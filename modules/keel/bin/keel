JS = r"""
(function(){
  var M = window.MEMO;
  var draftKey = "memo-form:" + M.slug;
  var live = !!(M.post || M.emit);  // a Save merges into the memo as it is now, not a store to re-read
  var $ = function(id){ return document.getElementById(id); };
  var main = document.querySelector("main");
  var status = $("status"), stateEl = $("state"), wordEl = $("state-word");
  // The bar's state (the owner, 2026-10-20: "a simple indicator with 1-2 words showing main status, and a
  // pop-up showing the full status on hover"). `base` is what last happened, a word for the bar, the
  // sentence for the pop-up and a tone for the dot; flash() shows a passing word (the arrows' "nothing
  // further") for a moment; text typed since the last Save reads Unsaved over a quiet state, never over
  // a failure, a Save in flight, or a page with no store. show() is the one place that draws it.
  var base = { text: "Nothing saved yet.", word: "Not saved", tone: "idle" }, flashing = null, flashT = 0, dirtyNow = false;
  var closed = false;  // memo serve has stopped: nothing could send what is typed now, so it is never "Unsaved"
  function show(){
    var s = flashing || base;
    if (!flashing && dirtyNow && !closed && /^(idle|ok|sent)$/.test(base.tone))
      s = { word: "Unsaved", tone: "draft", text: "Not saved yet: Save sends your answers, notes and feedback; this browser keeps a draft meanwhile."
                                                 + (base.tone === "idle" ? "" : " Before that: " + base.text) };
    wordEl.textContent = s.word; stateEl.setAttribute("data-tone", s.tone); status.textContent = s.text;
  }
  var say = function(t, word, tone){ base = { text: t, word: word || "Note", tone: tone || "idle" }; flashing = null; clearTimeout(flashT); show(); };
  function flash(t, word){
    flashing = { text: t, word: word, tone: stateEl.getAttribute("data-tone") || "idle" };
    clearTimeout(flashT); show();
    flashT = setTimeout(function(){ flashing = null; show(); }, 2500);
  }
  // a tap opens the pop-up where there is no hover (a phone); a tap anywhere else closes it
  stateEl.addEventListener("click", function(e){ e.stopPropagation(); $("stwrap").classList.toggle("open"); });
  document.addEventListener("click", function(){ $("stwrap").classList.remove("open"); });
  var store = null, lastSaved = null, pristine = null, sent = { notes: {}, feedback: "" };
  var notes = {};  // "at|row" → {at, row, quote, el, box, ta}
  var unplaced = [];  // saved notes whose line reads differently now: kept, and merge files them under feedback

  // ---- notes: tap any block to say something about it; merge writes it under that source line
  function noteKey(at, row){ return at + "|" + (row || ""); }
  function openNote(el, text, focus){
    var at = +el.getAttribute("data-at"), row = el.getAttribute("data-row") || "";
    var key = noteKey(at, row);
    if (notes[key]) { if (focus) notes[key].ta.focus(); return; }
    var box = document.createElement("div"); box.className = "note";
    var h = document.createElement("div"); h.className = "h";
    var lab = document.createElement("span"); lab.textContent = row ? "Note on the row “" + row + "”" : "Note";
    var rm = document.createElement("button"); rm.type = "button"; rm.className = "linkbtn"; rm.textContent = "Remove";
    h.appendChild(lab); h.appendChild(rm);
    var ta = document.createElement("textarea"); ta.rows = 2; ta.value = text || "";
    ta.title = "Note on line " + (at + 1);  // its accessible name: the box has no <label>
    box.appendChild(h); box.appendChild(ta);
    if (el.tagName === "TR") { var t = el.closest(".tbl"); t.parentNode.insertBefore(box, t.nextSibling); }
    else if (el.tagName === "LI") el.appendChild(box);
    else el.parentNode.insertBefore(box, el.nextSibling);
    el.classList.add("noted");
    notes[key] = {at: at, row: row, quote: el.getAttribute("data-q") || "", el: el, box: box, ta: ta};
    ta.addEventListener("input", changed);
    // an empty note left behind is a stray tap, not a note
    ta.addEventListener("blur", function(){ setTimeout(function(){ if (!ta.value.trim()) dropNote(key); }, 150); });
    rm.addEventListener("click", function(){ dropNote(key); });
    if (focus) ta.focus();
  }
  function dropNote(key){
    var n = notes[key]; if (!n) return;
    if (n.box.parentNode) n.box.parentNode.removeChild(n.box);
    n.el.classList.remove("noted"); delete notes[key]; changed();
  }
  function clearNotes(){
    Object.keys(notes).forEach(function(k){
      var n = notes[k]; if (n.box.parentNode) n.box.parentNode.removeChild(n.box); n.el.classList.remove("noted");
    });
    notes = {};
  }

  // ---- options: a tap puts the letter at the head of the answer, keeping any words after it
  var ACCEPT_ALL = "= recommended (accept all)";
  var REC_TAKEN = /^=\s*recommended(?:\s*\(accept all\))?$/i;  // the two markers, never "= recommended, but…"
  // a letter alone or before a separator ("B", "B - why"), never the "A" or "I" that starts a sentence
  var LETTER = /^([A-Z])(?=$|\s*[\-—–:,.])/;
  function lettersOf(id){
    var out = [], opts = document.querySelectorAll("#card-" + id + " button.opt");
    for (var i = 0; i < opts.length; i++) out.push(opts[i].getAttribute("data-letter"));
    return out;
  }
  function chosen(id, v){
    var L = (v.match(LETTER) || [])[1];
    return L && lettersOf(id).indexOf(L) >= 0 ? L : null;
  }
  function pick(opt){
    var id = opt.closest(".card").getAttribute("data-id"), ta = $("ans-" + id), L = opt.getAttribute("data-letter");
    var v = ta.value.trim();
    if (!v || REC_TAKEN.test(v)) ta.value = L;
    else if (chosen(id, v)) ta.value = L + v.slice(1);
    else ta.value = L + " - " + v;
    changed();
  }

  main.addEventListener("click", function(e){
    var t = e.target;
    var opt = t.closest("button.opt");
    if (opt) { pick(opt); return; }
    if (t.closest("a,button,textarea,input,label,.note")) return;
    if (window.getSelection && String(window.getSelection())) return;  // selecting text, not noting
    var el = t.closest("[data-at]");
    if (el && main.contains(el)) openNote(el, "", true);
  });

  function current(){
    var items = {};
    M.items.forEach(function(it){ items[it.id] = $("ans-" + it.id).value; });
    var comments = [];
    Object.keys(notes).forEach(function(k){
      var n = notes[k];
      if (n.ta.value.trim()) comments.push({at: n.at, row: n.row, quote: n.quote, text: n.ta.value});
    });
    comments = comments.concat(unplaced);
    comments.sort(function(a, b){ return a.at - b.at; });
    return { items: items, comments: comments, feedback: $("feedback").value };
  }
  function apply(doc){
    if (!doc) return;
    M.items.forEach(function(it){
      if (!doc.items || typeof doc.items[it.id] !== "string") return;
      // the live page: a draft box comes back only while the memo still holds the answer it was typed
      // against — else the session rewrote it since, and restoring would post the old text as edited
      if (live && !(doc.bases && doc.bases[it.id] === it.answer)) return;
      $("ans-" + it.id).value = doc.items[it.id];
    });
    if (Array.isArray(doc.comments)) {
      clearNotes(); unplaced = [];
      doc.comments.forEach(function(c){
        var cands = main.querySelectorAll('[data-at="' + (+c.at) + '"]'), el = null;
        for (var i = 0; i < cands.length; i++) if ((cands[i].getAttribute("data-row") || "") === (c.row || "")) { el = cands[i]; break; }
        // the line moved since the note was made: never reattach it to whatever sits there now
        if (el && c.quote && el.getAttribute("data-q") !== c.quote) el = null;
        if (el) openNote(el, c.text, false); else unplaced.push(c);
      });
    }
    if (typeof doc.feedback === "string") $("feedback").value = doc.feedback;
    refresh();
  }
  function answered(){ return M.items.filter(function(it){ return $("ans-" + it.id).value.trim(); }).length; }
  // the notes on the page with words in them: what the count says and what ↑ and ↓ visit
  function filled(){ return Object.keys(notes).map(function(k){ return notes[k]; }).filter(function(n){ return n.ta.value.trim(); }); }
  function refresh(){
    M.items.forEach(function(it){
      var v = $("ans-" + it.id).value.trim();
      var chip = $("chip-" + it.id);
      if (it.shape === "new") {
        chip.textContent = v ? "answered" : "open";
        chip.className = "chip" + (v ? "" : " open");
        $("take-" + it.id).hidden = REC_TAKEN.test(v);
        var L = chosen(it.id, v);
        var opts = document.querySelectorAll("#card-" + it.id + " button.opt");
        for (var i = 0; i < opts.length; i++) opts[i].classList.toggle("sel", opts[i].getAttribute("data-letter") === L);
      } else {
        var same = v === it.answer.trim();
        chip.textContent = same ? "recommendation" : "edited";
        chip.className = "chip" + (same ? "" : " edited");
        $("reset-" + it.id).hidden = same;
      }
    });
    // The decisions' tally, then one ✎ with the count of what the owner wrote besides: his notes and the
    // feedback box. Spelled `· 1 note · feedback`, the tail read as more items on the tally, the
    // feedback an open one (the owner, 2026-10-21). The words stay in the tooltip and, for a screen reader
    // (the counter is a live region), in a hidden span beside the glyph it skips. An unplaced note has
    // no box on the page, but a Save sends it: it counts.
    if ($("count")) {
      var a = answered(), n = M.items.length, k = filled().length + unplaced.length, fb = $("feedback").value.trim() ? 1 : 0;
      var words = (k ? " · " + k + " note" + (k === 1 ? "" : "s") : "") + (fb ? " · feedback written" : "");
      var span = function(cls, text, hide){ var s = document.createElement("span"); s.className = cls; s.textContent = text;
        return s; };
      $("count").textContent = a + "/" + n;
      $("count").appendChild(span("cw", " answered"));  // a phone drops the word
      if (k + fb) { $("count").appendChild(span("pen", " · ✎" + (k + fb), true)); $("count").appendChild(span("sr", words)); }
      $("count").title = a + " of " + n + " decision" + (n === 1 ? "" : "s") + " answered" + words;
    }
    var cur = JSON.stringify(current());
    var dirty = lastSaved === null || cur !== lastSaved;
    $("save").disabled = !dirty && store !== null;
    dirtyNow = pristine !== null && cur !== (lastSaved === null ? pristine : lastSaved);
    show();
  }
  function changed(){ refresh(); saveDraft(); }

  // ---- the footer (review feedback, 2026-10-14; entry S14): ↑ and ↓ jump to the previous and next
  // stop, and the count follows the boxes as they are typed. The stops are every decision card, every
  // note with words in it and the feedback card (the owner, 2026-10-20: "buttons should jump to them as
  // well"), in page order. "Next" is the first stop below where a jump lands; "previous" the last that
  // starts above it — the one being read, when it is scrolled part-way, else the one before.
  // Where a jump lands is scroll-padding-top plus the stop's scroll-margin-top: spacesheep's runtime
  // pads <html> by its header's height while the header floats over the page (anchor.js insetSet).
  // Measured against a fixed 24 px instead, a card ↓ had just put in place sat at 68 px, still "below",
  // and every press picked it again: ↓ never moved (the owner, 2026-10-20; reproduced in Chrome). A press
  // within 900 ms of the last steps on from where that one is going: a smooth scroll is still under way.
  // Where the browser has `scrollend`, the step-on lasts until the scroll ends (up to 3 s: a long smooth
  // scroll outlasts 900 ms, and the stop it heads for would be picked again — code review 2026-10-20).
  var reduced = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
  var lastJump = null, hasEnd = "onscrollend" in window;
  if (hasEnd) document.addEventListener("scrollend", function(){ if (lastJump) lastJump.done = true; });
  function stops(){
    var out = M.items.map(function(it){ return $("card-" + it.id); })
      .concat(filled().map(function(n){ return n.box; }), [$("card-feedback")]).filter(Boolean);
    return out.sort(function(a, b){ return a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1; });
  }
  var px = function(v){ v = parseFloat(v); return isNaN(v) ? 0 : v; };
  function jump(dir){
    var all = stops(), target = null, i, pad = px(getComputedStyle(document.documentElement).scrollPaddingTop);
    var landing = function(el){ return pad + px(getComputedStyle(el).scrollMarginTop); };
    var age = lastJump ? Date.now() - lastJump.t : Infinity;
    var from = (hasEnd ? lastJump && !lastJump.done && age < 3000 : age < 900) ? all.indexOf(lastJump.el) : -1;
    if (from >= 0) target = all[from + dir] || null;
    else if (dir > 0) { for (i = 0; i < all.length; i++) if (all[i].getBoundingClientRect().top > landing(all[i]) + 8) { target = all[i]; break; } }
    else { for (i = all.length - 1; i >= 0; i--) if (all[i].getBoundingClientRect().top < landing(all[i]) - 8) { target = all[i]; break; } }
    // at the page's end the last stop cannot reach the top: it is in view, and nothing is further down
    if (dir > 0 && from < 0 && innerHeight + scrollY >= document.documentElement.scrollHeight - 2) target = null;
    if (!target) {
      lastJump = null;
      flash(dir > 0 ? "No decision, note or feedback further down." : "No decision or note further up.", dir > 0 ? "At the end" : "At the top");
      return;
    }
    lastJump = { el: target, t: Date.now() };
    if (flashing) { flashing = null; clearTimeout(flashT); show(); }  // "At the end" is over once a press moves
    target.scrollIntoView({behavior: reduced ? "auto" : "smooth", block: "start"});
  }
  if ($("prev")) { $("prev").addEventListener("click", function(){ jump(-1); }); $("next").addEventListener("click", function(){ jump(1); }); }
  function saveDraft(){
    var d = current();
    if (live) { d.bases = {}; M.items.forEach(function(it){ d.bases[it.id] = it.answer; }); }
    try { localStorage.setItem(draftKey, JSON.stringify(d)); } catch (e) {}
  }
  function loadDraft(){
    try { var d = localStorage.getItem(draftKey); return d ? JSON.parse(d) : null; } catch (e) { return null; }
  }
  // "D1: first line" and its further lines indented two spaces — what merge's text reader expects
  function block(head, text){
    var ls = text.trim().split("\n");
    return [head + ls[0]].concat(ls.slice(1).map(function(l){ return "  " + l; }));
  }
  function asText(){
    var c = current(), out = [];
    M.items.forEach(function(it){ out = out.concat(block(it.id + ": ", c.items[it.id])); });
    c.comments.forEach(function(n){
      out = out.concat(block("Note L" + (n.at + 1) + (n.row ? " row " + JSON.stringify(n.row) : "")
                             + (n.quote ? " on " + JSON.stringify(n.quote) : "") + ": ", n.text));
    });
    if (c.feedback.trim()) out = out.concat(block("Feedback: ", c.feedback));
    return out.join("\n");
  }
  function stamp(){
    var d = new Date(); return d.toTimeString().slice(0,5);
  }

  M.items.forEach(function(it){
    var ta = $("ans-" + it.id);
    ta.addEventListener("input", changed);
    if (it.shape === "new") $("take-" + it.id).addEventListener("click", function(){ ta.value = "= recommended"; changed(); });
    else $("reset-" + it.id).addEventListener("click", function(){ ta.value = it.answer; changed(); });
  });
  $("feedback").addEventListener("input", changed);

  // One click to agree with everything (docs/subagent-cache-2026-10-04.md D5): every empty answer
  // of a new-shape item takes the recommendation, marked ACCEPT_ALL so a later analysis can tell a
  // bulk click from a per-card "Take the recommendation" (`= recommended`) or a typed letter;
  // answers already typed stay. Then it saves, as Save would.
  if ($("acceptall")) $("acceptall").addEventListener("click", function(){
    M.items.forEach(function(it){
      var ta = $("ans-" + it.id);
      if (it.shape === "new" && !ta.value.trim()) ta.value = ACCEPT_ALL;
    });
    changed();
    // a disabled Save (store path, nothing new) would swallow the click without a word (review 2026-10-04)
    if ($("save").disabled) { flash("Nothing new to accept: every answer is filled and saved.", "Nothing new"); return; }
    $("save").click();
  });

  $("copy").addEventListener("click", function(){
    var t = asText();
    var done = function(){ flash("Copied. Paste it to a session; merge does the rest.", "Copied"); };
    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t).then(done, function(){ window.prompt("Copy this:", t); });
    else window.prompt("Copy this:", t);
  });

  $("save").addEventListener("click", function(){
    var doc = current(); doc.savedAt = new Date().toISOString();
    if (live) {  // sheep wait and sheep pull merge into the live doc: send only what the owner changed, so a
      var edited = {};  // recommendation the session rewrote after this page loaded stays rewritten
      M.items.forEach(function(it){ if (doc.items[it.id].trim() !== it.answer.trim()) edited[it.id] = doc.items[it.id]; });
      doc.items = edited;
      // the page keeps every note and the feedback after a Save: send only what came since, or a
      // second Save would add them to the doc again (review 2026-10-14)
      doc.comments = doc.comments.filter(function(c){ return !sent.notes[c.quote + "\u0000" + c.text]; });
      var fb = doc.feedback;
      if (sent.feedback && fb.indexOf(sent.feedback) === 0) fb = fb.slice(sent.feedback.length);
      doc.feedback = fb.trim();
      // a Save with nothing in it would wake the session for nothing (code review 2026-10-04)
      if (!Object.keys(edited).length && !doc.comments.length && !doc.feedback.trim()) { flash("Nothing to save yet: answer, note or write feedback first.", "Nothing new"); return; }
    }
    if (!store) { saveDraft(); say("Kept in this browser only; the store is out of reach. Use Copy as text.", "Local", "warn"); return; }
    $("save").disabled = true;
    var sending = current(), before = base;
    say("Sending your answers, notes and feedback…", "Saving…", "busy");
    store.doc("answers/current").set(doc).then(function(res){
      // what went out, not what the boxes hold now: words typed while the Save was in flight (the
      // bridge may take 5 s) are still unsaved, and their draft stays (code review 2026-10-20)
      lastSaved = JSON.stringify(sending);
      if (live) {  // what went out is never sent again, and a reload must not bring it back
        sending.comments.forEach(function(c){ sent.notes[c.quote + "\u0000" + c.text] = true; });
        sent.feedback = sending.feedback;
        if (JSON.stringify(current()) === lastSaved) { try { localStorage.removeItem(draftKey); } catch (e) {} }
        else saveDraft();
      }
      var n = answered(), k = doc.comments.length, parts = [n + " answer" + (n === 1 ? "" : "s")];
      if (k) parts.push(k + " note" + (k === 1 ? "" : "s"));
      if (doc.feedback.trim()) parts.push("the feedback");
      if (res && res.sent) {  // the page's room has it; the session has not said it took it (receipt below)
        markSent(doc.savedAt);
        say("Handed to spacesheep at " + stamp() + ": " + parts.join(", ") + ". The session takes it into the doc "
            + "when it listens, and then this says Taken.", "Sent", "sent");
      } else if (res && res.message) say(res.message, "Saved", "ok");
      else say("Saved: " + parts.join(", ") + ", " + stamp() + ".", "Saved", "ok");
      if (res && res.closed) { store = null; closed = true; }  // memo serve has stopped: a second Save would go nowhere
      refresh();
      if (res && res.closed) $("save").disabled = true;
    }, function(e){
      say("Not saved (" + (e && e.code ? e.code : "error") + "). The draft stays here; Copy as text works."
          + (before.tone === "idle" ? "" : " Before that: " + before.text), "Failed", "error");
      $("save").disabled = false;
    });
  });

  pristine = JSON.stringify(current());  // the page as the doc stands: a restored draft is Unsaved
  apply(loadDraft());
  refresh();
  say("Nothing saved yet.", "Not saved", "idle");

  // ---- the receipt (RECEIPT_ID in keel): the hidden block holds the last pull's receipt as the
  // page was deployed, and a pull that takes a Save replaces it on every open tab (live_push), which
  // the runtime announces as `ss:live`. This browser remembers when it last sent a Save, so a page
  // reloaded before the session listened still says Sent, not an older Taken.
  var sentKey = "memo-sent:" + M.slug;
  function markSent(at){ try { localStorage.setItem(sentKey, at); } catch (e) {} }
  function lastSent(){ try { return localStorage.getItem(sentKey) || ""; } catch (e) { return ""; } }
  function when(iso){
    var d = new Date(iso); if (isNaN(d)) return "";
    var t = d.toTimeString().slice(0, 5);
    return d.toDateString() === new Date().toDateString() ? t : d.toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" }) + " " + t;
  }
  function receipt(){
    var el = document.querySelector('[data-ss-id="' + M.receipt_id + '"]');
    try { var r = el && JSON.parse(el.getAttribute("data-receipt") || "null"); return r && r.at ? r : null; } catch (e) { return null; }
  }
  // The word follows the newest Save the receipt covers (review 2026-10-20: a pull folds each Save
  // alone, so an earlier one can be taken and the newest refused): Refused when the newest was,
  // Partly when the doc kept some of its answers (git changed them since the page's commit, or a
  // newer comment answers them), else Taken. A newer Save of this browser's, still in the room,
  // keeps Sent — on load and when a pushed receipt arrives alike.
  function takeReceipt(r){
    if (!r) return false;
    var refused = Array.isArray(r.refused) ? r.refused : [], took = Array.isArray(r.saves) ? r.saves : [];
    var kept = Array.isArray(r.kept) ? r.kept : [];
    var newest = took.concat(refused.map(function(x){ return x.saved || ""; })).sort().pop() || "";
    if (lastSent() > newest) return false;
    var yours = newest ? " (your Save of " + when(newest) + ")" : "";
    var bad = refused.filter(function(x){ return (x.saved || "") === newest; })[0];
    if (bad)
      say("The session could not take your Save into the doc" + yours + ": " + bad.why + ". The session keeps its words; "
          + "Copy as text works too." + (took.length ? " An earlier Save was taken: " + (r.what || "nothing new") + "." : ""),
          "Refused", "error");
    else say("Taken into the doc at " + when(r.at) + yours + ": " + (r.what || "nothing new") + "."
             + (kept.length ? " Not taken: " + kept.join(", ") + "." : "")
             + (refused.length ? " " + refused.length + " older Save" + (refused.length === 1 ? " was" : "s were") + " refused." : ""),
             kept.length ? "Partly" : "Taken", kept.length ? "warn" : "ok");
    return true;
  }
  document.addEventListener("ss:live", function(e){
    // a patch names the blocks it changed; a whole-page morph lists every block, the receipt's unchanged
    var d = e.detail || {};
    if (d.mode === "patch" && (d.ids || []).indexOf(M.receipt_id) >= 0) takeReceipt(receipt());
  });

  // memo serve (the fallback where a doc has no page): the page posts to the local server, which
  // writes the answers into the memo
  var posted = M.post ? { doc: function(){ return {
    get: function(){ return Promise.resolve({ exists: false }); },
    set: function(d){
      return fetch(M.post, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(d) })
        .then(function(r){ return r.ok ? r.json() : r.json().then(function(b){ return Promise.reject({ code: b.message || "http " + r.status }); },
                                                                   function(){ return Promise.reject({ code: "http " + r.status }); }); },
              function(){ return Promise.reject({ code: "the local server has stopped" }); });
    } }; } } : null;
  // The spacesheep page: the Save is an event in the space's room (spacesheep's page bridge,
  // window.ss.emit), which `memo sheep wait` hears and `sheep pull` drains. The room keeps its
  // last 500 events while nobody listens (live_events' own description); how long, and across a
  // redeploy, is not probed (the design's Q3) — seen: a Save still in the room 30 min later (2026-10-14),
  // and a page's opens and Save still there about 57 h later, nobody listening (crew design, 2026-10-18).
  // The bridge loads after the page, once the frame's sign-in exchange is done: what needs it
  // waits for it, up to `ms`.
  var bridge = function(ms){ return new Promise(function(ok, no){
    var t0 = Date.now();
    (function poll(){
      if (window.ss && typeof window.ss.emit === "function") ok();
      else if (Date.now() - t0 > ms) no({ code: "spacesheep's page bridge did not load; Copy as text works" });
      else setTimeout(poll, 200);
    })();
  }); };
  // one open per page load, as memo serve logged one per GET (E14 `opened`); never in the way
  if (M.emit) bridge(20000).then(function(){ window.ss.emit(M.open, { sha: M.sha }); }, function(){});
  // memo-read, the reading heartbeat (regatta's crew design, S6): at most one a minute, while the
  // page is visible and a trusted wheel, keydown, pointerdown or touchstart came within the last
  // minute; a 15-second timer looks. Input, not visibility, bounds a run: VS Code's Simple Browser
  // keeps a hidden tab alive and may call it visible. No scroll or pointermove: Chromium fires
  // those under a still cursor after a layout change. Captured on the document, so a listener on
  // the window not seeing the frame's events (unprobed in the Simple Browser) loses nothing. The
  // page keeps no state: the 5-minute break is the reader's (crew-report), a closed tab loses nothing.
  if (M.emit && M.read) {
    var lastInput = 0, lastBeat = 0;
    ["wheel", "keydown", "pointerdown", "touchstart"].forEach(function(t){
      document.addEventListener(t, function(e){ if (e.isTrusted) lastInput = Date.now(); }, { capture: true, passive: true });
    });
    setInterval(function(){
      var now = Date.now();
      if (document.visibilityState !== "visible" || now - lastInput > 60000 || now - lastBeat < 60000) return;
      if (!(window.ss && typeof window.ss.emit === "function")) return;
      lastBeat = now;
      try { window.ss.emit(M.read, { sha: M.sha }); } catch (e) {}
    }, 15000);
  }
  var emitted = M.emit ? { doc: function(){ return {
    get: function(){ return Promise.resolve({ exists: false }); },
    set: function(d){
      var ev = { sha: M.sha }; for (var k in d) ev[k] = d[k];
      // ss.emit returns nothing: the room's word that it took the Save comes later, as the receipt
      return bridge(5000).then(function(){ return window.ss.emit(M.emit, ev); }).then(function(){ return { sent: true }; });
    } }; } } : null;
  // a Save this browser sent that no receipt answers yet: the page was reloaded before the session listened
  function sentWaiting(){
    var s = lastSent(); if (!s) return false;
    say("Your Save of " + when(s) + " is with spacesheep. The session takes it into the doc when it listens, "
        + "and then this says Taken.", "Sent", "sent");
    return true;
  }
  var use = posted ? Promise.resolve(posted)
          : emitted ? Promise.resolve(emitted)
          : window.claude && window.claude.use ? window.claude.use("db") : Promise.resolve(null);
  use.then(function(db){
    if (!db) { say("No store on this view; answers stay in this browser. Copy as text to hand them over.", "Local", "warn"); return; }
    store = db;
    return db.doc("answers/current").get().then(function(snap){
      if (snap.exists) {
        var d = snap.data();
        apply(d);
        lastSaved = JSON.stringify(current());
        say("Saved answers loaded" + (d.savedAt ? " (" + String(d.savedAt).slice(0, 16).replace("T", " ") + ")" : "") + ".", "Loaded", "ok");
      } else if (!(M.emit && (takeReceipt(receipt()) || sentWaiting()))) {
        say("Nothing saved yet.", "Not saved", "idle");
      }
      refresh();
    });
  }).catch(function(){ say("The store did not answer; the draft stays in this browser.", "Local", "warn"); });
})();
"""


def slugify(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:60] or "memo"


def rec_html(it):
    """The Recommended line, read-only: a letter shows its option's text beside it."""
    r = it["recommended"] or ""
    m = re.match(r"^([A-Z])(?:$|\s*[—–:-]\s*(.*)$)", r)
    opt = dict(it["options"])
    if m and m.group(1) in opt:
        extra = (" — " + inline(m.group(2))) if (m.group(2) or "").strip() else ""
        return "<strong>%s</strong> — %s%s" % (m.group(1), inline(opt[m.group(1)]), extra)
    return inline(r)


def card_body(it, lines, ctx, pick=None):
    """An item's body rendered from its source lines, so a note on any of them finds its line."""
    src = []
    base = it["start"] + 1
    if it["inline"]:
        src.append(" " * it["content"] + it["inline"])
        base = it["start"]
    src += lines[it["start"] + 1:it["body_end"]]
    return render_md(src, base, 0, ctx, pick=(it["shape"] == "new") if pick is None else pick)


def ss_anchor(ctx, at, row=None):
    """The page's `data-ss-id` for a block, from its content: `b-` + 8 hex of the line's text (and
    the row label), `-2`… for a repeat. Not the line number — a line added above would renumber
    every block below, and an open comment would then name another block (review, 2026-10-03);
    spacesheep keeps comments across redeploys only while the ids stay put. ctx["ss"] maps each id
    back to what `merge` places a note by: the line, its text, the row label."""
    import hashlib
    quote = ctx["lines"][at].strip()
    base = "b-" + hashlib.sha1(("%s\x00%s" % (quote, row or "")).encode()).hexdigest()[:8]
    sid, k = base, 1
    while sid in ctx["ss"]:
        k += 1
        sid = "%s-%d" % (base, k)
    ctx["ss"][sid] = {"at": at, "quote": quote, "row": row or ""}
    return sid


def page_parts(text, page=False):
    """(lines, items, feedback_line, the page's HTML parts, ctx) — `build` renders them, `merge`
    reads ctx["anchors"] to place each note exactly where the page showed it. Every item is a card;
    the feedback section (parse's feedback_section: after the last item) and what follows it are not
    rendered here — the page's own feedback card shows them.
    `page`: the spacesheep page (`memo sheep`) — the same form, every block also anchored for
    spacesheep's comments: a decision card `data-ss-id="D<n>"`, every other block a content hash
    (ss_anchor), mapped back in ctx["ss"]. Until 2026-10-14 the page was read-only and a comment
    anywhere on a card was its answer; now the card has the answer box, so a comment on a line
    inside it is a note on that line and one on the card's own head is the answer."""
    lines, items, feedback_line = parse(text)
    ctx = {"lines": lines, "anchors": {}}
    if page:
        ctx["ss"] = {}
    # segments: markdown between items, cards for items; the feedback section is never above an item
    parts = []
    pos = 0
    for it in items:
        parts.append(render_md(lines[pos:it["start"]], pos, 0, ctx))
        pos = it["end"]
        ans = it["answer"] if it["answer"] is not None else ""
        v = {"id": it["id"], "title": inline(it["title"]), "body": card_body(it, lines, ctx),
             "ans": html.escape(ans, quote=False), "ss": ' data-ss-id="%s"' % it["id"] if page else ""}
        if it["shape"] == "new":
            v["rec"] = rec_html(it)
            mid = between(it, lines)
            v["mid"] = render_md(mid, it["rec_end"], 0, ctx, pick=True) if any(l.strip() for l in mid) else ""
            parts.append(
                '<section class="card" id="card-%(id)s" data-id="%(id)s"%(ss)s>'
                '<div class="eyebrow">%(id)s</div>'
                '<div class="title">%(title)s</div>'
                '<div class="body">%(body)s</div>'
                '<div class="rec"><span class="k">Recommended</span>%(rec)s</div>'
                '<div class="body">%(mid)s</div>'
                '<label for="ans-%(id)s">Your answer</label>'
                '<textarea id="ans-%(id)s" rows="2" placeholder="A letter, words, or both">%(ans)s</textarea>'
                '<div class="row"><span class="chip" id="chip-%(id)s">open</span>'
                '<button type="button" class="linkbtn" id="take-%(id)s">Take the recommendation</button></div>'
                '</section>' % v)
        else:
            parts.append(
                '<section class="card" id="card-%(id)s" data-id="%(id)s"%(ss)s>'
                '<div class="eyebrow">%(id)s</div>'
                '<div class="title">%(title)s</div>'
                '<div class="body">%(body)s</div>'
                '<label for="ans-%(id)s">Answer</label>'
                '<textarea id="ans-%(id)s" rows="2">%(ans)s</textarea>'
                '<div class="row"><span class="chip" id="chip-%(id)s">recommendation</span>'
                '<button type="button" class="linkbtn" id="reset-%(id)s" hidden>Back to the recommendation</button></div>'
                '</section>' % v)
    parts.append(render_md(lines[pos:feedback_line if feedback_line is not None else len(lines)], pos, 0, ctx))
    return lines, items, feedback_line, parts, ctx


def build(text, source_name, post=None):
    return render_form(text, source_name, post=post)[0]


def render_form(text, source_name, post=None, sheep=None):
    """The form as one HTML page; returns (html, ctx). `post`: memo serve's answer URL. `sheep`:
    the spacesheep page's footer facts ({rel, sha, branch, read, edit}) — the same form, anchored
    for comments, its Save sent through spacesheep's page bridge (`window.ss.emit("memo-save",
    doc)`; probed 2026-10-14: an emit reaches live_events in under 2 s, its data intact) for
    `sheep wait` and `sheep pull` to take."""
    lines, items, feedback_line, parts, ctx = page_parts(text, page=bool(sheep))
    title = title_of(text, Path(source_name).stem)
    existing_feedback = ""
    if feedback_line is not None:
        tail = [l for l in lines[feedback_line + 1:] if l.strip() != "---"]
        existing_feedback = "\n".join(tail).strip()
    data = {"slug": slugify(title), "title": title,
            "items": [{"id": it["id"], "title": it["title"], "answer": it["answer"] or "", "shape": it["shape"],
                       "recommended": it["recommended"]} for it in items]}
    if post:
        data["post"] = post
    if sheep:
        data["emit"], data["open"], data["read"], data["sha"] = SAVE_EVENT, OPEN_EVENT, READ_EVENT, sheep["sha"]
        data["receipt_id"] = RECEIPT_ID
    n = len(items)
    new = sum(1 for it in items if it["shape"] == "new")
    say = ["%d decision%s." % (n, "" if n == 1 else "s")] if n or not sheep else []
    if new:
        say.append("The recommendation is fixed; the answer box is yours — a letter, words, or both.")
    if new < n:
        say.append("%s pre-filled with the recommendation; leave it, or say otherwise."
                   % ("Each answer is" if not new else "Older-style answers are"))
    say.append("Tap any line to leave a note on it. One Save covers it all.")
    if sheep:
        say.append("Save sends your answers, notes and feedback to this page's room: they reach the doc when the session "
                   "that handed you this page takes them in (it listens), or at the next memo sheep pull; the bar "
                   "says Sent, then Taken once the doc has them. "
                   "Comments work too: on a decision's card a comment is the answer, on any other line a note, on the page "
                   "open feedback; the same pull collects them. The doc itself lives in git; this page is its copy.")
    foot = ""
    if sheep:
        foot = '<p class="foot"><span class="k">Source</span>%s at <code>%s</code> on <code>%s</code>%s</p>' % (
            html.escape(sheep["rel"], quote=False), html.escape(sheep["sha"][:7], quote=False),
            html.escape(sheep["branch"], quote=False),
            (' · <a href="%s" rel="noopener">read on GitHub</a> · <a href="%s" rel="noopener">edit</a>'
             % (html.escape(sheep["read"], quote=True), html.escape(sheep["edit"], quote=True))) if sheep.get("edit") else "")
    page = [
        "<title>%s</title>" % html.escape(title, quote=False),
        "<style>%s%s</style>" % (CSS, SHEEP_CSS if sheep else ""),
        "<main>",
        '<p class="meta">%s</p>' % " ".join(say),
        "\n".join(parts),
        '<section class="card" id="card-feedback"><div class="eyebrow">Open feedback</div>'
        '<div class="title">Anything the decisions above do not cover</div>',
        ('<div class="body">%s</div>' % render_md(existing_feedback.split("\n"))) if existing_feedback else "",
        '<label for="feedback">Feedback</label><textarea id="feedback" rows="3"></textarea></section>',
        foot,
        "</main>",
        # The bar: ↑ ↓ and the count, then the state — a word in a pill (spacesheep's live pill, the owner
        # 2026-10-20), the whole sentence in a pop-up — then the actions. The pill sits after the count,
        # sized to its word: a fixed slot ahead of the arrows left every shorter word off-centre (the owner's
        # D4 on the test page). `.more` is the rest of a label, which the spacesheep skin clips out of
        # sight and a screen reader still reads; `.sr` text is for a screen reader alone (no attribute
        # by the accessibility prefix in this file: the publish gate refuses that word, AGENTS.md's trap).
        '<div class="bar"><div class="in"><span class="nav">'
        + ('<button type="button" class="secondary" id="prev" title="Previous decision or note">↑<span class="sr"> Previous decision or note</span></button>'
           '<button type="button" class="secondary" id="next" title="Next decision or note">↓<span class="sr"> Next decision or note</span></button>'
           '<span class="count" id="count" role="status">%d/%d<span class="cw"> answered</span></span>'
           % (sum(1 for it in items if (it["answer"] or "").strip()), n) if n else "")
        + '<span class="stwrap" id="stwrap"><button type="button" class="state" id="state" data-tone="idle">'
        '<span class="dot"></span><span class="word" id="state-word">Not saved</span></button>'
        '<span class="pop" id="status" role="status">Nothing saved yet.</span></span></span>'
        + '<span class="acts">'
        + ('<button type="button" class="secondary" id="acceptall" title="Accept all recommendations">Accept all<span class="more"> recommendations</span></button>' if new else "")
        + '<button type="button" class="secondary" id="copy" title="Copy as text">Copy<span class="more"> as text</span></button>'
        '<button type="button" class="primary" id="save" title="Save answers">Save<span class="more"> answers</span></button></span></div></div>',
        receipt_html(sheep.get("receipt")) if sheep else "",
        "<script>window.MEMO = %s;</script>" % json.dumps(data, ensure_ascii=False).replace("</", "<\\/"),
        "<script>%s</script>" % JS,
    ]
    page.append(mermaid_scripts("\n".join(parts)))  # after the form's own script: a diagram never holds up the answers
    return "\n".join(p for p in page if p), ctx


# The spacesheep skin (the owner, 2026-10-20). The page wears spacesheep's own neutrals — its --ss-bg,
# text, border and surface tokens, light and dark, read from the viewer's stylesheet that day — so
# it sits in the viewer as one of its pages; what the reader acts on is a calm fire orange — the
# Save, focus rings, a picked option, links, the state pill while sending — and none of it purple,
# spacesheep's brand: purple on screen is spacesheep's control, orange is the course's. Labels, the
# arrows and the capsule stay neutral, card edges a faint warm line (the owner's D1 on the test page, 2026-10-20: "the orange
# is too loud"). The buttons take spacesheep's design-language measures (36 px, 13 px at 600, the 6 s
# gloss sheen of its .ss-btn--gloss) in a pill, not its 6-8 px rectangles, inside a glass capsule
# like the viewer's own header. The capsule stops 84 px short of the right edge: the viewer's mic
# (.speak) and comment (.cfab) buttons float there over the frame, 52 px wide at 16 px from the
# edge, stacked from 16 px up the bottom (viewer.css).
# The bar's z-index (in CSS, so memo serve's form has it too) is 2147483646: spacesheep's runtime
# draws comment pins and reaction chips at 2147483645, absolute in the body, so a pin on a card
# that had scrolled under the bar lay over ↓ and took the click (anchor.js catches a pin's
# pointerdown and opens its thread — the owner's "interacts with co-shepherd element instead", 2026-10-20).
# The selection pill and tooltips stay above it, at 2147483647; the hover reaction pill ties it at
# 2147483646 and, appended later, paints over where it overlaps — on hover only, at a block's top.
# ↑ ↓ lead the bar, inside the frame's left 120 px, where anchor.js reports the pointer to the
# viewer's Co-shepherd tab (EDGE_PX): the tab may slide out, at the frame's middle height, and takes
# no click at the bar — the pins above did. The state pill is spacesheep's live pill (viewer-main.js
# `ssLivePill`: 11 px at 600, upper case, a 7 px dot that blinks), its fill the tone.
# Contrast: white on the Save's gradient is 4.7:1 at its top and 6.2:1 at its foot; the link orange
# is 5.5:1 on the paper; each pill's word is 4.7:1 or more on its fill; dark mode puts near-black on
# a lighter orange, 5.2:1 at the least (the Save's foot).
