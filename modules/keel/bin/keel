"""


def sheep_page(text, source_name, meta):
    """The spacesheep page: the form (render_form), answerable from the phone. A Save there is an
    event `sheep wait` wakes the session on; a comment on a decision card answers it, on any other
    block leaves a note there, on the page is open feedback — `sheep pull` brings both back
    through `merge`. Returns (html, ctx).

    A whole document, never a fragment: spacesheep injects its page runtime (`window.ss`, the
    comment anchors) only into one with <html> and <body>; a fragment gets none, and the Save
    failed with "page bridge did not load" (probed 2026-10-14, the same script both ways)."""
    page, ctx = render_form(text, source_name, sheep=meta)
    return PAGE_HEAD + page + "</body></html>", ctx


# ----------------------------------------------------------------------------- merge

def load_answers(src):
    """Accept the store document, an ArtifactData wrapper around it, or the page's copied text."""
    raw = src.read_text() if isinstance(src, Path) else src
    raw = raw.strip()
    doc = None
    if raw.startswith("{") or raw.startswith("["):
        obj = json.loads(raw)
        doc = obj
        for _ in range(4):  # unwrap {data: {...}}, {document: {...}}, {result: {...}}
            if isinstance(doc, dict) and "items" in doc:
                break
            if isinstance(doc, dict):
                nxt = next((doc[k] for k in ("data", "document", "doc", "result", "value") if isinstance(doc.get(k), dict)), None)
                if nxt is None:
                    break
                doc = nxt
        if not (isinstance(doc, dict) and isinstance(doc.get("items"), dict)):
            # a flat {D1: "...", feedback: "..."} map
            if isinstance(doc, dict) and any(re.match(r"^D\d+$", k) for k in doc):
                doc = {"items": {k: v for k, v in doc.items() if re.match(r"^D\d+$", k)}, "feedback": doc.get("feedback", "")}
            else:
                raise SystemExit("answers: no `items` object found in the JSON")
    else:
        # the page's "Copy as text": `D1: …`, `Note L12 row "x": …`, `Feedback: …`, each followed by
        # its further lines indented two spaces; everything after Feedback is feedback
        items = {}
        comments = []
        feedback = []
        cur = None
        for l in raw.split("\n"):
            m = re.match(r"^(D\d+):\s*(.*)$", l)
            n = re.match(r'^Note L(\d+)(?: row ("(?:[^"\\]|\\.)*"))?(?: on ("(?:[^"\\]|\\.)*"))?:\s*(.*)$', l)
            if feedback:
                feedback.append(l[2:] if l.startswith("  ") else l)
            elif m:
                items[m.group(1)] = m.group(2).strip()
                cur = ("item", m.group(1))
            elif n:
                comments.append({"at": int(n.group(1)) - 1, "row": json.loads(n.group(2)) if n.group(2) else "",
                                 "quote": json.loads(n.group(3)) if n.group(3) else "", "text": n.group(4).strip()})
                cur = ("note", len(comments) - 1)
            elif l.lower().startswith("feedback:"):
                feedback.append(l.split(":", 1)[1].strip())
            elif cur:
                # the page indents further lines two spaces; a chat box may have trimmed them
                more = l[2:] if l.startswith("  ") else l
                if cur[0] == "item":
                    items[cur[1]] += "\n" + more
                else:
                    comments[cur[1]]["text"] += "\n" + more
        doc = {"items": items, "comments": comments, "feedback": "\n".join(feedback).strip()}
    comments = [c for c in (doc.get("comments") or []) if isinstance(c, dict)]
    for c in comments:
        try:
            c["at"] = int(c.get("at"))
        except (TypeError, ValueError):
            c["at"] = None
    return {"items": {k: (v if isinstance(v, str) else str(v)) for k, v in doc["items"].items()},
            "comments": comments,
            "feedback": (doc.get("feedback") or "").strip()}


def guard_block(it, lines, ind):
    """Refuse to rewrite a D10 answer block that may have run past its list item: a line indented
    less than the ➤ line, after a blank line, is most likely the agent's prose below a D-list that
    does not end in a heading or `---` — merge would delete it (review, 2026-10-03). The owner typing at
    column 0 straight under `➤ Answer:` passes; text further down stops here for a look, never lost."""
    if not ind:
        return
    blank = False
    for k in range(it["answer_line"] + 1, it["answer_end"]):
        l = lines[k]
        if not l.strip():
            blank = True
            continue
        if blank and len(l) - len(l.lstrip()) < len(ind):
            raise Stop("%s: its answer block runs into line %d (%r), which reads as text below the list — "
                       "end the D-list with a heading or `---`, then merge again" % (it["id"], k + 1, l.strip()[:60]))


def same_answer(it, a, b):
    """D10 answers keep their lines; an old-shape answer is one line, so only its words count."""
    if it["shape"] == "new":
        return block_text("", (a or "").split("\n")) == block_text("", (b or "").split("\n"))
    return " ".join((a or "").split()) == " ".join((b or "").split())


def place_note(lines, anchors, c):
    """The source line a note goes under: its own line if the memo still reads there as the page
    showed it, else the one line that does; None when the memo moved too far to tell."""
    at, quote = c.get("at"), (c.get("quote") or "").strip()
    if isinstance(at, int) and at in anchors and 0 <= at < len(lines) and (not quote or lines[at].strip() == quote):
        return at
    hits = [k for k in anchors if quote and lines[k].strip() == quote]
    return hits[0] if len(hits) == 1 else None


def merge(text, answers, today=None):
    lines, items, feedback_line, _, ctx = page_parts(text)
    today = today or dt.date.today().isoformat()
    changed = []
    unchanged = []
    edits = []  # (start, end, replacement_lines)
    for it in items:
        new = answers["items"].get(it["id"])
        if new is None:
            continue
        if same_answer(it, new, it["answer"]):
            unchanged.append(it["id"])
            continue
        if it["shape"] == "new":
            # D10: `➤ Answer:` alone on its line, the owner's words indented under it, one blank line after
            if it["answer_line"] is not None:
                prefix = split_answer(lines[it["answer_line"]])[0]
                start, end = it["answer_line"], it["answer_end"]
            else:
                prefix = lines[it["rec_line"]].split(RECOMMENDED, 1)[0]
                start = end = it["end"]
            ind = re.match(r"\s*", prefix).group(0)
            if it["answer_line"] is not None:
                guard_block(it, lines, ind)
            body = block_text("", new.split("\n")).split("\n")
            rep = [prefix + ANSWER] + [ind + l if l.strip() else "" for l in body]
            if end < len(lines):
                rep.append("")
            edits.append((start, end, rep))
            changed.append(it["id"])
            continue
        new = " ".join(new.split())
        if it["answer_line"] is not None:
            prefix = split_answer(lines[it["answer_line"]])[0]
            edits.append((it["answer_line"], it["answer_end"], [prefix + ANSWER + " " + new]))
        else:
            ind = " " * it["content"]
            edits.append((it["end"], it["end"], [ind + ANSWER + " " + new]))
        changed.append(it["id"])
    # notes: each goes under the line it was made on, as a paragraph of its own at that block's
    # indent (inside a list item it stays in the item); one the memo moved away from joins the feedback
    stray = []
    placed = 0
    for idx, c in enumerate(answers.get("comments", [])):
        text_ = (c.get("text") or "").strip()
        if not text_:
            continue
        row = (c.get("row") or "").strip()
        if row:
            text_ = "(row “%s”) %s" % (row, text_)
        at = place_note(lines, ctx["anchors"], c)
        if at is None:
            q = (c.get("quote") or "").strip()
            stray.append(("(on “%s”) " % (q[:80] + ("…" if len(q) > 80 else "")) if q else "") + text_)
            continue
        ind = " " * ctx["anchors"][at]
        body = text_.split("\n")
        # merged once already (the owner saved again, the store still holds it): not twice
        mine = re.compile(r"^\*\*%s, [0-9-]+:\*\* " % OWNER_RE + re.escape(body[0].strip()) + "$")
        if any(mine.match(l.strip()) for l in lines[at + 1:at + 1 + 40]):
            continue
        rep = ["", ind + "**%s, %s:** %s" % (OWNER, today, body[0].strip())] + [ind + l.strip() if l.strip() else "" for l in body[1:]]
        nxt = lines[at + 1] if at + 1 < len(lines) else ""
        if nxt.strip() and not re.match(r"^\s*([-*]|\d+\.)\s+", nxt):
            rep.append("")
        edits.append((at + 1, at + 1, rep, idx))
        placed += 1
    fb = "\n\n".join([answers.get("feedback", "").strip()] + stray).strip()
    fb_added = False
    if fb:
        block = ["", "**%s, %s:** %s" % (OWNER, today, fb), ""]
        if feedback_line is not None:
            at = len(lines)
            while at > feedback_line + 1 and not lines[at - 1].strip():
                at -= 1
            edits.append((at, at, block))
        else:
            edits.append((len(lines), len(lines), ["", "## Open feedback"] + block))
        fb_added = True
    # bottom up; at one line a replacement goes before an insertion, so a note above an answer stays above it
    # several notes on one line (rows of one table) keep their order: the later is applied first
    for e in sorted(edits, key=lambda e: (e[0], e[1], e[3] if len(e) > 3 else -1), reverse=True):
        lines[e[0]:e[1]] = e[2]
    return "\n".join(lines), {"changed": changed, "unchanged": unchanged, "feedback": fb_added,
                              "notes": placed, "notes_to_feedback": len(stray),
                              "unknown": sorted(set(answers["items"]) - {it["id"] for it in items})}


def summarize(rep):
    return "changed: %s; unchanged: %s; feedback: %s%s%s%s" % (
        ", ".join(rep["changed"]) or "none", ", ".join(rep["unchanged"]) or "none",
        "added" if rep["feedback"] else "none",
        ("; notes: %d" % rep["notes"]) if rep.get("notes") else "",
        ("; notes the memo moved away from, put under feedback: %d" % rep["notes_to_feedback"]) if rep.get("notes_to_feedback") else "",
        ("; unknown ids ignored: " + ", ".join(rep["unknown"])) if rep["unknown"] else "")


# ----------------------------------------------------------------------------- the page

PAGE_HEAD = ('<!doctype html><html><head><meta charset="utf-8">'
             '<meta name="viewport" content="width=device-width,initial-scale=1"></head><body>')


def serve(memo, port=0, once=True, idle=110 * 60):
    """The form in a VS Code tab: a server on 127.0.0.1 whose Save writes into the memo.

    VS Code's built-in Simple Browser claims http links to localhost / 127.0.0.1 (its
    `simpleBrowser.open` opener; any other host goes to the system browser), so the URL this
    prints opens in an editor tab when clicked in VS Code — with the user setting
    `"workbench.externalUriOpeners": {"127.0.0.1:*": "simpleBrowser.open"}`, without a picker.
    Nothing can open that tab from a script: Simple Browser has no vscode:// handler (read from
    its package.json, VS Code 2026-10-03). A random token in the path keeps other local pages
    from posting; a POST whose Origin is not this server is refused. Run in the background by a
    session: the first line printed is the URL, each Save prints one `saved` line, and with
    `once` (the default) the process exits after the first Save, which is what wakes the
    session. `idle` seconds without a request also end it.
    """
    import http.server
    import secrets
    path = Path(memo).resolve()
    token = secrets.token_urlsafe(16)
    base = "/%s/" % token
    state = {"done": False, "timed_out": False, "feedback": ""}

    class Handler(http.server.BaseHTTPRequestHandler):
        timeout = 30  # one server thread: a socket that never sends must not block the rest (review 2026-10-03)

        def log_message(self, *args):
            pass

        def send(self, code, body, ctype):
            b = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(b)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(b)

        def do_GET(self):
            if self.path.split("?", 1)[0] not in (base, base[:-1]):
                return self.send(404, "not found", "text/plain")
            # read the memo on every load: a reload shows what the session changed meanwhile
            try:
                page = build(path.read_text(), path.name, post=base + "answers")
            except (Stop, OSError, ValueError) as e:
                return self.send(500, "memo serve cannot show %s: %s" % (path.name, e), "text/plain; charset=utf-8")
            record_open(path)  # one row per page that built — the page never polls (E14: `opened`)
            self.send(200, PAGE_HEAD + page + "</body></html>", "text/html; charset=utf-8")

        def do_POST(self):
            if self.path != base + "answers":
                return self.send(404, "not found", "text/plain")
            origin = self.headers.get("Origin")
            if origin and origin != "http://%s" % self.headers.get("Host", ""):
                return self.send(403, "wrong origin", "text/plain")
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = -1
            if n < 0:
                return self.send(400, "bad Content-Length", "text/plain")
            if n > 1 << 20:
                return self.send(413, "too large", "text/plain")
            try:
                answers = load_answers(self.rfile.read(n).decode("utf-8"))
            except (SystemExit, ValueError) as e:
                return self.send(400, "bad answers: %s" % e, "text/plain")
            # A refusal must reach both sides: the page says why, and the session reads a line.
            # Unanswered, socketserver swallows the exception and the page reports a dead server
            # while it runs on, silent (review 2026-10-04: an answer block running into prose).
            try:
                text = path.read_text()
                # with --keep the box still holds what was saved: append only what was added since
                # Known limit (code review 2026-10-04): with --keep, feedback edited between Saves,
                # and notes that fall to the feedback, are appended again; the default exits after one Save.
                fb, prev = answers["feedback"], state["feedback"]
                if prev and fb.startswith(prev):
                    answers["feedback"] = fb[len(prev):].strip()
                new_text, rep = merge(text, answers)
                # an answer that reads as a D-item, a heading or `---` would restructure the memo:
                # parse the result before writing, so a bad Save leaves the file as it was
                _, items, _ = parse(new_text)
                if new_text != text:
                    path.write_text(new_text)
                state["feedback"] = fb or prev
                # only edited answers are posted: the rest (the page shows every item) are unchanged too, say so
                shown = {it["id"] for it in items}
                rep["unchanged"] = sorted(set(rep["unchanged"]) | (shown - set(rep["changed"]) - set(answers["items"])),
                                          key=lambda i: int(re.sub(r"\D", "", i) or 0))
                summary = summarize(rep)
            except Exception as e:  # Stop from merge's or parse's guards, or anything else
                print("refused %s: %s" % (path.name, e), flush=True)
                code = 409 if isinstance(e, Stop) else 500
                return self.send(code, json.dumps({"message": "Not written into %s: %s" % (path.name, e)}), "application/json")
            record_touch(path, "save")  # a Save is the owner's act: the doc no longer stands (D11, `status`)
            print("saved %s: %s" % (path.name, summary), flush=True)
            msg = "Saved into %s: %s." % (path.name, summary)
            if once:
                msg += " The session has them; this page is done."
                state["done"] = True
            self.send(200, json.dumps(dict(rep, message=msg, closed=once)), "application/json")

    if not path.is_file():
        raise Stop("no memo at %s" % path)
    build(path.read_text(), path.name)  # a bad memo fails here, not as empty replies
    srv = http.server.HTTPServer(("127.0.0.1", port), Handler)
    # A fixed lifetime from start, not an idle window: each request restarts srv.timeout, and the
    # harness kills a background task at its own deadline regardless (review 2026-10-04)
    import time
    deadline = time.monotonic() + idle
    srv.handle_timeout = lambda: None
    url = "http://127.0.0.1:%d%s" % (srv.server_address[1], base)
    print(url, flush=True)  # the first line: the hook and skill read it
    reg = register_serve(path, url, idle)  # `keel line` reuses it; the Stop hook checks a form link against it
    handover_lint(path.read_text(), path)
    try:
        while not state["done"] and time.monotonic() < deadline:
            srv.timeout = max(0.1, deadline - time.monotonic())
            srv.handle_request()
    finally:
        srv.server_close()
        if reg:
            try:
                reg.unlink()
            except OSError:
                pass
    if not state["done"]:
        print("stopped: %ds since start; nothing more was saved" % idle, flush=True)
    return 0



def title_of(text, fallback):
    for l in text.split("\n"):
        m = HEADING_RE.match(l.strip())
        if m:
            return re.sub(r"[*`]", "", m.group(2))
    return fallback


# ----------------------------------------------------------------------------- list

REPO_DEPTH = 4  # films/productions/<group>/<slug> is four levels under ~/projects
REPO_SKIP = ("node_modules", "transcripts")  # dot-dirs (.git, .claude, …) are skipped as well
REPO_PATS = ("docs/*.md", "docs/record/*.md", "*.md",
             ".claude/worktrees/*/docs/*.md", ".claude/worktrees/*/docs/record/*.md", ".claude/worktrees/*/*.md")


def repo_roots(root, depth=REPO_DEPTH):
    """Folders under root that hold docs: any folder with a `.git` (a dir or a file) at depth 1..4,
    and, as before the walk existed, a folder at depth 1..2 that has docs/ or .claude/worktrees/
    without one. Only a `.git` stops the descent (a group folder with its own docs/ still has repos
    below it); dot-dirs, node_modules and transcripts are never entered, which keeps the walk near
    the cost of the old twelve globs."""
    found = []

    def walk(d, k):
        try:
            entries = sorted(os.scandir(d), key=lambda e: e.name)
        except OSError:
            return
        for e in entries:
            if e.name.startswith(".") or e.name in REPO_SKIP:
                continue
            try:
                if not e.is_dir():
                    continue
            except OSError:
                continue
            if os.path.lexists(os.path.join(e.path, ".git")):
                found.append(Path(e.path))
                continue
            if k <= 2 and (os.path.isdir(os.path.join(e.path, "docs"))
                           or os.path.isdir(os.path.join(e.path, ".claude", "worktrees"))):
                found.append(Path(e.path))
            if k < depth:
                walk(e.path, k + 1)

    walk(str(root), 1)
    return found


def memo_files(root):
    """Yield (path, repo label) for every candidate doc under root: a repo's docs/*.md or top-level
    *.md, repos up to four levels under root (repo_roots; two until 2026-10-10, which hid
    films/productions/<group>/<slug>), and a worktree's copy when its checkout's own does not exist
    (a memo not launched yet; one row per doc however many worktrees hold it, the newest). Shared by
    `list` and `open`, so both see the same files. Top level since 2026-09-29: a memo in another
    repo sat at the repo root, and this list never showed it (docs/feedback-2026-09-29.md, R5)."""
    root = Path(root)
    seen = set()
    wt = {}  # (repo path, path after the worktree) → (mtime, path, label): the newest copy wins
    for base in repo_roots(root):
        for pat in REPO_PATS:
            for p in base.glob(pat):
                if p in seen:
                    continue
                seen.add(p)
                repo = repo_label(root, p)
                if repo is None:
                    continue
                rel = p.relative_to(root).parts
                if ".claude" not in rel:
                    yield p, repo
                    continue
                k = rel.index(".claude")
                try:
                    mt = p.stat().st_mtime
                except OSError:
                    continue
                key = (rel[:k], rel[k + 3:])
                if key not in wt or mt > wt[key][0]:
                    wt[key] = (mt, p, repo)
    for _, p, repo in wt.values():
        yield p, repo


def repo_label(root, p):
    """The repo label `list` shows for a doc, or None when it is not a memo's place: the checkout has
    it (a worktree copy is its branch's edit), a folder's stray *.md, a `.claude` that is no worktree."""
    rel = p.relative_to(root).parts
    if ".claude" in rel:
        k = rel.index(".claude")
        if rel[k + 1:k + 2] != ("worktrees",):
            return None
        if root.joinpath(*rel[:k], *rel[k + 3:]).exists():
            return None  # the checkout has this memo; the worktree copy is its branch's edit
        if rel[k + 3:k + 4] == ("docs",) and root.joinpath(*rel[:k], "docs", "record", rel[-1]).exists():
            return None  # …under docs/record/: a worktree forked before the docs map moved it
        return "/".join(rel[:k]) + "@" + rel[k + 2]
    if rel[-2] == "docs":
        return "/".join(rel[:-2])
    if rel[-2:-1] == ("record",) and rel[-3:-2] == ("docs",):
        return "/".join(rel[:-3])
    if root.joinpath(*rel[:-1], ".git").exists():
        return "/".join(rel[:-1])  # a repo's top level; any other folder's *.md is not a memo
    return None


def short_repo(label):
    """What the repo column shows: the last two path segments (`docu/220-film`, not
    `films/productions/docu/220-film`), `@branch` kept. The JSON keeps the full label."""
    base, at, wt = label.partition("@")
    return "/".join(base.split("/")[-2:]) + at + wt


def list_memos(root, limit=12):
    """Recent memos with decisions, newest first (files: memo_files). Unanswered is `answered()`'s."""
    found = []
    for p, repo in memo_files(root):
        try:
            text = p.read_text()
            mtime = p.stat().st_mtime
        except (OSError, UnicodeDecodeError):
            continue
        if not maybe_memo(text):
            continue
        try:
            lines, items, _ = parse(text)
        except Stop as e:
            print("memo: skipped %s: %s" % (p, e), file=sys.stderr)
            continue
        if not items:
            continue
        found.append({"path": str(p), "repo": repo, "title": title_of(text, p.stem),
                      "decisions": len(items), "open": sum(1 for it in items if not answered(it, lines)),
                      "mtime": mtime,
                      "modified": dt.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")})
    found.sort(key=lambda f: f["mtime"], reverse=True)
    found = group_sets(found[:limit] if limit else found)
    for f in found:
        del f["mtime"]
        try:  # E14's column, for the rows shown only: it costs two git calls a doc
            rv = review_of_file(f["path"])[0]
            f["review"] = rv and review_phrase(rv)
        except Exception:
            f["review"] = None
        kl = keel_card(f["path"])
        if kl:
            f["keel"] = kl
        try:  # G1's and G5's inputs (entry S10): when it was handed over, and what the owner kept of the picks
            p = Path(f["path"])
            top = Path(git(p.parent, "rev-parse", "--show-toplevel").stdout.strip())
            f["born"] = doc_born(top, p.resolve().relative_to(top.resolve()).as_posix(), p)
        except (Stop, ValueError, OSError):
            f["born"] = None
        ps = pick_stats(f["path"])
        if ps:
            f["picks"] = ps
    return found


def pick_stats(path):
    """{kept, overruled, n4, o4} over the items the owner answered with a letter against a bare pick: kept
    when his letter is the Recommended one (or the form's `= recommended` take), overruled otherwise;
    n4 and o4 the same for items with four or more options. Conditional picks, yolo's and the stand's
    picks and answers that name no letter are left out. None when nothing counts (G5 of the entry)."""
    p = Path(path)
    try:
        lines, items, _ = parse(p.read_text())
    except (OSError, UnicodeDecodeError, Stop):
        return None
    by = written_by(lines)
    k = o = n4 = o4 = 0
    for it in items:
        ans, rec = (it["answer"] or "").strip(), (it["recommended"] or "").strip()
        if not ans or not rec or CONDITIONAL_RE.search(rec) or YOLO_ANSWER_RE.match(ans) or not owner_answered(it, lines, by, p):
            continue
        if re.match(r"^=\s*recommended\b", ans, re.I):
            kept = True
        else:
            a, r = LETTER_RE.match(ans), LETTER_RE.match(rec)
            if not (a and r):
                continue
            kept = a.group(1) == r.group(1)
        k, o = k + kept, o + (not kept)
        if len(it["options"]) >= 4:
            n4, o4 = n4 + 1, o4 + (not kept)
    return {"kept": k, "overruled": o, "n4": n4, "o4": o4} if k + o else None


def keel_card(path):
    """{word, steps: [k, j] or None} of a doc that carries the Keel (a Status line or an Action plan),
    else None — what the board's memo card shows beside the review word (entry S5). A component of a
    set reads its steps from the entry. Never raises: the board must render without it."""
    try:
        p = Path(path)
        d = keel_derive(p.read_text(), p)
    except (OSError, UnicodeDecodeError, Stop):
        return None
    if not d["status"] and not d["steps"]:
        return None
    return {"word": d["word"], "steps": list(d["plan"]) if d["plan"] and d["plan"][1] else None}


# ----------------------------------------------------------------------------- open

# the label may carry a date: `**Status (2026-10-10):** resolved`
STATUS_RE = re.compile(r"^[\s>*_-]*status\s*(?:\([^)]*\))?[*_]*\s*:[*_]*\s*(\S.*)$", re.I)
PM_NAME_RE = re.compile(r"post-?mortem", re.I)
PM_HEAD_RE = re.compile(r"^#{1,6}\s+[*_`]*post-?mortem", re.I)
# a word of its own: `open-sourced`, `opened` and `resolvedish` are not statuses
OPEN_RE = re.compile(r"open(?![\w-])", re.I)
RESOLVED_RE = re.compile(r"resolved(?![\w-])", re.I)
OPEN_KINDS = ("post-mortem", "decisions", "open")
NOT_ARCHIVED = "resolved, not archived — git mv to docs/record/"
OPEN_LEGEND = ("post-mortem: open until its Status line says `resolved <date> — <how verified>` and it is "
               "`git mv`'d to docs/record/ (resolved but still outside it is listed too) · decisions: D-items "
               "nobody answered, or a doc that will not parse · open: `Status: open — …` in the first 15 lines")


def status_of(lines):
    """The text of the first `Status:` line in a doc's first 15 lines (bold, a `>` quote, a list
    marker or a dated label before the colon are fine), else None."""
    for l in lines[:15]:
        m = STATUS_RE.match(l)
        if m:
            return m.group(1).strip().strip("*_ ").strip()
    return None


def open_memos(root):
    """One row per open doc under root, of three kinds (docs/opensource.md, post-mortems; the owner,
    2026-10-10: "track all open postmortems together with the decisions and open design docs"):
    `post-mortem` — a docs/*.md named or headed post-mortem, open unless its Status line says
    `resolved` (resolved but still outside docs/record/ is a row too: it was never archived);
    `decisions` — D-items nobody answered (`answered()`'s rule, as `list`), or a doc whose D-list
    does not parse (a duplicate id): it is never silently dropped; `open` — any other doc with
    `Status: open`. Files are `list`'s (memo_files), minus docs/record/, which is the archive. No
    git, no review column: the session start calls this. A file that vanishes or cannot be read is
    skipped, never fatal. Post-mortems first, then decisions, then open docs, each newest first."""
    rows = []
    for p, repo in memo_files(root):
        if p.parent.name == "record" and p.parent.parent.name == "docs":
            continue  # the archive
        try:
            text = p.read_text()
            mtime = p.stat().st_mtime
        except (OSError, UnicodeDecodeError):
            continue
        lines = text.split("\n")
        status = status_of(lines)
        title = title_of(text, p.stem)
        first_head = next((l for l in lines if HEADING_RE.match(l.strip())), "")
        pm = p.parent.name == "docs" and bool(PM_NAME_RE.search(p.name) or PM_HEAD_RE.match(first_head.strip()))
        n = unanswered = 0
        bad = None
        if maybe_memo(text):
            try:
                dlines, items, _ = parse(text)
                n = len(items)
                unanswered = sum(1 for it in items if not answered(it, dlines))
            except Stop as e:
                bad = "unparseable — %s" % e
        is_open = bool(status and OPEN_RE.match(status))
        tail = status
        if is_open:
            tail = status[OPEN_RE.match(status).end():].lstrip(" \t—–-:*_").strip() or "open"
        decided = bad or ("%d of %d unanswered" % (unanswered, n) if unanswered else None)
        found = []
        if pm and status and RESOLVED_RE.match(status):
            found.append(("post-mortem", NOT_ARCHIVED))
            if decided:
                found.append(("decisions", decided))
        elif pm:
            what = tail if status else "no Status line"
            if bad:
                what += " · " + bad
            elif unanswered:
                what += " · %d of %d decisions unanswered" % (unanswered, n)
            found.append(("post-mortem", what))
        elif decided:
            found.append(("decisions", decided))
        elif is_open:
            found.append(("open", tail))
        for kind, what in found:
            rows.append({"kind": kind, "repo": repo, "title": title, "what": what, "path": str(p),
                         "modified": dt.datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M"),
                         "_mtime": mtime})
    rows.sort(key=lambda r: (OPEN_KINDS.index(r["kind"]), -r["_mtime"]))
    rows = [r for k in OPEN_KINDS for r in group_sets([x for x in rows if x["kind"] == k])]
    for r in rows:
        del r["_mtime"]
    return rows


def group_sets(rows):
    """Rows in their order, except that a nested set's files sit together where its first row was:
    the entry first, then its components in file order (shape section 3: `open` and `list` show one
    row per file, the entry first). A component row carries `set`, its entry's path; a file in no set
    is untouched. Reads only the folder of each doc that looks dated."""
    keys = {}
    for r in rows:
        try:
            st = set_of(r["path"]) if SET_STEM_RE.match(Path(r["path"]).stem) else None
        except Exception:
            st = None
        if st:
            keys[r["path"]] = (str(st["entry"]), [str(q) for q in st["files"]])
            if Path(r["path"]).resolve() != st["entry"]:
                r["set"] = str(st["entry"])
    out, done = [], set()
    for r in rows:
        k = keys.get(r["path"])
        if not k:
            out.append(r)
            continue
        if k[0] in done:
            continue
        done.add(k[0])
        members = [x for x in rows if keys.get(x["path"], (None,))[0] == k[0]]
        order = {f: n for n, f in enumerate(k[1])}
        out += sorted(members, key=lambda x: order.get(str(Path(x["path"]).resolve()), len(order)))
    return out


def open_counts(rows):
    """{kind: n} for the session-start line."""
    return {k: sum(1 for r in rows if r["kind"] == k) for k in OPEN_KINDS}


# ----------------------------------------------------------------------------- git

class Stop(Exception):
    pass


class Uncommitted(Stop):
    """`sheep` refused a doc with uncommitted changes — not a failed deploy: on a claude/* branch the
    checkpoint commits it at Stop and deploys then."""


GIT_TIMEOUT = None  # seconds; hooks/branches.py sets it — the session start has a budget, a CLI run none


def git(top, *args, check=True):
    try:
        r = subprocess.run(["git", "-C", str(top), *args], capture_output=True, text=True, timeout=GIT_TIMEOUT)
    except subprocess.TimeoutExpired:
        r = subprocess.CompletedProcess(args, 124, "", "timed out after %ss" % GIT_TIMEOUT)
    if check and r.returncode:
        raise Stop("git %s: %s" % (" ".join(args), (r.stderr or r.stdout).strip()))
    return r


def locate(memo):
    """(file, repo top, branch, path in repo, owner/repo) — every part read from git, none guessed."""
    p = Path(memo).expanduser().resolve()
    if not p.is_file():
        raise Stop("%s: no such file" % memo)
    top = Path(git(p.parent, "rev-parse", "--show-toplevel").stdout.strip())
    b = git(top, "symbolic-ref", "-q", "--short", "HEAD", check=False)
    if b.returncode:
        raise Stop("%s: detached HEAD — no branch to link" % top)
    url = git(top, "config", "--get", "remote.origin.url", check=False).stdout.strip()
    m = GITHUB_RE.match(url)
    if not m:
        raise Stop("%s: origin is not on GitHub (%s)" % (top, url or "no origin"))
    return p, top, b.stdout.strip(), p.relative_to(top).as_posix(), m.group(1)


def fetch(top, branch):
    """Update origin/<branch>. Returns None, or why the branch is not on GitHub."""
    r = git(top, "fetch", "-q", "origin", "+%s:refs/remotes/origin/%s" % (branch, branch), check=False)
    if r.returncode == 0:
        return None
    if "couldn't find remote ref" in r.stderr:
        return "branch %s is not on GitHub" % branch
    raise Stop("fetch failed (%s) — nothing checked" % r.stderr.strip())


def blob(top, ref, rel):
    r = git(top, "rev-parse", "-q", "--verify", "%s:%s" % (ref, rel), check=False)
    return r.stdout.strip() or None


def in_place_of(repo):
    """The records `repo` writes on its main (.claude/workflow.json `in_place`), normalized —
    None when it declares none (no opt-in, the no-workflow marker, no key): then any path goes."""
    repo = Path(repo)
    if (repo / ".claude" / "no-workflow").exists():
        return None
    try:
        v = json.loads((repo / ".claude" / "workflow.json").read_text()).get("in_place")
    except (OSError, ValueError, AttributeError):
        return None
    if not isinstance(v, list):
        return None
    return [e.strip("/") for e in v if isinstance(e, str) and e.strip("/")] or None


def is_in_place(entries, rel):
    return any(rel == e or rel.startswith(e + "/") for e in entries)


def push_hint(top, branch, rel):
    """How to get `rel` onto GitHub. A knowledge repo's main takes only its in-place records
    straight; a doc there is gated, and a doc to be answered belongs on its own branch anyway
    (rule: the overlay's rules), so the hint is knowledge-commit's --open/--in pair."""
    if top.name in KNOWLEDGE and branch == "main":
        records = in_place_of(top)
        on_workflow = (top / ".claude").is_dir() and not (top / ".claude" / "no-workflow").exists()
        if not on_workflow or (records and is_in_place(records, rel)):
            return "%s %s -m '<msg>' %s" % (tool_cmd("knowledge-commit"), top.name, rel)
        return ("%s %s --open <slug>, move %s under the path it prints, "
                "then link that copy (push it from a session opened in that worktree; another repo's session cannot run git there)"
                % (tool_cmd("knowledge-commit"), top.name, rel))
    if branch.startswith("claude/"):
        t = shlex.quote(str(top))
        return "git -C %s add -- %s && git -C %s commit -m '<msg>' -- %s && git -C %s push -u origin %s" % (
            t, shlex.quote(rel), t, shlex.quote(rel), t, branch)
    return "launch it on %s the repo's way (/finish), then link again" % branch


def urls(slug, branch, rel):
    ref = quote(branch, safe="/")
    path = quote(rel, safe="/")
    return ("https://github.com/%s/blob/%s/%s" % (slug, ref, path),
            "https://github.com/%s/edit/%s/%s" % (slug, ref, path))


def on_github(p, top, branch, rel, pending=False):
    """(why not, note): why is None when GitHub holds this copy of the memo (or a newer one:
    answers typed there), else why not, with the fix. Fetches. `pending` (url on a claude/*
    branch): a copy that is only ahead of GitHub's — uncommitted or unpushed, nothing split, the
    branch already on GitHub — passes with a note, because the checkpoint hook commits and
    pushes it at this turn's Stop and its stale-link check blocks the reply if that push fails.
    Without it, a turn that writes a D-list could never end with its link (review 2026-10-04)."""
    missing = fetch(top, branch)
    remote = None if missing else blob(top, "refs/remotes/origin/" + branch, rel)
    here = git(top, "hash-object", str(p)).stdout.strip()
    committed = here == blob(top, "HEAD", rel)
    push = "git -C %s push -u origin %s" % (shlex.quote(str(top)), branch)
    if remote is None:
        return "%s is not on GitHub yet (%s). Push it: %s" % (
            rel, missing or "not on origin/" + branch, push if committed else push_hint(top, branch, rel)), None
    if here == remote:
        return None, None
    origin = "refs/remotes/origin/" + branch
    base = git(top, "merge-base", "HEAD", origin, check=False).stdout.strip()
    if base and here == blob(top, base, rel):
        # this side never touched the memo since the two parted: GitHub's copy is the newer one
        return None, "GitHub has commits this checkout lacks (answers?) — memo pull %s" % shlex.quote(str(p))
    if git(top, "merge-base", "--is-ancestor", origin, "HEAD", check=False).returncode != 0:
        dirty = git(top, "status", "--porcelain", "--", rel).stdout.strip()
        first = ("git -C %s commit -m '<msg>' -- %s, then " % (shlex.quote(str(top)), shlex.quote(rel))) if dirty else ""
        return ("GitHub's %s has commits this checkout lacks (answers typed there?) and this one changed the "
                "memo too: the two have split. Take them in, then push: %spython3 %s pull %s, "
                "then git -C %s push -u origin %s" % (branch, first, tool_cmd("keel"), shlex.quote(str(p)), shlex.quote(str(top)), branch)), None
    if pending:
        return None, "pending: GitHub gets this copy at this turn's Stop (the checkpoint pushes it, then re-checks the link)"
    head = git(top, "rev-parse", "HEAD").stdout.strip()
    return "the copy here differs from GitHub's (%s at %s). %s: %s" % (
        rel, head[:7], "Push it" if committed else "Commit and push it first", push if committed else push_hint(top, branch, rel)), None



# The "GitHub holds this copy" rule lives in three places: on_github (fetches; names the split
# case), origin_holds (no fetch, for paste-paths) and hooks/checkpoint.py's stale_link_block (the
# hook's own git, no import of this script). Change one, change all three.
def origin_holds(top, branch, rel, path):
    """Does origin/<branch>, as last fetched, hold this copy (or a newer one)? No fetch — for
    bin/paste-paths' Stop hook, which must not spell out an edit URL GitHub cannot show
    (review 2026-10-04). Same rule as `on_github`: equal blobs, or this side never touched the
    file since the two parted."""
    origin = "refs/remotes/origin/" + branch
    here = git(top, "hash-object", str(path), check=False).stdout.strip()
    there = git(top, "rev-parse", "-q", "--verify", "%s:%s" % (origin, rel), check=False).stdout.strip()
    if here and here == there:
        return True
    base = git(top, "merge-base", "HEAD", origin, check=False).stdout.strip()
    return bool(base and here and here == git(top, "rev-parse", "-q", "--verify", "%s:%s" % (base, rel), check=False).stdout.strip())

def url(memo):
    """`line` under its old name (since 2026-10-07). Until then it printed `local:`, `answer:` (the
    edit URL) and `read:` on three lines; every hook message, skill and habit that still says
    `memo url` now gets the one hand-over line instead of the retired shape."""
    return line(memo)


def link(memo):
    """`/keel <doc>`: the title and the decision count, then the hand-over line (`line`)."""
    p = Path(memo).expanduser().resolve()
    if not p.is_file():
        raise Stop("%s: no such file" % memo)
    text = p.read_text()
    n = item_count(text)
    print("%s — %d decision%s" % (title_of(text, p.stem), n, "" if n == 1 else "s"))
    return line(p)


# ----------------------------------------------------------------------------- line (2026-10-07)

# The hand-over line (the owner, 2026-10-04/05; enforced everywhere 2026-10-07 — "It should apply to
# every single message that asks for Dx to be answered … in every repo I work on"). Every doc
# shown to the owner in chat is one line, in this order:
#
#     [course](<the page>) | [github](<blob URL>) | [space](<the page, without D-items>) — [<file name>](<absolute path>#L1)
#
# Labels exactly course, github, space. `course` and `space` are the same spacesheep page (2026-10-14):
# `course` when the doc has D-items, since the page is then the Course doc's form (the label was
# `form` until 2026-10-17, the owner: "rename it to course, which is what it's named now"), `space` when
# it has none; either
# left out only where `never_mirrored` says so. `github` the read (blob) view, one link, never the
# edit page; the file name links the absolute path with #L1, which VS Code opens as text, not preview.
# Other formats (a claude.ai artifact) follow `space` as more `|` links. `line` prints it and
# `line_findings` is the one reader: bin/paste-paths' Stop hook and hooks/checkpoint.py both
# call it, so what the hooks demand is exactly what `line` can print. Until 2026-10-07 the spec
# lived only in a project's auto-memory, and the hooks demanded the older local + edit shape.
LINE_LABELS = ("course", "github", "space")
LINE_LINK_RE = re.compile(r"\[([^\]\n]*)\]\((<[^>\n]+>|[^)\s]+)\)")
LINE_CHAIN_RE = re.compile(r"((?:\[[^\]\n]*\]\((?:<[^>\n]+>|[^)\s]+)\) \| )*\[[^\]\n]*\]\((?:<[^>\n]+>|[^)\s]+)\)) — $")
FORM_URL_RE = re.compile(r"^http://127\.0\.0\.1:\d+/[A-Za-z0-9_-]+/$")
# The course page's service: `keel/course-site` (its web app, one URL) and `keel/course-mcp` (its MCP
# endpoint) in the regatta config dir, each with its environment override for a suite; absent,
# spacesheep's public addresses, as before the keys.
SHEEP_APP = (os.environ.get("MEMO_SHEEP_APP") or (_config_lines("keel/course-site") or ["https://spacesheep.dev"])[0]).rstrip("/")
SHEEP_MCP = os.environ.get("MEMO_SHEEP_MCP") or (_config_lines("keel/course-mcp") or ["https://mcp.spacesheep.dev/mcp"])[0]
SPACE_URL_RE = re.compile(r"^https://(?:[\w-]+\.)*%s/\S+$" % re.escape(re.sub(r"^https?://", "", SHEEP_APP)))
FORM_FRESH = 30 * 60  # a running form with less left than this is not reused: the owner may still be reading
UNATTENDED_ENV = "CLAUDE_UNATTENDED"  # hooks/checkpoint.py's name: a run nobody watches opens no memo serve form


def item_count(text):
    """D-items as `parse` reads them; a doc it refuses (an id twice) still asks, so it counts one."""
    try:
        return len(parse(text)[1])
    except Stop:
        return 1 if ANSWER in text else 0


def serve_dir():
    return state_dir() / "serve"


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True
    return True


def register_serve(path, url, idle):
    """One file per running `serve`, `serve/<pid>.json`: what `line` reuses and the hooks check a
    form link against. Never raises — a form that could not register still serves."""
    import time
    try:
        d = serve_dir()
        d.mkdir(parents=True, exist_ok=True)
        f = d / ("%d.json" % os.getpid())
        f.write_text(json.dumps({"path": str(Path(path).resolve()), "url": url, "pid": os.getpid(),
                                 "started": time.time(), "deadline": time.time() + idle}))
        return f
    except OSError:
        return None


def live_serves(path):
    """The registered `serve` processes for this doc that still run, newest first. A serve killed
    by a signal never runs the `finally` that removes its file, so a dead pid's file goes here, and
    an entry past its deadline is not trusted: by then the pid may be another process's (review
    2026-10-09)."""
    import time
    want = os.path.realpath(str(path))
    out = []
    try:
        files = list(serve_dir().glob("*.json"))
    except OSError:
        return out
    for f in files:
        try:
            e = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(e, dict):
            continue
        if not pid_alive(e.get("pid")):
            try:
                f.unlink()
            except OSError:
                pass
            continue
        if float(e.get("deadline") or 0) > time.time() and os.path.realpath(str(e.get("path", ""))) == want:
            out.append(e)
    return sorted(out, key=lambda e: -float(e.get("started") or 0))


def form_url(p, timeout=8.0):
    """(url, why not): a running form for this doc with FORM_FRESH left, else a fresh `serve`,
    started detached (its own session, so the Bash call that ran `line` can end; output to a log
    beside the registry). A detached form wakes no session on Save — the skill starts `serve` in
    the background first when the session should go on after the Save, and `line` reuses it."""
    import time
    for e in live_serves(p):
        if float(e.get("deadline") or 0) - time.time() >= FORM_FRESH and FORM_URL_RE.match(str(e.get("url", ""))):
            return e["url"], None
    d = serve_dir()
    try:
        d.mkdir(parents=True, exist_ok=True)
        for f in d.glob("*.log"):  # a detached form's output; nobody reads it after a day
            if time.time() - f.stat().st_mtime > 86400:
                f.unlink()
        log = open(d / ("%s-%d.log" % (slugify(p.stem), int(time.time() * 1000))), "w")
    except OSError as e:
        return None, "cannot write the form's log (%s)" % e
    with log:
        proc = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve", str(p)],
                                stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                start_new_session=True, close_fds=True)
    reg = d / ("%d.json" % proc.pid)
    end = time.time() + timeout
    while time.time() < end:
        if reg.exists():
            try:
                return json.loads(reg.read_text())["url"], None
            except (OSError, ValueError, KeyError):
                pass
        if proc.poll() is not None:
            tail = (Path(log.name).read_text().strip().splitlines() or ["exit %d" % proc.returncode])[-1]
            return None, "memo serve stopped at once: %s" % tail[:160]
        time.sleep(0.05)
    return None, "memo serve did not start within %ds (pid %d; log %s)" % (timeout, proc.pid, log.name)


def md_target(path):
    s = str(path)
    return "<%s>" % s if re.search(r"[\s()<>]", s) else s


def line_plan(path):
    """What the hand-over line of `path` owes, read from git without a fetch (the Stop hooks call
    it): {path, name, text, items, top, branch, rel, slug, repo, owed: {part: None or why not}}.
    A part maps to None when owed, else to the reason it is left out. Reasons that are the rule
    (no D-items, no GitHub origin, never mirrored) and reasons that are trouble read alike here;
    `line` says which on stderr."""
    p = Path(path).expanduser().resolve()
    text = p.read_text()
    plan = {"path": p, "name": p.name, "text": text, "items": item_count(text), "top": None,
            "branch": None, "rel": None, "slug": None, "repo": None}
    # light L5: a doc answered in chat (its Gate line says light, no item open) owes no form. Only that
    # doc: an old-shape doc's `➤ Answer:` is pre-filled with the pick, so "every item answered" alone
    # took the form off docs still handed to the owner (test_paste_paths, test_checkpoint; B1 run 2026-10-19)
    try:
        lines_, _, open_ = light_open(text)
        gate = gate_of(lines_)
        plan["open"] = len(open_) if (gate and gate["mode"] == "light") else plan["items"]
    except Stop:  # an id twice: item_count's one item, still asking
        plan["open"] = plan["items"]
    owed = {}
    r = git(p.parent, "rev-parse", "--show-toplevel", check=False)
    if r.returncode:
        owed["course"] = owed["github"] = owed["space"] = "not in a git repo"
        plan["owed"] = owed
        return plan
    top = Path(r.stdout.strip())
    plan["top"], plan["rel"] = top, p.relative_to(top.resolve()).as_posix()
    b = git(top, "symbolic-ref", "-q", "--short", "HEAD", check=False)
    plan["branch"] = b.stdout.strip() if b.returncode == 0 else None
    m = GITHUB_RE.match(git(top, "config", "--get", "remote.origin.url", check=False).stdout.strip())
    plan["slug"] = m.group(1) if m else None
    try:
        plan["repo"] = repo_name(top)
    except Stop:
        plan["repo"] = top.name
    if not plan["slug"]:
        owed["github"] = "origin is not on GitHub"
    elif not plan["branch"]:
        owed["github"] = "detached HEAD — no branch to link"
    elif plan["branch"].startswith("claude/") or origin_holds(top, plan["branch"], plan["rel"], p):
        owed["github"] = None  # a claude/* branch: the checkpoint pushes at Stop (on_github's pending)
    else:
        owed["github"] = "GitHub's %s lacks this copy — %s" % (plan["branch"], push_hint(top, plan["branch"], plan["rel"]))
    why = never_mirrored(plan["repo"], plan["rel"])
    if why:
        owed["space"] = why
    elif not plan["branch"]:
        owed["space"] = "detached HEAD — no branch to name the version by"
    elif os.environ.get("CLAUDE_HOOK_NO_SHEEP"):
        owed["space"] = "CLAUDE_HOOK_NO_SHEEP is set — no mirror"
    elif not sheep_bin():
        owed["space"] = "no spacesheep CLI on this Mac"
    elif not plan["branch"].startswith("claude/") and git(top, "status", "--porcelain", "--", plan["rel"], check=False).stdout.strip():
        # `sheep` refuses a doc with uncommitted changes, and off claude/* no checkpoint commits it
        # at Stop: owing the page would block the very line `keel line` printed (review 2026-10-09)
        owed["space"] = "uncommitted changes and no checkpoint to commit them — commit first"
    elif not sheep_key():
        owed["space"] = "no SPACESHEEP_KEY — nothing can deploy the page"
    else:
        owed["space"] = None
    # One page, two names (2026-10-14): with D-items the spacesheep page is the form — answered
    # there, in a VS Code tab through the mirror or on the phone — and goes as `course`; without,
    # it is the read copy and goes as `space`. Where no page can be made (the vault, `rules/`,
    # no CLI or key, a doc off claude/* not committed), memo serve's 127.0.0.1 form is the form,
    # as before 2026-10-14 — bar an unattended run or a Remote Control session, where 127.0.0.1
    # opens nothing (review 2026-10-04, 2026-10-09).
    plan["form_via"] = None
    if not plan["items"]:
        owed["course"] = "no D-items — nothing to answer, so no form to link"
    elif not plan["open"]:
        # light L5 (B1): a doc answered in chat is handed over in the same turn, and checkpoint.py asks for
        # the line then; with nothing left to answer the page goes as the read copy, `space`
        owed["course"] = "every D-item is answered in chat (Gate: light) — nothing left for a form"
    else:
        page_why, owed["space"] = owed["space"], "the page is the form — it goes as course"
        if page_why is None:
            owed["course"], plan["form_via"] = None, "page"
        elif os.environ.get(UNATTENDED_ENV):
            owed["course"] = "%s, and an unattended run opens no local form" % page_why
        elif os.environ.get("CLAUDE_CODE_ENTRYPOINT") == "sdk-cli":
            owed["course"] = "%s, and a Remote Control session's 127.0.0.1 form would not open where %s reads it" % (page_why, WHO)
        else:
            owed["course"], plan["form_via"] = None, "serve"
    plan["owed"] = owed
    return plan


def file_link(plan):
    # `<…>` around the whole destination, #L1 inside: CommonMark ends a `<…>` destination at `>`
    return "[%s](%s)" % (plan["name"], md_target("%s#L1" % plan["path"]))


def line(memo):
    """The hand-over line for `memo`; for the entry of a nested set, the entry's line and then one per
    component, in file order (shape D4-A, the "one line" rule amended by entry S8: one line per file of
    a set, printed together). Exit 1 when any file's line misses a part it owes."""
    p = Path(memo).expanduser().resolve()
    if not p.is_file():
        raise Stop("%s: no such file" % memo)
    try:
        st = set_of(p)
    except Exception:
        st = None
    if not st or st["entry"] != p:
        return line_one(p)
    rc = 0
    for q in st["files"]:
        rc = max(rc, line_one(q))
    return rc


def line_one(memo):
    """Print the hand-over line for `memo` — and do what it takes: with D-items the form, the doc's
    spacesheep page (`sheep`) or memo serve's where no page can be made (`form_url`); GitHub's read view once GitHub holds this copy (`on_github`, which fetches; on a
    claude/* branch a copy only ahead passes, pending this Stop's push), the spacesheep mirror
    (`sheep`; a doc with uncommitted changes is refused, so commit first). A part that cannot be
    made is left out, never faked, with one `keel line: no <part> — <why>` line on stderr; exit 1
    when a part was owed and is missing, 0 otherwise. The lint goes to stderr too."""
    p = Path(memo).expanduser().resolve()
    if not p.is_file():
        raise Stop("%s: no such file" % memo)
    plan = line_plan(p)
    owed, parts, gaps = plan["owed"], [], []

    def miss(part, why):
        # exit 1 only for a part the plan owes: what the Stop hooks demand is what counts here
        print("keel line: no %s — %s" % (part, why), file=sys.stderr)
        if owed[part] is None:
            gaps.append(part)

    page = "course" if plan["items"] and plan["open"] else "space"
    page_link, served = None, False
    if page == "space":
        miss("course", owed["course"])  # "no D-items": said, never a gap
    if plan.get("form_via") == "serve" or (page == "space" and owed["space"] is not None):
        pass  # no page: the form is memo serve's (below), and a page without D-items is not owed
    elif owed[page] is None:  # the page deploys first: with D-items it is the line's first link
        try:
            u, _, _ = sheep(p, plain=True)
            page_link = "[%s](%s)" % (page, chat_page(u))
        except Exception as e:  # Stop, or a bug in the mirror: the rest of the line still prints
            why = str(e) if isinstance(e, Stop) else "%s: %s" % (type(e).__name__, e)
            if isinstance(e, Uncommitted) and (plan["branch"] or "").startswith("claude/"):
                # Pending, not failed: the checkpoint commits the doc at Stop and deploys the page
                # right after. A detached memo-serve form here was accepted by the Stop hook and
                # became the form the owner got (review 2026-10-16). The pin's page, if any, shows the
                # previous commit; with none, the form is missing and the hook asks again once the
                # page exists.
                pin = pins().get("%s@%s:%s" % (plan["repo"], plan["branch"], plan["rel"])) or {}
                if pin.get("url"):
                    page_link = "[%s](%s)" % (page, chat_page(pin["url"]))
                    print("keel line: the page shows the previous commit — %s; the checkpoint commits the doc "
                          "and redeploys it at Stop" % why, file=sys.stderr)
                else:
                    miss(page, "%s; the checkpoint commits the doc and deploys the page at Stop" % why)
            elif page == "course" and not os.environ.get(UNATTENDED_ENV) and os.environ.get("CLAUDE_CODE_ENTRYPOINT") != "sdk-cli":
                print("keel line: no page — %s; the form is memo serve's instead" % why, file=sys.stderr)
                plan["form_via"] = "serve"
            else:
                miss(page, why)
    if page == "course" and plan.get("form_via") == "serve":
        try:
            u, why = form_url(p)
        except Exception as e:
            u, why = None, "%s: %s" % (type(e).__name__, e)
        if u:
            page_link, served = "[course](%s)" % u, True
        else:
            miss("course", why)
    elif page == "course" and owed["course"] is not None:
        miss("course", owed["course"])
    elif page == "space" and owed["space"] is not None:
        miss("space", owed["space"])
    if page == "course" and page_link:
        parts.append(page_link)
    if plan["slug"] and plan["branch"]:
        try:
            why, note = on_github(p, plan["top"], plan["branch"], plan["rel"], pending=plan["branch"].startswith("claude/"))
        except Exception as e:  # a failed fetch is a Stop; anything else must not cost the line either
            why, note = str(e) if isinstance(e, Stop) else "%s: %s" % (type(e).__name__, e), None
        if why:
            miss("github", why)
        else:
            parts.append("[github](%s)" % urls(plan["slug"], plan["branch"], plan["rel"])[0])
            if note:
                print("keel line: github " + note, file=sys.stderr)
    else:
        miss("github", owed["github"])
    if page == "space" and page_link:
        parts.append(page_link)
    print((" | ".join(parts) + " — " if parts else "") + file_link(plan))
    if served:
        print("keel line: the form is memo serve's (no page); its Save wakes this session only when the "
              "session started `memo serve %s` in the background first — line reuses it" % p, file=sys.stderr)
    elif page_link:  # the page takes notes and feedback even without D-items: someone must collect them
        print("keel line: %s Save or comments wake this session only while `memo sheep wait %s` runs "
              "as its background shell" % (WHOSE, p), file=sys.stderr)
    handover_lint(plan["text"], p, out=sys.stderr)
    return 1 if gaps else 0


def line_findings(reply, path, plan=None):
    """[] when `reply` carries the hand-over line of `path`, else what is wrong with the best
    attempt, one phrase each. The reader the Stop hooks share (bin/paste-paths, checkpoint.py's
    answer_link_block). Read outside fenced blocks; one line, its links in the order above,
    ` | ` between them and ` — ` before the file link; each link checked against what this Mac
    knows: the GitHub link against `urls`, the form or the page against this doc's pin when there
    is one (else any spacesheep.dev page); a 127.0.0.1 form is memo serve's, retired."""
    from urllib.parse import unquote
    plan = plan or line_plan(path)
    p, owed = plan["path"], plan["owed"]
    want_file = os.path.realpath(str(p))
    lines = (reply or "").split("\n")
    best = None
    for raw, inside in zip(lines, fenced(lines)):
        if inside:
            continue
        for m in LINE_LINK_RE.finditer(raw):
            label, target = m.group(1).strip("`"), unquote(m.group(2).strip("<>"))
            base, _, frag = target.partition("#")
            if not base.startswith("/") or os.path.realpath(base) != want_file:
                continue
            probs = []
            if frag != "L1":
                probs.append("the file link ends #L1 (%s#L1), so VS Code opens it as text" % p)
            if label != p.name:
                probs.append("the file link's text is the file name, %s" % p.name)
            probs += _chain_findings(raw[:m.start()], plan, unquote)
            if not probs:
                return []
            if best is None or len(probs) < len(best):
                best = probs
    if best is None:
        want = [x for x in LINE_LABELS if owed.get(x) is None]
        return ["no line ends with the file link [%s](%s#L1)%s" % (
            p.name, p, (" after " + " | ".join("[%s](…)" % x for x in want) + " —") if want else "")]
    return best


def _chain_findings(prefix, plan, unquote):
    owed = plan["owed"]
    m = LINE_CHAIN_RE.search(prefix)
    links = [(a.strip(), unquote(b.strip("<>"))) for a, b in LINE_LINK_RE.findall(m.group(1))] if m else []
    probs, seen, at, other = [], {}, -1, False
    for label, u in links:
        if label in LINE_LABELS:
            i = LINE_LABELS.index(label)
            if label in seen or i < at or other:
                probs.append("the links go course | github | space, each once, then any others")
            seen[label], at = u, max(at, i)
        elif label.lower() in LINE_LABELS + ("form", "read", "answer", "edit", "page", "local", "form (read)"):
            # a known part mislabelled, or a retired shape's words (`form` until 2026-10-17): not an "other format"
            probs.append("the labels are exactly course, github, space (not %r)" % label)
        else:
            other = True
    if not m and any(owed.get(x) is None for x in LINE_LABELS):
        probs.append("the parts go on the file link's line, ` | ` between them and ` — ` before the file link")
    for label in LINE_LABELS:
        if owed.get(label) is None and label not in seen:
            probs.append("the %s link is missing" % label)
    if "github" in seen and plan["slug"] and plan["branch"]:
        if unquote(seen["github"]) != unquote(urls(plan["slug"], plan["branch"], plan["rel"])[0]):
            probs.append("the github link is not this branch's read (blob) view of %s" % plan["rel"])
    pin = pins().get("%s@%s:%s" % (plan["repo"], plan["branch"], plan["rel"])) if plan["branch"] else None
    for label in ("course", "space"):  # the doc's page, or for `course` memo serve's where none is (line_plan)
        if label not in seen:
            continue
        if FORM_URL_RE.match(seen[label]):
            # memo serve's form: the form where no page can be made, or where the deploy failed at `line`
            if label == "space":
                probs.append("the space link is a memo serve form, not the doc's spacesheep page (%s)" % seen[label])
            elif plan.get("form_via") == "page":
                probs.append("the course link is a memo serve form, but this doc has a spacesheep page — "
                             "the page is the form (memo line prints it once the doc is committed)")
            elif seen[label] not in [e.get("url") for e in live_serves(plan["path"])]:
                probs.append("the course link is not a running memo serve of this doc — memo line prints the form "
                             "(the doc's page, or a fresh serve where it has none)")
            continue
        u = page_of(seen[label])
        if not SPACE_URL_RE.match(u):
            probs.append("the %s link is not a spacesheep.dev page (%s)" % (label, u))
        elif pin and pin.get("url") and u != pin["url"]:
            probs.append("the %s link is not this doc's page (%s)" % (label, pin["url"]))
    return list(dict.fromkeys(probs))


def handover_lint(text, path, out=None):
    """The check at hand-over, printed by every command that puts the doc in front of the owner — `line`,
    `link` and `serve` (until 2026-10-05 only `link` did, and the hook and skill send sessions to
    `url` and `serve`). Findings never change the exit code: the link is still true, and a lint
    that fails for any reason says so in one line and lets the command go on (serve has printed
    its URL by then; code-review 2026-10-05). `line` sends them to stderr: its stdout is the one line."""
    out = out or sys.stdout
    try:
        errors, warnings = lint(text, path=path)
    except Exception as e:
        print("lint:   not run — %s" % e, file=out, flush=True)
        errors, warnings = [], []
    for e in errors:
        print("lint:   " + e, file=out, flush=True)
    for w in warnings:
        print("lint:   warning: " + w, file=out, flush=True)
    for w in cost_warnings(text, path):
        print("lint:   warning: " + w, file=out, flush=True)


def cost_warnings(text, path):
    """the owner, 2026-10-05: a model cost or price in a doc shows its effective cost too (bin/cost).
    The owner, 2026-10-18: and real money (a bill, rent, a domain) shows no effective figure.
    Warnings only, at hand-over and in `memo lint`; never more than six lines."""
    try:
        bare = _common().bare_costs(text)
        real = _common().real_money_effective(text)
    except Exception as e:
        return ["cost check not run — %s" % e]
    hits = sorted([(n, "shows a cost without its effective cost — `%s <list>`, " % tool_cmd("cost") +
                    "or `list-only` on a line of real money", l) for n, l in bare]
                  + [(n, "puts an effective figure on real money — write it plain, `list-only`", l) for n, l in real])
    out = ["line %d %s: %s" % (n, why, l[:100]) for n, why, l in hits[:5]]
    if len(hits) > 5:
        out.append("%d more such lines — `%s lint %s`" % (len(hits) - 5, tool_cmd("cost"), path))
    return out


def answers_of(text):
    _, items, fb = parse(text)
    lines = text.split("\n")
    return {it["id"]: (it["answer"] or "") for it in items}, "\n".join(lines[fb + 1:]).strip() if fb is not None else ""


def pull(memo):
    p, top, branch, rel, _ = locate(memo)
    missing = fetch(top, branch)
    if missing:
        raise Stop(missing + " — nothing to pull")
    ref = "refs/remotes/origin/" + branch
    if git(top, "merge-base", "--is-ancestor", ref, "HEAD", check=False).returncode == 0:
        print("nothing new on GitHub for %s" % branch)
        return 0
    if git(top, "status", "--porcelain", "--", rel).stdout.strip():
        raise Stop("%s has uncommitted changes here; commit them first (a checkpoint does at turn end)" % rel)
    before = p.read_text()
    old = git(top, "rev-parse", "HEAD").stdout.strip()
    if git(top, "merge", "-q", "--ff-only", ref, check=False).returncode == 0:
        how = "fast-forwarded"
    else:
        if git(top, "status", "--porcelain", "--untracked-files=no").stdout.strip():
            raise Stop("this branch and GitHub both moved, and uncommitted work blocks a rebase; commit it, then pull again")
        r = git(top, "rebase", "-q", ref, check=False)
        if r.returncode:
            git(top, "rebase", "--abort", check=False)
            raise Stop("rebase onto GitHub's %s conflicts — left as it was; resolve by hand:\n%s" % (branch, r.stdout + r.stderr))
        how = "rebased this branch's own commits onto GitHub's"
    after = p.read_text()
    print("%s %s (%s..%s)" % (how, branch, old[:7], git(top, "rev-parse", "--short", "HEAD").stdout.strip()))
    # after the move, not before: the GitHub commit may be the one that fixes a duplicate id
    try:
        a0, f0 = answers_of(before)
        a1, f1 = answers_of(after)
    except Stop as e:
        print("answers not compared: %s" % e)
        return 1
    changed = [k for k in a1 if a1[k] != a0.get(k)]
    for k in changed:
        print("  %s → %s" % (k, a1[k] or "(empty)"))
    print("changed: %s; unchanged: %s; feedback: %s" % (
        ", ".join(changed) or "none", ", ".join(k for k in a1 if k not in changed) or "none",
        "changed" if f1 != f0 else "none"))
    if before == after:
        print("(the memo itself did not change; GitHub's commits touched other files)")
    return 0


# ----------------------------------------------------------------------------- spacesheep

_SHEEP_TOOL = []


def sheep_tool():
    """bin/sheep as a module, loaded once: the mirror's address map (local_url, web_url) lives there."""
    if not _SHEEP_TOOL:
        from importlib.machinery import SourceFileLoader
        _SHEEP_TOOL.append(SourceFileLoader("sheep_tool", str(Path(__file__).resolve().parent / "sheep")).load_module())
    return _SHEEP_TOOL[0]


def chat_page(u):
    """A spacesheep page as chat hands it to the owner: the local mirror's address (a VS Code tab) while
    one runs — not in a Remote Control or unattended run, read on the phone or by nobody, where
    localhost opens nothing (line_plan's reasons for no memo serve form). Never fails: the
    plain URL whenever bin/sheep can't say. Committed docs keep spacesheep.dev links. The guard is
    bin/sheep's chat_url, shared with `sheep url`."""
    try:
        return sheep_tool().chat_url(u)
    except Exception:
        return u


def page_of(u):
    """The inverse for the hand-over check: a link on the running mirror counts as its page."""
    if not u.startswith("http://"):
        return u  # the common case pays for no import of bin/sheep
    try:
        return sheep_tool().web_url(u)
    except Exception:
        return u

# The mirror (docs/record/orchestration-proposal-2026-10-02.md, D4 and E3; section 8 for the reasoning).
# Git stays the record and the write path: the page is regenerated from the committed memo on
# every change and nothing is ever edited there. The owner comments on the page from the phone, and
# `sheep pull` turns those comments into the same answers document `merge` takes from the form.
#
# Read from spacesheep 1.26.0's source (2026-10-03): `deploy <dir>` needs an index.html,
# `--space <uuid>` updates, `-m` names the version, `--title` names a new space (else the
# folder's name), `--no-manifest` keeps `.spacesheep.json` out of the folder, `--json` prints the
# server's {uuid, url, sha, is_update} on stdout alone; SPACESHEEP_KEY in the environment wins
# over the CLI's stored login. Comments come from the MCP server (streamable HTTP, Bearer key,
# initialize first — what the CLI's lib/mcp.js does); a block comment is keyed by the element's
# `data-ss-id`. NOT yet seen: a real `list_comments` answer, nor `add_comment`'s and
# `resolve_comment`'s argument names beyond the docs' `uuid`, `parent_id`, `comment_id` — the
# docs suggest formatted text ("the thread's [id: …]"), so `comment_threads` reads JSON and that
# text form both, and `sheep pull` only previews until `--write`.

SHEEP_STATE = Path(os.environ.get("MEMO_SHEEP_STATE") or Path.home() / ".local/state/memo")
SHEEP_TITLE_MAX = 200  # spacesheep's stage_begin limit on a space's title
ACK = "memo:"  # the prefix of this tool's own replies, so a thread it answered is never read as the owner's
SS_ID_RE = re.compile(r"^(D\d+|b-[0-9a-f]{8}(?:-\d+)?)$")
# A text-form header that names an agent, not the owner: the Co-shepherd's real one is
# `@Co-shepherd 🐑 (asked by <the owner's e-mail>)` (2026-10-08) and carries the owner's own e-mail, so the
# words `asked by`, a sheep or robot glyph, or `(via …)` are what give it away (M3).
BOT_VIA = {"co-shepherd", "claude", "session", "agent", "bot", "mcp", "api", "spacesheep"}
BOT_HEAD_RE = re.compile(r"\b(?:Claude|bot)\b|Co-shepherd|spacesheep\b|\basked by\b|🐑|🤖|\(via\b", re.I)
DEPLOY_TIMEOUT = 25
# The page's shape. A pin of another shape is redeployed even when the memo's commit is the one it
# shows: 2 (2026-10-14) is the form, where 1 (no `fmt`) was the read-only copy; 3 (2026-10-14) the
# form as a whole document, the only shape spacesheep gives its page bridge (sheep_page); 4
# (2026-10-19) the form with the reading heartbeat, `memo-read`; 5 (2026-10-20) spacesheep's skin,
# the status word and the receipt block (RECEIPT_ID); 6 (2026-10-20) the orange toned down and the
# status as spacesheep's live pill (the owner's D1 and D4 on the test page); 7 (2026-10-21) a margin
# between the count and that pill; 8 (2026-10-22) the counter's notes and feedback as one ✎n beside
# the tally.
PAGE_FMT = 8
# The receipt (2026-10-20, the owner: "I don't think I've ever seen a receipt"). ss.emit returns nothing,
# so all a Save could say was "handed over"; nothing ever came back. Now a pull that takes the page's
# Saves answers on two paths: a live_push `replace` of the page's hidden RECEIPT_ID block, which every
# open tab hears as `ss:live` (anchor.js dispatches it after a patch, with the ids the HTML carries),
# and the pin's `receipt`, which the next deploy writes into the page — the redeploy reaches an open
# tab as a document swap (the page's script changed), and a swap restarts the page's status.
RECEIPT_ID = "keel-receipt"
# The page's Save, as an event in the space's room: {sha, items, comments, feedback, savedAt}, the
# form's answers document plus the commit the page showed. Read by live_events (MCP), which
# answers {events: [{seq, at, name, data, from: {name, seed}}], next_after} — the real shape,
# 2026-10-14. `from` is the viewer's display name, not a verified identity: the page is private to
# the owner's account unless shared, which is what makes a Save the owner's.
SAVE_EVENT = "memo-save"
OPEN_EVENT = "memo-open"  # one per page load, {sha}: drained into opens.jsonl, as memo serve's GET was
# A minute of reading, {sha}: drained into reads.jsonl, never a Save, never a wake (crew design S6,
# regatta). crew-report joins the minutes into runs with a 5-minute break — the owner, 2026-10-18: time
# on a course page is what gets charged.
READ_EVENT = "memo-read"
READ_REPEAT = 30  # s: a second heartbeat from one viewer within this is another tab on the same minute
WAIT_QUIET = 120  # sheep wait: new comments wake the session once none came for this long
WAIT_POLL = 60    # …and are looked for this often; a Save wakes it within one live_events call


def sheep_bin():
    """The CLI: $MEMO_SHEEP_BIN when set (empty or missing = none, no fallback — the tests rely on
    it), else `spacesheep` on PATH or in ~/.local/bin. Never npx: a cold npx in a Stop hook
    downloads for longer than a turn should wait."""
    import shutil
    if "MEMO_SHEEP_BIN" in os.environ:
        c = os.environ["MEMO_SHEEP_BIN"]
        return c if c and os.access(c, os.X_OK) else None
    for c in (shutil.which("spacesheep"), str(Path.home() / ".local/bin/spacesheep"), "/opt/homebrew/bin/spacesheep"):
        if c and os.access(c, os.X_OK):
            return c
    return None


def sheep_key():
    """SPACESHEEP_KEY: the environment, else the overlay's .env through bin/sheep's own reader (one
    definition of the host-file rule), else the CLI's stored login. Never printed."""
    if os.environ.get("SPACESHEEP_KEY"):
        return os.environ["SPACESHEEP_KEY"].strip().strip("'\"")
    try:
        v = sheep_tool().env_value("SPACESHEEP_KEY")
        if v:
            return v.strip().strip("'\"")
    except Exception:  # bin/sheep's Refused (Drive offline, no Full Disk Access), or no bin/sheep
        pass
    cfg = Path(os.environ.get("SPACESHEEP_CONFIG_DIR") or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "spacesheep") / "config.json"
    try:
        return (json.loads(cfg.read_text()).get("key") or "").strip() or None
    except (OSError, ValueError):
        return None


def sheep_env(cli=None):
    env = dict(os.environ)
    k = sheep_key()
    if k:
        env["SPACESHEEP_KEY"] = k
    # The CLI is a node script (`#!/usr/bin/env node`). A hook or a Remote Control session can lack
    # Homebrew's bin on PATH even when the CLI was found there, and then fails with "env: node: No
    # such file or directory" (the build Mac, 2026-10-05). The CLI's own folder usually holds the node it
    # was installed with, so it goes first; Homebrew's two prefixes go last, a fallback for a CLI
    # installed elsewhere (~/.local/bin) with node from Homebrew. Empty entries are dropped.
    first = [str(Path(cli).parent)] if cli else []
    have = [d for d in env.get("PATH", "").split(os.pathsep) if d and d not in first]
    last = [d for d in ("/opt/homebrew/bin", "/usr/local/bin") if os.path.isdir(d) and d not in have + first]
    env["PATH"] = os.pathsep.join(first + have + last)
    return env


def repo_name(top):
    """The repo's own name, from its common git dir — a worktree's folder is named for its topic."""
    common_dir = Path(git(top, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip())
    return (common_dir.parent if common_dir.name == ".git" else common_dir).name


def never_mirrored(repo, rel):
    """D4: `rules/`, `me/` and anything in the vault never leave the machine; nor the transcripts
    and the guarded repos — hooks/sheep_gate.py's PRIVATE_REPOS, the one list, case-folded — nor a
    confidential scope's repo (its private_part). Fails closed: a gate that will not load, or
    confidential scopes it cannot read, mirror nothing."""
    try:
        from importlib.machinery import SourceFileLoader
        gate = SourceFileLoader("sheep_gate", str(Path(__file__).resolve().parent.parent / "hooks" / "sheep_gate.py")).load_module()
        if getattr(gate, "confidential_roots", lambda: ())() is None:
            return "the registry's confidential scopes do not read — nothing is mirrored until they do"
        private = gate.private_part(repo)
    except Exception as exc:
        return "hooks/sheep_gate.py did not load (%s) — nothing is mirrored without the private list" % exc
    if private:
        return "%s is private — it is never mirrored" % repo
    if LAYER and repo == LAYER and rel.startswith("rules/"):
        return "rules/ is always-loaded — it is never mirrored"
    return None


def pins():
    try:
        return json.loads((SHEEP_STATE / "sheep.json").read_text())
    except (OSError, ValueError):
        return {}


def update_pin(key, change):
    """Read-modify-write one pin under a lock: parallel sessions' Stop hooks deploy at once, and a
    whole-map write from a stale read would drop another doc's pin — its next deploy would then
    make a second page, the owner's comments left on the first (review, 2026-10-03)."""
    import fcntl
    SHEEP_STATE.mkdir(parents=True, exist_ok=True)
    with open(SHEEP_STATE / "sheep.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        d = pins()
        d[key] = change(dict(d.get(key) or {}))
        tmp = SHEEP_STATE / ("sheep.json.%d.tmp" % os.getpid())
        tmp.write_text(json.dumps(d, ensure_ascii=False, indent=1, sort_keys=True))
        tmp.replace(SHEEP_STATE / "sheep.json")
        return d[key]


def page_dir(key):
    """The scratch folder a page is built in. slugify cuts at 60 characters, and 179 pins shared 148
    folders (two docs of one long branch name collided, 2026-10-15): the slug is shortened and the
    whole key's hash added. A folder made under the old name is just cache (M8)."""
    import hashlib
    return SHEEP_STATE / "pages" / ("%s-%s" % (slugify(key)[:50], hashlib.sha1(key.encode()).hexdigest()[:8]))


def sheep_where(memo):
    """(file, repo top, branch, rel, slug or None, pin key, repo name). The key carries the branch:
    two branches editing one doc get a page each, never one page flipping between them. Unlike
    `locate`, a repo whose origin is not GitHub still mirrors (the footer has no edit link)."""
    p = Path(memo).expanduser().resolve()
    if not p.is_file():
        raise Stop("%s: no such file" % memo)
    top = Path(git(p.parent, "rev-parse", "--show-toplevel").stdout.strip())
    b = git(top, "symbolic-ref", "-q", "--short", "HEAD", check=False)
    if b.returncode:
        raise Stop("%s: detached HEAD — no branch to name the version by" % top)
    m = GITHUB_RE.match(git(top, "config", "--get", "remote.origin.url", check=False).stdout.strip())
    rel = p.relative_to(top).as_posix()
    repo = repo_name(top)
    branch = b.stdout.strip()
    return p, top, branch, rel, (m.group(1) if m else None), "%s@%s:%s" % (repo, branch, rel), repo


def sheep(memo, timeout=DEPLOY_TIMEOUT, plain=False, deadline=None, src=None, notes=None):
    """Deploy the memo's page; returns (url, sha, deployed?). The page is the committed memo: a
    keel with uncommitted changes is refused, so a version name always names what git holds; a
    keel whose commit the page already shows is not redeployed. `plain` (from `line`): a doc
    without D-items is mirrored too — every doc handed to the owner gets its page (2026-10-07); the
    checkpoint's `--hook` still mirrors only docs that ask. `deadline`: the hook's budget ends then
    (epoch seconds); a retry after a refused pinned space needs a whole deploy timeout left.
    `src` (sheep_blob): the doc as a branch holds it, for a page whose branch no checkout here has
    out — the lookout's redeploy (crosstalk S3); `memo` is then unused. `notes` (the hook's list):
    the publish budget's warning goes there, for the hook's row, instead of to stderr; and a
    `deadline` reads the plan from its cache only, as no CLI call fits the hook's budget."""
    if src:
        p, top, branch, rel, slug, key, repo = None, src["top"], src["branch"], src["rel"], src["slug"], src["key"], src["repo"]
    else:
        p, top, branch, rel, slug, key, repo = sheep_where(memo)
    why = never_mirrored(repo, rel)
    if why:
        raise Stop(why)
    if p and git(top, "status", "--porcelain", "--", rel).stdout.strip():
        raise Uncommitted("%s has uncommitted changes — the page is a copy of git; commit first" % rel)
    text = p.read_text() if p else src["text"]
    name = p.name if p else Path(rel).name
    _, items, _ = parse(text)
    if not items and not plain:
        raise Stop("%s has no decisions — nothing to answer, so no page" % rel)
    if src:
        sha = src["sha"]
    else:
        sha = git(top, "log", "-1", "--format=%H", "--", rel).stdout.strip() or git(top, "rev-parse", "HEAD").stdout.strip()
    pin = pins().get(key) or {}
    # a receipt the page does not show yet is a reason to deploy too: a pull whose Saves were refused,
    # or added nothing, changes no file, so no new commit would ever carry it (review 2026-10-20)
    if (pin.get("sha") == sha and pin.get("url") and pin.get("fmt") == PAGE_FMT
            and pin.get("receipt_shown") == pin.get("receipt")):
        return pin["url"], sha, False
    cli = sheep_bin()
    if not cli:
        raise Stop("no spacesheep CLI on this Mac (orchestration build step 8 installs it)")
    view, edit = urls(slug, branch, rel) if slug else ("", "")
    shown = pin.get("receipt")
    page, ctx = sheep_page(text, name, {"rel": rel, "sha": sha, "branch": branch, "read": view, "edit": edit,
                                          "receipt": shown})
    out = page_dir(key)
    out.mkdir(parents=True, exist_ok=True)
    (out / "index.html").write_text(page)
    cmd = [cli, "deploy", str(out), "-m", "%s@%s" % (branch, sha[:7]), "--no-manifest", "--json"]
    # spacesheep refuses a title over 200 characters (stage_begin's `too_big`, 2026-10-13); an
    # architect's H1 runs longer, so the page gets the first 200 and the doc keeps its own.
    title = title_of(text, Path(name).stem)
    # counted in UTF-16 units, the longest of the likely server counts that stays cheap (JS .length;
    # the server's own unit is unverified), and passed on every deploy: without --title a redeploy
    # to a pinned space sends the page's full <title> again (review 2026-10-14)
    def units(t):
        return len(t.encode("utf-16-le")) // 2
    if units(title) > SHEEP_TITLE_MAX:
        while units(title) > SHEEP_TITLE_MAX - 1:
            title = title[:-1]
        title = title.rstrip() + "…"
    base_cmd = cmd

    def deploy(space_id):
        cmd = list(base_cmd)
        cmd[3:3] = (["--space", space_id] if space_id else []) + ["--title", title]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, env=sheep_env(cli), timeout=timeout)
        except subprocess.TimeoutExpired:
            raise Stop("spacesheep deploy timed out after %ds" % timeout)
        try:
            res = json.loads(r.stdout)
        except ValueError:
            res = {}
        return r, (res if isinstance(res, dict) else {})
    r, res = deploy(pin.get("space"))
    # A pinned space the server no longer has (deleted on the page, or an account moved): the page
    # is deployed as a new one, once — a loop of the same refusal otherwise on every Stop hook
    # (M19). Only the CLI's own `✗` error line counts (its wording is unverified: any "not found"),
    # not a 404 somewhere in a body. The pin keeps what is the owner's — pending Saves, refused ones,
    # taken threads, the block ids — and drops what belonged to the lost space.
    import time
    gone = next((l for l in r.stderr.splitlines() if l.strip().startswith("✗")), "")
    if (r.returncode and pin.get("space") and re.search(r"not[ _]found|no such space|does not exist", gone, re.I)
            and (deadline is None or deadline - time.time() >= DEPLOY_TIMEOUT)):
        print("memo: space %s is gone on spacesheep — deploying %s as a new page" % (pin["space"], rel), file=sys.stderr)
        lost = pin["space"]

        def forget(old):
            old = {k: v for k, v in old.items() if k not in ("space", "url", "sha", "fmt", "events_after", "events_at", "opens_seen", "reads_seen")}
            old["old_space"] = lost
            return old
        pin = update_pin(key, forget)
        r, res = deploy(None)
    space = res.get("uuid") or res.get("id") or res.get("space_id")
    if r.returncode or not (space and res.get("url")):
        # The CLI's error is a `✗` line, often followed by a pretty-printed JSON body whose last
        # line is a lone `]` — which is all this used to report (2026-10-13). Prefer the ✗ line.
        lines = [l.strip() for l in r.stderr.strip().splitlines() if l.strip()] or ["exit %d" % r.returncode]
        err = res.get("message") or res.get("error") or next((l for l in lines if l.startswith("✗")), lines[-1])
        cap = sheep_cap_words(cli, str(err), cached=deadline is not None)
        raise Stop("spacesheep deploy %s: %s%s" % (cap or "failed", str(err)[:200], " (not signed in? SPACESHEEP_KEY in .env)" if r.returncode == 3 else ""))

    def change(pin):
        # every id this page ever had: a comment made on an older version still finds its block
        # by the text it was made on (merge places it by quote, or files it under feedback)
        pin.update({"space": space, "fmt": PAGE_FMT, "url": res["url"], "sha": sha, "branch": branch, "receipt_shown": shown,
                    "repo_path": str(top) if src else (doc_key(p) or [pin.get("repo_path")])[0],  # where `prune` asks whether the branch lives
                    "deployed": dt.datetime.now().isoformat(timespec="seconds"),
                    "ss": dict(pin.get("ss") or {}, **ctx["ss"])})
        return pin
    update_pin(key, change)
    warn = sheep_book(cli, rel, cached=deadline is not None)
    if warn and notes is not None:
        notes.append(warn)
    elif warn:
        print(warn, file=sys.stderr)
    return res["url"], sha, True


# The publish budget (the core's sheep_budget(), shared with helm's redeploys: one 24-hour cap per
# account, 400 on Free, counted per Mac). keel never skips an answer page, the owner's road back; it
# warns once this Mac nears its part of the cap, so the pause helm takes first is seen to be why. Once
# per crossing (KEEL_WARNED in the core's sheep dir, cleared back under the line), not on every deploy.
KEEL_WARNED = "keel-warned"


def sheep_book(cli, rel, cached=False):
    """Log this publish; the warning's text when this one crossed the line, else None. `cached`
    (the checkpoint's hook: its 30 s kill leaves no room for the CLI's 20 s plan read) reads the
    plan from the cache only, and with none budgets as Free, the line that is wrong only safely."""
    try:
        c = _common()
        c.sheep_record("keel", what=rel)
        d = c.sheep_dir()
        b = c.sheep_budget()
        if b["count"] >= b["keel_warn"]:   # over Free's line: the plan says where the line is
            b = c.sheep_budget(c.sheep_plan(cli, None if cached else sheep_env(cli), cached_only=cached))
        mark = d / KEEL_WARNED if d else None
        if b["count"] < b["keel_warn"]:
            if mark:
                try:
                    mark.unlink()
                except OSError:
                    pass
            return None
        if not mark or mark.exists():
            return None
        mark.write_text("%d\n" % b["count"])
        return ("keel: %d spacesheep publishes from this Mac in 24 h, near its part of the account's cap "
                "(spacesheep %s: %d a day, shared by %d machine%s; %s) — helm's board has stopped redeploying, keel's pages go on"
                % (b["count"], c.sheep_plan_words(b["plan"]), b["cap"], b["machines"], "" if b["machines"] == 1 else "s", c.SHEEP_PLAN_URL))
    except Exception:  # bookkeeping never fails a deploy that happened
        return None


def sheep_cap_words(cli, err, cached=False):
    """'refused for the account's 24-hour publish cap (…)' when the deploy's error reads as one, else
    ''; the refusal goes in the log with its retry, which pauses helm's redeploys too."""
    try:
        c = _common()
        if c.sheep_cap_refusal(err):
            c.sheep_record("keel", ok=False, err=err)
            return c.sheep_cap_line(c.sheep_budget(c.sheep_plan(cli, None if cached else sheep_env(cli), cached_only=cached)))
    except Exception:
        pass
    return ""


PRUNE_DAYS = 14


def sheep_prune(dry=False):
    """Drop the pins of branches that are gone, with their page folders (M18). Local state only —
    never a call to spacesheep: the page itself stays, unreachable from here, which is what a
    deleted branch's page is. A pin goes when its branch has neither an `origin/<branch>` ref nor a
    local one in its repo (no network: `sync.py` prunes what GitHub deleted) and was last deployed
    over 14 days ago; a pin whose repo cannot be found, or with no deploy time, stays. An empty pin
    (a space the server lost, M19) goes at once."""
    import fcntl
    import shutil
    now = now_ts()
    drop, keep = [], 0
    for key, pin in sorted(pins().items()):
        if not pin:
            drop.append((key, "an empty pin"))
            continue
        branch, repo = pin.get("branch"), key.partition("@")[0]
        try:
            age = (now - dt.datetime.fromisoformat(pin["deployed"]).astimezone().timestamp()) / 86400
        except (KeyError, ValueError, TypeError):
            keep += 1
            continue
        where = Path(pin.get("repo_path") or Path.home() / "projects" / repo)
        if not branch or age < PRUNE_DAYS or not (where / ".git").exists():
            keep += 1
            continue
        has = lambda ref: git(where, "show-ref", "--verify", "--quiet", ref, check=False).returncode == 0
        origin = git(where, "remote", "get-url", "origin", check=False).returncode == 0
        if origin and not has("refs/remotes/origin/" + branch) and not has("refs/heads/" + branch):
            drop.append((key, "branch %s gone, deployed %d days ago" % (branch, age)))
        else:
            keep += 1
    for key, why in drop:
        print("  %s %s: %s" % ("would drop" if dry else "dropped", key, why))
    if not dry and drop:
        SHEEP_STATE.mkdir(parents=True, exist_ok=True)
        with open(SHEEP_STATE / "sheep.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            d = pins()
            for key, _ in drop:
                d.pop(key, None)
            tmp = SHEEP_STATE / ("sheep.json.%d.tmp" % os.getpid())
            tmp.write_text(json.dumps(d, ensure_ascii=False, indent=1, sort_keys=True))
            tmp.replace(SHEEP_STATE / "sheep.json")
        for key, _ in drop:
            shutil.rmtree(page_dir(key), ignore_errors=True)
            # the folder's old name (slugify alone) is shared by pins that collided: only when none is left
            old = SHEEP_STATE / "pages" / slugify(key)
            if old.is_dir() and not any(slugify(k) == slugify(key) for k in d):
                shutil.rmtree(old, ignore_errors=True)
    print("%d pin%s %s, %d kept" % (len(drop), "" if len(drop) == 1 else "s", "to drop" if dry else "dropped", keep))
    return 0


def sheep_check(memo):
    """`current`, or how many commits to the memo the page is behind — from the newest version's
    name (`<branch>@<sha>`, written by `sheep`), else this Mac's pin, said so."""
    p, top, branch, rel, _, key, _ = sheep_where(memo)
    pin = pins().get(key)
    if not pin or not pin.get("space"):  # a pin may hold only what survived a lost space (M19)
        return None, "no page for %s on %s on this Mac yet — memo sheep %s" % (rel, branch, p)
    sha, src = pin["sha"], "this Mac's pin"
    cli = sheep_bin()
    if cli:
        try:
            r = subprocess.run([cli, "versions", pin["space"], "--json"], capture_output=True, text=True,
                               env=sheep_env(cli), timeout=DEPLOY_TIMEOUT)
            v = json.loads(r.stdout) if r.returncode == 0 else None
            v = v.get("versions", v) if isinstance(v, dict) else v
            name = (v[0].get("version_name") or v[0].get("name") or "") if isinstance(v, list) and v else ""
            m = re.search(r"@([0-9a-f]{7,40})$", name)
            full = git(top, "rev-parse", "-q", "--verify", m.group(1) + "^{commit}", check=False).stdout.strip() if m else ""
            if full:
                sha, src = full, "the page's newest version"
        except (subprocess.TimeoutExpired, ValueError, AttributeError, KeyError):
            pass
    head = git(top, "log", "-1", "--format=%H", "--", rel).stdout.strip()
    if head == sha or git(top, "diff", "--quiet", sha, head, "--", rel, check=False).returncode == 0:
        return pin, "current (%s, %s@%s, from %s) — %s" % (rel, pin["branch"], sha[:7], src, pin["url"])
    n = git(top, "rev-list", "--count", "%s..%s" % (sha, head), "--", rel, check=False).stdout.strip() or "?"
    return pin, "behind by %s commit%s (page %s from %s, memo %s) — memo sheep %s" % (
        n, "" if n == "1" else "s", sha[:7], src, head[:7], p)


_WEB = {}  # the web session the key trades for: {cookie, until}, one per run


def sheep_comments(mcp, k, space):
    """The page's comments. First the viewer's own JSON route — the key trades for a 12-hour web
    session (POST /api/account/web-session), whose cookie reads GET /api/space/<id>/comments:
    {comments: [{id, parent_id, body, anchor_id, resolved_at, via, …}]}, read 2026-10-14. Its
    `via` is what tells the Co-shepherd's or this tool's reply from the owner's (null for the owner; both
    carry the owner's author_email), which list_comments' text cannot (docs/memo-on-spacesheep-2026-10-11.md
    F7, P11). The route is the viewer's, not a documented API (Q5 there): any failure falls back
    to list_comments, and says so on stderr — that text cannot tell a bot's reply by `via`.
    Redirects are refused: urllib would carry the key and the cookie to whatever host one names."""
    import http.client
    import time
    import urllib.error
    import urllib.request

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **kw):
            return None

    opener = urllib.request.build_opener(NoRedirect)
    ua = {"User-Agent": "memo/1 (keel)"}
    if time.time() - _WEB.get("failed", 0) < 600:
        # the route failed a moment ago: no second POST of the key to web-session, no second warning
        # for every poll of a wait — it is tried again after ten minutes
        return mcp.call("list_comments", {"uuid": space})
    try:
        if _WEB.get("until", 0) < time.time():
            req = urllib.request.Request(SHEEP_APP + "/api/account/web-session", data=b"{}", method="POST",
                                         headers=dict(ua, **{"Authorization": "Bearer " + k, "Content-Type": "application/json"}))
            with opener.open(req, timeout=20) as r:
                s = json.loads(r.read().decode())
            _WEB.update(cookie="%s=%s" % (s["cookie"], s["token"]), until=time.time() + int(s.get("expires_in") or 3600) - 300)
        req = urllib.request.Request(SHEEP_APP + "/api/space/%s/comments" % space, headers=dict(ua, Cookie=_WEB["cookie"]))
        with opener.open(req, timeout=20) as r:
            d = json.loads(r.read().decode())
        if isinstance(d, dict) and isinstance(d.get("comments"), list):
            return {"comments": d["comments"]}
        why = "an answer without a comments list"
    except urllib.error.HTTPError as e:
        why = "HTTP %d" % e.code
    except (OSError, ValueError, KeyError, TypeError, http.client.HTTPException) as e:
        why = type(e).__name__
    _WEB.clear()
    _WEB["failed"] = time.time()
    print("memo: the comments route failed (%s) — read through list_comments, whose text cannot tell a bot's "
          "reply by `via`" % why, file=sys.stderr)
    return mcp.call("list_comments", {"uuid": space})


class Mcp:
    """spacesheep's MCP server, the way the CLI talks to it: one initialize + initialized per
    instance, the Mcp-Session-Id echoed, a JSON or an SSE body, the text content parsed."""

    def __init__(self, key):
        self.key, self.session, self.n = key, None, 1
        self._post({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                    "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "memo", "version": "1"}}})
        self._post({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def _post(self, msg):
        import urllib.error
        import urllib.request
        # A named User-Agent, as the CLI sends: Cloudflare in front of mcp.spacesheep.dev answers
        # urllib's default (`Python-urllib/3.x`) with 403 before spacesheep sees the key, which
        # read as "the key was refused" (probed unauthenticated 2026-10-04: default 403, named 401).
        h = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
             "MCP-Protocol-Version": "2025-06-18", "Authorization": "Bearer " + self.key,
             "User-Agent": "memo/1 (keel)"}
        if self.session:
            h["Mcp-Session-Id"] = self.session
        req = urllib.request.Request(SHEEP_MCP, data=json.dumps(msg).encode(), headers=h, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                self.session = r.headers.get("Mcp-Session-Id") or self.session
                body = r.read().decode("utf-8", "replace")
                ctype = r.headers.get("Content-Type", "")
        except urllib.error.HTTPError as e:
            raise Stop("spacesheep MCP %s: HTTP %d%s" % (msg.get("method"), e.code, {
                401: " — the key was refused",
                403: " — refused: no access to this space for this key, or Cloudflare (the User-Agent)"}.get(e.code, "")))
        except OSError as e:
            raise Stop("spacesheep MCP unreachable: %s" % e)
        if "id" not in msg or not body.strip():
            return None
        try:
            if "text/event-stream" in ctype:
                for line in body.splitlines():
                    if line.startswith("data:"):
                        obj = json.loads(line[5:].strip())
                        if isinstance(obj, dict) and obj.get("id") == msg["id"]:
                            return obj
                raise Stop("spacesheep MCP: no answer to %s in the event stream" % msg.get("method"))
            return json.loads(body)
        except ValueError:
            raise Stop("spacesheep MCP %s: an answer that is not JSON: %s" % (msg.get("method"), body[:120]))

    def call(self, name, arguments):
        self.n += 1
        res = self._post({"jsonrpc": "2.0", "id": self.n, "method": "tools/call", "params": {"name": name, "arguments": arguments}})
        if not isinstance(res, dict) or "error" in res:
            err = (res or {}).get("error") if isinstance(res, dict) else None
            raise Stop("spacesheep %s: %s" % (name, (err.get("message") if isinstance(err, dict) else err) or "no answer"))
        result = res.get("result") or {}
        text = "\n".join(c.get("text", "") for c in result.get("content", []) if isinstance(c, dict) and c.get("type") == "text")
        if result.get("isError"):
            raise Stop("spacesheep %s refused: %s" % (name, text[:200]))
        try:
            return json.loads(text)
        except ValueError:
            return text


def _first(d, *keys):
    for k in keys:
        if d.get(k) not in (None, ""):
            return d[k]
    return None


def comment_threads(raw):
    """list_comments → [{id, anchor, text, at, resolved, bot, replies: [...]}], roots in order.
    JSON: every object carrying an id and a body, collected first and then threaded by nesting or
    `parent_id`, whichever order the list comes in. Text: one comment per `[id: …]` line; its
    header (before a `: ` after the bracket) holds the anchor (`D3`, `b-…`), the time and the
    author, the rest of the line and every line indented deeper is its body; an indented `[id:`
    is a reply to the one above. A line that is neither (a reaction tally) ends a comment. The
    real shape (2026-10-04, unanchored only): a header with nothing after it, the body on the
    same-indent lines below, `---` closing it. Heuristics on one real sample: an anchored
    comment's and a reply's shape are still unseen (orchestration proposal, step 8)."""
    out, by_id, order = [], {}, []
    if isinstance(raw, (dict, list)):
        def walk(o, parent=None):
            if isinstance(o, dict):
                cid, body = _first(o, "id", "comment_id", "uuid"), _first(o, "body", "text", "content", "message")
                if cid is not None and isinstance(body, str):
                    author = o.get("author") if isinstance(o.get("author"), dict) else {}
                    a = _first(o, "anchor_id", "anchor", "block_id", "ss_id", "anchorId", "blockId")
                    if isinstance(a, dict):
                        a = _first(a, "id", "ss_id", "anchor_id")
                    st = str(o.get("status") or "").lower()
                    via = o.get("via") if isinstance(o.get("via"), str) and o.get("via") else None
                    c = {"id": str(cid), "text": body, "anchor": str(a) if a else None, "replies": [],
                         "at": str(_first(o, "created_at", "createdAt", "created", "time", "timestamp") or ""),
                         "resolved": bool(o.get("resolved") or o.get("resolved_at") or st == "resolved"),
                         "bot": bool(o.get("is_bot") or o.get("bot") or author.get("is_bot") or author.get("bot")
                                     or str(_first(o, "author_type", "kind") or author.get("type") or "").lower() in ("bot", "claude", "agent")
                                     # `via` names what posted a comment on the owner's account: "co-shepherd",
                                     # "claude" (this tool, through the key); null when the owner typed it in
                                     # Chrome (2026-10-14). Only values known to be an agent are not the owner's
                                     # words: a comment through the localhost mirror may carry another
                                     # (review 2026-10-16), and dropping it would lose an answer silently.
                                     or bool(via and BOT_HEAD_RE.search(via))
                                     or (via or "").lower() in BOT_VIA),
                         "odd_via": via if via and not BOT_HEAD_RE.search(via) and via.lower() not in BOT_VIA else None,
                         "parent": parent if parent is not None else (str(o["parent_id"]) if o.get("parent_id") else None)}
                    by_id[c["id"]] = c
                    order.append(c)
                    for k in ("replies", "children", "thread"):
                        if isinstance(o.get(k), list):
                            for r in o[k]:
                                walk(r, c["id"])
                    return
                for v in o.values():
                    if isinstance(v, (list, dict)):
                        walk(v, parent)
            elif isinstance(o, list):
                for v in o:
                    walk(v, parent)
        walk(raw)
    else:
        stack, cur, group = [], None, None  # stack: (indent, comment); group: the last `[on …]` line's anchor
        for line in str(raw).split("\n"):
            ind = len(line) - len(line.lstrip(" \t│└├─"))  # depth: whitespace and tree glyphs, never a `- ` bullet
            # The real answer (first read 2026-10-04): a hint line naming "[id: …]" in prose, then
            # per comment `[id: <uuid>] @<author> (<iso time>)`, its body on the lines below at the
            # same indent, and `---` closing it. So: an id is a real token, never `…`; `---` ends a
            # body; a same-indent line under a header is body until then.
            m = re.search(r"\[id:\s*([A-Za-z0-9_-]+)\s*\]", line)
            if not m:
                g = re.match(r"^\s*\[on (.+)\]\s*$", line)
                if g:  # the group line: `[on the whole page]`, or the block the comments below hang on
                    group = next((t for t in re.findall(r"[A-Za-z0-9-]+", g.group(1)) if SS_ID_RE.match(t)), None)
                    cur = None
                    continue
                if line.strip() == "---":
                    cur = None
                elif cur is not None and line.strip() and (ind > cur["_ind"] or cur.get("_open")):
                    cur["text"] += ("\n" if cur["text"] else "") + line.strip()
                    if ind > cur["_ind"]:
                        cur["_open"] = False  # the indented shape: a same-indent line ends it again
                elif line.strip():
                    cur = None  # not a body line: a tally, a heading — never the owner's words
                continue
            rest = line[m.end():]
            head, sep, body = rest.partition(": ")
            if not sep:
                head, body = rest, ""
            head = line[:m.start()] + " " + head
            cur = {"id": m.group(1), "_ind": ind, "text": body.strip(), "replies": [], "_open": not sep,
                   "anchor": next((t for t in re.findall(r"[A-Za-z0-9-]+", head) if SS_ID_RE.match(t)), group),
                   "resolved": bool(re.search(r"\bresolved\b", head, re.I)) and not re.search(r"\bunresolved\b", head, re.I),
                   "bot": bool(BOT_HEAD_RE.search(head))}  # F7: the shepherd's header
            ts = re.search(r"\d{4}-\d\d-\d\d(?:[T ]\d\d:\d\d(?::\d\d)?(?:\.\d+)?)?(?:Z|[+-]\d\d:?\d\d)?", head)
            cur["at"] = ts.group(0) if ts else ""
            while stack and stack[-1][0] >= ind:
                stack.pop()
            cur["parent"] = stack[-1][1]["id"] if stack else None
            by_id[cur["id"]] = cur
            order.append(cur)
            stack.append((ind, cur))
    for c in order:
        # the text form marks a reply's first body line with the tree glyph (`↳ Yes, …`), the later
        # lines without it: it is not part of the words
        c["text"] = re.sub(r"^↳\s*", "", c["text"])
        if c["parent"] and c["parent"] in by_id and c["parent"] != c["id"]:
            by_id[c["parent"]]["replies"].append(c)
        else:
            out.append(c)
    return out


def epoch(stamp):
    """A comment's time as seconds, or None. ISO 8601 (fractions and `Z` included); a time with no
    zone is UTC (the server's)."""
    s = (stamp or "").strip().replace("Z", "+00:00").replace(" ", "T")
    s = re.sub(r"(\.\d{6})\d+", r"\1", s)
    s = re.sub(r"([+-]\d\d)(\d\d)$", r"\1:\2", s)
    try:
        t = dt.datetime.fromisoformat(s)
    except ValueError:
        return None
    return (t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)).timestamp()


def in_doc(words, doc, feedback=False):
    """Whether `words` already stand in the memo the way `merge` writes them (M4): a note as
    `**<owner>, <date>:** <first line>` with its other lines after it; feedback the same in the
    feedback section, or as a paragraph of one that joined several. Never a substring anywhere in
    the doc: a note "No" or feedback "ship" is in nearly every memo (review, 2026-10-16)."""
    want = [l.strip() for l in words.splitlines() if l.strip()]
    if not want:
        return False
    try:
        fb_line = parse(doc)[2]
    except Stop:
        return False
    lines = [l.strip() for l in doc.split("\n")]
    pre = re.compile(r"^\*\*%s, \d{4}-\d\d-\d\d:\*\* " % OWNER_RE)
    for k, l in enumerate(lines):
        m = pre.match(l)
        if m:
            first = l[m.end():]
        elif feedback and fb_line is not None and k > fb_line:
            first = l  # a later paragraph of a feedback block that joined several threads
        else:
            continue
        if first != want[0]:
            continue
        rest = [x for x in lines[k + 1:] if x][:len(want) - 1]
        if rest == want[1:]:
            return True
    return False


def sheep_answers(threads, pin, doc=""):
    """The open threads as the answers document `merge` takes. Returns (answers, taken, skipped):
    `taken` [(thread, what)], `skipped` [(thread, why, superseded?)]. A thread's words are its
    root's and every reply that is not this tool's own nor the bot's; several threads on one
    decision: the newest wins, and the rest are superseded — resolved on --write too, or the next
    pull would take the older one and revert the answer (review, 2026-10-03)."""
    items, notes, feedback, taken, skipped = {}, [], [], [], []
    ss = pin.get("ss") or {}
    done = set(pin.get("taken") or [])
    open_ = []
    for k, t in enumerate(threads):
        words = [c["text"].strip() for c in [t] + t["replies"]
                 if c["text"].strip() and not c["bot"] and not c["text"].strip().startswith(ACK)]
        if words and not t["resolved"] and t["id"] not in done:
            open_.append((k, t, "\n".join(words)))
    when = {t["id"]: (epoch(t["at"]) or 0, k) for k, t, _ in open_}
    newest = {}
    for k, t, _ in open_:
        a = t["anchor"] or ""
        if re.match(r"^D\d+$", a) and (a not in newest or when[t["id"]] > when[newest[a]]):
            newest[a] = t["id"]
    for k, t, text_ in open_:
        a = t["anchor"] or ""
        if re.match(r"^D\d+$", a):
            if newest[a] != t["id"]:
                skipped.append((t, "superseded by the newer [%s] on %s" % (newest[a], a), True))
                continue
            items[a] = text_
            taken.append((t, a))
        elif a in ss:
            if not in_doc(text_, doc):
                notes.append({"at": ss[a]["at"], "quote": ss[a]["quote"], "row": ss[a]["row"], "text": text_})
            taken.append((t, "a note on “%s”" % ss[a]["quote"][:40]))
        else:
            if not in_doc(text_, doc, feedback=True):
                feedback.append(text_)
            taken.append((t, "open feedback"))
    return {"items": items, "comments": notes, "feedback": "\n\n".join(feedback)}, taken, skipped


def own_words(c):
    """Whether comment `c` holds the owner's words: text, not a bot's, not this tool's reply."""
    return bool(c["text"].strip()) and not c["bot"] and not c["text"].strip().startswith(ACK)


def late_replies(threads, pin):
    """[(thread, [reply, …])] — the owner's replies in a thread already taken that the take did not see
    (M20): the pin keeps the reply ids a take read (`seen_replies`); a thread taken before that was
    kept is judged by its newest `memo:` reply's time, and with none to compare, not at all. Such
    a reply sits under a resolved thread, where nobody looks, and no pull takes it in."""
    done, seen, out = set(pin.get("taken") or []), pin.get("seen_replies") or {}, []
    for t in threads:
        if t["id"] not in done:
            continue
        mine = [r for r in t["replies"] if own_words(r)]
        if t["id"] in seen:
            late = [r for r in mine if r["id"] not in seen[t["id"]]]
        else:
            acks = [epoch(r["at"]) or 0 for r in t["replies"] if r["text"].strip().startswith(ACK)]
            late = [r for r in mine if acks and (epoch(r["at"]) or 0) > max(acks)]
        if late:
            out.append((t, late))
    return out


def unread_resolved(threads, pin):
    """Threads resolved on the page with the owner's words in them that no pull took (M20): they leave
    the open list silently, so a pull names each once (`resolved_seen`)."""
    done, seen = set(pin.get("taken") or []), set(pin.get("resolved_seen") or [])
    return [t for t in threads if t["resolved"] and t["id"] not in done and t["id"] not in seen
            and any(own_words(c) for c in [t] + t["replies"])]


def git_answer_since(top, rel, stamp, pin_sha, d, now, ref="HEAD"):
    """Whether git changed decision `d`'s answer after the comment was made — then git's answer is
    the newer and wins. The baseline is the memo as committed at the comment's time; a comment
    with no readable time falls back to the page's version (git wins whenever it differs). `ref`:
    the branch's history (a plumbed pull reads it from the primary, whose HEAD is main)."""
    when = epoch(stamp)
    base = ""
    if when is not None:
        base = git(top, "log", "-1", "--before=@%d" % int(when), "--format=%H", ref, "--", rel, check=False).stdout.strip()
    base = base or pin_sha
    old = git(top, "show", "%s:%s" % (base, rel), check=False).stdout
    if not old:
        return False
    try:
        return answers_of(old)[0].get(d) != now.get(d)
    except Stop:
        return False


def drain_saves(mcp, key, space, wait=0, path=None, row=None, counts=None):
    """The page's Saves in the room past this pin's cursor → the pin's `saves`, in one locked write
    that keeps the larger cursor and skips a seq at or below it, or one already held — so a
    `sheep wait` and a `sheep pull` draining at once never take a Save twice nor move the cursor
    back (review 2026-10-14). Returns the Saves this call added. A `next_after` below the cursor
    is only a suspicion that the room started afresh (its seq counting from 1 again): an empty
    answer carries `next_after` 0 too. The room is read from the start and believed to have
    restarted only on evidence — an event at or below the cursor that is newer than the newest
    event this pin has seen (`events_at`); otherwise what it shows is old, and dropped (review
    2026-10-16). Not caught: a fresh room whose seq has already passed the old cursor (retention
    unprobed, the design's Q3). `wait`: seconds live_events may hold the first call for a new event. Each page
    open goes to opens.jsonl for `path`, one per load (below) — so `status` counts opens only as
    far as a pull, a wait or a drain has drained the room — and each reading heartbeat to reads.jsonl,
    neither a Save nor anything returned, so a wait never wakes on one. `row` stands in for `path`
    where there is none (`sheep drain`, from the pin: pin_row): without either, the cursor would
    move past opens and reads and nothing would log them. `counts`, when given, gets the opens and
    reads logged and the repeats dropped."""
    start = int((pins().get(key) or {}).get("events_after") or 0)
    after, got, restarted, opens, reads, probing, ats = start, [], False, [], [], False, []
    seen_at = epoch(str((pins().get(key) or {}).get("events_at") or "")) or 0
    while True:
        res = mcp.call("live_events", {"uuid": space, "after": after, "wait_seconds": wait})
        if not isinstance(res, dict) or not isinstance(res.get("events", []), list):
            raise Stop("spacesheep live_events answered in a shape this tool has not seen: %s" % str(res)[:160])
        evs = [e for e in res.get("events") or [] if isinstance(e, dict)]
        nxt = res.get("next_after")
        if isinstance(nxt, int) and nxt < after and not restarted and not probing:
            after, probing, wait = 0, True, 0
            continue
        if probing and not restarted:
            if not seen_at or not any(isinstance(e.get("seq"), int) and e["seq"] <= start
                                      and (epoch(str(e.get("at") or "")) or 0) > seen_at for e in evs):
                after, evs = start, []  # old events, or nothing: the cursor stands
                break
            restarted = True
        for e in evs:
            if e.get("at"):
                ats.append(str(e["at"]))
            if e.get("name") == SAVE_EVENT and isinstance(e.get("data"), dict):
                who = e.get("from") if isinstance(e.get("from"), dict) else {}
                sv = {"seq": e.get("seq"), "at": e.get("at"), "from": who.get("name"), "data": e["data"]}
                if (sv["seq"], sv["at"]) not in {(g["seq"], g["at"]) for g in got}:
                    got.append(sv)
            elif e.get("name") == OPEN_EVENT:
                opens.append(e)
            elif e.get("name") == READ_EVENT:
                reads.append(e)
        top = max([after] + [nxt if isinstance(nxt, int) else 0] + [e["seq"] for e in evs if isinstance(e.get("seq"), int)])
        if not evs or top <= after:
            break
        after, wait = top, 0
    added = []
    if row is None and path:
        try:
            row = doc_row(path)
        except Exception:  # a drain never fails because the log could not be keyed
            row = None

    def take(pin):
        held = pin.get("saves") or []
        have = {(sv.get("seq"), sv.get("at")) for sv in held}
        floor = 0 if restarted else int(pin.get("events_after") or 0)
        new = [sv for sv in got if (sv["seq"], sv["at"]) not in have
               and (restarted or not isinstance(sv["seq"], int) or sv["seq"] > floor)]
        added[:] = new
        cursor = after if restarted else max(after, int(pin.get("events_after") or 0))
        # Opens and heartbeats at or below the pin's cursor were logged by a drain that ran beside
        # this one (pull, wait, sheep drain): the repeat checks below only look forward in time.
        def unseen(e):
            return restarted or not isinstance(e.get("seq"), int) or e["seq"] > floor
        # One load emits memo-open more than once while the frame settles (three in 9 s from one
        # navigation, 2026-10-14), and a wait's long poll returns at the first: a repeat from the
        # same viewer (`from.seed`) and commit within a minute of the last one this pin saw is the
        # same open, across drains.
        seen = dict(pin.get("opens_seen") or {})
        fresh = []
        for e in [e for e in opens if unseen(e)] if row else []:
            who = "%s|%s" % ((e.get("from") or {}).get("seed") if isinstance(e.get("from"), dict) else "",
                             (e.get("data") or {}).get("sha") if isinstance(e.get("data"), dict) else "")
            at = epoch(str(e.get("at") or ""))
            if at is not None and who in seen and 0 <= at - seen[who] < 60:
                seen[who] = at
                continue
            seen[who] = at if at is not None else 0
            fresh.append((at, viewer(e)))
        fresh_opens[:] = fresh
        seen = dict(sorted(seen.items(), key=lambda kv: kv[1])[-50:])
        # Heartbeats, per viewer by name (two tabs, or the phone and a VS Code tab, are one reader
        # with two seeds): one within READ_REPEAT of the last one kept is the same minute. Measured
        # from the last kept, not the last seen, so three tabs never silence each other for good.
        last = dict(pin.get("reads_seen") or {})
        beats, dropped = [], 0
        for e in [e for e in reads if unseen(e)] if row else []:
            who, at = viewer(e), epoch(str(e.get("at") or ""))
            if at is not None and who in last and 0 <= at - last[who] < READ_REPEAT:
                dropped += 1
                continue
            if at is not None:
                last[who] = at
            beats.append((at, who))
        fresh_reads[:], drops[:] = beats, [dropped]
        last = dict(sorted(last.items(), key=lambda kv: kv[1])[-50:])
        newest = max([pin.get("events_at") or ""] + ats, key=lambda a: epoch(a) or 0)
        return dict(pin, events_after=cursor, saves=held + new, opens_seen=seen, reads_seen=last, events_at=newest)

    fresh_opens, fresh_reads, drops = [], [], [0]
    update_pin(key, take)
    for at, who in fresh_opens:
        record_open(path, ts=at, who=who, row=row)
    for at, who in fresh_reads:
        record_read(path, ts=at, who=who, row=row)
    if counts is not None:
        counts.update(opens=len(fresh_opens), reads=len(fresh_reads), dropped=drops[0])
    return added


def viewer(e):
    """The event's viewer: `from.name`, the display name the room set from the viewer's session
    (not a verified handle; crew-report filters on it), or "" when the event has none."""
    f = e.get("from")
    return str(f.get("name") or "") if isinstance(f, dict) else ""


def pin_row(key, pin):
    """The log row's place for a drain that has no doc path, from the pin: `repo` its `repo_path`
    (set on every deploy since 2026-10-16), else ~/projects/<the key's repo> — a folder that may not
    exist, which crew-report shows as "?"; `branch` the pin's; `doc` the key's path in the repo.
    The same (repo, branch, doc) a path's doc_row gives, so logged_opens counts it alike."""
    name, _, rest = key.partition("@")
    branch, _, doc = rest.partition(":")
    repo = pin.get("repo_path") or str(Path.home() / "projects" / name)
    return {"doc": doc, "repo": repo, "branch": pin.get("branch") or branch, "path": str(Path(repo) / doc)}


def answer_at(top, rel, sha, d):
    """Decision `d`'s answer in the memo as committed at `sha`, or None when unreadable."""
    old = git(top, "show", "%s:%s" % (sha, rel), check=False).stdout if sha else ""
    if not old:
        return None
    try:
        return answers_of(old)[0].get(d)
    except Stop:
        return None


def fold_saves(answers, taken, skipped, saves, top=None, rel=None, now=None, text="", applied=None, kept_out=None):
    """The page's Saves over the comments' answers, oldest first: a Save is the form's own answers
    document, so its items, notes and feedback go in as `merge` takes them from memo serve. Per
    decision, the newer word wins: a comment on it older than the Save is superseded (resolved
    with that reply), a newer one keeps it and the Save's answer for it is dropped; and a decision
    git changed since the commit the page showed (`sha`) keeps git's answer — the page was out of
    date (review 2026-10-14). A note or a feedback block already in the doc, or already taken from
    an earlier Save in this batch, is not added again: every Save re-sends what the page holds.
    Returns the lines to print; `kept_out`, when given, gets each answer a Save carried that the doc
    kept its own for, as `D1 (why)` — the page's receipt names them."""
    out = []
    for sv in sorted(saves, key=lambda s: s.get("seq") or 0):
        d = sv["data"]
        got, kept = [], []
        items = d.get("items") if isinstance(d.get("items"), dict) else {}
        s_at = epoch(str(sv.get("at") or "")) or 0
        for k, v in sorted(items.items()):
            if not (isinstance(v, str) and v.strip()):
                continue
            if top and now is not None and d.get("sha"):
                then = answer_at(top, rel, d["sha"], k)
                # `applied`: what an earlier pull wrote for this decision. A second Save from the same
                # page load names the same old commit, and the first one's answer is not git's change
                # (review 2026-10-16): while the doc still holds what was written, the newer Save wins.
                mine = (applied or {}).get(k)
                if then is not None and then != now.get(k) and (mine is None or " ".join(now.get(k, "").split()) != mine):
                    kept.append("%s (git changed it after the page's commit)" % k)
                    continue
            newer = [x for x in taken if x[1] == k and (epoch(x[0].get("at")) or 0) > s_at]
            if newer:
                kept.append("%s (a newer comment answers it)" % k)
                continue
            answers["items"][k] = v
            got.append(k)
            for t, what in [x for x in taken if x[1] == k]:
                taken.remove((t, what))
                skipped.append((t, "%s answered by the page's Save" % k, True))
        have = {(str(c.get("quote") or ""), str(c.get("text") or "").strip()) for c in answers["comments"]}
        notes = []
        for c in d.get("comments") or []:
            if not (isinstance(c, dict) and str(c.get("text") or "").strip()):
                continue
            sig = (str(c.get("quote") or ""), str(c.get("text") or "").strip())
            if sig in have or in_doc(sig[1], text):
                continue
            have.add(sig)
            notes.append(c)
        answers["comments"] = list(answers["comments"]) + notes
        fb = d.get("feedback").strip() if isinstance(d.get("feedback"), str) else ""
        if fb and (in_doc(fb, text, feedback=True) or fb in answers["feedback"]):
            fb = ""
        if fb:
            answers["feedback"] = "\n\n".join(x for x in (answers["feedback"], fb) if x)
        if kept_out is not None:
            kept_out.extend(kept)
        parts = got + (["%d note%s" % (len(notes), "" if len(notes) == 1 else "s")] if notes else []) + (["feedback"] if fb else [])
        out.append("  [save %s, %s%s] → %s%s" % (sv.get("seq"), str(sv.get("at") or "")[:16].replace("T", " "),
                                                   ", by %s" % sv["from"] if sv.get("from") else "", ", ".join(parts) or "nothing new",
                                                   "; kept: " + ", ".join(kept) if kept else ""))
    return out


def receipt_what(rep):
    """What a pull's merge put into the doc, in the page's words: `D1, D2, 1 note, the feedback`."""
    n = rep.get("notes") or 0
    parts = list(rep.get("changed") or []) + (["%d note%s" % (n, "" if n == 1 else "s")] if n else []) \
        + (["the feedback"] if rep.get("feedback") else [])
    return ", ".join(parts) or "nothing new (the doc already had it)"


def receipt_html(r):
    """The page's hidden receipt block: the pin's last receipt as JSON in `data-receipt`, `{}` for none."""
    return '<div data-ss-id="%s" hidden data-receipt="%s"></div>' % (
        RECEIPT_ID, html.escape(json.dumps(r or {}, ensure_ascii=False), quote=True))


def push_receipt(mcp, space, receipt):
    """The receipt to every tab open on the page (live_push: reaches open tabs only, publishes nothing),
    as the line a pull prints. Never fails the pull: the doc is written by now, and the next deploy
    carries the receipt as well. A page older than PAGE_FMT 5 has no block, and spacesheep skips it."""
    try:
        res = mcp.call("live_push", {"uuid": space, "edits": [{"anchor": RECEIPT_ID, "op": "replace", "html": receipt_html(receipt)}]})
    except Exception as e:  # Stop from the server or the network
        return "not pushed to the page (%s); the next deploy carries it" % e
    # the answer, probed 2026-10-20: {ok, space, seq, tabs, ms, note}; `tabs` 0 when nobody has it open
    if not (isinstance(res, dict) and res.get("ok") is not False):
        return "not taken by spacesheep (%s); the next deploy carries it" % (
            (res.get("note") or res.get("error") or "ok: false") if isinstance(res, dict) else str(res)[:120])
    tabs = res.get("tabs")
    if tabs == 0:
        return "no tab has the page open; the next deploy carries it"
    return ("pushed to %d open tab%s" % (tabs, "" if tabs == 1 else "s")) if isinstance(tabs, int) else "pushed to the page"


def sheep_pull(memo, write=False, plumb=False):
    """Comments and the page's Saves → the memo, through `merge`. Without --write: what would
    change, nothing written or posted (Saves are drained into the pin, never applied). With it: the
    memo rewritten, then each thread taken (and each superseded) gets one `memo:` reply and is
    resolved — after the write, so a failed write leaves every thread open; a thread taken is
    recorded in the pin, so a failure part-way never merges it twice; the Saves applied leave it.
    `plumb` (the lookout's, crosstalk S3): `memo` is a pin key or a doc path; the doc is the
    branch's blob in the primary checkout, fast-forwarded from origin first, and the write is a
    commit made by plumbing as pickup's `seed` makes one, then pushed (plumb_where, plumb_commit) —
    so a Save reaches a branch no session here has checked out."""
    loc = plumb_where(memo) if plumb else None
    if loc:
        p, top, branch, rel, slug, key = None, loc["top"], loc["branch"], loc["rel"], loc["slug"], loc["key"]
    else:
        p, top, branch, rel, slug, key, _ = sheep_where(memo)
    pin = pins().get(key)
    if not pin or not pin.get("space"):  # a pin may hold only what survived a lost space (M19)
        raise Stop("no page for %s on %s on this Mac — memo sheep %s" % (rel, branch, p or key))
    if p and git(top, "status", "--porcelain", "--", rel).stdout.strip():
        raise Stop("%s has uncommitted changes — commit them first, so git's answers are what the comments meet" % rel)
    if p and slug and fetch(top, branch) is None:
        if git(top, "merge-base", "--is-ancestor", "refs/remotes/origin/" + branch, "HEAD", check=False).returncode:
            raise Stop("GitHub has commits on %s this checkout lacks (answers typed there?) — memo pull %s first" % (branch, p))
    k = sheep_key()
    if not k:
        raise Stop("no SPACESHEEP_KEY (environment, the config dir's regatta/.env, or the CLI's login)")
    mcp = Mcp(k)
    raw = sheep_comments(mcp, k, pin["space"])
    threads = comment_threads(raw)
    # the server's own words for a page nobody has commented on (read 2026-10-14): empty, not a new
    # shape — no alarm, and the last real sample in list_comments.last.txt stays (M5, F5)
    empty = isinstance(raw, str) and re.match(r"^\s*No comments\b", raw) and len(raw) < 200
    if not threads and raw and not empty and not (isinstance(raw, dict) and raw.get("comments") == []):
        dump = SHEEP_STATE / "list_comments.last.txt"
        SHEEP_STATE.mkdir(parents=True, exist_ok=True)
        dump.write_text(raw if isinstance(raw, str) else json.dumps(raw, indent=1, ensure_ascii=False))
        print("no comment read from list_comments's answer — if the page has comments, its shape is new to this tool: %s" % dump)
    def every(ts):
        for t in ts:
            yield t
            yield from every(t["replies"])
    for c in every(threads):
        if c.get("odd_via"):
            print("  comment [%s] came via %r, not a known agent — read as %s words" % (c["id"], c["odd_via"], WHOSE))
    drain_saves(mcp, key, pin["space"], path=p, row=None if p else pin_row(key, pin))
    pin = pins().get(key) or pin
    saves = pin.get("saves") or []
    text = p.read_text() if p else loc["text"]
    answers, taken, skipped = sheep_answers(threads, pin, doc=text)
    try:
        now, _ = answers_of(text)
    except Stop:
        now = {}
    for t, d in list(taken):
        if d in answers["items"] and git_answer_since(top, rel, t["at"], pin["sha"], d, now, ref="HEAD" if p else "refs/heads/" + branch):
            skipped.append((t, "%s changed in git after it (git's answer kept)" % d, False))
            taken.remove((t, d))
            del answers["items"][d]
    # the comments alone must merge: a bad one stops here, its thread left open for a fix
    parse(merge(text, answers)[0])
    # then each Save on top, one at a time: one merge refuses (an answer that reads as a D-item,
    # a heading or `---`) is set aside, named, and never retried — it would block every later
    # pull of this page (review 2026-10-14)
    import copy
    save_lines, refused, kept = [], [], []
    for sv in sorted(saves, key=lambda x: x.get("seq") or 0):
        trial, kept_here = (copy.deepcopy(answers), list(taken), list(skipped)), []
        try:
            lines_ = fold_saves(*trial, [sv], top=top, rel=rel, now=now, text=text, applied=pin.get("applied"), kept_out=kept_here)
            parse(merge(text, trial[0])[0])
        except Exception as e:  # Stop from merge's or parse's guards, or a Save of a shape never seen
            refused.append((sv, str(e) if isinstance(e, Stop) else "%s: %s" % (type(e).__name__, e)))
            continue
        answers, taken, skipped = trial
        save_lines += lines_
        kept += kept_here
    new_text, rep = merge(text, answers)
    late, unread = late_replies(threads, pin), unread_resolved(threads, pin)
    for t, rs in late:
        print("  late reply: [%s] %d new reply%s after it was taken, not read: %s — say it again as a new comment"
              % (t["id"], len(rs), "" if len(rs) == 1 else "s", rs[-1]["text"].strip().split("\n")[0][:70]))
    for t in unread:
        print("  resolved on the page, not read: [%s] %s" % (t["id"], next(c["text"] for c in [t] + t["replies"] if own_words(c)).strip().split("\n")[0][:70]))
    for t, why, _ in skipped:
        print("  %s: [%s] %s" % ("resolve" if write and _ else "kept open", t["id"], why))
    for t, what in taken:
        print("  [%s] → %s: %s" % (t["id"], what, t["text"].strip().split("\n")[0][:70]))
    for line_ in save_lines:
        print(line_)
    for sv, why in refused:
        print("  %s save %s (%s): %s — set aside in the pin's `refused_saves`; its words are there to copy"
              % ("refused" if write else "would refuse", sv.get("seq"), str(sv.get("at") or "")[:16].replace("T", " "), why))
    summary = "changed: %s; unchanged: %s; feedback: %s; notes: %d%s" % (
        ", ".join(rep["changed"]) or "none", ", ".join(rep["unchanged"]) or "none",
        "added" if rep["feedback"] else "none", rep["notes"],
        ("; unknown ids ignored: " + ", ".join(rep["unknown"])) if rep["unknown"] else "")
    what = "%d thread%s%s" % (len(taken), "" if len(taken) == 1 else "s",
                              " and %d Save%s from the page" % (len(saves) - len(refused), "" if len(saves) - len(refused) == 1 else "s")
                              if len(saves) > len(refused) else "")
    parse(new_text)  # each part passed alone; the whole is checked again before a write
    if not write:
        print("%s: would merge %s — %s (preview; --write to apply and resolve them)" % (rel, what, summary))
        return 0
    committed = None
    if new_text != text and p:
        p.write_text(new_text)
        record_touch(p, "save")  # the owner's act from the page, as a form Save was: the doc no longer stands (F9)
    elif new_text != text:
        took = [sv for sv in saves if all(sv is not r for r, _ in refused)]
        wrote_ = answers_of(new_text)[0]
        carried = sorted((d for d, a in wrote_.items() if " ".join(a.split()) and " ".join(a.split()) != " ".join((now.get(d) or "").split())), key=id_key)
        committed = plumb_commit(loc, new_text, what, saved_by=[save_viewer(sv) for sv in took], items=carried)
        print("  committed %s on %s (%s)" % (committed[0][:7], branch, committed[1]))
        touch_row(pin_row(key, pin), "save")
    done = {(s.get("seq"), s.get("at")) for s in saves}
    set_aside = [dict(sv, why=why) for sv, why in refused]
    # every thread this write took or superseded is marked taken at once, with the doc: a reply or
    # resolve that fails part-way (the server, the network) then leaves the later threads' words
    # in the memo and recorded, so the next pull cannot append them a second time (M4)
    just = [t for t, _ in taken] + [t for t, _, sup in skipped if sup]
    ids = {t["id"] for t in just}
    # what each take read, so a reply typed after it shows as late; and what was surfaced above, once
    seen = {t["id"]: [c["id"] for c in t["replies"] if own_words(c)] for t in just}
    for t, rs in late:
        seen[t["id"]] = [c["id"] for c in t["replies"] if own_words(c)]
    wrote = answers_of(new_text)[0]
    applied = {d: " ".join(wrote.get(d, "").split()) for d in answers["items"]}
    applied_at = take_in_times(applied, now, now_ts())
    update_pin(key, lambda pin: dict(pin, saves=[s for s in pin.get("saves") or [] if (s.get("seq"), s.get("at")) not in done],
                                     applied=dict(pin.get("applied") or {}, **applied),
                                     applied_at=dict(pin.get("applied_at") or {}, **applied_at),
                                     taken=sorted(set(pin.get("taken") or []) | ids),
                                     seen_replies=dict(pin.get("seen_replies") or {}, **seen),
                                     resolved_seen=sorted(set(pin.get("resolved_seen") or []) | {t["id"] for t in unread}),
                                     refused_saves=((pin.get("refused_saves") or []) + set_aside)[-10:]))
    if saves:  # the doc is written: the page hears it now, before any reply below can fail part-way (M4)
        bad = {(sv.get("seq"), sv.get("at")) for sv, _ in refused}
        stamp_of = lambda sv: str((sv.get("data") or {}).get("savedAt") or "") if isinstance(sv.get("data"), dict) else ""
        receipt = {"at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                   "saves": sorted(filter(None, (stamp_of(sv) for sv in saves if (sv.get("seq"), sv.get("at")) not in bad))),
                   "what": receipt_what(rep), "kept": kept,
                   "refused": [{"saved": stamp_of(sv), "why": why[:200]} for sv, why in refused]}
        update_pin(key, lambda pin: dict(pin, receipt=receipt))
        print("  receipt: %s" % push_receipt(mcp, pin["space"], receipt))
        if new_text == text:  # no rewrite, so no commit to redeploy with: the page takes the receipt now
            try:
                sheep(p) if p else sheep_blob(key)
                print("  receipt: the page redeployed with it")
            except Exception as e:  # Stop (the CLI, the network) — the pull has done its part
                print("  receipt: not redeployed (%s); the next deploy carries it" % e)
    reach = "committed on its branch" if committed else "it reaches git with the next commit"
    replies = [(t, "%s taken into %s as %s; %s."
                % (ACK, rel, what + "'s answer" if re.match(r"^D\d+$", what) else what, reach)) for t, what in taken]
    replies += [(t, "%s %s; left out of %s." % (ACK, why, rel)) for t, why, sup in skipped if sup]
    for t, body in replies:
        update_pin(key, lambda pin: dict(pin, taken=sorted(set(pin.get("taken") or []) | {t["id"]})))
        mcp.call("add_comment", {"uuid": pin["space"], "parent_id": t["id"], "body": body})
        mcp.call("resolve_comment", {"uuid": pin["space"], "comment_id": t["id"]})
    print("%s: merged %s and resolved %d thread%s — %s" % (rel, what, len(replies), "" if len(replies) == 1 else "s", summary))
    return 0


def open_words(threads, taken, pin=None):
    """{thread id: how many of the owner's words it holds} for each open thread not yet taken — a new
    thread or a new reply in one changes it. With the pin: a late reply under a taken thread too
    (M20), keyed `<id>+late`, so a wait wakes for it as for a new comment."""
    out = {}
    for t in threads:
        n = sum(1 for c in [t] + t["replies"] if own_words(c))
        if n and not t["resolved"] and t["id"] not in taken:
            out[t["id"]] = n
    for t, rs in late_replies(threads, pin) if pin else []:
        out[t["id"] + "+late"] = len(rs)
    return out


def sheep_wait(memo, quiet=WAIT_QUIET, idle=110 * 60, poll=WAIT_POLL):
    """Listen on the page until the owner answers there, then take it in and exit — the exit is what
    wakes the session, run as its background shell exactly as `memo serve` was (a detached one wakes
    nobody). Wakes on a Save from the page at once (a live_events call holds up to 25 s for one),
    or on new comments once none came for `quiet` seconds — a phone's run of comments is one
    answer, not five wakes. Comments open when it starts are not new. Then `sheep pull --write`.
    Exits 0 having taken something or, after `idle` seconds, nothing; 1 when spacesheep kept
    failing or the pull refused (the Saves stay in the pin, for the next pull)."""
    import fcntl
    import time
    p, top, branch, rel, slug, key, _ = sheep_where(memo)
    pin = pins().get(key)
    if not pin or not pin.get("space"):  # a pin may hold only what survived a lost space (M19)
        raise Stop("no page for %s on %s on this Mac — memo sheep %s" % (rel, branch, p))
    k = sheep_key()
    if not k:
        raise Stop("no SPACESHEEP_KEY (environment, the config dir's regatta/.env, or the CLI's login)")
    SHEEP_STATE.mkdir(parents=True, exist_ok=True)
    # by the whole key: slugify cuts at 60 characters, and two docs on one branch shared a lock;
    # wait_lock is the one name, the lookout reads the same file
    lock = open(wait_lock(key), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("memo sheep wait: another wait already listens on %s's page — that one wakes its session" % rel)
        return 0
    space = pin["space"]
    print("memo sheep wait: listening on %s for a Save or new comments" % chat_page(pin["url"]), flush=True)
    mcp, fails, base, seen, since, next_poll = None, 0, None, {}, 0.0, 0.0
    end = time.time() + idle
    # a Save a preview pull already drained into the pin wakes nobody later: take it now
    why = "a Save already drained from the page" if (pins().get(key) or {}).get("saves") else None
    while time.time() < end and not why:
        # every round, not only at the start: a preview `sheep pull` (or a wait that died) drains a
        # Save into the pin while this one listens, and no later drain would find it (review 2026-10-16)
        if (pins().get(key) or {}).get("saves"):
            why = "a Save already drained from the page"
            break
        try:
            mcp = mcp or Mcp(k)
            now = time.time()
            if now >= next_poll:
                cur_pin = pins().get(key) or {}
                words = open_words(comment_threads(sheep_comments(mcp, k, space)), set(cur_pin.get("taken") or []), cur_pin)
                base = words if base is None else base
                new = {t: n for t, n in words.items() if base.get(t) != n}
                if new != seen:
                    seen, since = new, now
                next_poll = now + poll
            if seen and now - since >= quiet:
                why = "%d new comment thread%s" % (len(seen), "" if len(seen) == 1 else "s")
                break
            hold = max(0, min(25, int(min(end, (since + quiet) if seen else end, next_poll) - time.time())))
            t0 = time.time()
            if drain_saves(mcp, key, space, wait=hold, path=p):
                why = "a Save from the page"
            elif hold and time.time() - t0 < 1:
                time.sleep(1)  # a room that answered at once though asked to hold: never a busy loop
            fails = 0
        except Exception as e:  # Stop, or a truncated answer (http.client.IncompleteRead): counted, never a traceback
            fails += 1
            mcp = None
            if fails >= 5:
                print("memo sheep wait: spacesheep failed %d times running, last: %s — nothing taken; "
                      "memo sheep pull %s once it answers" % (fails, e, p))
                return 1
            time.sleep(min(60, 5 * fails))
    if not why:
        print("memo sheep wait: nothing on the page in %d min — stopped; start it again to keep listening" % (idle // 60))
        return 0
    print("memo sheep wait: %s — taking it in" % why, flush=True)
    try:
        sheep_pull(memo, write=True)
    except Stop as e:
        print("memo sheep wait: not taken in — %s; the page's Saves stay in the pin, so `memo sheep pull %s --write` "
              "takes them once that is fixed" % (e, p))
        return 1
    print("next: commit %s on %s, then act on the answers the memo's way" % (rel, branch))
    return 0


DRAIN_HOURS = 6  # sheep drain --if-due: the room keeps 500 events, and ≥ 57 h was seen (2026-10-18)


def drain_due_ts(pin):
    """The newest of a pin's deploy, its newest event seen and its newest open, epoch seconds."""
    out = [v for v in (pin.get("opens_seen") or {}).values() if isinstance(v, (int, float))]
    for s in (pin.get("deployed"), pin.get("events_at")):
        try:
            out.append(iso_ts(str(s)))
        except (ValueError, TypeError):
            pass
    return max(out or [0])


def sheep_drain(if_due=False):
    """Drain every page deployed, seen or opened in the last PRUNE_DAYS (not every pin `prune`
    keeps: that is any pin whose branch lives; an older page waits for its doc's pull): one live_events call or so each, rows by pin_row, Saves into their pins for the doc's
    next pull (or the wait listening on it, which looks there each round). A page read after its
    session closed would otherwise sit in the room until someone pulls it, and the ring holds 500
    events. `--if-due`: nothing within DRAIN_HOURS of the last run (bin/ask poll's 5-minute tick).
    The stamp is written when a run starts, so a spacesheep that is down is tried once per 6 h, not
    every tick. Prints one line, plus one per page with over 10 repeats dropped (a page script
    emitting on every event; crew design's risks)."""
    import fcntl
    now = now_ts()
    d = state_dir()
    stamp = d / "drain-at"
    try:
        last = float(stamp.read_text().strip())
    except (OSError, ValueError):
        last = 0.0
    if if_due and 0 <= now - last < DRAIN_HOURS * 3600:
        return 0
    d.mkdir(parents=True, exist_ok=True)
    lock = open(d / "drain.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("keel sheep drain: another drain is running")
        return 0
    stamp.write_text("%d\n" % now)
    k = sheep_key()
    if not k:
        raise Stop("no SPACESHEEP_KEY on this Mac (sheep_key's three places) — no page drained")
    horizon = now - PRUNE_DAYS * 86400
    todo = [(key, pin) for key, pin in sorted(pins().items()) if pin and pin.get("space") and drain_due_ts(pin) >= horizon]
    # Start at a random page: three dead spaces side by side trip the breaker, and a run killed by
    # ask's timeout stops part-way — in a fixed order each would starve the same tail every time.
    import random
    at = random.randrange(len(todo)) if todo else 0
    todo = todo[at:] + todo[:at]
    mcp, fails, tot, saves, failed = None, 0, {"opens": 0, "reads": 0, "dropped": 0}, 0, []
    for key, pin in todo:
        c = {}
        try:
            mcp = mcp or Mcp(k)
            row = pin_row(key, pin)
            held = drain_saves(mcp, key, pin["space"], row=row, counts=c)
            saves += len(held)
            if held:
                touch_row(row, "save")  # the owner's act from the page, held for the pull: the doc no longer stands (F9)
            fails = 0
        except Exception as e:  # Stop, a refused call, a truncated answer: this page waits for the next drain
            failed.append((key, e))
            fails, mcp = fails + 1, None
            if fails >= 3:
                print("keel sheep drain: spacesheep failed 3 times running, last: %s — stopped" % str(e)[:160])
                break
            continue
        for n in tot:
            tot[n] += c.get(n, 0)
        if c.get("dropped", 0) > 10:
            print("  %s: %d repeated heartbeats dropped — a page emitting too often?" % (key, c["dropped"]))
    print("keel sheep drain: %d page%s, %d read%s (%d repeat%s dropped), %d open%s, %d Save%s held for its doc's pull%s"
          % (len(todo), "" if len(todo) == 1 else "s", tot["reads"], "" if tot["reads"] == 1 else "s",
             tot["dropped"], "" if tot["dropped"] == 1 else "s", tot["opens"], "" if tot["opens"] == 1 else "s",
             saves, "" if saves == 1 else "s", "; %d failed, first %s" % (len(failed), failed[0][0]) if failed else ""))
    return 1 if failed else 0


def key_parts(key):
    """(repo name, branch, path in repo) of a pin key `repo@branch:rel`; Stop on any other shape."""
    name, _, rest = key.partition("@")
    branch, _, rel = rest.partition(":")
    if not (name and branch and rel):
        raise Stop("%s: not a doc path nor a pin key (repo@branch:path)" % key)
    return name, branch, rel


def plumb_where(memo):
    """Where `sheep pull --plumb` reads and writes: {key, top (the primary checkout), branch, rel,
    slug, repo, wt (the worktree with the branch out, or None), base (the branch's sha), text (the
    doc at it)}. `memo` is a pin key or a doc path (its key). Refused — before anything moves —
    when a worktree on the branch is held by a session (its owner file within OWNER_TTL), in a
    rebase or merge, or dirty in a tracked file: that session takes its own Saves (`sheep pull`),
    and a ref moved under a dirty tree reads to it as edits reverted. Then fast-forwarded from
    origin, so the commit lands on GitHub's tip and a run on either Mac starts from `keel pull`;
    a branch that diverged from origin is refused."""
    if Path(memo).expanduser().is_file():
        key = sheep_where(memo)[5]
    else:
        key = memo
    name, branch, rel = key_parts(key)
    pin = pins().get(key) or {}
    top = Path(pin_row(key, pin)["repo"])
    if not top.is_dir() or git(top, "rev-parse", "--git-dir", check=False).returncode:
        raise Stop("%s: no checkout of %s at %s" % (key, name, top))
    if not branch.startswith("claude/"):   # main moves only through a PR; pre-push would refuse it anyway
        raise Stop("%s: --plumb writes claude/* branches only, not %s" % (key, branch))
    head = "refs/heads/" + branch
    base = git(top, "rev-parse", "-q", "--verify", head, check=False).stdout.strip()
    if not base:
        raise Stop("%s: no local branch %s in %s" % (key, branch, top))
    wt = next((w for w, b in worktrees(top) if b == branch), None)
    if wt:
        why = held_by(wt) or (("a git %s in progress" % git_busy(wt)) if git_busy(wt) else None)
        if not why and git(wt, "status", "--porcelain", "--untracked-files=no", check=False).stdout.strip():
            why = "uncommitted changes in %s" % wt
        if why:
            raise Stop("%s: %s — its session takes the Saves (memo sheep pull)" % (branch, why))
    m = GITHUB_RE.match(git(top, "config", "--get", "remote.origin.url", check=False).stdout.strip())
    if git(top, "remote", "get-url", "origin", check=False).returncode == 0 and fetch(top, branch) is None:
        o = git(top, "rev-parse", "refs/remotes/origin/" + branch).stdout.strip()
        if o != base:
            if git(top, "merge-base", "--is-ancestor", base, o, check=False).returncode == 0:
                plumb_advance(top, wt, branch, o, base)
                base = o
            elif git(top, "merge-base", "--is-ancestor", o, base, check=False).returncode:
                raise Stop("%s and origin/%s have diverged — a session settles it, not a plumbed commit" % (branch, branch))
    text = git(top, "show", "%s:%s" % (base, rel), check=False).stdout
    if not text:
        raise Stop("%s: %s is not on %s" % (key, rel, branch))
    return {"key": key, "top": top, "branch": branch, "rel": rel, "slug": m.group(1) if m else None,
            "repo": name, "wt": wt, "base": base, "text": text}


def plumb_advance(top, wt, branch, new, old):
    """Move the branch from `old` to its descendant `new`: through the worktree that has it out (a
    fast-forward, so its index and files follow), else the ref alone, refused if it moved since."""
    if wt:
        git(wt, "merge", "--ff-only", "-q", new)
    else:
        git(top, "update-ref", "refs/heads/" + branch, new, old)


def plumb_commit(loc, new_text, what, saved_by=(), items=()):
    """One commit of `new_text` at loc's path on top of loc's base, made as pickup's `seed` makes
    one (hash-object, a scratch index, write-tree, commit-tree: no checkout), the branch moved to it
    and pushed. Returns (sha, "pushed" | why not). Its trailer names the tool, not an agent: the
    answer is the page's, and stand and `keel_dates` read it as such. Every Save is taken in (the owner on
    lookout S3's D1, 2026-10-21: "just record who made it"): a `Saved-By:` trailer per viewer whose
    Save it holds — the room's display name, never verified (`viewer`) — and a `Saved-Items:` trailer
    naming the D-items it answered, so the lookout on either Mac reads them, and only them, as taken
    in (lookout-echo, finding 5)."""
    import tempfile
    top, rel = loc["top"], loc["rel"]
    blob_sha = subprocess.run(["git", "-C", str(top), "hash-object", "-w", "--stdin"], input=new_text,
                              capture_output=True, text=True, check=True).stdout.strip()
    mode = (git(top, "ls-tree", loc["base"], "--", rel).stdout.split() or ["100644"])[0]
    with tempfile.TemporaryDirectory() as tmp:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(tmp) / "index"))
        for a in (["read-tree", loc["base"]], ["update-index", "--add", "--cacheinfo", "%s,%s,%s" % (mode, blob_sha, rel)]):
            subprocess.run(["git", "-C", str(top)] + a, env=env, capture_output=True, text=True, check=True)
        tree = subprocess.run(["git", "-C", str(top), "write-tree"], env=env, capture_output=True, text=True, check=True).stdout.strip()
    names = sorted({viewer_name(n) for n in saved_by})
    msg = "Keel: %s — %s, taken in by the lookout\n\n%s\n" % (rel, what, "".join(
        "%s %s\n" % (SAVED_BY, n) for n in names) + ("%s %s\n" % (SAVED_ITEMS, ", ".join(items)) if items else "") + TAKEN_BY)
    sha = subprocess.run(["git", "-C", str(top), "commit-tree", tree, "-p", loc["base"], "-F", "-"], input=msg,
                         capture_output=True, text=True, check=True).stdout.strip()
    plumb_advance(top, loc["wt"], loc["branch"], sha, loc["base"])
    if git(top, "remote", "get-url", "origin", check=False).returncode:
        return sha, "no origin"
    b = loc["branch"]
    r = git(top, "push", "-q", "origin", "refs/heads/%s:refs/heads/%s" % (b, b), check=False)
    return sha, "pushed" if r.returncode == 0 else "not pushed: " + (r.stderr or r.stdout).strip()[:120]


def sheep_blob(key, ref=None, gd=None):
    """Deploy pin `key`'s page from its branch as git holds it (`ref` in `gd`, default the local
    branch in the primary; the lookout passes helm's poll mirror) — the doc's last commit on that
    ref names the version, as a checkout's deploy names it."""
    name, branch, rel = key_parts(key)
    top = Path(pin_row(key, pins().get(key) or {})["repo"])
    gd, ref = gd or top, ref or "refs/heads/" + branch
    text = git(gd, "show", "%s:%s" % (ref, rel), check=False).stdout
    if not text:
        raise Stop("%s: %s is not on %s" % (key, rel, ref))
    m = GITHUB_RE.match(git(top, "config", "--get", "remote.origin.url", check=False).stdout.strip())
    sha = git(gd, "log", "-1", "--format=%H", ref, "--", rel).stdout.strip()
    return sheep(None, src={"top": top, "branch": branch, "rel": rel, "slug": m.group(1) if m else None, "key": key,
                            "repo": name, "text": text, "sha": sha})


SHEEP_USAGE = ("usage: memo sheep <doc> | sheep pull <doc> [--write] [--plumb] | sheep wait <doc> [--quiet S] [--idle S] [--poll S] | "
               "sheep check <doc> | sheep drain [--if-due] | sheep prune [--dry-run] | sheep --hook [--budget S] <doc>…")


def sheep_main(args):
    """`sheep <doc>`, `sheep pull <doc> [--write]`, `sheep check <doc>`, and `sheep --hook
    [--budget S] <doc>…` (the checkpoint hook: one JSON line per doc as it goes, a silent skip
    without the CLI or a key, no deploy started once the budget is spent, always exit 0)."""
    if args and args[0] == "--hook":
        import time
        args = args[1:]
        budget = 20.0
        if args[:1] == ["--budget"] and len(args) > 1:
            budget, args = float(args[1]), args[2:]
        if not sheep_bin() or not sheep_key():
            return 0
        end = time.time() + budget
        for doc in args:
            row = {"doc": str(Path(doc).resolve())}
            left = end - time.time()
            if left < 3:
                row["error"] = "the hook's time ran out first — memo sheep %s" % doc
                print(json.dumps(row), flush=True)
                continue
            notes = []   # the budget's warning: checkpoint's 🐑 note shows a row's `note`; nobody reads stderr here
            try:
                row["url"], row["sha"], row["deployed"] = sheep(doc, timeout=min(DEPLOY_TIMEOUT, int(left)), deadline=end, notes=notes)
                if notes:
                    row["note"] = "; ".join(notes)
            except Stop as e:
                if "never mirrored" in str(e) or "no decisions" in str(e):
                    continue
                row["error"] = str(e)
            except Exception as e:  # a hook never fails the turn
                row["error"] = "%s: %s" % (type(e).__name__, e)
            print(json.dumps(row), flush=True)
        return 0
    if args[:1] == ["wait"]:
        opts = argparse.ArgumentParser(prog="memo sheep wait")
        opts.add_argument("doc")
        opts.add_argument("--quiet", type=int, default=WAIT_QUIET)
        opts.add_argument("--idle", type=int, default=110 * 60)
        opts.add_argument("--poll", type=int, default=WAIT_POLL)
        o = opts.parse_args(args[1:])
        return sheep_wait(o.doc, quiet=o.quiet, idle=o.idle, poll=o.poll)
    flags = [a for a in args if a.startswith("--")]
    rest = [a for a in args if not a.startswith("--")]
    if rest == ["prune"] and set(flags) <= {"--dry-run"}:
        return sheep_prune(dry="--dry-run" in flags)
    if rest == ["drain"] and set(flags) <= {"--if-due"}:
        return sheep_drain(if_due="--if-due" in flags)
    if rest[:1] == ["pull"] and len(rest) == 2 and set(flags) <= {"--write", "--plumb"}:
        if "--plumb" in flags and "--write" not in flags:   # plumb_where fast-forwards before any preview
            raise Stop("sheep pull --plumb commits and pushes: it takes --write")
        return sheep_pull(rest[1], write="--write" in flags, plumb="--plumb" in flags)
    if rest[:1] == ["check"] and len(rest) == 2 and not flags:
        pin, line = sheep_check(rest[1])
        print(line)
        return 0 if pin and line.startswith("current") else 1
    if rest[:1] in (["pull"], ["check"], ["drain"]) or (rest[:1] == ["prune"] and not set(flags) <= {"--dry-run"}):
        raise Stop(SHEEP_USAGE)  # a subcommand's name is not a doc: "pull: no such file" told the owner nothing
    if len(rest) == 1 and not flags:
        # by hand a doc without D-items is mirrored too, as `memo line` does (2026-10-07); only the
        # checkpoint's --hook stays picky (M7)
        u, sha, deployed = sheep(rest[0], plain=True)
        print("page:   %s (%s%s)" % (chat_page(u), sha[:7], "" if deployed else ", already showing this commit"))
        return 0
    raise Stop(SHEEP_USAGE)


# ----------------------------------------------------------------------------- stand (D11)

# D11-A (docs/autofinish-design-2026-10-02.md, sections 2c and 12; built as E10): a doc's
# recommendations stand at link + 24 h when nobody touched it, in a repo whose contract says
# `physical: none`, never in a doc with more than ten D-items; an explicit `Stands:` line is the
# only way in elsewhere and the way to move the time. `status` decides; `stand --apply` acts on
# `due` alone. Every rule errs towards waiting: a signal that might be the owner's is a touch.
STAND_HOURS = 24
STAND_MAX_ITEMS = 10  # the owner, 2026-10-04: "those stay and rot if they have to"
STOOD_TRAILER = "Stood-By: autofinish"
STANDS_RE = re.compile(r"^Stands:\s*(\S+)(?:.*?\bset\s+(\S+))?")
# A commit that is not the owner's: the checkpoint's own trailer, an agent's, or this tool's. On the
# laptop every commit's author is the owner (rules: git-workflow, "Who the commit is from"), so the
# author cannot tell a checkpoint from an edit the owner committed himself; the trailers can.
AGENT_TRAILER_RE = re.compile(r"^(?:Claude-Session:|Co-Authored-By:\s*Claude\b|Stood-By:)", re.M | re.I)
# A checkpoint commit quotes the prompts it carries (hooks/checkpoint.py build_message)
PROMPT_RE = re.compile(r"^(?:Prompt|Prompts \(oldest first\)):\s*\n> ", re.M)


def now_ts():
    """The clock. MEMO_NOW (ISO-8601 or epoch seconds) pins it: the tests, and a dry run of the
    launcher at a chosen hour."""
    v = os.environ.get("MEMO_NOW")
    if not v:
        return dt.datetime.now(dt.timezone.utc).timestamp()
    if re.match(r"^\d+(?:\.\d+)?$", v):
        return float(v)
    return iso_ts(v)


def iso_ts(s):
    """An ISO-8601 time as epoch seconds; `Z` read as UTC (3.9's fromisoformat refuses it), a
    time without a zone read as local."""
    t = dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    return (t if t.tzinfo else t.astimezone()).timestamp()


def iso(ts):
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).replace(microsecond=0).isoformat()


def human(ts):
    return dt.datetime.fromtimestamp(ts).astimezone().strftime("%Y-%m-%d %H:%M %Z")


def state_dir():
    """Per-Mac state, beside E14's opens.jsonl; MEMO_STATE_DIR moves it (the tests)."""
    return Path(os.environ.get("MEMO_STATE_DIR") or Path.home() / ".local" / "state" / "memo")


def doc_key(path):
    """(primary checkout, branch, path in repo) of a file, or None outside a git branch. The
    primary, not the worktree: a Save in one checkout is read by `status` run from another."""
    p = Path(path).resolve()
    r = git(p.parent, "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel", check=False)
    b = git(p.parent, "symbolic-ref", "-q", "--short", "HEAD", check=False)
    if r.returncode or b.returncode:
        return None
    common, top = r.stdout.split("\n")[:2]
    return str(Path(common).parent), b.stdout.strip(), p.relative_to(Path(top).resolve()).as_posix()


def record_touch(path, event):
    """Append a touch — a form Save, a `stand --void` — to touches.jsonl. Never raises: a Save
    must not fail because the log could not be written. Why a log: a Save's edit reaches git only
    in the next checkpoint, which may carry no prompt and an agent's trailer."""
    try:
        key = doc_key(path)
        row = {"path": str(Path(path).resolve()), "repo": key and key[0], "branch": key and key[1],
               "doc": key and key[2], "ts": now_ts(), "event": event}
        d = state_dir()
        d.mkdir(parents=True, exist_ok=True)
        with open(d / "touches.jsonl", "a") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
        return True
    except Exception:
        return False


def touch_row(row, event):
    """record_touch for a doc known only by its log row (sheep drain's pin_row). Never raises."""
    try:
        r = {"path": row["path"], "repo": row["repo"], "branch": row["branch"], "doc": row["doc"],
             "ts": now_ts(), "event": event}
        d = state_dir()
        d.mkdir(parents=True, exist_ok=True)
        with open(d / "touches.jsonl", "a") as f:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
        return True
    except Exception:
        return False


def logged_touches(path, key, since):
    out = []
    try:
        for l in (state_dir() / "touches.jsonl").read_text().splitlines():
            r = json.loads(l) if l.strip() else {}
            mine = r.get("path") == str(path) or (key and [r.get("repo"), r.get("branch"), r.get("doc")] == list(key))
            if mine and float(r.get("ts") or 0) > since:
                out.append(r)
    except (OSError, ValueError, AttributeError):
        pass
    return out


def contract_physical(primary):
    """The contract's `physical:` line, read the way bin/dispatch's physical_ok reads it: the
    first `- physical:` line of AGENTS.md, else CLAUDE.md, in the primary checkout (main's
    contract, not one a branch rewrote). None when there is none."""
    for name in ("AGENTS.md", "CLAUDE.md"):
        try:
            for l in (Path(primary) / name).read_text().splitlines():
                if l.startswith("- physical:"):
                    return l
        except (OSError, UnicodeDecodeError):
            continue
    return None


def answer_count(top, ref, rel):
    r = git(top, "show", "%s:%s" % (ref, rel), check=False)
    return 0 if r.returncode else sum(1 for l in r.stdout.split("\n") if split_answer(l) is not None)


def main_ref(top):
    for ref in ("refs/remotes/origin/main", "refs/heads/main"):
        if git(top, "rev-parse", "-q", "--verify", ref, check=False).returncode == 0:
            return ref
    return None


def origin_ref(top, branch):
    ref = "refs/remotes/origin/" + branch
    return ref if git(top, "rev-parse", "-q", "--verify", ref, check=False).returncode == 0 else None


def link_commit(top, branch, rel):
    """(sha, commit time) of the first commit on origin/<branch> that added the doc's `➤ Answer:`
    lines — the link: the hook pushes the turn that adds them (hooks/checkpoint.py), so it is when
    GitHub first showed the owner the question. On a branch, the branch's own commits first (a revision
    of a doc already on main links when the branch adds its items), else the whole history."""
    origin = origin_ref(top, branch)
    if not origin:
        return None
    base = main_ref(top)
    ranges = [[origin, "^" + base], [origin]] if base and branch != "main" else [[origin]]
    for rng in ranges:
        log = git(top, "log", "--reverse", "--format=%H %ct", "-S" + ANSWER, *rng, "--", rel, check=False).stdout.split()
        for sha, ct in zip(log[::2], log[1::2]):
            if answer_count(top, sha, rel) > answer_count(top, sha + "^", rel):
                return sha, int(ct)
    return None


def stands_line(lines):
    """(deadline, set time or None, the line) of the explicit `Stands:` line, or None."""
    for l in lines:
        m = STANDS_RE.match(l)
        if m:
            try:
                return iso_ts(m.group(1)), (iso_ts(m.group(2).rstrip(".,;)")) if m.group(2) else None), l
            except ValueError:
                raise Stop("unreadable `Stands:` line: %s" % l.strip())
    return None


def without_stands(text):
    """The doc minus its `Stands:` line and the blank line `stand` writes above it: writing the
    line is no edit of the owner's."""
    out = []
    for l in text.split("\n"):
        if STANDS_RE.match(l):
            if out and not out[-1].strip():
                out.pop()
            continue
        out.append(l)
    return "\n".join(out)


def stood_commit(top, branch, rel):
    refs = ["HEAD"] + [r for r in [origin_ref(top, branch)] if r]
    out = git(top, "log", "-1", "--format=%h", "--fixed-strings", "--grep=" + STOOD_TRAILER, *refs, "--", rel, check=False)
    return out.stdout.strip() or None


VOIDS, RESTARTS = "void", "clock"


def touches(p, top, branch, rel, link, since, skip=None):
    """Every touch after `since`, oldest first, as (time, phrase, kind). The touch rule, narrowed by
    entry D4-A (review section 3): a touch that proves the owner read the doc VOIDS — a commit on the doc
    that carries no agent trailer (the owner's, by hand); any commit whose committer is `GitHub`, a web
    edit whoever the author (`75af6eb`: author iMachine, committer GitHub); a form Save or `stand
    --void` (touches.jsonl). One that only proves the session went on RESTARTS the 24 h clock — a
    checkpoint quoting a prompt, a prompt still queued in the worktree's prompts.json, an
    uncommitted edit (timed now, so it holds the clock while it stays). Until 2026-10-15 every kind
    voided for good: 8 docs, 14 standable items, never stood (review section 3's probe). A form
    *open* is not a touch. `skip`: the commit that wrote the `Stands:` line, whose prompt asked for
    it. Commits come from HEAD and origin/<branch>, not from main (another session's checkpoints
    merged in are not this doc's session)."""
    found = []
    refs = ["HEAD"] + [r for r in [origin_ref(top, branch)] if r] + ["^" + link]
    base = main_ref(top)
    if base and branch != "main":
        refs.append("^" + base)
    on_doc = set(git(top, "log", "--format=%H", *refs, "--", rel, check=False).stdout.split())
    raw = git(top, "log", "--format=%H%x1f%ct%x1f%cn%x1f%an%x1f%B%x1e", *refs, check=False).stdout
    for rec in raw.split("\x1e"):
        parts = rec.strip("\n").split("\x1f")
        if len(parts) < 5:
            continue
        sha, ct, cn, an, body = parts[0], int(parts[1]), parts[2], parts[3], parts[4]
        if ct <= since or sha == skip:
            continue
        if cn == "GitHub":
            found.append((ct, "a GitHub web edit (%s, author %s)" % (sha[:7], an), VOIDS))
        elif PROMPT_RE.search(body):
            found.append((ct, "a prompt in the session (%s)" % sha[:7], RESTARTS))
        elif sha in on_doc and not AGENT_TRAILER_RE.search(body):
            found.append((ct, "a commit on the doc by %s (%s)" % (an, sha[:7]), VOIDS))
    gd = git(p.parent, "rev-parse", "--absolute-git-dir", check=False).stdout.strip()
    try:
        queue = json.loads((Path(gd) / "claude" / "prompts.json").read_text()) if gd else []
    except (OSError, ValueError):
        queue = []
    for e in queue if isinstance(queue, list) else []:
        ts = e.get("ts") if isinstance(e, dict) else None
        if isinstance(ts, (int, float)) and ts > since:
            found.append((ts, "a prompt in the session (queued %s)" % human(ts), RESTARTS))
    for r in logged_touches(p, doc_key(p), since):
        found.append((float(r["ts"]), "a form Save" if r.get("event") == "save" else "memo stand --void", VOIDS))
    head = git(top, "show", "HEAD:" + rel, check=False)
    if head.returncode == 0 and without_stands(p.read_text()) != without_stands(head.stdout):
        found.append((now_ts(), "an uncommitted edit", RESTARTS))
    return sorted(found, key=lambda x: x[0])


def stand_status(memo, fetch_first=True):
    """The verdict for one doc, as the dict `status --json` prints — the contract the autofinish
    launcher reads (E2/E10): doc, repo, branch, items, unanswered, deadline, verdict, reason. In
    order, the first that holds:

    stood        a commit on the doc carries `Stood-By: autofinish` and no item is open
    part-stood   the same commit, and items are still open: `no`, unmarked, conditional or reopened
                 ones a stand never takes (entry D4-A) — autofinish's rule D refuses it, so no
                 branch launches with them open; the owner's answers make it `stood`
    no-contract  the repo's contract has no `physical:` line: never stands, by either path
    taken        every D-item answered, one or more by `memo yolo` (E12): the owner never saw those, so
                 the sweep's rule D, which launches only `stood` and `answered`, skips it — the veto
                 of docs/yolo-veto-2026-10-07.md D1 (not lifted), held by code
    answered     every D-item answered (an answer, or a `>` reply under it)
    ask-mode     the branch's sent task is in mode `ask`: nothing answers it but the owner, so it never
                 stands, by the sweep or by autofinish's rule D (landing review 8)
    too-big      more than ten D-items: never stands, not even by the explicit line
    physical     `physical:` is not none and there is no `Stands:` line (household, household…)
    voided       a touch that proves the owner read it, since the link (or the `Stands:` line): a form
                 Save, a GitHub web edit, a commit of his on the doc, `stand --void`
    due          the deadline passed, untouched, items unanswered: `stand --apply` may run
    stands-at    the deadline is ahead — 24 h after the link, or after the last prompt in the
                 session or an uncommitted edit, which restart the clock (entry D4-A)

    Beside the verdict, `standable` (the open items `stand --apply` takes: `Reversible: yes`, a bare
    pick, not reopened) and `unstandable` ([id, why] for the rest), so a launcher can tell a stand
    that closes the doc from one that leaves it part-stood.

    A doc with no link — its branch or its answer lines not on GitHub — or on a branch other than
    `claude/*` (only a doc on its own branch launches through the runner) gets no verdict past
    `physical`: Stop, exit 1, so a launcher skips it. So does a failed fetch: a GitHub edit is a
    touch, and a stale origin could not show it."""
    p, top, branch, rel, _ = locate(memo)
    if fetch_first:
        fetch(top, branch)
    text = p.read_text()
    lines, items, _ = parse(text)
    open_items = [it for it in items if not answered(it, lines)]
    primary = Path(git(top, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()).parent
    out = {"doc": rel, "repo": str(top), "branch": branch, "items": len(items),
           "unanswered": len(open_items), "deadline": None, "verdict": None, "reason": ""}
    take, left = standable(open_items, lines)
    out["standable"], out["unstandable"] = [it["id"] for it in take], left
    explicit = stands_line(lines)
    link = link_commit(top, branch, rel)
    if explicit:
        out["deadline"] = iso(explicit[0])
    elif link:
        out["deadline"] = iso(link[1] + STAND_HOURS * 3600)

    try:  # E14 is a footnote to the verdict: a fault here never costs the launcher its --json
        rv = review_status(top, ["HEAD"] + [r for r in [origin_ref(top, branch)] if r], rel, text,
                           branch=branch, path=p, primary=primary)
    except Exception:
        rv = None

    def done(verdict, reason):
        out["verdict"], out["reason"] = verdict, reason
        # E14, beside the launcher's contract (which reads verdict and deadline only)
        out["review"] = rv and dict(rv, phrase=review_phrase(rv, verdict, out["deadline"]))
        out["_open"] = open_items  # for --apply; not part of the printed contract
        return out
    sha = stood_commit(top, branch, rel)
    if sha and open_items:
        return done("part-stood", "stood (%s); %d still open: %s" % (
            sha, len(open_items), ", ".join("%s %s" % (i, w) for i, w in left) or
            ", ".join(it["id"] for it in open_items)))
    if sha:
        return done("stood", "stood by autofinish (%s)" % sha)
    phys = contract_physical(primary)
    if phys is None:
        return done("no-contract", "the repo's contract has no `physical:` line: never stands")
    taken = [it["id"] for it in items if taken_answer(it["answer"])]
    if not open_items and taken:
        # S3b: the mode says whether the branch lands, not the record line (`taken_by`, `mode`, `lands`
        # beside the verdict; the launcher's contract still reads `taken` as no stand)
        by = sorted({("yolo" if OWNER + "'s yolo" in (it["answer"] or "") else "dnd" if OWNER + "'s dnd" in (it["answer"] or "")
                      else "relay") for it in items if taken_answer(it["answer"])})
        mode, where = branch_mode(branch, str(primary))
        out["taken_by"], out["mode"], out["lands"] = by, mode, taken_lands(by, mode)
        return done("taken", "%s taken unattended (%s), never seen by %s; %s" % (
            ", ".join(taken), ", ".join(by), WHO, ("lands by itself under mode %s (%s)" % (mode, where)) if out["lands"]
            else "lands by %s tap: mode %s (%s) lands no taken answer" % (WHOSE, mode or "none", where)))
    if not open_items:
        return done("answered", "every D-item answered" if items else "no D-items")
    ask = branch_in_ask_mode(branch, str(primary))
    if ask:
        return done("ask-mode", "mode ask (%s): nobody answers it but %s — never stands" % (ask, WHO))
    if len(items) > STAND_MAX_ITEMS:
        return done("too-big", "%d D-items, over %d: never stands" % (len(items), STAND_MAX_ITEMS))
    if not phys.startswith("- physical: none") and not explicit:
        return done("physical", "%s — stands only on `memo stand`" % phys[2:].strip())
    if not branch.startswith("claude/"):
        raise Stop("%s is on %s, not a claude/* branch: a doc stands only on its own branch" % (rel, branch))
    if not link:
        raise Stop("%s has no link: its answer lines are not on origin/%s (memo url)" % (rel, branch))
    since, skip = link[1], None
    if explicit:
        # the touches before the line are why it was written: count from when it was set
        cut = explicit[1]
        added = git(top, "log", "-1", "--format=%H %ct", "-S" + explicit[2], "HEAD", "--", rel, check=False).stdout.split()
        if added:
            skip = added[0]
            cut = int(added[1]) if cut is None else cut
        since = max(since, cut if cut is not None else since)
    seen = touches(p, top, branch, rel, link[0], since, skip)
    hard = [w for _, w, k in seen if k == VOIDS]
    if hard:
        return done("voided", "touched since %s: %s" % ("the Stands line" if explicit else "the link", "; ".join(hard[:3])))
    dl, why = iso_ts(out["deadline"]), ""
    soft = [(t, w) for t, w, k in seen if k == RESTARTS]
    if soft and soft[-1][0] + STAND_HOURS * 3600 > dl:
        dl = soft[-1][0] + STAND_HOURS * 3600
        out["deadline"] = iso(dl)
        why = "; the clock restarted at %s (%s)" % (human(soft[-1][0]), soft[-1][1])
    if now_ts() >= dl:
        return done("due", "deadline %s passed, untouched; %d of %d unanswered%s" % (human(dl), len(open_items), len(items), why))
    return done("stands-at", "stands at %s unless touched; %d of %d unanswered%s" % (human(dl), len(open_items), len(items), why))


def status_line(st):
    rv = st.get("review")
    return "%s (%s): %s — %s%s" % (st["doc"], st["branch"], st["verdict"], st["reason"],
                                   " · review: " + rv["phrase"] if rv else "")


def stand(memo, by=None):
    """Write the explicit `Stands:` line under the title: now + `by` hours (default 24). The only
    way in where `physical:` is not none, the way to move the time anywhere, and `--by 0` stands
    now. It resets the touch clock. Not committed here: the session's checkpoint commits it with
    the prompt that asked for it, and that one commit is not a touch (`skip` in `touches`)."""
    st = stand_status(memo)
    if st["verdict"] in ("stood", "part-stood", "no-contract", "taken", "answered", "ask-mode", "too-big"):
        raise Stop("%s never stands: %s" % (st["doc"], st["reason"]))
    p = Path(memo).expanduser().resolve()
    lines = p.read_text().split("\n")
    t = now_ts()
    at = t + (STAND_HOURS if by is None else by) * 3600
    line = "Stands: %s — set %s with `memo stand`; any touch after that voids it." % (iso(at), iso(t))
    old = [k for k, l in enumerate(lines) if STANDS_RE.match(l)]
    if old:
        lines[old[0]] = line
    else:
        h = next((k for k, l in enumerate(lines) if HEADING_RE.match(l.strip())), None)
        if h is None:
            lines[0:0] = [line, ""]
        else:
            lines[h + 1:h + 1] = ["", line]
    p.write_text("\n".join(lines))
    print("%s: stands at %s (%s)" % (st["doc"], human(at), iso(at)))
    return 0


def standable(open_items, lines):
    """(items a stand takes, [[id, why]] for the rest), in document order. Entry D4-A: only an item
    marked `Reversible: yes` with a bare `➤ Recommended:` pick stands; `no`, unmarked and conditional
    items stay open for the owner (`/embark` lists them after 72 h), and so does a reopened one — the
    session refused its answer, and a reply under it would read as answered."""
    take, left = [], []
    for it in sorted(open_items, key=lambda i: i["start"]):
        rec = " ".join((it["recommended"] or "").split())
        if reopened(it, lines):
            left.append([it["id"], "reopened"])
        elif it["reversible"] == "no":
            left.append([it["id"], "Reversible: no"])
        elif it["reversible"] is None:
            left.append([it["id"], "unmarked"])
        elif not rec:
            left.append([it["id"], "no pick"])
        elif CONDITIONAL_RE.search(rec):
            left.append([it["id"], "conditional"])
        else:
            take.append(it)
    return take, left


def stand_apply(memo):
    """At the deadline: under every item `standable` takes, `> **Applied.** Stood <date>: no
    objection by <deadline> — <the Recommended pick>`. The answer block stays empty — the reply is
    the record (D10's shape) — and a `>` reply reads as answered. The rest stay open, named, and the
    doc then reads `part-stood` (until 2026-10-15 an unmarked or pick-less item refused the whole
    stand). Commits the doc alone with the `Stood-By: autofinish` trailer and logs the stand for the
    session-start bulletin (stood.jsonl, entry S9); never pushes — the sweep does. Returns the
    {stood, open, sha} it wrote."""
    st = stand_status(memo)
    if st["verdict"] != "due":
        raise Stop("%s does not stand now: %s — %s" % (st["doc"], st["verdict"], st["reason"]))
    p, top = Path(memo).expanduser().resolve(), Path(st["repo"])
    lines = p.read_text().split("\n")
    take, left = standable(st["_open"], lines)
    if not take:
        raise Stop("%s: nothing stands — %s" % (st["doc"], ", ".join("%s %s" % (i, w) for i, w in left)))
    today = dt.datetime.fromtimestamp(now_ts()).astimezone().strftime("%Y-%m-%d")
    deadline = human(iso_ts(st["deadline"]))
    # bottom up, so each insert leaves the line numbers above it valid
    for it in sorted(take, key=lambda i: i["start"], reverse=True):
        at = it["answer_line"] if it["answer_line"] is not None else it["rec_end"] - 1
        ind = re.match(r"\s*", lines[at]).group(0)
        lines[at + 1:at + 1] = ["", "%s> **Applied.** Stood %s: no objection by %s — %s"
                                % (ind, today, deadline, it["recommended"].strip())]
    new = "\n".join(lines)
    nl, items, _ = parse(new)
    ids = {it["id"] for it in take}
    bad = [it["id"] for it in items if it["id"] in ids and not answered(it, nl)]
    if bad:
        raise Stop("the replies did not take for %s — nothing written" % ", ".join(bad))
    p.write_text(new)
    try:  # E14: the record says the deadline answered, and whether the owner had looked; in the same commit
        stamp(p, stood=True)
    except Exception as e:  # a stamp is the record's footnote, never a reason not to stand
        print("%s: review not stamped: %s" % (st["doc"], e), file=sys.stderr)
    # the replies change the derivation (k of n answered): stamp the set's Status lines into the same
    # commit, or every stand leaves a line `keel lint` fails (review 2026-10-16); quiet, as in the sweep
    also = []
    try:
        import contextlib
        import io
        with contextlib.redirect_stdout(io.StringIO()):
            also = [str(q.resolve().relative_to(top.resolve())) for q in keel_stamp(p)]
    except Exception as e:
        print("%s: Status line not stamped: %s" % (st["doc"], e), file=sys.stderr)
    stood_ids = ", ".join(it["id"] for it in sorted(take, key=lambda i: i["n"]))
    still = ("\nStill open, %s to answer: %s.\n" % (WHOSE, ", ".join("%s (%s)" % (i, w) for i, w in left))) if left else ""
    msg = ("Memo: %s stood — %s\n\nNo objection by %s: each Reversible: yes item's recommendation stands (entry D4-A\n"
           "of docs/design-docs-2026-10-14.md). The answer blocks stay empty; the replies are the record.\n%s\n%s\n"
           % (st["doc"], stood_ids, deadline, still, STOOD_TRAILER))
    r = subprocess.run(["git", "-C", str(top), "commit", "-q", "-F", "-", "--", st["doc"]] + [f for f in also if f != st["doc"]],
                       input=msg, text=True, capture_output=True)
    if r.returncode:
        raise Stop("replies written but not committed: %s" % (r.stderr or r.stdout).strip())
    sha = git(top, "rev-parse", "--short", "HEAD").stdout.strip()
    record_stood(top, st, [it["id"] for it in take], [i for i, _ in left], sha)
    print("%s: stood — %s (%s)%s" % (st["doc"], stood_ids, sha,
                                     "; open: " + ", ".join("%s %s" % (i, w) for i, w in left) if left else ""))
    return {"stood": [it["id"] for it in take], "open": left, "sha": sha}


def record_stood(top, st, stood, still, sha):
    """One row per stand in stood.jsonl, beside touches.jsonl: what `hooks/bulletin.py` shows at every
    session start for 7 days (review D3-A). Never raises: the commit is the record."""
    try:
        primary = Path(git(top, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()).parent
        row = {"ts": now_ts(), "repo": primary.name, "primary": str(primary), "branch": st["branch"],
               "doc": st["doc"], "stood": stood, "open": still, "sha": sha}
        d = state_dir()
        d.mkdir(parents=True, exist_ok=True)
        with open(d / "stood.jsonl", "a") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    except Exception:
        pass


# The stand sweep (entry D4-A, S3; review section 3, "What must change"): `stand --sweep`, called by
# `bin/ask poll`'s laptop job (every 300 s) and running at most hourly, walks `git worktree list`
# over every local checkout — not ask poll's bare mirror, which has no worktree to commit in, and
# not memo_files, which drops a worktree's copy of a doc that also sits on main — and stands each
# `due` doc there: `stand --apply`, then a push of that branch with the ref spelled out. Skipped, as
# the rest of D11 skips: a branch not `claude/*` (a doc on main), a worktree a session holds (its
# owner file seen within 2 h: it may hold chat answers not yet written; only checkpoint.py and
# bin/pickup write that file, so a session with hooks off is covered by the 24 h quiet alone), a git
# operation in progress; physical repos, docs over ten items and docs with no link get no `due`.
# It is armed by hand: ask poll runs it only while `sweep-armed` exists in the state dir, so the
# first live run is the owner's call (`stand --sweep --arm`), never a merge's side effect.
SWEEP_EVERY = 3600
GIT_BUSY = ("rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD")  # checkpoint.py's


def sweep_armed():
    return (state_dir() / "sweep-armed").is_file()


def sweep_arm(on):
    f = state_dir() / "sweep-armed"
    if on:
        state_dir().mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps({"ts": now_ts(), "by": os.environ.get("USER") or "?"}) + "\n")
        print("stand sweep: armed (%s) — bin/ask poll runs it at most hourly from now on" % f)
    else:
        if f.exists():
            f.unlink()
        print("stand sweep: disarmed (%s gone)" % f)
    return 0


def worktrees(repo):
    """[(path, branch)] of `git worktree list` for the checkout at `repo` — the primary first; a
    detached one has branch ''. [] outside git."""
    r = git(repo, "worktree", "list", "--porcelain", check=False)
    if r.returncode:
        return []
    out, cur = [], {}
    for l in r.stdout.split("\n") + [""]:
        if l.startswith("worktree "):
            cur = {"path": l[len("worktree "):], "branch": ""}
        elif l.startswith("branch refs/heads/"):
            cur["branch"] = l[len("branch refs/heads/"):]
        elif not l.strip() and cur:
            if Path(cur["path"]).is_dir():
                out.append((Path(cur["path"]), cur["branch"]))
            cur = {}
    return out


def holder(wt, me=True):
    """Who holds the worktree, by checkpoint's held_by_other — the one rule for the plumb's refusal
    and the lookout's gate (S11 item 5: the two disagreed on a handed-over worktree): its owner file
    names a session other than this one, not handed over, seen within OWNER_TTL. {session, age},
    {unknown: why} when the lock cannot be read (unknown reads as held), or None when free.
    me=False: the caller's own session holds it too — a lookout pass run from a person's session
    starts no run beside that session (S11c item 12)."""
    gd = git(wt, "rev-parse", "--absolute-git-dir", check=False).stdout.strip()
    if not gd:
        return {"unknown": "its worktree %s has no readable git dir, so its lock is unknown" % wt}
    try:
        c = _common()
    except ImportError:
        return {"unknown": "no regatta core here to read the lock of %s" % wt}
    lock = c.read_owner(Path(gd) / "claude")
    if not lock or not lock.get("session") or lock.get("handover") \
            or (me and lock["session"] == os.environ.get("CLAUDE_CODE_SESSION_ID")):
        return None
    try:
        age = now_ts() - float(lock.get("seen") or 0)
    except (TypeError, ValueError):
        return None
    return {"session": str(lock["session"]), "age": age} if age < c.OWNER_TTL else None


def held_by(wt, h=None, at=False):
    """The phrase for a session that holds the worktree (holder, or `h` already read), or None; `at`
    names the worktree in it (the lookout's card, where the branch alone is named)."""
    h = h or holder(wt)
    if not h:
        return None
    return h["unknown"] if "unknown" in h else "held by session %s%s, seen %dm ago" % (
        h["session"][:8], " at %s" % wt if at else "", h["age"] // 60)


def git_busy(wt):
    gd = git(wt, "rev-parse", "--absolute-git-dir", check=False).stdout.strip()
    return next((m for m in GIT_BUSY if gd and (Path(gd) / m).exists()), None)


def sweep_docs(wt, branch):
    """The .md files the branch changed against main that hold D-items (handoff briefs are not docs)."""
    base = main_ref(wt)
    if not base:
        return []
    names = git(wt, "diff", "--name-only", "--diff-filter=AM", "%s...HEAD" % base, "--", "*.md", check=False).stdout.split("\n")
    out = []
    for rel in [n for n in names if n and not n.startswith("docs/handoff/")]:
        q = wt / rel
        try:
            text = q.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        if maybe_memo(text) and parse(text)[1]:
            out.append(q)
    return out


def stand_sweep(root, force=False, dry=False):
    """One pass; returns the rows it printed as dicts {repo, branch, doc, verdict, what}."""
    marker = state_dir() / "sweep.json"
    t = now_ts()
    try:
        last = float(json.loads(marker.read_text()).get("ts") or 0)
    except (OSError, ValueError, AttributeError):
        last = 0
    if not force and not dry and t - last < SWEEP_EVERY:
        print("stand sweep: ran %dm ago; next after %dm" % ((t - last) // 60, SWEEP_EVERY // 60))
        return []
    rows, seen_repos = [], set()
    for root_dir in repo_roots(root):
        common = git(root_dir, "rev-parse", "--path-format=absolute", "--git-common-dir", check=False).stdout.strip()
        if not common or common in seen_repos:
            continue
        seen_repos.add(common)
        for wt, branch in worktrees(root_dir):
            if not branch.startswith("claude/"):
                continue
            docs = sweep_docs(wt, branch)
            if not docs:
                continue
            why = held_by(wt) or (("a git %s in progress" % git_busy(wt)) if git_busy(wt) else None)
            if not why:
                ask = branch_in_ask_mode(branch, str(Path(common).parent))
                why = ask and "mode ask (%s): nobody answers it but %s" % (ask, WHO)
            for q in docs:
                row = {"repo": Path(common).parent.name, "branch": branch, "doc": str(q.relative_to(wt)), "path": str(q)}
                if why:
                    rows.append(dict(row, verdict="skipped", what=why))
                    continue
                try:
                    st = stand_status(str(q), fetch_first=not dry)  # a dry run writes nothing, refs included
                except Stop as e:
                    rows.append(dict(row, verdict="no verdict", what=str(e)))
                    continue
                if st["verdict"] != "due":
                    rows.append(dict(row, verdict=st["verdict"], what=st["reason"]))
                    continue
                if not st["standable"]:
                    rows.append(dict(row, verdict="due", what="nothing stands: " + ", ".join("%s %s" % (i, w) for i, w in st["unstandable"])))
                    continue
                if dry:
                    rows.append(dict(row, verdict="would stand", what=", ".join(st["standable"])))
                    continue
                try:
                    res = stand_apply(str(q))
                except Stop as e:
                    rows.append(dict(row, verdict="failed", what=str(e)))
                    continue
                push = git(wt, "push", "-q", "origin", "refs/heads/%s:refs/heads/%s" % (branch, branch), check=False)
                rows.append(dict(row, verdict="stood" if not res["open"] else "part-stood",
                                 what="%s (%s)%s%s" % (", ".join(res["stood"]), res["sha"],
                                                      "; open: " + ", ".join("%s %s" % (i, w) for i, w in res["open"]) if res["open"] else "",
                                                      "" if push.returncode == 0 else "; not pushed: " + (push.stderr or push.stdout).strip()[:120])))
    if not dry:
        try:
            state_dir().mkdir(parents=True, exist_ok=True)
            marker.write_text(json.dumps({"ts": t, "docs": len(rows),
                                          "stood": sum(1 for r in rows if r["verdict"] in ("stood", "part-stood"))}) + "\n")
        except OSError:
            pass
    for r in rows:
        print("%s %s %s: %s — %s" % (r["repo"], r["branch"], r["doc"], r["verdict"], r["what"]))
    print("stand sweep: %d doc%s on claude/* worktrees, %d stood%s" % (
        len(rows), "" if len(rows) == 1 else "s", sum(1 for r in rows if r["verdict"] in ("stood", "part-stood")),
        " (dry run)" if dry else ""))
    return rows


# skipper-modes D1-A (2026-10-21): what `yolo --dnd` never takes, whatever the pick. Each is a test
# over the item's own lines (title, options, marks), matched case-blind; a hit holds the item for a
# relay, and a false hit costs one card, never a wrong answer. Money is real money only: a model
# cost is written `$<list> ($<eff> effective)` (rules: every model cost), so those pairs are cut
# before the test, and a `list-only` mark is money by the same rule. A repo whose contract is not
# `physical: none` holds every item (DND_PHYSICAL), read as dispatch's physical_ok reads it.
MODEL_COST_RE = re.compile(r"\$[\d.,]+[kKmM]?\s*\(\s*\$[\d.,]+[kKmM]?\s+effective\s*\)")
DND_HOLDS = (
    ("money in an option", re.compile(r"[$€£]\s?\d|\blist-only\b|\b(?:usd|eur|gbp)\b|\bsubscription\b|\binvoice\b", re.I)),
    ("a deletion", re.compile(r"\bdelet(?:e|es|ed|ing|ion)\b|\bdrop (?:the |a )?(?:table|database|repo)|\bwipe\b|\bpurge\b|\bforce-push", re.I)),
    ("a public publish", re.compile(r"\bpublish(?:es|ed|ing)?\b|\bmake (?:it |them )?public\b|\bgo(?:es)? public\b|\bopen[- ]source\b|\bpublic (?:twin|repo|release)\b", re.I)),
    ("a third party's answer", re.compile(r"\bthird[- ]part(?:y|ies)\b|\bvendor'?s? (?:answer|reply|approval)\b|\boutside (?:party|maintainer)\b|\btheir (?:answer|approval|reply|sign-off)\b", re.I)),
)


def dnd_held(it, lines, physical=None):
    """The held class of one open item under `yolo --dnd`, or None when its pick may be taken: no
    pick, a conditional or reopened one, unmarked, a physical repo, or one of DND_HOLDS in its lines."""
    rec = " ".join((it["recommended"] or "").split())
    if reopened(it, lines):
        return "reopened (> **Reopened.** under it) — %s answers it again" % WHO
    if not rec:
        return "no ➤ Recommended: pick"
    if CONDITIONAL_RE.search(rec):
        return "its pick is conditional (%s) — a probe nobody ran" % rec[:60]
    if it["reversible"] is None:
        return "not marked Reversible: yes|no"
    # no `physical:` line reads as physical, as autofinish's held_slice and dispatch's physical_ok
    # fail closed (landing review 17)
    if physical is None:
        return "the repo's contract has no `physical:` line (read as physical)"
    if not physical.startswith("- physical: none"):
        return "the repo acts on the real world (%s)" % physical.strip()[:60]
    body = MODEL_COST_RE.sub(" ", "\n".join(lines[it["start"]:it["end"]]))
    for why, rx in DND_HOLDS:
        m = rx.search(body)
        if m:
            return "%s (%s)" % (why, m.group(0).strip())
    return None


def doc_physical(p):
    """The `physical:` line of the contract in the doc's checkout (its primary, as contract_physical
    reads), or None when the doc is in no repo or the contract has no such line."""
    top = git(p.parent, "rev-parse", "--show-toplevel", check=False).stdout.strip()
    if not top:
        return None
    gd = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir", check=False).stdout.strip()
    primary = str(Path(gd).parent) if gd.endswith("/.git") else top
    return contract_physical(primary) or contract_physical(top)


def yolo(memo, dry=False, today=None, dnd=False):
    """E12 of docs/autofinish-design-2026-10-02.md, widened by skipper-modes D1 (the owner, 2026-10-21: "A,
    and --yolo goes all the way"). A `dispatch --yolo` run answers the doc it would otherwise stop on.

    Plain: every item not yet answered, in document order, with a bare `➤ Recommended:` pick —
    `Reversible: no` and unmarked items included — gets `Taken unattended (<owner>'s yolo, <date>):
    <pick>` in its answer block, and the run goes on (exit 0). The first with no pick, a conditional
    one (`none until …`, `A if … else B`: a probe nobody ran) or a reopened one (its box holds the owner's
    refused answer, which a pick would overwrite) stops it (exit 3), and then NOTHING is written:
    the owner answers the whole list, never one half-filled with picks the owner did not make.

    `--dnd`: the same picks as `Taken unattended (<owner>'s dnd, <date>): <pick>`, except a held item
    (dnd_held: D1-A's classes, plus the three stops above), which is left open and printed as `held
    D<n> …` for the run to relay. Not all-or-nothing: the rest is written and built on. Exit 0 when
    nothing is held, 4 when something is (whatever was taken is written).

    Neither answer is the owner's word: `taken`, never `answered`, and the branch stops at a ready PR
    (yolo-veto D1). Not committed here: the session's checkpoint commits it. `--dry-run` prints the
    same verdict and writes nothing. Returns the exit code."""
    p = Path(memo)
    text = p.read_text()
    lines, items, _ = parse(text)
    today = today or dt.date.today().isoformat()
    physical = doc_physical(p) if dnd else None
    take, held = {}, []
    for it in sorted(items, key=lambda x: x["start"]):
        if yolo_settled(it, lines):
            continue
        rec = " ".join((it["recommended"] or "").split())
        if dnd:
            why = dnd_held(it, lines, physical)
            if why:
                held.append((it, why))
                continue
        else:
            why = None
            if reopened(it, lines):
                why = "reopened (> **Reopened.** under it) — %s answers it again" % WHO
            elif not rec:
                why = "no ➤ Recommended: pick"
            elif CONDITIONAL_RE.search(rec):
                why = "its pick is conditional (%s) — a probe nobody ran" % rec[:60]
            if why:
                print("stopped at %s (line %d) — %s: %s" % (it["id"], it["start"] + 1, it["title"][:70], why))
                print("nothing written: the run stops here and %s answers the list" % WHO)
                return 3
        take[it["id"]] = (DND_ANSWER if dnd else YOLO_ANSWER) % (today, rec)
    for it, why in held:
        print("held %s (line %d) — %s: %s" % (it["id"], it["start"] + 1, it["title"][:70], why))
    if not take:
        if held:
            print("%s: nothing taken — every open decision is held for a relay" % p.name)
            return 4
        print("%s: no open decision — nothing to take" % p.name)
        return 0
    new, rep_ = merge(text, {"items": take}, today=today)
    for k in sorted(take, key=lambda x: int(x[1:])):
        print("%s %s: %s" % ("would take" if dry else "took", k, take[k]))
    if not dry:
        p.write_text(new)
        _, after, _ = parse(new)
        left = [it["id"] for it in after if it["id"] in take and not yolo_settled(it, new.split("\n"))]
        if left:  # read back, never assumed
            p.write_text(text)
            raise Stop("the answers did not take for %s — the doc is as it was" % ", ".join(left))
    if held:
        print("%d held for a relay: %s" % (len(held), ", ".join(it["id"] for it, _ in held)))
        return 4
    return 0


# ----------------------------------------------------------------------------- light

# B1 of docs/light-gate-2026-10-16.md: the design gate as a chat questionnaire, the doc still the record.
# AskUserQuestion's caps, read from the installed binary (light P2, 2.1.300): 1-4 questions per call,
# 2-4 options per question, "Other" added by the tool, `header` "max 12 chars" (guidance, not schema).
LIGHT_MAX_ITEMS = 4   # light D4 as revised (the owner, 2026-10-16): "4Ds max in the chain"; a fifth makes it a full memo
LIGHT_PER_CALL = 3    # …"3+other is better": three D-items per call, Open feedback the last question of the last
LIGHT_HEADER = 12
LIGHT_QUESTION = 200  # session 0's D1 ran ~300 characters; short is what made it answerable on a phone (L3)
LIGHT_LABEL_WORDS = 5
LIGHT_DESCRIPTION = 160  # the tool's guidance: "one short line on what choosing it leads to" (P2)
LIGHT_REVIEWS = ("light-ok", "redesign", "promote")  # reviewer-high's verdicts on a light doc (light D3, revised)
RECOMMENDED_TAG = " (Recommended)"
FEEDBACK_QUESTION = "Open feedback — anything these decisions miss? Type it in Other."
# "No"-shaped only, the automatic Other field is the yes: session 0's "Yes, see Other" option submitted
# before the owner could type (the doc's Open feedback, 2026-10-16)
FEEDBACK_OPTIONS = (("No", "Nothing to add"), ("Not now", "Nothing for this doc today"))
# words a header skips for the item's first telling one: `D1 How` says nothing, `D1 light` does
HEADER_SKIP = {"how", "what", "which", "who", "whom", "when", "where", "why", "whether", "should", "does", "do",
               "the", "a", "an", "is", "are", "to", "of", "for", "and", "or", "in", "on", "at", "by", "with"}


def ask_parts(r):
    """The AskUserQuestion parts of one transcript record: ("use", id, input) for a call and ("result",
    tool_use id, toolUseResult) for what came back. One reader for `light --write` and bin/interruptions
    (light B1: factored out of interruptions' transcript_rows; it lives here because a new file under
    bin/ is born in regatta now, and asklib is the relay seam that imports nothing of Claude's). A result
    is a tool_result whose toolUseResult carries `questions` or `answers`, the AskUserQuestion shape (73
    of 73 on this Mac's disk, 2026-10-19); callers key it by the use's id."""
    msg = r.get("message") if isinstance(r, dict) else None
    content = msg.get("content") if isinstance(msg, dict) else None
    out = []
    if not isinstance(content, list):
        return out
    for b in content:
        if not isinstance(b, dict):
            continue
        if b.get("type") == "tool_use" and b.get("name") == "AskUserQuestion":
            inp = b.get("input")
            out.append(("use", b.get("id"), inp if isinstance(inp, dict) else {}))
        elif b.get("type") == "tool_result":
            tur = r.get("toolUseResult")
            if isinstance(tur, dict) and ("answers" in tur or "questions" in tur):
                out.append(("result", b.get("tool_use_id"), tur))
    return out


def plain(s):
    """Markdown off for a chip on a phone: links to their text, code ticks and bold or italic marks gone."""
    s = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", s or "")
    s = s.replace("`", "").replace("**", "").replace("__", "")
    s = re.sub(r"(?<!\w)[*_](\S[^*_]*?)[*_](?!\w)", r"\1", s)
    return " ".join(s.split())


def cap(s, n):
    """`s` cut to at most n characters, at a word, with an ellipsis."""
    if len(s) <= n:
        return s
    cut = s[:n - 1].rsplit(" ", 1)[0].rstrip(" ,;:—-")
    return cut + "…"


def light_open(text):
    """(lines, every item, the items still open) — what a questionnaire asks. Open is yolo_settled's rule,
    not answered()'s: a session's own `> **Checked.**` under an empty box must not drop the item from the
    questionnaire (finish review, 2026-10-19)."""
    lines, items, _ = parse(text)
    return lines, items, [it for it in items if not yolo_settled(it, lines)]


# A pick naming two options (`A and B`, `A, B`, `A or B`, `A+B`): one chip cannot carry it. A qualified
# one (`A, but cap it at 7 days`) is prose this regex cannot tell from a note (`A, pick 1`); B2's.
TWO_PICK_RE = re.compile(r"^[A-Z]\s*(?:,|\+|&|/|\band\b|\bor\b)\s*[A-Z]\b")


def rec_letter(it):
    """The ➤ Recommended: pick's letter, when it is one of the item's options; else None."""
    m = LETTER_RE.match((it["recommended"] or "").strip())
    return m.group(1) if m and m.group(1) in [o[0] for o in it["options"]] else None


def light_surface():
    """Where the owner answers (M2): recorded, never judged. `rc` is bin/keel's Remote Control signal. The VS Code
    side panel leaves TERM_PROGRAM empty and says so in the entrypoint (probed 2026-10-19, finish review)."""
    ep = os.environ.get("CLAUDE_CODE_ENTRYPOINT")
    if ep == "sdk-cli":
        return "rc"
    return "vscode" if ep == "claude-vscode" or os.environ.get("TERM_PROGRAM") == "vscode" else "terminal"


def light_check(text):
    """The reasons the open items may not go as a questionnaire — [] when they may. The mechanical half
    of the doc's classification: C1 size, C2's option count, C3 ready, C4 attended. C2's prose half (a
    `Reversible: no` option names its cost) and C5 (a decision that is a collaborator's too) are the skill's."""
    lines, _, open_items = light_open(text)
    why = []
    if not open_items:
        why.append("nothing open — every D-item is answered")
    if len(open_items) > LIGHT_MAX_ITEMS:
        why.append("C1 size: %d open D-items, at most %d (a fifth makes it a full memo, light D4)"
                   % (len(open_items), LIGHT_MAX_ITEMS))
    errors = lint(text)[0]
    for it in open_items:
        n = len(it["options"])
        if not 2 <= n <= 4:
            why.append("C2 options: %s has %d `- A — …` options, a chip question takes 2 to 4" % (it["id"], n))
        rec = " ".join((it["recommended"] or "").split())
        if reopened(it, lines):  # --write's read-back is answered(), which a Reopened reply keeps False
            why.append("C3 ready: %s is reopened — the session answers its reopen first" % it["id"])
        elif not rec:
            why.append("C3 ready: %s has no ➤ Recommended: pick" % it["id"])
        elif CONDITIONAL_RE.search(rec):
            why.append("C3 ready: %s's pick is conditional (%s) — a probe nobody ran" % (it["id"], cap(rec, 60)))
        elif TWO_PICK_RE.match(rec):
            why.append("C3 ready: %s's pick (%s) is not one option — a chip carries one" % (it["id"], cap(rec, 40)))
        elif n and not rec_letter(it):
            why.append("C3 ready: %s's pick (%s) names none of its options" % (it["id"], cap(rec, 40)))
        why += ["C3 ready: " + e for e in errors if e.startswith(it["id"] + " (")]
    if os.environ.get(UNATTENDED_ENV):
        why.append("C4 attended: %s is set — an unattended run relays instead (bin/ask relay)" % UNATTENDED_ENV)
    return why


def option_chip(letter, text):
    """(label, description) for one `- A — …` option (L3): the label is the text before the first ` — `,
    `:` or `(`, at most five words; the description is the rest, or the whole text when the label was cut."""
    t = plain(text)
    # only at a word's end: `07:35`, a URL or `f(x)` is never cut (finish review, 2026-10-19)
    cuts = [i for i in (t.find(" — "), t.find(": "), t.find(" (")) if i > 0]
    label, rest = (t[:min(cuts)], t[min(cuts):]) if cuts else (t, "")
    rest = re.sub(r"^\s*(?:—|:)\s*", "", rest).strip()
    words = label.split()
    if len(words) > LIGHT_LABEL_WORDS:
        label, rest = " ".join(words[:LIGHT_LABEL_WORDS]), t
    label = label.strip().rstrip(".,;") or "Option " + letter
    return label, cap(rest or t, LIGHT_DESCRIPTION)


def light_question(it):
    """`D2 — <title> <the body's first sentence>`, near 200 characters: the D-id leads, so --write finds it."""
    title = plain(it["title"]).rstrip()
    first = []
    for l in it["body"].split("\n"):
        if not l.strip():
            if first:
                break
            continue
        if OPTION_RE.match(l) or REVERSIBLE_RE.match(l):
            break
        first.append(l.strip())
    para = plain(" ".join(first))
    m = re.match(r"^(.+?[.!?)])(?:\s|$)", para)
    sentence = m.group(1) if m else para
    q = "%s — %s" % (it["id"], title)
    if sentence:
        q += ("" if re.search(r"[.!?:]$", title) else ".") + " " + sentence
    return cap(q, LIGHT_QUESTION)


def light_header(it):
    words = re.findall(r"[A-Za-z][A-Za-z0-9-]*", plain(it["title"]))
    word = next((w for w in words if len(w) > 2 and w.lower() not in HEADER_SKIP), words[0] if words else "")
    return ("%s %s" % (it["id"], word.strip("-")))[:LIGHT_HEADER].rstrip()


def light_options(it):
    """[(letter, label, description)] in chip order: the Recommended option first, tagged (L3). A label
    two options share gets its letter, so a tap maps back to exactly one."""
    chips = [(o[0],) + option_chip(o[0], o[1]) for o in it["options"]]
    labels = [c[1] for c in chips]
    if len(set(labels)) < len(labels):
        chips = [(c[0], "%s · %s" % (c[0], c[1]), c[2]) for c in chips]
    rec = rec_letter(it)
    chips.sort(key=lambda c: c[0] != rec)
    return [(c[0], c[1] + (RECOMMENDED_TAG if c[0] == rec else ""), c[2]) for c in chips]


def light_plan(text):
    """The AskUserQuestion calls, in order: three open items per call (D4, revised), Open feedback the last
    question of the last call. Each call is the tool's input, to be made exactly as printed."""
    _, _, open_items = light_open(text)
    calls = []
    for k in range(0, len(open_items), LIGHT_PER_CALL):
        qs = [{"question": light_question(it), "header": light_header(it), "multiSelect": False,
               "options": [{"label": l, "description": d} for _, l, d in light_options(it)]}
              for it in open_items[k:k + LIGHT_PER_CALL]]
        calls.append({"questions": qs})
    if calls:
        calls[-1]["questions"].append({"question": FEEDBACK_QUESTION, "header": "Feedback", "multiSelect": False,
                                       "options": [{"label": l + (RECOMMENDED_TAG if i == 0 else ""), "description": d}
                                                   for i, (l, d) in enumerate(FEEDBACK_OPTIONS)]})
    return calls


def light_transcripts(session):
    """This session's transcripts: `<login dir>/projects/*/<session>.jsonl` under every login, as
    bin/interruptions' SOURCES globs (session 0's cwd moved between repos, so a path built from the cwd's
    slug would miss). KEEL_TRANSCRIPTS (roots, `:`-separated) points the tests at fixtures."""
    if not re.match(r"^[\w-]+$", session or ""):
        raise Stop("no session id to read the answers from — CLAUDE_CODE_SESSION_ID is unset; pass --session")
    env = os.environ.get("KEEL_TRANSCRIPTS")
    roots = [Path(p) for p in env.split(":") if p] if env else sorted(Path.home().glob(".claude*/projects"))
    found = []
    for r in roots:
        found += sorted(r.glob("*/%s.jsonl" % session)) + sorted(r.glob("%s.jsonl" % session))
    return found


def light_records(files):
    """({use id: (ts, input)}, {use id: (ts, toolUseResult)}) from the transcripts; ts in epoch seconds."""
    uses, results = {}, {}
    for f in files:
        try:
            fh = open(f, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"AskUserQuestion"' not in line and '"toolUseResult"' not in line:
                    continue
                try:
                    r = json.loads(line)
                    ts = iso_ts(r.get("timestamp") or "")
                except (ValueError, TypeError):
                    continue
                for kind, key, val in ask_parts(r):
                    (uses if kind == "use" else results).setdefault(key, (ts, val))
    return uses, results


def utc(ts, fmt):
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime(fmt)


def took_for(seconds):
    s = int(round(seconds))
    if s < 60:
        return "%d s" % s
    if s < 3600:
        return "%d min %d s" % (s // 60, s % 60)
    return "%d h %d min" % (s // 3600, s % 3600 // 60)


def note_of(ann):
    """An annotation's free text: `{"notes": "…"}` as bin/interruptions reads it, or a plain string."""
    if isinstance(ann, dict):
        ann = ann.get("notes")
    return ann.strip() if isinstance(ann, str) else ""


def gate_of(lines):
    """The doc's `Gate:` line as {mode, text, line}, or None. Only above the first D-item (session 0's doc
    keeps it under its Decisions heading): a body quoting a Gate line is prose, not the doc's gate (finish
    review, 2026-10-19)."""
    fence = fenced(lines)
    for k, l in enumerate(lines):
        if not fence[k] and item_match(l):
            return None
        m = not fence[k] and GATE_RE.match(l)
        if m:
            return {"mode": m.group("mode"), "text": l, "line": k + 1}
    return None


def set_gate(text, gate):
    """`gate` in place of the doc's Gate line, else under the `Written by` paragraph, else under the title."""
    lines = text.split("\n")
    at = gate_of(lines)
    if at:
        lines[at["line"] - 1] = gate
        return "\n".join(lines)
    fence = fenced(lines)
    head = next((k for k, l in enumerate(lines) if l.startswith("## ") and not fence[k]), len(lines))
    wb = next((k for k in range(head) if not fence[k] and lines[k].startswith("Written by")), None)
    if wb is not None:
        k = wb
        while k + 1 < head and lines[k + 1].strip():  # the paragraph ends at a blank line or the first heading
            k += 1
        lines[k + 1:k + 1] = ["", gate]
    else:
        t = next((k for k in range(head) if lines[k].startswith("# ")), None)
        if t is None:
            lines[0:0] = [gate, ""]
        else:
            lines[t + 1:t + 1] = ["", gate]
    return "\n".join(lines)


def light_cmd_check(memo, record=False):
    p = Path(memo)
    text = p.read_text()
    _, _, open_items = light_open(text)
    if not open_items:  # nothing to ask is no refusal: D1 (revised) re-runs the check unasked on a doc already answered
        print("%s: nothing open — every D-item is answered; nothing to ask" % p.name)
        return 0
    why = light_check(text)
    if not why:
        _, _, open_items = light_open(text)
        print("%s: light — %d open D-item%s, %d call%s; surface %s; `keel light --plan` prints them" % (
            p.name, len(open_items), "" if len(open_items) == 1 else "s", len(light_plan(text)),
            "" if len(light_plan(text)) == 1 else "s", light_surface()))
        return 0
    for w in why:
        print("%s: not light — %s" % (p.name, w))
    gate = "Gate: memo — light refused: %s" % "; ".join(why)
    held = gate_of(text.split("\n"))
    if record and held and held["mode"] == "light":  # a doc answered in chat keeps its row (M1, M5)
        print("not recorded: line %d already says how it was asked (%s)" % (held["line"], cap(held["text"], 60)))
    elif record:
        p.write_text(set_gate(text, gate))
        print("recorded: " + gate)
    else:
        print("the memo path: `keel line %s`; --record writes `%s`" % (memo, cap(gate, 80)))
    return 1


def light_review(review):
    """D3 as answered: reviewer-high reads every doc proposed for the light path before the owner is asked, so
    --plan and --write both take its verdict, and only `light-ok` goes on (finish review, 2026-10-19: the
    verdict was optional and checked only after the answers)."""
    if review == "light-ok":
        return
    if not review:
        raise Stop("light: --review light-ok — reviewer-high's verdict on the doc first (light D3)")
    raise Stop("reviewer-high returned %s — not a light doc (light D3): %s" % (
        review, "back to its author" if review == "redesign" else "a full memo, `keel line`"))


def light_write(memo, why, review=None, session=None):
    """L4: the taps from this session's transcript into the doc, through merge — never an answer typed.
    Every open item needs a result: one missing (never asked, declined, Esc, a timeout, a follow-up)
    writes nothing and exits 3, the memo path, as `yolo` does. A tapped label maps back to its letter
    (`A — Voice Memos (Recommended)`); anything else the owner typed is `Other — <text verbatim>`. An
    annotation goes under its item as `**<owner>, <date>:**`; Open feedback's Other text, its annotation and
    a typed `response` go under Open feedback (a response in a call without it, under that call's first
    item); a "No"-shaped label never does. One `Gate: light — …` line records how. Returns the exit code."""
    light_review(review)
    p = Path(memo)
    text = p.read_text()
    _, _, open_items = light_open(text)
    if not open_items:
        print("%s: no open decision — nothing to write" % p.name)
        return 0
    files = light_transcripts(session or os.environ.get("CLAUDE_CODE_SESSION_ID"))
    if not files:
        raise Stop("no transcript for session %s under %s" % (session or os.environ.get("CLAUDE_CODE_SESSION_ID"),
                                                              os.environ.get("KEEL_TRANSCRIPTS") or "~/.claude*/projects"))
    uses, results = light_records(files)
    take, notes, missing, used, seen = {}, {}, [], {}, set()
    for it in open_items:
        # L4: a question is the item's when it starts with its D-id, so a title fixed after --plan, or a
        # question the session reflowed, still finds its answer (finish review, 2026-10-19)
        lead = it["id"] + " —"
        asked = [(ts, uid, x["question"]) for uid, (ts, inp) in uses.items()
                 for x in inp.get("questions") or []
                 if isinstance(x, dict) and isinstance(x.get("question"), str) and x["question"].startswith(lead)]
        if not asked:
            missing.append((it["id"], "never asked — no AskUserQuestion with its question (`keel light --plan`)"))
            continue
        ts_use, uid, q = max(asked)
        seen.add(uid)
        got = results.get(uid)
        tur = got[1] if got else {}
        a = (tur.get("answers") or {}).get(q) if isinstance(tur.get("answers"), dict) else None
        if not got:
            missing.append((it["id"], "asked %s, no result on record (declined, Esc, or still open)" % utc(ts_use, "%H:%MZ")))
        elif tur.get("afkTimeoutMs"):
            missing.append((it["id"], "the dialog timed out (afkTimeoutMs): what was tapped is not an answer"))
        elif tur.get("followUp"):
            missing.append((it["id"], "%s asked a follow-up — answer it, then `keel light --plan` again" % WHO))
        elif not isinstance(a, str) or not a.strip():
            missing.append((it["id"], "no answer to it in the result"))
        if missing and missing[-1][0] == it["id"]:
            continue
        used[uid] = (ts_use, got[0], tur)
        a = a.strip()
        base = a[:-len(RECOMMENDED_TAG)] if a.endswith(RECOMMENDED_TAG) else a
        letter = next((l for l, lab, _ in light_options(it)
                       if (lab[:-len(RECOMMENDED_TAG)] if lab.endswith(RECOMMENDED_TAG) else lab) == base), None)
        take[it["id"]] = CHAT_ANSWER % (utc(got[0], "%Y-%m-%d %H:%MZ"), "%s — %s" % (letter or "Other", a))
        n = note_of((tur.get("annotations") or {}).get(q) if isinstance(tur.get("annotations"), dict) else None)
        if n:
            notes.setdefault(it["id"], []).append((utc(got[0], "%Y-%m-%d"), n))
    if missing:
        for i, w in missing:
            print("%s: %s" % (i, w))
        for uid in sorted(seen, key=lambda u: uses[u][0]):  # every call asked, answered or not: a typed
            tur = (results.get(uid) or (0, {}))[1]          # response often comes with no answers at all
            if isinstance(tur, dict) and isinstance(tur.get("response"), str) and tur["response"].strip():
                print("%s typed instead of choosing: %s" % (WHO, tur["response"].strip()))
        print("nothing written: the memo path — `keel line %s`" % memo)
        return 3
    feedback = []
    fb_labels = {l for l, _ in FEEDBACK_OPTIONS} | {l + RECOMMENDED_TAG for l, _ in FEEDBACK_OPTIONS}
    asked_fb = False
    for uid, (_, ts_res, tur) in sorted(used.items(), key=lambda x: x[1][0]):
        qs = [x.get("question") for x in uses[uid][1].get("questions") or [] if isinstance(x, dict)]
        answers = tur.get("answers") if isinstance(tur.get("answers"), dict) else {}
        anns = tur.get("annotations") if isinstance(tur.get("annotations"), dict) else {}
        if FEEDBACK_QUESTION in qs:
            fa = answers.get(FEEDBACK_QUESTION)
            asked_fb = asked_fb or isinstance(fa, str)
            if isinstance(fa, str) and fa.strip() and fa.strip() not in fb_labels:
                feedback.append(fa.strip())
            n = note_of(anns.get(FEEDBACK_QUESTION))
            if n:
                feedback.append(n)
        resp = tur.get("response")
        if isinstance(resp, str) and resp.strip():
            if FEEDBACK_QUESTION in qs:
                feedback.append(resp.strip())
            else:
                first = next(it["id"] for it in open_items
                             if any(isinstance(x, str) and x.startswith(it["id"] + " —") for x in qs))
                notes.setdefault(first, []).append((utc(ts_res, "%Y-%m-%d"), resp.strip()))
    for i, ns in notes.items():
        take[i] += "".join("\n\n**%s, %s:** %s" % ((OWNER,) + n) for n in ns)
    t_asked = min(v[0] for v in used.values())
    t_answered = max(v[1] for v in used.values())
    new, _ = merge(text, {"items": take, "feedback": "\n\n".join(feedback)}, today=utc(t_answered, "%Y-%m-%d"))
    same_day = utc(t_asked, "%Y-%m-%d") == utc(t_answered, "%Y-%m-%d")
    gate = "Gate: light — %s in chat (%s); asked %s, answered %s (%s); why: %s; review: %s" % (
        OWNER, light_surface(), utc(t_asked, "%Y-%m-%dT%H:%M:%SZ"),
        utc(t_answered, "%H:%M:%SZ" if same_day else "%Y-%m-%dT%H:%M:%SZ"), took_for(t_answered - t_asked),
        " ".join((why or "").split()) or "not given", review or "none recorded")
    new = set_gate(new, gate)
    p.write_text(new)
    lines2, after, _ = parse(new)
    left = [it["id"] for it in after if it["id"] in take
            and not (answered(it, lines2) and CHAT_ANSWER_RE.match(it["answer"] or ""))]
    if left or not gate_of(lines2):  # read back, never assumed
        p.write_text(text)
        raise Stop("the answers did not take for %s — the doc is as it was" % (", ".join(left) or "the Gate line"))
    for k in sorted(take, key=lambda x: int(x[1:])):
        print("took %s: %s" % (k, take[k].split("\n")[0]))
    if feedback:
        print("open feedback: %d note%s" % (len(feedback), "" if len(feedback) == 1 else "s"))
    elif not asked_fb:
        print("open feedback: none on record — ask once, in plain chat: \"Anything to add?\"")
    print(gate)
    return 0


def stand_void(memo):
    p, _, _, rel, _ = locate(memo)
    if not record_touch(p, "void"):
        raise Stop("could not write %s" % (state_dir() / "touches.jsonl"))
    print("%s: touched (%s) — it no longer stands until a new `memo stand` line" % (rel, human(now_ts())))
    return 0


# ----------------------------------------------------------------------------- review status (E14)

# D11's second addition (docs/autofinish-design-2026-10-02.md, section 2c and E14): did the owner look
# at a D-list doc at all. Four names, each read from one signal, the strongest that holds —
#   unseen    no form open logged, no answer, no note, no edit of the doc on GitHub or by hand
#   opened    the form was fetched (opens.jsonl, this Mac) or the doc edited, nothing answered
#   partial   some D-items answered, or a note, with items still open
#   reviewed  every D-item answered by the owner (`(accept all)` when the form's bulk button did it)
# — and beside it, never merged into `reviewed`: `stood` (a `Stood-By:` commit: the deadline
# answered), `waits` (over ten D-items, never stands), `stands <time>` (status's verdict).
# Limits, named rather than hidden: a memo serve form opened on the other Mac is not seen (the log is per Mac; a page open from any device is, once a pull or wait here drains it);
# a doc read on GitHub without an edit stays `unseen` (GitHub reports no views); an old-shape
# answer (`➤ Answer:` pre-filled, no Recommended line) in a doc that predates the architects'
# empty-box rule reads as the owner's — nothing in the text tells the owner's from the agent's there.
# Notes count across the whole doc, earlier rounds included: a record reopened on a new branch
# with an old note reads `partial` before anyone looks. opens.jsonl is never rotated: a row is
# about 200 bytes, read in full per doc — worth a cut only past some thousands of opens.
REVIEWS = ("unseen", "opened", "partial", "reviewed")
NOTE_RE = re.compile(r"^\s*(?:[-*]\s+)?\*\*%s, \d{4}-\d{2}-\d{2}:\*\*" % OWNER_RE)  # merge's note, the form's or GitHub's
# `> the owner (2026-10-07): …` or `> **the owner, 2026-10-07:**` — dated, as the owner's own replies are; a quote
# that merely starts with the name (`> the owner flagged in chat …`, a wrapped line) is the agent's
OWNER_REPLY_RE = re.compile(r"^\s*>\s*\**%s(?:\s*\(|,\s*)\d{4}-\d{2}-\d{2}" % OWNER_RE)
STOOD_REPLY_RE = re.compile(r"^\s*>\s*\*\*Applied\.\*\*\s+Stood\b")  # stand --apply's reply: not the owner's
# an agent's reply that settles something the owner said (hooks/branches.py's DONE_REPLY_RE); any other
# reply — `> **Taken as recommended (A)** — unanswered` — is the agent's alone and answers nothing
SETTLE_REPLY_RE = re.compile(r"^\s*>\s*\*\*(?:Done|Applied|Superseded|Revised|Checked)\.\*\*")
ACCEPT_ALL_RE = re.compile(r"^=\s*recommended\s*\(accept all\)$", re.I)  # the page's ACCEPT_ALL
# R34: `opened` is not `read` — the legend says what each signal is, where the status is shown
REVIEW_LEGEND = ("review: unseen — no sign of " + WHO + " · opened — the form was loaded (the page anywhere, memo serve on this Mac), or the "
                 "doc edited · partial — some items answered, or a note · reviewed — every item answered; "
                 "stood — the deadline answered. A GitHub view is never seen.")


def doc_row(path):
    """{doc, repo, branch, path} of a file, the doc keyed like touches.jsonl (primary checkout,
    branch, path in repo)."""
    key = doc_key(path)
    return {"doc": key and key[2], "repo": key and key[0], "branch": key and key[1], "path": str(Path(path).resolve())}


def log_row(name, path, ts, who, row):
    try:
        out = dict(row or doc_row(path), ts=ts if ts is not None else now_ts(), who=who or "")
        d = state_dir()
        d.mkdir(parents=True, exist_ok=True)
        with open(d / name, "a") as f:
            f.write(json.dumps(out, ensure_ascii=False) + "\n")
        return True
    except Exception:
        return False


def record_open(path, ts=None, who=None, row=None):
    """One row per load of the doc's page (a drained `memo-open`) — {doc, repo, branch, path, ts,
    who}: doc_row's place (or `row`, a pathless drain's), `ts` the event's own time, not the
    drain's, `who` the viewer's name (a collaborator's open is told from the owner's). Never raises: a
    drain must not fail because the log could not be written. An open is not a touch: it never
    voids a stand."""
    return log_row("opens.jsonl", path, ts, who, row)


def record_read(path, ts=None, who=None, row=None):
    """One row per minute of reading (a drained `memo-read`), in reads.jsonl beside opens.jsonl,
    the same shape. Read by regatta's crew-report (S7), nothing here: `status`'s `opened` stays a
    load. Never rotated, like opens.jsonl: about 50,000 rows a year at two hours a day."""
    return log_row("reads.jsonl", path, ts, who, row)


def logged_opens(key, path=None):
    """How many opens the log holds for the doc: same repo and branch, and the same path in the
    repo or the same file name (a record `docs-index move` sent to docs/record/ keeps its opens)."""
    n = 0
    try:
        for l in (state_dir() / "opens.jsonl").read_text().splitlines():
            r = json.loads(l) if l.strip() else {}
            if path and r.get("path") == str(path):
                n += 1
            elif key and r.get("repo") == key[0] and r.get("branch") == key[1] and r.get("doc") \
                    and (r["doc"] == key[2] or Path(r["doc"]).name == Path(key[2]).name):
                n += 1
    except (OSError, ValueError, AttributeError, TypeError):
        pass
    return n


def replies_under(it, lines):
    """The `>` reply lines under an item, up to the next item or heading (replied()'s span)."""
    out, k = [], it["end"]
    while k < len(lines) and not item_match(lines[k]) and not STOP_RE.match(lines[k].strip()):
        if REPLY_RE.match(lines[k]):
            out.append(lines[k])
        k += 1
    return out


def owner_answered(it, lines, by, path=None):
    """the owner spoke on this item: an answer that is not the architect's pick copied into the owner's box,
    or a settling reply under it that `stand --apply` did not write (a `> **Done.**` answers
    something the owner said, in the doc or in chat). answered() counts the stood replies; this never does,
    nor a `Taken unattended (the owner's yolo, …)` pick (E12): the owner never saw it."""
    if (it["answer"] or "").strip() and not taken_answer(it["answer"]):
        if it["shape"] == "new":
            if not (path and is_new_prefill(it, lines, by, path)):
                return True
        elif not is_prefill(it, lines, by):
            return True
    return any((SETTLE_REPLY_RE.match(l) or OWNER_REPLY_RE.match(l)) and not STOOD_REPLY_RE.match(l)
               for l in replies_under(it, lines))


def review_status(top, ref, rel, text, branch=None, path=None, primary=None):
    """The review status of one doc as a dict, or None when it has no D-items. `ref` is the
    commit, or list of commits, whose history counts (HEAD and origin/<branch>: a GitHub edit
    not pulled yet is still the owner's; on a branch, only commits main lacks), `text`
    the doc as read (the working file when there is one: an answer typed and not yet committed
    is still the owner's), `path` that file. Errs towards `unseen`: only a signal that is the owner's
    raises it, and an agent's commit, a checkpoint or a stood reply never does."""
    lines, items, _ = parse(text)
    if not items:
        return None
    by = written_by(lines)
    mine = [it for it in items if owner_answered(it, lines, by, path)]
    fence = fenced(lines)
    notes = sum(1 for k, l in enumerate(lines) if not fence[k] and (NOTE_RE.match(l) or OWNER_REPLY_RE.match(l)))
    refs = [ref] if isinstance(ref, str) else list(ref)
    rng = list(refs)
    base = main_ref(top)
    if base and branch and branch != "main":
        rng.append("^" + base)
    edits = 0
    raw = git(top, "log", "--format=%H%x1f%cn%x1f%B%x1e", *rng, "--", rel, check=False).stdout
    for rec in raw.split("\x1e"):
        parts = rec.strip("\n").split("\x1f")
        if len(parts) < 3:
            continue
        # a web edit whoever the author (75af6eb: author iMachine), or a commit nobody's trailer claims
        if parts[1] == "GitHub" or not AGENT_TRAILER_RE.search(parts[2]):
            edits += 1
    # this branch's round only, like the edits: a round that stood and launched says nothing of new items
    stood = bool(git(top, "log", "-1", "--format=%h", "--fixed-strings", "--grep=" + STOOD_TRAILER,
                     *rng, "--", rel, check=False).stdout.strip())
    key = (str(primary), branch, rel) if primary and branch else None
    opens = logged_opens(key, path and Path(path).resolve())
    n = len(items)
    if len(mine) == n:
        word = "reviewed"
    elif mine or notes:
        word = "partial"
    elif opens or edits:
        word = "opened"
    else:
        word = "unseen"
    return {"word": word, "items": n, "answered": len(mine),
            "taken": sum(1 for it in items if taken_answer(it["answer"])),
            "accept_all": any(ACCEPT_ALL_RE.match((it["answer"] or "").strip()) for it in mine),
            "notes": notes, "opens": opens, "edits": edits, "stood": stood, "waits": n > STAND_MAX_ITEMS}


def review_of_file(memo):
    """review_status() for a file in a checkout: its branch's history, the working text."""
    p = Path(memo).expanduser().resolve()
    if not p.is_file():
        raise Stop("%s: no such file" % memo)
    top = Path(git(p.parent, "rev-parse", "--show-toplevel").stdout.strip())
    primary = Path(git(top, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()).parent
    b = git(top, "symbolic-ref", "-q", "--short", "HEAD", check=False)
    branch = b.stdout.strip() if b.returncode == 0 else None
    rel = p.relative_to(top.resolve()).as_posix()
    refs = ["HEAD"] + [r for r in [branch and origin_ref(top, branch)] if r]
    return review_status(top, refs, rel, p.read_text(), branch=branch, path=p, primary=primary), top, rel


def review_word(rv, stood=None):
    """The one word a record keeps (its banner, the docs map): `unseen`, `reviewed (accept all)`,
    `unseen → stood` — the fact the owner asked to see, a record whose recommendations stood unread."""
    w = rv["word"] + (" (accept all)" if rv["word"] == "reviewed" and rv["accept_all"] else "")
    w += ", %d taken unattended" % rv["taken"] if rv.get("taken") else ""
    return w + (" → stood" if (rv["stood"] if stood is None else stood) else "")


def review_phrase(rv, verdict=None, deadline=None):
    """`unseen 0/5, stands Mon 09:12` — the live form: counts, and what is beside the status."""
    s = "%s %d/%d" % (rv["word"], rv["answered"], rv["items"])
    if rv["word"] == "reviewed" and rv["accept_all"]:
        s += " (accept all)"
    if rv.get("taken"):  # memo yolo's picks: answered, never by the owner
        s += ", %d taken unattended" % rv["taken"]
    if rv["stood"] and verdict == "part-stood":
        s += ", part-stood"  # the sweep stood what it may; the owner still owes the rest (review 2026-10-16)
    elif rv["stood"]:
        s += ", stood"
    elif rv["waits"] and rv["word"] != "reviewed":  # it never stands: worth saying only while items are open
        s += ", waits"
    elif verdict == "stands-at" and deadline:
        s += ", stands " + dt.datetime.fromtimestamp(iso_ts(deadline)).astimezone().strftime("%a %H:%M")
    elif verdict == "due":
        s += ", due"
    return s


def docs_index():
    """docs-index as a module: the banner line is its, and so is the rule for writing it. It is
    atlas's (regatta-modules G10), found through the core's tool(); None when atlas is not here."""
    p = _common().tool("docs-index")
    if not p:
        return None
    from importlib.machinery import SourceFileLoader
    return SourceFileLoader("docs_index", str(p)).load_module()


def stamp(memo, stood=None):
    """Write the review word into the record's banner (`> **Record.** … · review: unseen → stood`),
    the line bin/docs-index owns, inserting the banner when the record has none. At launch:
    /finish step 5, and `stand --apply` (whose commit is the stood one, so `stood` is passed).
    Not committed here. A doc that is not a record (`docs/<topic>-<date>.md`) keeps no banner."""
    rv, top, rel = review_of_file(memo)
    if rv is None:
        print("%s: no D-items — nothing to stamp" % rel)
        return 0
    di = docs_index()
    if di is None:  # G10: the banner is atlas's; without it there is none to write
        print("%s: docs-index (atlas) is not installed — no banner stamped; review %s" % (rel, review_phrase(rv)))
        return 0
    if not di.is_record_path(rel):
        print("%s: not a record (docs/<topic>-<date>.md) — no banner to stamp; review %s" % (rel, review_phrase(rv)))
        return 0
    word = review_word(rv, stood)
    # stand --apply (stood passed) stamps inside its own Stood-By commit: the stood fact is read
    # from this branch's range only, so a later launch could not stamp it — never skipped there
    held = [] if stood else [b for b in di.skip_set(top).get(rel, []) if b != "main"]
    if held:  # R2, as `docs-index banner` refuses: a line at the top would conflict with that branch's edit
        print("skipped %s: %s edits it too — the next launch stamps it; review: %s" % (rel, ", ".join(held[:3]), word))
        return 0
    print(("stamped" if di.stamp_review(top, rel, word) else "unchanged") + " %s: review: %s" % (rel, word))
    return 0


# ----------------------------------------------------------------------------- cli

# The reasons an open item stays the owner's whatever the sweep does, in the order /embark lists them (review
# D4-A): the four an item carries, then the four a doc does. Anything else is named too — nothing is dropped.
EMBARK_REASONS = ("Reversible: no", "unmarked", "conditional", "reopened", "no pick",
                  "physical repo", "on main", "over ten items", "no link", "voided", "no contract", "unparseable")
EMBARK_HOURS = 72
EMBARK_VERDICT_WHY = {"physical": "physical repo", "too-big": "over ten items", "voided": "voided", "no-contract": "no contract",
                      "ask-mode": "mode ask"}


def doc_born(top, rel, p):
    """When the doc first appeared in git (the oldest commit that added it), else its file's mtime."""
    r = git(top, "log", "--diff-filter=A", "--format=%ct", "--", rel, check=False)
    ts = [int(x) for x in r.stdout.split() if x.isdigit()]
    if ts:
        return float(min(ts))
    try:
        return p.stat().st_mtime
    except OSError:
        return now_ts()


def embark_doc(path):
    """[(reason, item)] for the open items of one doc the stand sweep cannot take (review D4-A,
    `standable` and `stand_status`): an item that is `Reversible: no`, unmarked, conditional, pick-less or
    reopened is the owner's whatever the doc; one that would stand waits on the doc — a physical repo, `main`,
    over ten items, no link, a touch that voided it. A doc the sweep will reach (`due`, `stands-at`,
    `part-stood`) lists only its first four kinds. No fetch: origin as last fetched. Read-only."""
    text = Path(path).read_text()
    lines, items, _ = parse(text)
    open_items = [it for it in items if not answered(it, lines)]
    take, left = standable(open_items, lines)
    out = [(why, next(it for it in open_items if it["id"] == i)) for i, why in left]
    if not take:
        return out
    try:
        verdict = stand_status(str(path), fetch_first=False)["verdict"]
        doc_why = EMBARK_VERDICT_WHY.get(verdict)
    except Stop as e:
        m = re.search(r" is on (\S+), not a claude/\* branch", str(e))
        doc_why = "on main" if m else "no link"
    return out + [(doc_why, it) for it in take if doc_why]


def embark_list(root, hours=EMBARK_HOURS):
    """The /embark list (review D4-A): one row per open item the sweep cannot take, in a doc handed over
    more than `hours` ago, grouped by EMBARK_REASONS, oldest first within each. No model, no write."""
    rows, seen = [], set()
    for r in open_memos(root):
        if r["kind"] != "decisions" or r["path"] in seen:
            continue
        seen.add(r["path"])
        p = Path(r["path"])
        try:
            top = Path(git(p.parent, "rev-parse", "--show-toplevel").stdout.strip())
            rel = p.resolve().relative_to(top.resolve()).as_posix()
        except (Stop, ValueError):
            top, rel = p.parent, p.name
        age = (now_ts() - doc_born(top, rel, p)) / 3600
        if age < hours:
            continue
        base = {"repo": r["repo"], "doc": str(p), "title": r["title"], "age_h": round(age, 1)}
        try:
            found = embark_doc(p)
        except Stop as e:
            rows.append(dict(base, reason="unparseable", id="—", item=str(e), line=1))
            continue
        for why, it in found:
            rows.append(dict(base, reason=why, id=it["id"], item=it["title"], line=it["start"] + 1))
    rows.sort(key=lambda x: (EMBARK_REASONS.index(x["reason"]) if x["reason"] in EMBARK_REASONS else len(EMBARK_REASONS),
                             -x["age_h"], x["doc"], id_key(x["id"]) if re.match(r"^[A-Z]\d+$", x["id"]) else ("~", 0)))
    return rows


def embark_print(rows, hours=EMBARK_HOURS):
    docs = {r["doc"] for r in rows}
    print("Open items the stand sweep cannot take, in docs handed over more than %d h ago: %d item%s in %d doc%s — oldest first in each group" % (
        hours, len(rows), "" if len(rows) == 1 else "s", len(docs), "" if len(docs) == 1 else "s"))
    cur = None
    for r in rows:
        if r["reason"] != cur:
            cur = r["reason"]
            print("\n%s — %d" % (cur, sum(1 for x in rows if x["reason"] == cur)))
        a = r["age_h"]
        print("  %s · %s · %s %s — %s#L%d" % ("%dd" % (a // 24) if a >= 48 else "%dh" % a, short_repo(r["repo"]), r["id"],
                                             r["item"], r["doc"], r["line"]))
    if rows:
        print("\nEach doc's own form: `keel line <doc>` (the form, GitHub and the page). Nothing here was answered or written.")


# ----------------------------------------------------------------------------- lookout (crosstalk S3)

# docs/crosstalk-2026-10-20.md, "Lookout": one pass every LOOKOUT_EVERY on each Mac, from helm's ask
# poll (its S6). Events: a Save drained from a page whose doc has open items and still lacks it (the
# laptop's pins only — only the laptop holds a Save), an item the last pass did not see answered and
# answered on origin since — by a commit no automation made, nor one taking in a Save (S12) — and
# new comments on a page with open items. Each
# finds the doc's session and hails it with a pointer, never the answer's words (K13); a working
# session waits a pass; with none live, answers on the branch and an open step waiting on them, the
# pass puts a brief on the branch and dispatches one run (S5, lookout_gone), else raises a card.
# No model call. Ships disarmed: arming per Mac is the owner's act (`--arm`), as the stand sweep's.
LOOKOUT_EVERY = 15 * 60
LOOKOUT_LOG = "lookout.jsonl"       # one row per act, keyed (doc, event id): the memory that hails once
LOOKOUT_STATE = "lookout-state.json"  # the last pass's open items and tips and the pages' comment counts
LOOKOUT_ARMED = "lookout-armed"
LOOKOUT_AT = "lookout-at"
LOOKOUT_DAYS = 14   # a doc acted on stays watched for its page's redeploy this long (the drain's horizon)
LIVE_STATES = ("submitted", "working", "input-required", "idle", "auth-required")   # harness's, bar the ended
SETTLED = ("hailed", "left alone", "would dispatch", "card", "skipped", "own",     # an event done with
           "dispatching", "dispatched")   # once per answer: a run that failed to start is never retried
# A gate that clears by itself — a tight week, no login free, a missing tool, the peer not answering,
# a pickup refusal that passes — raises a `gated` card, which is not settled: the event is tried
# again each pass and gets its run once the gate clears (S11 item 2). A permanent gate stays a `card`.
GATED = "gated"
LOOKOUT_STARTS = "lookout-starts"   # a detached start's request, then its .out.json (S11 item 3)
START_LIMIT = 15 * 60   # pickup brief's 180 s, dispatch's 300 s and the release's 180 s, with room: older and unanswered, it died
LOOKOUT_CARD_DAYS = 7   # a card older drops from --status and helm's board (S11 item 18)
LOOKOUT_KEEP_DAYS = 30  # lookout.jsonl keeps this long: past LOOKOUT_DAYS, which redeploy reads
# a pickup brief refusal that clears by itself: a fetch, a git operation, a session's lock or its uncommitted work
PICKUP_PASSING_RE = re.compile(r"run it again|try again|could not fetch|let it finish first|must end, or idle|commits them first", re.I)
TAKEN_BY = "Taken-By: keel sheep pull --plumb"
SAVED_BY, SAVED_BY_NONE = "Saved-By:", "(no name)"   # a plumbed commit's trailer per Save's viewer
SAVED_ITEMS = "Saved-Items:"   # and the D-ids its take-in answered (lookout-echo)
SESSION_TRAILER_RE = re.compile(r"^Claude-Session:\s*(\S+)\s*$", re.M)
SESSION_URL_RE = re.compile(r"\bsession_[A-Za-z0-9]{8,}\b")
HAIL_TEXT = {"save": "a Save from the doc's page is on its branch: keel pull, then act on the answers",
             "save-held": "a Save waits on the doc's page: keel sheep pull --write, then act on the answers",
             "answer": "an answer landed on GitHub: keel pull, then act on it",
             "comment": "new comments on the doc's page: keel sheep pull, read them, reply"}


def lookout_tool(name):
    """A peer the lookout runs: LOOKOUT_<NAME> when set (the tests' stub; empty = none), else the
    core's tool() — hail is wharf-runs' (crosstalk S2), harness wharf-runs' too."""
    v = os.environ.get("LOOKOUT_" + name.upper())
    if v is not None:
        return v or None
    try:
        t = _common().tool(name)
    except ImportError:
        return None
    return str(t) if t else None


def lookout_host():
    """(this host's name, the laptop's name): LOOKOUT_HOST stands in for the first (the tests)."""
    try:
        c = _common()
        return os.environ.get("LOOKOUT_HOST") or c.host_name(), c.LAPTOP
    except ImportError:
        return os.environ.get("LOOKOUT_HOST") or "host", None


def ask_cache():
    return Path(os.environ.get("ASK_CACHE_DIR") or Path.home() / "Library/Caches/ask")


def open_asks():
    """{pin key: [D-ids]} of every open item helm's ask poll last found (its asks.json), or None
    when this Mac has no poll cache."""
    try:
        rows = json.loads((ask_cache() / "asks.json").read_text()).get("asks") or []
    except (OSError, ValueError, AttributeError):
        return None
    out = {}
    for a in rows:
        if isinstance(a, dict) and a.get("repo") and a.get("branch") and a.get("rel") and a.get("item"):
            out.setdefault("%s@%s:%s" % (a["repo"], a["branch"], a["rel"]), set()).add(a["item"])
    return {k: sorted(v, key=id_key) for k, v in out.items()}


def repo_tops(pinned):
    """{repo name: its primary checkout}: the pins' repo_path, then the core's cloned repos."""
    out = {}
    try:
        for r in _common().cloned_repos():
            out.setdefault(Path(r).name, Path(r))
    except Exception:  # no core, no repos.json: the pins alone
        pass
    for key, pin in pinned.items():
        if pin.get("repo_path"):
            out[key.partition("@")[0]] = Path(pin["repo_path"])
    return out


def origin_view(top, branch, fetch_first=True):
    """(git dir, ref) holding GitHub's tip of `branch`: helm's poll mirror when it has the branch
    (fetched every 5 min, never a checkout sessions share), else this checkout's origin ref,
    fetched first; None when neither has it."""
    import hashlib
    mirror = ask_cache() / "mirrors" / ("%s-%s.git" % (top.name, hashlib.sha1(str(top).encode()).hexdigest()[:8]))
    if mirror.is_dir() and git(mirror, "rev-parse", "-q", "--verify", "refs/heads/" + branch, check=False).returncode == 0:
        return mirror, "refs/heads/" + branch
    try:
        if fetch_first and fetch(top, branch) is not None:
            return None
    except Stop:
        return None
    ref = "refs/remotes/origin/" + branch
    return (top, ref) if git(top, "rev-parse", "-q", "--verify", ref, check=False).returncode == 0 else None


def runs_dir():
    """dispatch's run records (bin/dispatch `runs=`); LOOKOUT_RUNS_DIR moves it (the tests)."""
    return Path(os.environ.get("LOOKOUT_RUNS_DIR") or Path.home() / "Library/Logs/claude-weekly/run-seed-runs")


def run_records():
    """Every run record, oldest first (their names start with the start time)."""
    out = []
    for f in sorted(runs_dir().glob("*.json")):
        try:
            r = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(r, dict):
            out.append(r)
    return out


def session_marks(body):
    """The session ids a commit names: its Claude-Session trailers (an 8-character id or a web
    session's URL), newest last."""
    out = []
    for v in SESSION_TRAILER_RE.findall(body):
        m = SESSION_URL_RE.search(v)
        out.append(m.group(0) if m else v)
    return out


def dispatched(sid, runs):
    """Whether session `sid` (a prefix of 6 or more) is a dispatch run's own."""
    return len(sid) >= 6 and any(str(r.get("session") or "").startswith(sid) for r in runs)


def answers_in(gd, ref, rel):
    """{D-id: answer} of the doc at `ref`; {} when the doc is not there (no ref, no such path); None
    when it is there and git or the parse cannot say — a doc that does not parse, a blob a partial
    mirror could not fetch. An unreadable doc is never "no answers" (lookout-echo, finding 4: an
    unseen answer in the commit that fixed a parse error read as written answered, and was skipped)."""
    if not ref:
        return {}
    r = git(gd, "ls-tree", "--name-only", ref, "--", rel, check=False)
    if r.returncode:
        return None
    if not r.stdout.strip():
        return {}
    text = git(gd, "show", "%s:%s" % (ref, rel), check=False).stdout
    try:
        return answers_of(text)[0] if text else None
    except Stop:
        return None


def fork_base(gd, ref):
    """The main line `ref` forked from, in the same git dir: refs/heads/main or master in helm's
    poll mirror, refs/remotes/origin/… in a checkout; None when `ref` is that line itself or none
    exists. A doc first met looks back over its branch's own commits only (lookout-echo, finding 3:
    a window over main's history raised answers settled a round ago as new)."""
    full = git(gd, "rev-parse", "--symbolic-full-name", ref, check=False).stdout.strip() or ref
    pre = "refs/remotes/origin/" if full.startswith("refs/remotes/origin/") else "refs/heads/"
    for b in ("main", "master"):
        if pre + b == full:
            return None
        if git(gd, "rev-parse", "-q", "--verify", pre + b, check=False).returncode == 0:
            return pre + b
    return None


def take_in_times(applied, before, ts):
    """{D-id: ts} for each item a `sheep pull` write changed — the times the pin's mark keeps, which the
    lookout reads only where the doc's last change before the answer is no newer (lookout-echo). An item the write left as it was keeps its
    old time, or none: a Save that re-sent an answer typed on GitHub took nothing in, and stamping it
    would file that answer as the Save's (lookout-echo's finish review)."""
    return {d: ts for d, a in applied.items() if a and a != " ".join((before.get(d) or "").split())}


def saved_items(body):
    """The D-ids a commit's `Saved-Items:` trailers name (the items its Saves carried), or None when
    it has none — a commit from before lookout-echo, or no take-in."""
    found = re.findall(r"^%s[ \t]*(.*)$" % re.escape(SAVED_ITEMS), body, re.M)   # [ \t]: an empty trailer never takes the next line
    return None if not found else {d for v in found for d in re.split(r"[,\s]+", v) if d}


def not_owners_answer(body, now, got, runs, own_save=True):
    """Why a commit's answers are not a person's and wake nobody, or None: stand
    --apply's trailer, keel yolo's `Taken unattended`, a dispatched run's session, the lookout's own
    plumbed Save (its Save event has acted already) — unless `own_save` is False: the commit's
    Saved-Items name what the Save carried, and the rest of it is judged."""
    if STOOD_TRAILER in body:
        return "stand --apply's"
    if any(YOLO_ANSWER_RE.match(now.get(d) or "") for d in got):
        return "keel yolo's"
    if own_save and TAKEN_BY in body:
        return "the lookout's own Save"
    if any(dispatched(s, runs) for s in session_marks(body)):
        return "a dispatched run's"
    return None


def answer_events(gd, ref, rel, items, since, runs, unseen=(), after=0, applied=None, applied_at=None):
    """[{sha, part, items, skip, sessions}]: each commit on `ref` past `since` (the last pass's tip;
    when it is unknown or rewritten, the branch's own commits since it forked from main, or the last
    30 doc commits where no main line is there) that answered one of `items` — open at the last pass,
    empty before it and not after. Oldest first.
    `unseen` (S12, the joint test's miss): items the last pass never saw, open nor answered, that
    are answered now — opened and answered between two passes, or before the first. Each is judged
    the same way against the doc at its answer's parent, by a commit newer than `after` only (the arm
    time: an answer older is no event); one absent from that parent came answered with the item
    (part `new`, skipped, and still judged should a later commit reopen and answer it). One whose answer the window cannot reach — 30 commits, all newer than
    `after` — is part `unjudged`, a card: never dropped unseen. A commit whose parent's doc git
    cannot read or parse is judged against the doc as it last read in the window; an unseen item that
    state cannot account for is part `unjudged` too (lookout-echo, finding 4, narrowed in round two).
    `applied`: the pin's `sheep pull` mark (the answers its last write took in), `applied_at` when it
    took each in. An item answered as that mark says, where the doc's last change before the commit
    is no newer than the take-in, is a Save taken in — the mark grows forever, and an answer re-typed with the same words
    after it is a person's (lookout-echo, finding 2); a mark with no time never counts. A commit with
    `Saved-Items:` trailers (plumb_commit's) names the items its Saves carried: those are the Save's,
    the rest are judged (finding 5). The Save's own event hailed already, so its items are part
    `save`, skipped (S12, the joint test's echo)."""
    if since and git(gd, "merge-base", "--is-ancestor", since, ref, check=False).returncode == 0:
        rng, capped, start = ["%s..%s" % (since, ref)], False, since
    else:
        base = fork_base(gd, ref)
        rng, capped = (["%s..%s" % (base, ref)], False) if base else (["-n", "30", ref], True)
        start = git(gd, "merge-base", base, ref, check=False).stdout.strip() if base else ""
    raw = git(gd, "log", "--reverse", "--format=%H%x1f%P%x1f%ct%x1f%B%x1e", *rng, "--", rel, check=False).stdout
    recs = []
    for rec in raw.split("\x1e"):
        parts = rec.strip("\n").split("\x1f")
        if len(parts) >= 4:
            recs.append((parts[0], parts[1].split(), int(parts[2] or 0), parts[3]))
    unseen = set(unseen)
    pending, out = set(items) | unseen, []
    came = set()   # unseen items that came answered (part new): still judged, should a later commit reopen and answer them
    # the doc as it last read in the window — at its start until a commit in it reads; None when the
    # start does not read or is unknown (the capped window). A commit whose parent's doc does not read
    # is judged against it (lookout-echo's finish review: an open item's answer there was a card, not a hail)
    last = [answers_in(gd, start, rel) if start else None]
    norm = lambda s: " ".join((s or "").split())

    def taken_in(d, parents):   # the pin's mark says this answer is the one its take-in wrote, then
        if not (applied and applied_at and d in applied and norm(now.get(d)) == norm(applied[d])):
            return False
        # the doc's last change before this commit, not the parent itself: a code commit between the
        # take-in and the doc's checkpoint is no re-ask; a time git cannot read never counts (fail closed)
        at = git(gd, "log", "-1", "--format=%ct", parents[0], "--", rel, check=False).stdout.strip() if parents else ""
        try:
            return bool(at) and float(applied_at.get(d) or 0) >= int(at)
        except (TypeError, ValueError):
            return False
    for sha, parents, ct, body in recs:
        if not pending:
            break
        if pending <= unseen and ct <= after:   # only unseen items left, and this commit predates the arm
            last[0] = None   # its doc went unread: a later unreadable parent is judged against nothing, a card
            continue
        now = answers_in(gd, sha, rel)
        if now is None:   # unreadable here: the next commit that reads is judged against it, as a card
            continue
        before = answers_in(gd, parents[0], rel) if parents else {}
        marks = session_marks(body)
        shaky, prior = before is None, last[0]
        last[0] = now
        if shaky:   # items open at the last pass were empty at `since`; an unseen one is known only if `prior` holds it
            before = prior or {}
        got = [d for d in pending if (now.get(d) or "").strip() and not (before.get(d) or "").strip()]
        if not got:
            continue
        pending -= {d for d in got if not (d in unseen and ct <= after)}   # pre-arm: still pending, as the skip leaves it
        came -= set(got)
        got = [d for d in got if not (d in unseen and ct <= after)]
        if shaky:
            odd = sorted((d for d in got if d in unseen and d not in before), key=id_key)
            if odd:
                out.append({"sha": sha, "part": "unjudged", "items": odd, "skip": None, "sessions": marks,
                            "card": "answered in a commit whose parent's doc does not read — look at it"})
            got = [d for d in got if d not in odd]
        new = sorted((d for d in got if d in unseen and d not in before), key=id_key)
        got = sorted((d for d in got if d not in new), key=id_key)
        pending |= set(new)
        came |= set(new)
        if new:
            out.append({"sha": sha, "part": "new", "items": new, "skip": "came answered in the commit that wrote it",
                        "sessions": marks})
        if not got:
            continue
        carried = saved_items(body)
        if carried is not None:
            took = [d for d in got if d in carried]
            skip = not_owners_answer(body, now, [d for d in got if d not in carried], runs, own_save=False)
        else:
            skip = not_owners_answer(body, now, got, runs)
            took = [] if skip else [d for d in got if taken_in(d, parents)]
        rest = [d for d in got if d not in took]
        if rest:
            out.append({"sha": sha, "part": "", "items": rest, "skip": skip, "sessions": marks})
        if took:
            out.append({"sha": sha, "part": "save", "items": took, "sessions": marks, "skip": "the lookout's own Save"
                        if TAKEN_BY in body else "a Save taken in: its own event acted"})
    left = sorted(pending & unseen - came, key=id_key)
    if left and capped and len(recs) >= 30 and recs[0][2] > after:
        card = "answered before the lookout saw it open, past the doc's last 30 commits — look at it"
        same = [e for e in out if e["sha"] == recs[-1][0] and e["part"] == "unjudged"]
        if same:   # one event id per commit and part: the pass keeps one card per id, so join the tip's card
            same[0]["items"] = sorted(set(same[0]["items"]) | set(left), key=id_key)
            same[0]["card"] += "; " + card
        else:
            out.append({"sha": recs[-1][0], "part": "unjudged", "items": left, "skip": None, "sessions": [],
                        "card": card})
    return out


def save_lacks(sv, text):
    """Whether Save `sv` holds something the doc's text lacks: an answer that differs, a note or
    feedback not in it."""
    d = sv.get("data") if isinstance(sv.get("data"), dict) else {}
    try:
        now = answers_of(text)[0]
    except Stop:
        now = {}
    for k, v in (d.get("items") or {}).items() if isinstance(d.get("items"), dict) else ():
        if isinstance(v, str) and v.strip() and " ".join(v.split()) != " ".join((now.get(k) or "").split()):
            return True
    for c in d.get("comments") or []:
        if isinstance(c, dict) and str(c.get("text") or "").strip() and not in_doc(str(c["text"]).strip(), text):
            return True
    fb = d.get("feedback") if isinstance(d.get("feedback"), str) else ""
    return bool(fb.strip()) and not in_doc(fb.strip(), text, feedback=True)


def save_items(sv, text):
    """The D-items Save `sv` answers that the doc's text lacks — a Save re-sends every item the page
    holds, blank ones too, so its keys alone are not what it answered."""
    d = sv.get("data") if isinstance(sv.get("data"), dict) else {}
    try:
        now = answers_of(text)[0]
    except Stop:
        now = {}
    its = d.get("items") if isinstance(d.get("items"), dict) else {}
    return [k for k, v in its.items() if isinstance(v, str) and v.strip()
            and " ".join(v.split()) != " ".join((now.get(k) or "").split())]


def save_viewer(sv):
    """A drained Save's viewer: drain_saves keeps `from.name` as a string; a room event has the dict."""
    f = sv.get("from")
    return str((f.get("name") if isinstance(f, dict) else f) or "")


def viewer_name(n):
    """A viewer's name as the lookout writes it — into a trailer, lookout.jsonl and a run's brief, an
    unattended prompt: the room's display name is never verified, so one line, no backticks, 40
    characters, and never in a session id's shape (session_refs reads commit bodies for those)."""
    n = " ".join(str(n or "").replace("`", "'").split())[:40]
    # nor a trailer's shape: `Stood-By: autofinish` inside a Saved-By line would read as a stand to
    # the unanchored `git log --grep` readers (S5 landing review)
    n = re.sub(r"(?i)(\w-by)\s*:", r"\1;", n)
    return SESSION_URL_RE.sub(lambda m: m.group(0).replace("_", "-", 1), n) or SAVED_BY_NONE


def lock_held(f):
    """Whether a process holds an flock on `f` — read, never taken: a LOCK_EX|LOCK_NB take would
    end a `sheep wait` starting that instant (it finds the lock taken and exits). On macOS F_GETLK
    reports a flock(2) lock (probed 2026-10-21: l_type F_WRLCK, l_pid -1); elsewhere the two kinds
    are apart, and lsof names a process with the file open. Unknown reads as held: the doc is then
    left alone, the safe way."""
    if sys.platform == "darwin":
        import fcntl
        import struct
        try:
            fd = os.open(str(f), os.O_RDONLY)
        except OSError:
            return False
        try:
            res = fcntl.fcntl(fd, fcntl.F_GETLK, struct.pack("qqihh", 0, 0, 0, fcntl.F_WRLCK, 0))
            return struct.unpack("qqihh", res)[3] != fcntl.F_UNLCK
        except OSError:
            return True
        finally:
            os.close(fd)
    try:
        r = subprocess.run(["lsof", "-t", "--", str(f)], capture_output=True, text=True, timeout=10)
        return bool(r.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        return True


def wait_lock(key):
    """`sheep wait`'s lock file for pin `key` — the one name: sheep_wait takes it, the lookout reads it."""
    import hashlib
    return SHEEP_STATE / ("wait-%s.lock" % hashlib.sha1(key.encode()).hexdigest()[:16])


def session_refs(top, branch, ref, runs):
    """[(source, session ref)] in the resolver's order, deduplicated: the worktree's owner file, the
    newest Claude-Session trailer or `session_…` id on the branch, the newest run record of the
    branch, then that run's skipper."""
    out = []
    wt = next((w for w, b in worktrees(top) if b == branch), None) if top else None
    if wt:
        gd = git(wt, "rev-parse", "--absolute-git-dir", check=False).stdout.strip()
        try:
            lock = _common().read_owner(Path(gd) / "claude") if gd else None
        except ImportError:
            lock = None
        if lock and lock.get("session"):
            out.append(("owner.json", str(lock["session"])))
    if ref:
        gd_, r = ref
        for body in git(gd_, "log", "-n", "40", "--format=%B%x1e", r, check=False).stdout.split("\x1e"):
            got = session_marks(body) or SESSION_URL_RE.findall(body)
            if got:
                out.append(("Claude-Session trailer", got[-1]))
                break
    run = next((x for x in reversed(runs) if x.get("branch") == branch and x.get("session")), None)
    if run:
        out.append(("run record", str(run["session"])))
        if run.get("manager"):
            out.append(("its skipper", str(run["manager"])))
    seen, uniq = set(), []
    for src, sid in out:
        if sid not in seen:
            seen.add(sid)
            uniq.append((src, sid))
    return uniq


SESSION_MEMO = {}   # one pass's harness answers by session ref: many events name one session


def session_state(sid):
    """harness status's record for `sid` across the hosts it reads (from the laptop the peer over
    ssh; never the reverse), or None when nothing answers, two do, or harness is missing."""
    if sid in SESSION_MEMO:
        return SESSION_MEMO[sid]
    SESSION_MEMO[sid] = rec = _session_state(sid)
    return rec


def _session_state(sid):
    h = lookout_tool("harness")
    if not h:
        return None
    try:
        r = subprocess.run([h, "status", sid, "--host", "all", "--json"], capture_output=True, text=True, timeout=120)
        rec = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    return rec if isinstance(rec, dict) else None


def resolve_session(key, top, branch, ref, runs):
    """(how, record or None, source): `left alone` when a `sheep wait` holds the page's lock; else
    the first ref whose session is live by harness status — `idle` or `working` (any other live
    state: it is busy or waits on someone); `none` when no ref names a live one."""
    if wait_lock(key).exists() and lock_held(wait_lock(key)):
        return "left alone", None, "a sheep wait listens on the page"
    for src, sid in session_refs(top, branch, ref, runs):
        rec = session_state(sid)
        if rec and rec.get("state") in LIVE_STATES:
            return ("idle" if rec["state"] == "idle" else "working"), rec, src
    return "none", None, None


# The tools whose module path the account dirs' allow rules name since B14a (the overlay's
# bootstrap.sh --hooks). Since B14b every tool is spelled so: the overlay's shims are gone.
MODULE_RULED = ("ask", "helm")


def overlay_cmd(name):
    """`name` spelled by its module path (tool()), which the account dirs' allow rules name: an
    unattended session is denied the bare name (AGENTS.md, Traps; as paste-paths' _ask_cmd). The
    overlay's shim came first until B14b (2026-10-23), which deleted it; the name stays for callers."""
    try:
        p = _common().tool(name)
        if p:
            return str(p)
    except Exception:   # no core here: the bare name
        pass
    return name


def hail_text(kind):
    """HAIL_TEXT with `keel` spelled by its module path (overlay_cmd), `~/`-relative as the brief
    is (home_rel): the hailed session may be on the peer, whose home differs (S11c item 11)."""
    return HAIL_TEXT[kind].replace("keel ", home_rel(overlay_cmd("keel")) + " ")


def hail_session(rec, about, kind, here):
    """bin/hail with a pointer (HAIL_TEXT, never an answer's words); its JSON record, or one made
    here with verdict `unreachable` when it could not run."""
    h = lookout_tool("hail")
    if not h:
        return {"verdict": "unreachable", "why": "no hail on this Mac (wharf-runs, crosstalk S2)"}
    cmd = [h, str(rec.get("session_id")), "--kind", "event", "--about", about, "--text", hail_text(kind), "--json"]
    if rec.get("machine") and rec["machine"] != here:
        cmd[2:2] = ["--host", str(rec["machine"])]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        txt = r.stdout.strip()
        try:   # hail --json prints its record indented (json.dumps indent=1); a stray line before it: the last
            out = json.loads(txt) if txt else {}
        except ValueError:
            out = json.loads(txt.splitlines()[-1])
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        return {"verdict": "unreachable", "why": "hail: %s" % e}
    if not isinstance(out, dict) or not out.get("verdict"):
        return {"verdict": "unreachable", "why": "hail exit %d: %s" % (r.returncode, (r.stderr.strip().splitlines() or ["no record"])[-1][:160])}
    return out


RUN_KINDS = ("save", "answer")   # answers on the branch; a Save still on the page (save-held) or comments start no run
_AF = []   # bin/autofinish, loaded once a process (week_tight caches per repo inside it)


def lookout_card(ev, why, action="card"):
    """A card for the owner — `lookout --status` lists it until a later row of the event settles it,
    for LOOKOUT_CARD_DAYS at most. A GATED one is tried again each pass and says so."""
    return {"action": action, "card": "no live session for %s %s — %s%s" % (
        ev["doc"], ", ".join(ev["items"]) or ev["kind"], why, " (tried again each pass)" if action == GATED else "")}


def branch_host(branch):
    """The host a `claude/<host>/<date>-<topic>` branch names, or None (an older `claude/<date>-…` name)."""
    m = re.match(r"^claude/([^/]+)/", branch or "")
    return m.group(1) if m and not re.match(r"^%s$" % DATE_RE, m.group(1)) else None


def waiting_steps(text, items, repo=None, sets=None, slug=None, given=()):
    """The open steps a run would build once `items` are answered, and the doc whose Action plan holds
    them: (step ids, "entry" or `slug`). A step is a run's when it is a session's (or a `project`
    step naming this repo — another repo's step is its own session's, and its contract's physical
    gate is not this one), not started, whose `after:` names one of them and is met in full: every
    D-item answered, every S-step done. An `after:` entry of another shape (`shape D4`, another doc's
    item) is never taken as met. An answer with no such step leaves a run nothing to build, so it
    raises a card instead (S5 review, 2026-10-22). Never a `wip` step (another branch builds it) or
    one placed `in <repo>/<path>` (S11c item 10).
    In a nested set (`sets`: {slug: text}, the entry's under `entry`; `slug`: the answered doc's) a
    component keeps its steps in the entry (shape D4-A): its answers are `<slug> D2` in the entry's
    `after:`, met when that component's item is answered (S11 item 4); a component of the older
    layout keeps its own Action plan, read when the entry's waits on nothing (S11c item 29).
    `given`: items taken as answered though the text lacks them — a dry pass's Save, never written
    onto the branch it reads (S11c item 23)."""
    docs = dict(sets or {})
    me = slug if slug and slug != "entry" and docs.get("entry") else "entry"
    docs[me] = text
    done_d = {}
    for k, t in docs.items():
        try:
            lines = t.split("\n")
            done_d[k] = {it["id"] for it in parse(t)[1] if answered(it, lines)}
        except Exception:   # a doc keel cannot read: the answered one or the entry, no step (a card)
            if k in (me, "entry"):
                return [], me
            done_d[k] = set()   # another component: its items stay unmet, the set reads on (S11c item 29)
    done_d[me] |= set(given)

    def ours(st):
        # parse_step keeps the first kind only: `session `worker` | project `shop`` reads as a
        # session whose `who` holds the project, and `| human (…)` a person's part (S5 landing review)
        who = "%s %s" % (st["kind"], st["who"])
        if st["kind"] == "human" or re.search(r"\|\s*human\b", who) \
                or re.match(r"session\s+(?:`[^`]*`|[^\s|(]+)\s+in\s+`?[\w.-]+/", who):   # placed, not a path in prose (finish review)
            return False
        m = re.search(r"\bproject\s+`?([^`\s|]+)", who)
        if m:
            return repo is not None and m.group(1) == repo
        return st["kind"] == "session"
    mine = {(me, d) for d in items}
    for where in ("entry",) + ((me,) if me != "entry" else ()):
        try:
            steps = keel_parse(docs[where].split("\n"))["steps"]
        except Exception:
            continue
        done_s = {st["id"] for st in steps if st["status"] in ("done", "superseded")}

        def ref(t, where=where):   # a bare id is the plan's own doc's
            m = re.fullmatch(r"(?:([\w-]+)\s+)?([DS]\d+)", t.strip())
            return (m.group(1) or where, m.group(2)) if m else (None, None)

        def met(t, where=where, done_s=done_s):
            s, x = ref(t)
            if not x:
                return False
            return (s == where and x in done_s) if x[0] == "S" else s in done_d and x in done_d[s]
        got = [st["id"] for st in steps if ours(st) and st["status"] in (None, "not started")
               and any(ref(t) in mine for t in st["after"]) and all(met(t) for t in st["after"])]
        if got:
            return got, where
    return [], "entry"


def set_at(gd, ref, rel):
    """The nested set `rel` is in, read from the tree at `ref` (no checkout: set_names over `git
    ls-tree`): ({slug: text}, rel's slug, the entry's rel), or (None, None, rel) when it is in none."""
    d = posixpath.dirname(rel)
    names = [posixpath.basename(n) for n in git(gd, "ls-tree", "--name-only", ref, "--", (d + "/") if d else ".",
                                                 check=False).stdout.split("\n") if n.endswith(".md")]
    texts = {}

    def read(n):
        if n not in texts:
            r = git(gd, "show", "%s:%s" % (ref, posixpath.join(d, n)), check=False)
            texts[n] = None if r.returncode else r.stdout
        return texts[n]
    s = set_names(posixpath.basename(rel), names, read)
    if not s:
        return None, None, rel
    me = next((k for k, n in s["slugs"].items() if n == posixpath.basename(rel)), None)
    if me is None:   # linked from the entry, no Status line: not a component (finish review, 2026-10-22)
        return None, None, rel
    return ({k: read(n) or "" for k, n in s["slugs"].items()}, me, posixpath.join(d, s["entry"]))


def held_branch(top, branch):
    """helm ask's held_by_other, read from the lookout: the worktree with `branch` out is held by a
    session (holder: checkpoint's rule; the pass's own caller too, S11c item 12) — (why, passing),
    or (None, False) when free (crosstalk F3: dispatch's own owner check runs on --next only, so
    this one comes first). Passing when a session holds it: the lock frees within OWNER_TTL, as
    pickup's refusal on it is GATED (S11c item 25); an unreadable lock is a card."""
    wt = next((w for w, b in worktrees(top) if b == branch), None)
    h = holder(wt, me=False) if wt else None
    return (held_by(wt, h, at=True), "session" in h or "no regatta core" in h.get("unknown", "")) if h else (None, False)


def peer_live(branch):
    """From the laptop a run goes to the peer by dispatch's Where, and held_branch reads this Mac's
    worktrees only (S11 item 1): `harness list --host all` reads every host's live sessions, the
    peer's over ssh (laptop → peer only; elsewhere `all` is this host). (why, passing): a live
    session on `branch` anywhere (not passing: its session takes the answers), or a host that did
    not answer (passing: tried again next pass); (None, False) when no host holds it."""
    if "list" not in PEER_MEMO:   # one `harness list` a pass, not an ssh round trip per event (S11c item 28)
        PEER_MEMO["list"] = _peer_list()
    r, recs, why = PEER_MEMO["list"]
    if why:
        return why, True
    for x in recs if isinstance(recs, list) else []:
        if isinstance(x, dict) and x.get("branch") == branch and x.get("state") in LIVE_STATES:
            return "session %s is %s on %s" % (str(x.get("session_id") or "?")[:8], x["state"], x.get("machine") or "?"), False
    if r.returncode == 3:   # a host asked did not answer: what it holds is unknown
        return "a host did not answer harness list (%s)" % last_line(r), True
    if r.returncode or not isinstance(recs, list):
        return "harness list exit %d (%s)" % (r.returncode, last_line(r)), True
    return None, False


PEER_MEMO = {}   # one pass's `harness list --host all` answer (peer_live), cleared with SESSION_MEMO


def _peer_list():
    """(the run, its records, None) of `harness list --host all --json`, or (None, None, why) when it
    could not run."""
    h = lookout_tool("harness")
    if not h:
        return None, None, "no harness here to ask the other Macs whether a session holds it"
    try:
        r = subprocess.run([h, "list", "--host", "all", "--json"], capture_output=True, text=True, timeout=120)
        return r, (json.loads(r.stdout) if r.stdout.strip() else []), None
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        return None, None, "the other Macs could not be asked (harness list: %s)" % type(e).__name__


def lookout_week(top):
    """Why the week stops a run, or None: bin/autofinish's week_tight() on the repo, cached readings
    (where autofinish stops, the lookout starts nothing). An odd answer stops it, as in helm's tick."""
    try:
        if not _AF:
            af = lookout_tool("autofinish")
            if not af:
                return "no bin/autofinish here to read the week"
            from importlib.machinery import SourceFileLoader
            _AF.append(SourceFileLoader("autofinish_for_lookout", af).load_module())
        verdict, detail = _AF[0].week_tight(str(top))
    except (Exception, SystemExit) as e:  # noqa: BLE001 — its top level exits when a peer is missing
        verdict, detail = "none", "the pick could not be read (%s)" % type(e).__name__
    if verdict == "tight":
        return "the week is tight (%s)" % (detail or "?")
    if verdict == "none":
        return "no login may run it now (%s)" % (detail or "?")
    return None


def brief_day():
    """Today as `pickup brief` dates its file (datetime.date.today()): the brief's title and the
    same-day guard read the one clock pickup writes by, never now_ts() (S11c item 15)."""
    return dt.date.today().isoformat()


def branch_topic(branch):
    """A `claude/<host>/<date>-<topic>` branch's topic, as pickup brief reads it."""
    return re.sub(r"^%s-" % DATE_RE, "", branch.rsplit("/", 1)[-1])


def run_brief(ev, steps, sha, plan=None):
    """The run's brief — fixed text (crosstalk, "The fresh run and the check-in"): take the answers
    in, check in on the Status line, reply under every changed hunk, build and stamp the steps the
    answers unblock, check out, commit, end on the line bin/ask prints. Never /finish, push, gh or
    bin/pr (F4: dispatch denies them). Its `Steps:` line holds the branch back from landing until
    the steps are done (`keel landing`). The tools by the overlay's path (AGENTS.md, Traps). `plan`:
    the doc holding the steps when it is not the answered one — a set's entry (S11 item 4)."""
    k, ask, rel, items = home_rel(overlay_cmd("keel")), home_rel(overlay_cmd("ask")), ev["rel"], ", ".join(ev["items"])
    plan = plan or rel
    if ev["kind"] == "save":
        what = "a Save from the doc's page, saved by %s, taken in as %s" % (", ".join(ev.get("saved_by") or [SAVED_BY_NONE]), sha[:7])
    else:
        what = "an answer typed on GitHub, %s" % sha[:7]
    return "\n".join([
        "# %s — the lookout's run on %s, %s" % (branch_topic(ev["branch"]), rel, brief_day()),
        "Task: Take in the answers to %s on %s and build what they unblock: %s." % (items, rel, ", ".join(steps)),
        "Steps: %s of %s" % (", ".join(steps), plan),
        "Why: %s. No session held the doc, so `keel lookout` started this run (crosstalk S5)." % what,
        "Do, in this worktree:",
        "1. `%s pull %s` — the answers into the doc." % (k, rel),
        "2. `%s checkin %s` — the crew's mark on its Status line." % (k, rel),
        "3. Reply under every hunk the answers changed (`> **Done.** …`, or Applied, Superseded, Revised, Checked).",
        "4. Build what the answers unblock — %s, each by its line in %s's Action plan; run its `gate:` and the repo's check."
        % (", ".join(steps), "the doc" if plan == rel else plan),
        "5. `%s step %s <S> done --branch %s --stamp` for each step whose check is green." % (k, plan, ev["branch"]),
        "6. `%s checkin %s --done`, then commit." % (k, rel),
        "7. End on the line `%s` prints: a decision the answers leave open is a D-item in the doc, then `%s relay %s <Dn>`." % (ask, ask, rel),
        "Not this: never `/finish`, `git push`, `gh` or `bin/pr` — dispatch denies them; the landing is the laptop's `/finish` or autofinish.",
        ""])


def home_rel(p):
    """`p` under this Mac's home as `~/…`: from the laptop the run goes to the peer by dispatch's
    Where, where the home differs, and the allow rules name the overlay's `bin/*` under `~/` (S5 review)."""
    h = str(Path.home()).rstrip("/") + "/"
    return "~/" + p[len(h):] if p.startswith(h) else p


def last_line(r):
    """A peer's answer in one line: the last line naming its log, else its last line, stdout then stderr."""
    lines = [l.strip() for l in (r.stdout + "\n" + r.stderr).splitlines() if l.strip()]
    return next((l for l in reversed(lines) if re.search(r"\blog\s", l)), lines[-1] if lines else "exit %d" % r.returncode)[:240]


def lookout_gone(ev, kind, row, laptop, dry):
    """S5: no live session holds the doc. A run starts only when the answers are on the branch, the
    branch is this host's to act on (the laptop leaves another host's GitHub answer to that host's
    lookout: one start per answer across Macs), an open step waits on them (in a set's entry for a
    component), no session holds the worktree here or the branch on any host (harness list: the
    peer, S11 item 1), the repo is `physical: none`, the week is not tight and the tools are here;
    then a dry or disarmed pass says it would (the preview after the gates, S11 item 6), and an
    armed one writes a `dispatching` row and starts `pickup brief` and `dispatch` out of process
    (S11 item 3: a pass returns in seconds; the next pass reads how it went, lookout_collect) —
    from the laptop by dispatch's own Where default (the peer, else here; no host named in this
    code), from another host `--on here`. Else a card; a GATED one, for a gate that clears by
    itself, is tried again each pass (S11 item 2). Once per answer: the `dispatching` row settles
    the event, so neither a second pass nor a failed dispatch starts it twice."""
    if kind not in RUN_KINDS:
        return lookout_card(ev, "the Save waits on the page (%s); no run starts from it" % row.get("plumb", "not taken in")
                            if kind == "save-held" else "new comments, no answer; no run starts for them")
    top, branch = ev["top"], ev["branch"]
    if not top:
        return lookout_card(ev, "no checkout of %s on this Mac" % ev["doc"].partition("@")[0])
    if kind == "answer" and laptop and branch_host(branch) not in (None, row["host"]):
        return lookout_card(ev, "another host's branch: its own lookout starts the run")
    if kind == "answer" and not branch.startswith("claude/"):   # main, a collaborator's: no run's (finish review, 2026-10-22)
        return lookout_card(ev, "not a claude/* branch: a run starts only on a session's own branch")
    ref = ev["view"] if kind == "answer" and ev["view"] else (top, "refs/heads/" + branch)
    sha = git(ref[0], "rev-parse", ref[1], check=False).stdout.strip()
    if kind == "answer":   # the answer's own commit, not a tip that moved on since (S11c item 14)
        sha = ev["id"].split(":")[1] if ev["id"].count(":") else sha   # answer:<sha>[:<part>]
    sets, slug, plan = set_at(ref[0], ref[1], ev["rel"])
    # a dry pass never writes the Save onto the branch it reads: its items count as answered (S11c item 23)
    steps, where = waiting_steps(git(ref[0], "show", "%s:%s" % (ref[1], ev["rel"]), check=False).stdout, ev["items"],
                                 top.name, sets=sets, slug=slug, given=ev["items"] if kind == "save" and dry else ())
    if where != "entry":   # a component's own Action plan (the older layout, S11c item 29)
        plan = ev["rel"]
    if not steps:
        return lookout_card(ev, "no open step waits on %s; nothing for a run to build" % (", ".join(ev["items"]) or "these answers"))
    why, passing = held_branch(top, branch)
    if why:
        return lookout_card(ev, "%s: its session takes the answers" % why, action=GATED if passing else "card")
    phys = contract_physical(top)
    if not (phys or "").startswith("- physical: none"):
        return lookout_card(ev, "%s's contract says %s, not `physical: none`: the skipper starts it"
                            % (top.name, (phys or "nothing").lstrip("- ").strip()))
    why = lookout_week(top)
    if why:
        return lookout_card(ev, why, action=GATED)
    pickup, dispatch = lookout_tool("pickup"), lookout_tool("dispatch")
    if not (pickup and dispatch):
        return lookout_card(ev, "no %s on this Mac (wharf-runs)" % ("pickup" if not pickup else "dispatch"), action=GATED)
    # one run a branch at a time: a second answer within the hour a run takes to start finds the
    # first run's brief and job, one per branch, which `pickup brief` and `dispatch` would replace
    # (S5 review; keyed on the branch, not the doc, since its landing review); the run pulls every
    # answer on the branch, and the card names the steps it was not briefed for. A start that
    # failed is no run (its event's later `start` row): it holds nothing back (S5 landing item 8);
    # one collected as dispatched still is, until its session shows (finish review, 2026-10-22)
    try:
        ttl = _common().OWNER_TTL
    except ImportError:   # a missing core is a card, never a dead pass (S11c item 13)
        return lookout_card(ev, "no regatta core here to read the 2 h guard", action=GATED)
    on_branch, last_start = ev["doc"].partition(":")[0], {}
    for r in pass_rows():
        if str(r.get("doc") or "").partition(":")[0] == on_branch and (r.get("action") == "dispatching" or r.get("start")):
            last_start[(r.get("doc"), r.get("id"))] = r
    started = sorted((r for r in last_start.values() if r.get("action") == "dispatching" or r.get("start") == "dispatched"
                      and now_ts() - float(r.get("ts") or 0) < ttl), key=lambda r: float(r.get("ts") or 0))
    if started:
        return lookout_card(ev, "a run started on its branch %dm ago (%s); it pulls these answers too, but was not briefed for %s"
                            % ((now_ts() - float(started[-1]["ts"])) // 60, ", ".join(started[-1].get("steps") or []),
                               ", ".join(steps)))
    # `pickup brief` writes docs/handoff/<today>-<topic>.md: on a branch seeded today that is its own
    # brief, and its Steps: hold would go with it (S5 review)
    own = "docs/handoff/%s-%s.md" % (brief_day(), branch_topic(branch))
    mine = git(ref[0], "show", "%s:%s" % (ref[1], own), check=False)
    if not mine.returncode and "the lookout's run on" not in mine.stdout.split("\n", 1)[0]:
        return lookout_card(ev, "the branch's own brief %s is from today and a run's brief would replace it" % own)
    held = []
    if not mine.returncode:   # an earlier run's brief from today: the new one keeps its Steps: hold
        hm = list(BRIEF_STEPS_RE.finditer(mine.stdout))
        if any(m.group("doc") != plan for m in hm):   # one Steps: line names one plan (finish review)
            return lookout_card(ev, "the branch's brief %s holds steps of %s; a run for %s waits until it lands"
                                % (own, ", ".join(sorted({m.group("doc") for m in hm})), plan))
        held = [s.strip() for m in hm for s in m.group("ids").split(",")]
        steps = held + [s for s in steps if s not in held]
    # the last gate asks the other hosts (an ssh round trip from the laptop): a live session there
    # on the branch takes the answers, as a held worktree here does; a host that did not answer, again
    why, passing = peer_live(branch)
    if why:
        return lookout_card(ev, "%s%s" % (why, "" if passing else ": its session takes the answers"),
                            action=GATED if passing else "card")
    if dry:
        return lookout_card(ev, "a run would start here%s" % ("" if lookout_armed() else " once armed (keel lookout --arm)"),
                            action="would dispatch")
    # `why`, never `card`: a start on its way asks the owner nothing (helm's board makes every carded
    # row a card; S11c item 24)
    start = dict(row, action="dispatching", steps=steps, ts=now_ts(),
                 why="a run for %s %s is starting out of process; the next pass reads how it went (dispatch --status)"
                 % (ev["doc"], ", ".join(ev["items"])))
    lookout_log(start)
    why = lookout_spawn({"row": start, "branch": branch, "top": str(top), "laptop": laptop, "text": run_brief(ev, steps, sha, plan=plan),
                         "pending": pending_of(ev, row), "keep": held})
    if why:
        return dict(lookout_card(ev, "the start could not be launched (%s); no run started" % why), steps=steps, start="failed")
    return dict(start, logged=True)


def pending_of(ev, row):
    """The fields an event is carried to the next pass with: a Save taken in keeps its plumb line,
    so a retried event does not read the emptied page as a Save still waiting (S11 item 2)."""
    out = {k: ev.get(k) for k in ("doc", "kind", "id", "items", "skip", "sessions", "saved_by", "branch", "rel")}
    if row.get("plumb"):
        out["plumb"] = row["plumb"]
    return out


def lookout_spawn(req):
    """Start one run out of process (S11 item 3): the request file under LOOKOUT_STARTS, then `keel
    lookout --start <file>` in its own session, which writes <file>.out.json; None, or why it failed."""
    import hashlib
    d = state_dir() / LOOKOUT_STARTS
    d.mkdir(parents=True, exist_ok=True)
    name = hashlib.sha1(("%s\0%s" % (req["row"]["doc"], req["row"]["id"])).encode()).hexdigest()[:16]
    f = d / (name + ".json")
    tmp = d / (name + ".tmp")
    tmp.write_text(json.dumps(req, ensure_ascii=False, sort_keys=True))
    tmp.replace(f)
    try:
        with open(d / (name + ".log"), "a") as log:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "lookout", "--start", str(f)],
                             stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as e:
        f.unlink()
        return str(e)[:160]
    return None


# What a start's tools never inherit from the pass (S11c item 12): a fired job's label turns dispatch's
# Where default off, its log and year are the job's own, and a session id or a skipper's road names
# whoever ran the pass — dispatch would make that session every run's skipper, and pickup would
# brief past that session's own lock.
START_ENV_DROP = ("DISPATCH_LABEL", "DISPATCH_LOG", "DISPATCH_YEAR", "CLAUDE_CODE_SESSION_ID",
                  "DISPATCH_SKIPPER", "DISPATCH_MANAGER", "DISPATCH_SKIPPER_ACCOUNT", "DISPATCH_MANAGER_ACCOUNT",
                  "DISPATCH_SHIP", "DISPATCH_PLAN", "DISPATCH_PLAN_SPACE", "DISPATCH_SKIPPER_HOST", "DISPATCH_MANAGER_HOST",
                  # a run's chain and task, as dispatch's runner unsets them: the lookout's run starts a chain of its own
                  "DISPATCH_DEPTH", "DISPATCH_PIN", "DISPATCH_BRIEF", "DISPATCH_TASK", "DISPATCH_REPO", "ASK_ACCOUNT")
RELEASED = "Released:"   # a brief's `Steps:` line once its run did not start: BRIEF_STEPS_RE reads it no more


def released_brief(text, why, keep=()):
    """The brief with its `Steps:` hold turned into a `Released:` line naming why (S11c item 9). `keep`:
    an earlier run's steps this brief carried (the same-day brief), still held (finish review)."""
    def sub(m):
        sm, line = BRIEF_STEPS_RE.match(m.group(0)), m.group(1).strip()
        kept = [s.strip() for s in sm.group("ids").split(",") if s.strip() in keep] if sm else []
        if kept:
            line = "%s of %s" % (", ".join(s.strip() for s in sm.group("ids").split(",") if s.strip() not in kept),
                                 sm.group("doc"))
        out = "%s %s — no run started (%s); `keel landing` holds nothing for it" % (RELEASED, line, " ".join(why.split())[:160])
        return ("Steps: %s of %s\n" % (", ".join(kept), sm.group("doc")) + out) if kept else out
    return re.sub(r"^Steps:\s*(.*)$", sub, text, count=1, flags=re.M)


def start_err(e):
    """A tool's failure, short: a timeout's own text is the whole command line, the brief and this Mac's
    paths with it, and the release commits it (finish review)."""
    return "timed out after %ss" % e.timeout if isinstance(e, subprocess.TimeoutExpired) else str(e)[:160]


def lookout_start(path):
    """`keel lookout --start <request>`, the detached half of a start: `pickup brief` puts the brief on
    the branch, `dispatch` starts the run; the result goes to <request>.out.json for the next pass.
    A pickup refusal that clears by itself (PICKUP_PASSING_RE) is GATED, its event tried again. A
    brief that went on but whose run did not start (dispatch failed, or pickup timed out) is
    briefed again released, so its `Steps:` hold keeps no branch from landing (S11c item 9)."""
    f = Path(path).resolve()
    if f.parent != (state_dir() / LOOKOUT_STARTS).resolve():
        print("keel lookout --start: %s is not under %s" % (path, state_dir() / LOOKOUT_STARTS), file=sys.stderr)
        return 1
    req = json.loads(f.read_text())
    # the tools are this Mac's, never the request's (a file anyone here can write; finish review, 2026-10-22)
    req["pickup"], req["dispatch"] = lookout_tool("pickup"), lookout_tool("dispatch")
    ev = {"doc": req["row"]["doc"], "items": req["row"].get("items") or [], "kind": req["row"].get("event") or ""}
    steps, branch, top = req["row"].get("steps") or [], req["branch"], req["top"]
    env = {k: v for k, v in os.environ.items() if k not in START_ENV_DROP}
    held = False   # the brief, with its hold, may be on the branch
    try:
        if not lookout_armed():
            raise FileNotFoundError("disarmed before it started")
        if not (req["pickup"] and req["dispatch"]):
            raise FileNotFoundError("no pickup or dispatch on this Mac")
        try:
            r = subprocess.run([req["pickup"], "brief", branch, "--repo", top, "--text", req["text"]],
                               capture_output=True, text=True, timeout=180, env=env)
        except subprocess.TimeoutExpired:
            held = True   # whether pickup committed is unknown: released all the same
            raise
        held = not r.returncode   # pickup refuses before it commits, or takes the brief back (its push)
        if r.returncode:
            why = last_line(r)
            res = lookout_card(ev, "pickup brief refused: %s; no run started" % why,
                               action=GATED if PICKUP_PASSING_RE.search(why) else "card")
        else:
            brief = last_line(r)
            try:
                r = subprocess.run([req["dispatch"], branch, "--repo", top] + ([] if req["laptop"] else ["--on", "here"]),
                                   capture_output=True, text=True, timeout=300, env=env)
                if r.returncode:
                    res = lookout_card(ev, "the brief is on %s; dispatch failed: %s" % (branch, last_line(r)))
                else:
                    res, held = {"action": "dispatched", "run": last_line(r)}, False
            except subprocess.TimeoutExpired as e:   # the peer may have the job: held, as a lost start is (finish review)
                res, held = lookout_card(ev, "the brief is on %s; dispatch %s, so whether a run started is unknown: "
                                         "dispatch --status says" % (branch, start_err(e))), False
            except OSError as e:
                res = lookout_card(ev, "the brief is on %s; dispatch did not run (%s)" % (branch, start_err(e)))
            res["brief"] = brief
    except FileNotFoundError as e:
        res = lookout_card(ev, "pickup brief did not run (%s); no run started" % e, action=GATED)
    except (OSError, subprocess.TimeoutExpired) as e:
        res = lookout_card(ev, "pickup brief did not run (%s); no run started" % start_err(e))
    if held:
        res["released"] = lookout_release(req, env, res.get("card") or "no run started")
        res["card"] = "%s; %s" % (res["card"], res["released"])
    res = dict(res, steps=steps, start="dispatched" if res["action"] == "dispatched" else "failed")
    tmp = f.with_name(f.stem + ".out.tmp")
    tmp.write_text(json.dumps(dict(req, result=res), ensure_ascii=False, sort_keys=True))
    tmp.replace(f.with_name(f.stem + ".out.json"))
    f.unlink()
    return 0


def lookout_release(req, env, why):
    """Brief the branch again with its hold released (released_brief), so `keel landing` and
    autofinish are not held for a run that is not coming; the line saying how it went. A timed-out
    pickup may have committed nothing: the released brief then goes on in its place, a hold of none."""
    text = released_brief(req["text"], re.sub(r"^no live session for .*? — ", "", why), keep=req.get("keep") or ())
    try:
        r = subprocess.run([req["pickup"], "brief", req["branch"], "--repo", req["top"], "--text", text],
                           capture_output=True, text=True, timeout=180, env=env)
    except (OSError, subprocess.TimeoutExpired) as e:
        r = None
        err = start_err(e)
    if r is not None and not r.returncode:
        return "its brief's Steps: hold released (%s)" % RELEASED
    return ("its brief's Steps: hold may still be on the branch (the release failed: %s) — `keel landing` names it"
            % (last_line(r) if r is not None else err))


def lookout_collect(now, pending):
    """The detached starts' results, read by the next pass (under its lock): one row each, logged and
    returned; a GATED one's event goes back into `pending`. A request older than START_LIMIT with no
    result died: a card, its start lost."""
    d = state_dir() / LOOKOUT_STARTS
    rows = []
    for f in sorted(d.glob("*.json")) if d.is_dir() else []:
        out = f.name.endswith(".out.json")
        try:
            req = json.loads(f.read_text())
            base = {k: v for k, v in req["row"].items() if k not in ("action", "card", "why", "ts")}
        except (OSError, ValueError, KeyError, TypeError):
            f.unlink()
            continue
        if out:
            res = req.get("result") or {}
        elif now - float(req["row"].get("ts") or 0) > START_LIMIT and not f.with_name(f.stem + ".out.json").exists():
            ev = {"doc": base.get("doc"), "items": base.get("items") or [], "kind": base.get("event") or ""}
            res = dict(lookout_card(ev, "its start never reported back (killed?); dispatch --status says if a run started"),
                       start="lost")
        else:
            continue
        row = dict(base, ts=now, **res)
        lookout_log(row)
        rows.append(row)
        if row["action"] not in SETTLED and req.get("pending"):
            pending.append(req["pending"])
        f.unlink()
        f.with_name(f.name.split(".", 1)[0] + ".log").unlink(missing_ok=True)
    return rows


def lookout_rows():
    out = []
    try:
        for l in (state_dir() / LOOKOUT_LOG).read_text().splitlines():
            try:
                r = json.loads(l)
            except ValueError:
                continue
            if isinstance(r, dict):
                out.append(r)
    except OSError:
        pass
    return out


PASS_ROWS = []   # [rows]: one pass's lookout.jsonl, read once and kept current by lookout_log (S11c item 15)


def pass_rows():
    """lookout.jsonl as the pass knows it — read once a pass, with every row the pass logged since
    (a second answer on a branch sees the first's `dispatching` row) — else read now."""
    return PASS_ROWS[0] if PASS_ROWS else lookout_rows()


def lookout_log(row):
    state_dir().mkdir(parents=True, exist_ok=True)
    with open(state_dir() / LOOKOUT_LOG, "a") as f:
        f.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
    if PASS_ROWS:
        PASS_ROWS[0].append(json.loads(json.dumps(row)))


def lookout_trim(now):
    """lookout.jsonl keeps LOOKOUT_KEEP_DAYS of rows (S11 item 18): rewritten, under the pass's lock,
    only when a row has aged out. An event's memory goes with its rows; none comes back that late —
    an answer is a diff of one pass, and a Save the page still holds is cleared once taken in."""
    rows = pass_rows()
    keep = [r for r in rows if now - float(r.get("ts") or 0) < LOOKOUT_KEEP_DAYS * 86400]
    if len(keep) == len(rows):
        return
    tmp = state_dir() / (LOOKOUT_LOG + ".tmp")
    tmp.write_text("".join(json.dumps(r, ensure_ascii=False, sort_keys=True) + "\n" for r in keep))
    tmp.replace(state_dir() / LOOKOUT_LOG)


def card_open(r, tops):
    """A card still worth the owner's look (S11 item 18): raised within LOOKOUT_CARD_DAYS, and its
    branch still here or on origin (a landed branch's cards close with it); a repo this Mac does
    not know keeps its card by age alone."""
    if now_ts() - float(r.get("ts") or 0) >= LOOKOUT_CARD_DAYS * 86400:
        return False
    try:
        name, branch, _rel = key_parts(str(r.get("doc") or ""))
    except Stop:
        return True
    top = tops.get(name)
    if not top or not Path(top).is_dir():
        return True
    # helm's poll mirror too: a branch only it knows is still on GitHub (S11c item 27)
    return git(top, "rev-parse", "-q", "--verify", "refs/heads/" + branch, check=False).returncode == 0 \
        or origin_view(Path(top), branch, fetch_first=False) is not None


def lookout_state():
    try:
        d = json.loads((state_dir() / LOOKOUT_STATE).read_text())
    except (OSError, ValueError):
        d = {}
    d = d if isinstance(d, dict) else {}
    return {"open": d.get("open") or {}, "comments": d.get("comments") or {}, "pending": d.get("pending") or []}


def lookout_armed():
    return (state_dir() / LOOKOUT_ARMED).is_file()


def lookout_after():
    """The time an answer the lookout never saw open must be newer than to count (S12): the arm
    time, so the first armed pass does not fire on every old answered doc; a dry pass on a disarmed
    Mac looks back one pass. Never past lookout.jsonl's horizon, whose rows remember the acts."""
    try:
        at = float(json.loads((state_dir() / LOOKOUT_ARMED).read_text()).get("ts"))
    except (OSError, ValueError, AttributeError, TypeError):
        at = now_ts() - LOOKOUT_EVERY
    return max(at, now_ts() - LOOKOUT_KEEP_DAYS * 86400)


def seen_answered(was, gd, rel):
    """The items the last pass saw answered: its record's `answered`; a record from before S12 has
    none, so the doc at its tip says (one pass after the upgrade); none for a doc never seen."""
    if not was:
        return []
    if isinstance(was.get("answered"), list):
        return was["answered"]
    return [d for d, a in (answers_in(gd, was.get("tip"), rel) or {}).items() if a.strip()] if was.get("tip") else []


def lookout_arm(on):
    # arming starts runs since S5: the owner's yes (AGENTS.md, Traps); disarming is the safe way and
    # stays open to an unattended run that sees the lookout misbehave (S5 landing review)
    if on and os.environ.get("CLAUDE_UNATTENDED"):
        print("keel lookout --arm: refused in an unattended session (CLAUDE_UNATTENDED=%s) — arming is the owner's"
              % os.environ["CLAUDE_UNATTENDED"], file=sys.stderr)
        return 1
    f = state_dir() / LOOKOUT_ARMED
    if on:
        state_dir().mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps({"ts": now_ts(), "by": os.environ.get("USER") or "?"}) + "\n")
        print("lookout: armed (%s) — every pass now hails, records, and starts a run where no session holds the doc" % f)
    else:
        if f.exists():
            f.unlink()
        print("lookout: disarmed (%s gone) — a pass only says what it would do" % f)
    return 0


def lookout_events(asks, prev, pinned, laptop, runs, mcp_box, dry, notes):
    """The pass's events, and the new state. mcp_box: [Mcp or None, calls], filled lazily."""
    tops = repo_tops(pinned)
    events, new_open, new_comments = [], {}, dict(prev["comments"])
    # an event not settled last pass (a working session, a refused hail) is tried again: the diff
    # that found it has moved on, and nothing else would bring it back
    for ev in prev["pending"]:
        try:
            name = key_parts(ev["doc"])[0]
        except Stop:
            continue
        top = tops.get(name)
        events.append(dict(ev, top=top, view=origin_view(top, ev["branch"], fetch_first=False) if top else None))

    def mcp():
        if mcp_box[0] is None:
            k = sheep_key()
            if not k:
                raise Stop("no SPACESHEEP_KEY")
            mcp_box[0] = Mcp(k)
        return mcp_box[0]
    # GitHub: an item the last pass did not see answered and answered at origin's tip now — open at
    # the last pass, or never seen (S12: opened and answered between two passes, or before the first).
    # The docs read: those open now or at the last pass, and this Mac's pins on a session's branch
    # deployed or seen within LOOKOUT_DAYS — a doc whose only item opened and closed between two
    # passes has no open item at either (lookout-echo, finding 1; the managing session's call:
    # "recent course docs" are docs with a page, helm's poll stays as it is). A pin alone is read
    # from helm's mirror or the last fetch, never fetched for: a landed branch is pruned there.
    after, horizon = lookout_after(), now_ts() - LOOKOUT_DAYS * 86400
    def session_branch(k):
        try:
            return key_parts(k)[1].startswith("claude/")
        except Stop:
            return False
    watched = {k for k, r in prev["open"].items() if (r or {}).get("items")} | set(asks)
    paged = {k for k, pin in pinned.items() if isinstance(pin, dict) and drain_due_ts(pin) >= horizon
             and session_branch(k)} - watched
    for key in sorted(watched | paged):
        name, branch, rel = key_parts(key)
        top = tops.get(name)
        view = origin_view(top, branch, fetch_first=not dry and key not in paged) if top else None
        tip = git(view[0], "rev-parse", view[1], check=False).stdout.strip() if view else ""
        at_tip = answers_in(view[0], tip, rel) if tip else None
        answered = sorted((d for d, a in at_tip.items() if a.strip()), key=id_key) if at_tip is not None else None
        was = prev["open"].get(key)
        # every doc read keeps its record, open items or none, so a closed doc that gains an item is
        # no first meeting (finding 5 of the review list); a pin's lapses with its horizon
        if view and answered is not None:
            # open items only: one answered at the tip is settled here, never gone again on a later
            # pass while stale asks list it (a rewrite would find its answer under a new sha)
            new_open[key] = {"items": [d for d in asks.get(key, []) if d not in answered], "tip": tip, "answered": answered}
        elif was:   # origin unread, or the doc unreadable at its tip: the last record stands, read again next pass
            new_open[key] = was if [d for d in was.get("items") or [] if d not in asks.get(key, [])] else \
                dict(was, items=[d for d in asks.get(key, []) if d not in (was.get("answered") or [])])
            continue
        elif key in asks:
            new_open[key] = {"items": asks[key], "tip": ""}
            continue
        if not view or answered is None:
            continue
        # an item still in asks but answered at the tip is gone too: a scan that carried stale asks would
        # otherwise move the record's tip past the answer, and no later window would hold it (S12's third round)
        gone = [d for d in (was or {}).get("items") or [] if d not in asks.get(key, []) or d in answered]
        seen = set((was or {}).get("items") or []) | set(seen_answered(was, view[0], rel))
        unseen = [d for d in answered or [] if d not in seen]
        if not (gone or unseen):
            continue
        applied, applied_at = ((pinned.get(key) or {}).get(f) for f in ("applied", "applied_at"))
        for a in answer_events(view[0], view[1], rel, gone, (was or {}).get("tip"), runs, unseen=unseen, after=after,
                               applied=applied if isinstance(applied, dict) else None,
                               applied_at=applied_at if isinstance(applied_at, dict) else None):
            events.append(dict({"doc": key, "kind": "answer", "id": "answer:" + a["sha"] + (":" + a["part"] if a["part"] else ""),
                                "items": a["items"], "skip": a["skip"], "sessions": a["sessions"], "top": top,
                                "branch": branch, "rel": rel, "view": view}, **({"card": a["card"]} if a.get("card") else {})))
    # the pages of docs with open items: Saves (the laptop's), then comments; the drain's breaker —
    # three spacesheep failures in a row end the pages for this pass (each can wait 30 s)
    fails = 0
    for key in sorted(asks):
        pin = pinned.get(key)
        if not (pin and pin.get("space")):
            continue
        if fails >= 3:
            notes.append("spacesheep: 3 failures in a row — the other pages wait for the next pass")
            break
        name, branch, rel = key_parts(key)
        top = tops.get(name)
        if laptop:
            try:  # a dry run drains too: it moves the room's Saves into the pin, as the 6-hour drain does
                drain_saves(mcp(), key, pin["space"], row=pin_row(key, pin))
                mcp_box[1] += 1
                fails = 0
                pin = pins().get(key) or pin
            except Exception as e:  # Stop, a refused call: this page waits for the next pass
                notes.append("%s: not drained (%s)" % (key, str(e)[:120]))
                fails += 1
            text = git(top, "show", "refs/heads/%s:%s" % (branch, rel), check=False).stdout if top else ""
            lacking = [sv for sv in pin.get("saves") or [] if text and save_lacks(sv, text)]
            if lacking:
                # every Save is taken in, whoever saved it; who did is recorded with it (the owner on S3's
                # D1, 2026-10-21: "Every save taken in, just record who made it")
                by = sorted({viewer_name(save_viewer(sv)) for sv in lacking})
                items = sorted({k for sv in lacking for k in save_items(sv, text)}, key=id_key)
                seq = max(int(sv.get("seq") or 0) for sv in lacking)
                # by space too: a page redeployed to a new space counts seq from 1 again (M19)
                events.append({"doc": key, "kind": "save", "id": "save:%s:%d" % (pin["space"][:8], seq),
                               "items": items, "skip": None, "sessions": [], "top": top, "branch": branch, "rel": rel,
                               "saved_by": by, "view": None})
        try:
            threads = comment_threads(sheep_comments(mcp(), mcp().key, pin["space"]))
            mcp_box[1] += 1
            fails = 0
        except Exception as e:
            notes.append("%s: comments not read (%s)" % (key, str(e)[:120]))
            fails += 1
            continue
        words = open_words(threads, set(pin.get("taken") or []), pin)
        before = prev["comments"].get(key)
        new_comments[key] = words
        fresh = {t: n for t, n in words.items() if (before or {}).get(t) != n}
        if before is not None and fresh:
            import hashlib
            events.append({"doc": key, "kind": "comment", "id": "comments:" + hashlib.sha1(
                json.dumps(sorted(fresh.items())).encode()).hexdigest()[:12], "items": [], "skip": None, "sessions": [],
                "top": top, "branch": branch, "rel": rel, "view": None})
    for key in list(new_comments):
        if key not in asks:
            del new_comments[key]
    return events, {"open": new_open, "comments": new_comments, "pending": []}


def lookout_act(ev, here, laptop, runs, dry):
    """One event → its row: the host rule, the wait lock, the Save taken in, the session, the act."""
    row = {"doc": ev["doc"], "id": ev["id"], "event": ev["kind"], "items": ev["items"], "host": here}
    if ev.get("saved_by"):
        row["saved_by"] = ev["saved_by"]
    if ev["skip"]:
        return dict(row, action="skipped", why=ev["skip"])
    if not laptop and not ev["branch"].startswith("claude/%s/" % here):
        # A host other than the laptop acts on its own branches; another host's lookout owns the rest. One
        # pushed lately is the owner's to know about (the laptop may be asleep); an older one is left to that host.
        view = ev["view"] or (origin_view(ev["top"], ev["branch"], fetch_first=False) if ev["top"] else None)
        ct = git(view[0], "log", "-1", "--format=%ct", view[1], check=False).stdout.strip() if view else ""
        try:
            fresh = now_ts() - int(ct) < _common().OWNER_TTL
        except (ValueError, ImportError):
            fresh = False
        if fresh:
            return dict(row, action="card", card="%s %s on another host's branch, pushed within %dh — its lookout acts"
                        % (ev["doc"], ", ".join(ev["items"]) or ev["kind"], _common().OWNER_TTL // 3600))
        return dict(row, action="skipped", why="another host's branch")
    if laptop and ev["kind"] == "answer" and branch_host(ev["branch"]) not in (None, here):
        # another host's GitHub answer is that host's lookout's, to hail as to start (S11 item 17: each
        # Mac's lookout.jsonl is its own, so both would hail); a Save or a comment is only the laptop's
        return dict(row, action="skipped", why="another host's branch: its own lookout acts on a GitHub answer")
    if ev.get("card"):   # an answer the lookout cannot judge (S12): the owner's to look at, once
        return dict(row, action="card", card="%s %s %s" % (ev["doc"], ", ".join(ev["items"]), ev["card"]))
    # origin's history first (the newest trailer is there), else the local branch
    ref = ev["view"] or ((ev["top"], "refs/heads/" + ev["branch"]) if ev["top"] and git(
        ev["top"], "rev-parse", "-q", "--verify", "refs/heads/" + ev["branch"], check=False).returncode == 0 else None)
    how, rec, src = resolve_session(ev["doc"], ev["top"], ev["branch"], ref, runs)
    if how == "left alone":
        if ev["kind"] == "answer":   # a sheep wait wakes on the page, never on a commit: the answer waits for the wait
            return dict(row, action="waiting", why="%s; it never wakes on a commit — next pass" % src)
        return dict(row, action="left alone", why=src)
    if rec:
        row.update(target=str(rec.get("session_id")), via=src, state=rec.get("state"))
        if any(len(s) >= 6 and row["target"].startswith(s) for s in ev["sessions"]):
            return dict(row, action="own", why="the session's own commit")
        if how == "working":   # before any plumbing: a Save pushed under a working session diverges its branch
            return dict(row, action="waiting", why="%s is %s — next pass" % (row["target"][:8], rec.get("state")))
    import contextlib
    import io
    kind = ev["kind"]
    if kind == "save":
        if dry:
            row["plumb"] = "would take it in"
        elif str(ev.get("plumb") or "").startswith("committed ") and "not pushed" not in ev["plumb"]:
            row["plumb"] = ev["plumb"]   # a gated event tried again: its Save is on the branch already
        else:
            try:
                with contextlib.redirect_stdout(io.StringIO()) as buf:
                    sheep_pull(ev["doc"], write=True, plumb=True)
                row["plumb"] = next((l.strip() for l in buf.getvalue().splitlines() if l.strip().startswith("committed ")), "nothing new")
            except Stop as e:
                row["plumb"] = "refused: %s" % str(e)[:160]
            except Exception as e:  # a git or spacesheep failure: the session still hears of the Save
                row["plumb"] = "failed: %s: %s" % (type(e).__name__, str(e)[:120])
            # "on its branch" only when it is there on origin: a commit that did not push, or none made,
            # leaves the Save on the page
            if not row["plumb"].startswith("committed ") or "not pushed" in row["plumb"]:
                kind = "save-held"
    if how == "none":
        return dict(row, **lookout_gone(ev, kind, row, laptop, dry))
    about = "%s:%s:%s%s" % (ev["doc"].partition("@")[0], ev["branch"], ev["rel"], "#" + ev["items"][0] if ev["items"] else "")
    if dry:
        return dict(row, action="would hail", about=about)
    res = hail_session(rec, about, kind, here)
    row.update(verdict=res.get("verdict"), road=res.get("road"))
    if res.get("verdict") in ("delivered", "queued", "held"):
        return dict(row, action="hailed", about=about)
    if res.get("verdict") == "refused":   # its own idle re-read found it busy, or the road said no: next pass
        return dict(row, action="waiting", why=str(res.get("why") or "hail refused")[:160])
    # a live session no road reaches: never a run beside it (one writer per branch)
    return dict(row, **lookout_card(ev, "%s is %s but no hail reaches it" % (row["target"][:8], rec.get("state"))),
                why=str(res.get("why") or "hail unreachable")[:160])


def lookout_redeploy(asks, pinned, dry):
    """The laptop's pages follow origin: a pinned doc with open items, or one the lookout acted on
    within LOOKOUT_DAYS, whose page shows a commit origin has moved past on the doc — a run's
    check-in, a GitHub answer — is redeployed from origin's blob, so the page the owner reads carries it.
    Never back: a page ahead of origin (a session's unpushed commit) is the checkout's to deploy."""
    since = now_ts() - LOOKOUT_DAYS * 86400
    keys = set(asks) | {r["doc"] for r in pass_rows() if (r.get("ts") or 0) >= since and r.get("doc")}
    tops, out = repo_tops(pinned), []
    for key in sorted(keys):
        pin = pinned.get(key)
        if not (pin and pin.get("space") and pin.get("sha")):
            continue
        name, branch, rel = key_parts(key)
        view = origin_view(tops[name], branch, fetch_first=False) if name in tops else None
        if not view:
            continue
        doc_sha = git(view[0], "log", "-1", "--format=%H", view[1], "--", rel, check=False).stdout.strip()
        if not doc_sha or doc_sha == pin["sha"] or git(view[0], "merge-base", "--is-ancestor", pin["sha"], doc_sha, check=False).returncode:
            continue
        if dry:
            out.append("%s: would redeploy at %s" % (key, doc_sha[:7]))
            continue
        try:
            u, sha, did = sheep_blob(key, view[1], gd=view[0])
            out.append("%s: redeployed at %s" % (key, sha[:7]) if did else "%s: already at %s" % (key, sha[:7]))
        except Exception as e:
            out.append("%s: not redeployed (%s)" % (key, str(e)[:120]))
    return out


def lookout(dry=False, if_due=False):
    """One pass; prints a line per event and one summary; returns the rows."""
    import time
    t0, now = time.time(), now_ts()
    stamp = state_dir() / LOOKOUT_AT
    if if_due:
        if not lookout_armed():
            return []
        try:
            last = float(json.loads(stamp.read_text()).get("ts") or 0)
        except (OSError, ValueError, AttributeError):
            last = 0
        if 0 <= now - last < LOOKOUT_EVERY:
            return []
    if not dry and not lookout_armed():
        print("lookout: disarmed — a dry run (keel lookout --arm acts)")
        dry = True
    import fcntl
    state_dir().mkdir(parents=True, exist_ok=True)
    lock = open(state_dir() / "lookout.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("lookout: another pass is running")
        return []
    here, laptop_name = lookout_host()
    laptop = here == laptop_name
    SESSION_MEMO.clear()
    PEER_MEMO.clear()
    carried = []
    try:
        PASS_ROWS[:] = [lookout_rows()]
        asks = open_asks()
        blind = asks is None
        # the detached starts' results (S11 item 3); a blind pass writes no state, so it leaves them on
        # disk, or a GATED one's event would be carried nowhere (finish review, 2026-10-22)
        collected = [] if dry or blind else lookout_collect(now, carried)
        return lookout_pass(t0, now, stamp, dry, here, laptop, asks, blind, collected, carried)
    except BaseException:
        # the results are consumed: a GATED start's event goes back into the state, or nothing would
        # bring it back (S11c item 30)
        if carried:
            st = lookout_state()
            have = {(q.get("doc"), q.get("id")) for q in st["pending"]}
            st["pending"] += [q for q in carried if (q.get("doc"), q.get("id")) not in have]
            tmp = state_dir() / (LOOKOUT_STATE + ".tmp")
            tmp.write_text(json.dumps(st, ensure_ascii=False, sort_keys=True))
            tmp.replace(state_dir() / LOOKOUT_STATE)
        raise
    finally:
        PASS_ROWS.clear()


GATED_RELOG = 86400   # a GATED card still retried is logged again this often, so its age stays its last try


def lookout_pass(t0, now, stamp, dry, here, laptop, asks, blind, collected, carried):
    """The pass after its starts are collected: the events, each one's act, the state."""
    import time
    for row in collected:
        print("lookout: %s %s %s — %s%s" % (row.get("event"), row.get("doc"), ", ".join(row.get("items") or []) or row.get("id"),
                                           row["action"], "".join(" · %s" % row[k] for k in ("card", "run") if row.get(k))))
    if blind:   # the state stays as it was: written from no list, it would forget every open item
        print("lookout: no asks.json in %s — helm's ask poll has not run on this Mac; nothing watched" % ask_cache())
        asks = {}
    prev, pinned, runs, notes = lookout_state(), pins(), run_records(), []
    box = [None, 0]
    events, new_state = lookout_events(asks, prev, pinned, laptop, runs, box, dry, notes)
    events = list({(ev["doc"], ev["id"]): ev for ev in events}.values())   # a carried event found again is one
    last = {}
    for r in pass_rows():
        last[(r.get("doc"), r.get("id"))] = r
    # settled by its latest row: a start that came back GATED follows its `dispatching` row, and its
    # event is tried again (S11 item 2)
    done = {k for k, r in last.items() if r.get("action") in SETTLED}
    rows = []
    for ev in events:
        if (ev["doc"], ev["id"]) in done:
            continue
        row = dict(lookout_act(ev, here, laptop, runs, dry), ts=now)
        logged = row.pop("logged", False)   # lookout_gone wrote its dispatching row before the start
        rows.append(row)
        print("lookout: %s %s %s — %s%s" % (row["event"], row["doc"], ", ".join(row["items"]) or row["id"], row["action"],
                                           "".join(" · %s" % row[k] for k in ("target", "verdict", "plumb", "why", "card", "run") if row.get(k))))
        was = last.get((row["doc"], row["id"])) or {}
        # one row per change of act; a GATED card still retried once a day too, or its card ages out
        # of --status while the pass still tries it (S11c item 26)
        again = row["action"] == GATED and now - float(was.get("ts") or 0) >= GATED_RELOG
        if not dry and not logged and ((was.get("action"), was.get("target")) != (row["action"], row.get("target")) or again):
            lookout_log(row)
        if row["action"] not in SETTLED:
            new_state["pending"].append(pending_of(ev, row))
    new_state["pending"] += [p for p in carried if (p.get("doc"), p.get("id")) not in
                             {(q.get("doc"), q.get("id")) for q in new_state["pending"]}]
    redeployed = lookout_redeploy(asks, pins(), dry) if laptop else []
    for l in redeployed + notes:
        print("  " + l)
    secs = time.time() - t0
    if not dry and not blind:
        tmp = state_dir() / (LOOKOUT_STATE + ".tmp")
        tmp.write_text(json.dumps(new_state, ensure_ascii=False, sort_keys=True))
        tmp.replace(state_dir() / LOOKOUT_STATE)
        stamp.write_text(json.dumps({"ts": now, "secs": round(secs, 2), "calls": box[1], "events": len(events),
                                     "acted": len(rows), "docs": len(asks)}) + "\n")
        lookout_trim(now)
    print("lookout: %d doc%s with open items, %d event%s, %d acted on, %d spacesheep call%s, %.1fs%s" % (
        len(asks), "" if len(asks) == 1 else "s", len(events), "" if len(events) == 1 else "s", len(rows),
        box[1], "" if box[1] == 1 else "s", secs, " (dry run)" if dry else ""))
    return rows


def lookout_status(as_json=False):
    """Armed or not, the last pass (G4: its seconds and spacesheep calls), the week's acts by kind,
    the open cards — a card stays open until a later row of its event settles it otherwise, for
    LOOKOUT_CARD_DAYS at most and while its branch is still there (card_open) — and
    the runs started within LOOKOUT_DAYS with their log line.
    as_json: the same as one object (helm's board reads the cards from it, crosstalk S6)."""
    try:
        st = json.loads((state_dir() / LOOKOUT_AT).read_text())
        float(st["ts"]), int(st.get("calls", 0)), int(st.get("docs", 0)), int(st.get("events", 0)), int(st.get("acted", 0))
    except (OSError, ValueError, KeyError, TypeError):
        st = None
    rows = lookout_rows()
    week = [r for r in rows if (r.get("ts") or 0) >= now_ts() - 7 * 86400]
    counts = {}
    for r in week:
        counts[r.get("action")] = counts.get(r.get("action"), 0) + 1
    latest = {}
    for r in rows:
        latest[(r.get("doc"), r.get("id"))] = r
    tops = repo_tops(pins())
    cards = [r for r in latest.values() if r.get("card") and card_open(r, tops)]
    # the runs it started (S5), newest last, each with dispatch's own line naming the run's log
    since = now_ts() - LOOKOUT_DAYS * 86400
    runs = sorted((r for r in latest.values() if r.get("action") == "dispatched" and (r.get("ts") or 0) >= since),
                  key=lambda r: r.get("ts") or 0)
    if as_json:
        print(json.dumps({"armed": lookout_armed(), "last_pass": st, "week": counts, "cards": cards, "runs": runs},
                         ensure_ascii=False, sort_keys=True))
        return 0
    print("lookout: %s" % ("armed" if lookout_armed() else "disarmed"))
    if st:
        print("last pass: %s — %s s, %d spacesheep call%s, %d doc%s with open items, %d event%s, %d acted on" % (
            human(st["ts"]), st.get("secs"), st.get("calls", 0), "" if st.get("calls") == 1 else "s", st.get("docs", 0),
            "" if st.get("docs") == 1 else "s", st.get("events", 0), "" if st.get("events") == 1 else "s", st.get("acted", 0)))
    else:
        print("last pass: none on this Mac")
    print("7 days: %s" % (", ".join("%d %s" % (n, a) for a, n in sorted(counts.items())) or "nothing acted on"))
    for r in cards:
        print("  card: %s" % r["card"])
    for r in runs:
        print("  run: %s %s (%s%s) — %s" % (r.get("doc"), ", ".join(r.get("items") or []), ", ".join(r.get("steps") or []),
                                           "; saved by " + ", ".join(r["saved_by"]) if r.get("saved_by") else "", r.get("run") or "?"))
    return 0


# ----------------------------------------------------------------------------- checkin (crosstalk S3)

def checkin(memo, done=False, who=None, today=None):
    """The crew's mark on a Course doc's Status line: ` · crew: <who> since <date>`, then
    ` · crew: <who> done <date>` — a run the lookout started says it is on the doc, then that it
    finished; `status --stamp` keeps it, `lint` refuses a mark it cannot read. Not committed here."""
    p = Path(memo)
    text = p.read_text()
    lines = text.split("\n")
    st = keel_parse(lines)["status"]
    if not st:
        raise Stop("%s: no Keel `Status:` line in its first %d lines — nothing to check in on" % (p.name, KEEL_HEAD))
    who = " ".join((who or ("session " + os.environ["CLAUDE_CODE_SESSION_ID"][:8] if os.environ.get("CLAUDE_CODE_SESSION_ID")
                            else os.environ.get("USER") or "crew")).split())
    if not who or "·" in who or re.search(r"\s(?:since|done)\s", " %s " % who):
        raise Stop("checkin: --who %r — one name, without `·`, `since` or `done`" % who)
    date = today or dt.datetime.fromtimestamp(now_ts()).strftime("%Y-%m-%d")
    if not re.match(r"^%s$" % DATE_RE, date):
        raise Stop("checkin: --date %r — yyyy-mm-dd" % date)
    base = CREW_SEG_RE.sub("", lines[st["line"]])
    new = "%s · crew: %s %s %s" % (base, who, "done" if done else "since", date)
    if new != lines[st["line"]]:
        lines[st["line"]] = new
        p.write_text("\n".join(lines))
    print("%s: %s" % (p.name, new))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="keel", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list", help="recent memos with decisions, newest first")
    ls.add_argument("--root", default=os.environ.get("MEMO_ROOT", str(Path.home() / "projects")))
    ls.add_argument("--limit", type=int, default=12, help="0 = all")
    ls.add_argument("--json", action="store_true")
    op = sub.add_parser("open", help="every open post-mortem, doc with unanswered decisions and `Status: open` doc")
    op.add_argument("--root", default=os.environ.get("MEMO_ROOT", str(Path.home() / "projects")))
    op.add_argument("--json", action="store_true")
    for name, h in (("line", "the hand-over line: [course] | [github] | [space] — [file]; starts what it links"),
                    ("url", "line under its old name"),
                    ("link", "the title and decision count, then the hand-over line"),
                    ("pull", "take in commits made on GitHub and name the answers that changed"),
                    ("parse", "print the decisions as JSON"),
                    ("lint", "a pick resting on a claim the doc lists as not verified; a pre-filled answer")):
        sp = sub.add_parser(name, help=h)
        sp.add_argument("memo")
        if name == "lint":
            sp.add_argument("--strict", action="store_true", help="answered items too: the doc as it read when handed over")
            sp.add_argument("--set", action="store_true", help="the doc is an entry: lint every file of its set and each `<slug> D2` across it")
    b = sub.add_parser("build", help="--form: render the memo as a form page")
    b.add_argument("memo")
    b.add_argument("-o", "--out", help="output HTML (default: <memo stem>.form.html in the current directory)")
    s = sub.add_parser("serve", help="the form on 127.0.0.1 (a VS Code tab) where the doc has no spacesheep page; Save writes into the memo")
    s.add_argument("memo")
    s.add_argument("--port", type=int, default=0, help="default: any free port")
    s.add_argument("--keep", action="store_true", help="keep serving after a Save (default: exit after the first)")
    s.add_argument("--idle", type=int, default=110 * 60, help="seconds from start before it stops (default 110 min: under the 2 h a background task may run)")
    sh = sub.add_parser("sheep", help="the doc's spacesheep page: <doc> | pull <doc> [--write] | wait <doc> | check <doc> | drain | prune",
                        description="Deploy a memo's page to spacesheep (the form, answered there with a Save or comments) and "
                                    "bring the answers back. pull previews, pull --write applies; wait is the session's "
                                    "background shell and exits when something arrives; drain empties every recent page's room "
                                    "into the logs; prune drops local pins of branches gone from origin. " + SHEEP_USAGE)
    sh.add_argument("args", nargs=argparse.REMAINDER)
    st = sub.add_parser("status", help="does the doc stand (D11), and did the owner look (E14): verdict and review status")
    st.add_argument("memo")
    st.add_argument("--stamp", action="store_true",
                    help="rewrite the Keel Status line (the set's, for an entry) and the review status into a record's banner")
    st.add_argument("--json", action="store_true", help="the contract the autofinish launcher reads")
    st.add_argument("--no-fetch", action="store_true",
                    help="judge origin as last fetched (the launcher's dry run; a start's own judging fetches)")
    sd = sub.add_parser("stand", help="write the explicit Stands: line; --apply at the deadline; --void a touch; --sweep every worktree")
    sd.add_argument("memo", nargs="?")
    sd.add_argument("--root", default=os.environ.get("MEMO_ROOT", str(Path.home() / "projects")), help="--sweep: where the checkouts are")
    sd.add_argument("--force", action="store_true", help="--sweep: run though the last sweep was under an hour ago")
    sd.add_argument("--dry-run", action="store_true", help="--sweep: say what would stand; write nothing")
    sd.add_argument("--if-armed", action="store_true", help="--sweep: do nothing unless armed (bin/ask poll's call)")
    g = sd.add_mutually_exclusive_group()
    g.add_argument("--sweep", action="store_true", help="every due doc on a claude/* worktree under --root: stand and push (at most hourly)")
    g.add_argument("--arm", action="store_true", help="let bin/ask poll run the sweep")
    g.add_argument("--disarm", action="store_true", help="stop bin/ask poll running the sweep")
    g.add_argument("--by", type=float, help="hours from now (default 24; 0 stands now)")
    g.add_argument("--apply", action="store_true", help="write the Applied replies and commit with Stood-By: autofinish")
    g.add_argument("--void", action="store_true", help="record a touch: it no longer stands")
    sp = sub.add_parser("step", help="write a step's status in the doc's Action plan (entry D6: the build session, plan digest, Aurora)")
    sp.add_argument("memo")
    sp.add_argument("step", help="S3")
    sp.add_argument("word", nargs="+", help="not started | wip | done | blocked | superseded")
    sp.add_argument("--date", help="the date after the word (default today for done)")
    sp.add_argument("--branch", help="the branch that built it")
    sp.add_argument("--note", help="after an em dash: why blocked, what superseded it")
    sp.add_argument("--stamp", action="store_true", help="then rewrite the set's Status lines (status --stamp)")
    em = sub.add_parser("embark", help="/embark's list: open items the stand sweep cannot take, older than 72 h, by block reason (review D4-A)")
    em.add_argument("--root", default=os.environ.get("MEMO_ROOT", str(Path.home() / "projects")))
    em.add_argument("--hours", type=float, default=EMBARK_HOURS, help="docs handed over at least this long ago (default 72)")
    em.add_argument("--json", action="store_true")
    ld = sub.add_parser("landing", help="refuse (exit 1) when a brief this branch added names a step its doc has open (entry D6, S7)")
    ld.add_argument("where", nargs="?", default=".")
    ld.add_argument("--base", help="the ref the branch is compared with (default origin/main, else main)")
    y = sub.add_parser("yolo", help="E12: take every open bare pick unattended, or stop (exit 3) and write nothing; --dnd holds D1-A's classes (exit 4)")
    y.add_argument("memo")
    y.add_argument("--dry-run", action="store_true", help="say what it would take or where it stops; write nothing")
    y.add_argument("--dnd", action="store_true", help="skipper-modes D1-A: take the picks bar the held classes, print each held item (exit 4)")
    y.add_argument("--date", help="the date in the answer line (default today)")
    li = sub.add_parser("light", help="light B1: the open D-items as a chat questionnaire — --check, --plan, --write")
    li.add_argument("memo")
    lg = li.add_mutually_exclusive_group(required=True)
    lg.add_argument("--check", action="store_true", help="may they go as a questionnaire (C1-C4); exit 1 with the reasons")
    lg.add_argument("--plan", action="store_true", help="the AskUserQuestion calls as JSON, to make exactly as printed")
    lg.add_argument("--write", action="store_true", help="the taps from this session's transcript into the doc; exit 3 when one is missing")
    li.add_argument("--record", action="store_true", help="--check: on a refusal, write `Gate: memo — light refused: …`")
    li.add_argument("--why", help="--write: what put it on the light path (`the owner: --light`, `session: check passed`)")
    li.add_argument("--review", choices=LIGHT_REVIEWS, help="--plan, --write: reviewer-high's verdict on the doc; only light-ok goes on (light D3)")
    li.add_argument("--session", help="--write: the session whose transcript holds the answers (default $CLAUDE_CODE_SESSION_ID)")
    lk = sub.add_parser("lookout", help="crosstalk S3: one pass over the docs with open items — Saves, GitHub answers, comments → hail the session")
    lk.add_argument("--dry-run", action="store_true", help="say what each event would get; take in, hail, write nothing (the rooms are drained into the pins)")
    lk.add_argument("--if-due", action="store_true", help="nothing unless armed and %d min since the last pass (bin/ask poll's call)" % (LOOKOUT_EVERY // 60))
    lg_ = lk.add_mutually_exclusive_group()
    lg_.add_argument("--arm", action="store_true", help="let a pass act (hail, take Saves in, start runs); ships disarmed. "
                     "Any Save may start a run: a shared course page lets its viewers start runs")
    lg_.add_argument("--disarm", action="store_true")
    lg_.add_argument("--status", action="store_true", help="armed?, the last pass, the week's acts, the open cards")
    lk.add_argument("--json", action="store_true", help="--status as one JSON object (armed, last_pass, week, cards): helm's board reads it")
    lk.add_argument("--start", metavar="REQUEST", help=argparse.SUPPRESS)   # a pass's detached start (lookout_spawn)
    ci = sub.add_parser("checkin", help="crosstalk S3: the crew's mark on the Status line — `crew: <who> since <date>`, --done when finished")
    ci.add_argument("memo")
    ci.add_argument("--done", action="store_true")
    ci.add_argument("--who", help="the name the mark carries (default: session <id[:8]>, else $USER)")
    ci.add_argument("--date", help="default today")
    m = sub.add_parser("merge", help="--form: write the page's answers back into the memo")
    m.add_argument("memo")
    m.add_argument("answers", help="JSON from the page's store (or the copied text); - for stdin")
    m.add_argument("--write", action="store_true", help="rewrite the memo in place (default: print it)")
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["sheep"] and argv[1:2] != ["-h"] and argv[1:2] != ["--help"]:
        try:  # its own argument shapes (`--hook` leads), which REMAINDER would refuse
            return sheep_main(argv[1:])
        except Stop as e:
            print("memo: %s" % e, file=sys.stderr)
            return 1
    a = ap.parse_args(argv)
    try:
        if a.cmd == "list":
            rows = list_memos(a.root, a.limit)
            if a.json:
                print(json.dumps(rows, ensure_ascii=False, indent=1))
            elif not rows:
                print("no memos with decisions under %s" % a.root)
            else:
                # R35: a stood doc under its own header, never among the ones the owner reviewed
                # …but a part-stood doc (items still the owner's) stays among the live ones (review 2026-10-16)
                stood = [r for r in rows if ", stood" in (r.get("review") or "") and not r["open"]]
                live = [r for r in rows if r not in stood]
                w = max([14] + [len(short_repo(r["repo"])) for r in rows])
                for k, r in enumerate(live + stood, 1):
                    if stood and r is stood[0]:
                        print("    — stood: the deadline answered these, not %s —" % WHO)
                    print("%2d  %s  %-*s %s%s  (%d decision%s, %d unanswered)%s\n    %s" % (
                        k, r["modified"], w, short_repo(r["repo"]), "↳ " if r.get("set") else "", r["title"], r["decisions"],
                        "" if r["decisions"] == 1 else "s", r["open"],
                        " · " + r["review"] if r.get("review") else "", r["path"]))
                if any(r.get("review") for r in rows):
                    print(REVIEW_LEGEND)
            return 0
        if a.cmd == "open":
            rows = open_memos(a.root)
            if a.json:
                print(json.dumps(rows, ensure_ascii=False, indent=1))
            elif not rows:
                print("nothing open under %s" % a.root)
            else:
                w = max([14] + [len(short_repo(r["repo"])) for r in rows])
                for k, r in enumerate(rows, 1):
                    print("%2d  %-11s %s  %-*s %s%s — %s\n    %s" % (
                        k, r["kind"], r["modified"][:10], w, short_repo(r["repo"]), "↳ " if r.get("set") else "",
                        r["title"], r["what"], r["path"]))
                print(OPEN_LEGEND)
            return 0
        if a.cmd == "embark":
            rows = embark_list(a.root, a.hours)
            if a.json:
                print(json.dumps(rows, ensure_ascii=False, indent=1))
            else:
                embark_print(rows, a.hours)
            return 0
        if a.cmd in ("line", "url"):
            return line(a.memo)
        if a.cmd == "link":
            return link(a.memo)
        if a.cmd == "pull":
            return pull(a.memo)
        if a.cmd == "sheep":
            return sheep_main(a.args)
        if a.cmd == "serve":
            return serve(a.memo, port=a.port, once=not a.keep, idle=a.idle)
        if a.cmd == "status":
            if a.stamp:
                keel_stamp(a.memo)  # the Keel's derived line first: the review stamp below reads the same file
                return stamp(a.memo)
            try:
                res = stand_status(a.memo, fetch_first=not a.no_fetch)
            except Stop:
                if not a.json:  # no verdict, but the review status still reads (the launcher's --json is unchanged)
                    try:
                        rv, _, rel = review_of_file(a.memo)
                        if rv:
                            print("%s: no verdict · review: %s" % (rel, review_phrase(rv)))
                    except Stop:
                        pass
                    for k in keel_summary(a.memo):
                        print(k)
                raise
            res.pop("_open", None)
            if a.json:
                ks = keel_summary(a.memo)
                if ks:
                    res["keel"] = ks
                print(json.dumps(res, ensure_ascii=False))
            else:
                print(status_line(res))
                for k in keel_summary(a.memo):
                    print(k)
            return 0
        if a.cmd == "yolo":
            return yolo(a.memo, dry=a.dry_run, today=a.date, dnd=a.dnd)
        if a.cmd == "light":
            if a.check:
                return light_cmd_check(a.memo, record=a.record)
            if a.plan:
                light_review(a.review)
                text = Path(a.memo).read_text()
                why = light_check(text)
                if why:
                    for w in why:
                        print("%s: not light — %s" % (Path(a.memo).name, w), file=sys.stderr)
                    return 1
                print(json.dumps({"doc": str(Path(a.memo).resolve()), "calls": light_plan(text)}, ensure_ascii=False, indent=1))
                return 0
            if not a.why:
                raise Stop("light --write: --why \"<what put it on the light path>\" (the Gate line's why, M2)")
            return light_write(a.memo, a.why, review=a.review, session=a.session)
        if a.cmd == "landing":
            return landing(a.where, a.base)
        if a.cmd == "lookout":
            if a.json and not a.status:
                # without --status it would run a live pass and print text (S6 review)
                raise Stop("lookout: --json goes with --status")
            if a.arm or a.disarm:
                return lookout_arm(a.arm)
            if a.start:
                return lookout_start(a.start)
            if a.status:
                return lookout_status(as_json=a.json)
            lookout(dry=a.dry_run, if_due=a.if_due)
            return 0
        if a.cmd == "checkin":
            return checkin(a.memo, done=a.done, who=a.who, today=a.date)
        if a.cmd == "step":
            old, new = keel_step(a.memo, a.step, " ".join(a.word), date=a.date, branch=a.branch, note=a.note,
                                 stamp_after=a.stamp)
            print("%s %s: status: %s%s" % (Path(a.memo).name, a.step.upper(), new,
                                           "" if old == new else " (was: %s)" % (old or "none")))
            return 0
        if a.cmd == "stand":
            if a.arm or a.disarm:
                return sweep_arm(a.arm)
            if a.sweep:
                if a.if_armed and not sweep_armed():
                    return 0
                stand_sweep(a.root, force=a.force, dry=a.dry_run)
                return 0
            if not a.memo:
                raise Stop("stand: a doc, or --sweep / --arm / --disarm")
            if a.apply:
                stand_apply(a.memo)
                return 0
            if a.void:
                return stand_void(a.memo)
            return stand(a.memo, by=a.by)
        memo = Path(a.memo)
        text = memo.read_text()
        if a.cmd == "parse":
            _, items, fb = parse(text)
            lines = text.split("\n")
            kd = keel_derive(text, memo)
            print(json.dumps({"items": [dict({k: v for k, v in it.items() if k in ("id", "title", "body", "recommended", "answer", "shape", "options", "reversible")},
                                             answered=answered(it, lines), settled=yolo_settled(it, lines),
                                             reopened=reopened(it, lines)) for it in items],
                              "steps": [{k: v for k, v in x.items() if k != "line"} for x in kd["steps"]],
                              "goals": [dict({k: v for k, v in g.items() if k != "line"}, measured=kd["measured"].get(g["id"]))
                                        for g in kd["goals"]],
                              "keel": {"word": kd["word"], "decisions": kd["decisions"], "plan": kd["plan"],
                                       "built_by": kd["built_by"], "line": kd["status"] and kd["status"]["text"],
                                       "derived": keel_line(kd) if (kd["status"] or kd["steps"]) else None},
                              "gate": gate_of(lines),
                              "feedback_line": fb}, ensure_ascii=False, indent=1))
            return 0
        if a.cmd == "lint":
            found = set_lint(memo) if a.set else [(memo, *lint(text, strict=a.strict, path=memo))]
            bad = 0
            for q, errors, warnings in found:
                q = memo if q == memo else q
                warnings = warnings + cost_warnings(q.read_text() if q != memo else text, q)
                for e in errors:
                    print("%s: %s" % (q, e))
                for w in warnings:
                    print("%s: warning: %s" % (q, w))
                if not errors and not warnings:
                    print("%s: no findings" % q)
                bad += len(errors)
            return 1 if bad else 0
        if a.cmd == "build":
            out = Path(a.out) if a.out else Path.cwd() / (memo.stem + ".form.html")
            out.write_text(build(text, memo.name))
            _, items, _ = parse(text)
            print("%s: %d decision%s → %s" % (memo.name, len(items), "" if len(items) == 1 else "s", out))
            return 0
        if a.cmd == "merge":
            src = sys.stdin.read() if a.answers == "-" else Path(a.answers)
            answers = load_answers(src)
            new_text, rep = merge(text, answers)
            summary = summarize(rep)
            if a.write:
                if new_text != text:
                    memo.write_text(new_text)
                print("%s: %s" % (memo.name, summary))
            else:
                sys.stdout.write(new_text)
                print(summary, file=sys.stderr)
            return 0
    except Stop as e:
        print("memo: %s" % e, file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
