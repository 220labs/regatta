#!/usr/bin/env python3
"""A memo's answers, travelling as commits: a form on the doc's spacesheep page (a VS Code tab through the mirror, or the phone), GitHub too.

    keel list [--root DIR] [--limit N] [--json]   # recent memos with decisions, newest first
    keel open [--root DIR] [--json]               # open post-mortems, unanswered decisions, `Status: open` docs; docs/record/ is the archive
    keel line <memo.md>                           # the hand-over line: course | github | space — file (url: the old name);
                                                  #   an entry doc: its line, then one per component of the set
    keel link <memo.md>                           # the title and decision count, then the line
    keel pull <memo.md>                           # take in commits made on GitHub; name the answers that changed
    keel build <memo.md> [-o <out.html>]          # --form: the page; publish it with capabilities {db: {}}
    keel merge <memo.md> <answers.json> [--write] # --form: answers from the page's store → the memo
    keel serve <memo.md> [--keep] [--idle S]      # the form on 127.0.0.1 where the doc has no page — a VS Code tab
    keel parse <memo.md>                          # the decisions, steps, goals and derived status, as JSON
    keel lint [--strict] <memo.md>                # a pick resting on an unverified claim, a pre-filled answer;
                                                  #   the Keel: a Status line that disagrees, a dangling after:, the caps
    keel lint --set <entry.md>                    # every file of a nested set, and each `<slug> D2` across it
    keel sheep <memo.md>                          # the spacesheep page: deploy the form there
    keel sheep pull <memo.md> [--write]           # its Saves and comments → answers, notes, feedback (preview first)
    keel sheep pull <doc|pin key> --write --plumb # the same onto the branch by plumbing — no checkout; fast-forwarded,
                                                  #   refused on a held or dirty worktree, pushed (the lookout's)
    keel sheep wait <memo.md> [--quiet S]         # the session's background shell: exit (= wake it) on a Save or new comments, taken in
    keel sheep check <memo.md>                    # is the page current, or behind by N commits
    keel sheep drain [--if-due]                   # every page of the last 14 days: Saves into their pins, opens and
                                                  #   reading heartbeats into opens.jsonl and reads.jsonl (at most every 6 h)
    keel status <memo.md> [--json] [--no-fetch]   # does it stand (D11), and did the owner look: unseen · opened · partial · reviewed (E14)
    keel status --stamp <memo.md>                 # the derived Keel Status line (the whole set's, for an entry);
                                                  #   at launch, the review status into the record's banner
    keel stand <memo.md> [--by H]                 # write the explicit `Stands:` line, H hours from now
    keel stand --apply <memo.md>                  # at the deadline: the `> **Applied.**` replies, committed
    keel stand --void <memo.md>                   # record a touch: it no longer stands
    keel stand --sweep [--root DIR] [--dry-run] [--force]   # every due doc on a claude/* worktree: stand, push (hourly)
    keel stand --arm | --disarm                   # whether bin/ask poll runs the sweep (off until the owner arms it)
    keel step <doc> S3 <word> [--date D] [--branch B] [--note N] [--stamp]   # a step's status (entry D6)
    keel landing [<dir>] [--base REF]             # exit 1 while a brief of this branch names an open step (S7)
    keel embark [--root DIR] [--hours N] [--json] # /embark's list: the open items the sweep cannot take, older than N h (72), by block reason
    keel light <doc> --check [--record]           # may the open D-items go as a chat questionnaire (light C1-C4)
    keel light <doc> --plan                       # the AskUserQuestion calls, as JSON, to make exactly as printed
    keel light <doc> --write --why "<text>" [--review light-ok] [--session ID]
                                                  # the taps, read from this session's transcript, into the doc
    keel lookout [--dry-run] [--if-due]           # one pass over the docs with open items: a Save, a GitHub answer, new
                                                  #   comments → the doc's session hailed once (15 min; crosstalk S3); none
                                                  #   live → a brief and one run on the branch (`pickup brief`, `dispatch`; S5)
    keel lookout --arm | --disarm | --status [--json]  # whether a pass acts (off until the owner arms it); the last pass, the cards, the runs
                                                  #   armed, every Save is taken in and may start a run (Saved-By records who):
                                                  #   a course page shared with people lets each of them start runs — its
                                                  #   spacesheep access is the gate (the owner on S5's item 7, 2026-10-22)
    keel checkin <doc> [--done] [--who W]         # the Status line's ` · crew: <who> since|done <date>`

The memo format is the one every digest and design doc here already uses (rules:
the overlay's rules → "How to talk"): numbered decisions `D1`, `D2`… each ending in an
`➤ Answer:` line pre-filled with the recommendation, and an optional feedback section after the
last one (`## Open feedback`, `## Feedback from <owner>`, an `Open feedback:` lead — is_feedback_marker).
No LLM, no judgement: this tool reads exactly that.

D10's shape (docs/record/jev-pipeline-2026-10-02.md, 2026-10-02 — answers written to the right of the
arrow were indistinguishable from the recommendation) is read beside the old one:

    - **D1 — Title.** Body.
      - A — one way
      - B — the other

      ➤ Recommended: B

      ➤ Answer:
      A - great idea, and a second line if the owner wants one

The Recommended line is the agent's record and nothing here rewrites it; everything from
`➤ Answer:` to the next item, heading, rule, reply quote or ➤ line is the owner's, blank lines and
all (empty = not answered yet). An item with a Recommended line is `shape: new`; without, `old`.
Options as bullets and the blank lines are 2026-10-04's form (agents/architect.md): without
them GitHub renders options, Recommended and Answer as one line. Plain `A — …` lines and no
blank lines, the form 13 open memos use, read the same.

`lint` is the mechanism for the autofinish post-mortem (docs/autofinish-design-2026-10-02.md,
"Why the first two passes went wrong", third pass on claude/laptop/2026-10-03-autofinish-gates):
twice a recommendation rested on a claim its own doc listed as not verified, and the owner nearly
said "go". Deterministic, like the rest: see `lint`'s docstring. `line` and `link` print
its findings — the check at hand-over, wherever the hook or the skill sends a session (`link`
alone did until 2026-10-05, and sessions are sent to `url` and `serve`).

GitHub, the default (2026-09-25; the owner: "give me a link on github … instead of forming the
memo"). The owner answers in GitHub's web editor on the branch the memo lives on and commits there;
`pull` brings the commit home. The answers travel as a git commit, so they survive a worktree
being removed and reach the other Mac without anything going to `main`. The checkpoint hook
pushes a turn that adds answer lines at once and makes sure the reply carries `line`'s output
(hooks/checkpoint.py, 2026-09-29) — the incident of 2026-09-28, where the other Mac
rendered for hours on pre-filled answers while the owner's real ones sat uncommitted on this one's
`main`, is what that closes.

`line` is what a reply ends with (since 2026-10-07; `url` is its old name): one line,
`[course](…) | [github](…) | [space](…) — [<file>](<absolute path>#L1)` — the doc's spacesheep page as `course` when it has D-items (a VS Code tab through the mirror;
since 2026-10-14, when memo serve's 127.0.0.1 form retired), GitHub's read view, the same page
as `space` when it has none, the file. See the
"line" section. Its GitHub part comes from `on_github`, which fetches and compares the working
file with the blob on `origin/<branch>`, because a URL to a copy GitHub lacks (or holds an older
version of) shows the owner the wrong memo without a word; the part is then left out with the fix on
stderr, exit 1 (since 2026-10-04, docs/record/memo-links-2026-10-04.md). Until 2026-10-07 `url`
printed `local:`, the edit URL (`answer:`) and `read:`. `pull` fast-forwards, or rebases the session's own later
commits on top; it never merges, and it stops on a conflict. Why `pull` matters beyond reading:
`/finish` fetches and force-pushes the curated branch, so a GitHub commit it never took in
would be overwritten (/finish step 5 takes it in and step 11 refuses to push over one).

The form, on request (`/keel --form`; 2026-09-22, retired 2026-09-25, back 2026-09-29 as
the second path): `build` renders the whole memo (a Markdown subset — headings, paragraphs,
lists, tables, quotes, code, bold, code spans, links; everything else escaped, never HTML),
each decision a card with its answer in a textarea (old shape: pre-filled with the
recommendation; new shape: empty, the Recommended line read-only above it, the options as
buttons), one feedback box, one Save, and — when any item has a Recommended line — Accept all
recommendations: every empty answer becomes `= recommended (accept all)`, then it saves (D5 of
docs/subagent-cache-2026-10-04.md; the marker tells a bulk click from a per-card take). Any paragraph, bullet, table row, heading or code block
takes a note (2026-10-03, the owner: "let me add comment at any line"): it carries `data-at`, its
source line, and `data-q`, that line's text; `merge` writes the note under the line as
`**<owner>, <date>:** …` at the block's indent, or into the feedback when the line moved.
Answers go to the artifact's store as ONE document, `answers/current` = {items: {D1: "…"},
comments: [{at, row, quote, text}], feedback: "…", savedAt}; a read-back is one `ArtifactData get`. Without
the store (opened outside claude.ai) the page keeps a browser draft and offers "Copy as text",
which `merge` also accepts. `merge` rewrites only the `➤ Answer:` lines whose text changed,
appends feedback at the end of the doc as `**<owner>, <date>:** …` (under a new `## Open
feedback` when no section follows the last item), touches nothing else, and
prints what changed; without `--write` the new memo goes to stdout.

What counts as a decision (the shapes found in the repos on 2026-09-22):

    - **D1 — Title.** Body on the same line, more below.
      ➤ Answer: yes.
    **D2 — Title?** Body…
    ➤ Answer: yes, from the first push.
    D3 — **Title.** ➤ Answer: own script.
    **D4. Title.** Body…

i.e. an optional list marker, optional `**`, `D<n>`, a separator (— – - . :), the title up to
the closing `**` (or the end of the line), body until the `➤ Answer:` line, and the answer
(plus its continuation lines, up to a blank line or a `>` quote — the `> **Done.**` reply is
not the answer). A `.` or `:` separator needs the opening `**`, and a title must follow: a
wrapped sentence that starts a line with "D2." is prose, and so is a range "D5–D8". One id twice is an error naming both
lines. An item with no `➤` line still counts; `merge` inserts the line. Fenced code is skipped.

Recommendations stand (D11-A of docs/autofinish-design-2026-10-02.md, built as its E10): an
unanswered doc's `➤ Recommended:` picks become its answers 24 h after the link, unless the owner
touched it meanwhile — `status` computes that, `stand --apply` writes it. See `stand_status`.

The unattended one-pass run (E12, `dispatch --yolo`): `yolo` answers every open item with a bare
pick, `Reversible: no` included, with `Taken unattended (<owner>'s yolo, <date>): <pick>`, or stops at
the first without one and writes nothing; `yolo --dnd` takes the same picks bar the held classes and
leaves those for a relay (skipper-modes D1, 2026-10-21). See `yolo`.

The chat questionnaire (docs/light-gate-2026-10-16.md, built as its B1): `light --check` says whether a
doc's open items fit one or two AskUserQuestion calls, `--plan` prints the calls, `--write` copies the
taps from the session's own transcript as `Taken in chat (<owner>, <ts>): <letter> — <label>` and one
`Gate: light — …` line. See the "light" section.

The Keel (docs/design-docs-layer-2026-10-14.md, built as entry S1 on 2026-10-15): a Course doc's
steps (`- **S3 — …** · session `tier` · after: S1, D2 · status: …` in its Action plan), goals (`| G2 —
… |` rows, `> **Measured, <date>:** G2 = …` under them) and one `Status:` line near the top that
`status --stamp` derives — proposed · answered · building · blocked · built · measured · superseded —
and `lint` checks. A `> **Reopened.**` reply under an item makes it open again. A nested set (entry
`docs/<topic>-<date>.md`, components `docs/<topic>-<component>-<date>.md` it links) is read together:
`list` and `open` show it as the entry and its components, `line` prints a line per file. See
the "the Keel" section.

Did the owner look at it (E14 of the same doc): `status` also prints the review status — `unseen ·
opened · partial · reviewed`, with `stood`, `waits` or `stands <time>` beside it — from the form's
opens (each load of the page emits `memo-open`; `sheep pull`, `sheep wait` and `sheep drain`
drain it into ~/.local/state/memo/opens.jsonl), the owner's answers and notes, and
the doc's own commits; `list` shows it per doc, hooks/branches.py per branch, and `status --stamp`
writes it into the record's banner at launch, where bin/docs-index carries it into the map. See
`review_status`.

Renamed from memo-form on 2026-09-29 (docs/feedback-2026-09-29.md, D1; `/feedback` turned out to be Claude Code's own command, so `memo`). Stdlib only,
Python 3.9. The page is self-contained: no fonts, no CDN; one library, Mermaid, pinned by version and
sha256, fetched once into the cache (vendor/mermaid/README.md) and inlined only into a page whose doc
draws a diagram (entry S13, 2026-10-15; fetched, not vendored, since 2026-10-23).
"""
import argparse
import datetime as dt
import html
import json
import os
import posixpath
import re
import shlex
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote


# ---- private values: through the regatta config dir, never literals (the scrub, 2026-10-22) ------
# Read here without the core, as the core's config_read does (first non-blank lines, a BOM dropped):
# these regexes are built at import, and an importer without the core (plumb's bench) must still load.
def _config_lines(name):
    cfg = Path(os.environ.get("REGATTA_CONFIG") or Path.home() / ".config" / "regatta").expanduser()
    try:
        text = (cfg / name).read_text(encoding="utf-8-sig")
    except (OSError, UnicodeDecodeError):
        return None
    return [l.strip() for l in text.splitlines() if l.strip()]


# The owner: the name answers, notes and replies are signed with (`**<owner>, <date>:**`), as the
# core's `regatta/owner` holds it; `Owner` without one. Docs written before a rename keep the old
# name and read as the agent's: the key is set once, at install.
OWNER = (_config_lines("regatta/owner") or ["Owner"])[0]
OWNER_RE = "(?:%s)" % re.escape(OWNER)
# Who the messages name: the owner by name where the key is set (the text the Macs always read),
# else "the owner"; WHOSE its possessive.
WHO = (_config_lines("regatta/owner") or ["the owner"])[0]
WHOSE = WHO + "'s"


def tool_cmd(name):
    """How a message names a peer tool: the module's file under `~` (tool()), else the bare name.
    Since B14b (2026-10-23) the overlay keeps no copy, and the account dirs' allow rules name the
    module paths (the overlay's bootstrap.sh --hooks)."""
    try:
        p = _common().tool(name)
    except ImportError:
        p = None
    return tilde(p) if p else name


def tilde(p):
    """`p` under `~` when it is inside the home folder — $HOME's, or the login's own when a caller
    (a suite) moved HOME — else as it is."""
    import pwd
    s = str(p)
    for home in (str(Path.home()), pwd.getpwuid(os.getuid()).pw_dir):
        if home and s.startswith(home.rstrip("/") + "/"):
            return "~" + s[len(home.rstrip("/")):]
    return s

ANSWER = "➤ Answer:"
RECOMMENDED = "➤ Recommended:"
REC_LINE_RE = re.compile(r"^\s*(?:(?:[-*]|\d+\.)\s+)?" + re.escape(RECOMMENDED))
# multiple choice, D10's shape: `A — …`, `B — …` on their own lines, capitals, no parentheses.
# Since 2026-10-04 written as bullets, `- A — …`: plain lines inside a list item join the line
# above when GitHub renders the file, so `A — … B — … ➤ Recommended: A` read as one run-on line
# (the owner: "options should all start at next lines, otherwise hard to see"). Both are read.
OPTION_RE = re.compile(r"^\s*(?:[-*]\s+)?\*{0,2}([A-Z])\*{0,2}\s*[—–-]\s+(\S.*)$")
BULLET_RE = re.compile(r"^\s*[-*]\s+")
ITEM_RE = re.compile(r"^(?P<indent>\s*)(?P<marker>(?:[-*]|\d+\.)\s+)?(?P<bold>\*{0,2})D(?P<n>\d+)\*{0,2}\s*(?P<sep>[—–\-.:])\s*(?P<rest>.*)$")
HEADING_RE = re.compile(r"^(#{1,6})\s+(.*)$")
# The feedback marker starts a line, never sits inside one. A prose line ("a line in Open feedback
# reopens any", 220-film's docs/daily-build-2026-10-09.md before its fix) above the D-items became the
# marker, page_parts() cut the form before every item, and nothing warned (2026-10-09; the owner: "second
# time I see this issue today"). Two shapes, both from the repos (sweep of 2026-10-10):
# - a heading that opens with "Open feedback" or "Feedback from the owner" — numbered (`## 12. Open
#   feedback`), bold, closed (`## Open feedback ##`), qualified (`## Open feedback (the owner)`). Aurora's
#   dreams, /embark and sextant write the second (the vault's dreams/2026-10-07.md: 12 D-items under
#   it); without it a Save appended a second `## Open feedback`. A bare `## Feedback` is not one:
#   a project's 13-working-with-humans.md has a content section by that name;
# - a lead at column 0: `**Open feedback.** Anything the decisions miss goes here.`, `_Open
#   feedback_`, `Open feedback:` (with or without text after the colon), a bare `Open feedback`, or the
#   template's "Open feedback goes below this line." (docs/record/usage-report-2026-09-22.md).
# Column 0, or a heading's up to three spaces (CommonMark): an indented line is an item's body or a
# 4-space code block, never the marker (review, 2026-10-09). Fenced lines are the callers' to skip.
FEEDBACK_HEAD_RE = re.compile(r"^ {0,3}#{1,6}\s+(?:\d+(?:\.\d+)*\.?\s+)?[*_]*(?:open feedback|feedback from (?:%s|the owner))\b" % OWNER_RE, re.I)  # "the owner": plumb's bench sheets
_FB = r"open feedback(?: goes below this line)?"
FEEDBACK_LEAD_RE = re.compile(r"^(?:(\*\*|__|\*|_)%s[.:]?\1[.:]?(?:\s|$)|%s(?:[.:]?\s*$|:\s))" % (_FB, _FB), re.I)
# a quoted line is the memo's reply (`> **Done.** …`), never a decision's text or the feedback marker;
# `> the owner (date): …` is the older way an answer was written under the recommendation (agent-git-identity)
REPLY_RE = re.compile(r"^\s*>(?!\s*%s\b)" % OWNER_RE)
OPENS_FEEDBACK_RE = re.compile(r"^[*_]*open feedback", re.I)  # block_stop only, on the stripped line
STOP_RE = re.compile(r"^(#{1,6}\s|---\s*$)")
# E12 of docs/autofinish-design-2026-10-02.md: an architect marks each D-item `Reversible: yes|no`
# above its Recommended line (agents/architect.md); `yolo` takes only a `yes` item's pick unattended.
# `Reversible: yes`, `**Reversible:** no — deletes the table`, `- *Reversible*: yes.` A `yes` must stand
# alone (`yes, as long as …` is a hedge: unmarked, so memo yolo stops); a `no` may carry its reason
REVERSIBLE_RE = re.compile(r"^\s*(?:[-*]\s+)?[*_]*Reversible[*_]*\s*:[*_]*\s*[*_]*(yes|no)\b(.*)$", re.I)
YOLO_ANSWER = "Taken unattended (" + OWNER.replace("%", "%%") + "'s yolo, %s): %s"
DND_ANSWER = "Taken unattended (" + OWNER.replace("%", "%%") + "'s dnd, %s): %s"   # `keel yolo --dnd`'s (skipper-modes S2)
# keel yolo's pick, under --yolo or --dnd (skipper-modes S2): never the owner's. bin/dispatch's launch gate
# and the finish skill read the same two words through `keel parse`'s settled and taken.
YOLO_ANSWER_RE = re.compile(r"^\s*Taken unattended \(%s's (?:yolo|dnd), " % OWNER_RE)
# light B1 (docs/light-gate-2026-10-16.md L4): a tap in an AskUserQuestion questionnaire, copied from the
# session's transcript by `keel light --write`, never typed. The owner's own answer, so not taken_answer().
CHAT_ANSWER = "Taken in chat (" + OWNER.replace("%", "%%") + ", %s): %s"
CHAT_ANSWER_RE = re.compile(r"^\s*Taken in chat \(%s, " % OWNER_RE)
# the doc's gate (light M1-M2): one line, `Gate: light — …` written by `keel light --write`, `Gate: memo —
# light refused: …` by `--check --record`; the corpus reads the mode from it
GATE_RE = re.compile(r"^Gate:\s*(?P<mode>light|memo|yolo|stood|relayed)\b\s*(?:—\s*(?P<tail>.*))?$")
# bin/ask answer's line, RELAYED_ANSWER `Relayed from <who> (<source>, <date>): <text>`, with a source
# that is not one of the owner's routes (`yes item`, `manager`, a pick): a relay a manager answered, never
# the owner's word, so it is taken like a yolo pick and rule D never launches the doc (stray-manager B1 iii;
# session-listen L7). `(the owner's form, …)`, `(the owner, Session tab (signed), …)` are the owner's answer carried,
# and stay answers. The test is asklib's relayed_by_owner (taken_answer), bin/ask's too, and it fails closed: a
# `Relayed from` line it cannot read as the owner's is taken (review gate, 2026-10-16 — this file's own
# pattern read `Relayed from manager (the build Mac) (yes item, …)` as the owner's answer).
_ASKLIB = []


def _asklib():
    """asklib.py as a module, loaded once (stdlib only): the relay test lives there. It is helm's
    (regatta-modules G33), found through the core's tool(); None when helm is not here."""
    if not _ASKLIB:
        p = _common().tool("asklib.py")
        if p:
            from importlib.machinery import SourceFileLoader
            p = SourceFileLoader("asklib", str(p)).load_module()
        _ASKLIB.append(p)
    return _ASKLIB[0]


_HELMLIB = []


def _helmlib():
    """helm's helmlib.py as a module, loaded once: a sent task's mode lives there (skipper-modes S1).
    None when helm is not here — then no branch has a mode, and the sweep stands as before."""
    if not _HELMLIB:
        p = _common().tool("helmlib.py")
        try:
            if p:
                from importlib.machinery import SourceFileLoader
                p = SourceFileLoader("helmlib", str(p)).load_module()
        except Exception:  # a helm mid-edit must not take the sweep down
            p = None
        _HELMLIB.append(p)
    return _HELMLIB[0]


def branch_in_ask_mode(branch, repo=None):
    """skipper-modes S1: the branch's sent task is in mode `ask` — nothing answers it but the owner, so the
    stand sweep leaves its docs alone. The mode as helmlib.branch_mode reads it (plan.json first)."""
    lib = _helmlib()
    if lib is None:
        return None
    try:
        mode, where = lib.branch_mode(branch, repo)
    except Exception:
        return None
    return where if mode == "ask" else None


def branch_mode(branch, repo=None):
    """(mode, where) of the branch's sent task (helmlib.branch_mode), or (None, why): no helm, no task."""
    lib = _helmlib()
    if lib is None:
        return None, "helm is not installed here"
    try:
        return lib.branch_mode(branch, repo)
    except Exception as e:  # noqa: BLE001 — unreadable is no mode
        return None, "the mode is unreadable (%s)" % type(e).__name__


def taken_lands(taken_by, mode):
    """skipper-modes S3b, the landing ladder for a doc whose answers were taken unattended: whether
    the branch lands by itself under its mode now — `yolo` lands any pick, `dnd` lands the picks taken
    under dnd (a yolo pick had no holds), every other mode none (yolo-veto D1, kept for default and
    ask). The mode is read now, not the record line: a ship lowered mid-flight holds its branch."""
    if mode == "yolo":
        return True
    return mode == "dnd" and "yolo" not in taken_by


def taken_answer(ans):
    """An answer somebody other than the owner took: memo yolo's pick or a relayed one whose source is not
    the owner's. Without helm's asklib only the yolo pick is told apart: a relayed answer reads as
    the owner's own, as before relays existed (G33)."""
    if YOLO_ANSWER_RE.match(ans or ""):
        return True
    lib = _asklib()
    if lib is None:
        return False
    # helm's scrub names it relayed_by_owner; until both land, whichever relayed_by_* asklib has
    fn = getattr(lib, "relayed_by_owner", None) or next(
        (getattr(lib, n) for n in sorted(dir(lib)) if n.startswith("relayed_by_")), None)
    return fn is not None and fn(ans or "") is False


def reversible_mark(m):
    """'yes', 'no' or None (unmarked) from a REVERSIBLE_RE match."""
    if not m:
        return None
    word, rest = m.group(1).lower(), m.group(2).strip().strip("*_.").strip()
    return None if word == "yes" and rest else word
GITHUB_RE = re.compile(r"^(?:git@github\.com:|ssh://git@github\.com/|https://github\.com/)([^/]+/[^/]+?)(?:\.git)?/?$")
# The knowledge repos: atlas's two keys, `<name> <checkout> <variable>` each (the overlay's first
# item); absent, none — no repo gets knowledge-commit's hint or the always-loaded rules/ refusal.
KNOWLEDGE = tuple(v[0] for v in (_config_lines("atlas/layer"), _config_lines("atlas/vault")) if v)
LAYER = (_config_lines("atlas/layer") or [""])[0]


# ----------------------------------------------------------------------------- parsing

def item_match(line):
    """ITEM_RE, minus the prose it would otherwise take. A wrapped sentence can start a line with
    "D2." (a memo in another repo, 2026-09-30: a phantom D2 ahead of the real one
    took the form's D2 key, and the owner's saved D2 came back empty). Every real "." or ":" decision
    in the repos opens with `**`; none is untitled."""
    m = ITEM_RE.match(line)
    if not m:
        return None
    if m.group("sep") in ".:" and m.group("bold") != "**":
        return None
    if not m.group("rest").strip("* \t"):
        return None
    if m.group("sep") in "–-" and re.match(r"D\d", m.group("rest")):
        return None  # "D5–D8 are still open": a range (household storage-cleanup), not D5
    after = line[m.end("sep"):m.end("sep") + 1]
    if m.group("sep") in "–-" and after and not after.isspace() and re.match(r"[A-Z]\b", m.group("rest")):
        return None  # "D3-C). Design: …", "D31-B, …": a reference to option C of D3, not a D-item (the overlay's AGENTS.md, 2026-10-10)
    return m


# one pre-filter for "might hold D-items", built from ITEM_RE so it can never drift from it
ITEM_ANY_RE = re.compile(ITEM_RE.pattern, re.M)


def maybe_memo(text):
    return ANSWER in text or bool(ITEM_ANY_RE.search(text))


def split_title(rest):
    """`Title.** Body` → (Title., Body); `**Title.** Body` → same; no `**` → (rest, '')."""
    r = rest
    if r.startswith("**"):
        r = r[2:]
    i = r.find("**")
    if i < 0:
        return r.strip(), ""
    return r[:i].strip(), r[i + 2:].strip()


def _common():
    """The regatta core's common.py: the one fence rule, shared with the checkpoint and branch hooks
    (the same loader as paste-paths'), and tool() for every peer (lib/find_core.py: the checkout this module sits in, else the config dir's `home`, else the plugin's installPath; never a copy). No core is an ImportError the callers' own guards take."""
    # Loaded once: fence_mark and scan() call this per line, and find_core reads the home file
    # and installed_plugins.json each time (1,521 lookups in one `keel open`, review of B4).
    if "common" in sys.modules:
        return sys.modules["common"]
    lib = str(Path(__file__).resolve().parent.parent / "lib")
    if lib not in sys.path:
        sys.path.insert(0, lib)
    import find_core
    try:
        hooks = find_core.hooks()
    except SystemExit:
        raise ImportError("keel: the regatta core is missing")
    if hooks not in sys.path:
        sys.path.insert(0, hooks)
    import common
    return common


def fence_mark(line):
    """The fence string when the line could open or close a fenced block (``` or ~~~, three or
    more: a ~~~-fenced example D-item is an example, not a decision — review, 2026-10-04), else
    None (every closer could also open). Which line closes which block is `fenced`'s call."""
    return _common().fence_opener(line)


def fenced(lines):
    """For each line: inside a fenced block, its own fence lines included — hooks/common.py's
    rule: a fence closes on the same character, at least as long as its opener (CommonMark)."""
    return _common().fenced(lines)


def split_answer(line):
    """(before, after) the `➤ Answer:` marker, or None. A marker inside a code span is prose: the
    third autofinish pass's D11 said "memos waiting on pre-filled `➤ Answer:` lines" on its item
    line, and its first ten words became its answer, its Recommended line unread (2026-10-04)."""
    masked = re.sub(r"`[^`]*`", lambda m: "\x00" * len(m.group(0)), line)
    i = masked.find(ANSWER)
    return None if i < 0 else (line[:i], line[i + len(ANSWER):])


def is_feedback_marker(line):
    """A line that opens a feedback section (FEEDBACK_HEAD_RE or FEEDBACK_LEAD_RE). Anchored at the
    line's start, so a reply quote (`>`), an item line (`- **D1`) and a legend that mentions the
    section ("`➤ Answer:` … Open feedback") can never be one: no further guard is needed. Every
    place that finds the section or ends a block at it — feedback_markers, an item's body in
    parse, block_stop, the old shape's answer continuation — asks this one predicate (block_stop
    also stops at a looser line; see there)."""
    return bool(FEEDBACK_HEAD_RE.match(line) or FEEDBACK_LEAD_RE.match(line))


def feedback_markers(lines, fence):
    """Every line outside fenced code that opens a feedback section, in order."""
    return [k for k, l in enumerate(lines) if not fence[k] and is_feedback_marker(l)]


def feedback_section(markers, items):
    """The feedback section's line: the first marker after the last D-item, else None.

    Every item is a decision the form shows, wherever it sits; only this line is chosen. Until
    2026-10-10 the first marker anywhere was the section, and page_parts, serve's Save and lint
    each dropped the items after it — so a marker above the D-list (or a mention taken for one)
    emptied the form while parse and lint looked fine. A marker with items under it — a reply
    thread's proposals after the owner's feedback (household's history-2026-09-23, D13-D18) — is
    prose on the page, and a Save's feedback opens a new section at the end, under all of them."""
    last = items[-1]["end"] if items else 0
    return next((k for k in markers if k >= last), None)


def is_rec(line):
    """A `➤ Recommended:` line — at the line's start, so prose that mentions one is still prose."""
    return bool(REC_LINE_RE.match(line))


def block_stop(line):
    """Where a D10 answer block (and a wrapped Recommended line) ends: the next item, a heading or
    rule, a reply quote, another ➤ line, or a line that opens the feedback section — a lead with
    text after it too (`**Open feedback.** Anything the decisions miss goes here.`), which
    otherwise became the last item's answer: answered, taken by `dispatch --yolo` and `stand
    --apply`, and deleted by a form Save (review, 2026-10-09). Only an item line written
    the way agents write one (`- **D2 —` or `**D2 —`) counts: an answer that says "D2 — same as
    here" is the owner's words, not a phantom D2 (review, 2026-10-03). Nothing else ends it, so a
    D-list in this shape ends with a heading or `---` before any further prose.

    Looser than the marker on purpose: any line opening with "Open feedback", indented or not, with
    any text after it (`Open feedback (anything else):`, `Open feedback — …`) ends the block, as it
    did before 2026-10-10. Ending an answer early leaves an item open, which is safe; swallowing a
    feedback line makes it answered (review, 2026-10-10)."""
    s = line.strip()
    m = item_match(line)
    return bool((m and (m.group("bold") == "**" or m.group("marker"))) or STOP_RE.match(s) or REPLY_RE.match(line)
                or split_answer(line) is not None or is_rec(line) or fence_mark(line) or is_feedback_marker(line)
                or OPENS_FEEDBACK_RE.match(s))


def block_text(first, rest):
    """An answer block as the owner wrote it: the common indent off, blank lines at either end dropped."""
    ind = min((len(l) - len(l.lstrip()) for l in rest if l.strip()), default=0)
    out = ([first.strip()] if first.strip() else []) + [l[ind:].rstrip() for l in rest]
    while out and not out[0]:
        out.pop(0)
    while out and not out[-1]:
        out.pop()
    return "\n".join(out)


def between(it, lines):
    """Lines after the Recommended line and before `➤ Answer:` (options, a "why") — the card shows them."""
    if it.get("rec_end") is None or it.get("answer_line") is None:
        return []
    return lines[it["rec_end"]:it["answer_line"]]


def option_run(lines, i):
    """([(letter, text, first line, last line)], end) for the options starting at lines[i]: A, B,
    C… in order, two at least — else ([], i). One line that happens to start "I — " is prose, not a choice. An
    option may wrap: a plain line indented deeper than its own, under it, continues it (one
    wrapped option dropped all of an item's options until 2026-10-05, memo-lint-fixes)."""
    out, j = [], i
    while j < len(lines):
        m = OPTION_RE.match(lines[j])
        if not m or m.group(1) != chr(ord("A") + len(out)):
            break
        at, text, ind = j, m.group(2).strip(), len(lines[j]) - len(lines[j].lstrip())
        j += 1
        sub = False  # past a sub-list or table under the option: still the option's, not its text
        while j < len(lines) and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > ind \
                and not OPTION_RE.match(lines[j]) and not block_stop(lines[j]):
            sub = sub or bool(LIST_ITEM_RE.match(lines[j]) or lines[j].lstrip().startswith("|"))
            if not sub:
                text += " " + lines[j].strip()
            j += 1
        out.append((m.group(1), text, at, j - 1))
    return (out, j) if len(out) >= 2 else ([], i)


def options_at(lines, i):
    """The options starting at lines[i] as [(letter, text)] — else []."""
    return [(o[0], o[1]) for o in option_run(lines, i)[0]]


def parse(text):
    """Return (lines, items, feedback_line). Each item: dict with line ranges for merge."""
    lines = text.split("\n")
    items = []
    # Fences read once for the whole doc, not as the loop walks: an item's end can skip past a
    # fence's opener, and then its example D-item became a phantom (memo-lint-fixes, 2026-10-05)
    fence = fenced(lines)
    i = 0
    while i < len(lines):
        line = lines[i]
        if fence[i]:
            i += 1
            continue
        m = item_match(line)
        if not m:
            i += 1
            continue
        title, inline = split_title(m.group("rest"))
        item = {"id": "D" + m.group("n"), "n": int(m.group("n")), "title": title, "start": i,
                "marker": bool(m.group("marker")), "indent": m.group("indent"),
                "content": len(m.group("indent")) + len(m.group("marker") or "")}
        body = []
        answer = recommended = None
        answer_line = rec_line = answer_end = rec_end = body_end = None
        cut = split_answer(inline)
        if cut is not None:
            head, tail = cut
            if head.strip():
                body.append(head.strip())
            answer = tail.strip()
            answer_line = i
            answer_end = i + 1
            body_end = i + 1
        elif inline:
            body.append(inline)
        j = i + 1
        while j < len(lines) and answer_line is None:
            l = lines[j]
            s = l.strip()
            if fence[j]:
                break
            here = split_answer(l)
            if item_match(l) or STOP_RE.match(s) or is_feedback_marker(l):
                break
            if is_rec(l) and recommended is None and here is None:
                # D10's shape: the agent's pick on its own line, the record of what it recommended
                recommended = l.split(RECOMMENDED, 1)[1].strip()
                rec_line = j
                body_end = j
                k = j + 1
                while k < len(lines) and lines[k].strip() and not block_stop(lines[k]) and not options_at(lines, k):
                    recommended += " " + lines[k].strip()
                    k += 1
                rec_end = j = k
                continue
            if here is not None:
                answer_line = j
                if body_end is None:
                    body_end = j
                tail = here[1]
                k = j + 1
                if recommended is not None:
                    # D10: everything under `➤ Answer:` up to the next item is the owner's, blank lines and
                    # all — the box starts empty, so any text in it is the owner's by construction
                    while k < len(lines) and not block_stop(lines[k]):
                        k += 1
                    answer = block_text(tail, lines[j + 1:k])
                else:
                    answer = tail.strip()
                    # the answer ends at a blank line or a reply: `> **Done.** …` answers it, it is not part
                    # of it. A plain line under an answer on its own ➤ line is the owner's (a note typed on GitHub);
                    # under an inline answer it is not read as one. A fence ends it: `➤ Answer: yes`
                    # with a fenced example right under it swallowed the opener (memo-lint-fixes), and the
                    # feedback section does: right under `➤ Answer: yes` it became the answer, and a
                    # Save rewrote the line without it (review, 2026-10-09).
                    while k < len(lines) and lines[k].strip() and not fence[k] and not REPLY_RE.match(lines[k]) \
                            and not item_match(lines[k]) and not is_feedback_marker(lines[k]) \
                            and not STOP_RE.match(lines[k].strip()) and split_answer(lines[k]) is None:
                        answer += " " + lines[k].strip()
                        k += 1
                answer_end = k
                break
            if recommended is None:
                body.append(s)
            j += 1
        # trailing blank lines are not body
        inline_lines = 1 if (inline and cut is None) or (cut is not None and cut[0].strip()) else 0
        while body and not body[-1]:
            body.pop()
        item["body"] = "\n".join(body)
        item["answer"] = answer
        item["answer_line"] = answer_line
        item["answer_end"] = answer_end
        item["recommended"] = recommended
        item["rec_line"] = rec_line
        item["rec_end"] = rec_end
        item["shape"] = "new" if recommended is not None else "old"
        item["inline"] = cut[0].strip() if cut is not None else inline
        # end = first line after the item; without an answer line that is the last body line + 1
        if answer_end is not None:
            item["end"] = answer_end
        elif rec_end is not None:
            item["end"] = rec_end
        else:
            item["end"] = i + 1 + (len(body) - inline_lines)
        item["body_end"] = body_end if body_end is not None else item["end"]
        raw = lines[i + 1:item["body_end"]] + between(item, lines)
        at, item["options"] = next(((k, o) for k, o in ((k, options_at(raw, k)) for k in range(len(raw))) if o), (None, []))
        # `lint` warns on the old, unbulleted options (they render as one run-on line)
        item["options_bulleted"] = at is not None and bool(BULLET_RE.match(raw[at]))
        # the agent's lines only — up to the answer, never the owner's box below it; the first mark counts
        own_end = answer_line if answer_line is not None else item["end"]
        marks = [REVERSIBLE_RE.match(lines[k]) for k in range(i + 1, own_end) if not fence[k]]
        item["reversible"] = next((reversible_mark(m) for m in marks if m), None)
        items.append(item)
        i = item["end"]
    seen = {}
    for it in items:
        if it["id"] in seen:
            # one id twice is a collision every consumer keys on: the form, merge, pull
            raise Stop("%s appears twice, at lines %d and %d — renumber or reword one"
                       % (it["id"], seen[it["id"]] + 1, it["start"] + 1))
        seen[it["id"]] = it["start"]
    return lines, items, feedback_section(feedback_markers(lines, fence), items)


# ----------------------------------------------------------------------------- lint

# Where a doc lists its unchecked claims: a heading (`## 13. Not verified`, "Not yet verified",
# "What is not verified"), or a lead — bold or italic, alone or as a bullet (`**Not verified.**`,
# `- **Not verified:**`, `*Not verified.*`) or a plain line `Not verified: …`. The forms
# agents/architect.md asks for, both autofinish passes used, and the review found (2026-10-04).
NV = r"(?:not (?:yet )?verified|unverified)\b"
# A heading may wrap it in bold and lead with one of a few words: `## **Not verified**`, `## Claims
# not verified`, `## What is not verified` (memo-lint-fixes, 2026-10-05). A named list, not "any
# three words": `## Verified and not verified` lists verified claims too (code-review, same day).
NV_HEADING_RE = re.compile(r"^(?:\d+(?:\.\d+)*\.?\s+)?[*_]*(?:(?:what is|what's|what was|still|claims?|"
                           r"assumptions?|items?|facts?)\s+)?" + NV, re.I)
NV_LEAD_RE = re.compile(r"^\s*(?:[-*+]\s+)?(?:\*\*|\*|__|_)" + NV, re.I)
NV_PLAIN_RE = re.compile(r"^\s*(?:[-*+]\s+)?not (?:yet )?verified\s*:", re.I)
# `*(unverified)*` (or `*(unverified: not read)*`) marks the ids on its own line
NV_INLINE_RE = re.compile(r"[*_]\((?:not (?:yet )?verified|unverified)\b[^)]*\)[*_]", re.I)
# An id a doc numbers things by: R15, P4, G3. Not D<n> (the decisions themselves) and not E<n>
# (build steps: one named under Not verified is the probe that will settle a claim, which a
# conditional recommendation points to). `D11-A2` is an option, not A2. A range is written with
# no spaces, `R2–R4`, `R2-R4` or `R2–4`; "R2 - 3 runs" is not one (review, 2026-10-04).
ID_RE = re.compile(r"(?<![\w-])([A-CF-Z])(\d+)(?:[–-]\1?(\d+))?(?!\w)")
# Only an id the doc defines counts — a line, heading or table row that starts with it (`- **R2 —
# …`, `### R4 — …`, `| P4 |`, `R2: …`): Q4, L12 or S3 in passing prose are not the doc's ids.
DEF_RE = re.compile(r"^\s*(?:#{1,6}\s+|(?:[-*]|\d+\.)\s+)?(?:\|\s*)?\**([A-CF-Z]\d+)\**(?![\w])")
# Under Not verified only a definition written as one counts — bold-led, followed by a separator,
# or a table row: "- A1 path untested" is a sentence there, not A1's definition.
STRONG_DEF_RE = re.compile(r"^\s*(?:#{1,6}\s+|(?:[-*]|\d+\.)\s+)?"
                           r"(?:\*\*([A-CF-Z]\d+)\b|([A-CF-Z]\d+)\**\s*[—–:]|\|\s*\**([A-CF-Z]\d+)\**\s*\|)")
# Link targets and code spans hold paths and anchors (`#L12`), never a reference to an id.
NOT_PROSE_RE = re.compile(r"\]\([^)]*\)|`[^`]*`")
ARCHITECT_RE = re.compile(r"\bWritten by\s+`?(sr-architect|architect|sounder)`?.*?\bon (\d{4}-\d{2}-\d{2})")
# The two conditional forms agents/architect.md teaches, and only those: "A, simplest even if R15
# turns out wrong" carries an "if" and is still a bare pick (code-review, 2026-10-04), and so does
# "B, even if R15 is wrong; nothing else" — the else must name a letter (memo-lint-fixes), bold or
# as "option B", with or without a comma before it (`A if X else B`, `A if X — else **B**`).
CONDITIONAL_RE = re.compile(r"^(?i:none\s+until)\b|^[A-Z]\b.*\b(?i:if)\b.*\b(?i:else)\s+[*_]*(?:(?i:option)\s+)?[A-Z]\b")
LIST_ITEM_RE = re.compile(r"^\s*(?:[-*+]|\d+[.)])\s+")
# Docs written before the architects were told to leave `➤ Answer:` empty pre-filled it by design.
PREFILL_RULE_SINCE = "2026-10-04"


def ids_in(lines):
    out = set()
    for l, f in zip(lines, fenced(lines)):
        if f:
            continue
        for m in ID_RE.finditer(NOT_PROSE_RE.sub(" ", l)):
            lo = int(m.group(2))
            hi = int(m.group(3)) if m.group(3) and lo < int(m.group(3)) <= lo + 50 else lo
            out.update("%s%d" % (m.group(1), n) for n in range(lo, hi + 1))
    return out


def defined_ids(lines, strong=False):
    out = set()
    for l, f in zip(lines, fenced(lines)):
        if f:
            continue
        m = (STRONG_DEF_RE if strong else DEF_RE).match(l)
        if m:
            out.add(next(g for g in m.groups() if g))
    return out


def heading_at(lines, fence, k):
    """The heading match on line k, unless the line sits in a fence (`# a comment` there is code)."""
    return None if fence[k] else HEADING_RE.match(lines[k].strip())


def sections(lines, heading_test, lead_test=None, items_end=False):
    """(start, end) of each part of the doc that opens with a heading `heading_test(text)` accepts
    — to the next heading of its level or higher, or a `---` (or, with `items_end`, a D-item: a
    D-list with no heading of its own after `## Not verified` is not part of it, memo-lint-fixes,
    2026-10-05) — or, with `lead_test`, a line it
    accepts (a lead). A lead with text after it is that paragraph, or that bullet with its deeper
    lines; a lead alone on its line, or one whose text ends in a colon (`**Not verified** (background
    claims only):`), takes the list under it, past blank lines while the next
    line is still a list item and not a D-item. Fenced lines never open or end one."""
    fence = fenced(lines)
    out = []
    n = len(lines)

    def stop(k):
        return heading_at(lines, fence, k) or (not fence[k] and lines[k].strip() == "---")
    for i, l in enumerate(lines):
        if fence[i]:
            continue
        s = l.strip()
        h = heading_at(lines, fence, i)
        if h:
            if heading_test(h.group(2)):
                level = len(h.group(1))
                j = i + 1
                while j < n:
                    m = heading_at(lines, fence, j)
                    if (m and len(m.group(1)) <= level) or (not fence[j] and lines[j].strip() == "---") \
                            or (items_end and not fence[j] and item_match(lines[j])):
                        break
                    j += 1
                out.append((i, j))
            continue
        if not (lead_test and lead_test(l)):
            continue
        rest = re.sub(r"^\s*(?:[-*+]\s+)?(?:\*\*.*?\*\*|\*[^*]+\*|__.*?__|_[^_]+_|[^:]*:)", "", l).strip()
        j = i + 1
        if rest and not rest.endswith(":") and LIST_ITEM_RE.match(l):  # `- **Not verified:** R2, R3` — the bullet and its deeper lines
            ind = len(l) - len(l.lstrip())
            while j < n and lines[j].strip() and len(lines[j]) - len(lines[j].lstrip()) > ind:
                j += 1
        elif rest and not rest.endswith(":"):  # a paragraph that opens with the lead
            while j < n and lines[j].strip() and not stop(j):
                j += 1
        else:  # a lead alone on its line, or ending in a colon: the (loose) list under it
            while j < n and not lines[j].strip():
                j += 1  # the blank line between the lead and its list
            while j < n:
                if not lines[j].strip():
                    k = j
                    while k < n and not lines[k].strip():
                        k += 1
                    if k < n and not fence[k] and LIST_ITEM_RE.match(lines[k]) and not item_match(lines[k]):
                        j = k
                        continue
                    break
                if stop(j) or (not fence[j] and item_match(lines[j])):
                    break
                j += 1
        out.append((i, j))
    return out


def not_verified(lines):
    """The Not-verified parts of the doc as (start, end) ranges, plus each line with an inline
    `*(unverified)*` mark."""
    listed = sections(lines, lambda t: bool(NV_HEADING_RE.match(t)),
                      lambda l: bool(NV_LEAD_RE.match(l) or NV_PLAIN_RE.match(l)), items_end=True)
    fence = fenced(lines)
    listed += [(k, k + 1) for k, l in enumerate(lines) if not fence[k] and NV_INLINE_RE.search(l)]
    return listed


def id_key(x):
    return x[0], int(x[1:])


def replied(it, lines):
    """A `>` reply under the item (`> **Done.** …`, `> **Accepted 2026-10-03**`), before the next
    item or heading."""
    k = it["end"]
    while k < len(lines) and not item_match(lines[k]) and not STOP_RE.match(lines[k].strip()):
        if REPLY_RE.match(lines[k]):
            return True
        k += 1
    return False


def answered(it, lines):
    """the owner has spoken on this item: a new-shape answer (the owner's by construction), any old-shape
    answer text, or a `>` reply under it — unless the last reply under it is `> **Reopened.**`
    (the Keel's refusal, layer section 1): then the item is open again, whatever its box holds."""
    if reopened(it, lines):
        return False
    return bool((it["answer"] or "").strip()) or replied(it, lines)


# A session that read an answer and cannot act on it writes `> **Reopened.** <what reopens>` under the
# item (layer D2-A): open again for answered(), stand_status and the Keel's doc word. Not `Revised.`,
# which means done per the answer. A later bold-led reply (`> **Applied.**` after the owner's new answer)
# closes it again: the last one decides.
REOPENED_RE = re.compile(r"^\s*>\s*\*\*Reopened\.\*\*")
BOLD_REPLY_RE = re.compile(r"^\s*>\s*\*\*[A-Z][^*]{0,40}\*\*")


def reopened(it, lines):
    """The last bold-led `>` reply under the item is `> **Reopened.**`."""
    k, last = it["end"], None
    while k < len(lines) and not item_match(lines[k]) and not STOP_RE.match(lines[k].strip()):
        if REPLY_RE.match(lines[k]) and BOLD_REPLY_RE.match(lines[k]):
            last = lines[k]
        k += 1
    return bool(last and REOPENED_RE.match(last))


def yolo_settled(it, lines):
    """For `memo yolo` and dispatch --yolo's launch: the item is past the gate — an answer in the owner's
    box (a yolo pick included: taken once, never re-taken) or a dated reply of the owner's. A session's own
    `>` reply is not: a build that wrote `> Proceeding with B` under a Reversible: no item must not
    clear it (review of 2026-10-08). A reopened item is not settled, whatever its box holds: the
    session refused that answer, so it waits on the owner again (entry S3, 2026-10-15)."""
    if reopened(it, lines):
        return False
    if (it["answer"] or "").strip():
        return True
    k = it["end"]
    while k < len(lines) and not item_match(lines[k]) and not STOP_RE.match(lines[k].strip()):
        if OWNER_REPLY_RE.match(lines[k]):
            return True
        k += 1
    return False


def lint(text, strict=False, path=None):
    """(errors, warnings) for a doc that asks the owner, deterministically:

    - an error: a D-item not yet answered whose pick is bare — anything but `none until <probe>`
      or `<letter> … if … else …` — while its text, its options, its Recommended line, or a
      section headed by its id cites an id the doc defines and lists as not verified. `strict`
      also reads answered items, an old-shape answer as the pick: the doc as it read when it was
      handed over (the ed7ca88 self-test). By default an answered doc is quiet — its picks are
      the owner's now;
    - a warning: in a doc whose header says ``Written by `architect` … on <date>`` (or
      sr-architect), dated 2026-10-04 or later, an old-shape answer with text and no reply under
      it. It cannot be told from the owner's own answer, so it never fails the lint;
    - a warning, same doc: a new-shape answer that is the Recommended letter alone (or the
      Recommended text verbatim), no reply under it, written by the same commit as the
      Recommended line (git blame on `path`): the architect
      filled the owner's box. The owner's answer always comes in a later commit than the doc it answers —
      the author can't tell them apart (on the laptop every commit is the owner's, the hook's too),
      the commit can, until the branch launches (see same_commit). Without `path` in a repo, it is
      not checked. Known gap: a later commit that rewords the Recommended line hides a pre-fill
      made with it (blame moves that line only); the lint stays a warning;
    - a warning: options in the old, unbulleted shape;
    - a warning: a D-item not yet answered that sits under a feedback heading or lead. The form
      shows it (feedback_section), so nothing is lost and it is no error; the cost is a second
      `## Open feedback` at the end when a Save brings feedback. An answered one is a reply
      thread's record (household's history-2026-09-23, D13-D18): nothing is left to take, so it
      is quiet;
    - a warning: an architect's doc dated KIND_SINCE or later whose title names no kind, or one off DOC_KINDS
      (kind_warnings) — research, proposal, design, in that order for most things."""
    lines, items, _ = parse(text)
    errors, warnings = [], []
    if items:
        above = [k for k in feedback_markers(lines, fenced(lines)) if k < items[-1]["start"]]
        for it in items:
            over = [k for k in above if k < it["start"]]
            if over and not answered(it, lines):
                warnings.append("%s (line %d): sits under the feedback section (line %d) — the form shows it, but "
                                "a Save's feedback goes under the first section after the last item; move this "
                                "section below the last item" % (it["id"], it["start"] + 1, over[-1] + 1))
    listed = not_verified(lines)
    inside = {k for a, b in listed for k in range(a, b)}
    outside = [l if k not in inside else "" for k, l in enumerate(lines)]
    within = [l if k in inside else "" for k, l in enumerate(lines)]
    known = defined_ids(outside) | defined_ids(within, strong=True)
    unverified = {}
    for a, b in listed:
        for x in ids_in(lines[a:b]) & known:  # a lead lists on its own line too
            unverified.setdefault(x, a + 1)
    by = written_by(lines)
    for it in items:
        rec = it["recommended"]
        done = answered(it, lines)
        pick = rec if rec is not None else (it["answer"] or "").strip()
        if pick and (strict or not done) and not CONDITIONAL_RE.search(pick.strip()) and unverified:
            # the agent's lines: up to the answer (on the item's own line, that line), never the owner's below
            own = lines[it["start"]:max(it["start"] + 1, it["answer_line"] if it["answer_line"] is not None else it["end"])]
            for a, b in sections(lines, lambda t, n=it["id"]: bool(re.match(r"^(?:\d+(?:\.\d+)*\.?\s+)?\**%s\b" % n, t))):
                own = own + lines[a:b]
            hit = sorted(ids_in(own) & set(unverified), key=id_key)
            if hit:
                errors.append("%s (line %d): the pick %r rests on %s, listed as not verified (line %d) — "
                              "probe it, or make the pick conditional: `➤ Recommended: none until <probe>` or "
                              "`➤ Recommended: A if <probe> shows X, else B`"
                              % (it["id"], it["start"] + 1, pick[:40], ", ".join(hit), min(unverified[x] for x in hit)))
        if is_prefill(it, lines, by) or (path and is_new_prefill(it, lines, by, path)):
            warnings.append("%s (line %d): an architect doc's `➤ Answer:` holds text (%r) — if it isn't %s, "
                            "empty it; the pick goes on `➤ Recommended:` (agents/architect.md)"
                            % (it["id"], (it["answer_line"] or it["start"]) + 1, it["answer"][:40], WHOSE))
        if it["options"] and not it["options_bulleted"]:
            warnings.append("%s (line %d): options as plain `A — …` lines render as one run-on line on GitHub — "
                            "write them as `- A — …` bullets (agents/architect.md)" % (it["id"], it["start"] + 1))
        if it["reversible"] is None and not done:
            # layer section 2: 59 of 122 open items carried none on 2026-10-14, and the stand sweep and
            # yolo never take an unmarked item — a warning makes authors mark them
            warnings.append("%s (line %d): no `Reversible: yes|no` line — no default can ever take it (yolo, "
                            "the stand sweep); mark it above `➤ Recommended:`" % (it["id"], it["start"] + 1))
    ke, kw = keel_lint(text, path)
    return errors + ke, warnings + kw + kind_warnings(text, path)


def written_by(lines):
    """The `Written by `architect` … on <date>` match in the header (before the first `## `), or None."""
    head = []
    for l in lines:
        if l.startswith("## "):
            break
        head.append(l)
    return ARCHITECT_RE.search("\n".join(head))


def is_prefill(it, lines, by):
    """An old-shape answer with text and no reply under it, in a doc an architect wrote on or
    after PREFILL_RULE_SINCE: perhaps the agent's pick in the owner's box."""
    return bool(by and by.group(2) >= PREFILL_RULE_SINCE and it["recommended"] is None
                and (it["answer"] or "").strip() and not replied(it, lines))


LETTER_RE = re.compile(r"^[*_]*([A-Z])\b")


def is_new_prefill(it, lines, by, path):
    """A new-shape answer naming the Recommended letter, no reply under it, in an architect doc,
    on a line the same commit wrote as the Recommended line — the architect's pick in the owner's box
    (`➤ Answer: B` under `➤ Recommended: B`, memo-lint-fixes 2026-10-05)."""
    if not (by and by.group(2) >= PREFILL_RULE_SINCE and it["recommended"] is not None and it["rec_line"] is not None):
        return False
    ans, rec = (it["answer"] or "").strip().rstrip("."), it["recommended"].strip().rstrip(".")
    a, r = LETTER_RE.match(ans), LETTER_RE.match(rec)
    if not (a and r and a.group(1) == r.group(1)) or replied(it, lines):
        return False
    # Only a copy: the bare letter, or the Recommended text verbatim. A session that records chat
    # answers writes more ("A (the owner in chat, 2026-10-05: …)", 220labs' two briefs), often in the
    # same commit as a revised Recommended line — that is the owner's word, not a pre-fill.
    if not (re.match(r"^[*_]*[A-Z][*_]*$", ans) or ans == rec):
        return False
    at = next((k for k in range(it["answer_line"], it["answer_end"])
               if (split_answer(lines[k]) or (None, lines[k]))[1].strip()), it["answer_line"])
    return bool(same_commit(path, it["rec_line"], at))


def same_commit(path, a, b):
    """Did one commit write lines a and b (0-based) of the file — or one uncommitted edit, or is
    the file not tracked yet (one hand so far)? None when git can't say: outside a repo, a blame
    that fails on a tracked file, or a commit already on `main` — `/finish` folds the doc and
    the owner's answers into one commit there, so on main one commit proves nothing (review,
    2026-10-05). The check is for hand-over, on a branch."""
    p = Path(path).resolve()

    def run(*args):
        try:
            return subprocess.run(["git", "-C", str(p.parent), *args], capture_output=True, text=True, timeout=GIT_TIMEOUT)
        except subprocess.TimeoutExpired:
            return subprocess.CompletedProcess(args, 124, "", "")
    r = run("blame", "--porcelain", "-L", "%d,+1" % (a + 1), "-L", "%d,+1" % (b + 1), "--", p.name)
    if r.returncode:
        if run("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
            return None
        return True if run("ls-files", "--error-unmatch", "--", p.name).returncode else None
    shas = [l.split()[0] for l in r.stdout.splitlines() if re.match(r"^[0-9a-f]{40} \d+ \d+", l)]
    if len(shas) < 2 or shas[0] != shas[-1]:
        return False
    if shas[0] != "0" * 40:
        for main in ("main", "origin/main"):
            if run("merge-base", "--is-ancestor", shas[0], main).returncode == 0:
                return None
    return True


# ----------------------------------------------------------------------------- the Keel (2026-10-15)

# The layer under every Course doc (docs/design-docs-layer-2026-10-14.md, section 1; entry S1): beside
# the D-item, three more one-line grammars and one derived line, read by regex, no model, no sidecar
# (layer D1-A). A step of the Action plan:
#
#     - **S3 — <what>** · session `tier` | project `<name>` | human (<why>) · after: S1, D2, shape D4 | — [· gate: <file>] · status: <word>[ <date> <branch>][ — <note>]
#
# a goal, a row of the Goals table: `| G2 — <metric> | <today> | <target> | <how, when> |`; its
# evaluation, a quote under the table that never edits the row (layer D3-A):
# `> **Measured, <date>:** G2 = <value> (target <t>) — <how>`; and the doc's `Status:` line in its
# first lines, which `status --stamp` rewrites and `lint` checks, never typed (entry D6-A):
#
#     Status: <word> — <n> of <m> decisions answered · action plan: <k> of <j> steps done · handed over <date>[ · first answer <date>][ · crew: <who> since|done <date>]
#
# A component of a set writes `built by entry S2, S8 (k of j done)` for its action plan (shape
# section 3). Steps live in the Action plan section only (a heading that opens "Action plan"), so a
# review report's S1 severities or a fenced skeleton are never steps. `part done` is read as `wip`:
# a step built in parts (the keel build's S8, 2026-10-15) has started and is not done.
STEP_WORDS = ("not started", "wip", "done", "blocked", "superseded")
STEP_ALIAS = {"part done": "wip"}
DOC_WORDS = ("proposed", "answered", "building", "blocked", "built", "measured", "superseded")
STEP_RE = re.compile(r"^\s*[-*]\s+\*\*S(?P<n>\d+)\s*[—–-]\s*(?P<what>.+?)\*\*(?P<rest>.*)$")
STEP_FIELD_RE = re.compile(r"·\s*(after|gate|status)\s*:\s*([^·]*)")
STEP_KIND_RE = re.compile(r"·\s*(session|project|human)\b\s*([^·]*)")
GOAL_RE = re.compile(r"^\s*\|\s*\**G(?P<n>\d+)\**\s*[—–-]\s*(?P<metric>[^|]*)\|(?P<rest>.*)$")
MEASURED_RE = re.compile(r"^\s*>\s*\*\*Measured,\s*(?P<date>\d{4}-\d{2}-\d{2}):?\*\*:?\s*G(?P<n>\d+)\b")
KEEL_STATUS_RE = re.compile(r"^Status:\s*(?P<word>%s)\s+—\s+(?P<tail>.*)$" % "|".join(DOC_WORDS))
# crosstalk S3's check-in: ` · crew: <who> since|done <date>`, the line's last part (keel checkin)
CREW_RE = re.compile(r"(?:^|·)\s*crew:\s*(?P<who>[^·]+?)\s+(?P<state>since|done)\s+(?P<date>\d{4}-\d{2}-\d{2})\s*(?=·|$)")
CREW_SEG_RE = re.compile(r"\s*·\s*crew:[^·]*")
KEEL_HEAD = 15  # status_of's window: the line sits at 3–5, the title and `Written by` above it
DATE_RE = r"\d{4}-\d{2}-\d{2}"
SET_STEM_RE = re.compile(r"^(?P<topic>.+)-(?P<date>\d{4}-\d{2}-\d{2})$")
# the caps of shape D1-A — warnings, never errors; `wc -w` counts, so a diagram's glyphs count
CAP_TOP, CAP_FUNDAMENTAL, CAP_FUNDAMENTAL_N = 700, 140, 6
CAP_ENTRY, CAP_DOC, CAP_DOC_D, CAP_SET = 2000, 2500, 7, 10000
# A dated doc's title ends `(<kind>, <date>[; a note])`. Research, proposal, design are the order
# most work takes (the owner, 2026-10-16; agents/architect.md "Kind"); the rest are kinds outside it, or
# a set's part. A warning, never an error, only on an architect's doc (written_by) dated KIND_SINCE
# or later — the day the rule went in: docs of 2026-10-16 were written before it, and an old doc is
# never judged by a rule it was not written to; a session's digest names no kind until a rule asks it
# to (reviews 2026-10-16, 2026-10-17). `evidence` is a set's companion of probes (sr-architect's).
DOC_KINDS = ("research", "proposal", "design", "decision memo", "escalation", "storyboard",
             "entry doc", "component doc", "evidence", "review", "digest", "post-mortem")
KIND_SINCE = "2026-10-17"
TITLE_KIND_RE = re.compile(r"\((?P<kind>[^(),;]+),\s*\d{4}-\d{2}-\d{2}[^()]*\)\s*$")


def title_kind(text):
    """The kind the doc's title names — the last parenthesis, before its date — lowercased,
    markdown stripped (title_of takes `*` and backticks, `_` here); None when it names none."""
    m = TITLE_KIND_RE.search(title_of(text, "").strip())
    return re.sub(r"\s+", " ", m.group("kind")).strip(" _").lower() if m else None


def kind_warnings(text, path):
    """[] or one warning: an architect's doc dated KIND_SINCE or later whose title names no kind, or one off DOC_KINDS."""
    m = SET_STEM_RE.match(Path(path).stem) if path else None
    if not m or m.group("date") < KIND_SINCE or not written_by(text.split("\n")):
        return []
    kind = title_kind(text)
    if kind is None:
        return ["the title does not end `(<kind>, <date>)` — research, proposal or design, "
                "in that order for most things (the owner, 2026-10-16)"]
    if kind not in DOC_KINDS:
        return ["the title's kind `%s` is none of %s (the owner, 2026-10-16)" % (kind, ", ".join(DOC_KINDS))]
    return []


def action_plan(lines, fence=None):
    """(start, end) of the Action plan section — a heading that opens with "Action plan" — or None."""
    found = sections(lines, lambda t: bool(re.match(r"^(?:\d+(?:\.\d+)*\.?\s+)?[*_]*action plan\b", t, re.I)))
    return found[0] if found else None


def parse_step(line):
    m = STEP_RE.match(line)
    if not m:
        return None
    rest = m.group("rest")
    fields = {k: v.strip() for k, v in STEP_FIELD_RE.findall(rest)}
    kind = STEP_KIND_RE.search(rest)
    raw = fields.get("status", "")
    low = raw.lower()
    word = next((w for w in sorted(list(STEP_WORDS) + list(STEP_ALIAS), key=len, reverse=True)
                 if low == w or low.startswith(w + " ") or low.startswith(w + " —")), None)
    after = [t.strip() for t in fields.get("after", "").split(",")]
    return {"id": "S" + m.group("n"), "n": int(m.group("n")), "what": m.group("what").strip(),
            "kind": kind.group(1) if kind else None, "who": kind.group(2).strip() if kind else "",
            "after": [t for t in after if t and t not in ("—", "-", "–")],
            "gate": fields.get("gate"), "status_text": raw,
            "status": STEP_ALIAS.get(word, word) if word else None}


def keel_parse(lines):
    """{steps, goals, measured, status} of a doc: the Action plan's S-lines, the G-rows, the Measured
    quotes (G id → latest date), and the Keel `Status:` line (None in a doc without one)."""
    fence = fenced(lines)
    steps, goals, measured, status = [], [], {}, None
    ap = action_plan(lines)
    for k, l in enumerate(lines):
        if fence[k]:
            continue
        if ap and ap[0] <= k < ap[1]:
            s = parse_step(l)
            if s:
                s["line"] = k
                steps.append(s)
                continue
        g = GOAL_RE.match(l)
        if g:
            cells = [c.strip() for c in g.group("rest").split("|")]
            goals.append({"id": "G" + g.group("n"), "metric": g.group("metric").strip(),
                          "today": cells[0] if cells else "", "target": cells[1] if len(cells) > 1 else "",
                          "how": cells[2] if len(cells) > 2 else "", "line": k})
            continue
        mm = MEASURED_RE.match(l)
        if mm:
            gid = "G" + mm.group("n")
            measured[gid] = max(measured.get(gid, ""), mm.group("date"))
    for k, l in enumerate(lines[:KEEL_HEAD]):
        m = KEEL_STATUS_RE.match(l)
        if m and not fence[k]:
            status = keel_status_fields(m)
            status["line"] = k
            break
    return {"steps": steps, "goals": goals, "measured": measured, "status": status}


def keel_status_fields(m):
    """The parts of a Keel Status line a derivation compares, plus the dates it keeps."""
    tail = m.group("tail")
    out = {"word": m.group("word"), "text": m.group(0)}
    d = re.search(r"(\d+) of (\d+) decisions? answered", tail)
    out["decisions"] = (int(d.group(1)), int(d.group(2))) if d else None
    p = re.search(r"action plan:\s*(\d+) of (\d+) steps? done", tail)
    out["plan"] = (int(p.group(1)), int(p.group(2))) if p else None
    b = re.search(r"built by entry\s+(S\d+(?:\s*,\s*S\d+)*)\s*\((\d+) of (\d+) done\)", tail)
    out["built_by"] = [x.strip() for x in b.group(1).split(",")] if b else None
    out["built"] = (int(b.group(2)), int(b.group(3))) if b else None
    h = re.search(r"handed over (%s)" % DATE_RE, tail)
    f = re.search(r"first answer (%s)" % DATE_RE, tail)
    out["handed_over"], out["first_answer"] = h and h.group(1), f and f.group(1)
    c = CREW_RE.search(tail)
    out["crew"] = c and {"who": c.group("who").strip(), "state": c.group("state"), "date": c.group("date")}
    out["crew_bad"] = bool(re.search(r"(?:^|·)\s*crew:", tail)) and not c
    return out


def set_of(path):
    """The nested set `path` belongs to (shape D4-A: flat files, `docs/<topic>-<date>.md` the entry,
    `docs/<topic>-<component>-<date>.md` each component, same folder, same date), as {entry, files,
    slugs: {slug: path}} — or None when the file is in no set. A component counts only when the entry
    links it (by file name: the entry's links may point at another worktree's copy), so two unrelated
    docs that happen to share a prefix and a date are no set."""
    p = Path(path).resolve()
    m = SET_STEM_RE.match(p.stem)
    if not m:
        return None
    try:
        names = [q.name for q in p.parent.glob("*-%s.md" % m.group("date")) if q.is_file()]
    except OSError:
        return None

    def read(n):
        try:
            return (p.parent / n).read_text()
        except (OSError, UnicodeDecodeError):
            return None
    s = set_names(p.name, names, read)
    if not s:
        return None
    return {"entry": p.parent / s["entry"], "files": [p.parent / n for n in s["files"]],
            "slugs": {k: p.parent / n for k, n in s["slugs"].items()}}


def set_names(name, names, read):
    """set_of's rule over the file names of one folder, `read(name)` giving a file's text or None:
    {entry, files, slugs: {slug: name}} by name, or None. The lookout reads a branch's tree with it,
    where there is no checkout to glob (set_at)."""
    m = SET_STEM_RE.match(name[:-3] if name.endswith(".md") else name)
    if not m:
        return None
    topic, date = m.group("topic"), m.group("date")
    same = sorted(n for n in names if n.endswith("-%s.md" % date))

    def links(n):
        return {Path(t.strip("<>").split("#")[0]).name for t in re.findall(r"\]\((<[^>\n]+>|[^)\s]+)\)", read(n) or "")}

    entries = [n for n in same if n != name and SET_STEM_RE.match(n[:-3])
               and topic.startswith(SET_STEM_RE.match(n[:-3]).group("topic") + "-")]
    for e in sorted(entries, key=lambda n: len(n[:-3])):
        if name in links(e):
            break
    else:
        e = name
    et = SET_STEM_RE.match(e[:-3]).group("topic")
    linked = links(e)
    # a component carries its own Keel Status line (shape section 1): the research record the entry
    # links for its baselines (design-docs-research-2026-10-14.md) shares the name and is no component
    comps = [n for n in same if n != e and n in linked and n[:-3].startswith(et + "-")
             and any(KEEL_STATUS_RE.match(l) for l in (read(n) or "").split("\n")[:KEEL_HEAD])]
    if not comps:
        return None
    slugs = {"entry": e}
    for n in comps:
        slugs[n[:-3][len(et) + 1:-len(date) - 1]] = n
    return {"entry": e, "files": [e] + comps, "slugs": slugs}


def keel_files(path):
    """[(path, text)] for the set `path` is in (the entry first), else for the file alone."""
    s = set_of(path)
    out = []
    for q in (s["files"] if s else [Path(path).resolve()]):
        try:
            out.append((q, q.read_text()))
        except (OSError, UnicodeDecodeError):
            pass
    return out, s


def slug_of(s, path):
    return next((k for k, q in (s or {}).get("slugs", {}).items() if q == Path(path).resolve()), None)


def keel_derive(text, path=None, cache=None):
    """The doc's Keel state, derived by layer section 1's table — the first word that holds:
    superseded (the line already says so: Aurora's charts section writes it, a later doc having
    replaced this one) · blocked (a step is blocked, or a D a step waits on was reopened) · measured ·
    built · building · answered · proposed. A component of a set reads its steps from the entry, by
    its own line's `built by entry …` list. Returns {word, decisions: (n, m), plan: (k, j) or None,
    built_by, steps, goals, status (the line as written, or None), reopened, dangling}."""
    lines, items, _ = parse(text)
    kp = keel_parse(lines)
    st = kp["status"]
    s = set_of(path) if path else None
    texts = cache if cache is not None else {}

    def items_of(q):
        q = Path(q).resolve()
        if q not in texts:
            try:
                tl, ti, _ = parse(q.read_text())
                texts[q] = (tl, ti)
            except (OSError, UnicodeDecodeError, Stop):
                texts[q] = None
        return texts[q]
    reopened_ids = {it["id"] for it in items if reopened(it, lines)}
    done_d = sum(1 for it in items if answered(it, lines))
    steps, built_by = kp["steps"], None
    if st and st["built_by"] is not None and s and Path(path).resolve() != s["entry"]:
        built_by = st["built_by"]
        ep = items_of(s["entry"])
        entry_steps = keel_parse(ep[0])["steps"] if ep else []
        steps = [x for x in entry_steps if x["id"] in built_by]
    own = {it["id"] for it in items}
    step_ids = {x["id"] for x in kp["steps"]}
    goal_ids = {g["id"] for g in kp["goals"]}
    blocked_by, dangling = [], []
    for x in steps:
        for t in x["after"]:
            m = re.match(r"^(?:(?P<slug>[\w-]+)\s+)?(?P<id>[SDG]\d+)$", t)
            if not m:
                continue
            slug, xid = m.group("slug"), m.group("id")
            if slug and slug != "entry":
                q = (s or {}).get("slugs", {}).get(slug)
                got = items_of(q) if q else None
                if got is None:
                    if s and built_by is None:
                        dangling.append((x["id"], t))
                    continue
                if xid.startswith("D"):
                    hit = [it for it in got[1] if it["id"] == xid]
                    if not hit:
                        if built_by is None:  # an entry step's ids are reported once, in the entry
                            dangling.append((x["id"], t))
                    elif reopened(hit[0], got[0]):
                        blocked_by.append((x["id"], t))
                continue
            if built_by is not None:
                continue  # an entry step's own ids are the entry's to check
            if xid.startswith("S") and xid not in step_ids:
                dangling.append((x["id"], t))
            elif xid.startswith("D"):
                if xid not in own:
                    dangling.append((x["id"], t))
                elif xid in reopened_ids:
                    blocked_by.append((x["id"], t))
            elif xid.startswith("G") and xid not in goal_ids:
                dangling.append((x["id"], t))
    sw = [x["status"] for x in steps]
    all_done = bool(steps) and all(w in ("done", "superseded") for w in sw)
    if st and st["word"] == "superseded":
        word = "superseded"
    elif "blocked" in sw or blocked_by:
        word = "blocked"
    elif all_done and kp["goals"] and all(g["id"] in kp["measured"] for g in kp["goals"]):
        word = "measured"
    elif all_done:
        word = "built"
    elif any(w in ("wip", "done") for w in sw):
        word = "building"
    elif done_d == len(items) and not reopened_ids:
        word = "answered"
    else:
        word = "proposed"
    k = sum(1 for w in sw if w in ("done", "superseded"))
    return {"word": word, "decisions": (done_d, len(items)), "plan": (k, len(steps)) if steps or st else None,
            "built_by": built_by, "steps": steps, "goals": kp["goals"], "measured": kp["measured"],
            "status": st, "reopened": sorted(reopened_ids, key=id_key), "blocked_by": blocked_by,
            "dangling": dangling, "set": s}


def keel_line(d, handed_over=None, first_answer=None):
    """The Status line a derivation writes; dates kept from the line as written unless given."""
    st = d["status"] or {}
    n, m = d["decisions"]
    parts = ["%d of %d decision%s answered" % (n, m, "" if m == 1 else "s")]
    k, j = d["plan"] or (0, 0)
    if d["built_by"] is not None:
        parts.append("built by entry %s (%d of %d done)" % (", ".join(d["built_by"]), k, j))
    else:
        parts.append("action plan: %d of %d step%s done" % (k, j, "" if j == 1 else "s"))
    ho, fa = handed_over or st.get("handed_over"), first_answer or st.get("first_answer")
    if ho:
        parts.append("handed over " + ho)
    if fa:
        parts.append("first answer " + fa)
    if st.get("crew"):
        parts.append("crew: %(who)s %(state)s %(date)s" % st["crew"])
    return "Status: %s — %s" % (d["word"], " · ".join(parts))


def keel_disagrees(d):
    """What the doc's Status line says that its derivation does not, one phrase each ([] if none)."""
    st = d["status"]
    if not st:
        return []
    out = []
    if st["word"] != d["word"]:
        out.append("says %s, derives %s" % (st["word"], d["word"]))
    if st["decisions"] and tuple(st["decisions"]) != tuple(d["decisions"]):
        out.append("says %d of %d decisions answered, derives %d of %d" % (st["decisions"] + d["decisions"]))
    have = st["built"] if d["built_by"] is not None else st["plan"]
    if have and d["plan"] and tuple(have) != tuple(d["plan"]):
        out.append("says %d of %d steps done, derives %d of %d" % (tuple(have) + tuple(d["plan"])))
    return out


def words(lines):
    """`wc -w` over the lines: whitespace-separated tokens, a diagram's glyphs included."""
    return sum(len(l.split()) for l in lines)


def keel_lint(text, path=None, cache=None):
    """(errors, warnings) the Keel adds to `lint`, for a doc in the Course shape (a Keel Status line
    or an Action plan with S-lines; an old doc is never judged by caps it was not written to):
    errors — a Status line that disagrees with its derivation, a step's `after:` naming an S, D or G
    the doc (or, for `<slug> D2`, the set) lacks; warnings — shape D1-A's caps."""
    lines, items, _ = parse(text)
    d = keel_derive(text, path, cache)
    if not d["status"] and not d["steps"]:
        return [], []
    errors, warnings = [], []
    where = "line %d" % (d["status"]["line"] + 1) if d["status"] else "Status line"
    for p in keel_disagrees(d):
        errors.append("the Status line (%s) %s — `keel status --stamp` rewrites it" % (where, p))
    if d["status"] and d["status"].get("crew_bad"):
        errors.append("the Status line (%s) has a crew mark that does not read `crew: <who> since|done <yyyy-mm-dd>` — "
                      "`keel checkin` writes it" % where)
    for sid, t in d["dangling"]:
        errors.append("%s: after: names %s, which %s" % (sid, t, "the set does not hold" if " " in t else "the doc does not define"))
    ap = action_plan(lines)
    body = lines[:ap[0]] + lines[ap[1]:] if ap else lines
    s = d["set"]
    me = Path(path).resolve() if path else None
    is_entry = bool(s and me == s["entry"])
    n = words(body)
    cap = CAP_ENTRY if is_entry else CAP_DOC
    if n > cap:
        warnings.append("%d words outside the Action plan, over the cap of %d for %s (shape D1-A)"
                        % (n, cap, "an entry doc" if is_entry else "a doc"))
    if not is_entry and len(items) > CAP_DOC_D:
        warnings.append("%d D-items, over %d — split by component (entry D3-A)" % (len(items), CAP_DOC_D))
    top = sections(lines, lambda t: bool(re.match(r"^(?:\d+(?:\.\d+)*\.?\s+)?[*_]*(?:summary|goals|the system)\b", t, re.I)))
    tw = 0
    for a, b in top:
        fund = sections(lines[a:b], lambda t: bool(re.match(r"^(?:\d+(?:\.\d+)*\.?\s+)?[*_]*fundamental decisions\b", t, re.I)))
        tw += words(lines[a:b]) - sum(words(lines[a:b][x:y]) for x, y in fund)
    if top and tw > CAP_TOP:
        warnings.append("Summary + Goals + System: %d words, over %d (shape D1-A)" % (tw, CAP_TOP))
    fund = sections(lines, lambda t: bool(re.match(r"^(?:\d+(?:\.\d+)*\.?\s+)?[*_]*fundamental decisions\b", t, re.I)))
    if fund:
        a, b = fund[0]
        inside = [it for it in items if a <= it["start"] < b]
        if len(inside) > CAP_FUNDAMENTAL_N:
            warnings.append("%d fundamental decisions, over %d (shape D1-A)" % (len(inside), CAP_FUNDAMENTAL_N))
        for k, it in enumerate(inside):
            end = inside[k + 1]["start"] if k + 1 < len(inside) else b
            w = words(lines[it["start"]:it["answer_line"] if it["answer_line"] is not None else end])
            if w > CAP_FUNDAMENTAL:
                warnings.append("%s: %d words to its answer, over %d for a fundamental decision (shape D1-A)"
                                % (it["id"], w, CAP_FUNDAMENTAL))
    return errors, warnings


SET_REF_RE = r"(?<![\w-])(%s) (D\d+)\b"


def set_lint(entry):
    """`keel lint --set <entry>`: every file of the set, plus each `<slug> D2` whose target is missing
    (shape section 3) and the set's cap. [(path, errors, warnings)]."""
    files, s = keel_files(entry)
    if not s:
        raise Stop("%s is not an entry doc with components (shape D4-A: docs/<topic>-<component>-<date>.md, linked from the entry)" % entry)
    cache, out, total = {}, [], 0
    ids = {}
    for q, text in files:
        try:
            ids[slug_of(s, q)] = {it["id"] for it in parse(text)[1]}
        except Stop:
            ids[slug_of(s, q)] = set()
    ref = re.compile(SET_REF_RE % "|".join(re.escape(k) for k in sorted(s["slugs"], key=len, reverse=True)))
    for q, text in files:
        errors, warnings = lint(text, path=q)
        lines = text.split("\n")
        fence = fenced(lines)
        ap = action_plan(lines)
        total += words(lines[:ap[0]] + lines[ap[1]:] if ap else lines)
        for k, l in enumerate(lines):
            if fence[k] or (ap and ap[0] <= k < ap[1] and STEP_RE.match(l)):
                continue  # a step's after: is keel_lint's to report, once
            for m in ref.finditer(NOT_PROSE_RE.sub(" ", l)):
                if m.group(2) not in ids.get(m.group(1), set()):
                    errors.append("line %d: %s %s — %s has no %s" % (k + 1, m.group(1), m.group(2), s["slugs"][m.group(1)].name, m.group(2)))
        out.append((q, list(dict.fromkeys(errors)), warnings))
    if total > CAP_SET:
        out[0][2].append("the set holds %d words outside its Action plans, over %d (shape D1-A)" % (total, CAP_SET))
    return out


def keel_dates(path, d):
    """(handed over, first answer) for a Status line that lacks them, read from git: the link (the
    first commit with the doc's answer lines on origin, `stand_status`'s clock) and the first
    commit on the doc after it that no agent trailer claims. (None, None) where git cannot say."""
    try:
        p, top, branch, rel, _ = locate(path)
    except Exception:
        return None, None
    ho = fa = None
    try:
        lk = link_commit(top, branch, rel)
    except Exception:
        lk = None
    if lk:
        ho = dt.datetime.fromtimestamp(lk[1]).strftime("%Y-%m-%d")
        if d["decisions"][0]:
            raw = git(top, "log", "--reverse", "--format=%H%x1f%ct%x1f%cn%x1f%B%x1e", "%s..HEAD" % lk[0], "--", rel, check=False).stdout
            for rec in raw.split("\x1e"):
                parts = rec.strip("\n").split("\x1f")
                if len(parts) >= 4 and (parts[2] == "GitHub" or not AGENT_TRAILER_RE.search(parts[3])):
                    fa = dt.datetime.fromtimestamp(int(parts[1])).strftime("%Y-%m-%d")
                    break
    return ho, fa


def keel_stamp(path):
    """Rewrite the Keel Status line of `path` — and of every file of its set, the entry first — from
    the derivation; dates kept, a missing one filled from git where it can be read. Not committed
    here. Prints one line per file; returns the files it changed."""
    files, s = keel_files(path)
    cache, changed = {}, []
    for q, text in files:
        d = keel_derive(text, q, cache)
        st = d["status"]
        rel = q.name
        if not st:
            if q == Path(path).resolve():
                print("%s: no Keel `Status:` line in its first %d lines — nothing to derive into" % (rel, KEEL_HEAD))
            continue
        ho, fa = (None, None)
        if not st["handed_over"] or (not st["first_answer"] and d["decisions"][0]):
            ho, fa = keel_dates(q, d)
        new = keel_line(d, st["handed_over"] or ho, st["first_answer"] or fa)
        lines = text.split("\n")
        if lines[st["line"]] == new:
            print("unchanged %s: %s" % (rel, new))
            continue
        lines[st["line"]] = new
        q.write_text("\n".join(lines))
        changed.append(q)
        print("stamped %s: %s" % (rel, new))
    return changed


def keel_summary(path):
    """One `keel: …` line per file of the doc's set (or the doc alone) that carries the Keel — the
    derived Status line, and `(the line says …)` where the written one differs. [] for an old doc."""
    files, s = keel_files(path)
    cache, out = {}, []
    for q, text in files:
        try:
            d = keel_derive(text, q, cache)
        except Stop:
            continue
        if not d["status"] and not d["steps"]:
            continue
        diff = keel_disagrees(d)
        out.append("keel: %s%s%s" % ((slug_of(s, q) + ": ") if s else "", keel_line(d)[len("Status: "):],
                                      " (the line says %s)" % d["status"]["word"] if diff else ""))
    return out


# The one writer of a step's `status:` field (entry D6-A, S4 and S7): the build session at its end
# (`keel step <doc> S3 done --branch B`), `plan digest` from the plan's status, Aurora's charts section
# (`superseded`). `/finish` and autofinish write nothing. One regex for the field, here, so `bin/plan`
# never carries a second one.
STEP_STATUS_FIELD_RE = re.compile(r"·\s*status\s*:\s*[^·]*$")


def step_status_text(word, date=None, branch=None, note=None):
    """`<word>[ <date>][ <branch>][ — <note>]`, D6's form (`done 2026-10-15 claude/laptop/…`). A `·`
    in a note would start a new field, so it becomes a comma."""
    parts = [word] + [x for x in (date, branch) if x]
    text = " ".join(parts)
    if note:
        text += " — " + " ".join(note.replace("·", ",").split())
    return text


def keel_step(path, sid, word, date=None, branch=None, note=None, stamp_after=False):
    """Rewrite step `sid`'s status field in the doc's Action plan; append one when the line has none.
    `done` takes today's date unless given. Returns (old status text, new) — equal when nothing
    changed. Raises Stop when the doc has no such step or the word is not a step word."""
    word = word.strip().lower()
    if word not in STEP_WORDS:
        raise Stop("%s is not a step word (%s)" % (word, ", ".join(STEP_WORDS)))
    if word == "done" and not date:
        date = dt.date.fromtimestamp(now_ts()).isoformat()
    p = Path(path)
    text = p.read_text()
    lines = text.split("\n")
    step = next((x for x in keel_parse(lines)["steps"] if x["id"] == sid.upper()), None)
    if step is None:
        raise Stop("%s: no %s in its Action plan (a component's steps live in the entry)" % (p.name, sid))
    new_text = step_status_text(word, date, branch, note)
    line = lines[step["line"]]
    if STEP_STATUS_FIELD_RE.search(line):
        new_line = STEP_STATUS_FIELD_RE.sub(lambda _: "· status: " + new_text, line)
    else:
        new_line = line.rstrip() + " · status: " + new_text
    if new_line != line:
        lines[step["line"]] = new_line
        p.write_text("\n".join(lines))
    if stamp_after:
        keel_stamp(p)
    return step["status_text"], new_text


# The launch refusal (entry D6-A, S7), `keel landing`: the verb keeps its old word, a CLI name no
# rename row maps yet. `/finish` and autofinish refuse a branch whose brief names an open step,
# and write nothing. A brief names its steps on one line, the dispatch template's:
#
#     Steps: S4, S3, S7 of docs/design-docs-2026-10-14.md
#
# (the doc relative to the repo; an absolute path is read from its `docs/` on). Only the branch's own
# briefs count — docs/handoff/ files it added or changed against main — and a brief with no `Steps:`
# line names none, so every brief written before 2026-10-15 launches as before.
BRIEF_STEPS_RE = re.compile(r"^Steps:\s*(?P<ids>S\d+(?:\s*,\s*S\d+)*)\s+(?:of|in)\s+[`<]?(?P<doc>[^`>\s]+)[`>]?", re.M)


def landing_open(where, base=None):
    """[(brief, doc, step, why)] for every step a branch brief names that its doc does not mark done
    or superseded (a missing doc or step counts: it cannot be shown done)."""
    top = Path(git(Path(where), "rev-parse", "--show-toplevel").stdout.strip())
    base = base or main_ref(top)
    if not base:
        return []
    names = git(top, "diff", "--name-only", "--diff-filter=AM", "%s...HEAD" % base, "--", "docs/handoff/", check=False).stdout.split("\n")
    out = []
    for rel in sorted(n for n in names if n.endswith(".md")):
        try:
            text = (top / rel).read_text()
        except (OSError, UnicodeDecodeError):
            continue
        for m in BRIEF_STEPS_RE.finditer(text):
            doc = m.group("doc")
            if doc.startswith("/"):
                doc = doc[doc.index("/docs/") + 1:] if "/docs/" in doc else doc
            ids = [x.strip() for x in m.group("ids").split(",")]
            try:
                steps = {x["id"]: x for x in keel_parse((top / doc).read_text().split("\n"))["steps"]}
            except (OSError, UnicodeDecodeError):
                out += [(rel, doc, sid, "the doc is not on this branch") for sid in ids]
                continue
            for sid in ids:
                x = steps.get(sid)
                if x is None:
                    out.append((rel, doc, sid, "no such step in its Action plan"))
                elif x["status"] not in ("done", "superseded"):
                    out.append((rel, doc, sid, x["status_text"] or "no status"))
    return out


def landing(where, base=None):
    found = landing_open(where, base)
    for brief, doc, sid, why in found:
        print("open step: %s names %s %s — %s" % (brief, doc, sid, why))
    if found:
        print("refused: the branch's brief names %d open step%s; the build marks each done (`keel step <doc> <S> done "
              "--branch <b> --stamp`) or Aurora supersedes it — nothing written" % (len(found), "" if len(found) == 1 else "s"))
        return 1
    print("landing: no brief on this branch names an open step")
    return 0


# ----------------------------------------------------------------------------- markdown subset

def inline(s):
    """Escape, then bold / code / links / strike. Nothing in the memo is ever raw HTML."""
    s = html.escape(s, quote=False)
    codes = []

    def keep(m):
        codes.append(m.group(1))
        return "\x00%d\x00" % (len(codes) - 1)
    s = re.sub(r"`([^`]+)`", keep, s)
    s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"~~(.+?)~~", r"<s>\1</s>", s)
    s = re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", r'<a href="\2" rel="noopener">\1</a>', s)
    s = re.sub(r"\x00(\d+)\x00", lambda m: "<code>%s</code>" % codes[int(m.group(1))], s)
    return s


def render_md(lines, base=None, shift=0, ctx=None, pick=False):
    """The Markdown subset as HTML. With `ctx` and `base` (the source line of lines[0]), every block
    the owner can note carries `data-at` — the source line a note goes after — and `data-q`, that
    line's text, so `merge` can tell whether the memo moved under the page. `ctx["anchors"]` maps
    each such line to the indent a note there needs to stay inside its list item. `shift` is the
    indent a nested list's slicing took off; `pick` makes options buttons (a decision's card)."""
    out = []
    i = 0
    n = len(lines)

    def ind(l):
        return len(l) - len(l.lstrip())

    def mark(k, indent, row=None):
        if ctx is None or base is None:
            return ""
        at = base + k
        ctx["anchors"].setdefault(at, shift + indent)
        a = ' data-at="%d" data-q="%s"' % (at, html.escape(ctx["lines"][at].strip(), quote=True))
        if row is not None:
            a += ' data-row="%s"' % html.escape(row, quote=True)
        if "ss" in ctx:
            a += ' data-ss-id="%s"' % ss_anchor(ctx, at, row)
        return a
    while i < n:
        line = lines[i]
        s = line.strip()
        if not s:
            i += 1
            continue
        opener = fence_mark(line)
        if opener:  # the same fence rule as parse (hooks/common.py): ~~~ too, and ```` holds ```
            buf = []
            first = i
            i += 1
            while i < n and not _common().fence_closes(lines[i], opener, ind(lines[first])):
                buf.append(lines[i])
                i += 1
            end = min(i, n - 1)
            i += 1
            if MERMAID_FENCE_RE.match(lines[first]):
                # drawn by the inlined mermaid.min.js (mermaid_scripts); until it runs, or where it may
                # not, the escaped source shows — mermaid reads it back through the entities
                out.append('<pre class="mermaid"%s>%s</pre>' % (mark(end, ind(lines[first])), html.escape("\n".join(buf), quote=False)))
                continue
            out.append("<pre%s><code>%s</code></pre>" % (mark(end, ind(lines[first])), html.escape("\n".join(buf), quote=False)))
            continue
        m = HEADING_RE.match(s)
        if m:
            level = len(m.group(1))
            out.append("<h%d%s>%s</h%d>" % (level, mark(i, ind(line)), inline(m.group(2)), level))
            i += 1
            continue
        if s == "---":
            out.append("<hr>")
            i += 1
            continue
        opts, end = option_run(lines, i)
        if opts:
            o = ['<div class="opts">']
            for letter, text, _, last in opts:
                if pick:
                    o.append('<button type="button" class="opt" data-letter="%s"><span class="L">%s</span><span class="t">%s</span></button>'
                             % (letter, letter, inline(text)))
                else:
                    o.append('<div class="opt"%s><span class="L">%s</span><span class="t">%s</span></div>'
                             % (mark(last, ind(lines[last])), letter, inline(text)))  # a note goes after the whole option
            out.append("".join(o) + "</div>")
            i = end
            continue
        if s.startswith("|"):
            rows = []
            first = i
            while i < n and lines[i].strip().startswith("|"):
                rows.append(lines[i].strip().strip("|").split("|"))
                i += 1
            last = i - 1
            if len(rows) >= 2 and all(re.match(r"^\s*:?-+:?\s*$", c) for c in rows[1]):
                head, body = rows[0], rows[2:]
            else:
                head, body = None, rows
            t = ["<div class=\"tbl\"><table>"]
            if head:
                t.append("<thead><tr>%s</tr></thead>" % "".join("<th>%s</th>" % inline(c.strip()) for c in head))
            t.append("<tbody>")
            seen = {}
            for k, r in enumerate(body, 1):
                # a note on a row goes under the whole table, naming the row by its first cell —
                # numbered when that cell is empty or repeats, so two rows never share one note
                label = re.sub(r"[*`]", "", r[0]).strip() or "row %d" % k
                seen[label] = seen.get(label, 0) + 1
                if seen[label] > 1:
                    label = "%s (%d)" % (label, seen[label])
                t.append("<tr%s>%s</tr>" % (mark(last, ind(lines[first]), label),
                                            "".join("<td>%s</td>" % inline(c.strip()) for c in r)))
            t.append("</tbody></table></div>")
            out.append("".join(t))
            continue
        if s.startswith(">"):
            buf = []
            first = i
            while i < n and lines[i].strip().startswith(">"):
                buf.append(lines[i].strip()[1:].strip())
                i += 1
            out.append("<blockquote%s>%s</blockquote>" % (mark(i - 1, ind(lines[first])), render_md(buf)))
            continue
        lm = re.match(r"^(\s*)([-*]|\d+\.)\s+(.*)$", line)
        if lm:
            kind = "ol" if lm.group(2)[0].isdigit() else "ul"
            lind = len(lm.group(1))
            out.append("<%s>" % kind)
            while i < n:
                lm = re.match(r"^(\s*)([-*]|\d+\.)\s+(.*)$", lines[i])
                if not lm or len(lm.group(1)) != lind:
                    break
                text = [lm.group(3)]
                content = lind + len(lm.group(2)) + 1
                last = i
                i += 1
                sub = []
                sub_at = None
                while i < n and lines[i].strip():
                    sm = re.match(r"^(\s*)([-*]|\d+\.)\s+", lines[i])
                    if sm and len(sm.group(1)) == lind:
                        break
                    if options_at(lines, i):
                        break
                    if sm and len(sm.group(1)) > lind:
                        sub_at = i
                        while i < n and lines[i].strip() and (not re.match(r"^(\s*)([-*]|\d+\.)\s+", lines[i]) or len(re.match(r"^(\s*)", lines[i]).group(1)) > lind):
                            sub.append(lines[i][lind + 2:] if len(lines[i]) > lind + 2 else lines[i].strip())
                            i += 1
                        break
                    text.append(lines[i].strip())
                    last = i
                    i += 1
                item = inline(" ".join(text))
                if sub:
                    item += render_md(sub, None if base is None else base + sub_at, shift + lind + 2, ctx, pick)
                out.append("<li%s>%s</li>" % (mark(last, content), item))
                # a blank line ends the list only if the next non-blank line is not a sibling
                if i < n and not lines[i].strip():
                    k = i
                    while k < n and not lines[k].strip():
                        k += 1
                    nm = re.match(r"^(\s*)([-*]|\d+\.)\s+", lines[k]) if k < n else None
                    if nm and len(nm.group(1)) == lind:
                        i = k
                        continue
                    break
            out.append("</%s>" % kind)
            continue
        buf = []
        first = i
        while i < n and lines[i].strip() and not STOP_RE.match(lines[i].strip()) \
                and not lines[i].strip().startswith(("|", ">")) and not fence_mark(lines[i]) \
                and not re.match(r"^(\s*)([-*]|\d+\.)\s+", lines[i]) \
                and not (i > first and options_at(lines, i)):
            buf.append(lines[i].strip())
            i += 1
        if not buf:
            buf.append(s)
            i += 1
        out.append("<p%s>%s</p>" % (mark(i - 1, ind(lines[first])), inline(" ".join(buf))))
    return "\n".join(out)


# ----------------------------------------------------------------------------- the page

# Mermaid (shape D2-B, entry S13, 2026-10-15): one pinned mermaid.min.js, inlined only into a page
# whose doc has a ```mermaid fence. Fetched, never vendored (the shareable scrub, 2026-10-23): the
# publish gate's word list matches inside the minified code, and every module file targets going
# public (root AGENTS.md, Rules), so the repo carries the version and the hash, and the file comes
# from the npm CDNs once, into the cache
# (KEEL_CACHE_DIR, else ~/Library/Caches/keel on a Mac, $XDG_CACHE_HOME/keel or ~/.cache/keel
# elsewhere). Both CDNs served the pinned bytes (read back 2026-10-23). A file that does not match the
# hash is never inlined or kept: the page shows the diagram's source (vendor/mermaid/README.md).
# KEEL_MERMAID_URL names one source instead (the suite's file:// stand-in); KEEL_MERMAID_FETCH=0 never
# fetches. The fetch runs inside callers with short deadlines (the checkpoint kills `sheep --hook` at
# 30 s, `keel line` waits 8 s for serve), hence the short timeout and, after a failed fetch, a marker
# beside the cache that holds every process off for MERMAID_RETRY (the landing review, 2026-10-23).
MERMAID_VERSION = "11.17.2"
MERMAID_SHA256 = "581ed7d74bd9048d0e3a91363927d72ef22942d7722546b27f7cc29e35390eb8"  # 11.17.2
MERMAID_URLS = tuple(u % MERMAID_VERSION for u in ("https://cdn.jsdelivr.net/npm/mermaid@%s/dist/mermaid.min.js",
                                                   "https://unpkg.com/mermaid@%s/dist/mermaid.min.js"))
MERMAID_MAX = 8 * 1024 * 1024
MERMAID_TIMEOUT = 8
MERMAID_RETRY = 600


def _keel_cache():
    if os.environ.get("KEEL_CACHE_DIR"):
        return Path(os.environ["KEEL_CACHE_DIR"])
    home = Path(os.environ.get("HOME") or Path.home())
    if sys.platform == "darwin":
        return home / "Library/Caches/keel"
    return Path(os.environ.get("XDG_CACHE_HOME") or home / ".cache") / "keel"


MERMAID_JS = _keel_cache() / ("mermaid-%s.min.js" % MERMAID_VERSION)
MERMAID_FENCE_RE = re.compile(r"^\s*(?:`{3,}|~{3,})\s*mermaid\b", re.I)
MERMAID_RUN = ('(function(){try{var dark=window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches'
               '&&document.documentElement.getAttribute("data-theme")!=="light";'
               'mermaid.initialize({startOnLoad:false,securityLevel:"strict",theme:dark?"dark":"default"});'
               'mermaid.run({querySelector:"pre.mermaid"}).catch(function(e){console.warn("mermaid:",e);});}'
               'catch(e){console.warn("mermaid:",e);}})();')
_MERMAID = []


def mermaid_fetch():
    """Fetch the pinned build: (bytes, None) or (None, why). The bytes are written to MERMAID_JS only
    when they match MERMAID_SHA256, by a rename, so a reader never sees half a file; a cache that cannot
    be written still returns them (the page draws, the next build fetches again). All sources together
    get MERMAID_TIMEOUT seconds, read in chunks against that deadline: urlopen's timeout bounds each
    socket call, not the download, and a trickle under it would outlast the caller (the B-gate review,
    2026-10-24)."""
    import hashlib
    import http.client
    import time
    import urllib.request
    whys = []
    deadline = time.monotonic() + MERMAID_TIMEOUT
    for url in ([os.environ["KEEL_MERMAID_URL"]] if os.environ.get("KEEL_MERMAID_URL") else MERMAID_URLS):
        left = deadline - time.monotonic()
        if left <= 0:
            whys.append("%s: no time left of %d s" % (url, MERMAID_TIMEOUT))
            continue
        try:
            with urllib.request.urlopen(url, timeout=left) as r:
                chunks, size = [], 0
                while True:
                    if time.monotonic() > deadline:
                        raise TimeoutError("not done in %d s" % MERMAID_TIMEOUT)
                    chunk = r.read(65536)
                    if not chunk:
                        break
                    chunks.append(chunk)
                    size += len(chunk)
                    if size > MERMAID_MAX:
                        break
                raw = b"".join(chunks)
        except (OSError, ValueError, http.client.HTTPException) as e:  # IncompleteRead is no OSError
            whys.append("%s: %s" % (url, getattr(e, "reason", None) or str(e) or type(e).__name__))
            continue
        got = hashlib.sha256(raw).hexdigest()
        if got != MERMAID_SHA256:
            whys.append("%s: sha256 %s…, pin %s…" % (url, got[:12], MERMAID_SHA256[:12]))
            continue
        tmp = MERMAID_JS.with_name(MERMAID_JS.name + ".%d.tmp" % os.getpid())
        try:
            MERMAID_JS.parent.mkdir(parents=True, exist_ok=True)
            tmp.write_bytes(raw)
            os.replace(tmp, MERMAID_JS)
        except OSError as e:
            print("keel: %s not cached (%s) — inlined this once" % (MERMAID_JS, e.strerror), file=sys.stderr)
            try:
                tmp.unlink()
            except OSError:
                pass
        return raw, None
    return None, "; ".join(whys)


def mermaid_source():
    """The pinned script, or None (with why on stderr): read from the cache, fetched there first when
    it is missing or not the pinned build, unless a fetch failed in the last MERMAID_RETRY seconds. A
    found script is kept for the process; a None only for MERMAID_RETRY, so the long-lived `keel serve`
    draws diagrams once the network is back (the B-gate review, 2026-10-24)."""
    import time
    if _MERMAID and (_MERMAID[0] is not None or time.time() - _MERMAID[1] < MERMAID_RETRY):
        return _MERMAID[0]
    del _MERMAID[:]
    import hashlib
    try:
        raw = MERMAID_JS.read_bytes()
    except OSError:
        raw = None
    stale = raw is not None and hashlib.sha256(raw).hexdigest() != MERMAID_SHA256
    if stale:
        raw = None
    if raw is None:
        failed = MERMAID_JS.with_name(MERMAID_JS.name + ".failed")
        try:
            recent = time.time() - failed.stat().st_mtime < MERMAID_RETRY
        except OSError:
            recent = False
        why = None
        if os.environ.get("KEEL_MERMAID_FETCH") == "0":
            why = "KEEL_MERMAID_FETCH=0"
        elif recent:
            why = "a fetch failed under %d min ago, %s" % (MERMAID_RETRY // 60, failed)
        if why is None:
            # the marker goes down before the fetch and comes off after a good one: a caller killed
            # mid-fetch (the checkpoint's 30 s) still holds the next processes off
            try:
                failed.parent.mkdir(parents=True, exist_ok=True)
                failed.write_text("fetching, pid %d\n" % os.getpid())
            except OSError:
                pass
            raw, said = mermaid_fetch()
            if raw is None:
                why = "Mermaid %s not fetched (%s)" % (MERMAID_VERSION, said)
                try:
                    failed.write_text(said + "\n")
                except OSError:
                    pass
            else:
                try:
                    failed.unlink()
                except OSError:
                    pass
        if raw is None:
            print("keel: %s%s — diagrams show as source"
                  % ("%s is not the pinned build; " % MERMAID_JS if stale else "no %s; " % MERMAID_JS, why),
                  file=sys.stderr)
            _MERMAID[:] = [None, time.time()]
            return None
    # `</script` inside the inlined text would end the tag early; the pinned build has none
    _MERMAID[:] = [raw.decode("utf-8").replace("</script", "<\\/script"), 0]
    return _MERMAID[0]


def mermaid_scripts(body):
    """The two <script> tags a page needs when its HTML holds a diagram, else ""."""
    if 'class="mermaid"' not in body:
        return ""
    src = mermaid_source()
    if not src:
        return ""
    return "<script>%s</script>\n<script>%s</script>" % (src, MERMAID_RUN)

