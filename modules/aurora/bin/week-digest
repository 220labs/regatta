#!/usr/bin/env python3
"""What the owner actually typed this week, per project — the raw material the dream (Aurora) reads.

    week-digest [--days 7] [--max-chars 400] [--scope <scope>]
    week-digest --json [--days 7] [--scope <scope>]
    week-digest --promote-tags [--scope <scope>]

A week of transcripts is hundreds of megabytes of tool output; the signal the dream needs is
the human side: requests, corrections, preferences, "remember this", "never do that again".
This prints only human-typed prompts (origin kind "human", IDE context blocks stripped),
grouped by project and session, oldest first, each cut to --max-chars. It reads the archive
(~/projects/transcripts, kept past Claude Code's 30-day sweep) and the live transcript
directory of every login dir (the core's login_dirs). A session found in more than one place (the archive's
copy and a live one: the archive is a copy of the live file, taken at some point) is merged by event uuid,
the newest file's copy of a prompt kept, so the prompts only one copy holds all count (the first file seen per
session id used to win, and dropped what the other held; evolve S11). A prompt counts
by its own timestamp, not its file's. A fork's prompts at or before its `forked-from` cutoff
are its source's and are skipped (bin/fork_claude_session.py; teleport design E1), and a prompt
another session of the project already holds, same time and same words, is not counted twice.
Read-only.

`--json` is the same read without the cut: one object, `sessions` (project, session, title, start,
source, and each prompt's `ts`, full `text` and `marked`) and `fenced` (the confidential sessions
counted, `sessions` only) — the input of plumb's `asks` (evolve S1). The text interface is unchanged.

Lines that look like corrections are marked `✱` so the dream can count repeats: they contain
"again", "still", "I told you", "don't", "never", "stop", "wrong", "remember", "always".

The fence (knowledge-layers S4): a session of a confidential scope (the registry's
`"confidential": true`, read through the core's gather_fence) is counted, never quoted — its own
scope's pass reads it. The verdict is judged from the path before the file is opened (evolve S1),
so a fenced transcript is counted by name and never read, and its prompts are not counted.
`--scope <scope>` reads that scope alone, a confidential one included.

`--promote-tags` is the dream's other raw read: every `<!-- promote:` line in a Markdown file
under the projects folder, as `grep -rn` prints it, never descending into a confidential scope's
folders (the grep it replaces walked them all).
"""
import datetime as dt
import json
import os
import re
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import find_core  # noqa: E402  the regatta core's hooks/; none: one line, exit 2
sys.path.insert(0, find_core.hooks())
import common  # noqa: E402  gather_fence, PROJECTS

HOME = Path.home()


def sources():
    """The archive, then the live transcript folder of every login dir here (evolve S1: the one
    the home login's alone missed every other login's sessions)."""
    return [common.PROJECTS / "transcripts"] + [d / "projects" for d in common.login_dirs()]
PROMOTE_TAG = "<!-- promote:"
IDE_BLOCK = re.compile(r"<(ide_\w+)>.*?</\1>", re.S)
COMMAND = re.compile(r"<command-message>.*?</command-message>\s*<command-name>(.*?)</command-name>"
                     r"(?:\s*<command-args>(.*?)</command-args>)?", re.S)
CORRECTION = re.compile(r"\b(again|still|i told you|don'?t|never|stop|wrong|remember|always)\b", re.I)


def arg(name, default):
    return type(default)(sys.argv[sys.argv.index(name) + 1]) if name in sys.argv else default


def stamp(epoch):
    return dt.datetime.fromtimestamp(epoch, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")


def events(path, since=""):
    """(session id, title, [(timestamp, text, event uuid)]); `since`: an ISO second, a prompt stamped
    before it is outside the window (the file's mtime only says when the last line was written). A line
    without a uuid has the empty one: merge() then keys it by its time and words."""
    sid = title = cut = None
    out = []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            sid = sid or r.get("sessionId")
            if r.get("type") == "forked-from":
                cut = r.get("cutoff")
                continue
            if r.get("type") == "summary" and r.get("summary"):
                title = r["summary"]
            if r.get("type") != "user" or (r.get("origin") or {}).get("kind") != "human":
                continue
            c = (r.get("message") or {}).get("content")
            text = c if isinstance(c, str) else " ".join(
                b.get("text", "") for b in (c or []) if isinstance(b, dict) and b.get("type") == "text")
            text = IDE_BLOCK.sub("", text)
            text = COMMAND.sub(lambda m: f"{m.group(1)} {m.group(2) or ''}".strip(), text).strip()
            if text:
                out.append((r.get("timestamp") or "", text, r.get("uuid") or ""))
    if cut:  # the record follows what it describes, so the skip waits for the whole file
        out = [x for x in out if x[0] > cut]
    if since:
        out = [x for x in out if x[0][:19] >= since]
    return sid, title, out


def prompts(path, since=""):
    """events() as it was before the merge: (session id, title, [(timestamp, text)]); plumb's suite loads it."""
    sid, title, ps = events(path, since)
    return sid, title, [(ts, text) for ts, text, _ in ps]


def merge(copies):
    """One session's prompts from all its copies, [(ts, text)] oldest first. `copies` is [(mtime, path,
    [(ts, text, uuid)])]; a prompt is one event, keyed by its uuid (by time and words where a line has none),
    and the copy of the newest file replaces an older file's. A copy with an event the other lacks adds it."""
    held = {}
    for _, path, ps in sorted(copies, key=lambda c: (c[0], str(c[1]))):
        for ts, text, uid in ps:
            held[uid or (ts, text)] = (ts, text)
    return sorted(held.values(), key=lambda x: x[0])


def project_of(path):
    """Archive: transcripts/<repo>/…; live: projects/<slug>/… — the slug's last segment,
    with a worktree suffix folded back into its repo."""
    if path.parts[-3] == "transcripts":
        return path.parent.name
    slug = path.parent.name
    slug = slug.split("--claude-worktrees-")[0]
    return slug.rsplit("-projects-", 1)[-1] if "-projects-" in slug else slug


def promote_tags(fence, scope=None):
    """`grep -rn "<!-- promote:" <projects>/*/ --include='*.md'`, the fence applied: a confidential
    scope's folder is never descended into (counted), and under --scope a file outside it is never
    read. Returns (lines, folders fenced)."""
    hits, fenced = [], 0
    tops = sorted(p for p in common.PROJECTS.iterdir() if p.is_dir() and not p.name.startswith(".")) \
        if common.PROJECTS.is_dir() else []
    for top in tops:
        for d, subs, files in os.walk(top):
            if fence(d) == "fenced":
                fenced += 0 if scope else 1  # a scoped pass does not even count another scope
                subs[:] = []
                continue
            subs[:] = sorted(x for x in subs if x != ".git")
            for f in sorted(files):
                p = os.path.join(d, f)
                if not f.endswith(".md") or fence(p) != "quote":
                    continue
                try:
                    with open(p, encoding="utf-8", errors="replace") as fh:
                        hits += [f"{p}:{n}:{l.rstrip()}" for n, l in enumerate(fh, 1) if PROMOTE_TAG in l]
                except OSError:
                    continue
    return hits, fenced


def main():
    days = arg("--days", 7)
    limit = arg("--max-chars", 400)
    if "--scope" in sys.argv and (sys.argv[-1] == "--scope" or sys.argv[sys.argv.index("--scope") + 1].startswith("--")):
        print("week-digest: --scope needs a scope's name", file=sys.stderr)
        return 2
    scope = arg("--scope", "") or None
    try:
        fence = common.gather_fence(scope)
    except ValueError as e:
        print(f"week-digest: {e}", file=sys.stderr)
        return 2
    if "--promote-tags" in sys.argv:
        hits, fenced = promote_tags(fence, scope)
        print("\n".join(hits) if hits else f"(no {PROMOTE_TAG} tags)")
        if fenced:
            print(f"({fenced} folder(s) of a confidential scope not read — its own pass reads them)")
        return 0
    cutoff = time.time() - days * 86400
    since = stamp(cutoff)
    seen, held, by_project, fenced_seen = set(), set(), {}, set()
    copies, order = {}, []   # a session's copies by its id (or file stem), in the order the sources name them
    for root in sources():
        for f in sorted(root.glob("*/*.jsonl")):
            mtime = f.stat().st_mtime
            if mtime < cutoff:
                continue
            verdict = fence(f)   # from the path, before the file is opened
            if verdict == "outside" or scope and verdict != "quote":   # under --scope, only its own counts
                continue
            if verdict == "fenced":   # counted by name, never opened
                fenced_seen.add(f.stem)
                continue
            sid, title, ps = events(f, since)
            key = sid or f.stem
            if not ps:
                continue
            if key not in copies:
                order.append(key)
            copies.setdefault(key, []).append((mtime, f, ps, title))
    for key in order:
        group = copies[key]
        f = group[0][1]   # the first source's copy names the project (the archive's, where there is one)
        ps = merge([(m, p, x) for m, p, x, _ in group])
        title = next((t for m, p, x, t in sorted(group, key=lambda c: (c[0], str(c[1])), reverse=True) if t), None)
        seen.add(key)
        project = project_of(f)
        fresh = []
        for ts, text in ps:   # a fork's copy of a prompt another session holds
            ident = (project, ts, text)
            if ident not in held:
                held.add(ident)
                fresh.append((ts, text))
        if fresh:
            by_project.setdefault(project, []).append(
                (fresh[0][0], key, title, fresh, "archive" if max(group, key=lambda c: (c[0], str(c[1])))[1].parts[-3] == "transcripts" else "live"))
    if "--json" in sys.argv:
        print(json.dumps({
            "generated": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "days": days,
            "scope": scope, "fenced": {"sessions": len(fenced_seen)},
            "sessions": [{"project": project, "session": key, "title": title, "start": start, "source": source,
                          "prompts": [{"ts": ts, "text": text, "marked": bool(CORRECTION.search(" ".join(text.split())))}
                                      for ts, text in ps]}
                         for project in sorted(by_project) for start, key, title, ps, source in sorted(by_project[project])]},
            ensure_ascii=False))
        return 0
    total = sum(len(s[3]) for v in by_project.values() for s in v)
    marked = 0
    print(f"# Week digest — last {days} days, {len(seen)} sessions, {total} prompts "
          f"({dt.date.today().isoformat()})" + (f" — scope {scope}" if scope else "") + "\n")
    for project in sorted(by_project):
        print(f"## {project}\n")
        for start, key, title, ps, _ in sorted(by_project[project]):
            print(f"### {start[:16].replace('T', ' ')} · {key[:8]}" + (f" · {title}" if title else ""))
            for ts, text in ps:
                flat = " ".join(text.split())
                mark = "✱ " if CORRECTION.search(flat) else "- "
                marked += mark == "✱ "
                print(f"{mark}{flat[:limit]}{' […]' if len(flat) > limit else ''}")
            print()
    if fenced_seen:
        print(f"_{len(fenced_seen)} sessions of a confidential scope: counted, never opened — "
              "its own pass reads them._\n")
    print(f"_{marked} prompts marked ✱ as possible corrections — read them, don't count them blindly._")
    return 0


if __name__ == "__main__":
    sys.exit(main())
