#!/usr/bin/env python3
"""pitch: hold a document's renders to the method, and build its decks and its page.

    pitch check <docs-root|document.md> [--config pitch.json] [--json]
    pitch build <deck folder>|<document.md> [--deck admiral|commodore|all] [--config pitch.json] [--check]
    pitch memo <document.md> [--config pitch.json] [--check] [--replace]
    pitch review <document.md>
    pitch renders <document.md> [--config pitch.json] [--links]
    pitch calibrate glyphs|render [<docs-root>] [--config pitch.json] [--shots DIR]

`check` holds every render of every document under a root to the method: the admiral deck to its
rules, every folder deck to the furniture rules, the captain renders to their floor and their
allowlist, the commodore deck to the admiral's rules at its own limits and to its links, and every
render to the claims its document makes. Given one document, it checks that
document and its renders only. Exit 0 clean, 1 on any finding, each finding a rule id and a message;
2 when the check could not run (no config, no such path, a render it cannot parse), so a caller never
reads a crash as a finding (AGENTS.md's trap: a probe's "refuse" exit must not be 1).

`build` writes a deck's slides from where its words live: the ```deck fence at its document's end,
or, for the admiral alone, the export's content file (`slides.json`) beside the deck, never both. A
deck folder builds that deck; a document builds `--deck admiral` (the spoken deck), `commodore` (the
sent one, from the fence only) or `all`, and by default the admiral plus the commodore once its folder
exists, so a corrected fence rebuilds both. Every deck named is built in memory first: when any slide
of any of them breaks a rule, nothing is written. `--check` compares only, exit 1 on drift (a slide
edited by hand, which the next build would silently revert). Given a document with a fence, it makes
a deck's folder and a first `deck.json` if there are none. Exit 1 on a refusal or drift, 2 when it
could not run.

`memo` writes the captain page, `<stem>-memo.html`, from the document's Markdown; a block it cannot
place (raw HTML, an image, a diagram) is listed by line and nothing is written, exit 1. It will not
overwrite a page it did not write unless `--replace` says to. `--check` compares only.

`review` holds a captain review (a document whose title ends `(captain review, <date>)`) to its
template, skills/captain/TEMPLATE.md, before any render exists; `check` holds the same rules once
there are renders. It needs no config. `renders` lists a document's renders and the URL its sidecar
records for each; `--links` prints them as one Markdown line, exit 1 when one is unpublished.

`calibrate` holds the fit estimate to headless Chrome, by hand: `glyphs` measures the config's face
and writes its `face.glyphs` table, `render` lays every admiral slide under the root out and compares
line counts with the estimate (exit 1 on a difference; `--shots` writes a PNG per slide). It needs
Chrome and the network, so no check calls it. Exit 2 when it could not run (no Chrome, no deck, the
face did not load).

The config is `pitch.json`, found at or above the root (or the deck) unless --config names one; a
config may start with "extends": "<another config>", relative to itself. Anything left out takes
the default in pitchlib.py (DEFAULTS). Every key: skills/pitch/config.md; the method behind every
rule: skills/pitch/method.md.

Pairing is by file name beside the document `<root>/<stem>.md` (every suffix is a parameter):
  <stem>-admiral-deck/project/   the admiral render: deck.json + slides/<id>.html, and the builder's
                                 content file in <stem>-admiral-deck/
  <stem>-commodore-deck/project/ the commodore render, sent and read alone, from the deck fence
  <stem>-deck/project/           a folder deck that is not admiral (Slides-type, captain density)
  <stem>-memo.html               the captain render, a plain page
  <stem>-deck.html               a single-file deck, slides as JavaScript template literals
  <stem>.pitch.json              the sidecar: where each render was published (its shape is checked)
  ```deck … ``` in <stem>.md     both decks' words; cut from what the number, pin and link checks read

Why every check refuses to be vacuous: the first version of the pairing suite this comes from was
mutation-tested and found to skip everything, green, the moment a deck was renamed.
"""
import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True          # no __pycache__ beside the module's tools
sys.path.insert(0, str(Path(__file__).resolve().parent))   # this file's own folder, never the shell's
import pitchlib as pl  # noqa: E402


class CouldNotRun(Exception):
    """The verb could not do its job: exit 2, never the 1 a finding or a refusal exits."""


def cmd_check(a):
    target = Path(a.target).resolve()
    only = None
    if target.is_file():
        cfg = pl.find_config(target.parent, a.config)
        if target not in pl.documents(target.parent, cfg):
            sys.exit(f"pitch check: {target.name} is not a document here ({cfg.naming['documents_glob']})")
        root, only = target.parent, target.stem
    elif target.is_dir():
        root, cfg = target, pl.find_config(target, a.config)
    else:
        sys.exit(f"pitch check: no such file or folder: {a.target}")
    findings = pl.check_root(root, cfg, only)
    if a.json:
        print(json.dumps([{"rule": r, "message": m} for r, m in findings], indent=1, ensure_ascii=False))
    else:
        for r, m in findings:
            print(f"{r:28} {m}")
        print(f"{len(findings)} finding(s)")
    return 1 if findings else 0


def cmd_build(a):
    target = Path(a.deck).resolve()
    cfg = pl.find_config(target.parent if target.is_file() else target, a.config)
    md = None
    if target.is_file():
        md = target
        kinds = {"admiral": ["admiral"], "commodore": ["commodore"], "all": ["admiral", "commodore"]}.get(a.which)
        if kinds is None:               # the default: the admiral, and the commodore once it is built
            built_commodore = md.with_name(md.stem + cfg.naming["commodore_suffix"]).is_dir()
            slides = []
            for _, body in pl.deck_fences(md.read_text(encoding="utf-8"), cfg)[:1]:
                try:
                    slides = json.loads(body)
                except ValueError:
                    pass                # the builder's own refusal names it
            slides = slides if isinstance(slides, list) else []
            kinds = (["admiral"] if pl.admiral_wanted(slides) else []) + (["commodore"] if built_commodore else [])
        decks = [md.with_name(md.stem + cfg.naming[f"{k}_suffix"]) for k in kinds]
    else:
        decks = [target]
    fenced = md is not None and bool(pl.deck_fences(md.read_text(encoding="utf-8"), cfg))
    plans = []
    for deck_dir in decks:
        # A document's fence builds a deck that has no folder yet; its folder is made only once every
        # slide has passed, so a refused first build leaves nothing behind for the check to call an orphan.
        first = fenced and not deck_dir.is_dir()
        if md is not None and not fenced and pl.deck_kind(deck_dir, cfg) == "commodore":
            sys.exit(f"no deck fence in {md.name}: the commodore deck is built from the fence alone")
        if not deck_dir.is_dir() and not first:
            raise CouldNotRun(f"pitch build: no deck folder at {deck_dir}")
        kind = pl.deck_kind(deck_dir, cfg)
        if kind is None:
            # stem_of() cuts the suffix by length: any other folder would yield a wrong stem and keys
            raise CouldNotRun(f"pitch build: {deck_dir.name} is not an admiral deck (<stem>{cfg.naming['admiral_suffix']}) "
                              f"or a commodore deck (<stem>{cfg.naming['commodore_suffix']})")
        if a.which and md is None and a.which not in ("all", kind):
            raise CouldNotRun(f"pitch build: {deck_dir.name} is the {kind} deck, not --deck {a.which}")
        plans.append((deck_dir, first, pl.build_all(deck_dir, cfg)))
    # Only now, every deck built in memory: a refusal in the second leaves the first untouched too.
    for deck_dir, first, built in plans:
        slide_dir = deck_dir / "project" / "slides"
        if a.check and first:
            sys.exit(f"{deck_dir.name} is not built yet: `pitch build {md.name}"
                     f"{'' if pl.deck_kind(deck_dir, cfg) == 'admiral' else ' --deck commodore'}`")
        if a.check:
            drifted = [sid for sid, html, _ in built
                       if not (slide_dir / f"{sid}.html").exists()
                       or (slide_dir / f"{sid}.html").read_text(encoding="utf-8") != html]
            if drifted:
                sys.exit(f"{deck_dir.name}: slides on disk differ from what {pl.deck_source(deck_dir, cfg)[0]} says: "
                         f"{drifted} — a render was edited by hand, which the next build would silently revert")
            print(f"{len(built)} slides match the generator ({deck_dir.name})")
            continue
        slide_dir.mkdir(parents=True, exist_ok=True)
        for sid, html, _ in built:
            (slide_dir / f"{sid}.html").write_text(html, encoding="utf-8")
        print(f"{deck_dir.name}: {len(built)} slides written:\n  " + "\n  ".join(b[2] for b in built))
        index = deck_dir / "project" / "deck.json"
        doc = md or deck_dir.parent / (pl.stem_of(deck_dir, cfg) + ".md")
        if not index.exists() and doc.exists():
            index.write_text(json.dumps(pl.deck_index(doc, [b[0] for b in built], cfg), indent=2, ensure_ascii=False)
                             + "\n", encoding="utf-8")
            print(f"a first {index.relative_to(deck_dir.parent)}: its order is the deck's, and from now on it is yours")
    return 0


def cmd_memo(a):
    md = Path(a.doc).resolve()
    if not md.is_file():
        raise CouldNotRun(f"pitch memo: no such document: {a.doc}")
    try:
        cfg = pl.find_config(md.parent, a.config)
    except SystemExit as e:             # no config: could not run, never the refusal's 1
        raise CouldNotRun(e.code)
    path = md.with_name(md.stem + cfg.naming["memo_suffix"])
    page, unplaced = pl.memo_page(md, cfg)
    if unplaced:
        print("\n".join(f"captain.unplaced             {md.name}:{n}: {what}" for n, what in unplaced))
        sys.exit(f"{len(unplaced)} block(s) the page cannot place; nothing written")
    on_disk = path.read_text(encoding="utf-8") if path.exists() else None
    if a.check:
        if on_disk != page:
            sys.exit(f"{path.name} differs from what `pitch memo` writes from {md.name}")
        print(f"{path.name} matches its document")
        return 0
    if on_disk is not None and pl.MEMO_MARK not in on_disk and not a.replace:
        sys.exit(f"{path.name} was not written by `pitch memo`; --replace overwrites it (its words must be in "
                 f"{md.name} first)")
    path.write_text(page, encoding="utf-8")
    print(f"{path.name} written from {md.name}")
    return 0


def cmd_review(a):
    md = Path(a.doc)
    if not md.is_file():
        raise CouldNotRun(f"pitch review: no such document: {a.doc}")
    text = md.read_text(encoding="utf-8")
    findings = pl.review_problems(text, md.name) if pl.is_review(text) else [
        ("review.title", f"{md.name}: not a captain review; its title ends `(captain review, <yyyy-mm-dd>)`")]
    for r, m in findings:
        print(f"{r:28} {m}")
    print(f"{len(findings)} finding(s)")
    return 1 if findings else 0


def cmd_renders(a):
    md = Path(a.doc).resolve()
    if not md.is_file():
        raise CouldNotRun(f"pitch renders: no such document: {a.doc}")
    cfg = pl.find_config(md.parent, a.config)
    found = pl.published_links(md, cfg)
    if a.links:
        recorded = [(label, path, url) for label, path, url, rec in found if rec]
        line = " | ".join(f"[{label}]({url})" for label, _, url in recorded if url)
        missing = [f"{label} ({path.name}) has no URL in {md.stem}{cfg.naming['sidecar_suffix']}"
                   for label, path, url in recorded if not url]
        if line:
            print(line)
        for m in missing or ([] if recorded else [f"{md.name} has no render the sidecar records"]):
            print(f"pitch renders: {m}", file=sys.stderr)
        return 1 if missing or not recorded else 0
    for label, path, url, rec in found:
        print(f"{label:13} {path.name:44} {url or ('not published' if rec else 'not recorded by the sidecar')}")
    return 0


def cmd_calibrate(a):
    # `glyphs` does not read the table it writes: it may not exist yet, or measure the old face.
    # `render` reads it, since the estimate it holds to Chrome is the one the check makes.
    cfg = pl.find_config(a.root, a.config, load_glyphs=a.what != "glyphs")
    if a.what == "glyphs":
        pl.measure_glyphs(cfg)
        return 0
    return pl.calibrate_render(Path(a.root).resolve(), cfg, a.shots)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="pitch", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="\n".join(__doc__.split("\n")[2:8]))
    sub = ap.add_subparsers(dest="verb", metavar="check|build|memo|review|renders|calibrate")
    sub.required = True
    c = sub.add_parser("check", help="hold a docs root, or one document, to the method; exit 1 on a finding")
    c.add_argument("target", metavar="root|doc")
    c.add_argument("--config")
    c.add_argument("--json", action="store_true")
    b = sub.add_parser("build", help="write a deck's slides from its deck fence or content file")
    b.add_argument("deck", metavar="deck|doc", help="a <stem>-admiral-deck or <stem>-commodore-deck folder, or its document")
    b.add_argument("--deck", dest="which", choices=["admiral", "commodore", "all"],
                   help="given a document: which deck (default: the admiral, and the commodore once it is built)")
    b.add_argument("--config")
    b.add_argument("--check", action="store_true", help="compare only; exit 1 on drift")
    m = sub.add_parser("memo", help="write the captain page from the document's Markdown")
    m.add_argument("doc", metavar="doc")
    m.add_argument("--config")
    m.add_argument("--check", action="store_true", help="compare only; exit 1 on drift")
    m.add_argument("--replace", action="store_true", help="overwrite a page `pitch memo` did not write")
    r = sub.add_parser("review", help="hold a captain review to its template; no config needed")
    r.add_argument("doc", metavar="doc")
    n = sub.add_parser("renders", help="a document's renders and the URL its sidecar records for each")
    n.add_argument("doc", metavar="doc")
    n.add_argument("--config")
    n.add_argument("--links", action="store_true", help="one Markdown line of links; exit 1 when one is missing")
    k = sub.add_parser("calibrate", help="hold the fit estimate to headless Chrome (by hand; never in a check)")
    k.add_argument("what", choices=["glyphs", "render"])
    k.add_argument("root", nargs="?", default=".", help="where the config is found; render's docs root")
    k.add_argument("--config")
    k.add_argument("--shots", metavar="DIR", help="render: one PNG per slide into DIR")
    a = ap.parse_args(argv)
    try:
        if a.verb in ("check", "calibrate", "review", "renders"):
            try:
                return {"check": cmd_check, "calibrate": cmd_calibrate, "review": cmd_review,
                        "renders": cmd_renders}[a.verb](a)
            except SystemExit as e:     # their own refusals (no config, no such path, no Chrome): could not run
                if isinstance(e.code, int):
                    raise
                raise CouldNotRun(e.code)
        return cmd_memo(a) if a.verb == "memo" else cmd_build(a)   # their sys.exit(message): a refusal, exit 1
    except (CouldNotRun, pl.ConfigError) as e:
        print(e, file=sys.stderr)
        return 2
    except Exception:                   # a crash is "could not tell", never a finding
        import traceback
        traceback.print_exc()
        return 2


if __name__ == "__main__":
    sys.exit(main())
