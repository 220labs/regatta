#!/usr/bin/env python3
"""regatta — the core's command line: where the core, a module and a tool are; the config check;
the shims an old path keeps while its file moves. Stdlib, Python 3.9.

    regatta root                the regatta checkout the core belongs to (exit 1: none)
    regatta has <module>        the module's path, or "<module> not installed" (exit 1)
    regatta which <tool>        a peer's path through common.tool(), or "<tool> not installed" (exit 1)
    regatta check               the config directory: home, the overlay, each link with its target, the private values,
                                aurora/host against lighthouse/hosts, each scope's yard, the fleet queue's home and sweep
    regatta shim <path>         the shim an old path keeps for <path> (relative to the root): a
                                source shim for a Python file, an exec shim for any other
    regatta shim --hook <path>  a hook's source shim: run with no core, one line and exit 0 (C4)
    regatta shim --deny <path>  a deny hook's source shim: run as a hook with no core, it refuses a
                                PreToolUse call instead of dying (C4)
    regatta shim --deny-prompt <path>
                                the same, and it also blocks a prompt in a secondary login dir
                                (CLAUDE_CONFIG_DIR set): for a prompt guard (account_guard)
    regatta weekly-host <job> [--scope <scope>]
                                whether this host runs weekly job <job> (common.weekly_host): its notes,
                                then its line; exit 0 run, 3 skip, 4 refuse, 5 closed (a scope's
                                registry does not read) — never 1, a crash's code. The installers ask it
    regatta <name> [args…]      run a tool kept off PATH (C1: `pr`, `helm`) from its module

Why a CLI and not one more name on PATH per tool: a plugin's `bin/` is appended last to the Bash
PATH, so `/usr/bin/pr` or an installed `helm` would win over a module's (the design's C1).
"""
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
if sys.argv[1:] == ["check"]:
    # The check is the one caller that must load the core whatever the config dir holds: it sets
    # _REGATTA_CHECK before the module runs, so a missing private value is reported, not raised.
    import importlib.util
    _spec = importlib.util.spec_from_file_location("common", str(Path(sys.path[0]) / "common.py"))
    common = importlib.util.module_from_spec(_spec)
    common._REGATTA_CHECK = True
    sys.modules["common"] = common
    _spec.loader.exec_module(common)
else:
    import common  # noqa: E402

SOURCE_SHIM = '''#!/usr/bin/env python3
# Source shim: this file moved to the regatta checkout, at {rel}.
# Its source runs here, in this module, with __file__ set to that path, so `import`,
# load_module, exec_module and a run as a script all behave as the file itself (design P5).
# Made by `regatta shim {made}`; regenerate, never edit.
def _regatta_load(rel):
    import os
    home = os.environ.get("REGATTA_HOME")
    if not home:
        f = os.path.join(os.path.expanduser(os.environ.get("REGATTA_CONFIG") or "~/.config/regatta"), "home")
        try:
            with open(f) as fh:
                home = fh.readline().strip()
        except OSError:
            raise ImportError("regatta: core not found: no REGATTA_HOME and no %s (clone the regatta repo, "
                              "then run its install.sh, or your overlay's bootstrap.sh --config)" % f)
        if not home:
            raise ImportError("regatta: core not found: %s is empty" % f)
    path = os.path.join(os.path.expanduser(home), rel)
    if not os.path.isfile(path):
        raise ImportError("regatta: core missing at %s" % path)
    # The loader, not open(): it decodes as import does (UTF-8, PEP 263), whatever the locale,
    # and keeps the core's .pyc, so a hook does not recompile the core on every call.
    from importlib.machinery import SourceFileLoader
    return path, SourceFileLoader("_regatta_core", path).get_code("_regatta_core")


'''

# A deny hook's shim (C4): the same load, but run as a hook with no core to load from, it refuses
# instead of dying — exit 1 is "no objection" to Claude Code, and the hook's own fail-closed path
# lives in the module the shim cannot reach. A PreToolUse call is denied whole, in one line that
# names the fix; any other event gets the line on stderr and exit 0. Imported, it raises as ever.
# Any load failure, not ImportError alone: a conflicted pull leaves a SyntaxError, a bad mode an
# OSError, and either would die with exit 1 (B5 review). One call passes: a plain `git -C <dir>
# fetch` or `pull --ff-only`, no shell operators and no option word but a harmless few (never
# `--upload-pack`), so a checkout that predates the module can be
# fast-forwarded from the session itself, as the hook's own core_missing() allows.
DENY_TAIL = '''try:
    __file__, _regatta_code = _regatta_load({rel_py})
except Exception as _regatta_exc:
    if __name__ != "__main__":
        raise
    import json as _json, sys as _sys
    _sys.stderr.write("%s (a deny hook: refusing)\\n" % _regatta_exc)
    try:
        _event = _json.loads(_sys.stdin.read() or "{{}}")
    except ValueError:
        _event = {{}}
    _cmd = str(((_event.get("tool_input") or {{}}) if isinstance(_event, dict) else {{}}).get("command") or "")
    import re as _re
    _repair = bool(_re.fullmatch(r"\\s*git -C [\\w./~][\\w./~-]* (fetch|pull --ff-only)( [\\w./][\\w./-]*| --all| --prune| -q| --quiet| -v)*\\s*", _cmd))
    if isinstance(_event, dict) and _event.get("hook_event_name") == "PreToolUse" and not _repair:
        print(_json.dumps({{"hookSpecificOutput": {{"hookEventName": "PreToolUse", "permissionDecision": "deny",
              "permissionDecisionReason": "\\u26d4 %s. This hook cannot judge the call without it, so it refuses it; "
                                          "run the fix in a terminal, or `git -C <the core\\'s checkout> pull --ff-only`, which it lets through." % _regatta_exc}}}}))
    _sys.exit(0)
del _regatta_load
exec(_regatta_code)
'''
# A prompt guard's shim (`--deny-prompt`, B9 review): DENY_TAIL, and with no core a UserPromptSubmit
# in a secondary login dir (CLAUDE_CONFIG_DIR set) is blocked too, as lighthouse's account_guard
# blocks when bin/account cannot run. Only for a hook whose module fails closed on prompts:
# checkpoint.py's `--deny` lets a prompt pass on purpose (B5's deny proof 2), and the default
# login, which holds the repair, is never blocked.
DENY_PROMPT_TAIL = DENY_TAIL.replace('''    _sys.exit(0)
del _regatta_load''', '''    if (isinstance(_event, dict) and _event.get("hook_event_name") == "UserPromptSubmit"
            and __import__("os").environ.get("CLAUDE_CONFIG_DIR")):
        print(_json.dumps({{"decision": "block", "reason": "\\u26d4 %s. This guard cannot check the login without it, "
              "so it blocks the prompt; in a terminal, `git -C <the core\\'s checkout> pull --ff-only` or the fix it names, then send it again." % _regatta_exc}}))
    _sys.exit(0)
del _regatta_load''', 1)
assert DENY_PROMPT_TAIL != DENY_TAIL, "DENY_PROMPT_TAIL's anchor is gone from DENY_TAIL"
# Any other hook's shim (C4: a hook runs to a quiet exit with the core missing): run as a hook
# with no core, one line on stderr and exit 0 — never exit 1's traceback at every session start,
# never exit 2, which on UserPromptSubmit erases the prompt. Imported, it raises as ever.
HOOK_TAIL = '''try:
    __file__, _regatta_code = _regatta_load({rel_py})
except Exception as _regatta_exc:
    if __name__ != "__main__":
        raise
    import sys as _sys
    _sys.stderr.write("%s\\n" % _regatta_exc)
    _sys.exit(0)
del _regatta_load
exec(_regatta_code)
'''
SOURCE_TAIL = '''__file__, _regatta_code = _regatta_load({rel_py})
del _regatta_load
exec(_regatta_code)
'''

EXEC_SHIM = '''#!/usr/bin/env bash
# Exec shim: this file moved to the regatta checkout, at {rel}.
# Made by `regatta shim {rel}`; regenerate, never edit.
home=${{REGATTA_HOME:-$(head -1 "${{REGATTA_CONFIG:-$HOME/.config/regatta}}/home" 2>/dev/null)}}
home=${{home/#\\~/$HOME}}
[ -n "$home" ] || {{ echo "regatta: core not found: no REGATTA_HOME and no ${{REGATTA_CONFIG:-$HOME/.config/regatta}}/home (clone the regatta repo, then run its install.sh, or your overlay's bootstrap.sh --config)" >&2; exit 127; }}
exec "$home/"{rel_sh} "$@"
'''


TAILS = {None: SOURCE_TAIL, "--hook": HOOK_TAIL, "--deny": DENY_TAIL, "--deny-prompt": DENY_PROMPT_TAIL}


def shim(rel, kind=None):
    root = common.regatta_root()
    target = (root / rel) if root else None
    if not target or not target.is_file():
        print("regatta shim: no %s under %s" % (rel, root), file=sys.stderr)
        return 1
    first = target.read_text(encoding="utf-8", errors="replace").split("\n", 1)[0]
    python = target.suffix == ".py" or "python" in first
    if kind and not python:
        print("regatta shim %s: %s is no Python hook" % (kind, rel), file=sys.stderr)
        return 2
    text = (SOURCE_SHIM + TAILS[kind]) if python else EXEC_SHIM
    made = (kind + " " if kind else "") + rel
    sys.stdout.write(text.format(rel=rel, made=made, rel_py=repr(rel), rel_sh=shlex.quote(rel)))
    return 0


def module_keys():
    """The private values the modules here declare: each `config-keys` file (one key per line, `#`
    comments) in a module of the checkout above the core, or of an installed plugin's root."""
    root = common.regatta_root()
    dirs = sorted(p for p in (root / "modules").iterdir() if p.is_dir()) if root else []
    dirs += [base for _plugin, base in common._installed_roots() if base not in dirs]
    keys = []
    for d in dirs:
        try:
            lines = (d / "config-keys").read_text(encoding="utf-8-sig").splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        keys += [k.strip() for k in lines if k.strip() and not k.strip().startswith("#") and k.strip() not in keys]
    return keys


def module_problems():
    """One line per module key that is unreadable, or missing where an overlay is installed — the
    module refuses at use (orca-host's config_map), so a key it needs is said here, never by the
    core's import: a module's key never stops the core loading."""
    overlay = common.overlay_installed()
    out = []
    for k in module_keys():
        lines, why = common.config_read(k)
        if why:
            out.append("%s unreadable (%s)" % (k, why))
        elif lines is None and overlay:
            out.append("%s missing" % k)
    return out


def weekly_host_problems():
    """`aurora/host`, the one host the weekly jobs run on (common.weekly_host): a key that names no
    host or several is a finding, and so is a host `lighthouse/hosts` does not list, where that key
    exists — as yard_rows checks yards: no host of the fleet would run the night. Case-blind, as the
    rule compares. Absent or unreadable is module_problems' (aurora's config-keys lists the key)."""
    lines, why = common.config_read("aurora/host")
    if why or lines is None:
        return []
    if len(lines) != 1:
        return ["aurora/host %s: the weekly jobs refuse" % ("names no host" if not lines else "has %d lines, and names one host" % len(lines))]
    # host_name() prints only [a-z0-9-]: a name outside that never matches, on any host
    if re.sub(r"[^a-z0-9-]", "-", lines[0].lower()).strip("-") != lines[0].lower():
        return ["aurora/host names %s, which no host's name can be (host names are letters, digits and -): no host runs the weekly jobs" % lines[0]]
    hosts = common.config_lines("lighthouse/hosts")
    if hosts is not None and lines[0].lower() not in [h.lower() for h in hosts]:
        return ["aurora/host names %s, which lighthouse/hosts does not list (%s): no host here runs the weekly jobs"
                % (lines[0], ", ".join(hosts) or "it lists none")]
    return []


def yard_rows():
    """One row per scope of the registry: its yard (common.scope_yard), or none. A yard is a host
    `lighthouse/hosts` lists — the fleet's one list of Macs — else it is a finding: `wharf apply
    --yard` would send ships to a host nothing else here knows. → the number of findings. No
    registry, no rows; a registry that does not read is one finding, its rows skipped."""
    p = common.repos_json()
    if not p:
        return 0
    if common.registry_unreadable():
        print("  --  scopes: %s does not read, so no scope's yard is checked" % p)
        return 1
    hosts = common.config_lines("lighthouse/hosts") or []
    bad = 0
    for name in common.scope_registry()[1]:
        yard = common.scope_yard(name)
        if yard and yard not in hosts:
            print("  --  scope %s yard: %s is not a host lighthouse/hosts lists (%s)" % (name, yard, ", ".join(hosts) or "it lists none"))
            bad += 1
        else:
            print("  ok  scope %s yard: %s" % (name, yard or "none"))
    return bad


def berth_problems():
    """The registry's `scopes.<name>.berths` (skipper-modes S6): a list of host names, each one a host
    some repo of the registry is cloned on — the names come from the registry itself, never a list
    here. A typo would place every run of the scope nowhere."""
    p = common.repos_json()
    try:
        d = json.loads(p.read_text(encoding="utf-8")) if p else {}
    except (OSError, ValueError):
        return []
    known = {h for r in (d.get("repos") or {}).values() if isinstance(r, dict) for h in r.get("hosts") or []}
    out = []
    for name, sc in (d.get("scopes") or {}).items():
        b = sc.get("berths") if isinstance(sc, dict) else None
        if b is None:
            continue
        if not isinstance(b, list) or not all(isinstance(h, str) and h for h in b):
            out.append("registry: scope %s's berths is a list of host names" % name)
        elif set(b) - known:
            out.append("registry: scope %s's berths name %s, which no repo is cloned on" % (name, ", ".join(sorted(set(b) - known))))
    return out


def queue_rows():
    """The fleet queue's two rows (wharf-runs' dispatch-queue; S2 of the dispatch-queue design): its home,
    and the queue-sweep job that claims what waits for this host. A home with no sweep is a finding: a
    queued entry would wait for some unrelated dispatch here (any dispatch run here installs the job:
    `dispatch-queue jobs`). No home, no rows: the queue is off and dispatch runs as before it. Read as
    text, as hookwatch's pin is below: the core loads no module. → the number of findings."""
    v = (common.config_line("wharf-runs/queue-repo") or "").strip()
    if not v or v.lower() == "off":
        return 0
    print("  ok  queue home: %s" % v)
    if sys.platform != "darwin":
        print("  ..  queue-sweep: no launchd here (its systemd timer is dispatch-queue's S7)")
        return 0
    prefix = common.config_line("wharf-runs/label-prefix") or "org.regatta.claude"
    job = Path.home() / "Library" / "LaunchAgents" / ("%s.queue-sweep.plist" % prefix)
    if job.is_file():
        # the file is not the job: launchd must hold it (S2a's landing review, item 3). DISPATCH_LAUNCHCTL
        # is dispatch's own stand-in, which the suites set
        lc = os.environ.get("DISPATCH_LAUNCHCTL") or "launchctl"
        try:
            held = subprocess.run([lc, "print", "gui/%d/%s.queue-sweep" % (os.getuid(), prefix)],
                                  capture_output=True, timeout=10).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            held = False
        if held:
            print("  ok  queue-sweep: every 10 min (%s)" % job)
            return 0
        print("  --  queue-sweep: its plist is here but launchd does not hold it (%s) — any dispatch run here "
              "reloads it (dispatch-queue jobs)" % job)
        return 1
    print("  --  queue-sweep: no job here (%s) — a queued entry waits for some dispatch on this host; any dispatch "
          "run here installs it (dispatch-queue jobs)" % job)
    return 1


def check():
    """Each item of the config dir: ok, or what is wrong with it. Exit 1 on any finding."""
    bad = 0
    print("config: %s" % common.CONFIG)
    root = common.regatta_root()
    # The file, not $REGATTA_HOME: hooks and launchd jobs see only the file.
    home = common.config_line("home")
    if os.environ.get("REGATTA_HOME"):
        print("  ..  REGATTA_HOME=%s (this shell only)" % os.environ["REGATTA_HOME"])
    if not home:
        print("  --  home: none (no home file)")
        bad += 1
    elif not (Path(home).expanduser() / "modules" / "regatta" / "hooks" / "common.py").is_file():
        print("  --  home: %s holds no core" % home)
        bad += 1
    else:
        print("  ok  home: %s" % home)
    old = common.overlay_root()
    if old:
        print(("  ok  overlay: %s" if old.is_dir() else "  --  overlay: %s is no directory") % old)
        bad += 0 if old.is_dir() else 1
    # the `legacy` file and REGATTA_LEGACY are read by nothing since B14b (2026-10-23): named, so a
    # config dir from before the step is tidied by the overlay's bootstrap.sh --config
    if (common.CONFIG / "legacy").exists() and not old:
        # an overlay from before B14a: it now reads as a stranger's install, so its keys fail open
        # (guarded, orca-deny, the schedules' refusals) — a failure, not a note (B14b landing review)
        print("  --  legacy without regatta/overlay: the overlay reads as absent and its keys fail open"
              " (run the overlay's bootstrap.sh --config)")
        bad += 1
    elif (common.CONFIG / "legacy").exists():
        print("  ..  legacy: read by nothing since B14b (the overlay's bootstrap.sh --config removes it)")
    if os.environ.get("REGATTA_LEGACY"):
        print("  ..  REGATTA_LEGACY is set and read by nothing since B14b")
    problems = list(common.CONFIG_PROBLEMS) + module_problems() + weekly_host_problems()
    refused = {x.split()[0] for x in problems}   # said once, below, never also `ok`
    if common.CONFIG.is_dir():
        for p in sorted(common.CONFIG.glob("*/*")):
            if str(p.relative_to(common.CONFIG)) in refused:
                continue
            if p.is_symlink():
                t = os.readlink(p)
                ok = p.exists()
                print("  %s  %s → %s%s" % ("ok" if ok else "--", p.relative_to(common.CONFIG), t, "" if ok else " (missing)"))
                bad += 0 if ok else 1
            elif p.is_file():
                print("  ok  %s" % p.relative_to(common.CONFIG))
    for problem in problems:   # the private values (README): each one the core or its module refuses
        print("  --  %s (your overlay's bootstrap.sh --config)" % problem)
        bad += 1
    bad += yard_rows()
    # lighthouse's hookwatch (autofinish-exclude S4): a pinned primary runs an older checkout than main
    # until a person unpins it, so the pin is a finding here, read from its state file as text
    try:
        pin = json.loads((common.CONFIG / "lighthouse" / "hookwatch.json").read_text()).get("pinned")
    except (OSError, ValueError, AttributeError):
        pin = None
    if isinstance(pin, dict) and pin.get("to"):
        print("  --  pinned: %s detached at %s by hookwatch (%s)%s — `hookwatch unpin` after the fix" % (
            Path(pin["root"]).name if pin.get("root") else "the primary", str(pin["to"])[:12], pin.get("why") or "a hook fault",
            "; revert PR %s" % pin["pr"] if pin.get("pr") else ""))
        bad += 1
    for problem in berth_problems():
        print("  --  %s" % problem)
        bad += 1
    bad += queue_rows()
    print("core: %s" % (root or "not in a checkout"))
    return 1 if bad else 0


WEEKLY_RC = {"run": 0, "skip": 3, "refuse": 4, "closed": 5}   # refusal is never 1 (AGENTS.md Traps)


def weekly_host(job, scope):
    verdict, line, notes = common.weekly_host(job, scope)
    for said in notes + ([line] if line else []):
        print(said)
    return WEEKLY_RC[verdict]


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "root":
        root = common.regatta_root()
        if root:
            print(root)
        return 0 if root else 1
    if cmd == "has" and len(rest) == 1:
        p = common.module_path(rest[0])
        print(p if p else "%s not installed" % rest[0])
        return 0 if p else 1
    if cmd == "which" and len(rest) == 1:
        p = common.tool(rest[0])
        print(p if p else "%s not installed" % rest[0])
        return 0 if p else 1
    if cmd == "check" and not rest:
        return check()
    if cmd == "weekly-host" and rest and not rest[0].startswith("-") and (len(rest) == 1 or (len(rest) == 3 and rest[1] == "--scope" and rest[2])):
        return weekly_host(rest[0], rest[2] if len(rest) == 3 else None)
    if cmd == "shim" and len(rest) == 1:
        return shim(rest[0])
    if cmd == "shim" and len(rest) == 2 and rest[0] in ("--hook", "--deny", "--deny-prompt"):
        return shim(rest[1], rest[0])
    if cmd in ("root", "has", "which", "check", "shim", "weekly-host"):
        print("regatta %s: wrong arguments — `regatta help`" % cmd, file=sys.stderr)
        return 2
    p = common.tool(cmd)
    if not p or not p.is_file() or not os.access(str(p), os.X_OK):
        print("regatta: %s not installed" % cmd, file=sys.stderr)
        return 2
    os.execv(str(p), [str(p)] + rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
