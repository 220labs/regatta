#!/usr/bin/env python3
"""secrets — this Mac's .env files against their .env.example, in Drive's _secrets folder.

  secrets check [repo …] [--fix]    repo: a name under the projects folder ($SECRETS_PROJECTS,
                                    else the config dir's regatta/projects, else `projects` in
                                    the home folder; e.g. `site`, `team/studio`) or
                                    a path; default: every repo there that has a .env.example

A repo's main-checkout `.env` is a symlink to `<_secrets>/<name>.env` (name: the path under the
projects folder with `/` as `-`); values that differ
by host sit beside it in `<name>.<host>.env`, for the keys `.env.example` lists under its
`# per-host` marker. Drive for desktop is the only sync; this only reads and, with --fix,
appends. It never prints a value.

Per repo it prints one line per finding:
  !!  a failure: a dangling link, a file Drive has not downloaded (pin _secrets "Available
      offline"), no Full Disk Access for this python, a shared key the example names and
      the file lacks — the exit code is 1
  --  waiting or informational: a key present but empty (the owner fills it), a per-host key
      missing or empty ("not on this host"), an .env that is still a real file (migration
      step 5), a key the file has and the example does not (the example is the manifest)
and `ok <name>: N keys` when nothing failed.

--fix appends each missing key as `KEY=` under the example's own comment lines — to the
shared file, or to this host's file, creating it — and creates a missing `.env` link. It
writes only into _secrets (never a repo's real .env), only to a downloaded file nobody
touched for 2 minutes (two Macs writing one Drive file within seconds lose one write,
probed 2026-09-24), and reads the file back before calling it done.

Stdlib only. Tests: the core's tests/check.sh. Overrides, for the tests: SECRETS_DIR,
SECRETS_PROJECTS, SECRETS_HOST, SECRETS_REPOS (the registry whose twin_of entries are skipped).
"""
import errno
import json
import os
import re
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import common  # noqa: E402

SECRETS = Path(os.environ.get("SECRETS_DIR") or common.CONFIG / "regatta" / "secrets").expanduser()   # a link to the shared folder
PROJECTS = Path(os.environ.get("SECRETS_PROJECTS") or common.PROJECTS).expanduser()   # the core's one projects folder
HOST = os.environ.get("SECRETS_HOST") or common.host_name()
REPOS = Path(os.environ.get("SECRETS_REPOS") or common.REPOS_JSON)
MARKER = re.compile(r"^#\s*per-host\b", re.I)
QUIET_FOR = 120          # seconds a file must have been untouched before --fix appends to it
DOC = "docs/secrets-2026-09-24.md"
PIN = "in Finder, right-click _secrets → Google Drive → Available offline"


class Fail(Exception):
    """A finding that ends the repo's check; printed as `!!`."""


def parse_example(path):
    """[(key, the comment lines right above it, per_host)] in file order. The marker line
    is not a comment of the key after it, and a blank line ends a comment block."""
    rows, comments, per_host = [], [], False
    for line in path.read_text().splitlines():
        s = line.strip()
        if MARKER.match(s):
            per_host, comments = True, []
        elif s.startswith("#"):
            comments.append(line)
        elif not s:
            comments = []
        elif "=" in s:
            key = s.split("=", 1)[0].strip()
            if key.startswith("export "):
                key = key[len("export "):].strip()
            rows.append((key, comments, per_host))
            comments = []
    return rows


def read_keys(path):
    """key → value as written (one pair of quotes stripped). Values never leave this process."""
    try:
        text = path.read_text()
    except OSError as e:
        if e.errno == errno.EDEADLK:
            raise Fail(f"{path.name}: not available offline on this Mac — {PIN}")
        if e.errno == errno.EPERM:
            raise Fail(f"{path.name}: Operation not permitted — {sys.executable} has no Full Disk Access on this Mac")
        raise
    out = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        key, value = s.split("=", 1)
        key = key.strip()
        if key.startswith("export "):
            key = key[len("export "):].strip()
        out[key] = value.strip().strip("'\"")
    return out


def downloaded(path):
    """Drive lists a file it has not fetched with its size and no blocks on disk."""
    st = path.stat()
    return st.st_size == 0 or st.st_blocks > 0


def append(path, rows):
    """`KEY=` lines with their comments, appended; the guards are the point of the function."""
    new = not path.exists()
    if not new:
        if not downloaded(path):
            raise Fail(f"{path.name}: not downloaded, so nothing was appended — {PIN}")
        if time.time() - path.stat().st_mtime < QUIET_FOR:
            raise Fail(f"{path.name}: changed in the last {QUIET_FOR // 60} minutes — nothing appended, run again later")
    old = "" if new else path.read_text()
    parts = []
    for key, comments, _ in rows:
        parts.extend(comments)
        parts.append(f"{key}=")
    block = ("" if new or not old or old.endswith("\n") else "\n") + "\n".join(parts) + "\n"
    with open(path, "a") as fh:
        fh.write(block)
    if new:
        path.chmod(0o600)
    if path.read_text() != old + block:
        raise Fail(f"{path.name}: the read-back after appending is not the file plus the new lines — look at it by hand")
    return [key for key, _, _ in rows]


def name_of(repo):
    try:
        return "-".join(repo.resolve().relative_to(PROJECTS.resolve()).parts)
    except ValueError:
        return repo.name


def check_repo(repo, fix, explicit):
    """[(level, text)] for one repo, level `!!` or `--`; [] when there is nothing to say."""
    name = name_of(repo)
    example, env = repo / ".env.example", repo / ".env"
    if not example.exists():
        return [("--", f"{name}: no .env.example")] if explicit else []
    rows = parse_example(example)
    drive = SECRETS / f"{name}.env"
    home = SECRETS.resolve() if SECRETS.is_dir() else None   # None: the folder's link is missing (main())
    out, host_file = [], None
    try:
        if env.is_symlink():
            if not env.exists():
                raise Fail(f"{name}: .env → {os.readlink(env)} is missing — Drive for desktop is not running, or _secrets has no {name}.env")
            shared = env.resolve()
            if home and shared.parent != home:
                out.append(("--", f"{name}: .env links to {shared}, not into _secrets"))
            elif not home:
                # Unchecked without the folder: say where it reads, so a link elsewhere stays visible.
                out.append(("--", f"{name}: read through its link, in {shared.parent} (unchecked: {SECRETS} is missing)"))
        elif env.exists():
            shared = env
            out.append(("--", f"{name}: .env is a real file, not yet a link to _secrets/{name}.env ({DOC}, migration step 5)"))
        elif not home:
            raise Fail(f"{name}: .env is missing, and so is {SECRETS} to link it into")
        elif drive.exists():
            if not fix:
                raise Fail(f"{name}: .env is missing; --fix links it to _secrets/{name}.env")
            # Straight at the shared file, never through the config-dir link: a .env made while
            # that link was briefly missing would otherwise dangle after the folder came back.
            env.symlink_to(drive.resolve())
            # Resolved, as the link branch's is: `drive` runs through the config-dir link, and
            # in_secrets compares resolved folders — unresolved, the first --fix judged the file
            # it had just linked to be outside the shared folder and appended nothing.
            shared = drive.resolve()
            out.append(("--", f"{name}: linked .env → {drive}"))
        else:
            raise Fail(f"{name}: .env is missing and _secrets has no {name}.env")
        # Without the folder's link, a linked file's own folder stands in for reading — its host
        # file sits beside it — while --fix writes nothing until the link is back: a link that
        # points elsewhere may be another repo's real file.
        folder = home or (shared.parent if env.is_symlink() else None)
        in_secrets = folder is not None and shared.parent == folder
        if in_secrets and shared.suffix == ".env":
            host_file = shared.with_name(f"{shared.stem}.{HOST}.env")
        for f in (shared, host_file):
            if f and f.exists() and not downloaded(f):
                raise Fail(f"{f.name}: not downloaded — {PIN}")
        have = read_keys(shared)
        # With no host file in play (a real .env, a link elsewhere) the per-host keys are
        # looked for in the same file, so a pre-migration .env can still carry them.
        host_have = (read_keys(host_file) if host_file and host_file.exists() else
                     {} if host_file else have)
        writable = fix and in_secrets and home is not None  # never a repo's real .env
        missing_shared = [r for r in rows if not r[2] and r[0] not in have]
        missing_host = [r for r in rows if r[2] and r[0] not in host_have]
        if missing_shared and writable:
            added = append(shared, missing_shared)
            out.append(("--", f"{shared.name}: added {', '.join(added)} — waiting for a value"))
            have.update(dict.fromkeys(added, ""))
            missing_shared = []
        if missing_host and writable and host_file:
            new = not host_file.exists()
            added = append(host_file, missing_host)
            out.append(("--", f"{host_file.name}: {'created with' if new else 'added'} {', '.join(added)} — a value for this host, or empty for none"))
            host_have.update(dict.fromkeys(added, ""))
        for key, _, _ in missing_shared:
            out.append(("!!", f"{shared.name}: {key} missing — in .env.example, not in the file ({'--fix adds the line' if home else f'--fix adds the line once {SECRETS} is back'})"))
        empty = [k for k, _, ph in rows if not ph and k in have and not have[k]]
        if empty:
            out.append(("--", f"{shared.name}: {len(empty)} key{'s' if len(empty) != 1 else ''} waiting for a value — {', '.join(empty)}"))
        off = [k for k, _, ph in rows if ph and not host_have.get(k)]
        if off and host_file:
            out.append(("--", f"{host_file.name}: not on this host — {', '.join(off)}"))
        elif off:
            out.append(("--", f"{name}: per-host keys unset — {', '.join(off)}"))
        known = {k for k, _, _ in rows}
        extra = sorted((set(have) | set(host_have)) - known)
        if extra:
            out.append(("--", f"{name}: not in .env.example — {', '.join(extra)}"))
    except Fail as f:
        out.append(("!!", str(f)))
    return out


def twins():
    """A public twin (twin_of in repos.json) is a read copy: its .env.example is the private repo's."""
    try:
        reg = json.loads(REPOS.read_text())["repos"]
    except (OSError, ValueError, KeyError):
        return set()
    return {PROJECTS / k for k, v in reg.items() if isinstance(v, dict) and v.get("twin_of")}


def main(argv):
    if not argv or argv[0] != "check":
        print("usage: secrets check [repo …] [--fix]", file=sys.stderr)
        return 2
    if not SECRETS.is_dir():
        # Said, never fatal: the config link is made once, and only to a folder that existed then,
        # while a repo whose link points straight at its shared file still reads through it. A
        # repo that needs the folder itself fails on its own line (check_repo).
        print(f"-- {SECRETS} is missing — the config dir's regatta/secrets link to the shared folder "
              f"(or SECRETS_DIR): each repo is read through its own link, and --fix writes nothing", file=sys.stderr)
    fix = "--fix" in argv
    names = [a for a in argv[1:] if a != "--fix"]
    if names:
        repos = [(Path(a) if Path(a).is_absolute() else PROJECTS / a, True) for a in names]
    else:
        repos = [(e.parent, False) for pat in ("*/.env.example", "*/*/.env.example")
                 for e in sorted(PROJECTS.glob(pat))
                 if ".claude" not in e.parts and e.parent not in twins()]
    bad = False
    for repo, explicit in repos:
        findings = check_repo(repo, fix, explicit)
        for level, text in findings:
            print(f"{level} {text}")
            bad = bad or level == "!!"
        if not any(level == "!!" for level, _ in findings) and (repo / ".env.example").exists():
            n = len(parse_example(repo / ".env.example"))
            print(f"ok {name_of(repo)}: {n} key{'s' if n != 1 else ''}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
