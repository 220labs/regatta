                "bin/test_helm.sh": "bin/test_plan.sh", "bin/test_wharf.sh": None}
# G5's interim read: the grep docs/wharf-rename-2026-10-16.md S8 names for bin/test_vocabulary.sh
LAND_WORDS = "land|lands|landed|landing|landings|relands?|lander"
