#!/usr/bin/env python3
"""The weekly loop's numbers, computed — DESIGN.md section 8. Read-only.

    knowledge-numbers            # markdown table for the sextant entry
    knowledge-numbers --json     # the same, for a script
    knowledge-numbers --scope S  # the per-project numbers of scope S alone (repos.json's scopes)

What each number is a proxy for:
  shipped / open branches   work that landed vs work still in flight (the owner-time per outcome)
  decisions waiting         things blocked on the owner, and how old the oldest is
  interruptions             everything that took the owner's attention this week — questions, hand-offs,
                            replies a Stop hook sent round again, permission dialogs, notices,
                            trust dialogs waiting — and the share of
                            questions where the owner took the recommendation unchanged (bin/interruptions)
  always-loaded lines       what every session pays before it starts
  transcripts archived      whether the episodic record the dream reads is being kept
  bulletin live entries     whether /share is used at all
  stood by default          docs whose Reversible: yes picks the stand sweep took (`Stood-By:`
                            commits, entry S3/S9 of docs/design-docs-2026-10-14.md): defaults that ran
  memory entries            the size of what the dream has to consolidate
  memory unlinked           projects with a transcript this week whose auto-memory is not linked
                            into its home — the vault, or for a confidential scope's repo its
                            knowledge repo (atlas's `knowledge-home adopt`): what no dream reads
  synced skills             account skills whose descriptions every terminal session loads
  user settings             declared settings missing or undeclared on this Mac (drift)
  Course goals G1–G6        the entry doc's Goals table of docs/design-docs-2026-10-14.md, one row
                            each, read from `keel parse` / `keel list --json` / `keel open --json`
                            (entry S10); a goal that cannot be measured yet says why, never a guess
  Wharf goals G1–G5         the Goals table of docs/wharf-on-orca-2026-10-17.md (S8), each a number
                            with its source: ships built by `wharf apply` (plan.json + events.jsonl),
                            ship workers' asks that reached the owner (attention log), dispatch-Mac starts that
                            never reached a prompt (dispatch logs, over ssh), live lines of the layer,
                            old words in live files. A read that cannot be made says why, never a 0

"Corrections repeated" comes from the dream's own log line, not from here.

The fence (knowledge-layers S4): a confidential scope's repos (the core's gather_fence) are summed
into one `(confidential)` project row and counted as `(confidential)` among the unlinked memories,
never named; interruptions applies the same fence to its rows. `--scope S` keeps scope S's
projects alone, by name, and hands the scope to interruptions; the machine-wide numbers (the
always-loaded layer, the plan, the goals) are the same either way.
Projects = every git repo one or two levels under ~/projects, except the two knowledge repos.
"""
import datetime as dt
import inspect
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

def _core_hooks():
    """The folder `import common` reads. In regatta's plumb module, the core's hooks/ found by
    lib/find_core.py (the checkout, the config dir's `home`, the plugin's installPath); in the
    overlay, hooks/ beside bin/, whose common.py is the core's source shim (regatta-modules
    C2). One body for both homes, so the move to modules/plumb is a pure copy."""
    root = Path(__file__).resolve().parent.parent
    if (root / "lib" / "find_core.py").is_file():
        sys.path.insert(0, str(root / "lib"))
        import find_core
        return find_core.hooks()
    return str(root / "hooks")


sys.path.insert(0, _core_hooks())
import common  # noqa: E402  cost_text: spend as list and effective (the owner, 2026-10-05)

HOME = Path.home()
PROJECTS = common.PROJECTS


def knowledge_repo(key):
    """(name, checkout) of a knowledge repo from atlas's key (`atlas/layer`, `atlas/vault`: its name,
    its checkout, the variable that overrides the checkout), (None, None) without the key: the numbers
    that read it then say not measured, and the overlay's absent key is one line on stderr."""
    items = common.config_lines(key) or []
    if len(items) < 2:
        if common.overlay_installed():
            print("knowledge-numbers: no %s in %s — its numbers are not measured" % (key, common.CONFIG), file=sys.stderr)
        return None, None
    env = os.environ.get(items[2]) if len(items) > 2 else None
    return items[0], Path(env or items[1]).expanduser()


LAYER_NAME, LAYER = knowledge_repo("atlas/layer")
VAULT_NAME, VAULT = knowledge_repo("atlas/vault")
# the checkout whose docs/ holds the entry: KNOWLEDGE_NUMBERS_ROOT; else, from regatta's plumb
# module, the overlay's checkout (the core's overlay_root); else this checkout
ROOT = Path(os.environ.get("KNOWLEDGE_NUMBERS_ROOT") or (
    common.overlay_root() if (Path(__file__).resolve().parent.parent / "lib" / "find_core.py").is_file() else None)
    or Path(__file__).resolve().parent.parent)
KNOWLEDGE = {n for n in (LAYER_NAME, VAULT_NAME) if n}
WEEK = 7 * 24 * 3600
CONFIDENTIAL = "(confidential)"   # a confidential scope's project, counted, never named (S4)


def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def lines(path):
    try:
        return len(Path(path).read_text(encoding="utf-8").splitlines())
    except OSError:
        return 0


def imported(claude_md):
    """Files a CLAUDE.md pulls in with @path (outside code spans), one level deep."""
    out = []
    try:
        text = Path(claude_md).read_text(encoding="utf-8")
    except OSError:
        return out
    text = re.sub(r"```.*?```", "", text, flags=re.S)
    text = re.sub(r"`[^`]*`", "", text)
    for m in re.finditer(r"(?:^|\s)@(~?/?[\w./-]+)", text):
        p = Path(m.group(1)).expanduser()
        if not p.is_absolute():
            p = Path(claude_md).parent / p
        if p.is_file():
            out.append(p)
    return out


KEEL = common.tool("keel")  # keel's (G36); None: the course rows say "not installed"
ENTRY = "design-docs-2026-10-14.md"
WINDOW_DAYS = 28  # the baselines' own window: docs handed over in the last four weeks
DATE_IN_NAME = re.compile(r"-(\d{4}-\d{2}-\d{2})\.md$")
FIRST_ANSWER = re.compile(r"first answer (\d{4}-\d{2}-\d{2})")


class NotMeasured(Exception):
    """A goal this run cannot measure: the message is the reason, printed after `not measured — `."""


def keel_json(*args, timeout=300):
    if not KEEL:
        return None
    try:
        r = subprocess.run([str(KEEL), *args], capture_output=True, text=True, timeout=timeout)
        return json.loads(r.stdout) if r.stdout.strip() else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def course_goals(now, root=None, projects=None):
    """[{id, metric, baseline, target, how, value|None, why|None}] — the entry's Goals table, each row
    measured from the Keel's own verbs (`keel parse`, `list --json`, `open --json`), or `why` it cannot
    be yet (entry S10). Read-only, no model; a goal is never estimated."""
    root, projects = root or ROOT, projects or PROJECTS
    if not KEEL:
        return [{"id": "G1–G6", "metric": "the Course goals", "baseline": "", "target": "", "how": "", "value": None,
                 "why": "not installed (keel)"}]
    entry = next((p for p in (root / "docs" / ENTRY, root / "docs" / "record" / ENTRY) if p.is_file()), None)
    kp = keel_json("parse", str(entry)) if entry else None
    if not kp or not kp.get("goals"):
        return [{"id": "G1–G6", "metric": "the Course goals", "baseline": "", "target": "", "how": "", "value": None,
                 "why": "docs/%s is not on this checkout, or bin/keel cannot read its Goals table" % ENTRY}]
    day = 86400
    data = {}

    def listing():
        if "list" not in data:
            data["list"] = keel_json("list", "--root", str(projects), "--limit", "0", "--json") or []
        return data["list"]

    def recent(min_days, max_days=WINDOW_DAYS):
        return [r for r in listing() if r.get("born") and min_days * day <= now - r["born"] <= max_days * day]

    def course_docs():
        """[(list row, first answer's day as a time or None, keel word, steps)] of every doc that
        carries the Keel: only a Course doc's Status line dates its first answer."""
        if "course" not in data:
            out = []
            for r in listing():
                if not r.get("keel"):
                    continue
                d = keel_json("parse", r["path"]) or {}
                m = FIRST_ANSWER.search((d.get("keel") or {}).get("line") or "")
                out.append((r, m and dt.datetime.strptime(m.group(1), "%Y-%m-%d").timestamp(),
                            (d.get("keel") or {}).get("word"), d.get("steps") or []))
            data["course"] = out
        return data["course"]

    def g1():
        rows = [r for r in recent(3) if r.get("review")]
        if not rows:
            raise NotMeasured("no doc with D-items was handed over 3 to %d days ago" % WINDOW_DAYS)
        n = sum(1 for r in rows if r["review"].startswith("unseen"))
        return "%d %% (%d of %d)" % (round(100 * n / len(rows)), n, len(rows))

    def g2():
        aged = [r for r, fa, _, _ in course_docs() if fa and now - fa >= 3 * day]
        if not aged:
            raise NotMeasured("only a Course doc's Status line dates its first answer, and none has one 72 h old (%d Course docs, %d with a first answer)"
                              % (len(course_docs()), sum(1 for _, fa, _, _ in course_docs() if fa)))
        n = sum(1 for r in aged if (r.get("review") or "").startswith("partial"))
        return "%d %% (%d of %d Course docs)" % (round(100 * n / len(aged)), n, len(aged))

    def g3():
        raise NotMeasured("a Status line keeps the day of the first answer, not the hour (%d Course docs have one); the first answer's commit time is not read yet"
                          % sum(1 for _, fa, _, _ in course_docs() if fa))

    def g4():
        old = [steps for _, fa, w, steps in course_docs() if fa and now - fa >= 7 * day and w not in (None, "proposed", "superseded")]
        if not old:
            raise NotMeasured("only a Course doc carries S-steps, and none was answered 7 days ago yet; the baseline's commit proxy is not computed here")
        n = sum(1 for steps in old if any(s.get("status") == "done" for s in steps))
        return "%d %% (%d of %d Course docs)" % (round(100 * n / len(old)), n, len(old))

    def g5():
        k = o = n4 = o4 = 0
        for r in recent(0):
            p = r.get("picks") or {}
            k, o, n4, o4 = k + p.get("kept", 0), o + p.get("overruled", 0), n4 + p.get("n4", 0), o4 + p.get("o4", 0)
        if k + o == 0:
            raise NotMeasured("no doc handed over in the last %d days has an item the owner answered against a bare pick" % WINDOW_DAYS)
        return "%d %% overruled (%d of %d)%s" % (round(100 * o / (k + o)), o, k + o,
                                                 "; %d %% with 4+ options (%d of %d)" % (round(100 * o4 / n4), o4, n4) if n4 else "")

    def g6():
        rows = keel_json("open", "--root", str(projects), "--json")
        if rows is None:
            raise NotMeasured("`keel open --json` printed nothing")
        old = sum(1 for r in rows if DATE_IN_NAME.search(r["path"])
                  and now - dt.datetime.strptime(DATE_IN_NAME.search(r["path"]).group(1), "%Y-%m-%d").timestamp() > 7 * day)
        return "%d of %d (age from the file name)" % (old, len(rows))

    measure = {"G1": g1, "G2": g2, "G3": g3, "G4": g4, "G5": g5, "G6": g6}
    out = []
    for g in kp["goals"]:
        row = {"id": g["id"], "metric": g["metric"], "baseline": g["today"], "target": g["target"], "how": g["how"],
               "value": None, "why": None}
        try:
            if g["id"] not in measure:
                raise NotMeasured("no measure for %s in bin/knowledge-numbers yet" % g["id"])
            row["value"] = measure[g["id"]]()
        except NotMeasured as e:
            row["why"] = str(e)
        out.append(row)
    return out


def claude_dirs():
    """Every Claude Code config dir on this Mac, as bootstrap.sh's claude_dirs finds them: this
    session's ($CLAUDE_CONFIG_DIR, else ~/.claude) first, then each claude row of the account
    registry whose home exists, deduplicated by real path. Orca's logins are rows too."""
    dirs = [Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")]
    try:
        reg = json.loads(Path(os.environ.get("ACCOUNTS_FILE") or common.CONFIG / "lighthouse" / "accounts.json")
                         .read_text(encoding="utf-8")).get("accounts", [])
        for a in common.account_rows(reg):
            if isinstance(a, dict) and a.get("provider", "claude") == "claude":
                h = common.account_home(a)
                if h and h.is_dir():
                    dirs.append(h)
    except Exception:  # a missing or malformed registry leaves the session's own dir, never a crash
        pass
    seen, out = set(), []
    for d in dirs:
        if os.path.realpath(d) not in seen:
            seen.add(os.path.realpath(d))
            out.append(d)
    return out


def slug(path):
    """Claude Code's folder name for a directory: every non-alphanumeric character becomes `-`
    (the rule of bootstrap.sh cmd_adopt_memory)."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def recent_transcript(folder, now):
    """A non-empty transcript modified this week; one moved or deleted mid-scan is skipped."""
    for p in folder.glob("*.jsonl"):
        try:
            st = p.stat()
        except OSError:
            continue
        if st.st_size > 0 and now - st.st_mtime < WEEK:
            return True
    return False


def memory_homes():
    """{registry key: the memory/ folder that repo's memory links into} for each repo of a scope
    flagged confidential: its knowledge repo's, the scope's anchor (knowledge-layers D1). Every
    other repo's home is the vault's memory/. The same rule as atlas's knowledge-home, read by flag
    through the core's scope readers; {} when the registry cannot be read. A confidential scope with
    no anchor (a glob first) has no home: its repos map to None, unlinked wherever they link."""
    repos, scopes = common.scope_registry()
    out = {}
    for s in scopes.values():
        if not (isinstance(s, dict) and s.get("confidential") is True):
            continue
        first = (s.get("repos") or [None])[0]
        anchor = first if isinstance(first, str) and not common.is_glob(first) else None
        for k in common.scope_members(s, repos):
            out.setdefault(k, (PROJECTS / anchor / "memory").resolve() if anchor else None)   # the first, as knowledge-home
    return out


def memory_unlinked(now, dirs=None, fence=None):
    """Names of the projects with a non-empty transcript modified this week whose `memory` entry is
    not a symlink into its home's memory/ (memory_homes; the vault's for most). A project is a `<config dir>/projects/<slug>/` folder;
    a worktree's folder (`…--claude-worktrees-<topic>`) folds into its repo's, because Claude Code
    keys auto-memory by the repo root and its worktree folders never hold a `memory`. The same
    project on two logins counts once, unlinked if any login's memory is. A slug no ~/projects dir
    (or one under a folder of repos) accounts for is listed as the slug. With `fence` (the core's
    gather_fence), a confidential scope's project is listed as `(confidential)`, once per project,
    and one outside the scope asked for not at all."""
    if VAULT is None:  # no vault named (atlas/vault): nothing to link into, so nothing to count
        return []
    names = {}
    for top in sorted(PROJECTS.glob("*")) + sorted(PROJECTS.glob("*/*")):
        if top.is_dir() and not top.name.startswith("."):
            names.setdefault(slug(top), str(top.relative_to(PROJECTS)))  # shallower path wins
    vault_memory = (VAULT / "memory").resolve()
    homes = memory_homes()
    folders = {}  # (real projects dir, repo slug) -> any folder of it has a transcript this week
    for d in (dirs if dirs is not None else claude_dirs()):
        # Real path: a second login dir and Orca's profile link `projects` to ~/.claude's, so
        # their memory is one memory and is read once.
        proj = Path(os.path.realpath(d / "projects"))
        for f in proj.glob("*"):
            # Only a folder under ~/projects is a project: a /tmp scratchpad, a session opened in ~
            # or an Orca probe workspace never has its memory adopted (review, 2026-10-19).
            if not f.name.startswith(slug(PROJECTS) + "-"):
                continue
            key = (proj, f.name.split("--claude-worktrees-")[0])
            folders[key] = folders.get(key, False) or recent_transcript(f, now)
    out = set()
    for (proj, s), recent in folders.items():
        mem = proj / s / "memory"
        home = homes.get(names.get(s), vault_memory)
        if recent and not (home and mem.is_symlink() and mem.resolve().is_relative_to(home)):
            out.add(names.get(s, s))
    if not fence:
        return sorted(out)
    verdict = {n: fence(PROJECTS / n if not n.startswith("-") else None,
                        *(proj / s for (proj, s) in folders if names.get(s, s) == n)) for n in out}
    return sorted(n for n in out if verdict[n] == "quote") + [CONFIDENTIAL] * sum(v == "fenced" for v in verdict.values())

