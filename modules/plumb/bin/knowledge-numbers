def scan_logs(logdir, dates):
    """{"<log name>#<n>": True when that start never got busy} for each start in each dispatch log dated
    in `dates`. dispatch appends every run of a topic on one day to the same log, so a log is cut into
    starts at dispatch's `== exit` lines; a start failed when it says `FAILED: never busy` and exits 3
    (the retry that succeeded exits otherwise, and its two lines sit before one exit, so it counts once).
    A tail with the line and no exit yet is one more failed start; a refused start writes neither.
    None when the directory cannot be read. Self-contained: G3 sends this source to the dispatch Mac."""
    import os
    import re
    try:
        names = sorted(os.listdir(logdir))
    except OSError:
        return None
    out = {}
    for n in names:
        if n[:10] not in dates or "-dispatch-" not in n or not n.endswith(".log"):
            continue
        try:
            with open(os.path.join(logdir, n), errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        start = 0
        for i, m in enumerate(re.finditer(r"(?m)^== exit (\S+)", text)):
            out["%s#%d" % (n, i)] = "FAILED: never busy" in text[start:m.start()] and m.group(1) == "3"
            start = m.end()
        if "FAILED: never busy" in text[start:]:
            out["%s#tail" % n] = True
    return out


def dispatch_peer():
    """(host, ssh alias) of the Mac that runs dispatch, whose logs G3 reads: DISPATCH_KEY; without it
    the first line of PEERS_KEY, as before the key (the lines have no order, so one line on stderr);
    (None, None) without either. A config key, not a name here: public code names no host
    (regatta's AGENTS.md)."""
    lines = common.config_lines(DISPATCH_KEY)
    if lines is None and common.config_lines(PEERS_KEY):
        print("knowledge-numbers: no %s — G3 takes %s's first line" % (DISPATCH_KEY, PEERS_KEY), file=sys.stderr)
    for line in (lines if lines is not None else common.config_lines(PEERS_KEY)) or []:
        host, _, alias = line.partition(":")
        if host.strip() and alias.strip():
            return host.strip().lower(), alias.strip()
    return None, None


def dispatch_scan(dates):
    """scan_logs on the dispatch Mac, over ssh to its PEERS_KEY alias (read-only): its dispatch logs live there."""
    _, ssh_alias = dispatch_peer()
    if not ssh_alias:
        raise NotMeasured("the dispatch Mac's ssh alias is not configured (%s in the regatta config dir)" % DISPATCH_KEY)
    code = inspect.getsource(scan_logs) + "\nimport json, os\nprint(json.dumps(scan_logs(os.path.expanduser(%r), %r)))" % (
        "~/Library/Logs/claude-weekly", list(dates))
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", ssh_alias,
                            "python3 -c " + shlex.quote(code)], capture_output=True, text=True, timeout=60)
        out = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        raise NotMeasured("the dispatch Mac is not readable over ssh %s (%s)" % (ssh_alias, type(e).__name__))
    if out is None and r.returncode == 0 and r.stdout.strip() == "null":
        raise NotMeasured("the dispatch Mac has no readable ~/Library/Logs/claude-weekly")
    if out is None:
        raise NotMeasured("the dispatch Mac is not readable over ssh %s (%s)" % (ssh_alias, (r.stderr.strip().splitlines() or ["no output"])[-1][:100]))
    return out


def this_host():
    """This Mac as dispatch names it: PLAN_HOST, DISPATCH_HOST, else the core's host_name() (asklib's
    this_host, which the module cannot import); None when it cannot say."""
    try:
        return os.environ.get("PLAN_HOST") or os.environ.get("DISPATCH_HOST") or common.host_name()
    except Exception:
        return None


def ship_records(plans):
    """[{plan, ship, bp, tasks, last, sessions, cancelled}] — every blueprint with an `orca_run`, in
    every plan.json under `plans`. `tasks` are its blocks' plan tasks, `last` each task's newest status
    event ({task: (status, t)}) from the plan's events.jsonl: plan.json holds no status."""
    out = []
    try:
        dirs = sorted(d for d in Path(plans).iterdir() if (d / "plan.json").is_file())
    except OSError:
        return None
    for d in dirs:
        try:
            plan = json.loads((d / "plan.json").read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(plan, dict):
            continue
        events = []
        try:
            for line in (d / "events.jsonl").read_text().splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue   # a torn line from a crash
                if isinstance(ev, dict):
                    events.append(ev)
        except OSError:
            pass
        for ship, bp in (plan.get("blueprints") or {}).items():
            if not isinstance(bp, dict) or not bp.get("orca_run"):
                continue
            tasks = {t: v for t, v in (plan.get("tasks") or {}).items() if isinstance(v, dict) and v.get("ship") == ship and t in (bp.get("blocks") or {})}
            last = {}
            for ev in events:
                if ev.get("task") in tasks and ev.get("status") and ev.get("t") is not None:
                    if ev["task"] not in last or ev["t"] >= last[ev["task"]][1]:
                        last[ev["task"]] = (ev["status"], ev["t"])
            # a ship worker's session: one that reported on a build block. `helm report` stamps whoever ran
            # it, so the skipper (`by`, the plan's manager) and a launch block's lander are left out (review, 2026-10-19)
            skipper = {str(x)[:8] for x in (bp.get("by"), (plan.get("manager") or {}).get("session")) if x}
            sessions = {str(e["session"])[:8] for e in events
                        if e.get("task") in tasks and e.get("session") and not str(e["task"]).startswith("launch-")} - skipper
            out.append({"plan": d.name, "ship": ship, "bp": bp, "tasks": tasks, "last": last, "sessions": sessions,
                        "cancelled": bool(bp.get("cancelled"))})
    return out


def wharf_goals(now, root=None, plans=None, attention=None, logs=None, scan=None, host=None):
    """[{id, metric, baseline, target, how, value|None, why|None}] — the wharf doc's Goals table, each
    row measured, or `why` it cannot be (S8). Every value ends in its source. Read-only, no model."""
    root = root or ROOT
    plans = plans or CLAUDE_LOGS / "plans"
    attention = attention or ATTENTION
    logs = logs or CLAUDE_LOGS
    scan = scan or dispatch_scan
    entry = next((p for p in (root / "docs" / WHARF_ENTRY, root / "docs" / "record" / WHARF_ENTRY) if p.is_file()), None)
    kp = keel_json("parse", str(entry)) if entry else None
    if not kp or not kp.get("goals"):
        return [{"id": "G1–G5", "metric": "the Wharf goals", "baseline": "", "target": "", "how": "", "value": None,
                 "why": "docs/%s is not on this checkout, or bin/keel cannot read its Goals table" % WHARF_ENTRY}]
    since = now - WEEK

    def g1():
        ships = ship_records(plans)
        if ships is None:
            raise NotMeasured("no plans directory at %s" % plans)
        ships = [x for x in ships if not x["cancelled"]]
        # built end to end = wharf's own mark: finish_if_ended stamps `ended` once every block ended in the
        # plan (done, landed or launched). Counted since the first ship, as the target is ("3 by 2026-10-31").
        built = [x for x in ships if x["bp"].get("ended")]
        week = sum(1 for x in built if x["bp"]["ended"] >= since)
        return "%d of %d ships with an Orca Run built, %d this week — plan.json blueprints with `orca_run` that wharf marked `ended` (every block ended)" % (
            len(built), len(ships), week)

    def g2():
        rows, relays = [], 0
        months = {dt.datetime.fromtimestamp(t).strftime("%Y-%m") for t in (since, now)}
        found = False
        for m in sorted(months):
            f = Path(attention) / ("%s.jsonl" % m)
            if not f.is_file():
                continue
            found = True
            for line in f.read_text(errors="replace").splitlines():
                try:
                    r = json.loads(line)
                    ts = dt.datetime.fromisoformat(r["ts"]).timestamp()
                except (ValueError, KeyError, TypeError):
                    continue
                if r.get("event") == "Relay" and ts >= since:
                    relays += 1
                    if r.get("type") == "escalated":
                        rows.append((r, ts))
        if not found:
            raise NotMeasured("no attention log for this month at %s" % attention)
        src = "attention log, %d Relay rows in the last 7 days" % relays
        if not rows:
            return "0 — no `Relay` row `escalated` (%s)" % src
        ships = ship_records(plans) or []
        if not any(s["sessions"] for s in ships):
            raise NotMeasured("%d `Relay` rows `escalated`, but no ship worker's session is recorded in events.jsonl (a wharf task has session null), so a row cannot be tied to a ship" % len(rows))
        n = 0
        for r, ts in rows:
            sid = (r.get("session") or "")[:8]
            # the log has no liveness field: the skipper is read as live while its ship was open (its Run made —
            # `accepted` moves at every re-accept — and not ended)
            if sid and any(sid in s["sessions"] and (s["bp"].get("created_run") or s["bp"].get("accepted", 0)) <= ts and not (s["bp"].get("ended") and s["bp"]["ended"] < ts) for s in ships):
                n += 1
        return "%d of %d escalated rows from a ship worker while its ship was open (%s)" % (n, len(rows), src)

    def g3():
        today = dt.date.fromtimestamp(now)
        days = [(today - dt.timedelta(days=i)).isoformat() for i in range(7)]
        mine = scan_logs(logs, days)
        here = "this Mac: %d of %d" % (sum(mine.values()), len(mine)) if mine is not None else "this Mac's logs unreadable"
        peer = dispatch_peer()[0]
        if peer and (host or this_host()) == peer:
            theirs, how = mine, "its own logs"
        else:
            try:
                theirs, how = scan(days), "over ssh %s" % dispatch_peer()[1]
            except NotMeasured as e:
                raise NotMeasured("%s; %s" % (e, here))
        if not theirs:
            raise NotMeasured("no dispatch log on the dispatch Mac in the last 7 days records a start (%s)" % how)
        return "%d of %d starts never busy — `FAILED: never busy` and exit 3, one per start, the dispatch Mac's `*-dispatch-*.log` %s; %s" % (
            sum(theirs.values()), len(theirs), how, here)

    def count(paths):
        n, missing, shims = 0, [], []
        for f in paths:
            try:
                text = (root / f).read_text(errors="replace")
            except OSError:
                missing.append(f)
                continue
            n += len(text.splitlines())
            if "source shim" in text[:400].lower():   # moved to a regatta module: its lines left with it
                shims.append(f)
        return n, missing, shims

    def g4():
        files, extra = G4_FILES, G4_NEW
        if not (root / "bin/helm").exists() and (root / "bin/planlib.py").exists():
            files = tuple(G4_BEFORE_S5.get(f, f) for f in G4_FILES if G4_BEFORE_S5.get(f, f))
            extra = tuple(f for f in G4_NEW if f != "bin/plan")
        n, missing, shims = count(files)
        if len(missing) == len(files):
            raise NotMeasured("none of the baseline's %d files is on this checkout (%s)" % (len(files), root))
        new = count(extra)[0]
        s = "{:,} lines — `wc -l` over the baseline's %d files (evidence section 2); {:,} with %s".format(n, n + new) % (
            len(files) - len(missing), ", ".join(extra))
        return s + ("; MISSING %s, so those lines are not in the number" % ", ".join(missing) if missing else "") + (
            "; SHIM %s, moved to regatta, so the drop is a move, not a cut" % ", ".join(shims) if shims else "")

    def g5():
        script = root / "bin" / "test_vocabulary.sh"
        if script.is_file():
            r = subprocess.run(["bash", str(script)], capture_output=True, text=True, timeout=600, cwd=str(root))
            tail = (r.stdout.strip().splitlines() or r.stderr.strip().splitlines() or ["no output"])[-1][:120]
            return "bin/test_vocabulary.sh exits %d — %s" % (r.returncode, tail)
        paths = [p for p in LAND_PATHS if (root / p).exists()]
        if not paths:
            raise NotMeasured("none of the grep's paths (%s) is on this checkout (%s)" % (" ".join(LAND_PATHS), root))
        r = subprocess.run(["grep", "-rniwE", LAND_WORDS] + paths, capture_output=True, text=True, cwd=str(root), timeout=120)
        if r.returncode not in (0, 1):
            raise NotMeasured("the land-word grep failed: %s" % (r.stderr.strip()[:100] or "exit %d" % r.returncode))
        hits = [l for l in r.stdout.splitlines() if l]
        return "{:,} land lines in {} files — INTERIM read: the rename doc's S8 grep, not bin/test_vocabulary.sh (not built yet); no allow-list applied".format(
            len(hits), len({l.split(":", 1)[0] for l in hits}))

    measure = {"G1": g1, "G2": g2, "G3": g3, "G4": g4, "G5": g5}
    out = []
    for g in kp["goals"]:
        row = {"id": g["id"], "metric": g["metric"], "baseline": g["today"], "target": g["target"], "how": g["how"],
               "value": None, "why": None}
        try:
            if g["id"] not in measure:
                raise NotMeasured("no measure for %s in bin/knowledge-numbers yet" % g["id"])
            row["value"] = measure[g["id"]]()
        except NotMeasured as e:
            row["why"] = str(e)
        except Exception as e:  # one read's failure never costs the run its other numbers
            row["why"] = "the read failed: %s: %s" % (type(e).__name__, str(e)[:100])
        for k in ("value", "why"):
            if row[k]:
                row[k] = row[k].replace("|", "/")   # a table cell
        out.append(row)
    return out


def scoped(fence, scope):
    """The fence as this file applies it: under --scope another confidential scope's item is not
    the scope's, so it is left out, as one outside it, never counted."""
    return (lambda *p: "quote" if fence(*p) == "quote" else "outside") if scope else fence


def fold_fenced(rows, fenced):
    """The project rows with the fenced ones summed into one `(confidential)` row, last: every
    count holds, no name of theirs is printed (S4)."""
    if not fenced:
        return rows
    one = {"project": CONFIDENTIAL}
    for k in fenced[0]:
        if k != "project":
            one[k] = sum(r[k] for r in fenced)
    return rows + [one]


def main():
    scope = sys.argv[sys.argv.index("--scope") + 1] if "--scope" in sys.argv[:-1] else None
    if "--scope" in sys.argv and (not scope or scope.startswith("--")):
        print("knowledge-numbers: --scope needs a scope's name", file=sys.stderr)
        sys.exit(2)
    try:
        fence = common.gather_fence(scope)
    except ValueError as e:
        print(f"knowledge-numbers: {e}", file=sys.stderr)
        return 2
    now = dt.datetime.now().timestamp()
    # Repos one or two levels down (a folder of repos holds repos one level down).
    candidates = list(PROJECTS.glob("*/.git")) + list(PROJECTS.glob("*/*/.git")) if PROJECTS.is_dir() else []
    repos = sorted({g.parent for g in candidates if g.parent.name not in KNOWLEDGE
                    and g.parent.parent.name not in KNOWLEDGE and "worktrees" not in g.parts})
    fence = scoped(fence, scope)
    verdicts = {r: fence(r) for r in repos}
    repos = [r for r in repos if verdicts[r] != "outside"]
    rows, fenced = [], []
    for r in repos:
        main_branch = "main"
        wf = r / ".claude" / "workflow.json"
        if wf.is_file():
            try:
                main_branch = json.loads(wf.read_text()).get("main") or "main"
            except ValueError:
                pass
        shipped = git(r, "rev-list", "--count", "--since=7.days", main_branch) or "0"
        branches = [b for b in git(r, "for-each-ref", "--format=%(refname:short)", "refs/heads/claude/").split()
                    if b and not b.endswith("-raw")]
        todo = r / "TODO.md"
        decide = len(re.findall(r"\*\*Decide:\*\*", todo.read_text())) if todo.is_file() else 0
        local = r / "CLAUDE.md"
        always = lines(local) + sum(lines(p) for p in imported(local)) \
            + sum(lines(p) for p in (r / ".claude" / "rules").glob("**/*.md"))
        # Checkpoints that landed with no summary at all — the "commit summaries again"
        # correction (2026-09-10, 2026-09-12) made visible, so the dream sees if it recurs.
        no_summary = git(r, "rev-list", "--count", "--all", "--since=7.days",
                         "--grep=^wip(no-summary)") or "0"
        # A stood doc is one commit carrying the trailer (bin/keel's STOOD_TRAILER), on whatever
        # branch the sweep or autofinish stood it (review D3-A: the count in /sextant's numbers).
        # Distinct by subject: /finish's rewrite lands a copy on main while the original lives on in
        # the branch's -raw, archive or remote ref, and --all would count both (review 2026-10-16).
        stood = len(set(git(r, "log", "--all", "--since=7.days", "--fixed-strings", "--format=%s",
                            "--grep=Stood-By: autofinish").splitlines()))
        (fenced if verdicts[r] == "fenced" else rows).append(
            {"project": str(r.relative_to(PROJECTS)), "shipped_7d": int(shipped), "open_claude_branches": len(branches),
             "decide_items": decide, "project_always_loaded": always,
             "no_summary_7d": int(no_summary), "stood_7d": int(stood)})
    rows = fold_fenced(rows, fenced)

    user_md = HOME / ".claude" / "CLAUDE.md"
    user_always = lines(user_md) + sum(lines(p) for p in imported(user_md)) \
        + sum(lines(p) for p in (HOME / ".claude" / "rules").glob("**/*.md"))
    me = sum(lines(p) for p in (VAULT / "me").glob("*.md")) if VAULT else 0
    rules = sum(lines(p) for p in (LAYER / "rules").glob("*.md")) if LAYER else 0

    sessions_week = sum(1 for p in (HOME / ".claude" / "projects").glob("*/*.jsonl")
                        if now - p.stat().st_mtime < WEEK)
    archived_week = sum(1 for p in (PROJECTS / "transcripts").glob("*/*.jsonl")
                        if now - p.stat().st_mtime < WEEK)
    bulletin = (VAULT or PROJECTS / ".no-vault") / "bulletin.md"
    today = dt.date.today().isoformat()
    live = 0
    if bulletin.is_file():
        for l in bulletin.read_text().splitlines():
            m = re.search(r" · until (\d{4}-\d{2}-\d{2}) · ", l)
            if l.startswith("- ") and m and m.group(1) >= today:
                live += 1
    # Usage-limit hits (the owner, D13: "I never want to stop work and wait for tokens to refresh").
    # Claude Code writes each as an API-error assistant record: "You've hit your session
    # limit · resets 11pm (…)". Forks copy records, so count distinct record uuids.
    limit_hits = {}
    for p in list((HOME / ".claude" / "projects").glob("*/*.jsonl")) + list((PROJECTS / "transcripts").glob("*/*.jsonl")):
        if now - p.stat().st_mtime > WEEK:
            continue
        with open(p, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if "hit your" not in line or '"isApiErrorMessage":true' not in line:
                    continue
                try:
                    rec = json.loads(line)
                    ts = dt.datetime.fromisoformat(rec.get("timestamp", "").replace("Z", "+00:00")).timestamp()
                except ValueError:
                    continue
                if now - ts > WEEK:
                    continue
                m = re.search(r"hit your (\w+) limit", line)
                limit_hits[rec.get("uuid") or line] = m.group(1) if m else "?"
    kinds = {}
    for k in limit_hits.values():
        kinds[k] = kinds.get(k, 0) + 1
    # The transcript count above sees only a hard stop that surfaced as an error in Claude Code. A
    # weekly limit that rolled into paid extra usage, or one hit in Cowork, leaves no such record —
    # both happened the week of 2026-09-14 and this number read 0. bin/usage-report reads the plan's
    # own percentages (the Claude app's 15-minute history and Claude Code's /usage cache) and is the
    # authority when it has data; the transcript count stays as the fallback.
    usage = {}
    try:
        out = subprocess.run([str(Path(__file__).with_name("usage-report")), "numbers", "--json"],
                             capture_output=True, text=True, timeout=120).stdout
        usage = json.loads(out) if out.strip() else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        usage = {}
    if usage.get("limit_hits") is not None and (usage.get("limits_now") or usage.get("proxy_usd")):
        kinds = usage["limit_hits"]
    memory = sum(1 for p in (VAULT / "memory").glob("*/*.md") if p.name != "MEMORY.md") if VAULT else 0
    index_lines = sum(lines(p) for p in (VAULT / "memory").glob("*/MEMORY.md")) if VAULT else 0
    unlinked = memory_unlinked(now, fence=fence)
    # Skills enabled on the claude.ai account sync into every terminal session (Claude Code
    # 2.1.275) and each description is loaded at start — an always-loaded cost the me/ + rules/
    # budget doesn't see. Pruned on the account, not here (DESIGN D20).
    synced = sorted({p.parent.name for p in (HOME / ".claude" / "skills" / "synced").glob("**/SKILL.md")})

    # The declared user settings on this Mac (docs/record/machine-settings-2026-09-29.md): drift reaches
    # The owner here, as a number, only on the Mac the weekly runs on.
    cs = common.tool("claude-settings")  # lighthouse's (G36); absent, the row says so
    try:
        if not cs:
            raise LookupError
        r = subprocess.run([str(cs), "check", "--json"],
                           capture_output=True, text=True, timeout=20)
        settings = json.loads(r.stdout) if r.stdout.strip() else {"error": r.stderr.strip() or "no output"}
    except LookupError:
        settings = {"error": "not installed (lighthouse's claude-settings)"}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        settings = {}

    # Number 6 (the owner, 2026-10-10): every question put to the owner, and how many the owner answered with the
    # pick offered. About a minute: the D-item channel walks every doc's git history.
    try:
        r = subprocess.run([str(Path(__file__).with_name("interruptions")), "--days", "7", "--json"]
                           + (["--scope", scope] if scope else []),
                           capture_output=True, text=True, timeout=300)
        interruptions = json.loads(r.stdout) if r.stdout.strip() else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        interruptions = {}

    goals = course_goals(now)  # entry S10: the Course's G1–G6, a few seconds of keel list
    wharf = wharf_goals(now)  # wharf S8: G1–G5 of docs/wharf-on-orca-2026-10-17.md; an ssh to the dispatch Mac, a land-word grep

    totals = {
        "date": today,
        "scope": scope,
        "shipped_7d": sum(r["shipped_7d"] for r in rows),
        "open_claude_branches": sum(r["open_claude_branches"] for r in rows),
        "decide_items": sum(r["decide_items"] for r in rows),
        "stood_7d": sum(r["stood_7d"] for r in rows),
        "user_always_loaded": user_always,
        "budget_me": f"{me}/100", "budget_rules": f"{rules}/250",
        "sessions_7d": sessions_week, "archived_7d": archived_week,
        "limit_hits_7d": kinds, "usage": usage,
        "bulletin_live": live, "memory_entries": memory, "memory_index_lines": index_lines,
        "memory_unlinked_projects": unlinked,
        "synced_skills": synced,
        "interruptions_7d": {k: v for k, v in interruptions.items() if k != "rows"},
        "user_settings": {k: (len(v) if isinstance(v, list) else v) for k, v in settings.items()},
        "course_goals": goals,
        "wharf_goals": wharf,
        "projects": rows,
    }
    if "--json" in sys.argv:
        print(json.dumps(totals, indent=1))
        return
    print(f"Numbers — {today}" + (f", scope {scope}" if scope else "") + " (bin/knowledge-numbers)\n")
    print("| | Value |\n| --- | --- |")
    print(f"| commits on main, last 7 days (all projects) | {totals['shipped_7d']} |")
    print(f"| `claude/*` branches still open | {totals['open_claude_branches']} |")
    print(f"| `**Decide:**` items in TODO.md files | {totals['decide_items']} (plus open D-items in DESIGN.md) |")
    print(f"| docs stood by default, last 7 days (`Stood-By:` commits; one bulletin line each) | {totals['stood_7d']} |")
    hits = ", ".join(f"{n} {k}" for k, n in sorted(kinds.items())) or "0"
    print(f"| usage-limit hits, last 7 days (plan's own samples; episodes at 100%) | {hits} |")
    if usage:
        print(f"| plan now / extra usage | {usage.get('limits_now') or '?'} / {usage.get('extra_usage') or '?'} |")
        split = ", ".join(f"{k} {v}%" for k, v in (usage.get("breakdown") or {}).items() if v)
        print(f"| Claude Code, API-price proxy, last 7 days (by host) | {common.cost_text(usage.get('proxy_usd', 0))} "
              f"({', '.join(f'{h} {common.cost_text(v)}' for h, v in (usage.get('by_host') or {}).items())}); week by surface: {split or '?'} |")
        # Each scope's weekly pass (aurora's `/aurora dream --scope`, knowledge-layers S5), by its
        # session's title; under --scope, that scope's alone.
        passes = {k: v for k, v in (usage.get("scope_passes") or {}).items() if not scope or k == scope}
        print(f"| scope passes, last 7 days (`/aurora dream --scope`; sessions, API-price proxy) | "
              + ("; ".join(f"{k} {v['sessions']} · {common.cost_text(v['usd'])}" for k, v in passes.items()) or "none")
              + " |")
    print(f"| always-loaded lines, user level (`~/.claude/CLAUDE.md` + imports + rules) | {user_always} |")
    if interruptions.get("channels"):
        ch = interruptions["channels"]
        def part(c):
            k = c["kinds"]
            return f"{c['n']} ({k.get('recommended', 0)} took the pick)"
        print(f"| interruptions, last 7 days (`bin/interruptions`; class: hooks/attention.py) | "
              f"{interruptions.get('total')} — questions: AskUserQuestion {part(ch['ask'])}, D-items {part(ch['memo'])}, "
              f"{interruptions.get('predictable_pct')}% predictable, {ch['ask']['kinds'].get('unranked', 0)} with no pick; "
              f"hand-offs {ch['handoff']['n']} ({', '.join(f'{k} {n}' for k, n in ch['handoff']['kinds'].items())}); "
              + (f"resent by a Stop hook {ch['repeat']['n']} ({', '.join(f'{k} {n}' for k, n in ch['repeat']['kinds'].items())}"
                 f"{'; unattended not in the total' if 'unattended' in ch['repeat']['kinds'] else ''}); "
                 if 'repeat' in ch else "")
              + f"permission dialogs {ch['permission']['n']}; notices {ch['notice']['n']}; "
              f"trust dialogs waiting {sum(len(v) for v in (interruptions.get('trust_waiting') or {}).values())} |")
    else:
        print("| interruptions, last 7 days (`bin/interruptions`) | ⚠ no output |")
    print(f"| budget: `me/` · `rules/` | {totals['budget_me']} · {totals['budget_rules']} |")
    print(f"| sessions this week / transcripts archived this week | {sessions_week} / {archived_week} |")
    print(f"| bulletin entries live | {live} |")
    print(f"| auto-memory entries in the vault / index lines | {memory} / {index_lines} |")
    print(f"| projects with a transcript this week and no memory link | {len(unlinked)} ({', '.join(unlinked) or 'none'}) |")
    print(f"| skills synced from the claude.ai account (a description each, every session) | {len(synced)} |")
    if settings.get("error"):
        print(f"| user settings (`bin/claude-settings check`) | ⚠ {settings['error']} |")
    elif settings.get("declared"):
        print(f"| user settings: declared / missing / undeclared (`bin/claude-settings check`) | "
              f"{settings['declared']} / {len(settings.get('missing', []))} / {len(settings.get('undeclared', []))} |")
    print("\n| Course goal (`docs/%s`) | Baseline | Target | Now |\n| --- | --- | --- | --- |" % ENTRY)
    for g in goals:
        print("| %s — %s | %s | %s | %s |" % (g["id"], g["metric"], g["baseline"], g["target"],
                                           g["value"] if g["value"] is not None else "not measured — " + g["why"]))
    print("\n| Wharf goal (`docs/%s`) | Baseline | Target | Now |\n| --- | --- | --- | --- |" % WHARF_ENTRY)
    for g in wharf:
        print("| %s — %s | %s | %s | %s |" % (g["id"], g["metric"], g["baseline"], g["target"],
                                           g["value"] if g["value"] is not None else "not measured — " + g["why"]))
    print("\n| project | shipped 7d | open branches | Decide | always-loaded | no-summary checkpoints |\n"
          "| --- | --- | --- | --- | --- | --- |")
    for r in rows:
        print(f"| {r['project']} | {r['shipped_7d']} | {r['open_claude_branches']} | {r['decide_items']} "
              f"| {r['project_always_loaded']} | {r['no_summary_7d']} |")


if __name__ == "__main__":
    sys.exit(main())
