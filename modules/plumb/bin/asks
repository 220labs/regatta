BASELINE_DIR = Path.home() / ".local" / "state" / "regatta" / "plumb" / "asks-baseline-2026-10-30"
LOOKBACK_DAYS = 60
CHUNK = 50          # items per gate call; a failed call ends the model labelling for the run (sieve week)
TEXT_MAX = 1200     # characters of a prompt the gate sees

# ---- Ring 0: the labels. The owner changes these; the loop never does. -------------------------------

