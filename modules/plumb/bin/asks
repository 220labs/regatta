    ("PW", r"\b(finish|land|landing|pr|pull request|merge|branch|worktree|review|reviewer|skipper|session|sessions|"
           r"parallel|chain|step|steps|blueprint|ship|handoff|pickup|seed|queue|autofinish|unattended|workflow|"
           r"checkpoint|commit|todo|rebase|stall|decision|memo|keel|answer|question)\w*"),
    ("PE", r"\b(meeting|call|interview|partner|friend|collaborator|contact|contacts|text|message|imessage|telegram|"
           r"email|mail|people|person|team|employer|hire)\w*"),
    ("CB", r"\b(cost|costs|spend|spent|budget|dollar|price|prices|limit|limits|tokens?|effective|cheap|expensive|"
           r"credits|billing|subscription|week'?s budget|reset|usage)\w*"),
    ("KL", r"\b(rule|rules|memory|memories|lesson|lessons|promote|docs?|documentation|agents\.md|claude\.md|record|"
