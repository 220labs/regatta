# ---- the sieve: zero tokens, a pre-label (the first pen's asks.py, kept here as its home) -------------

MACHINE = re.compile(r"^(<|kind: build|Task:|Read first:|Unattended run|You are (a|the) |/finish|/aurora|/sextant|"
                     r"/embark|/pickup|/autofinish|pickup |dispatch |Resume |The brief|Brief:|This is a dispatched|"
                     r"Continue (the|this) |Pick up )", re.I)
PASTED = re.compile(r"<pasted_content|<system-reminder>|<ide_|<browser_instruction>|<command-name>", re.I)
STATUS = re.compile(r"^(status\??|how('s| is) it going\??|(any )?update\??|done\??|progress\??|where are (we|you)\??|"
                    r"what('s| is) the status\??|still (there|working)\??|are you (done|there)\??|ready\??|and\??|"
                    r"ok\??|k|go on|continue|proceed|carry on|next\??|\?+)$", re.I)
ANSWER = re.compile(r"^([A-F](\s*[—–-]\s*.{0,80})?|yes|no|ok(ay)?|go|yes please|sure|agreed|approved|do it|"
                    r"go ahead|sounds good|looks good|lgtm|fine|yep|nope|correct|right|exactly|perfect|great|thanks|ty)[.!]?$", re.I)
ASK = re.compile(r"\b(let'?s (add|make|build|design|change|fix|rename|move|create|have|do|try|use|start|stop|"
                 r"switch|expand|improve|make sure|not|never|always|also|think|figure|automate|run|put|get)|"
                 r"i (want|need|would like|'d like|expect|prefer|want you|wish)|we (should|need|want|must|could|ought|"
                 r"have to|can'?t|shouldn'?t)|you should (always|never|also|not|be|have)|can we|could we|"
                 r"should (we|be able|also|never|always|not)|make sure|from now on|in (the )?future|going forward|"
                 r"every time|each time|whenever|design (a|an|the|it|this)|a design (for|of|doc)|proposal|propose|"
                 r"redesign|improve|improvement|feature|mechanism|a rule|the rule|add (a|an|the|this|support)|"
                 r"automatic(ally)?|unattended|generic|portable|refactor|rename|simplif|consolidat|evolve|"
                 r"the system|regatta|aurora|sextant|embark|helm|keel|skipper|dispatch|autofinish|wharf|lighthouse|"
                 r"plumb|atlas|the loop|the process|workflow|principle|north star|self-improv)\b", re.I)
CORRECTION = re.compile(r"\b(don'?t|never|again|still|wrong|stop|i told you|remember|always|not what i|"
                        r"you (should|must) not|why (did|do|are) you)\b", re.I)
SIEVE_LEVELS = [
    ("PS", r"\b(strateg|ventur|business|market|position|roadmap|vision|priorit|north star|portfolio|company|"
