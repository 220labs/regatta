MERGE_EVERY_DAYS = 28   # the merge pass is one call a month
MERGE_RETRY_DAYS = 7    # a pass that spent a call and failed is tried again after a week, not every night
MERGE_MIN = 20          # `run` makes the pass only for a ledger of at least this many model slugs
MERGE_LIST_MAX = 500    # slugs one call sees (the most-asked first)
MERGE_GROUP_MAX = 30    # a group of more slugs than this is held, never folded: a degenerate "everything is X"
CUSUM_K, CUSUM_H, CUSUM_WEEKS, CUSUM_BASE_MIN = 0.10, 8, 8, 10   # provisional (the memo-acceptance CUSUM)
GOLDEN_PRECISION, GOLDEN_RECALL, GOLDEN_MIN = 0.80, 0.85, 30     # provisional bars (Ring 0); fewer labels cannot tell
GOLDEN = Path(os.environ.get("ASKS_GOLDEN") or Path(__file__).resolve().parent.parent / "golden" / "manifest.json")

# ---- Ring 0: the labels. The owner changes these; the loop never does. -------------------------------

CONTEXT = (
