#!/usr/bin/env python3
"""ops — the operations desk's own verbs (docs/lighthouse-ops-2026-10-26.md; S1 built usage and pick, S2
the sampler: sample, status, is-host; S4 the intake: ingest, intake; S5 the sense, logged: classify, digest).

    ops sample [--print]             one row of the desk's metrics appended to the log dir's ops.jsonl
                                     (docs/lighthouse-ops-metrics-2026-10-26.md): the queue, the run slots,
                                     machine load, check slots, CI budgets, the token's standing, token
                                     weeks and cost; ci-usage.json rewritten on the way. Only in the
                                     desk's own job on `lighthouse/ops-host` (exit 2 elsewhere); --print
                                     prints the row and writes nothing, anywhere, with no token read
    ops status [--json]              the last row, readable; --json: {row, age_s, stale, line, sig} for
                                     helm's board (`line` its ops row, `sig` the row without its clocks
                                     and gauges); exit 3 when there is no row
    ops ingest                       one intake pass (docs/lighthouse-ops-intake-2026-10-26.md): every fleet
                                     repo's issues and comments since its cursor, and every Project
                                     `lighthouse/ops-projects` names, appended to the log dir's intake.jsonl,
                                     a row an event, metadata and the body's hash only; a confidential scope
                                     whose yard is not this host skipped (`skipped: fenced`), a torn registry
                                     nothing (exit 3), a pass that read no repo at all exit 5. Then `classify`'s
                                     pass, in the same job. Only in the desk's job on the ops host (exit 2 elsewhere)
    ops classify                     each new open issue the intake holds through four gate rows, a rung of the
                                     ladder and every cap, one verdict row each appended to the log dir's
                                     ops-verdicts.jsonl; nothing laid, commented, labelled or seeded (S5 is log-only).
                                     Off without `lighthouse/ops.json`; exit 3 when it or the registry will not read;
                                     the desk's job on the ops host only, as ingest (exit 2 elsewhere)
    ops digest [--days 7] [--json]   the logged days' verdicts counted by rung, kind and would, the caps' refusals,
                                     rung-1 candidates on published paths (D4's fact), errors and the gate's spend
    ops intake [--json]              the open issues the intake holds, each judged against the registry as it
                                     reads now; --json: {open, why, sig} for helm's board, a card each
    ops is-host                      exit 0 on `lighthouse/ops-host`, 3 on another host, 4 when the key
                                     names none or cannot be read (install.sh --schedule asks it)
    ops usage [--write] [--json]     CI minutes and credits used this month, per account in the config
                                     dir's `lighthouse/ci-budgets.json`: GitHub's billing usage endpoint
                                     (a user's or an organization's) and CircleCI's insights summary
                                     (--write: the log dir's ci-usage.json, which `ci-provider --pick`
                                     reads; only in the desk's own job)
    ops pick [--apply] [REPO…]       `ops usage --write`, then `ci-provider REPO --pick [--apply]` for
                                     each REPO (default: every registry repo cloned on this host);
                                     a repo the pick refuses or does not handle is counted, exit 3
                                     when one sits on a lane its pick refused, 1 on anything else

The owner's token (D5-A, answered 2026-10-26): a fine-grained token with `Plan: read`, no repository
access, made in GitHub's UI and written by the owner over ssh into one file on the yard node — the
config dir's `lighthouse/secrets/ops.env`, its dir 0700 and the file 0600, both this user's and
neither a link: on the Macs `regatta/secrets` is a link into Drive, so it is not reused. Lines are
`KEY=value`; `GITHUB_TOKEN` (the billing read) and `CIRCLECI_TOKEN` (the insights read) unless a
budget row names its own `token_key`. It is read here and nowhere else, only in the desk's own job:
`LIGHTHOUSE_DESK=1` set and no `CLAUDE_CODE_SESSION_ID` or `CLAUDE_UNATTENDED` (a session, attended
or dispatched, is refused it, and so is a shell that never said it is the desk). That marker is an
accident guard, not a wall: any process of the node's agent user can read the file by intent, and
the wall would be an OS user of the desk's own (not built). `secrets_guard` refuses a session's tool
call that names the dir when `lighthouse/guarded-dirs` lists it; `ops usage` says so when it does not.
The token goes into one request header and nowhere else: never an argv, a log, a row or the output.
Without it (absent, refused, unreadable) every account reads `absent` or `refused`, and the pick
treats every hosted lane of a private repo as over budget.

ci-budgets.json, one row an account (lighthouse's README, "Private values"):
  {"reserve": 0.2, "accounts": {
     "<key>": {"provider": "github", "user": "<login>" | "org": "<org>", "month_minutes": 3000,
               "week_share": 0.35, "reserve": 0.2},
     "<key>": {"provider": "circleci", "org_slug": "gh/<org>", "month_credits": 30000, "margin": 0.1}}}
GitHub's answer is `usageItems` (`date`, `product`, `sku`, `quantity`, `unitType`, `netAmount`;
the enhanced billing platform only): the Actions minutes of the month, a macOS minute weighed 10 and
a Windows one 2 as the included minutes are spent (GitHub's billing page; the weights not probed),
the last seven days' items as the week. CircleCI's is `org_data.metrics.total_credits_used` over its
last 30 days (and 7 for a week share): "not a financial reporting tool", so the pick adds a margin.
LIGHTHOUSE_OPS_GITHUB_API and LIGHTHOUSE_OPS_CIRCLECI_API replace the two base URLs (a suite's stub).

The sampler's row (S2). Each read is a subprocess of a peer's tool or a file, run side by side, each
under its own 10 s bound and the whole under 60 s; a read that fails or does not answer writes its field
as null and the reason under `why`, and never aborts the row (`partial` says the deadline cut one):
  queue    dispatch-queue's ref (`list --all --json --status`): pending by priority, live; no queue home
           (`wharf-runs/queue-repo`) is null, and `slots` stands for it
  slots    `dispatch --slots`: busy runs of the cap      load   the 5-minute load per core (berth's rule)
  mem      `headroom --json --no-log` (its own log stays its own): avail %, swap GB, swap MB/s
  check    wharf-runs' check slots under ~/Library/Caches/check-slots (CHECK_SLOT_DIR): busy, waiting
  budget   per budgeted account, S1's usage(): state, used, cap, share; ci-usage.json is written from it
  token    `plan` the billing read's standing (S1's usage), `project` a GraphQL `viewer { projectsV2 }`
           read, never a write: `ok`, `refused` or `absent` each, for S1's and S7's cases; null when the
           endpoint did not answer. The token goes into the request header only, as above.
  weeks    `account limits --all --cached --json`, per login label: weekly, five_hour, fable, locked
  cost     plumb's `usage-report numbers --json`: the week's list price, and its effective figure by the
           core's cost ratio (null when the ratio is unread)
  registry `ok` or `unreadable` (the core's registry_unreadable(): a torn file reads as no repos)
CI queues (`ci.lanes.<lane>.queued_s_p50`, which `ci-provider --pick` reads) are not sampled yet.

The jobs: every 15 minutes on `lighthouse/ops-host` alone, with LIGHTHOUSE_DESK=1 and no Claude Code
variable, running `ops sample`; every 10 minutes, the same way, `ops ingest` (S4). On a Mac it is lighthouse's install.sh --schedule (a LaunchAgent);
elsewhere — the yard node's agent guest — a systemd timer is yard-node S5's, and install.sh prints the
unit's lines rather than writing one. Either way each job is its command and that environment.

The intake's row (S4), one an event: seen, repo (the registry key), slug, number, event (seen on a first
pass, opened, reopened, edited, closed, comment, comment-edited, item), kind (deadman, stall, contact, bug,
other: the first of those a label names, by that order), label, state, created, updated (epoch seconds; G3 is seen − created),
author (self: the registry's `machine_account`; member: an owner, member or collaborator; else stranger),
body_sha (16 hex of the body's sha256, never the body), url, scope (the registry's); a Project item adds
project, item, type and fields (single-select, number, date and iteration values: never a text field). A
skip is a row once per change of reason: {scope, skipped: fenced} or {repo|project, skipped: unread, why}.
Beside the registry the intake reads the two repos the issue road files into (S5): `helm/logbook-repo` and beacon's
`sink.repo` (an issue there with no kind label is a contact), each keyed by its slug; `lighthouse/ops-bots` names the
GitHub Apps that file for the road (author `bot`, self-like); a repo's open set is re-read once a day (`event:
dropped` for a card GitHub no longer lists open); the first cursor is the newest `updated_at` read.
LIGHTHOUSE_OPS_GH replaces `gh` (the suite's stub).

The verdict row (S5), one an issue classified: ts, key (`<repo>#<number>`), repo, number, kind, author, scope, event,
labels {importance, urgency, cost, clarity}, rung (0-4) and rung_why, caps {cap: ok | why}, would (lay, skipper, ask,
alarm, none), held (the classes the text names), published (yes, no, unknown: D4's fact), dry, laid (false in S5),
gate {provider, model, cost_usd, items} and gate_cost_usd (this issue's share), or error and tries. Never a title, a
body, a path the text names or an address: the issue's words reach the gate and nothing else.

Tests: tests/ops.sh; the pick's own cases are wharf's tests/test_ci_provider.sh; the board's row is
helm's tests/test_helm.sh.
"""
import argparse
import datetime
import json
import os
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import find_core  # noqa: E402

sys.path.insert(0, find_core.hooks())
import common  # noqa: E402

GITHUB_API = os.environ.get("LIGHTHOUSE_OPS_GITHUB_API") or "https://api.github.com"
CIRCLECI_API = os.environ.get("LIGHTHOUSE_OPS_CIRCLECI_API") or "https://circleci.com/api/v2"
# an override carries the token too: https, or plain http to this host only (a suite's stub)
LOOPBACK = {"127.0.0.1", "localhost", "::1"}
PICK_TIMEOUT = 600   # one repo's pick; a hung gh call never holds the 15-minute job past the next tick
DESK_DIR = common.CONFIG / "lighthouse" / "secrets"
DESK_FILE = DESK_DIR / "ops.env"
DEFAULT_KEY = {"github": "GITHUB_TOKEN", "circleci": "CIRCLECI_TOKEN"}
WEIGHT = (("macos", 10.0), ("windows", 2.0))   # included minutes spent per minute, by sku
TIMEOUT = 10                                    # s a read; the metrics doc's bound


class Refused(Exception):
    pass


def desk_refusal():
    """Why this process is not the desk's own job, or None (the header: an accident guard)."""
    if os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_UNATTENDED") or os.environ.get("CLAUDECODE"):
        return "a Claude Code session is never handed the desk's token: it is read in the desk's own job only"
    if os.environ.get("LIGHTHOUSE_DESK") != "1":
        return "not the desk's job (LIGHTHOUSE_DESK=1 unset): the token is read there only"
    return None


def read_tokens():
    """{KEY: value} from the token file, or Refused naming why — never the file's text."""
    why = desk_refusal()
    if why:
        raise Refused(why)
    uid = os.getuid()
    cfg = os.path.realpath(common.CONFIG)
    if os.path.realpath(DESK_DIR) != os.path.join(cfg, "lighthouse", "secrets") \
            or cfg != os.path.join(os.path.realpath(os.path.dirname(os.path.abspath(common.CONFIG))),
                                   os.path.basename(os.path.abspath(common.CONFIG))):
        # the config dir or its lighthouse/ a link would put the token in a drive (a system link
        # higher up, macOS's /var, is no drive)
        raise Refused("%s resolves to %s: a folder above it is a link; the token's dir is a local one of "
                      "its own, never in a drive" % (DESK_DIR, os.path.realpath(DESK_DIR)))
    for path, mode, what in ((DESK_DIR, 0o700, "dir"), (DESK_FILE, 0o600, "file")):
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            raise Refused("absent: no %s at %s (the owner writes it over ssh, D5-A)" % (what, path))
        except OSError as e:
            raise Refused("%s unreadable (%s)" % (path, e.strerror))
        if stat.S_ISLNK(st.st_mode):
            raise Refused("%s is a link: the token's %s is a local one of its own, never into a drive" % (path, what))
        if (what == "dir") != stat.S_ISDIR(st.st_mode) or (what == "file" and not stat.S_ISREG(st.st_mode)):
            raise Refused("%s is not a %s" % (path, what))
        if st.st_uid != uid or stat.S_IMODE(st.st_mode) != mode:
            raise Refused("%s must be this user's and %o, not %o" % (path, mode, stat.S_IMODE(st.st_mode)))
    try:   # opened without following a link, and judged again by the descriptor: no swap after lstat
        fd = os.open(DESK_FILE, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        with os.fdopen(fd, encoding="utf-8") as fh:
            st = os.fstat(fh.fileno())
            if st.st_uid != uid or stat.S_IMODE(st.st_mode) != 0o600 or not stat.S_ISREG(st.st_mode):
                raise Refused("%s changed while it was read" % DESK_FILE)
            text = fh.read()
    except (OSError, UnicodeDecodeError) as e:
        raise Refused("%s unreadable (%s)" % (DESK_FILE, type(e).__name__))
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            k = k.strip()
            k = k[len("export "):].strip() if k.startswith("export ") else k
            v = v.strip().strip("'\"")
            if v:
                out[k] = v
    return out


def http_get(url, headers):
    """(status, decoded JSON or None); status 0 when no answer came. The suite replaces it. The
    headers are unredirected: urllib copies a request's headers onto a redirect to any host, and
    these carry the token (the landing review)."""
    return _request(url, headers)


def http_post(url, headers, body):
    """http_get's POST of a JSON body (the GraphQL probe, a read); the suite replaces it too."""
    return _request(url, dict(headers, **{"Content-Type": "application/json"}), json.dumps(body).encode())


def _request(url, headers, data=None):
    u = urllib.parse.urlsplit(url)
    try:
        host = u.hostname
    except ValueError:
        host = None
    # plain http to this host only, by the parsed host: a prefix let `localhost.example` and
    # `localhost@example` through (the second landing review)
    if not (u.scheme == "https" or (u.scheme == "http" and host in LOOPBACK and not u.username)):
        return 0, None
    req = urllib.request.Request(url, data=data, headers={"User-Agent": "lighthouse-ops"})
    for k, v in headers.items():
        req.add_unredirected_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            raw = r.read()
            return r.status, (json.loads(raw) if raw else None)
    except urllib.error.HTTPError as e:
        return e.code, None
    except Exception:
        return 0, None


def answer_state(code):
    return "refused" if code in (401, 403, 404) else "unread"


def github_usage(b, tok, now):
    who = b.get("user") or b.get("org")
    if not isinstance(who, str) or not who:
        return {"state": "unread", "why": "the budget names no `user` or `org`"}
    d = datetime.datetime.fromtimestamp(now, datetime.timezone.utc)
    base = ("/users/%s" % who) if b.get("user") else ("/organizations/%s" % who)
    start = d - datetime.timedelta(days=6)   # the week: today and the six days before it
    week_from, this_month = start.date().isoformat(), (d.year, d.month)
    months = [this_month] + ([(start.year, start.month)] if (start.year, start.month) != this_month else [])
    items = []
    for y, m in months:   # a week across the month's start reads last month's items too
        code, out = http_get("%s%s/settings/billing/usage?year=%d&month=%d" % (GITHUB_API, base, y, m),
                             {"Authorization": "Bearer " + tok, "Accept": "application/vnd.github+json",
                              "X-GitHub-Api-Version": "2022-11-28"})
        got = out.get("usageItems") if code == 200 and isinstance(out, dict) else None
        if not isinstance(got, list):
            return {"state": answer_state(code) if code != 200 else "unread",
                    "why": "GitHub's billing usage answered %s" % (code or "nothing")}
        items += [(it, (y, m) == this_month) for it in got]
    month = week = net = 0.0
    for it, current in items:
        if not isinstance(it, dict) or str(it.get("product", "")).lower() != "actions" \
                or str(it.get("unitType", "")).lower() != "minutes":
            continue
        try:
            q, n = float(it.get("quantity") or 0), float(it.get("netAmount") or 0)
        except (TypeError, ValueError):
            return {"state": "unread", "why": "a usage item is not a number"}
        sku = str(it.get("sku", "")).lower()
        q *= next((w for k, w in WEIGHT if k in sku), 1.0)
        if current:
            month, net = month + q, net + n
        if str(it.get("date", ""))[:10] >= week_from:
            week += q
    return {"state": "ok", "month_used": round(month, 1), "week_used": round(week, 1),
            "net_amount": round(net, 2), "unit": "minutes"}


def circleci_credits(slug, tok, window):
    code, out = http_get("%s/insights/%s/summary?reporting-window=%s" % (CIRCLECI_API, slug, window),
                         {"Circle-Token": tok, "Accept": "application/json"})
    try:
        return code, float(out["org_data"]["metrics"]["total_credits_used"])
    except (TypeError, KeyError, ValueError):
        return code, None


def circleci_usage(b, tok):
    slug = b.get("org_slug")
    if not isinstance(slug, str) or not slug:
        return {"state": "unread", "why": "the budget names no `org_slug`"}
    code, month = circleci_credits(slug, tok, "last-30-days")
    if month is None:
        return {"state": answer_state(code), "why": "CircleCI's insights answered %s" % (code or "nothing")}
    week = 0.0
    if b.get("week_share"):
        code, week = circleci_credits(slug, tok, "last-7-days")
        if week is None:
            return {"state": answer_state(code), "why": "CircleCI's insights answered %s for the week" % (code or "nothing")}
    return {"state": "ok", "month_used": month, "week_used": week, "net_amount": 0, "unit": "credits"}


def budgets_file():
    path = common.CONFIG / "lighthouse" / "ci-budgets.json"
    try:
        d = json.loads(path.read_text(encoding="utf-8-sig"))
    except FileNotFoundError:
        return {}, "no budgets at %s" % path
    except (OSError, ValueError, UnicodeDecodeError) as e:
        return {}, "%s unreadable (%s)" % (path, type(e).__name__)
    acc = d.get("accounts") if isinstance(d, dict) else None
    return (acc if isinstance(acc, dict) else {}), None


def tokens():
    """(tokens, why): read_tokens() once, its refusal as the why."""
    try:
        return read_tokens(), None
    except Refused as e:
        return {}, str(e)


def usage(now=None, toks=None):
    """The usage row: {as_of, host, token: {github, circleci}, accounts: {key: row}}. toks: tokens()'s
    pair, when the caller read the file already (the sampler)."""
    now = time.time() if now is None else now
    accounts, why = budgets_file()
    toks, tok_why = toks or tokens()
    row = {"as_of": int(now), "host": common.host_name(), "token": {}, "accounts": {}}
    if why:
        row["why"] = why
    for key, b in sorted(accounts.items()):
        provider = b.get("provider") if isinstance(b, dict) else None
        if provider not in DEFAULT_KEY:
            row["accounts"][key] = {"state": "unread", "why": "provider %r is neither github nor circleci" % (provider,)}
            continue
        name = b.get("token_key") or DEFAULT_KEY[provider]
        tok = toks.get(name)
        if not tok:
            state = "refused" if tok_why and not tok_why.startswith("absent") else "absent"
            r = {"state": state, "why": tok_why or "no %s in %s" % (name, DESK_FILE)}
        else:
            r = github_usage(b, tok, now) if provider == "github" else circleci_usage(b, tok)
        row["accounts"][key] = r
        # the token's standing by provider, one word (the metrics doc's `token.plan`): ok wins
        prev = row["token"].get(provider)
        row["token"][provider] = "ok" if "ok" in (prev, r["state"]) else (prev or r["state"])
    return row


def write_usage(row):
    path = common.LOG_DIR / "ci-usage.json"
    os.makedirs(path.parent, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(row, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)
    return path


def say_usage(row):
    for key, r in sorted(row["accounts"].items()):
        if r.get("state") == "ok":
            print("%s: %s %s this month, %s this week, netAmount %s" % (key, r["month_used"], r["unit"],
                                                                        r["week_used"], r["net_amount"]))
        else:
            print("%s: %s (%s)" % (key, r.get("state"), r.get("why")))
    if not row["accounts"]:
        print("no accounts: %s" % row.get("why", "ci-budgets.json lists none"))
    guarded = [os.path.realpath(os.path.expanduser(x)) for x in common.config_lines("lighthouse/guarded-dirs") or []]
    if os.path.realpath(DESK_DIR) not in guarded:
        print("⚠ lighthouse/guarded-dirs does not list %s: secrets_guard lets a session's tool call name it" % DESK_DIR)


def cmd_usage(a):
    row = usage()
    if a.write:
        why = desk_refusal()
        if why:
            # a session's all-unread row would overwrite the job's good one
            print("ops usage --write: %s" % why, file=sys.stderr)
            return 2
        print("wrote %s" % write_usage(row), file=sys.stderr if a.json else sys.stdout)
    if a.json:
        print(json.dumps(row, indent=1, sort_keys=True))
    else:
        say_usage(row)
    return 0


def cmd_pick(a):
    why = desk_refusal()
    if why:
        print("ops pick: %s" % why, file=sys.stderr)
        return 2
    path = write_usage(usage())
    cp = common.tool("ci-provider")
    if not cp:
        print("ops pick: wharf's ci-provider is not installed", file=sys.stderr)
        return 2
    repos = a.repo or [str(r) for r in common.cloned_repos()]
    # the desk's marker never reaches a child (the sense component's "The marker")
    env = {k: v for k, v in os.environ.items() if k != "LIGHTHOUSE_DESK"}
    # 2 is a repo the pick does not handle or refused (no check.yml, CircleCI, not migrated, off the
    # ops host): reported, never the job's failure, or the normal fleet would fail every pass; 3 is a
    # repo whose current lane this pick refused (trust, money), the one the desk must card
    seen = {}
    for r in repos:
        cmd = [str(cp), r, "--pick", "--usage", str(path)] + (["--apply"] if a.apply else [])
        try:
            rc = subprocess.run(cmd, env=env, timeout=PICK_TIMEOUT).returncode
        except subprocess.TimeoutExpired:
            print("ops pick: %s took over %d s, stopped" % (r, PICK_TIMEOUT), file=sys.stderr)
            rc = 124
        seen.setdefault(rc, []).append(r)
    print("ops pick: %d repos — %d picked or unchanged, %d refused or not handled, %d on a failing lane%s"
          % (len(repos), len(seen.get(0, [])), len(seen.get(2, [])), len(seen.get(3, [])),
             "".join("; exit %d: %s" % (k, ", ".join(v)) for k, v in sorted(seen.items()) if k not in (0, 2))))
    if any(k not in (0, 2, 3) for k in seen):
        return 1
    return 3 if seen.get(3) else 0


# ---- the sampler (S2; the header's "The sampler's row") ----------------------------------------
SAMPLE_DEADLINE = 60     # s a whole sample (the metrics doc's bound); a read still out then is `partial`
STALE = 3600             # s: an older row is stale on the board (the metrics doc's "the ops host is down")
TAIL = 65536             # bytes read from the end of ops.jsonl: the file grows 96 rows a day, never read whole
FIELDS = ("registry", "queue", "slots", "load", "mem", "check", "budget", "weeks", "cost")
NO_QUEUE = "no queue home (wharf-runs/queue-repo): the run slots stand for it"


def ops_file():
    return common.LOG_DIR / "ops.jsonl"


def ops_host():
    """(0, None) on `lighthouse/ops-host`; (3, why) on another host; (4, why) when the key names none
    or cannot be read — the desk is then off everywhere, as ci-provider's --apply reads it."""
    lines, why = common.config_read("lighthouse/ops-host")
    if why:
        return 4, "lighthouse/ops-host cannot be read (%s)" % why
    if not lines:
        return 4, "lighthouse/ops-host names no host: the desk is off"
    if len(lines) > 1:
        return 4, "lighthouse/ops-host names one host, and it has %d lines" % len(lines)
    if lines[0].lower() != common.host_name():
        return 3, "this host is %s, not lighthouse/ops-host's %s: the desk runs there only" % (common.host_name(), lines[0])
    return 0, None


def child_env():
    # the desk's marker never reaches a child (the sense component's "The marker"); no token is in it
    return {k: v for k, v in os.environ.items() if k != "LIGHTHOUSE_DESK"}


def peer_out(name, args, ok=(0,)):
    """(stdout, None) from a peer's tool (the core's tool()), or (None, why)."""
    timeout = TIMEOUT
    p = common.tool(name)
    if not p:
        return None, "%s is not installed" % name
    cmd = [str(p)] + list(args)
    if not os.access(str(p), os.X_OK):
        cmd = [sys.executable] + cmd
    try:
        cp = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=child_env(),
                            stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, "%s took over %d s" % (name, timeout)
    except OSError as e:
        return None, "%s did not start (%s)" % (name, e.strerror or type(e).__name__)
    if cp.returncode not in ok:
        last = (cp.stderr or "").strip().splitlines()[-1:]
        return None, "%s exited %d%s" % (name, cp.returncode, (": " + last[0][:200]) if last else "")
    return cp.stdout, None


def peer_json(name, args, ok=(0,)):
    out, why = peer_out(name, args, ok)
    if why:
        return None, why
    try:
        return json.loads(out), None
    except ValueError:
        return None, "%s printed no JSON" % name


def read_queue():
    _, why = peer_out("dispatch-queue", ["home"])
    if why:
        # exit 1 is "no home" (dispatch-queue's header) and prints nothing; a crash that exits 1 leaves a stderr line
        return None, NO_QUEUE if why == "dispatch-queue exited 1" else why
    d, why = peer_json("dispatch-queue", ["list", "--all", "--json", "--status"])
    if why:
        return None, why
    if not isinstance(d, dict) or not isinstance(d.get("entries"), list):
        return None, "dispatch-queue list answered no entries"
    if d.get("unreadable"):
        return None, "the queue is unreadable: %s" % "; ".join(str(x) for x in d.get("why") or [])[:300]
    es = [e for e in d["entries"] if isinstance(e, dict)]
    by = {}
    for e in es:
        if e.get("state") == "queued":
            p = str(e.get("priority") or "normal")
            by[p] = by.get(p, 0) + 1
    return {"pending": sum(by.values()), "by_priority": by,
            "live": sum(1 for e in es if e.get("state") in ("claimed", "waiting", "running"))}, None


def read_slots():
    out, why = peer_out("dispatch", ["--slots"])
    if why:
        return None, why
    try:
        busy, cap = out.split()[:2]
        return {"busy": int(busy), "max": int(cap)}, None
    except ValueError:
        return None, "dispatch --slots printed %r" % out.strip()[:60]


def read_load():
    try:
        five = os.getloadavg()[1]
    except OSError:
        return None, "the load average is unreadable here"
    cores = os.cpu_count()
    if not cores:
        return None, "no core count"
    return {"per_core": round(five / cores, 2), "cores": cores}, None   # berth's rule: 5 minutes, per core


def read_mem():
    d, why = peer_json("headroom", ["--json", "--no-log"], ok=(0, 3))   # 3 is over a limit, a reading still
    if why:
        return None, why
    s = d.get("sample") if isinstance(d, dict) else None
    if not isinstance(s, dict):
        return None, "headroom answered no sample"
    return {"avail": s.get("avail"), "swap_gb": s.get("swap"), "rate": s.get("rate"), "room": d.get("room")}, None


def read_check():
    """wharf-runs' check slots on this login: a slot-<i> dir whose `pid` runs, a ticket in queue/ whose
    name ends in a running pid (check's header). No slot dir is no check run yet: zero, not unread."""
    d = Path(os.environ.get("CHECK_SLOT_DIR") or Path.home() / "Library" / "Caches" / "check-slots")

    def alive(pid):
        try:
            os.kill(int(pid), 0)
        except (ValueError, ProcessLookupError):
            return False
        except PermissionError:
            return True
        return True
    try:
        if not d.is_dir():
            return {"slots_busy": 0, "waiting": 0}, None
        busy = 0
        for s in d.glob("slot-*"):
            try:
                busy += alive((s / "pid").read_text().strip())
            except OSError:
                pass
        q = d / "queue"
        waiting = sum(1 for t in (q.iterdir() if q.is_dir() else []) if alive(t.name.rsplit(".", 1)[-1]))
    except OSError as e:
        return None, "the check slots at %s are unreadable (%s)" % (d, e.strerror or type(e).__name__)
    return {"slots_busy": busy, "waiting": waiting}, None


def read_weeks():
    d, why = peer_json("account", ["limits", "--all", "--cached", "--json"])
    if why:
        return None, why
    if not isinstance(d, list):
        return None, "account limits answered no rows"
    out = {}
    for r in d:
        if isinstance(r, dict):
            lim = r.get("limits") if isinstance(r.get("limits"), dict) else {}
            out[str(r.get("label") or "default")] = {
                "weekly": lim.get("seven_day"), "five_hour": lim.get("five_hour"), "fable": lim.get("fable_week"),
                "locked": lim.get("locked") or [], "eligible": r.get("eligible")}
    return out, None


def read_cost():
    d, why = peer_json("usage-report", ["numbers", "--json"])
    if why:
        return None, why
    lst = d.get("proxy_usd") if isinstance(d, dict) else None
    if not isinstance(lst, (int, float)) or isinstance(lst, bool):
        return None, "usage-report numbers carried no proxy_usd"
    ratio, _ = common.cost_ratio()
    return {"week_list": round(lst, 2), "week_effective": round(lst * ratio, 2) if ratio else None,
            "window": d.get("window")}, None


def read_budget(now, toks, keep):
    """Per budgeted account from S1's usage(): state, used, cap, share; keep["usage"] the whole usage
    row, which the job writes to ci-usage.json (one billing read a sample, not two)."""
    row = usage(now, toks)
    keep["usage"] = row
    budgets, bwhy = budgets_file()
    if bwhy and not bwhy.startswith("no budgets"):
        return None, bwhy
    out = {}
    for key, r in row["accounts"].items():
        b = budgets.get(key) if isinstance(budgets.get(key), dict) else {}
        e = {"state": r.get("state")}
        if r.get("state") == "ok":
            e.update(used=r["month_used"], week_used=r["week_used"], unit=r["unit"], net_amount=r["net_amount"])
            cap = b.get("month_minutes") if r["unit"] == "minutes" else b.get("month_credits")
            if isinstance(cap, (int, float)) and not isinstance(cap, bool) and cap > 0:
                e.update(cap=cap, share=round(r["month_used"] / cap, 3))
        else:
            e["why"] = r.get("why")
        out[key] = e
    return out, None


def no_github_token(toks):
    """(word, why) when the token file gave no GITHUB_TOKEN — absent, or refused (S1's usage words) — else None."""
    t, why = toks
    if t.get("GITHUB_TOKEN"):
        return None
    if why and not why.startswith("absent"):
        return "refused", why
    return "absent", why or "no GITHUB_TOKEN in %s" % DESK_FILE


def plan_word(toks, urow):
    """token.plan: the billing read's standing, as S1's usage() judged it for the GitHub accounts."""
    gone = no_github_token(toks)
    if gone:
        return gone
    if urow is None:
        return None, "the billing read did not answer within the sample"
    w = (urow.get("token") or {}).get("github")
    if w is None:
        return None, "no github account in ci-budgets.json to probe the billing read with"
    if w in ("ok", "refused", "absent"):
        return w, None if w == "ok" else next((r.get("why") for r in urow["accounts"].values()
                                               if r.get("state") == w), None)
    return None, next((r.get("why") for r in urow["accounts"].values() if r.get("state") == w), "unread")


def project_word(toks):
    """token.project: a GraphQL read of the viewer's Projects (S7 writes one; this never does)."""
    gone = no_github_token(toks)
    if gone:
        return gone
    code, out = http_post(GITHUB_API + "/graphql",
                          {"Authorization": "Bearer " + toks[0]["GITHUB_TOKEN"], "Accept": "application/json"},
                          {"query": "query { viewer { projectsV2(first: 1) { totalCount } } }"})
    if code in (401, 403):
        return "refused", "GitHub's GraphQL answered %d" % code
    if code != 200 or not isinstance(out, dict):
        return None, "GitHub's GraphQL answered %s" % (code or "nothing")
    data = out.get("data") if isinstance(out.get("data"), dict) else {}
    viewer = data.get("viewer") if isinstance(data.get("viewer"), dict) else {}
    errs = [e for e in out.get("errors") or [] if isinstance(e, dict)] if isinstance(out.get("errors"), list) else []
    if isinstance(viewer.get("projectsV2"), dict) and not errs:
        return "ok", None
    kinds = sorted({str(e.get("type")) for e in errs if e.get("type")})
    # a token without the Projects permission is answered 200 with an error, not 403 (not probed: S7's first case)
    if set(kinds) & {"FORBIDDEN", "INSUFFICIENT_SCOPES"} or any("not accessible" in str(e.get("message", "")).lower() for e in errs):
        return "refused", "GitHub's GraphQL refused the Projects read (%s)" % (", ".join(kinds) or "not accessible")
    return None, "GitHub's GraphQL answered no viewer.projectsV2"


def sample(now=None, read_token=True):
    """(row, usage row or None). Every read side by side, each bounded; one that fails or is still out
    at the deadline is its field's null and why, never the row's end."""
    from concurrent.futures import ThreadPoolExecutor, wait
    now = time.time() if now is None else now
    t0 = time.monotonic()
    row = {"as_of": int(now), "host": common.host_name(), "partial": False, "why": {}}
    keep = {}

    def registry():
        return ("unreadable" if common.registry_unreadable() else "ok"), None
    jobs = {"registry": registry, "queue": read_queue, "slots": read_slots, "load": read_load, "mem": read_mem,
            "check": read_check, "weeks": read_weeks, "cost": read_cost}
    toks = tokens() if read_token else None
    if read_token:
        jobs["budget"] = lambda: read_budget(now, toks, keep)
        jobs["token.project"] = lambda: project_word(toks)
    pool = ThreadPoolExecutor(max_workers=len(jobs))
    futs = {k: pool.submit(fn) for k, fn in jobs.items()}
    done, _ = wait(list(futs.values()), timeout=SAMPLE_DEADLINE)
    got = {}
    for k, f in futs.items():
        if f not in done:
            got[k] = (None, "not answered within the sample's %d s" % SAMPLE_DEADLINE)
            row["partial"] = True
            continue
        try:
            got[k] = f.result()
        except Exception as e:   # noqa: BLE001 — one read's crash is its field's null, never the row's end
            got[k] = (None, "the read failed (%s)" % type(e).__name__)
    pool.shutdown(wait=False)
    for k in FIELDS:
        if k == "budget" and not read_token:
            got[k] = (None, "--print reads no token: budgets are read in the desk's job")
        row[k], why = got[k]
        if row[k] is None:
            row["why"][k] = why
    if read_token:
        words = {"plan": plan_word(toks, keep.get("usage")), "project": got["token.project"]}
    else:
        words = {k: (None, "--print reads no token") for k in ("plan", "project")}
    row["token"] = {k: w for k, (w, _) in words.items()}
    row["why"].update({"token." + k: why for k, (w, why) in words.items() if why and w != "ok"})
    row["took_s"] = round(time.monotonic() - t0, 1)
    return row, keep.get("usage")


def append_row(row):
    path = ops_file()
    os.makedirs(path.parent, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:   # one write of the whole line: a reader never sees half a row but at a crash
        os.write(fd, (json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n").encode())
    finally:
        os.close(fd)
    return path


def last_row(path=None):
    """(the last whole row of ops.jsonl, None), or (None, why); read from its tail, never whole."""
    path = path or ops_file()
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - TAIL))
            chunk = fh.read()
    except FileNotFoundError:
        return None, "no sample yet at %s (the desk's job writes it: `ops sample`)" % path
    except OSError as e:
        return None, "%s unreadable (%s)" % (path, e.strerror or type(e).__name__)
    for line in reversed(chunk.splitlines()):
        try:   # the chunk's first line may be cut, a crash's last one torn: the one before stands
            r = json.loads(line)
        except ValueError:
            continue
        if isinstance(r, dict) and isinstance(r.get("as_of"), (int, float)) and not isinstance(r.get("as_of"), bool):
            return r, None
    return None, "no whole row in %s" % path


def ago(s):
    m = int(max(0, s) // 60)
    return "%d min" % m if m < 120 else "%d h" % (m // 60)


def unread(row):
    """The fields a row holds no reading for — a missing queue home is the queue off, not unread."""
    return [k for k in FIELDS if row.get(k) is None and not (k == "queue" and (row.get("why") or {}).get(k) == NO_QUEUE)]


def num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def status_line(row, now):
    """The board's ops row: one line, its age last."""
    bits = []
    q, s, c, l, m = (row.get(k) if isinstance(row.get(k), dict) else None for k in ("queue", "slots", "check", "load", "mem"))
    if q:
        by = q.get("by_priority") or {}
        order = ("force", "high", "normal", "low")
        bits.append("queue %s%s" % (q.get("pending"), " (%s)" % ", ".join(
            "%s %s" % (by[p], p) for p in sorted(by, key=lambda p: order.index(p) if p in order else 9)) if by else ""))
    elif (row.get("why") or {}).get("queue") == NO_QUEUE:
        bits.append("queue off")
    if s:
        bits.append("runs %s/%s" % (s.get("busy"), s.get("max")))
    if c:
        bits.append("checks %s busy%s" % (c.get("slots_busy"), ", %s waiting" % c["waiting"] if c.get("waiting") else ""))
    if l and num(l.get("per_core")):
        bits.append("load %.2f/core" % l["per_core"])
    if m and num(m.get("avail")):
        bits.append("mem %d%% free" % m["avail"])
    b = row.get("budget") if isinstance(row.get("budget"), dict) else {}
    shares = [v["share"] for v in b.values() if isinstance(v, dict) and num(v.get("share"))]
    if shares:
        bits.append("CI budget at most %d%% used" % round(max(shares) * 100))
    t = row.get("token") if isinstance(row.get("token"), dict) else {}
    bits.append("token plan %s, project %s" % (t.get("plan") or "unread", t.get("project") or "unread"))
    if row.get("registry") == "unreadable":
        bits.append("registry unreadable")
    if unread(row):
        bits.append("unread: " + ", ".join(unread(row)))
    if row.get("partial"):
        bits.append("partial")
    age = now - row["as_of"]
    bits.append("sampled %s ago%s" % (ago(age), " — stale" if age > STALE else ""))
    return "ops %s: %s" % (row.get("host") or "?", " · ".join(bits))


def row_sig(row, now):
    """The row without its clocks (as_of, the age) or its gauges (load, memory, budgets, weeks, cost), which
    move on every sample: hashed as helm_render.board_sig hashes cards, so the board deploys when a count,
    a token's word, an unread field or the stale mark changes, and the hourly redeploy refreshes the rest
    (AGENTS.md's trap on clocks in a rendered state)."""
    import hashlib
    keep = {k: row.get(k) for k in ("host", "registry", "queue", "slots", "check", "token")}
    keep.update(unread=unread(row), partial=bool(row.get("partial")), stale=now - row["as_of"] > STALE)
    return hashlib.sha256(json.dumps(keep, sort_keys=True, default=str).encode()).hexdigest()[:16]


def say_status(row, now):
    w = row.get("why") or {}
    print("ops: sampled %s on %s (%s ago%s)%s" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(row["as_of"])),
                                                   row.get("host"), ago(now - row["as_of"]),
                                                   ", stale" if now - row["as_of"] > STALE else "",
                                                   ", partial" if row.get("partial") else ""))

    def line(k, text):
        print("  %-9s %s" % (k, text if row.get(k) is not None else "unread — %s" % w.get(k, "no reason recorded")))
    q = row.get("queue") or {}
    if row.get("queue") is None and w.get("queue") == NO_QUEUE:
        print("  %-9s off — %s" % ("queue", NO_QUEUE))
    else:
        line("queue", "%s pending%s, %s live" % (q.get("pending"), " (%s)" % ", ".join(
            "%s %s" % (n, p) for p, n in sorted((q.get("by_priority") or {}).items())) if q.get("by_priority") else "", q.get("live")))
    s, l, m, c = (row.get(k) or {} for k in ("slots", "load", "mem", "check"))
    line("slots", "%s of %s runs" % (s.get("busy"), s.get("max")))
    line("load", "%s per core (%s cores, 5 min)" % (l.get("per_core"), l.get("cores")))
    line("mem", "%s%% free, %s GB swap, %s MB/s swapping" % (m.get("avail"), m.get("swap_gb"), m.get("rate")))
    line("check", "%s slots busy, %s waiting" % (c.get("slots_busy"), c.get("waiting")))
    if row.get("budget") is None:
        line("budget", "")
    elif not row["budget"]:
        print("  %-9s no accounts in ci-budgets.json" % "budget")
    for key, b in sorted((row.get("budget") or {}).items()):
        print("  %-9s %s: %s" % ("budget", key, ("%s of %s %s this month (%d%%), %s this week" % (
            b.get("used"), b.get("cap", "?"), b.get("unit"), round(b["share"] * 100), b.get("week_used")) if num(b.get("share"))
            else "%s %s this month, no cap" % (b.get("used"), b.get("unit"))) if b.get("state") == "ok"
            else "%s (%s)" % (b.get("state"), b.get("why"))))
    t = row.get("token") or {}
    for k in ("plan", "project"):
        print("  %-9s %s: %s%s" % ("token", k, t.get(k) or "unread", " — %s" % w["token." + k] if w.get("token." + k) else ""))
    if row.get("weeks") is None:
        line("weeks", "")
    for label, x in sorted((row.get("weeks") or {}).items()):
        print("  %-9s %s: week %s%%, 5-hour %s%%, Fable %s%%%s" % ("weeks", label, x.get("weekly"), x.get("five_hour"), x.get("fable"),
                                                                ", locked " + ", ".join(map(str, x["locked"])) if x.get("locked") else ""))
    k = row.get("cost") or {}
    line("cost", "%s list%s, %s" % (common.usd(k["week_list"]) if num(k.get("week_list")) else "?",
                                    " (%s effective)" % common.usd(k["week_effective"]) if num(k.get("week_effective")) else " (effective unknown: no ratio)",
                                    " to ".join(map(str, k.get("window") or [])) or "the week"))
    line("registry", str(row.get("registry")))


def cmd_sample(a):
    if a.print:
        row, _ = sample(read_token=False)
        print(json.dumps(row, indent=1, sort_keys=True))
        return 0
    why = desk_refusal() or ops_host()[1]
    if why:
        # a session's row, or another host's, would stand beside the desk's own as if it were one
        print("ops sample: %s" % why, file=sys.stderr)
        return 2
    row, urow = sample()
    if urow is not None:
        write_usage(urow)
    path = append_row(row)
    print("ops sample: %s — %s" % (path, status_line(row, time.time())))
    return 0


def cmd_status(a):
    now = time.time()
    row, why = last_row()
    if row is None:
        if a.json:
            print(json.dumps({"row": None, "why": why}))
        else:
            print("ops status: %s" % why, file=sys.stderr)
        return 3
    if a.json:
        print(json.dumps({"row": row, "age_s": int(now - row["as_of"]), "stale": now - row["as_of"] > STALE,
                          "line": status_line(row, now), "sig": row_sig(row, now)}, sort_keys=True))
    else:
        say_status(row, now)
    return 0


def cmd_is_host(a):
    rc, why = ops_host()
    print(why or "this host is lighthouse/ops-host's %s" % common.host_name())
    return rc


# ---- the intake (S4; docs/lighthouse-ops-intake-2026-10-26.md) -------------------------------------
# Every fleet repo's issues and comments since its cursor, and every Project `lighthouse/ops-projects`
# names, as one row an event in the log dir's intake.jsonl. The issues are read with the machine account's
# `gh` (its token holds `repo`); a Project with the owner's token (D5-A), whose Projects read S2 probes as
# `token.project`. A row holds metadata and the body's hash, never a body, a title or an email: contacts
# are strangers' personal data (the brief's rule; the component's "first 500 characters" is not built).
# intake-state.json beside it is the cursor and the open set: per repo `since` (the newest `updated_at`
# seen), `edge` (the ids seen at exactly `since`, which GitHub's `since` answers again), `open` (number ->
# the open issue's metadata, the board's cards) and `skip` (the last reason it was skipped, so a reason is
# written once, not every 10 minutes); per Project its own `since` and `edge`; `fenced` the scopes skipped.
# A row is written when an issue is new to the cursor, closes, reopens or changes its label or body; a
# comment is a row of its own; an issue whose only change is a comment writes only the comment's row.
# S9's `ops kick <repo>` calls ingest(only={key}): one repo, no Projects, under the same lock.

INTAKE_DEADLINE = 300    # s a whole pass; a repo still out then is unread and keeps its cursor
RECONCILE = 86400        # s between a repo's `state=open` re-reads (S5: a gone issue's card dropped)
NO_READ = 5              # ingest's exit when the pass read no repo at all (never 1, a crash's; 2 and 3 are taken)
GH_TIMEOUT = 60          # s one `gh api --paginate` read
GH_WORKERS = 6           # repos read side by side: 39 repos x 2 reads well inside 10 minutes
PROJECT_PAGES = 10       # 100 items a page: a Project's read is bounded
KINDS = ("deadman", "stall", "contact", "bug")   # a label naming one is the kind; first wins, else `other`
MEMBER = {"OWNER", "MEMBER", "COLLABORATOR"}     # GitHub's author_association a member holds


def intake_file():
    return common.LOG_DIR / "intake.jsonl"


def intake_state_file():
    return common.LOG_DIR / "intake-state.json"


def epoch(iso):
    """GitHub's `2026-10-27T10:00:00Z` as epoch seconds, or None."""
    try:
        return int(datetime.datetime.strptime(str(iso), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).timestamp())
    except ValueError:
        return None


def iso(t):
    return datetime.datetime.fromtimestamp(int(t), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def body_sha(text):
    """The body's hash, never the body: 16 hex characters of its sha256, or None for none."""
    import hashlib
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16] if isinstance(text, str) and text else None


def kind_of(labels):
    """(kind, label): the first of KINDS a label names, and that label; else `other` and the first label."""
    names = [l.get("name") if isinstance(l, dict) else l for l in labels or []]
    names = [n for n in names if isinstance(n, str) and n]
    low = {n.lower(): n for n in names}
    for k in KINDS:
        if k in low:
            return k, low[k]
    return "other", (names[0] if names else None)


def author_of(item, me, bots=()):
    """`self` for the machine account (the desk's own comments are never re-triaged), `bot` for a login
    `lighthouse/ops-bots` names (beacon's and deadman's GitHub Apps: self-like, never a stranger), `member` for
    an owner, member or collaborator, else `stranger`."""
    login = ((item.get("user") or item.get("author") or {}).get("login") or "") if isinstance(item, dict) else ""
    if me and login.lower() == me.lower():
        return "self"
    if login and login.lower() in bots:
        return "bot"
    assoc = item.get("author_association") or item.get("authorAssociation") or ""
    return "member" if str(assoc).upper() in MEMBER else "stranger"


def scope_fenced(name, sc, host):
    """True when scope `name` is confidential and this host is not its yard: its repos are ingested only on
    the node that drives them (the confidential rule)."""
    if not isinstance(sc, dict) or sc.get("confidential") is not True:
        return False
    yard = sc.get("yard")
    return not (isinstance(yard, str) and yard and yard.lower() == host)


def repo_fenced(key, reg, host):
    """The confidential scope that fences registry key `key` on this host, or None. Every scope is asked, not
    only the first that lists the key (scope_of_repo's answer): a repo in an open scope and a confidential one
    is fenced (the core's gather_fence, autofinish-run's rotation_fence; S4's landing review)."""
    for n, sc in sorted(((reg or {}).get("scopes") or {}).items()):
        if scope_fenced(n, sc, host) and common.scope_of_repo(key, reg={"scopes": {n: sc}, "repos": reg.get("repos")})[0]:
            return n
    return None


def bots():
    """The lowercased logins `lighthouse/ops-bots` names, one a line: the GitHub Apps that file the desk's own
    kinds (beacon's contacts, deadman's alarms, as `<app>[bot]`)."""
    return {l.strip().lower() for l in common.config_lines("lighthouse/ops-bots") or [] if l.strip()}


def beacon_sink():
    """beacon's `sink.repo` (owner/name) from its config (bin/beacon's path: $BEACON_CONFIG, else the config
    dir's beacon/config.json), or None: read for the slug alone, never validated here."""
    p = Path(os.environ.get("BEACON_CONFIG") or common.CONFIG / "beacon" / "config.json").expanduser()
    try:
        d = json.loads(p.read_text(encoding="utf-8-sig"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None
    r = (d.get("sink") or {}).get("repo") if isinstance(d, dict) and isinstance(d.get("sink"), dict) else None
    return r if isinstance(r, str) and r.count("/") == 1 else None


def extra_repos(repos):
    """{key: (slug, default kind)} for the two config keys the issue road files into beside the registry (AGENTS.md,
    "Where an issue goes"): `helm/logbook-repo` (bugs, stalls, alarms) and beacon's `sink.repo` (contacts only, so
    an issue there with no kind label is a contact). The key is the slug itself; a slug the registry already
    reads is skipped. Never in a scope: they are the owner's own private repos, named by the owner's config."""
    have = {e.get("github", "").lower() for e in repos.values() if isinstance(e, dict) and isinstance(e.get("github"), str)}
    out = {}
    log = (common.config_lines("helm/logbook-repo") or [None])[0]
    # the sink first: a slug it shares with the logbook stays a contact (strangers' words never reach a model)
    for slug, kind in ((beacon_sink(), "contact"), (log, "other")):
        if isinstance(slug, str) and slug.count("/") == 1 and slug.lower() not in have and slug not in out:
            out[slug] = (slug, kind)
    return out


def gh_lines(path, paginate=True):
    """[object] from `gh api --paginate PATH --jq '.[]'` — one JSON object a line — or raise Refused with
    the reason. The machine account's gh; the desk's marker never reaches it. ops.gh_lines is the suite's seam."""
    gh = os.environ.get("LIGHTHOUSE_OPS_GH") or "gh"
    try:
        cp = subprocess.run([gh, "api"] + (["--paginate"] if paginate else []) + ["-H", "Accept: application/vnd.github+json", path, "--jq", ".[]"],
                            capture_output=True, text=True, timeout=GH_TIMEOUT, env=child_env(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise Refused("gh took over %d s" % GH_TIMEOUT)
    except OSError as e:
        raise Refused("gh did not start (%s)" % (e.strerror or type(e).__name__))
    if cp.returncode:
        last = (cp.stderr or "").strip().splitlines()[-1:]
        raise Refused("gh exited %d%s" % (cp.returncode, (": " + last[0][:200]) if last else ""))
    out = []
    for line in cp.stdout.splitlines():
        if line.strip():
            try:
                d = json.loads(line)
            except ValueError:
                raise Refused("gh printed a line that is not JSON")
            if isinstance(d, dict):
                out.append(d)
    return out


def read_repo(slug, since, csince=None, reconcile=False):
    """(issues, comments, open numbers) of `slug`: issues updated since `since`, comments since `csince` (ISO;
    `since` when none), pull requests left out; with no cursor yet, the open issues alone and no comments (a first
    pass cards what is open, never the repo's history). `reconcile` (once a day a repo) reads the open set whole
    as well, so a deleted, transferred or closed-unseen issue's card is dropped; else the third is None. The fourth,
    on a first pass only, is the repo's most recently updated issue (any state), the first cursor's source."""
    q = "sort=updated&direction=asc&per_page=100"
    if not since:
        # the first cursor is the newest update of any issue, open or closed, one page and read first: the open
        # set's newest may be months old, and a cursor there replays the history since (S5's landing review); an
        # update after this read is past the cursor, one before it is in the open read
        head = gh_lines("repos/%s/issues?sort=updated&direction=desc&per_page=1&state=all" % slug, paginate=False)
        return [i for i in gh_lines("repos/%s/issues?state=open&%s" % (slug, q)) if "pull_request" not in i], [], None, head
    issues = [i for i in gh_lines("repos/%s/issues?state=all&%s&since=%s" % (slug, q, urllib.parse.quote(since)))
              if "pull_request" not in i]
    comments = [c for c in gh_lines("repos/%s/issues/comments?%s&since=%s" % (slug, q, urllib.parse.quote(csince or since)))
                if "/pull/" not in str(c.get("html_url") or "")]
    still = None
    if reconcile:
        still = {str(i.get("number")) for i in gh_lines("repos/%s/issues?state=open&%s" % (slug, q)) if "pull_request" not in i}
    return issues, comments, still, None


def load_intake_state():
    try:
        d = json.loads(intake_state_file().read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError, UnicodeDecodeError):
        # a torn state file restarts every cursor as a first pass: open issues again, never the history
        return {}


def save_intake_state(st):
    path = intake_state_file()
    os.makedirs(path.parent, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(st, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def append_rows(rows):
    if not rows:
        return
    path = intake_file()
    os.makedirs(path.parent, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:   # one write: a reader never sees half a pass's rows but at a crash
        os.write(fd, "".join(json.dumps(r, sort_keys=True, separators=(",", ":")) + "\n" for r in rows).encode())
    finally:
        os.close(fd)


def advance(items, since, edge):
    """The items past a cursor (newer than `since`, or at it and not in `edge`), and the cursor after: (new, since, edge)."""
    since, edge = since or "", set(edge or [])
    new = [i for i in items if (i.get("updated_at") or "") > since
           or ((i.get("updated_at") or "") == since and str(i.get("id")) not in edge)]
    top = max([since] + [i.get("updated_at") or "" for i in new])
    if top != since:
        edge = set()
    edge |= {str(i.get("id")) for i in new if i.get("updated_at") == top}
    return new, top or None, sorted(edge)


def repo_rows(key, slug, scope, rs, issues, comments, me, now, still=None, bots=(), default_kind="other", head=None):
    """The rows of one repo's read, and its state after: the cursor moved, the open set kept. `still`: the open
    numbers a reconcile read (read_repo's third), whose absence from it drops a card (`event: dropped`)."""
    first = not rs.get("since")
    since, csince = rs.get("since"), rs.get("comments_since")
    opened = dict(rs.get("open") or {})
    rows = []
    base = {"seen": int(now), "repo": key, "slug": slug, "scope": scope}
    if first:
        # the first cursor is the newest `updated_at` read, GitHub's clock, never this host's: a clock running
        # ahead would lose an update made in the gap (S4's landing review). No issue read leaves no cursor: the
        # next pass is a first pass again, the open issues alone
        _, top, edge = advance(list(issues) + list(head or []), None, [])   # `head`: read_repo's fourth
        # a first pass read the open set whole: it counts as the day's re-read
        after = {"since": top, "edge": edge, "comments_since": top, "comments_edge": [], "reconciled": int(now)}
    else:
        # issues and comments each keep their own cursor: one shared `since` would skip a label change made
        # between the two reads whenever a comment landed after it
        issues, top_i, edge_i = advance(issues, since, rs.get("edge"))
        comments, top_c, edge_c = advance(comments, csince or since, rs.get("comments_edge"))
        after = {"since": top_i, "edge": edge_i, "comments_since": top_c, "comments_edge": edge_c}
    kinds = {n: (o.get("kind"), o.get("label")) for n, o in opened.items()}
    touched = set()
    for i in issues:
        n = str(i.get("number"))
        touched.add(n)
        kind, label = kind_of(i.get("labels"))
        # the sink's issues are contacts whatever a label says: a label never sends a visitor's words to a model
        kind = "contact" if default_kind == "contact" else default_kind if kind == "other" else kind
        kinds[n] = (kind, label)
        meta = {"number": i.get("number"), "kind": kind, "label": label, "created": epoch(i.get("created_at")),
                "author": author_of(i, me, bots), "body_sha": body_sha(i.get("body")), "url": i.get("html_url")}
        prev = opened.get(n)
        if i.get("state") == "open":
            if first:
                event = "seen"
            elif prev is None:
                event = "opened" if (i.get("created_at") or "") > since else "reopened"
            elif (prev.get("kind"), prev.get("label"), prev.get("body_sha")) != (kind, label, meta["body_sha"]):
                event = "edited"
            else:
                event = None
            opened[n] = meta
        else:
            # closed: a row when it was open here, or when it opened and closed between two passes
            event = "closed" if prev is not None or (not first and (i.get("created_at") or "") > since) else None
            opened.pop(n, None)
        if event:
            rows.append(dict(base, event=event, state=i.get("state"), updated=epoch(i.get("updated_at")), **meta))
    if still is not None:
        # an open card GitHub no longer lists as open, untouched by this pass's read: deleted, transferred, or closed
        # where `since` never showed it. Its row keeps the card's metadata; the card goes
        for n in sorted(set(opened) - still - touched, key=lambda x: int(x) if x.isdigit() else 0):
            o = opened.pop(n)
            rows.append(dict(base, event="dropped", state=None, updated=None,
                             **{k: o.get(k) for k in ("number", "kind", "label", "created", "author", "body_sha", "url")}))
        after["reconciled"] = int(now)
    elif rs.get("reconciled"):
        after["reconciled"] = rs["reconciled"]
    for c in comments:
        m = str(c.get("issue_url") or "").rstrip("/").rsplit("/", 1)
        n = m[-1] if len(m) == 2 and m[-1].isdigit() else None
        kind, label = kinds.get(n, ("other", None))
        rows.append(dict(base, event="comment" if (c.get("created_at") or "") > (csince or since or "") else "comment-edited",
                         number=int(n) if n else None, comment=c.get("id"), kind=kind, label=label,
                         state="open" if n in opened else None, created=epoch(c.get("created_at")),
                         updated=epoch(c.get("updated_at")), author=author_of(c, me, bots), body_sha=body_sha(c.get("body")),
                         url=c.get("html_url")))
    return rows, dict(after, open=opened)


PROJECT_QUERY = """query($login: String!, $number: Int!, $after: String) {
  %s(login: $login) { projectV2(number: $number) { items(first: 100, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes { id type createdAt updatedAt
      content { __typename
        ... on Issue { number url issueState: state body authorAssociation author { login } repository { nameWithOwner }
                       labels(first: 20) { nodes { name } } }
        ... on PullRequest { number url prState: state repository { nameWithOwner } }
        ... on DraftIssue { body } }
      fieldValues(first: 30) { nodes { __typename
        ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { name } } }
        ... on ProjectV2ItemFieldNumberValue { number field { ... on ProjectV2FieldCommon { name } } }
        ... on ProjectV2ItemFieldDateValue { date field { ... on ProjectV2FieldCommon { name } } }
        ... on ProjectV2ItemFieldIterationValue { title field { ... on ProjectV2FieldCommon { name } } } } } } } } } }"""


def project_items(spec, tok):
    """([item], cut) of Project `user/<login>/<n>` or `org/<login>/<n>`, read with the owner's token — `cut` True
    when PROJECT_PAGES ended the read with pages left (the summary says so); Refused with why. Each state is
    aliased (`issueState`, `prState`): two enum types under one response key fail GraphQL's validation."""
    parts = spec.split("/")
    if len(parts) != 3 or parts[0] not in ("user", "org") or not parts[1] or not parts[2].isdigit():
        raise Refused("%r is not user/<login>/<number> or org/<login>/<number>" % spec)
    owner = "user" if parts[0] == "user" else "organization"
    out, after = [], None
    for _ in range(PROJECT_PAGES):
        code, d = http_post(GITHUB_API + "/graphql", {"Authorization": "Bearer " + tok, "Accept": "application/json"},
                            {"query": PROJECT_QUERY % owner, "variables": {"login": parts[1], "number": int(parts[2]), "after": after}})
        if code != 200 or not isinstance(d, dict):
            raise Refused("GitHub's GraphQL answered %s" % (code or "nothing"))
        if d.get("errors"):
            kinds = sorted({str(e.get("type")) for e in d["errors"] if isinstance(e, dict) and e.get("type")})
            raise Refused("GitHub's GraphQL refused the Project's read (%s)" % (", ".join(kinds) or "an error"))
        try:
            items = d["data"][owner]["projectV2"]["items"]
            nodes, page = items["nodes"], items["pageInfo"]
        except (KeyError, TypeError):
            raise Refused("GitHub's GraphQL answered no %s.projectV2.items" % owner)
        out += [n for n in nodes if isinstance(n, dict)]
        if not page.get("hasNextPage"):
            return out, False
        after = page.get("endCursor")
    return out, True


def item_fields(item):
    """{field name: value} of an item's single-select, number, date and iteration fields: no text field, which
    may carry anything (an issue's title is one)."""
    out = {}
    for v in ((item.get("fieldValues") or {}).get("nodes") or []):
        if not isinstance(v, dict) or not isinstance(v.get("field"), dict) or not v["field"].get("name"):
            continue
        val = next((v[k] for k in ("name", "number", "date", "title") if k in v), None)
        if val is not None:
            out[v["field"]["name"]] = val
    return out


def ingest(now=None, only=None):
    """(rows, summary, refused): one pass over the fleet — `only` a set of registry keys (S9's kick: one repo,
    no Projects). A torn registry ingests nothing; a fenced scope is skipped and named once; a read that fails
    writes its reason and the rest go on."""
    from concurrent.futures import ThreadPoolExecutor, wait
    now = time.time() if now is None else now
    reg, torn = common.read_registry()
    if torn:
        return [], None, "the registry %s cannot be read: nothing ingested (a torn registry is no fence)" % common.repos_json(), 0
    reg = reg or {}
    repos = reg.get("repos") if isinstance(reg.get("repos"), dict) else {}
    me = reg.get("machine_account") if isinstance(reg.get("machine_account"), str) else None
    host = common.host_name()
    bot_logins = bots()
    st = load_intake_state()
    st_repos = st.setdefault("repos", {})
    fenced_before = set(st.get("fenced") or [])
    fenced_now, rows, unread, todo = set(), [], {}, {}
    base = {"seen": int(now)}
    sink = beacon_sink()
    for key, entry in sorted(repos.items()):
        if only is not None and key not in only:
            continue
        slug = entry.get("github") if isinstance(entry, dict) else None
        if not isinstance(slug, str) or "/" not in slug:
            continue
        name, _ = common.scope_of_repo(key, reg=reg)
        fence = repo_fenced(key, reg, host)
        if fence:
            fenced_now.add(fence)
            st_repos.pop(key, None)   # a fenced repo's cursor and open set never stay on this host
            continue
        # a registered repo that is also beacon's sink keeps the sink's kind: contact, whatever its labels
        todo[key] = (slug, name, "contact" if sink and slug.lower() == sink.lower() else "other")
    for key, (slug, kind) in sorted(extra_repos(repos).items()):
        if only is None or key in only:
            todo[key] = (slug, None, kind)
    for name in sorted(fenced_now - fenced_before):
        rows.append(dict(base, scope=name, skipped="fenced"))
    st["fenced"] = sorted(fenced_now | (fenced_before if only is not None else set()))
    pool = ThreadPoolExecutor(max_workers=GH_WORKERS)
    def due(k):
        rs = st_repos.get(k) or {}
        return bool(rs.get("since")) and now - (rs.get("reconciled") or 0) >= RECONCILE
    futs = {k: pool.submit(read_repo, slug, (st_repos.get(k) or {}).get("since"), (st_repos.get(k) or {}).get("comments_since"), due(k))
            for k, (slug, _, _) in todo.items()}
    done, _ = wait(list(futs.values()), timeout=INTAKE_DEADLINE)
    # the queued reads are cancelled: the interpreter joins a pool's threads at exit, so a repo still queued
    # would be read after the pass gave it up (a running one ends within twice GH_TIMEOUT: two reads a repo)
    pool.shutdown(wait=False, cancel_futures=True)
    if only is None:
        for gone in set(st_repos) - set(todo):
            st_repos.pop(gone)   # a repo gone from the registry, or with no github any more
    for key, f in sorted(futs.items()):
        slug, scope, dkind = todo[key]
        rs = st_repos.get(key) or {}
        why = None
        if f not in done:
            why = "not read within the pass's %d s" % INTAKE_DEADLINE
        else:
            try:
                issues, comments, still, head = f.result()
            except Refused as e:
                why = str(e)
            except Exception as e:   # noqa: BLE001 — one repo's crash is its reason, never the pass's end
                why = "the read failed (%s)" % type(e).__name__
        if why:
            unread[key] = why
            if rs.get("skip") != why:
                rows.append(dict(base, repo=key, slug=slug, scope=scope, skipped="unread", why=why))
            st_repos[key] = dict(rs, skip=why)
            continue
        got, after = repo_rows(key, slug, scope, rs, issues, comments, me, now, still, bot_logins, dkind, head)
        rows += got
        st_repos[key] = after
    projects, punread, ptrunc = 0, {}, {}
    if only is None:
        specs = common.config_lines("lighthouse/ops-projects") or []
        st_proj = st.setdefault("projects", {})
        if specs:
            toks, tok_why = tokens()
            tok = toks.get("GITHUB_TOKEN")
        slugs = {e.get("github", "").lower(): k for k, e in repos.items() if isinstance(e, dict) and isinstance(e.get("github"), str)}
        for spec in specs:
            ps = st_proj.get(spec) or {}
            try:
                if not tok:
                    raise Refused("no GITHUB_TOKEN to read a Project with (%s)" % (tok_why or "not in %s" % DESK_FILE))
                items, cut = project_items(spec, tok)
            except Refused as e:
                punread[spec] = str(e)
                if ps.get("skip") != str(e):
                    rows.append(dict(base, project=spec, skipped="unread", why=str(e)))
                st_proj[spec] = dict(ps, skip=str(e))
                continue
            if cut:
                ptrunc[spec] = len(items)
            for it in items:
                it["updated_at"] = it.get("updatedAt")
            first = ps.get("since") is None
            new, top, edge = advance(items, ps.get("since"), ps.get("edge"))
            for it in new:
                c = it.get("content") if isinstance(it.get("content"), dict) else {}
                state = (c.get("issueState") or c.get("prState") or "").lower() or None
                if first and state in ("closed", "merged"):
                    continue   # a first read cards what is open, never the Project's history (as a repo's)
                rslug = ((c.get("repository") or {}).get("nameWithOwner") or "")
                key = slugs.get(rslug.lower())
                name = common.scope_of_repo(key, reg=reg)[0] if key else None
                if key and repo_fenced(key, reg, host):
                    continue   # a fenced scope's issue on a Project: skipped like its repo
                if not key:
                    # a repo the registry does not hold is never known not to be confidential: its item
                    # keeps its metadata, never its repo's name or link
                    rslug, url = "", None
                else:
                    url = c.get("url")
                kind, label = kind_of((c.get("labels") or {}).get("nodes")) if c.get("__typename") == "Issue" else ("other", None)
                rows.append(dict(base, event="item", project=spec, item=it.get("id"), type=it.get("type"),
                                 repo=key, slug=rslug or None, scope=name, number=c.get("number"), kind=kind, label=label,
                                 state=state, created=epoch(it.get("createdAt")),
                                 updated=epoch(it.get("updatedAt")),
                                 author=author_of(c, me, bot_logins) if c.get("__typename") == "Issue" else None,
                                 body_sha=body_sha(c.get("body")), url=url, fields=item_fields(it)))
                projects += 1
            st_proj[spec] = {"since": top or ps.get("since"), "edge": edge}
        for gone in set(st_proj) - set(specs):
            st_proj.pop(gone)
    st["as_of"] = int(now)
    # rows before the cursor: a crash between the two repeats a pass's rows next time, never loses them
    append_rows(rows)
    save_intake_state(st)
    events = sum(1 for r in rows if "event" in r)
    summary = "%d repos read, %d events, %d open issues%s%s%s%s%s" % (
        len(todo) - len(unread), events, sum(len((v or {}).get("open") or {}) for v in st_repos.values()),
        "; %d Project items" % projects if projects else "",
        "; fenced: %s" % ", ".join(sorted(fenced_now)) if fenced_now else "",
        "; unread: %s" % "; ".join("%s (%s)" % kv for kv in sorted(unread.items())) if unread else "",
        "; Projects unread: %s" % "; ".join("%s (%s)" % kv for kv in sorted(punread.items())) if punread else "",
        "; Projects cut at their first %s" % "; ".join("%s (%d items)" % kv for kv in sorted(ptrunc.items())) if ptrunc else "")
    return rows, summary, None, len(todo) - len(unread)


def intake_lock():
    """An exclusive lock on the log dir's intake.lock, or None while another pass holds it (the poll and S9's kick)."""
    import fcntl
    path = common.LOG_DIR / "intake.lock"
    os.makedirs(path.parent, exist_ok=True)
    fh = open(path, "a")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def open_items(now=None):
    """(cards, why) — the open issues of intake-state.json, each judged against the registry as it reads now: a
    torn registry gives none (the fence trap), a repo whose scope is fenced here is dropped."""
    now = time.time() if now is None else now
    reg, torn = common.read_registry()
    if torn:
        return [], "the registry cannot be read: no intake cards (a torn registry is no fence)"
    reg = reg or {}
    try:
        st = json.loads(intake_state_file().read_text(encoding="utf-8"))
    except FileNotFoundError:
        return [], "no intake yet at %s (the desk's job writes it: `ops ingest`)" % intake_state_file()
    except (OSError, ValueError, UnicodeDecodeError) as e:
        return [], "%s unreadable (%s)" % (intake_state_file(), type(e).__name__)
    host = common.host_name()
    repos = reg.get("repos") if isinstance(reg.get("repos"), dict) else {}
    extras = extra_repos(repos)
    out = []
    for key, rs in sorted(((st.get("repos") or {}) if isinstance(st, dict) else {}).items()):
        if (key not in repos and key not in extras) or not isinstance(rs, dict):
            continue
        if key in extras:
            name, slug = None, extras[key][0]
        else:
            name, _ = common.scope_of_repo(key, reg=reg)
            if repo_fenced(key, reg, host):
                continue
            slug = (repos.get(key) or {}).get("github")
        for n, o in sorted((rs.get("open") or {}).items(), key=lambda kv: int(kv[0]) if kv[0].isdigit() else 0):
            if isinstance(o, dict):
                out.append({"repo": key, "slug": slug, "number": o.get("number"), "kind": o.get("kind") or "other",
                            "label": o.get("label"), "created": o.get("created"), "author": o.get("author"),
                            "url": o.get("url"), "scope": name})
    order = {k: i for i, k in enumerate(KINDS + ("other",))}
    out.sort(key=lambda c: (order.get(c["kind"], 9), c["repo"], c["number"] or 0))
    return out, None


def cmd_ingest(a):
    why = desk_refusal() or ops_host()[1]
    if why:
        # a session's pass, or another host's, would move the desk's cursor and write a second intake
        print("ops ingest: %s" % why, file=sys.stderr)
        return 2
    lock = intake_lock()
    if lock is None:
        print("ops ingest: another pass holds %s; this one skipped" % (common.LOG_DIR / "intake.lock"))
        return 0
    try:
        rows, summary, refused, read = ingest()
    finally:
        lock.close()
    if refused:
        print("ops ingest: %s" % refused, file=sys.stderr)
        return 3
    print("ops ingest: %s — %s" % (intake_file(), summary))
    # the classifier runs in the same job, after the pass (S5): off without lighthouse/ops.json
    crc = run_classify()
    if not read:
        print("ops ingest: no repo read at all — the fleet has none with a `github` key, or every read failed", file=sys.stderr)
        return NO_READ
    return crc


def cmd_intake(a):
    cards, why = open_items()
    if a.json:
        import hashlib
        sig = hashlib.sha256(json.dumps([[c[k] for k in ("repo", "number", "kind", "label")] for c in cards]).encode()).hexdigest()[:16]
        print(json.dumps({"open": cards, "why": why, "sig": sig}, sort_keys=True))
        return 0
    if why:
        print("ops intake: %s" % why, file=sys.stderr)
    for c in cards:
        print("%-8s %s#%s  %s, %s ago" % (c["kind"], c["repo"], c["number"], c.get("author") or "?",
                                         ago(time.time() - c["created"]) if num(c.get("created")) else "?"))
    if not cards and not why:
        print("ops intake: no open issue in the fleet's intake")
    return 0

# ---- sense, logged (S5; docs/lighthouse-ops-sense-2026-10-26.md) ----------------------------------------
# `ops classify` takes each new open issue the intake holds through four rows of the core's gate
# (lighthouse.importance, .urgency, .cost, .clarity), derives a rung of the ladder from the labels and the
# issue's facts (ladder(), a pure function), judges every cap before a lay (judge_caps()), and appends one
# verdict row to the log dir's ops-verdicts.jsonl. S5 lays nothing, comments nothing, labels nothing, seeds
# nothing, whatever `dry` says: `ops send` is S6's, and reads `dry` there. The issue's title and body are
# fetched with the machine account's gh at classify time, handed to the gate, and never written anywhere; a
# verdict row holds the key, labels and metadata. A contact, a stall or a dead-man alarm is rung 4 by its kind
# alone and never goes to a model (strangers' words stay on GitHub; the desk never answers a contact).
#
# The ladder (the component's table; ladder()): 4 alarm — kind contact, stall or deadman, or importance 5;
# 3 ask — unclear, or cost l at importance 2 or less; 1 just happens — a bug by a member, the machine account or
# a configured bot, clear, cost xs or s, importance 3 or less; 2 a skipper's ship — any other clear bug, or
# importance 4; 0 none — the rest (a clear feature request, say): its card stands. The table's place conditions
# (the repo not confidential, its scope's yard this host, no held class in the text) are caps here, so the
# logged week counts rung-1 candidates the place alone keeps back (D4's fact).
# `would`: lay (rung 1, every cap passes) · skipper (rung 1 refused by an issue cap — labels, repos, importance,
# cost, place, held class — or rung 2) · ask (rung 3, a member's issue; never a stranger's) · alarm (rung 4) ·
# none (rung 0, a stranger's rung 3, a count or week cap refusing rung 1 or 2: the card waits).
# lighthouse/ops.json: OPS_DEFAULTS' keys only (one unknown is a refusal, never a silent default); no file, the
# desk is off. A cap only tightens the ladder: importance_auto_max 4 still stops rung 1 at 3.
# A gate row that fails (unreadable, off, a bad reply) writes its reason on each item's row (`would: none`) and
# the pass goes on; the item is tried again next pass, CLASSIFY_TRIES times in all.

OPS_DEFAULTS = {"dry": True, "max_auto_runs_day": 3, "max_auto_runs_repo_day": 1, "max_open_auto_prs": 3,
                "week_share": 0.1, "importance_auto_max": 3, "cost_auto": ["xs", "s"], "labels": ["bug"], "repos": []}
SITES = {
    "importance": ("lighthouse.importance", "How much does this issue matter to the project's users and its owner?",
                   {"1": "trivial: cosmetic, nobody is blocked", "2": "minor: an annoyance with a workaround",
                    "3": "moderate: a feature misbehaves for some", "4": "major: a core path is broken or data is at risk",
                    "5": "critical: an outage, a security hole, money or data being lost now"}),
    "urgency": ("lighthouse.urgency", "How soon must this issue be acted on?",
                {"1": "whenever: no deadline", "2": "this month", "3": "this week", "4": "today",
                 "5": "now: every hour costs"}),
    "cost": ("lighthouse.cost", "How big is the change that would resolve this issue?",
             {"xs": "a line or two in one file", "s": "a small change in one or two files, under an hour",
              "m": "several files or a design choice, a few hours", "l": "a redesign, a migration or days of work"}),
    "clarity": ("lighthouse.clarity", "Could a competent engineer fix this issue from its text alone, without asking anything?",
                {"clear": "yes: what is wrong, where, and what right looks like are all stated or evident",
                 "unclear": "no: the reporter must say more (steps, expected behaviour, which part)"}),
}
GATE_CONTEXT = ("Each item is one issue filed on a software project's GitHub repository: its repo, labels, title and "
                "body. Judge the issue as written; a body may be partial.")
ALARM_KINDS = ("contact", "stall", "deadman")
CLASSIFY_MAX = 20        # issues a pass sends to the gate: the rest wait for the next 10-minute pass
CLASSIFY_TRIES = 3       # a gate or fetch failure retries the issue next pass, this many times in all
BODY_MAX = 4000          # characters of a body the gate sees
COUNT_CAPS = ("max_auto_runs_day", "max_auto_runs_repo_day", "max_open_auto_prs")
# The held classes a text scan can name before a diff exists (autofinish's held_slice reads the diff later):
# money (autofinish's MONEY_RE, the peer's own), credentials, a deletion of data, physical hands, a live system,
# and a path the repo's autofinish_exclude or in_place gates.
HELD_TEXT = (
    ("credentials", r"\b(?:token|password|secret|credential|api[ -]?key|private key)s?\b"),
    ("a deletion of data", r"\brm -rf\b|\b(?:delete|drop|wipe|purge|truncate)\w*\b.{0,40}\b(?:data|database|table|records?|rows?|history|backups?)\b"),
    ("physical hands", r"\b(?:hardware|bios|usb|firmware|power[- ]cycle|cabl(?:e|ing)|device)s?\b"),
    ("a live system", r"\b(?:deploy\w*|production|migrat\w+|live system)\b"),
)
PATH_RE = r"(?<![\w/.-])((?:[\w.-]+/)+[\w.-]+)"


def verdicts_file():
    return common.LOG_DIR / "ops-verdicts.jsonl"


def classify_state_file():
    return common.LOG_DIR / "classify-state.json"


def ops_config():
    """(config, None), (None, None) when lighthouse/ops.json is absent (the desk is off), or (None, why) for a file
    that does not read or holds a key or a value it should not: refused whole, never a silent default."""
    p = common.CONFIG / "lighthouse" / "ops.json"
    try:
        d = json.loads(p.read_text(encoding="utf-8-sig"))
    except FileNotFoundError:
        return None, None
    except (OSError, ValueError, UnicodeDecodeError) as e:
        return None, "%s unreadable (%s)" % (p, type(e).__name__)
    if not isinstance(d, dict):
        return None, "%s is not a JSON object" % p
    bad = sorted(k for k in d if k not in OPS_DEFAULTS and k != "_")
    if bad:
        return None, "%s: unknown key %s (%s)" % (p, ", ".join(bad), ", ".join(OPS_DEFAULTS))
    cfg = dict(OPS_DEFAULTS, **{k: v for k, v in d.items() if k != "_"})
    if not isinstance(cfg["dry"], bool):
        return None, "%s: dry is true or false" % p
    for k in COUNT_CAPS + ("importance_auto_max",):
        if isinstance(cfg[k], bool) or not isinstance(cfg[k], int) or cfg[k] < 0:
            return None, "%s: %s is a whole number" % (p, k)
    if isinstance(cfg["week_share"], bool) or not isinstance(cfg["week_share"], (int, float)) or not 0 <= cfg["week_share"] <= 1:
        return None, "%s: week_share is a fraction from 0 to 1" % p
    for k in ("cost_auto", "labels", "repos"):
        if not isinstance(cfg[k], list) or not all(isinstance(x, str) and x for x in cfg[k]):
            return None, "%s: %s is a list of names" % (p, k)
    if not set(cfg["cost_auto"]) <= set(SITES["cost"][2]):
        return None, "%s: cost_auto takes %s" % (p, ", ".join(SITES["cost"][2]))
    return cfg, None


def ladder(labels, facts):
    """(rung, why) from the four labels ({importance: "1".."5", urgency, cost: xs|s|m|l, clarity}) and the
    issue's facts ({kind, author}): the component's table, the place conditions left to the caps. Pure."""
    kind, author = facts.get("kind"), facts.get("author")
    if kind in ALARM_KINDS:
        return 4, "kind %s" % kind
    imp = int(labels["importance"])
    if imp == 5:
        return 4, "importance 5"
    if labels["clarity"] == "unclear":
        return 3, "unclear"
    if labels["cost"] == "l" and imp <= 2:
        return 3, "cost l at importance %d" % imp
    if kind == "bug" and labels["cost"] in ("xs", "s") and imp <= 3 and author in ("member", "self", "bot"):
        return 1, "a clear %s bug at importance %d by a %s" % (labels["cost"], imp, author)
    if kind == "bug":
        return 2, "a clear bug, cost %s, importance %d%s" % (labels["cost"], imp,
                                                             "" if author in ("member", "self", "bot") else ", by a stranger")
    if imp >= 4:
        return 2, "importance %d" % imp
    return 0, "clear, no bug label, importance %d" % imp


def would_of(rung, caps, facts):
    """The action a verdict names: the header's `would` from the rung and the caps' refusals."""
    refused = [k for k, v in caps.items() if v != "ok"]
    if rung == 4:
        return "alarm"
    if rung == 3:
        return "none" if facts.get("author") == "stranger" else "ask"
    if rung in (1, 2) and "week_share" in refused:
        return "none"
    if rung == 1:
        if not refused:
            return "lay"
        return "none" if set(refused) <= set(COUNT_CAPS) else "skipper"
    return "skipper" if rung == 2 else "none"


_AF = []


def autofinish():
    """wharf-runs' autofinish loaded once (its MONEY_RE, repo_config, published, branches.main_branch), or None."""
    if not _AF:
        from importlib.machinery import SourceFileLoader
        p = common.tool("autofinish")
        try:
            _AF.append(SourceFileLoader("autofinish_for_ops", str(p)).load_module() if p else None)
        # SystemExit too: autofinish's header exits when wharf's branches.py is missing (S5's landing review)
        except (Exception, SystemExit):   # noqa: BLE001 — an unloadable peer is "unread", a hold, never the pass's end
            _AF.append(None)
    return _AF[0]


def repo_paths(key):
    """(exclude prefixes, published paths) of registry repo `key` from its clone on this host, as origin's main
    holds them (autofinish's own readers), or None when there is no clone or no autofinish."""
    af, clone = autofinish(), common.PROJECTS / key
    if af is None or not (clone / ".git").exists():
        return None
    try:
        main = af.branches.main_branch(clone) if hasattr(af, "branches") else "main"
        _, _, problem, exclude = af.repo_config(clone, main)
        if problem and not problem.startswith(("no .claude/workflow.json", "unknown autofinish value")):
            return None
        return list(exclude), af.published(clone, main)
    except Exception:   # noqa: BLE001
        return None


def held_classes(text, paths):
    """The held classes the issue's text names ([word]); `paths` repo_paths()' answer. A class it cannot read
    (no autofinish for money, no clone for the gated paths) is named as unread: a hold, never a pass."""
    import re
    out = [name for name, pat in HELD_TEXT if re.search(pat, text, re.I)]
    af = autofinish()
    if af is None or not hasattr(af, "MONEY_RE"):
        out.append("money unread (no autofinish)")
    elif af.MONEY_RE.search(text):
        out.append("money")
    named = named_paths(text)
    if paths is None:
        if named:
            out.append("gated paths unread (no clone here)")
    elif any(p.startswith(tuple(paths[0])) for p in named if paths[0]):
        out.append("a gated path")
    return out


def named_paths(text):
    """The repo paths an issue's text names: PATH_RE's matches, a sentence's closing punctuation and a leading
    `./` cut, so `modules/x/bin/ops.` reads as the file (S5's landing review)."""
    import re
    out = []
    for p in re.findall(PATH_RE, text):
        p = p.rstrip(".,;:")
        while p.startswith("./"):
            p = p[2:]
        if "/" in p:
            out.append(p)
    return out


def published_of(text, paths):
    """D4's fact for the digest: `yes` when a path the issue names is on the repo's allowlist (or under a listed
    folder), `no` when it names paths and none is, `unknown` when it names none or the allowlist was not read."""
    import re
    named = named_paths(text)
    if not named or paths is None:
        return "unknown"
    pub = paths[1]
    return "yes" if any(p in pub or any(x.startswith(p.rstrip("/") + "/") for x in pub) for p in named) else "no"


def gh_json(path):
    """One `gh api PATH` answer, parsed (no pagination), or Refused naming why. The machine account's gh."""
    gh = os.environ.get("LIGHTHOUSE_OPS_GH") or "gh"
    try:
        cp = subprocess.run([gh, "api", "-H", "Accept: application/vnd.github+json", path],
                            capture_output=True, text=True, timeout=GH_TIMEOUT, env=child_env(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise Refused("gh took over %d s" % GH_TIMEOUT)
    except OSError as e:
        raise Refused("gh did not start (%s)" % (e.strerror or type(e).__name__))
    if cp.returncode:
        last = (cp.stderr or "").strip().splitlines()[-1:]
        raise Refused("gh exited %d%s" % (cp.returncode, (": " + last[0][:200]) if last else ""))
    try:
        return json.loads(cp.stdout)
    except ValueError:
        raise Refused("gh printed no JSON")


def gate_module():
    """The core's bin/gate, loaded as bin/jev's callers load it (its header)."""
    from importlib.machinery import SourceFileLoader
    return SourceFileLoader("gate", str(Path(find_core.hooks()).parent / "bin" / "gate")).load_module()


def gate_reason(e):
    """A gate error's reason without its tail: the gate's messages end in the model's reply or claude's output
    (`the reply is not JSON: '…'`), which may quote the issue, and a verdict row holds no issue words."""
    parts = str(e).split(": ")
    return ": ".join(parts[:2])[:200] or type(e).__name__


def gate_down():
    """None when the four rows resolve, else why the gate can classify nothing: it does not load, a row is missing,
    off or invalid. The same for every item, so it holds the queue and spends no item's tries (S5's landing review:
    an overlay table without the rows would otherwise finish the whole backlog unclassified in three passes)."""
    try:
        g = gate_module()
    except Exception as e:   # noqa: BLE001
        return "the core's gate did not load (%s)" % type(e).__name__
    if not hasattr(g, "resolve"):
        return None
    for dim in SITES:
        site = SITES[dim][0]
        try:
            row = g.resolve(site)
        except Exception as e:   # noqa: BLE001 — GateError, GateOff, a table that does not read
            return gate_reason(e)
        if row is None:
            return "%s is off (when_off: skip)" % site
    return None


def run_gate(items, sources):
    """{dim: ({id: label}, None) | (None, why)} and the pass's cost in list USD: one gate call a row for every item of
    one source, the four rows side by side. `sources` {id: source} — the gate guards a confidential scope's data by
    source, so items are grouped by it."""
    from concurrent.futures import ThreadPoolExecutor
    try:
        g = gate_module()
    except Exception as e:   # noqa: BLE001
        return {d: (None, "the core's gate did not load (%s)" % type(e).__name__) for d in SITES}, 0.0, {}
    groups = {}
    for i, src in sources.items():
        groups.setdefault(src, {})[i] = items[i]

    def one(dim):
        site, ask, labels = SITES[dim]
        got, cost, why, meta = {}, 0.0, None, {}
        for src, its in sorted(groups.items()):
            try:
                r = g.classify(site, its, ask, labels, context=GATE_CONTEXT, source=src, caller="ops classify")
            except Exception as e:   # noqa: BLE001 — GateError and anything else: the reason, never the pass's end
                why = (why + "; " if why else "") + gate_reason(e)
                continue
            if r is None:
                why = "%s is off (when_off: skip)" % site
                continue
            cost += float(r.get("cost_usd") or 0)
            meta = {"provider": r.get("provider"), "model": r.get("model")}
            got.update({i: v["label"] for i, v in r["items"].items()})
        return dim, got, why, cost, meta
    out, total, meta = {}, 0.0, {}
    with ThreadPoolExecutor(max_workers=len(SITES)) as pool:
        for dim, got, why, cost, m in pool.map(one, list(SITES)):
            out[dim] = (got, why)
            total += cost
            meta = meta or m
    return out, total, meta


def read_verdicts(since):
    """The verdict rows written at or after epoch `since`; a torn line is skipped."""
    out = []
    try:
        with open(verdicts_file(), encoding="utf-8") as fh:
            for line in fh:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict) and num(r.get("ts")) and r["ts"] >= since:
                    out.append(r)
    except FileNotFoundError:
        pass
    return out


def week_cap(cfg, spent, now):
    """The week_share cap against S2's token weeks: "ok" or why it refuses. The last ops.jsonl row must be fresh;
    no eligible login is the week over; the desk's own spend (the gate's, from the verdict log, and S6's runs'
    `run_cost_usd`) over the fleet's week list spend (the row's `cost.week_list`) must stay under week_share. The row
    holds no reset time, so a pace (tight) is not judged here: autofinish's week_tight judges it at the launch."""
    row, why = last_row()
    if row is None:
        return "the week is unread (%s)" % ("no ops sample yet" if why.startswith("no sample") else "ops.jsonl unreadable")
    if now - row["as_of"] > STALE:
        return "the week is unread (the last sample is %s old)" % ago(now - row["as_of"])
    weeks = row.get("weeks") if isinstance(row.get("weeks"), dict) else None
    if not weeks:
        return "the week is unread (%s)" % ((row.get("why") or {}).get("weeks") or "no weeks in the sample")
    if not any(isinstance(w, dict) and w.get("eligible") for w in weeks.values()):
        return "the week is over: no login is eligible"
    lst = (row.get("cost") or {}).get("week_list") if isinstance(row.get("cost"), dict) else None
    if not num(lst) or lst <= 0:
        return "the week's spend is unread"
    if spent / lst > cfg["week_share"]:
        return "the desk spent %d%% of the week's list spend, over its %d%%" % (round(spent / lst * 100), round(cfg["week_share"] * 100))
    return "ok"


def open_auto_prs(owners):
    """The open pull requests labelled ops:auto across `owners`, by GitHub's search (one read an owner), or None."""
    n = 0
    for o in sorted(owners):
        try:
            d = gh_json("search/issues?q=%s" % urllib.parse.quote('is:pr is:open label:"ops:auto" user:%s' % o))
        except Refused:
            return None
        if not isinstance(d, dict) or not isinstance(d.get("total_count"), int):
            return None
        n += d["total_count"]
    return n


def judge_caps(cfg, rung, v, facts, ctx):
    """{cap: "ok" | why} for one verdict: every cap for rung 1, the week alone for rung 2, none above. `ctx` the
    pass's shared reads (the verdict log's last day, the week's spend, the open PR count), filled lazily."""
    if rung not in (1, 2):
        return {}
    now = ctx["now"]
    if "week" not in ctx:
        ctx["week"] = week_cap(cfg, ctx["spent"], now)
    caps = {"week_share": ctx["week"]}
    if rung == 2:
        return caps
    lays = [r for r in ctx["day"] if r.get("would") == "lay" or r.get("laid")]
    caps["max_auto_runs_day"] = "ok" if len(lays) < cfg["max_auto_runs_day"] else \
        "%d laid in the last day, the cap %d" % (len(lays), cfg["max_auto_runs_day"])
    here = [r for r in lays if r.get("repo") == v["repo"]]
    caps["max_auto_runs_repo_day"] = "ok" if len(here) < cfg["max_auto_runs_repo_day"] else \
        "%d laid in %s in the last day, the cap %d" % (len(here), v["repo"], cfg["max_auto_runs_repo_day"])
    if "prs" not in ctx:
        ctx["prs"] = open_auto_prs(ctx["owners"])
    caps["max_open_auto_prs"] = "the open ops:auto PRs are unread" if ctx["prs"] is None else \
        "ok" if ctx["prs"] < cfg["max_open_auto_prs"] else "%d open ops:auto PRs, the cap %d" % (ctx["prs"], cfg["max_open_auto_prs"])
    imp = int(v["labels"]["importance"])
    caps["importance_auto_max"] = "ok" if imp <= cfg["importance_auto_max"] else \
        "importance %d over %d" % (imp, cfg["importance_auto_max"])
    caps["cost_auto"] = "ok" if v["labels"]["cost"] in cfg["cost_auto"] else "cost %s not in %s" % (v["labels"]["cost"], ", ".join(cfg["cost_auto"]))
    have = {x.lower() for x in facts.get("labels") or []}
    caps["labels"] = "ok" if have & {x.lower() for x in cfg["labels"]} else "no label of %s" % ", ".join(cfg["labels"])
    caps["repos"] = "ok" if "*" in cfg["repos"] or v["repo"] in cfg["repos"] else "%s is not in repos" % v["repo"]
    caps["place"] = facts["place"]
    caps["held"] = "ok" if not facts["held"] else "held: %s" % ", ".join(facts["held"])
    return caps


def place_of(key, reg, host):
    """"ok" when a rung-1 fix could be laid here: a registry repo, in no confidential scope, whose scope's yard is
    this host (the component's "a scope whose yard is another host is out of rung 1"); else why not."""
    repos = reg.get("repos") if isinstance(reg.get("repos"), dict) else {}
    if key not in repos:
        return "%s is not a registry repo" % key
    scopes = reg.get("scopes") if isinstance(reg.get("scopes"), dict) else {}
    for n, sc in sorted(scopes.items()):
        if isinstance(sc, dict) and sc.get("confidential") is True and common.scope_of_repo(key, reg={"scopes": {n: sc}, "repos": repos})[0]:
            return "in confidential scope %s" % n
    name, _ = common.scope_of_repo(key, reg=reg)
    yard = (scopes.get(name) or {}).get("yard") if name else None
    if not (isinstance(yard, str) and yard.lower() == host):
        return "its scope's yard is %s, not this host" % (yard or "unnamed")
    return "ok"


def pending_rows(cst, st):
    """({key: {row, tries}}, offset): the state's queue with the open issue rows intake.jsonl gained past its offset
    merged in (the last row per issue; a new body or label starts its tries again), less what is classified at that
    body and label, and what intake-state.json no longer holds open. An issue over a pass's CLASSIFY_MAX stays queued."""
    path = intake_file()
    off = cst.get("offset") or 0
    chunk = b""
    try:
        if path.stat().st_size < off:
            off = 0   # the file was replaced or cut: read it again, `done` keeps what was classified
        with open(path, "rb") as fh:
            fh.seek(off)
            chunk = fh.read()
    except FileNotFoundError:
        off = 0
    end = chunk.rfind(b"\n") + 1   # a torn last line waits for the next pass
    queue = {k: q for k, q in (cst.get("pending") or {}).items() if isinstance(q, dict) and isinstance(q.get("row"), dict)}
    for line in chunk[:end].splitlines():
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if not isinstance(r, dict) or r.get("event") not in ("seen", "opened", "reopened", "edited") \
                or r.get("state") != "open" or not r.get("repo") or not isinstance(r.get("number"), int):
            continue
        key = "%s#%d" % (r["repo"], r["number"])
        old = (queue.get(key) or {}).get("row") or {}
        same = (old.get("body_sha"), old.get("label")) == (r.get("body_sha"), r.get("label"))
        queue[key] = {"row": r, "tries": queue[key]["tries"] if key in queue and same else 0}
    done = cst.get("done") or {}
    out = {}
    for key, q in queue.items():
        r = q["row"]
        if str(r.get("number")) not in (((st.get("repos") or {}).get(r.get("repo")) or {}).get("open") or {}):
            continue   # closed or dropped since
        if done.get(key) == [r.get("body_sha"), r.get("label")]:
            continue
        out[key] = q
    return out, off + end


def classify(now=None):
    """(rows, summary, code): one classify pass. code 0, or 3 when the registry or ops.json will not read (nothing
    classified) or the gate cannot resolve its four rows (the queue held, no try spent). Off (no ops.json): no
    rows, the summary says so."""
    now = time.time() if now is None else now
    cfg, why = ops_config()
    if why:
        return [], why, 3
    if cfg is None:
        return [], "off: no %s (the desk is off)" % (common.CONFIG / "lighthouse" / "ops.json"), 0
    reg, torn = common.read_registry()
    if torn:
        return [], "the registry %s cannot be read: nothing classified (a torn registry is no fence)" % common.repos_json(), 3
    reg = reg or {}   # read once: every repo is judged against this one read (the trap on a re-read mid-loop)
    host = common.host_name()
    st = load_intake_state()
    try:
        cst = json.loads(classify_state_file().read_text(encoding="utf-8"))
        cst = cst if isinstance(cst, dict) else {}
    except (OSError, ValueError, UnicodeDecodeError):
        cst = {}
    queue, offset = pending_rows(cst, st)
    done = dict(cst.get("done") or {})
    repos = reg.get("repos") if isinstance(reg.get("repos"), dict) else {}
    extras = extra_repos(repos)
    rows, fenced, gone = [], 0, 0
    week = read_verdicts(now - 7 * 86400)
    ctx = {"now": now, "day": [r for r in week if r["ts"] >= now - 86400],
           "spent": sum(float(r.get("gate_cost_usd") or 0) + float(r.get("run_cost_usd") or 0) for r in week),
           "owners": {(e.get("github") or "").split("/")[0] for e in repos.values() if isinstance(e, dict) and isinstance(e.get("github"), str)} - {""}}

    def verdict(key, r, **kw):
        v = {"ts": int(now), "key": key, "repo": r["repo"], "number": r["number"], "kind": r.get("kind"),
             "author": r.get("author"), "scope": r.get("scope"), "event": r.get("event"), "dry": cfg["dry"], "laid": False}
        v.update(kw)
        return v
    def finish(key, r):
        done[key] = [r.get("body_sha"), r.get("label")]
        queue.pop(key, None)

    def failed(key, r, **kw):
        tries = queue[key]["tries"] + 1
        rows.append(verdict(key, r, labels=kw.pop("labels", None), rung=None, caps={}, would="none", tries=tries, **kw))
        if tries >= CLASSIFY_TRIES:
            finish(key, r)
        else:
            queue[key]["tries"] = tries
    batch, facts, fetched, held = {}, {}, 0, 0
    down = gate_down() if any(q["row"].get("kind") not in ALARM_KINDS for q in queue.values()) else None
    for key, q in sorted(queue.items(), key=lambda kv: (kv[1]["row"].get("seen") or 0, kv[0])):
        r = q["row"]
        if r["repo"] not in repos and r["repo"] not in extras:
            queue.pop(key)
            continue
        if r["repo"] in repos and repo_fenced(r["repo"], reg, host):
            fenced += 1   # never fetched, never sent to a model, no row, no state: a confidential scope is classified on its yard
            queue.pop(key)
            continue
        if r.get("kind") in ALARM_KINDS:
            rows.append(verdict(key, r, labels=None, rung=4, rung_why="kind %s" % r["kind"], caps={}, would="alarm",
                                gate="skipped: an alarm kind goes to no model", gate_cost_usd=0.0, published="unknown"))
            finish(key, r)
            continue
        if down:
            held += 1   # kept queued, its tries untouched: the gate's failure is no fault of the item's
            continue
        # every fetch counts against the pass's limit, a failed one too: a hung gh costs GH_TIMEOUT each
        if fetched >= CLASSIFY_MAX:
            continue
        fetched += 1
        slug = (repos.get(r["repo"]) or {}).get("github") if r["repo"] in repos else extras[r["repo"]][0]
        try:
            issue = gh_json("repos/%s/issues/%d" % (slug, r["number"]))
            if not isinstance(issue, dict):
                raise Refused("gh answered no issue")
        except Refused as e:
            failed(key, r, error="fetch: %s" % e, gate_cost_usd=0.0, published="unknown")
            continue
        # gh follows a transferred issue's redirect: an answer from another repo (a confidential one, maybe) is
        # never read on, and the fence judged only this one (S5's landing review)
        if not str(issue.get("repository_url") or "").lower().endswith("/repos/" + slug.lower()):
            gone += 1
            queue.pop(key, None)
            continue
        if issue.get("state") != "open":
            gone += 1
            queue.pop(key, None)   # not `done`: a reopened issue, unchanged, is classified then
            continue
        names = [l.get("name") if isinstance(l, dict) else l for l in issue.get("labels") or []]
        names = [n for n in names if isinstance(n, str)]
        title, body = str(issue.get("title") or ""), str(issue.get("body") or "")
        text = "%s\n%s" % (title, body)
        paths = repo_paths(r["repo"]) if r["repo"] in repos else None
        batch[key] = "repo: %s\nlabels: %s\ntitle: %s\nbody: %s" % (r["repo"], ", ".join(names) or "none", title, body[:BODY_MAX])
        facts[key] = {"kind": r.get("kind"), "author": r.get("author"), "labels": names, "held": held_classes(text, paths),
                      "place": place_of(r["repo"], reg, host), "published": published_of(text, paths), "row": r}
        del title, body, text   # the issue's words go to the gate and nowhere else
    if batch:
        ids = {key: "i%d" % n for n, key in enumerate(sorted(batch))}
        got, cost, meta = run_gate({ids[k]: t for k, t in batch.items()},
                                   {ids[k]: facts[k]["row"]["repo"] for k in batch})
        share = round(cost / len(batch), 6)
        ctx["spent"] += cost
        batch.clear()
        for key in sorted(ids):
            f, r, i = facts[key], facts[key]["row"], ids[key]
            labels = {d: got[d][0].get(i) for d in SITES}
            errs = ["%s: %s" % (d, got[d][1] or "no label") for d in SITES if labels[d] is None]
            gate = dict(meta, cost_usd=round(cost, 6), items=len(ids))
            if errs:
                failed(key, r, labels=labels, error="gate: " + "; ".join(errs), gate=gate, gate_cost_usd=share,
                       published=f["published"])
                continue
            rung, rwhy = ladder(labels, f)
            v = verdict(key, r, labels=labels, rung=rung, rung_why=rwhy, gate=gate, gate_cost_usd=share, published=f["published"],
                        held=f["held"])
            v["caps"] = judge_caps(cfg, rung, v, f, ctx)
            v["would"] = would_of(rung, v["caps"], f)
            rows.append(v)
            if v["would"] == "lay":
                ctx["day"].append(v)   # this pass's lays count against the day's caps too
            finish(key, r)
    append_verdicts(rows)
    cst.update(offset=offset, done=done, pending=queue, as_of=int(now))
    path = classify_state_file()
    os.makedirs(path.parent, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(cst, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)
    by = {}
    for v in rows:
        by[v["would"]] = by.get(v["would"], 0) + 1
    summary = "%d verdicts (%s)%s%s%s%s" % (
        len(rows), ", ".join("%d %s" % (n, w) for w, n in sorted(by.items())) or "none",
        "; %d fenced" % fenced if fenced else "", "; %d closed since" % gone if gone else "",
        "; %d queued for the next pass" % len(queue) if queue else "",
        "" if cfg["dry"] else "; dry is false, but S5 lays nothing: `ops send` is S6's")
    if down:
        return rows, "%s; the gate cannot classify, %d held, no try spent: %s" % (summary, held, down), 3
    return rows, summary, 0


def append_verdicts(rows):
    if not rows:
        return
    path = verdicts_file()
    os.makedirs(path.parent, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, "".join(json.dumps(r, sort_keys=True, separators=(",", ":")) + "\n" for r in rows).encode())
    finally:
        os.close(fd)


def classify_lock():
    import fcntl
    path = common.LOG_DIR / "classify.lock"
    os.makedirs(path.parent, exist_ok=True)
    fh = open(path, "a")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def run_classify():
    lock = classify_lock()
    if lock is None:
        print("ops classify: another pass holds %s; this one skipped" % (common.LOG_DIR / "classify.lock"))
        return 0
    try:
        _, summary, code = classify()
    finally:
        lock.close()
    print("ops classify: %s — %s" % (verdicts_file(), summary), file=sys.stderr if code else sys.stdout)
    return code


def cmd_classify(a):
    why = desk_refusal() or ops_host()[1]
    if why:
        # a session's pass would send issues to a model outside the desk's job and move its state
        print("ops classify: %s" % why, file=sys.stderr)
        return 2
    return run_classify()


def digest(days, now=None):
    """The logged week's counts: by rung, kind and would; the caps' refusals; rung-1 candidates on published
    paths (D4's fact); errors; the gate's spend."""
    now = time.time() if now is None else now
    rows = read_verdicts(now - days * 86400)
    d = {"days": days, "verdicts": len(rows), "issues": len({r.get("key") for r in rows}), "by_rung": {}, "by_kind": {},
         "by_would": {}, "refused": {}, "rung1_published": {"yes": 0, "no": 0, "unknown": 0}, "errors": 0,
         "gate_usd": round(sum(float(r.get("gate_cost_usd") or 0) for r in rows), 4)}
    for r in rows:
        if r.get("error"):
            d["errors"] += 1
            continue
        for k, v in (("by_rung", str(r.get("rung"))), ("by_kind", str(r.get("kind"))), ("by_would", str(r.get("would")))):
            d[k][v] = d[k].get(v, 0) + 1
        for c, v in (r.get("caps") or {}).items():
            if v != "ok":
                d["refused"][c] = d["refused"].get(c, 0) + 1
        if r.get("rung") == 1:
            p = r.get("published") if r.get("published") in ("yes", "no") else "unknown"
            d["rung1_published"][p] += 1
    ratio, _ = common.cost_ratio()
    d["gate_effective_usd"] = round(d["gate_usd"] * ratio, 4) if ratio else None
    return d


def cmd_digest(a):
    d = digest(a.days)
    if a.json:
        print(json.dumps(d, indent=1, sort_keys=True))
        return 0
    names = {"0": "none", "1": "just happens", "2": "a skipper's ship", "3": "ask", "4": "alarm"}
    print("ops digest: the last %d days — %d verdicts on %d issues, %d errors" % (d["days"], d["verdicts"], d["issues"], d["errors"]))
    for k in sorted(d["by_rung"]):
        print("  rung %s (%s): %d" % (k, names.get(k, k), d["by_rung"][k]))
    print("  would:   %s" % (", ".join("%s %d" % kv for kv in sorted(d["by_would"].items())) or "none"))
    print("  kinds:   %s" % (", ".join("%s %d" % kv for kv in sorted(d["by_kind"].items())) or "none"))
    print("  refused: %s" % (", ".join("%s %d" % kv for kv in sorted(d["refused"].items())) or "none"))
    p = d["rung1_published"]
    print("  rung 1 on published paths (D4's fact): %d yes, %d no, %d unknown" % (p["yes"], p["no"], p["unknown"]))
    print("  the gate: %s list (%s)" % (common.usd(d["gate_usd"]), "%s effective" % common.usd(d["gate_effective_usd"])
                                         if d["gate_effective_usd"] is not None else "effective unknown: no ratio"))
    return 0


def main(argv):
    ap = argparse.ArgumentParser(prog="ops", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    s = sub.add_parser("sample")
    s.add_argument("--print", action="store_true")
    st = sub.add_parser("status")
    st.add_argument("--json", action="store_true")
    sub.add_parser("is-host")
    sub.add_parser("ingest")
    sub.add_parser("classify")
    dg = sub.add_parser("digest")
    dg.add_argument("--days", type=int, default=7)
    dg.add_argument("--json", action="store_true")
    it = sub.add_parser("intake")
    it.add_argument("--json", action="store_true")
    u = sub.add_parser("usage")
    u.add_argument("--write", action="store_true")
    u.add_argument("--json", action="store_true")
    k = sub.add_parser("pick")
    k.add_argument("--apply", action="store_true")
    k.add_argument("repo", nargs="*")
    a = ap.parse_args(argv)
    return {"usage": cmd_usage, "pick": cmd_pick, "sample": cmd_sample, "status": cmd_status,
            "is-host": cmd_is_host, "ingest": cmd_ingest, "intake": cmd_intake, "classify": cmd_classify,
            "digest": cmd_digest}[a.verb](a)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
