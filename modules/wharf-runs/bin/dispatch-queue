#!/usr/bin/env python3
"""dispatch-queue — the fleet's queue of dispatch runs: one git ref every host claims from by
compare-and-swap, and a node-local queue per confidential scope (S1 of docs/dispatch-queue-2026-10-25.md;
the ref's component, docs/dispatch-queue-ref-2026-10-25.md). bin/dispatch calls it and passes the facts it
holds the one home of (this host, the cap, the job's script, the label prefix); nobody else needs to.

    dispatch-queue home                    the queue's home (a URL or a path), exit 1 when there is none
    dispatch-queue enqueue --repo R --branch B [--priority P] [--pin HOST] [--needs a,b] [--by SID] [--cwd DIR]
                   [--arg=FLAG]... [--env K=V]... [--refused WHY] [--after B2]... [--claim] CTX
                                           one entry per branch (a later one replaces a queued one); with
                                           --claim, this host then claims what it has room for. One JSON
                                           line on stdout: key, qid, store, result, rank, claimed
                                           --needs: features a claiming host's `wharf-runs/features` line must name; a
                                           need no host that may take the repo meets exits 3 and is never queued.
                                           --after: the claim skips it until B2 is proved on origin/<main> (S9)
    dispatch-queue land --repo R --branch B --topic T --pid P CTX
                                           a landing (dispatch --start's /finish) with no room: an entry of
                                           kind landing in this host's queue-local/_land, ranked above every
                                           build but force; nothing of its run is in it (S9). JSON: qid, rank
    dispatch-queue land-wait QID --pid P [--for S]
                                           block until this host's claim takes the landing for process P:
                                           exit 0 claimed, 3 gone, 6 past --for (the entry then removed)
    dispatch-queue claim [--event-at T] CTX
                                           claim and start what this host has room for, best first; T is
                                           when the slot freed (the watcher's word), for G3's event_at
    dispatch-queue sweep CTX               the outbox, this host's own entries reconciled, cards, a claim —
                                           every SWEEP seconds from the queue-sweep job (S2)
    dispatch-queue poll CTX                the pending poll's pass (S2): one ls-remote, a claim only when the
                                           ref moved or a cached entry is claimable here, then the poll job
                                           kept or booted out
    dispatch-queue kick QID [--cwd DIR] [--full a,b] CTX
                                           S8: kick every eligible peer of a queued fleet entry over its roads
                                           (bin/kicklib.py), in parallel; the payload names hosts only. Exit 2 for
                                           a node-local entry or a confidential cwd. enqueue runs it detached for
                                           a fleet entry this host did not take, where `wharf-runs/kick-roads` exists
    dispatch-queue kicked --from H --full a,b | --from-stream CTX
                                           S8, the receiver: the kick noted in queue/kicks/ and this host's
                                           queue-sweep job kickstarted, nothing more; the sweep holds back
                                           (3 s per higher-ranked berth of unknown room, 9 s cap), then claims
    dispatch-queue roads CTX               S8: the kick-roads lines what exists here gives
    dispatch-queue jobs CTX                the queue-sweep job installed where a home is (its plist rewritten
                                           only when it differs), both jobs removed where none is
    dispatch-queue list [--all] [--json] [--status]
    dispatch-queue cancel --repo R --branch B
    dispatch-queue waiting|started|refused|failed QID [--session S] [--why W]   the fire path's word
    dispatch-queue started --repo R --branch B --session S                      a run not from the queue
    dispatch-queue ended --repo R --branch B --session S                        the run's end
    dispatch-queue has --repo R --branch B [--state S]... [--except-session S] [--elsewhere]
                                           exit 0 none, 3 an entry, 4 unreadable — a reader counts 4 as 3
                                           (the readers' rule: an unreadable queue is "has an entry");
                                           --elsewhere: only one live on another host
    dispatch-queue reserved [--except QID] the slots this host's claims hold before their records (held())
    dispatch-queue cap --priority P CTX    the cap a start of P meets here: force's one slot over it (S4, D2-A)
    dispatch-queue floor                   the memory floor a force start must leave (headroom --floor; S4)
    dispatch-queue force-ok                exit 0 when this caller may have --priority force (the owner's terminal,
                                           or a session holding its force mark), else 2 and why (S4)
    dispatch-queue caller-prio             the rank the caller inherits from its own run's record (force as
                                           high; nothing with no record): the record whose claude is an
                                           ancestor of this process, never a session id (S4)
    dispatch-queue watch QID [--for MIN] [--until running|waiting]
                                           block on an entry, its states printed: 0 at running, 3 gone, 1 --for
                                           passed, 2 refused (S3: `dispatch --watch`; never dispatches or writes)
  enqueue's S3 flags: --wait REASON names the waiter in the entry; --replace takes a claimed, waiting or
  running entry (pinned to the host it is live on, unless the put carries a pin of its own) or another live session's queued one, which a put alone
  refuses (exit 3, "busy queued by session …"); --queued-at EPOCH ages a fired one-shot's entry from WHEN;
  --skip-hour (enqueue --refused, refused) skips it here an hour even when pinned here: a named login past
  its limits, which the next claim here would meet again.
    dispatch-queue unreserve QID [--label L]   a stale job's reservation given back at its exit
    Every verb: exit 5 for a crash, never 1, which dispatch reads as "the queue alone refused it".
    dispatch-queue requeue TOPIC|--all [--repo R] [--why W] [--dry-run] CTX
                                           S10: this host's busy runs (or TOPIC's) ended, their work committed and
                                           pushed, the brief given a "Continue from here" section, the entry queued
                                           again for any host; --why lid is the watcher's, at a sleep (no offline
                                           refusal; warm runs left). Exit 3 refused offline by hand, nothing ended
    dispatch-queue mine QID [--label L]    the fired job's check: still its claim? exit 0 yes, 3 no, 4 unreadable
  CTX: --host H --cap N --jobbin PATH --prefix P [--prefix-previous P0] [--launchctl CMD] [--rch CMD]
  (P0: wharf-runs/label-prefix-previous; `jobs` drops its sweep and poll once the new sweep loads)

The home: `wharf-runs/queue-repo` in the regatta config dir, set on purpose (`off` or empty: no queue);
`owner/name` is a GitHub repo over https, a path or URL is taken as it is — set the URL this host's git
reaches the repo by (the live case proved git@). No home: no queue, and dispatch runs as before it. Until
S2 brings the watcher's claim at a run's end and the sweep job, nothing else turns the queue on: S1 fell
back to `helm/logbook-repo`, which every Mac has, and so would have queued fleet-wide with nothing to
start a queued entry but some unrelated dispatch (the landing review's item 15). S2's first half brings
the claim at a run's end and the sweep, but not the fallback: with it, landing would switch the queue on
on every Mac before S3 gives the callers their words; the dispatch-queue session switches it on.

What starts a queued entry (S2, docs/dispatch-queue-kick-2026-10-25.md "The polls, bounded"): the
dispatch call that enqueues it, with room here; a slot freeing here — the watcher claims when its run
turns parked (warm or waiting: no longer counted) and the fire path when its run ends (dispatch-rc's
queue_claim); the queue-sweep job, every SWEEP seconds on every host with a home (`jobs` installs it at
each dispatch here, beside the tidier; `regatta check` fails a host with a home and no sweep); and the
pending poll, a POLL-second job loaded only on a host no kick road reaches (`wharf-runs/kick-roads`;
absent, no road reaches any host; kicklib.reached states the reading), with room, while the fleet ref
holds an entry it may yet take, and booted out once the ref holds none or this host is full (its runs'
ends claim then); and, from S8, a kick: a host that enqueued what it does not take kicks every eligible
peer over its first road (sheep, orca, ssh), whose receiver kickstarts its own sweep. G3's event_at:
the claim stamps it — the later of the entry's queue time and the slot's freeing (the watcher's
--event-at, else the last end recorded here) — and the run's `started` line in queue.jsonl carries it
beside its `wait_s`.

The ref, `refs/regatta/queue`, is no branch: no PR, CI or protection reads it. Every write is one orphan
commit (no parent, so the ref never grows) of the whole tree, pushed `--force-with-lease=<ref>:<the sha
fetched>`: the receiving repo refuses the loser of a race (probed 20 of 20 on a bare repo, the ref
component's Evidence), who fetches again — three tries with jitter. The push goes from a bare cache
clone with no hooks (queue/clone.git in run-seed's cache folder), by this script alone: the owner's push
rule names this one exception (D6-A); a session's own `git push` to the ref stays denied.

A write that cannot reach the home goes to the outbox (queue/outbox/), replayed in one CAS by every
later call and the sweep, each op conditional on what it changes still being as this host left it. A
claim never rests on a stale view: offline, this host claims only an entry it put itself and nobody
else has seen (still in its outbox), and the fired job's check (`mine`) takes the same proof offline —
the put and this job's claim both in the outbox, the key absent from the last ref fetched — so the job
runs; any other offline view is unreadable to it (the second review's items 4 and 15). Every fetch into
the cache clone, and the ref it moves after a push, holds the clone's lock: two fetches at once raced
on the ref and read as the home being down (items 3 and 8).

A confidential scope's runs never enter the fleet ref (docs/dispatch-queue-confidential-2026-10-26.md):
a torn registry refuses the enqueue (the fence trap: torn reads as no scopes), a repo or caller's cwd in
a confidential scope queues in queue-local/<scope>/, and a seed carrying a `.review` (a spawn out of a
node) queues in queue-local/_spawn/, `confined`, until confidential-reach S6 lands spawn_review_ok() and
the review is checked again at claim (the note's items 3 and 5). One local queue per host, claimed here
only (the note's open item: shared by git inside the node, or one per host).
"""
import argparse
import fcntl
import json
import os
import plistlib
import random
import re
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import core_path  # noqa: E402 — the regatta core (C2)
core_path.require()
import common  # noqa: E402

REF = "refs/regatta/queue"
LEASE = 15 * 60          # a claim with no record yet is the claimer's for this long (the ref component)
SWEEP = 10 * 60          # every host's sweep; an entry silent two sweeps is a card
SILENT_SWEEPS = 6        # a named host with no word on an unclaimed entry this many sweeps counts by this host's config
UNREAD_WHY = "the registry will not read, so no berth or clone host can be judged"
POLL = 60                # the pending poll's interval, on a host no kick road reaches (S2)
SPENT = 120              # a reservation whose job's plist is gone, whose job is not running and whose claimer
                         # has exited is spent this long after its claim: the job exited before its record
SKIP = 3600              # a host that refused an entry at fire time skips it this long
LOW_AGE = 2 * 3600       # a `low` entry older than this ranks as normal
FLOOR = 5                # a force entry's memory floor, % free: headroom --floor (D2-A); dispatch asks `floor`
MARK_AGE = 30 * 60       # a force mark older than this is not this turn's words
TRIES = 3
OUTBOX_TTL = 24 * 3600   # a put still unsent after a day is dropped, never replayed onto a branch that moved on
RANKS = {"force": 0, "high": 1, "normal": 2, "low": 3}
# S9: a landing ranks above every build but force (the owner's word for one run), by its kind — which dispatch
# --start alone writes, from what it runs, never from a caller's flag or variable (the brief; S4's unattended
# refusal stands: no rank is raised by a word)
LAND_RANK = 0.5
LAND_STORE = "_land"     # queue-local/_land: a landing's entry never leaves this host (its worktree is here)
LAND_WAIT = 6 * 3600     # a landing that waited this long in the queue gives up: autofinish's sweep starts it again
AFTER_BOUND = 48 * 3600  # an entry waiting this long on an --after predecessor files one card (it still holds)
LIVE = ("claimed", "waiting", "running")
STATES = ("queued",) + LIVE
# What a claimed entry may hand the fired dispatch: these flags alone, each value matched — an entry is
# data written by any host with write on the home, never a command line (the claim's guard)
FLAGS = {"--model": r"[A-Za-z0-9.\[\]_-]{1,40}", "--effort": r"low|medium|high|xhigh|max", "--note": r"(?s).{0,4000}",
         "--background": r"allow|deny", "--account": r"[A-Za-z0-9_.@-]{1,60}", "--mode": r"default|ask|dnd|yolo",
         "--priority": r"low|normal|high|force", "--yolo": None, "--if-room": None, "--force": None, "--headless": None,
         # a confidential origin by its marker only: the entry is pushed, and a scope's name never is (S5)
         "--origin": r"confidential:[0-9a-f]{8}",
         # the entry's needs again as a flag (S5): a host whose claimable predates S5 skips an entry carrying a flag
         # it does not know, so a mixed-version fleet never runs a run on a host lacking its feature
         "--needs": r"[a-z0-9][a-z0-9._-]{0,39}(,[a-z0-9][a-z0-9._-]{0,39})*"}
ENV_OK = re.compile(r"DISPATCH_(DEPTH|MODE|SKIPPER|MANAGER|SKIPPER_ACCOUNT|MANAGER_ACCOUNT|SHIP|PLAN|PLAN_SPACE|SKIPPER_HOST|MANAGER_HOST)")
BRANCH_OK = re.compile(r"claude/[A-Za-z0-9._/-]{1,200}")
# The launcher (S7's Linux half): launchd's launchctl on a Mac, as before; elsewhere bin/systemd-launchctl, the
# same verbs over systemd's user manager (its header says why one shim and not a branch per caller). Every job
# here goes through a launchctl word, so the default is the whole seam; dispatch passes its own (--launchctl).
LAUNCHCTL = "launchctl" if sys.platform == "darwin" else str(HERE / "systemd-launchctl")


def now():
    return int(os.environ.get("DISPATCH_QUEUE_NOW") or time.time())   # the tests move the clock


def cache():
    return Path.home() / "Library" / "Caches" / "run-seed"


def qdir():
    return cache() / "queue"


def logdir():
    return Path.home() / "Library" / "Logs" / "claude-weekly"


def event(kind, **kw):
    """One line in claude-weekly/queue.jsonl: what the queue did, for --status, the cards and G3's
    measures (`event_at` to `started`). Never raises."""
    try:
        logdir().mkdir(parents=True, exist_ok=True)
        with open(logdir() / "queue.jsonl", "a") as f:
            f.write(json.dumps(dict(at=now(), event=kind, **kw), sort_keys=True) + "\n")
    except OSError:
        pass


class Unreachable(Exception):
    """The home could not be read or written: the network, a 404, no write access — or this host's cache
    clone could not write the commit to push (a full disk, unwritable objects)."""


class Torn(Exception):
    """An entry in the queue does not parse: the queue is unreadable, never empty."""


class Refused(Exception):
    def __init__(self, msg, code=2):
        super().__init__(msg)
        self.code = code


def home():
    lines = common.config_lines("wharf-runs/queue-repo") or []   # no helm/logbook-repo fallback until S2 (header)
    v = lines[0].strip() if lines else ""
    if not v or v.lower() == "off":
        return None
    if v.startswith(("/", "~", "file:", "git@", "ssh:", "http:", "https:")) or v.endswith(".git"):
        return os.path.expanduser(v)
    return "https://github.com/%s.git" % v


def queue_mode():
    """`wharf-runs/queue-mode` (S10(g)): `claim`, the default, or `writes` — a host that may sleep with runs on it
    (a laptop) holds a home for its own writes alone: the requeue's ops and their outbox, replayed by its sweep
    at wake. It enqueues nothing of its own (dispatch's queue_on reads `home`, which says none) and claims
    nothing. A `<host>:<mode>` line is that host's; a bare line every other host's."""
    h, mode = host_name(), ""
    for line in common.config_lines("wharf-runs/queue-mode") or []:
        name, sep, v = line.partition(":")
        if sep and name.strip().lower() == h:
            return v.strip().lower() or "claim"
        if not sep and not mode:
            mode = line.strip().lower()
    return mode or "claim"


def claims_here():
    return queue_mode() != "writes"


def dark_wake():
    """True while this Mac is in a DarkWake (a Power Nap or maintenance wake with the lid shut): a claim then
    starts a run the sleep cuts again within seconds, so it claims nothing (S10(g)). Read from `pmset -g
    systemstate`, whose capabilities line lacks Graphics in a DarkWake (IOPMLib's kIOPMSystemCapabilityGraphics;
    the line itself probed awake on a Mac, the DarkWake form not yet: S10(a)). No reading is awake."""
    pm = os.environ.get("DISPATCH_PMSET") or ("pmset" if sys.platform == "darwin" else "")
    if not pm:
        return False
    try:
        r = subprocess.run([pm, "-g", "systemstate"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return False
    m = re.search(r"Current System Capabilities are:(.*)", r.stdout or "")
    return bool(m) and "Graphics" not in m.group(1).split()


def topic_of(branch):
    return re.sub(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}-", "", branch.rsplit("/", 1)[-1])


def key_of(repo, branch):
    return re.sub(r"[^A-Za-z0-9._-]", "_", "%s--%s" % (os.path.basename(str(repo).rstrip("/")), topic_of(branch)))


def repo_word(repo):
    """The repo as the entry names it: relative to the projects folder, whose home differs per host (one
    login name each); a repo outside it by its absolute path, claimable only where that path exists."""
    p = Path(repo).resolve()
    try:
        return str(p.relative_to(common.PROJECTS.resolve()))
    except ValueError:
        return str(p)


def repo_path(word):
    p = Path(word)
    return p if p.is_absolute() else common.PROJECTS / p


def rank(e, t=None):
    """Sort key: force, a landing (S9), high, normal, low, then age; `low` past LOW_AGE ranks as normal."""
    t = now() if t is None else t
    r = RANKS.get(e.get("priority") or "normal", 2)
    if r == 3 and t - int(e.get("queued_at") or t) >= LOW_AGE:
        r = 2
    if e.get("kind") == "landing" and r > LAND_RANK:
        r = LAND_RANK
    return (r, int(e.get("queued_at") or 0), e.get("key") or "")


# ---- stores: the fleet ref and a node-local folder, one shape ------------------------------------------

def _env():
    # no GIT_DIR, GIT_INDEX_FILE… a hook or a worktree left set; the transport's own settings stay, or a host
    # whose ssh needs them could fetch the home and never push to it
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_") or k in ("GIT_SSH", "GIT_SSH_COMMAND")}
    # LC_ALL=C: fetch() and push() class results by git's English text ("couldn't find remote ref", "stale
    # info"); a translated git read a missing ref as the home down (the third review's item 8)
    env.update(LC_ALL="C", LANG="C", GIT_TERMINAL_PROMPT="0", GIT_AUTHOR_NAME="regatta queue", GIT_AUTHOR_EMAIL="queue@regatta.invalid",
               GIT_COMMITTER_NAME="regatta queue", GIT_COMMITTER_EMAIL="queue@regatta.invalid")
    return env


DOWN_S = 60     # a home that did not answer is down for this long, in this process only
_DOWN = {}      # url -> (monotonic, why): every Fleet of one process waited out the fetch timeout again
                # (stores() builds a new one per call; the third review's item 13)
FRESH_S = 5     # a CAS round's own entries stand in for a fetch this long, in this process only
_FRESH = {}     # url -> (monotonic, the entries as JSON) — saves enqueue --claim two of its four fetches
SHA = re.compile(r"[0-9a-f]{40}")


def _sha(r, what):
    """The object id a git step printed, or Unreachable: an unchecked step returned "", and `push("")`
    is git's delete refspec, which took the whole fleet ref under a lease that matched (the second
    review's item 1)."""
    v = r.stdout.strip()
    if r.returncode != 0 or not SHA.fullmatch(v):
        raise Unreachable("the cache clone could not write %s (%s)" % (what, (r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1][:160]))
    return v


class Fleet:
    name = "fleet"

    def __init__(self, url):
        self.url = url
        self.clone = qdir() / "clone.git"
        self.offline = None   # why the last fetch failed, once one did
        self.write_refused = None   # the home's own no to the last do()'s push (push's "refused")
        self.contended = False      # the last do() lost the lease TRIES times while the home answered

    def git(self, *args, input=None, timeout=60):
        try:
            return subprocess.run(["git", "--git-dir=%s" % self.clone] + list(args), input=input, capture_output=True,
                                  text=True, env=_env(), timeout=timeout)
        except subprocess.TimeoutExpired:
            return subprocess.CompletedProcess(args, 124, "", "timed out after %d s" % timeout)

    def ensure(self):
        if not (self.clone / "HEAD").exists():
            self.clone.parent.mkdir(parents=True, exist_ok=True)
            subprocess.run(["git", "init", "-q", "--bare", str(self.clone)], capture_output=True, env=_env())
            # hook-less on purpose (D6-A): no pre-push here, and nothing a template dir would add
            for k, v in (("core.hooksPath", "/dev/null"), ("gc.auto", "0")):
                self.git("config", k, v)

    def locked(self, wait=75):
        """The clone's lock, held by every write of its ref (a fetch, the ref a push moves, the sweep's gc):
        two fetches at once failed `cannot lock ref … but expected`, which read as the home being down
        (the second review's items 3 and 8: 46 of 80 parallel fetches). Waited for WAIT seconds at most,
        then Unreachable: a holder fetches for up to a minute or collects for two, and `--status`'s 10 s,
        `mine` and `has` waited behind it with no bound (the third review's item 12)."""
        self.clone.parent.mkdir(parents=True, exist_ok=True)
        f = open(self.clone.parent / "clone.lock", "w")
        end = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return f
            except BlockingIOError:
                if time.monotonic() >= end:
                    f.close()
                    raise Unreachable("this host's queue clone is busy (another queue call held it %d s)" % wait)
                time.sleep(0.2)

    def fetch(self, timeout=30):
        # 30 s, not a minute: a fetch of one small ref answers in a second or two, and a hanging home cost an
        # enqueue its whole timeout (once: _DOWN; the first review's item 10)
        down = _DOWN.get(self.url)
        if down and time.monotonic() - down[0] < DOWN_S:
            self.offline = down[1]
            raise Unreachable(down[1])
        self.ensure()
        with self.locked(timeout + 15):
            for _ in range(2):
                r = self.git("fetch", "--no-tags", "-q", self.url, "+%s:%s" % (REF, REF), timeout=timeout)
                if r.returncode == 0 or "cannot lock ref" not in r.stderr.lower():
                    break
                # under the clone's lock no writer of it runs: a ref lock left behind is a killed fetch's
                for lk in (self.clone / (REF + ".lock"), self.clone / "packed-refs.lock"):
                    lk.unlink(missing_ok=True)
            if r.returncode == 0:
                self.offline = None
                return self.git("rev-parse", "-q", "--verify", REF).stdout.strip()
            if "couldn't find remote ref" in r.stderr.lower():
                self.git("update-ref", "-d", REF)
                self.offline = None
                return ""
        self.offline = (r.stderr.strip().splitlines() or ["git fetch exit %d" % r.returncode])[-1][:200]
        _DOWN[self.url] = (time.monotonic(), self.offline)
        raise Unreachable(self.offline)

    def cached(self):
        """The last fetched sha here, "" for none: what an offline view starts from."""
        self.ensure()
        return self.git("rev-parse", "-q", "--verify", REF).stdout.strip()

    def read(self, sha):
        if not sha:
            return {}
        r = self.git("ls-tree", "-r", "--name-only", sha, "--", "queue/")
        if r.returncode != 0:
            # a listing that failed is no empty queue: do() would push over every other host's entries
            # (the second review's item 2)
            raise Torn("the tree of %s does not list (%s)" % (sha[:10], (r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1][:160]))
        names = [n for n in r.stdout.splitlines() if n.endswith(".json")]
        out = {}
        if not names:
            return out
        # every entry through one `cat-file --batch`, not a process each (the fourth review's item 15):
        # each answer is "<sha> blob <size>\n<bytes>\n", in the order asked, or "<name> missing"
        try:
            b = subprocess.run(["git", "--git-dir=%s" % self.clone, "cat-file", "--batch"], capture_output=True, env=_env(),
                               input="".join("%s:%s\n" % (sha, n) for n in names).encode(), timeout=60)
        except subprocess.TimeoutExpired:
            raise Torn("the entries of %s did not read in 60 s" % sha[:10])
        buf, i = b.stdout, 0
        for n in names:
            try:
                assert b.returncode == 0
                j = buf.index(b"\n", i)
                head = buf[i:j].split()
                assert len(head) == 3 and head[1] == b"blob"
                size = int(head[2])
                e = json.loads(buf[j + 1:j + 1 + size].decode("utf-8"))
                assert isinstance(e, dict)
            except (ValueError, AssertionError, UnicodeDecodeError):
                raise Torn("%s in %s does not parse" % (n, sha[:10]))
            i = j + 1 + size + 1
            out[n[len("queue/"):-len(".json")]] = e
        return out

    def write(self, entries, why):
        """The commit of ENTRIES, every step checked (_sha): Unreachable, never an empty sha."""
        lines = []
        keys = sorted(entries)
        if keys:
            # one `hash-object --stdin-paths` for every entry, not a process each (the fourth review's item 15);
            # --no-filters: the bytes as written, never a host's own attributes or autocrlf (S2a review, item 7.5)
            with tempfile.TemporaryDirectory(prefix="queue-write.") as d:
                paths = []
                for i, k in enumerate(keys):
                    paths.append(os.path.join(d, "%d.json" % i))
                    with open(paths[-1], "w") as f:
                        f.write(json.dumps(entries[k], indent=1, sort_keys=True) + "\n")
                r = self.git("hash-object", "-w", "--no-filters", "--stdin-paths", input="\n".join(paths) + "\n")
            blobs = r.stdout.split()
            if r.returncode != 0 or len(blobs) != len(keys) or not all(SHA.fullmatch(x) for x in blobs):
                raise Unreachable("the cache clone could not write the entries (%s)" % ((r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1][:160]))
            lines = ["100644 blob %s\t%s.json" % (b, k) for b, k in zip(blobs, keys)]
        if lines:
            sub = _sha(self.git("mktree", input="\n".join(lines) + "\n"), "the queue's tree")
            root = _sha(self.git("mktree", input="040000 tree %s\tqueue\n" % sub), "the root tree")
        else:
            root = _sha(self.git("mktree", input=""), "the empty tree")
        # a nonce in every commit: two writes of the same tree in the same second (two claims of one entry
        # on one host) were one sha, and git called the second push up to date before it checked the lease
        return _sha(self.git("commit-tree", root, "-m", "%s\n\nwrite %s" % (why, uuid.uuid4().hex)), "the commit")

    def push(self, commit, base):
        """("ok" | "lost" | "refused" | "down", text): lost is a lease another writer won — fetch and try
        again; refused is the home's own no to this host's write (a hook, no write access): it answered, so
        the outbox would wait on it for a day for nothing (the third review's item 6)."""
        if not SHA.fullmatch(commit or ""):
            # an empty source is git's delete refspec: never pushed (the second review's item 1)
            return "down", "no commit to push (%r)" % commit
        r = self.git("push", "--porcelain", "--force-with-lease=%s:%s" % (REF, base), self.url, "%s:%s" % (commit, REF))
        if r.returncode == 0:
            # the local ref follows this host's own write, or cached() and every offline view lag one write
            # behind it and judge a deferred word against the state before it (the second review's item 9).
            # Only from the base it was fetched at: a fetch that moved it since holds a newer one. A busy lock
            # is skipped after a second, not waited for (the fourth review: behind a gc that was 75 s)
            try:
                with self.locked(wait=1):
                    self.git("update-ref", REF, commit, base or "0" * 40)
            except Unreachable:
                pass   # the push landed: the next fetch brings the ref here
            return "ok", ""
        text = (r.stdout + r.stderr).strip()
        low = text.lower()
        if ("stale info" in low or "cannot lock ref" in low or "but expected" in low or "fetch first" in low) and "permission" not in low:
            return "lost", text
        last = (text.splitlines() or ["push exit %d" % r.returncode])[-1][:200]
        if r.returncode != 124 and re.search(r"remote rejected|declined|permission|denied|could not read username|authentication failed|\b403\b", low):
            return "refused", last
        return "down", last

    def entries(self):
        """A fresh read; Unreachable or Torn when there is none to be had."""
        return self.read(self.fetch())

    def view(self, timeout=30):
        """(entries, offline-why): fresh when the home answers, else the last fetch with the outbox laid
        over it — for a local decision only, never for a claim of what others may hold. What this process
        itself wrote or read in a CAS round seconds ago counts as fresh: a claim re-reads in its own round."""
        hit = _FRESH.get(self.url)
        if hit and time.monotonic() - hit[0] < FRESH_S:
            return apply_all(json.loads(hit[1]), outbox_ops()), None
        try:
            return apply_all(self.read(self.fetch(timeout)), outbox_ops()), None
        except Unreachable as e:
            return apply_all(self.read(self.cached()), outbox_ops()), str(e)

    def do(self, ops, why, defer=True):
        """Apply OPS in one CAS round; [result per op]. Unreachable or contended thrice: the ops that
        change something go to the outbox (defer) and the results are the offline view's; with defer
        False, Unreachable instead — a claim never rests on a write the home has not taken."""
        last = ""
        self.write_refused = None
        self.contended = False
        _FRESH.pop(self.url, None)
        for i in range(TRIES):
            try:
                base = self.fetch()
                entries = self.read(base)
            except Unreachable as e:
                last = str(e)
                break
            res = [apply_op(entries, op) for op in ops]
            if not any(c for c, _ in res):
                _FRESH[self.url] = (time.monotonic(), json.dumps(entries))
                return [r for _, r in res]
            try:
                commit = self.write(entries, why)
            except Unreachable as e:   # the clone itself: no write, and never an empty push
                last = self.offline = str(e)
                break
            st, text = self.push(commit, base)
            if st == "ok":
                _FRESH[self.url] = (time.monotonic(), json.dumps(entries))
                return [r for _, r in res]
            last = text
            if st in ("down", "refused"):
                self.offline = text
                if st == "refused":
                    self.write_refused = text
                break
            time.sleep(random.uniform(0.2, 0.8) * (i + 1))
        else:
            # every round lost the lease while the home answered: the ops go to the outbox like an offline
            # write's, and say so — enqueue read this as online and dispatch said "queued … no room"
            # with no word of the outbox (the fourth review's item 11)
            self.contended = True
            self.offline = "the lease lost %d times (other hosts writing): %s" % (TRIES, (last.splitlines() or [""])[-1][:160])
        if not defer:
            raise Unreachable(last)
        view = apply_all(self.read(self.cached()), outbox_ops())
        out = []
        for op in ops:
            changed, r = apply_op(view, op)
            if changed:
                outbox_add(op)
            out.append(r)
        event("outbox", ops=[o.get("op") for o in ops], why=why, error=last)
        return out


class Local:
    """queue-local/<scope>/: the same entries as files, under one lock; nothing leaves this host."""

    def __init__(self, scope):
        # the folder's spelling is the name: route() names a scope raw and local_stores() by its folder, and
        # one entry had two queue ids ("acme corp", "acme_corp"; the third review's item 14)
        self.scope = re.sub(r"[^A-Za-z0-9._-]", "_", scope)
        self.name = "local=" + self.scope
        self.dir = cache() / "queue-local" / self.scope
        self.offline = None

    def _read(self):
        out = {}
        for p in sorted(self.dir.glob("*.json")):
            try:
                e = json.loads(p.read_text())
                assert isinstance(e, dict)
            except (OSError, ValueError, AssertionError):
                raise Torn("%s does not parse" % p)
            out[p.stem] = e
        return out

    def entries(self):
        return self._read()

    def view(self):
        return self._read(), None

    def do(self, ops, why, defer=True):
        self.dir.mkdir(parents=True, exist_ok=True)
        with open(self.dir / ".lock", "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            entries = self._read()
            # as text: apply_op changes an entry in place, so a copy of the dict would hold the same
            # objects and every claim, set and refuse would compare equal and never be written
            before = {k: json.dumps(v, sort_keys=True) for k, v in entries.items()}
            res = [apply_op(entries, op) for op in ops]
            for k in set(before) | set(entries):
                p = self.dir / ("%s.json" % k)
                if k not in entries:
                    p.unlink(missing_ok=True)
                elif json.dumps(entries[k], sort_keys=True) != before.get(k):
                    tmp = p.with_suffix(".tmp")
                    tmp.write_text(json.dumps(entries[k], indent=1, sort_keys=True) + "\n")
                    os.replace(tmp, p)
        return [r for _, r in res]


def local_stores():
    d = cache() / "queue-local"
    return [Local(p.name) for p in sorted(d.iterdir()) if p.is_dir()] if d.is_dir() else []


def stores():
    url = home()
    return ([Fleet(url)] if url else []) + local_stores()


def store_of(name):
    if name == "fleet":
        url = home()
        if not url:
            raise Refused("dispatch-queue: no queue home here (wharf-runs/queue-repo)")
        return Fleet(url)
    if name.startswith("local="):
        return Local(name[len("local="):])
    raise Refused("dispatch-queue: no store %r" % name)


def split_qid(qid):
    store, _, key = qid.partition(":")
    if not key:
        raise Refused("dispatch-queue: a queue id is STORE:KEY, not %r" % qid)
    return store_of(store), key


# ---- ops: the one way an entry changes, here and from the outbox ----------------------------------------

def _match(e, cond):
    return all((e.get(k) or None) == (v or None) for k, v in (cond or {}).items())


def apply_op(entries, op):
    """(changed, result) — OP applied to ENTRIES in place."""
    k, kind = op.get("key"), op.get("op")
    cur = entries.get(k)
    if kind == "put":
        new = dict(op["entry"])
        if cur is None:
            entries[k] = new
            return True, "queued"
        if cur.get("id") == new.get("id"):
            return False, "queued"   # a replay of a put that landed
        if (cur.get("branch"), cur.get("repo")) != (new.get("branch"), new.get("repo")):
            # the key is the repo's basename and the topic: another branch (or repo) of that name holds it,
            # and replacing it would lose that branch's run silently
            return False, "clash with %s" % cur.get("branch")
        if cur.get("state") == "queued":
            # a queued entry another live session put is that session's step: replacing it unasked loses its
            # waiter (the contract's Replacing). Judged here, inside the CAS round, against the entry the round
            # read: judged before it from this host's view, two racing enqueues each passed and the later
            # dropped the other's waiter (S3's second landing review, item 3). GUARD is the caller's session
            # (cmd_enqueue sets it unless --replace or a fire-time refusal), replayed from the outbox as written
            g = op.get("guard")
            if g is not None and cur.get("by") and cur.get("by") != g and waiter_live(cur):
                return False, "busy queued by session %s" % cur["by"][:8]
            # a later dispatch replaces a queued entry and keeps its place, its refusals and the host
            # whose run of the branch is live (the one-branch-one-host rule)
            new["queued_at"] = min(int(cur.get("queued_at") or new["queued_at"]), int(new["queued_at"]))
            # and its better rank: a later plain put (a run's --next at its own rank, a /later) demoted an
            # owner's force or high step silently; --replace is the caller's word over it (S4's second review)
            if not op.get("replace") and RANKS.get(cur.get("priority") or "normal", 2) < RANKS.get(new.get("priority") or "normal", 2):
                new["priority"] = cur["priority"]
                new["args"] = [x for x in _rank_args(new.get("args"), cur["priority"])]
            # `after` too (S9): a later put that names none (helm's retry, a fire-time requeue) never drops the
            # dependency silently; `--cancel` and a new dispatch with its own --after are the ways to change it
            for f in ("running_on", "refused_by", "attempts", "last_refusal", "after"):
                if cur.get(f) and not new.get(f):
                    new[f] = cur[f]
            if not op["entry"].get("refused_by") and new.get("refused_by"):
                # a fresh dispatch from a host is that host's new word: its own hour of skipping goes
                new["refused_by"] = {h: t for h, t in new["refused_by"].items() if h != (new.get("from") or "").lower()}
            entries[k] = new
            return True, "replaced"
        live_on = (cur.get("running_on") or "").lower()
        # the pin from a live run's --next: that run's own session, onto its own host — the step waits
        # there for the run to end (dispatch-rc after()), and the run's end leaves it (ended's session test).
        # Any put from the host the branch runs on does the same (a re-dispatch there, helm's stall retry):
        # before the queue it was a one-shot that waited in after() for the earlier run; a later claimed
        # job of the replaced entry finds it no longer its claim at fire time (cmd_mine) and never runs. Only
        # a running entry is replaced: a claimed or waiting one's job is past that check ("claimed here")
        pin = (new.get("host") or "").lower()
        if op.get("replace") and live_on:
            # --replace (S3, the contract's Replacing): the caller's word over a claimed, waiting or running
            # entry. The branch stays on the host it is live on, pinned there, so the claim there waits in
            # after() for the run in hand; that run's job finds the entry no longer its claim at its next
            # check (cmd_mine) and never runs the step beside it. A pin of its own stands — a typed --on here,
            # a host-local --account (enqueue's pin): moved to the other host, that login was not set up there
            # and the typed host was overridden (S3's second landing review, item 4). It is queued there with
            # running_on kept, so no claim takes it until the run in hand ends (branch_word's free, the sweep's)
            new["running_on"] = cur.get("running_on")
            new["host"] = pin or live_on
            entries[k] = new
            return True, "replaced"
        mine = new.get("by") and new.get("by") == cur.get("session") and pin == live_on
        here = live_on and (new.get("from") or "").lower() == live_on and pin in ("", live_on)
        if here and not mine and cur.get("state") != "running" and not (op.get("dead") and _match(cur, op["dead"])):
            # claimed or waiting here: its job fired and passed its check already, and would run the step
            # beside a replacement (the second review): this host has the step in hand, nothing to replace.
            # Unless enqueue found that claim dead (claim_dead: no job, no run, no reservation): then it is
            # replaced as a running entry is, or it blocked every dispatch of its branch here (item 10)
            return False, "claimed here"
        if mine or here:
            new["running_on"] = cur.get("running_on")
            new["host"] = live_on
            entries[k] = new
            return True, "replaced"
        return False, "busy %s on %s" % (cur.get("state"), cur.get("running_on") or "?")
    if cur is None:
        return False, "gone"
    if kind == "claim":
        h = op["host"]
        if cur.get("state") != "queued" or not _match(cur, op.get("cond")):
            return False, "taken"
        on = (cur.get("running_on") or "").lower()
        if on and on != h.lower():
            return False, "busy on %s" % on
        cur.update(state="claimed", claimed_by=h, claimed_at=op["at"], running_on=h, seen_at=op["at"],
                   attempts=int(cur.get("attempts") or 0) + 1, session="")
        if op.get("event_at"):
            cur["event_at"] = op["event_at"]   # G3: what made it startable (claim()'s stamp)
        cur.pop("job", None)
        if op.get("job"):
            cur["job"] = op["job"]
        return True, "claimed"
    if kind == "set":
        if not _match(cur, op.get("cond")):
            return False, "moved"
        for f, v in op["fields"].items():
            if v is None:
                cur.pop(f, None)
            else:
                cur[f] = v
        return True, "set"
    if kind == "refuse":   # a fire-time refusal: back to queued, the host noted
        if not _match(cur, op.get("cond")):
            return False, "moved"
        rb = dict(cur.get("refused_by") or {})
        # the hour's skip hands an entry to the other hosts; one pinned to this host has none, and the skip
        # cost a chain an hour per refusal on the only host it may run on (the third review's item 15).
        # Its retry is the next claim here (a run's end), its attempts still counted toward the card. A
        # refusal whose cause outlasts that claim (a named login past its limits) skips it here all the same,
        # or the only host re-claims it at every sweep until the login resets (S3's landing review, item 4)
        if op.get("skip") or (cur.get("host") or "").lower() != (op["host"] or "").lower():
            rb[op["host"]] = op["at"]
        for f in ("claimed_by", "claimed_at", "running_on", "job"):
            cur.pop(f, None)
        if op.get("keep_on"):
            # a run of the branch outside the queue is live on that host (branch_live_here): its mark stays,
            # or another host starts the branch beside it (the second review's item 11)
            cur["running_on"] = op["keep_on"]
        cur.update(state="queued", refused_by=rb, last_refusal=op["why"], session="")
        return True, "queued"
    if kind == "requeue":
        # S10: a busy run handed back by the host that held it (dispatch --requeue, by hand or at sleep), or by
        # the fleet on that host's own word, its branch tip (D8-B). Unlike `refuse`, no host skips it: the
        # hour's skip, and a pinned entry's re-offer at once, were both wrong for a run cut by a lid
        if not _match(cur, op.get("cond")):
            return False, "moved"
        for f in ("claimed_by", "claimed_at", "running_on", "job", "started"):
            cur.pop(f, None)
        cur.update(state="queued", session="", requeued_from=op["host"], requeued_at=op["at"], seen_at=op["at"])
        if op.get("skip"):
            # by hand, before a lid closes: the Mac that handed it back skips it the hour (`refuse`'s skip), or its own
            # poll or sweep claims it back before the lid shuts. At a sleep none: a DarkWake claims nothing
            cur["refused_by"] = dict(cur.get("refused_by") or {}, **{op["host"]: op["at"]})
        if op.get("args") is not None:
            cur["args"] = op["args"]
        if cur.get("priority") == "force":
            # force spent its one slot over the cap on the run that was cut: the step goes on at high (the verb)
            cur["priority"] = "high"
            cur["args"] = _rank_args(cur.get("args"), "high")
        return True, "requeued"
    if kind == "remove":
        if not _match(cur, op.get("cond")):
            return False, "moved"
        del entries[k]
        return True, "removed"
    return False, "unknown op %s" % kind


def apply_all(entries, ops):
    for op in ops:
        apply_op(entries, op)
    return entries


def outbox_dir():
    return qdir() / "outbox"


def outbox_files():
    d = outbox_dir()
    return sorted(d.glob("*.json")) if d.is_dir() else []


def outbox_ops():
    out = []
    for p in outbox_files():
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, ValueError):
            continue
    return out


def outbox_add(op):
    d = outbox_dir()
    d.mkdir(parents=True, exist_ok=True)
    op = dict(op, queued_op_at=now())
    tmp = d / (".%d.tmp" % os.getpid())
    tmp.write_text(json.dumps(op, sort_keys=True))
    p = d / ("%019d-%d.json" % (time.time_ns(), os.getpid()))
    os.replace(tmp, p)
    return p


def outbox_only(key):
    """True when KEY's put is in the outbox: the ref never saw it, so nobody else can hold it."""
    return any(o.get("op") == "put" and o.get("key") == key for o in outbox_ops())


def flush(fleet, ready=(), replay=False):
    """The outbox in one CAS round, oldest first, each op as conditional as when it was written. A put
    older than OUTBOX_TTL is dropped (logged), never written onto a branch that has moved on since. A
    requeue's op (S10) waits while hold_waits() says so: its branch reaches origin before the op does, so a
    host that claims the entry finds the cut run's work; READY names outbox files the verb proved so now.
    [(op, result)] of the ops the home answered ([] when none was sent): an op that came back stale is
    dropped, and a caller waiting on its own put reads why (S2a's landing review, item 5)."""
    files = outbox_files()
    if not files:
        return []
    ops, keep = [], []
    for p in files:
        try:
            op = json.loads(p.read_text())
        except (OSError, ValueError):
            p.unlink(missing_ok=True)
            continue
        if op.get("op") == "put" and not op.get("hold") and now() - int(op.get("queued_op_at") or 0) > OUTBOX_TTL:
            event("outbox-dropped", key=op.get("key"), why="unsent for a day")
            p.unlink(missing_ok=True)
            continue
        if op.get("hold") and p.name not in ready:
            # owed (S10): never dropped by age — a lid shut over a weekend is the case it is for, and the put of a
            # writes-only host's run is its only entry. Judged only where asked (the sweep's replay): every other
            # flush (has, fire, poll…) skips it unprobed, never a push from a reader's process
            why = hold_waits(op) if replay else "replayed by the sweep"
            if why == "drop":
                p.unlink(missing_ok=True)
                continue
            if why:
                if replay and now() - int(op.get("queued_op_at") or 0) > OUTBOX_TTL:
                    hold = op.get("hold") or {}
                    card("queue-owed", "fleet:%s" % op.get("key"), {"branch": hold.get("branch"), "repo": hold.get("repo")},
                         "a requeue from %s owed a day: %s" % (op.get("host"), why), mark=op.get("at"), say=False)
                continue
        ops.append(op)
        keep.append(p)
    if not ops:
        return []
    try:
        res = fleet.do(ops, "outbox of %s" % host_name(), defer=False)
    except (Unreachable, Torn):   # a torn ref: the outbox waits, and the caller's own read says so
        return []
    for p, op, r in zip(keep, ops, res):
        p.unlink(missing_ok=True)
        if stale(r):
            event("outbox-stale", key=op.get("key"), op=op.get("op"), result=r)
            if op.get("op") == "put" and r.startswith(("busy", "clash")):
                # its caller was told `queued` when the put went to the outbox, and has ended since: the put
                # it made is not in the queue, so a card says so, naming its session — an event alone dropped
                # its priority, mode and note unseen (S3's third landing review, item 6)
                e = op.get("entry") or {}
                card("queue-dropped", "fleet:%s" % op.get("key"), e,
                     "a put from %s held in the outbox (session %s), refused at its replay: %s"
                     % (e.get("from") or host_name(), (e.get("by") or "none")[:8], r), mark=e.get("id"), say=False)
    return list(zip(ops, res))


def git_in(wt, *args, timeout=60):
    """git in a run's worktree, for the requeue: (exit, stdout stripped); 124 on a timeout, 127 with no git."""
    try:
        # the user's own git identity and config (a Requeue: commit is the user's, as a checkpoint is), never
        # _env()'s queue author; only what a hook or a worktree left set is dropped, as _env() drops it
        env = {k: v for k, v in os.environ.items() if k not in ("GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE", "GIT_PREFIX")}
        r = subprocess.run(["git", "-C", str(wt)] + list(args), capture_output=True, text=True, timeout=timeout,
                           env=dict(env, LC_ALL="C", GIT_TERMINAL_PROMPT="0"))
    except subprocess.TimeoutExpired:
        return 124, ""
    except OSError:
        return 127, ""
    return r.returncode, (r.stdout or "").strip()


def origin_tip(wt, branch, timeout=20):
    """The branch's sha on origin ("" for none), or None when origin did not answer."""
    rc, out = git_in(wt, "ls-remote", "origin", "refs/heads/" + branch, timeout=timeout)
    if rc != 0:
        return None
    return (out.split() or [""])[0]


def hold_waits(op):
    """Why an owed requeue op (S10, its `hold`) waits in the outbox, or None once it may be written: its verb is
    still running (it writes the op itself), or its branch is not on origin at the tip the op stands for. A verb
    cut before it committed (the sleep came first) left no tip: the branch's local tip stands for it. The replay
    pushes the branch first, and the op goes only once origin holds that tip: the fleet's claim must find the cut
    run's work (the requeue component's step 6; sync-unpushed alone waits for a session start).
    "drop" when the run it stands for was never ended by the requeue (the verb died before or while ending it, and
    the run then ended its own way): the op would queue a step its own run finished or holds. Origin past the tip
    (a later commit, another host's continuation) holds it too: the tip is an ancestor of origin's."""
    hold = op.get("hold") or {}
    pid = hold.get("pid")
    if pid:
        try:
            if rc_mod().running(int(pid), hold.get("pstart") or ""):
                return "its requeue is running"
        except (TypeError, ValueError):
            pass
    if hold.get("record"):
        try:
            rec = json.loads(Path(hold["record"]).read_text())
        except (OSError, ValueError):
            rec = None
        word = str((rec or {}).get("ending") or (rec or {}).get("end_reason") or "")
        if rec is not None and not word.startswith(REQUEUED):
            if rec.get("ended"):
                event("requeue-dropped", key=op.get("key"), why="its run ended its own way: %s" % word[:80])
                return "drop"
            return "its run was not ended by the requeue"
        if rec is not None and not rec.get("ended"):
            # end_run writes `ending` before its signal: a verb cut between the two leaves a live run marked
            return "its run is not ended yet"
    wt, br = hold.get("wt") or "", hold.get("branch") or ""
    if not br or not wt or not os.path.isdir(wt):
        return None   # no worktree here to push from: the branch is as origin has it
    tip = hold.get("tip")
    if not tip:
        rc, tip = git_in(wt, "rev-parse", "-q", "--verify", "refs/heads/" + br)
        if rc != 0 or not tip:
            return None
    there = origin_tip(wt, br)
    if there is None:
        return "origin did not answer"
    if there == "":
        # the branch is gone from origin (landed and deleted, or by hand): pushing it would bring it back, and the
        # entry the op stands for has moved on with it (the second review)
        event("requeue-dropped", key=op.get("key"), why="its branch %s is gone from origin" % br)
        return "drop"

    def anc(a, b):
        """True or False as merge-base says (0 or 1); None when it could not tell — a commit the fetch never
        brought exits 128, which is no divergence (S10's finish review)."""
        for c in (a, b):
            if git_in(wt, "cat-file", "-e", c + "^{commit}")[0] != 0:
                git_in(wt, "fetch", "-q", "--no-tags", "origin", "refs/heads/" + br, timeout=60)
                break
        rc = git_in(wt, "merge-base", "--is-ancestor", a, b)[0]
        return True if rc == 0 else False if rc == 1 else None

    def holds(sha):
        return sha == tip or (bool(sha) and anc(tip, sha))
    h = holds(there)
    if h:
        return None
    if h is None or anc(there, tip) is None:
        return "origin's %s did not fetch" % br
    if anc(there, tip) is False:
        # origin went elsewhere (rewritten by a landing, or another host's run): this tip can never reach it
        event("requeue-dropped", key=op.get("key"), why="origin's %s diverged from the requeue's tip" % br)
        card("queue-owed", "fleet:%s" % op.get("key"), {"branch": br, "repo": hold.get("repo")},
             "a requeue's branch %s diverged on origin; its op dropped, its tip %s kept in the worktree" % (br, tip[:10]),
             mark=op.get("at"), say=False)
        return "drop"
    git_in(wt, "push", "-q", "origin", "refs/heads/%s:refs/heads/%s" % (br, br), timeout=90)
    if holds(origin_tip(wt, br)):
        event("requeue-pushed", key=op.get("key"), branch=br, tip=tip[:12])
        return None
    return "its branch %s is not on origin at %s" % (br, tip[:10])


def stale(r):
    """An op's result that wrote nothing: what it was conditional on has moved on, or the key is held."""
    return r in ("moved", "taken", "gone") or r.startswith(("busy", "clash", "claimed here"))


# ---- this host ----------------------------------------------------------------------------------------

_HOST = None


def host_name():
    return (_HOST or os.environ.get("DISPATCH_HOST") or common.host_name() or "").lower()


def claims_dir():
    return qdir() / "claims"


def job_running(launchctl, label):
    if not label:
        return False
    try:
        r = subprocess.run([launchctl, "print", "gui/%d/%s" % (os.getuid(), label)], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "\tstate = running" in r.stdout


def reservations(launchctl=LAUNCHCTL):
    """{file: reservation} not yet spent: younger than the lease, or with a job launchd says is running
    (one waiting in after() keeps its reservation only while it lives), and with no record of its run
    yet. Whether one holds a slot now is held()'s. A record whose `queue` names the claim, started since, is the run live() counts now: its
    reservation is spent there, and counting both refused the next job at the cap (the review's item 5).
    One file per claim (_resfile's tag): two claimers of one entry each hold and drop their own."""
    d = claims_dir()
    out = {}
    if not d.is_dir():
        return out
    recs = None
    for p in d.glob("*.json"):
        try:
            r = json.loads(p.read_text())
        except (OSError, ValueError):
            # a reader between a write's truncate and its bytes (a writer before _reswrite): keep it
            try:
                young = time.time() - p.stat().st_mtime < LEASE
            except OSError:
                continue
            if young:
                out[p.stem] = {}
            else:
                p.unlink(missing_ok=True)
            continue
        if r.get("qid"):
            recs = records() if recs is None else recs
            if any(x.get("queue") == r["qid"] and int(x.get("started") or 0) >= int(r.get("at") or 0) for x in recs):
                p.unlink(missing_ok=True)
                continue
        age = now() - int(r.get("at") or 0)
        if job_running(launchctl, r.get("label")):
            out[p.stem] = r
        elif age < LEASE and not (age >= SPENT and r.get("label") and not (agents() / ("%s.plist" % r["label"])).exists()
                                  and not claimer_alive(r)):
            out[p.stem] = r
        else:
            # past the lease; or its job exited before its record (a stale job, a failure: its cleanup
            # removes its plist), which held its slot until the lease (the first review's item 10)
            p.unlink(missing_ok=True)
    return out


def claimer_alive(r):
    """The process that wrote reservation R still runs: its claim is in flight. claim() stamps `at` before its
    CAS round (a fetch, a push, up to three tries) and start_job writes the plist after it, so a slow round
    passed SPENT with no plist yet, and another claimer gave the slot back and took one past the cap (S2a's
    finish review). A reused pid holds the slot until the lease, never past it: the safe side."""
    try:
        pid = int(r.get("pid"))
    except (TypeError, ValueError):
        return False
    return rc_mod().alive(pid)


def _reswrite(qid, tag, r):
    """A reservation, whole or not at all: the lock-free readers (`reserved`, the fire path) see either."""
    p = _resfile(qid, tag)
    tmp = p.with_name(".%s.tmp" % p.name)
    tmp.write_text(json.dumps(r))
    os.replace(tmp, p)


def _resfile(qid, tag):
    return claims_dir() / ("%s.%s.json" % (re.sub(r"[^A-Za-z0-9._=-]", "_", qid), tag))


def unreserve(qid, tag=None, label=""):
    """This claimer's reservation of QID (TAG), or, from the fire path, QID's for its job's LABEL (every
    one of QID without a label): a stale job's word never frees a newer claim's slot."""
    if tag:
        _resfile(qid, tag).unlink(missing_ok=True)
        return
    d = claims_dir()
    for p in d.glob("*.json") if d.is_dir() else []:
        try:
            r = json.loads(p.read_text())
            if r.get("qid") == qid and (not label or r.get("label") in (None, "", label)):
                p.unlink(missing_ok=True)
        except (OSError, ValueError):
            continue


# ---- the slots: what holds one (docs/dispatch-queue-ref-2026-10-25.md, "Slots") ---------------------------
#
# A slot here is held by (1) a live run — a record not ended whose claude is the run's, not parked: the
# fire path's own count, `dispatch-rc live --no-reap` (its counted(), parked runs past MAX_PARKED included); (2) a claim's reservation, from the claim until its
# run's record exists; (3) a --next claimed here and waiting in after() for its branch's earlier run: its
# reservation stays, marked `waiting`, and counts only once that earlier run no longer holds its own slot —
# never both, never neither (the third review's item 4: the earlier run's end claimed the slot the waiter
# had handed back, and the waiter was refused at its cap on the only host it may use). held() is the one
# definition; busy() adds the runs; claim() counts under dispatch's start lock, which the fire path holds
# from its own count to its record (item 19), so a claim and a one-shot never both take the last slot.

def live_runs():
    """The live runs live() counts: dispatch-rc's live(), in process, no reaping, parked ones left out."""
    m = rc_mod()
    return [st for _, st in m.live(None, None, False) if not m.parked(st)]


def held(launchctl=LAUNCHCTL, except_qid=None, runs=None):
    """The reservations that hold a slot now, bar EXCEPT_QID's: every one but a waiting one whose earlier
    run still holds its own (a live run of its repo's topic)."""
    m, out = rc_mod(), []
    for r in reservations(launchctl).values():
        if except_qid and r.get("qid") == except_qid:
            continue
        if r.get("waiting"):
            runs = live_runs() if runs is None else runs
            if any(st.get("topic") == r.get("topic") and m.same_repo(st.get("repo"), r.get("repo")) for st in runs):
                continue
        out.append(r)
    return out


def busy(launchctl, repo="", topic="", except_qid=None):
    """Slots held here, REPO's TOPIC's runs not counted (a claim of a live run's --next does not count the
    run it waits for: the review's item 7), nor EXCEPT_QID's reservation."""
    m = rc_mod()
    every = m.live(None, None, False)
    runs = [st for _, st in every if not m.parked(st)]
    n = m.counted([(k, st) for k, st in every
                   if not (topic and st.get("topic") == topic and m.same_repo(st.get("repo"), repo))])
    return n + m.vendor_slots() + len(held(launchctl, except_qid, runs))


def start_lock(wait=150):
    """dispatch's start lock (its take_lock: a directory holding the taker's pid; a dead taker's, or one with
    no pid older than 2 min, is taken over), or None after WAIT seconds."""
    d = cache() / "start.lock"
    d.parent.mkdir(parents=True, exist_ok=True)
    end = time.monotonic() + wait
    while time.monotonic() < end:
        try:
            d.mkdir()
        except FileExistsError:
            try:
                h = (d / "pid").read_text().strip()
            except OSError:
                h = ""
            try:
                old = time.time() - d.stat().st_mtime > 120
            except OSError:
                continue   # dropped meanwhile: take it
            if (h and not rc_mod().alive(h)) or (not h and old):
                try:
                    cur = (d / "pid").read_text().strip()
                except OSError:
                    cur = ""
                if cur == h:
                    (d / "pid").unlink(missing_ok=True)
                    try:
                        d.rmdir()
                    except OSError:
                        pass
            time.sleep(0.5)
            continue
        except OSError:
            return None
        (d / "pid").write_text("%d\n" % os.getpid())
        return d
    return None


def start_unlock(d):
    try:
        if d and (d / "pid").read_text().strip() == str(os.getpid()):
            (d / "pid").unlink(missing_ok=True)
            d.rmdir()
    except OSError:
        pass


def mark_waiting(qid, label=""):
    """The fire path's `waiting`: QID's reservation for LABEL's job stays, marked waiting (held())."""
    d = claims_dir()
    n = 0
    for p in d.glob("*.json") if d.is_dir() else []:
        try:
            r = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        if r.get("qid") == qid and (not label or r.get("label") in (None, "", label)):
            r["waiting"] = True
            tmp = p.with_name(".%s.tmp" % p.name)
            tmp.write_text(json.dumps(r))
            os.replace(tmp, p)
            n += 1
    return n


def headroom_refuses(floor=None):
    """Why memory refuses a start here (headroom's exit 3), else None; a broken probe never refuses. FLOOR:
    the force's line (headroom --floor: avail lowered to it, swap and rate kept)."""
    r = subprocess.run([sys.executable, str(HERE / "headroom"), "check"] + (["--floor", str(floor)] if floor is not None else []),
                       capture_output=True, text=True)
    return (r.stdout.strip() or "headroom") if r.returncode == 3 else None


def cap_for(cap, priority):
    """The cap a start of PRIORITY meets here. Force (D2-A of docs/dispatch-queue-2026-10-25.md) may take one
    slot over it: no other priority starts at CAP or more, and force never at CAP + 1, so at most one run is
    ever above the cap, and a second force entry waits first in line (its rank). Judged by the claiming host,
    from its own cap; dispatch's fire path asks the same (`cap`)."""
    return cap + 1 if priority == "force" else cap


_AF = []


def landing_peer(h):
    """A peer host H hands its landings to, as autofinish-run's own peer_of() reads it at the run's end — a
    peer with an ssh alias (without one the launch cannot run there). Its function, never a second copy:
    a copy that took any line where peer_of() takes the first disagreed with it (the third review's item 16)."""
    if not _AF:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        ld = SourceFileLoader("autofinish_run", str(HERE / "autofinish-run"))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
        ld.exec_module(m)
        _AF.append(m)
    old = os.environ.get("AUTOFINISH_HOST")
    os.environ["AUTOFINISH_HOST"] = h   # peer_of() judges its self_host(): the host claiming, here
    try:
        peer, alias, _ = _AF[0].peer_of()
    finally:
        if old is None:
            os.environ.pop("AUTOFINISH_HOST", None)
        else:
            os.environ["AUTOFINISH_HOST"] = old
    return bool(peer and alias)


# ---- eligibility: what a host may claim (S5; docs/dispatch-queue-contract-2026-10-25.md "Eligibility") ----
# Names are lower-case and opaque. The feature lines are the claiming host's own config, one line per host
# (`wharf-runs/features`, `<host>:<name>,<name>`): a need is met by a host whose line names it, and a host
# with no line meets none.
NEED_RE = re.compile(r"[a-z0-9][a-z0-9._-]{0,39}")
_BERTH = []


def berth_candidates(repo, h):
    """(the hosts the scope's `berths` and the repo's clone `hosts` let take REPO, why they did) — berth's own
    candidates(), the one home of those filters; with no berths, each peer `wharf-runs/ssh` names and H. A
    registry that is there but will not read gives none (berth's rule: read as empty it drops both filters)."""
    if not _BERTH:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        ld = SourceFileLoader("berth", str(HERE / "berth"))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
        ld.exec_module(m)
        _BERTH.append(m)
    cands, why = _BERTH[0].candidates(str(repo_path(repo)), h)
    return [x.lower() for x in cands], why


def features():
    """{host: {name}} from `<config>/wharf-runs/features`. A line naming a malformed feature drops that name
    only; a host with no line, and a file that does not read, are absent: they meet no need. A line with no
    `:` continues the host before it: the overlay's bootstrap writes a config value one word per line, so
    `host-a:feat-a, feat-b` arrives as two lines (AGENTS.md's trap; S5's landing review)."""
    out = {}
    last = None
    for ln in common.config_lines("wharf-runs/features") or []:
        if ":" not in ln:
            if last:
                out[last].update(n for n in (x.strip().lower() for x in ln.split(",")) if NEED_RE.fullmatch(n))
            continue
        host, _, names = ln.strip().partition(":")
        last = host.strip().lower() or None
        if host.strip():
            out.setdefault(host.strip().lower(), set()).update(
                n for n in (x.strip().lower() for x in names.split(",")) if NEED_RE.fullmatch(n))
    return out


def eligibility(e, h, feats=None):
    """Why host H may not take entry E by the config alone, or None — the pin, the scope's berths and the
    clone hosts, and the feature line against E's needs. The one function the claim's `claimable` calls
    (and the sweep's unclaimed card, for every host the config names): what a host's own state decides — its
    room, its hour's skip, its clone, the yolo rule — stays in `claimable`. `stopped` joins here once
    host-power's key exists on main (the design doc's S5, "Not built here")."""
    if e.get("host") and e["host"].lower() != h:
        return "pinned to %s" % e["host"]
    cands, why = berth_candidates(e.get("repo") or "/nonexistent", h)
    if why.get("unreadable"):
        return UNREAD_WHY
    if h not in cands:
        return "the repo's berths and clone hosts leave out %s" % h
    needs = e.get("needs") or []
    if not isinstance(needs, list) or any(not isinstance(n, str) for n in needs):
        return "needs is not a list of feature names"   # an entry is data any host with write may put
    if needs:
        feats = features() if feats is None else feats
        miss = [n for n in needs if n not in feats.get(h, set())]
        if miss:
            return "%s %s %s" % (h, "lacks" if h in feats else "has no feature line, so lacks", ", ".join(miss))
    return None


def fleet_hosts(e, local=False):
    """Every host the config names for E: the repo's berth candidates and the hosts with a feature line (a host
    that claims from the ref with no ssh alias here has only its line). LOCAL: E is in a node-local queue, which
    only this host ever claims, so this host alone."""
    if local:
        return [host_name()]
    cands, _ = berth_candidates(e.get("repo") or "/nonexistent", host_name())
    pin = (e.get("host") or "").lower()
    return sorted(set(cands) | set(features()) | ({pin} if pin else set()))   # the pin names a host whatever this config says


def fleet_fence(e, h=None):
    """Why host H (this one) may not claim fleet entry E by the fence (S7's Linux half, kept on every host), or None.
    A fleet entry never runs a confidential scope's repo — route() keeps those in a node-local queue, so one
    on the ref is a put this host's registry would not have made — and every scope is walked, not the first
    that lists the repo (AGENTS.md: an umbrella scope hides a confidential one). A torn registry refuses
    them all (the fence trap). `wharf-runs/queue-repos`, one repo key per line, narrows what this host
    claims from the fleet ref: a host opened to fleet work for a few repos (a scope's node) lists those;
    absent, every repo cloned here, as before it. A line `<key> pinned` takes that repo's entries only when
    they are pinned to this host: the opening's first step, and how a test entry is proved while every
    other session's entry of the repo stays the Macs'. A file that is there but will not read refuses every
    entry (read as absent, it would open the host to every repo); a line that is only `pinned` belongs to the
    key before it, as the overlay's bootstrap writes a value one word per line (AGENTS.md's trap). Each
    confidential scope judges the key with the core's scope_of_repo, as route() does: a glob member matches a
    key the registry's `repos` lacks, which scope_members would drop (the landing reviews)."""
    h = (h or host_name()).lower()
    word = str(e.get("repo") or "")
    allow, why = common.config_read("wharf-runs/queue-repos")
    if why:
        return "wharf-runs/queue-repos does not read here (%s): this host claims nothing from the fleet" % why
    key = common.repo_key(str(repo_path(word))) or word
    if allow is not None:
        rows, last = {}, None
        for words in (l.split() for l in allow):
            if words == ["pinned"] and last:
                rows[last].append("pinned")
            elif words:
                last = words[0]
                rows.setdefault(last, []).extend(words[1:])
        if key not in rows:
            return "%s is not one wharf-runs/queue-repos lets this host claim" % word
        if "pinned" in rows[key] and (e.get("host") or "").lower() != h:
            return "wharf-runs/queue-repos lets this host claim %s only when pinned here" % word
    reg, torn = common.read_registry()
    if torn:
        return "the registry does not read here (a fleet entry waits until its scopes read)"
    repos = (reg or {}).get("repos") or {}
    for name, sc in common.confidential_scopes(reg=reg).items():
        if common.scope_of_repo(key, reg={"scopes": {name: sc}, "repos": repos})[0] == name:
            return "its repo is in a confidential scope: a fleet entry never runs one"
    return None


def claimable(e, h, t=None, fleet=False):
    """Why this host may not claim E, or None (the S1 filters, and `eligibility`'s: the pin, the berths, the features).
    FLEET: E is the fleet ref's, and the fence (fleet_fence) judges it too."""
    t = now() if t is None else t
    if e.get("state") != "queued":
        return "it is %s" % e.get("state")
    why = eligibility(e, h)   # the pin first, as its text always led the listing
    if why:
        return why
    if e.get("running_on") and e["running_on"].lower() != h:
        return "its branch runs on %s" % e["running_on"]
    if t - int((e.get("refused_by") or {}).get(h) or 0) < SKIP:
        return "refused here within the hour"
    if not BRANCH_OK.fullmatch(e.get("branch") or ""):
        return "no claude/* branch"
    if not (repo_path(e.get("repo") or "/nonexistent") / ".git").exists():
        return "no clone of %s here" % e.get("repo")
    # a disarmed host may not take one, peer or not: yolo_launch declines here before autofinish-run, and
    # autofinish-run keeps every mode launch on its own Mac (the fourth review)
    if (e.get("mode") in ("yolo", "dnd")) and not common.autofinish_armed():
        return "a %s run's launch cannot run here (autofinish disarmed here)" % e.get("mode")
    if bad_args(e):
        return bad_args(e)
    if e.get("kind") == "landing" and not land_waiter_alive(e):
        return "a landing whose dispatch --start is gone"
    if fleet:
        return fleet_fence(e, h)
    return None


def land_waiter_alive(e):
    """A landing's entry is its waiting dispatch --start's (S9): that process, with the start time it recorded,
    still runs. A pid reused since reads as gone."""
    try:
        pid = int(e.get("waiter_pid"))
    except (TypeError, ValueError):
        return False
    m = rc_mod()
    return m.running(pid, e["waiter_start"]) if e.get("waiter_start") else m.alive(pid)


_LANDED = []


def landed_mod():
    """wharf-runs' landed.py, the reader helm's dependency check shares (S9), loaded once."""
    if not _LANDED:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        ld = SourceFileLoader("landed", str(HERE / "landed.py"))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
        ld.exec_module(m)
        _LANDED.append(m)
    return _LANDED[0]


def sightings_file():
    return qdir() / "after-seen.json"


def _jread(name):
    try:
        d = json.loads((qdir() / name).read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _jupdate(name, fn):
    """Read NAME, apply FN to its dict, write it back — under one lock, through a temp name of this process's:
    every claimer (the sweep, the poll, a run's end, a dispatch) writes these files, and a shared temp name or
    an unlocked read-modify-write dropped another claimer's sightings (the S9 landing review)."""
    try:
        qdir().mkdir(parents=True, exist_ok=True)
        with open(qdir() / (".%s.lock" % name), "w") as lk:
            fcntl.flock(lk, fcntl.LOCK_EX)
            d = _jread(name)
            fn(d)
            tmp = qdir() / (".%s.%d.tmp" % (name, os.getpid()))
            tmp.write_text(json.dumps(d, sort_keys=True))
            os.replace(tmp, qdir() / name)
    except OSError:
        pass


AFTER_RECHECK = 9 * 60   # the pending poll's claim reuses a hold this young: one origin read per sweep, not per minute


def after_holds(qid, e, t=None, cached=False):
    """Why E waits on a predecessor (`--after`, S9), or None once every one is proved on origin/<main> —
    the one after test the claim calls (S5's filters join claimable(), beside it). landed.judge decides from
    the entry's sighting at enqueue (its tip and fork, when it was work) and this host's later ones
    (after-seen.json: the live tip with its fork while main lacks it). A `landed` verdict is kept there too, by
    entry and predecessor, and never judged again: once proved, a later read can only be a weaker one.
    Could-not-tell holds. A predecessor archived or deleted unlanded (`gone`), or one still waiting past
    AFTER_BOUND, files one card naming both branches (helm's stalls read it); the entry stays queued either way.
    The word returned names every predecessor that holds, `after <branch>: <verdict> <why>`, joined by `; `."""
    after = [a for a in (e.get("after") or []) if isinstance(a, dict) and BRANCH_OK.fullmatch(str(a.get("branch") or ""))]
    if not after:
        return None
    t = now() if t is None else t
    if cached:
        # the 60 s poll (cmd_poll): a hold judged within AFTER_RECHECK stands — a predecessor's landing is no
        # queue event, so the sweep, a run's end (the predecessor's own landing run among them) and a dispatch
        # re-judge it; the poll reading origin every minute per waiting entry was the waste G4 counts
        w, at = (after_said().get(qid) or [None, 0])
        if w and t - int(at or 0) < AFTER_RECHECK:
            return w
    repo = repo_path(e.get("repo") or "/nonexistent")
    lm = landed_mod()
    seen = _jread("after-seen.json")
    holds, news, proved = [], {}, {}
    for a in after:
        sk = "%s %s" % (e.get("repo"), a["branch"])
        pk = "landed %s %s" % (e.get("id") or qid, a["branch"])
        if seen.get(pk):
            continue
        sights = ([{"sha": a["seen"], "fork": a.get("fork") or ""}] if a.get("work") and a.get("seen") else []) + \
            [x for x in (seen.get(sk) or []) if isinstance(x, dict)]
        try:
            v, why, new = lm.judge(str(repo), a["branch"], sights, a.get("seen") or "")
        except Exception as x:   # any: the reader's crash is could-not-tell, never a pass
            v, why, new = "unknown", "the landed reader failed (%s: %s)" % (type(x).__name__, x), None
        if new and new not in (seen.get(sk) or []):
            news[sk] = new
        if v == "landed":
            proved[pk] = [why, t]
            continue
        if v == "gone":
            card("after-gone", qid, e, "%s waits on %s, which is %s — it will not land by itself: land or re-seed %s, or "
                 "dispatch %s --cancel and dispatch it again without --after (and without it on its brief's After: line, "
                 "which dispatch reads too)" % (e.get("branch"), a["branch"], why, a["branch"], e.get("branch")),
                 mark="%s gone" % a["branch"], say=False, after=a["branch"])
        elif t - int(e.get("queued_at") or t) >= AFTER_BOUND:
            card("after-overdue", qid, e, "%s has waited %d h on %s (%s)" % (e.get("branch"), (t - int(e.get("queued_at") or t)) // 3600,
                                                                          a["branch"], why),
                 mark="%s %d" % (a["branch"], int(e.get("queued_at") or 0)), say=False, after=a["branch"])
        holds.append("after %s: %s %s" % (a["branch"], v, why))
    if news or proved:
        def keep(d):
            for k, x in news.items():
                if x not in (d.get(k) or []):
                    d[k] = ([y for y in (d.get(k) or []) if isinstance(y, dict)] + [x])[-5:]
            d.update(proved)
        _jupdate("after-seen.json", keep)
    out = "; ".join(holds) or None
    _jupdate("after-said.json", lambda d: d.__setitem__(qid, [out, t]))   # every judgement: the poll's reuse is timed from it
    return out


def after_said():
    """{qid: [the after test's last word here, when]}: what the list rows say without judging again."""
    return _jread("after-said.json")


def bad_args(e):
    a = list(e.get("args") or [])
    i, seen = 0, set()
    while i < len(a):
        f = a[i]
        if f not in FLAGS:
            return "flag %r is not one a queued run may carry" % f
        if f in seen:
            # the fired dispatch keeps the last, every reader here the first: `--mode default --mode yolo`
            # passed the raise check as default and ran yolo (AGENTS.md: a gate reads a line as the job will;
            # the third review's item 1). queue_args never repeats one
            return "flag %s given twice" % f
        seen.add(f)
        if FLAGS[f] is not None:
            if i + 1 >= len(a) or not re.fullmatch(FLAGS[f], str(a[i + 1])):
                return "%s %r does not match its pattern" % (f, a[i + 1] if i + 1 < len(a) else "")
            i += 1
        i += 1
    for k, v in (e.get("env") or {}).items():
        if not ENV_OK.fullmatch(k) or "\n" in str(v):
            return "env %s is not one a queued run may carry" % k
    if "--needs" in a and (not isinstance(e.get("needs"), list) or sorted(set(",".join(a[a.index("--needs") + 1:a.index("--needs") + 2]).split(","))) != sorted(set(e["needs"]))):
        return "--needs and the entry's needs differ"
    if not isinstance(e.get("needs") or [], list) or any(not isinstance(n, str) or not NEED_RE.fullmatch(n) for n in e.get("needs") or []):
        return "needs is not a list of lower-case feature names"
    return None


def job_label(ctx, e):
    """<prefix>.dispatch.<repo>.<topic>.q<YYYYmmddHHMMSS>: a one-shot's label shape, its minute a `q` stamp,
    so dispatch's jobs() (twelve digits) never takes a claimed job for a pending one-shot."""
    return "%s.dispatch.%s.%s.q%s" % (ctx.prefix, os.path.basename(str(repo_path(e["repo"]))), topic_of(e["branch"]),
                                      time.strftime("%Y%m%d%H%M%S", time.localtime(now())))


def agents():
    return Path.home() / "Library" / "LaunchAgents"


def program(ctx, args):
    """dispatch ARGS as a launchd job of this host runs it: dispatch's own launchd path (ctx.jobbin, the
    main checkout's or the overlay's), through its launcher where rc-hosts names one (ctx.rch)."""
    out = [ctx.jobbin] + list(args)
    if ctx.rch:
        # once per process: every plist compare (jobs, each poll_tend) asked rc-hosts again (S2a review, item 7.9)
        if (ctx.rch, ctx.jobbin) not in _LAUNCHER:
            lr = None
            try:
                lr = subprocess.run([ctx.rch, "--launcher", ctx.jobbin], capture_output=True, text=True, timeout=20)
            except (OSError, subprocess.TimeoutExpired):
                pass
            if lr is not None:
                # only a completed answer is kept: a timeout cached as "" started every later claimed run of a
                # long-lived watcher without its launcher (the S8 review, pass 2)
                _LAUNCHER[(ctx.rch, ctx.jobbin)] = lr.stdout.strip() if lr.returncode == 0 else ""
        if _LAUNCHER.get((ctx.rch, ctx.jobbin)):
            out = [_LAUNCHER[(ctx.rch, ctx.jobbin)]] + out
    return out


_LAUNCHER = {}   # (rc-hosts, jobbin) -> its launcher, or "" — program()'s one ask per process


def start_job(ctx, store, key, e, label):
    """The claimed entry's fire path, as a launchd job that runs at load (RunAtLoad): dispatch BRANCH
    --repo R <the entry's flags> --from-queue STORE:KEY, its log and depth as a one-shot's. (label, log)."""
    repo = str(repo_path(e["repo"]))
    topic = topic_of(e["branch"])
    qid = "%s:%s" % (store.name, key)
    # dispatch's own log for the entry it just enqueued (its --next confirms from it), else the day's
    log = getattr(ctx, "log", None) if getattr(ctx, "own", None) == qid and getattr(ctx, "log", None) else \
        str(logdir() / ("%s-dispatch-%s.log" % (time.strftime("%Y-%m-%d"), topic)))
    # its predecessors (S9), each a claude/* name: the fired dispatch merges origin/<main> into the worktree
    # first, so the step has their code; they were proved landed by this claim (after_holds)
    after = [x for a in (e.get("after") or []) if isinstance(a, dict) and BRANCH_OK.fullmatch(str(a.get("branch") or ""))
             for x in ("--after", a["branch"])]
    args = program(ctx, [e["branch"], "--repo", repo] + list(e.get("args") or []) + after + ["--from-queue", qid])
    # no DISPATCH_YEAR: a RunAtLoad job runs at once, and the year guard failed a claim made in the last
    # seconds of a year (the first review's item 6); a stale plist is `mine`'s to judge
    env = {"DISPATCH_LABEL": label, "DISPATCH_LOG": log, "DISPATCH_LOADED_AT": str(now())}
    if e.get("event_at"):
        env["DISPATCH_EVENT_AT"] = str(int(e["event_at"]))   # G3's start, for the run's `started` line
    env.update({k: str(v) for k, v in (e.get("env") or {}).items()})
    plist = {"Label": label, "ProgramArguments": args, "EnvironmentVariables": env, "RunAtLoad": True,
             "StandardOutPath": log, "StandardErrorPath": log}
    la = agents()
    la.mkdir(parents=True, exist_ok=True)
    Path(log).parent.mkdir(parents=True, exist_ok=True)
    p = la / ("%s.plist" % label)
    with open(p, "wb") as f:
        plistlib.dump(plist, f)
    dom = "gui/%d" % os.getuid()
    subprocess.run([ctx.launchctl, "bootout", "%s/%s" % (dom, label)], capture_output=True)
    for i in range(2):
        r = subprocess.run([ctx.launchctl, "bootstrap", dom, str(p)], capture_output=True, text=True)
        if r.returncode == 0:
            return label, log
        time.sleep(2)
    p.unlink(missing_ok=True)
    raise Refused("launchctl bootstrap failed: %s" % (r.stderr.strip() or r.returncode), 1)


def claim(ctx, out=None):
    """Claim and start what this host has room for, best first: [(qid, label, log)]. The count and the
    reservation under dispatch's start lock make the watcher, the sweep, a kick and a one-shot fill one free
    slot once (live() counts records, which exist only after the job's start lock, after() and the launch;
    held() counts the claims meanwhile)."""
    out = [] if out is None else out
    h = host_name()
    # S10(g): a host whose home is for its own writes claims nothing, and no host claims in a DarkWake: the
    # entry it took would start as the sleep resumes, its own requeued run among them
    why_not = "this host's queue-mode is writes" if not claims_here() else "a DarkWake" if dark_wake() else None
    if why_not:
        event("claim-skipped", host=h, why=why_not)
        return out
    cands = []
    full_at = {}
    open_early = {r.get("topic") for r in records() if not r.get("ended")}

    def own_early(e):
        """The claim's `own` (below): a live run's own --next waits for that run, which no count holds it to."""
        return (e.get("running_on") or "").lower() == h or topic_of(e["branch"]) in open_early

    def room_for(e):
        """A rough look, unlocked, whether this host has a slot E's rank could take (the locked count decides
        later): the after test reads origin, and judging it on a full host bought nothing (the S9 review)."""
        cap = cap_for(ctx.cap, e.get("priority"))
        if cap not in full_at:
            try:
                full_at[cap] = busy(ctx.launchctl) >= cap
            except Exception:   # could not count: judge it, the locked count decides
                full_at[cap] = False
        return not full_at[cap]
    for s in stores():
        try:
            entries, offline = s.view()
        except Torn as x:
            event("claim-torn", store=s.name, host=h, why=str(x))
            continue   # one torn store stops its own claims, never the other stores'
        seen = None
        for k, e in entries.items():
            if claimable(e, h, fleet=isinstance(s, Fleet)):
                if e.get("kind") == "landing" and e.get("state") == "queued" and isinstance(s, Local) \
                        and (e.get("host") or "").lower() == h and not land_waiter_alive(e):
                    # its dispatch --start is gone (killed, or its waiter's end): nobody would run it, and
                    # autofinish's sweep starts the landing again — the entry goes, never a slot held for it
                    s.do([{"op": "remove", "key": k, "cond": {"id": e.get("id"), "state": "queued"}}], "landing %s gone" % k)
                    event("landing-gone", key="%s:%s" % (s.name, k), host=h, pid=e.get("waiter_pid"))
                continue
            if e.get("kind") == "landing" and not (isinstance(s, Local) and s.scope == LAND_STORE):
                continue   # a landing lives in this host's _land store only: one in the fleet (by hand, a replay) would hold a slot for any live pid
            # the after test (S9) once the cheap filters pass: it reads origin, and an entry pinned elsewhere
            # or refused here within the hour never needs it
            if e.get("after") and not own_early(e) and not room_for(e):
                continue   # no slot it could take here now: its after test (origin reads) waits for one
            if after_holds("%s:%s" % (s.name, k), e, cached=bool(getattr(ctx, "after_cached", False))):
                continue
            # the outbox may claim only what nobody else can hold: a put still in this host's outbox, its
            # key absent from the last ref fetched here (a key this host re-put while others see it is not)
            alone = False
            if isinstance(s, Fleet) and outbox_only(k):
                seen = s.read(s.cached()) if seen is None else seen
                alone = k not in seen
            if offline and isinstance(s, Fleet) and not alone:
                continue   # never claim from a stale view what another host may hold
            cands.append((rank(e), s, k, e, alone))
    cands.sort(key=lambda c: c[0])
    if not cands:
        return out
    # memory once there is something to start: the sample sleeps 2 s, and every enqueue and run end paid it
    # on an empty queue (the third review's item 18). Over the host's line, a force entry reads the force's
    # floor (D2-A): passed, the force entries alone go on; the rest wait as at any refusal
    why_mem = headroom_refuses()
    if why_mem:
        forced = [c for c in cands if c[3].get("priority") == "force"]
        why_force = headroom_refuses(FLOOR) if forced else why_mem
        if why_force:
            ctx.no_room = "memory: %s" % why_force
            event("no-room", host=h, why=why_force)
            return out
        event("no-room", host=h, why=why_mem, keys=["%s:%s" % (c[1].name, c[2]) for c in cands if c not in forced], floor=FLOOR)
        ctx.no_room = "memory: %s (only a force entry passes the force's floor)" % why_mem
        cands = forced
    claims_dir().mkdir(parents=True, exist_ok=True)
    tag = "%d-%s" % (os.getpid(), uuid.uuid4().hex[:8])
    full, no_room = None, []
    recs = records()
    open_topics = {r.get("topic") for r in recs if not r.get("ended")}
    # G3's event: when the slot this claim fills freed — the watcher's word (--event-at: its run turned
    # parked or ended), else the last end recorded here; an entry queued later is its own event
    freed = getattr(ctx, "event_at", None) or max([int(r.get("ended") or 0) for r in recs] or [0])
    for _, s, k, e, alone in cands:
        qid = "%s:%s" % (s.name, k)
        # a live run's own --next waits for that run, which its count leaves out, so it may fit where an
        # older entry does not: an entry whose branch runs here (running_on), or whose topic has any record
        # not ended (a run with no entry of its own marks none), is counted on its own. Every other entry
        # sees the same count, so once one finds no room the rest are skipped, not counted again (the second
        # review's item 18: a subprocess and a scan per entry under the lock, and a line each)
        own = (e.get("running_on") or "").lower() == h or topic_of(e["branch"]) in open_topics
        if full is not None and not own:
            no_room.append(qid)
            continue
        # the count and the reservation under dispatch's start lock, which the fire path holds from its own
        # count to its record: a one-shot between them was invisible to a claim under a lock of the queue's
        # own (the third review's item 19), and the claimed job was refused at its cap
        lock = start_lock()
        if lock is None:
            ctx.no_room = "the start lock is held"
            event("no-room", host=h, why="the start lock held 150 s", keys=[qid])
            break
        # a landing's own run is `finish-<topic>` (dispatch --start's NAME), never the branch's build run, which
        # holds its slot meanwhile: counted as the landing's recount counts it (the S9 review)
        rp, tp = str(repo_path(e["repo"])), (e.get("topic") if e.get("kind") == "landing" else None) or topic_of(e["branch"])
        try:
            n = busy(ctx.launchctl, rp, tp)
            if n >= cap_for(ctx.cap, e.get("priority")):
                no_room.append(qid)
                ctx.no_room = "the run cap (%d of %d busy on %s)" % (n, ctx.cap, h)
                if not own:
                    full = n
                continue
            t = now()
            label = job_label(ctx, e)
            res = {"qid": qid, "at": t, "label": label, "pid": os.getpid(), "repo": rp, "topic": tp}
            if e.get("kind") == "landing":
                # held while its waiting dispatch --start lives (claimer_alive reads `pid`), until that run's
                # record (`queue` names this qid) spends it, or the lease
                label = "landing.%s" % e.get("waiter_pid")
                res.update(label=label, pid=int(e.get("waiter_pid") or 0))
            # a --next of a live run is counted as waiting from the claim, not from its job's `waiting` word:
            # until then every other fire path counted the earlier run and this one both (the fourth review)
            if own and rc_mod().unfinished(rp, tp, reap=False):
                res["waiting"] = True
            _reswrite(qid, tag, res)
        finally:
            start_unlock(lock)
        # the job's label rides in the claim, one CAS round: the claimer's sweep asks launchd about it. The
        # claim holds only for the entry looked at (its id: a put that replaced it meanwhile has other flags
        # and pin), and only once the home took it — a claim parked in the outbox while another host's
        # landed started one entry twice (the review's item 2), bar the entry only this host has seen
        ev = max(int(e.get("queued_at") or 0), int(freed or 0)) or t
        op = {"op": "claim", "key": k, "host": h, "at": t, "job": label, "cond": {"id": e.get("id")}, "event_at": ev}
        try:
            r = s.do([op], "claim %s by %s" % (k, h), defer=alone or not isinstance(s, Fleet))[0]
        except (Unreachable, Torn) as x:   # Torn: the ref torn between the view and the CAS (item 7)
            unreserve(qid, tag)
            event("claim-unreachable", key=qid, host=h, why=str(x))
            continue
        if r != "claimed":
            unreserve(qid, tag)
            continue
        if e.get("kind") == "landing":
            # nothing to start: the landing's own dispatch --start waits for this claim (land-wait) and runs it,
            # its prompt, lists and merge rights its own, never in the entry (S9)
            event("claimed", key=qid, host=h, label=label, priority=e.get("priority"), entry_kind="landing",
                  queued_at=e.get("queued_at"), event_at=ev, claim_s=t - ev)
            out.append((qid, label, None))
            continue
        try:
            label, log = start_job(ctx, s, k, dict(e, event_at=ev), label)
        except (Refused, OSError, subprocess.SubprocessError) as x:
            unreserve(qid, tag)
            s.do([{"op": "refuse", "key": k, "host": h, "at": now(), "why": str(x), "cond": {"claimed_by": h, "claimed_at": t},
                   "keep_on": h if branch_live_here(k, records()) else None}],
                 "unclaim %s by %s" % (k, h))
            event("start-failed", key=qid, host=h, why=str(x))
            continue
        event("claimed", key=qid, host=h, label=label, priority=e.get("priority"), queued_at=e.get("queued_at"),
              event_at=ev, claim_s=t - ev)
        out.append((qid, label, log))
    if no_room:
        event("no-room", host=h, keys=no_room, busy=full, cap=ctx.cap)
    return out


# ---- the route: fleet, or a node's own queue -------------------------------------------------------------

def toplevel(d):
    if not d:
        return None
    r = subprocess.run(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True)
    g = r.stdout.strip()
    return str(Path(g).parent) if r.returncode == 0 and g.endswith("/.git") else None


def confidential_scope(path, reg):
    """PATH's confidential scope in REG, the registry route() parsed once (None: no registry, no scopes). Every
    scope is walked: scope_of_repo answers the first scope listing a path, so an umbrella scope ("*") listed before a
    confidential one hid it (AGENTS.md's fence trap; the S8 review, for --kick's fence and route() alike)."""
    if not path or reg is None:
        return None
    for name, sc in (reg.get("scopes") or {}).items():
        if isinstance(sc, dict) and sc.get("confidential") is True \
                and common.scope_of_repo(path, reg={"scopes": {name: sc}})[0] == name:
            return name
    return None


def has_review(repo, branch):
    for ref in ("refs/heads/%s" % branch, "refs/remotes/origin/%s" % branch):
        r = subprocess.run(["git", "-C", repo, "ls-tree", "-r", "--name-only", ref, "--", "docs/handoff/"], capture_output=True, text=True)
        if r.returncode == 0:
            # Any `.review` on the branch, as pickup's branch_origin scans: a seed made beside a spawn
            # (`pickup seed --beside`) inherits its source's `.review` under the source's topic, not its own.
            return any(re.fullmatch(r"docs/handoff/([0-9]{4}-[0-9]{2}-[0-9]{2}-)?[^/]+\.review", n) for n in r.stdout.splitlines())
    return False


def route(repo, branch, cwd, args=()):
    """(store, confined): where BRANCH's entry goes. The registry first: torn reads as no scopes, so a
    torn one refuses (the fence trap). Then the repo's scope, the caller's cwd's, a spawn's `.review` — all
    from that one parse: a write torn between a second read and the first reads as no scopes (common's
    read_registry docstring; the review's item 8). ARGS: the entry's
    flags — a confidential `--origin` is a spawn too, `.review` or not (S1's "a confidential seed origin")."""
    reg, torn = common.read_registry()
    if torn:
        raise Refused("dispatch: the scope registry (repos.json) is unreadable — refused: a torn registry reads as no "
                      "confidential scopes, and a confidential branch must never reach the fleet queue: end with the WAITING line — the next step waits for a run to end and for repos.json to read (dispatch again once it does)", 2)
    # the path as given and as resolved: a registry names a checkout one way (repo_key keeps a path outside
    # the projects folder as it is)
    sc = confidential_scope(repo, reg) or confidential_scope(str(Path(repo).resolve()), reg) or confidential_scope(toplevel(cwd), reg)
    if sc:
        return Local(sc), False
    if flag_values(list(args), "--origin") or has_review(repo, branch):
        # a spawn out of a node: queued in the node until spawn_review_ok() checks its review at claim.
        # A seed's `.review` says so, and so does a run given --origin by hand: its marker reads back
        # only where the scope is registered, which a fleet host may not be (the S5 rebase review)
        return Local("_spawn"), True
    url = home()
    if not url:
        raise Refused("dispatch-queue: no queue home here (wharf-runs/queue-repo)", 1)
    return Fleet(url), False


# ---- verbs --------------------------------------------------------------------------------------------

def same_branch(e, repo, branch):
    """E is BRANCH's of REPO: the key alone is the basename and the topic, which another branch can share."""
    return e.get("branch") == branch and e.get("repo") == repo_word(repo)


def find(repo, branch, torn=None):
    """[(store, key, entry, offline)] of BRANCH's entries in every store (one per store at most). A torn
    store is skipped, named in TORN: a torn fleet ref left a node-local entry's end unrecorded (the third
    review's item 5)."""
    k = key_of(repo, branch)
    out = []
    for s in stores():
        try:
            entries, off = s.view()
        except Torn as x:
            if torn is not None:
                torn.append((s, str(x)))
            event("store-torn", store=s.name, why=str(x))
            continue
        if k in entries and same_branch(entries[k], repo, branch):
            out.append((s, k, entries[k], off))
    return out


def chain_depth(env):
    """The depth the entry's run carries: an unattended caller's, at least one deeper than its own — its
    --env DISPATCH_DEPTH=1 reset the chain's bound (the second review's item 12); a person's word stands.
    No caller is exempt as "the fired job": no plist carries CLAUDE_UNATTENDED, so a real fired job never
    reaches this with it set, and a DISPATCH_LABEL was any session's word — a made-up one, or its own
    parent job's, which launchd does run (the third review's items 3 and 20)."""
    def num(v):
        return int(v) if str(v or "").isdigit() else 0
    given = num(env.get("DISPATCH_DEPTH"))
    if not os.environ.get("CLAUDE_UNATTENDED"):
        return given
    return max(given, num(os.environ.get("DISPATCH_DEPTH")) + 1)


def flag_values(args, flag):
    return [args[i + 1] for i, f in enumerate(args[:-1]) if f == flag]


def callers_mode(repo, branch):
    """The mode the unattended caller's own run on BRANCH of REPO was started at, or None: a record here
    of its session (dispatch gave the session its id) that names that branch and has not ended, read for
    its `task_mode` (dispatch writes it from the mode it judged). No session id, no record, no mode: None,
    so the hint is judged. Never the caller's DISPATCH_MODE: that is its own word, and a run that set it
    could raise itself (S2a's finish review, its S1)."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    if not sid:
        return None
    m = rc_mod()
    for r in records():
        if r.get("session") == sid and r.get("branch") == branch and not r.get("ended") and m.same_repo(r.get("repo"), repo):
            return r.get("task_mode") or None
    return None


_ANC = []


def ancestry():
    """[(pid, command name)] of this process's ancestors, nearest first (one `ps` of every process): what a
    caller's own run, and whether a session started it, are judged by. No seam stands in for it: a variable
    naming the ancestors would be one more word a session could set (the tests give a record their own
    shell's pid, a real ancestor, and start the "no session" case reparented away from theirs)."""
    if _ANC:
        return _ANC[0]
    try:
        r = subprocess.run(["ps", "-axo", "pid=,ppid=,comm="], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        r = None
    if r is None or r.returncode != 0:
        _ANC.append(None)   # could not tell: under_claude() reads it as a session (fails closed)
        return None
    up = {}
    for line in r.stdout.splitlines():
        f = line.split(None, 2)
        if len(f) >= 2 and f[0].isdigit() and f[1].isdigit():
            up[int(f[0])] = (int(f[1]), f[2] if len(f) > 2 else "")
    out, p, seen = [], os.getppid(), set()
    while p > 1 and p not in seen and len(out) < 64:
        seen.add(p)
        ppid, comm = up.get(p, (0, ""))
        out.append((p, comm))
        p = ppid
    _ANC.append(out)
    return out


def ancestors():
    return [p for p, _ in ancestry() or []]


def under_claude():
    """True when a Claude Code session is among this process's ancestors: its argv[0] `claude`, or its binary
    under a `claude/versions/` folder. A guard against accidents, not a fence: a session can unset CLAUDECODE
    and its session id, and a double fork leaves its parent behind (S4's second review). A `ps` that fails or
    hangs reads as a session: "could not tell" never grants the owner's word."""
    anc = ancestry()
    if anc is None:
        return True
    return any(os.path.basename(c.strip()) == "claude" or "/claude/versions/" in c for _, c in anc)


def force_dir():
    return cache() / "force"   # hooks/force_mark.py writes it, checkpoint denies a hand write to every session


def force_refusal():
    """Why this caller may not have `--priority force`, or None (D3-A: force only on the owner's words). An
    unattended caller never. A caller a session started — its variables, or a claude among its ancestors —
    only with that session's force mark, which hooks/force_mark.py writes from the owner's typed "use the
    force". Anyone else is the owner at a terminal, or a fired job whose plist a guarded dispatch wrote."""
    if os.environ.get("CLAUDE_UNATTENDED") or os.environ.get("AUTOFINISH_CALLER_UNATTENDED"):
        return ("--priority force is the owner's word for one run, and an unattended caller never raises to it (a "
                "--next inherits force as high)")
    if not (os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_SESSION_ID") or under_claude()):
        return None
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    f = force_dir() / sid
    try:
        # the owner's words of this turn: a mark older than MARK_AGE is a turn long gone (a turn started by a
        # notification clears nothing; S4's second review)
        if re.fullmatch(r"[A-Za-z0-9_-]{1,100}", sid) and f.is_file() and time.time() - f.stat().st_mtime < MARK_AGE:
            return None
    except OSError:
        pass
    return ("--priority force is the owner's word: it needs \"use the force\" in the owner's own message this turn "
            "(the force mark), and this session has none — dispatch it high, or ask the owner")


def spend_force():
    """The force mark spent once a force put or schedule landed: one phrase, one run."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    if re.fullmatch(r"[A-Za-z0-9_-]{1,100}", sid):
        try:
            (force_dir() / sid).unlink()
        except OSError:
            pass


def callers_record():
    """The caller's own run record, or None: the newest record here not ended whose claude (its `pid`) is an
    ancestor of this process. Never by CLAUDE_CODE_SESSION_ID, which a session can set to another run's id and
    so take that run's rank (S3's third landing review, item 3: never trust a variable a session can set)."""
    up = set(ancestors())
    if not up:
        return None
    best = None
    for r in records():
        try:
            pid = int(r.get("pid") or 0)
        except (TypeError, ValueError):
            continue
        # rec_alive: the pid with the start time the record holds — a crashed run's record never ended, its pid
        # reused by a shell, would hand that shell its rank (the landing review)
        if pid in up and not r.get("ended") and rec_alive(r) and (best is None or int(r.get("started") or 0) >= int(best.get("started") or 0)):
            best = r
    return best


def callers_prio():
    """The rank a caller inherits from its own run's record (callers_record): its `prio`, force read as high —
    the owner's force buys one run, and the run's --next is high (D3-A). None with no record."""
    r = callers_record()
    if r is None:
        return None
    p = r.get("prio") or "normal"
    return "high" if p == "force" else (p if p in RANKS else "normal")


def raise_refusal(args, env, prio, repo, branch):
    """Why an unattended caller may not enqueue this, or None: dispatch's two raise checks, here too, since
    `dispatch-queue enqueue` is on the Bash PATH — a priority above normal, and a mode above the
    branch's (helmlib.raise_refusal, as dispatch asks it; without helm, the caller's DISPATCH_MODE,
    failing closed). The trap: a flag that stands for a person's yes refuses an unattended caller (the
    review's item 1). Every mode the line names is judged — each --mode, --yolo, the env's — never the
    first alone (the third review's item 1). The env's DISPATCH_MODE is the plist's hint, which a --next
    inherits from its own run (dispatch passes --mode only when one was given): the caller's own mode, onto
    the caller's own branch, is no raise, and judging it refused a dnd run's --next under a lowered ship,
    which the one-shot runs at the lowered mode (the fourth review's item 12). Onto any other branch it is
    judged, as main did: a dnd run could otherwise raise a sibling the owner lowered (S2a's landing review,
    item 4). The caller's own mode is its run record's (the session's id), never its word: the env's
    DISPATCH_MODE is the caller's to set (S2a's finish review, its S1). A hint unlike the record's, or yolo (never inherited), is judged as a --mode is."""
    # force: the owner's words, for every caller (force_refusal) — this verb is on the Bash PATH, so an attended
    # session could put a force entry past dispatch's own check (the landing review)
    prios = [prio] + flag_values(args, "--priority")
    if "force" in prios:
        why = force_refusal()
        if why:
            return why
    if not os.environ.get("CLAUDE_UNATTENDED"):
        return None
    # high only when the caller's own run is high, by its record, never its word (D3-A; S4)
    if "high" in prios:
        inh = callers_prio()
        if inh != "high":
            return "--priority high is a raise, and an unattended caller never raises a run's priority (its own run's record says %s)" % (inh or "none")
    modes = flag_values(args, "--mode") + (["yolo"] if "--yolo" in args else [])
    hint = env.get("DISPATCH_MODE") or ""
    if hint and (hint == "yolo" or hint != callers_mode(repo, branch)):
        modes.append(hint)
    for mode in modes:
        try:
            p = common.tool("helmlib.py")
            sys.path.insert(0, str(p.parent))
            import helmlib
            old = helmlib.branch_mode(branch, repo)[0] or helmlib.run_mode()[0]
            why = helmlib.raise_refusal(old, mode) or None
        except Exception:
            ranks = {"ask": 0, "default": 1, "dnd": 2, "yolo": 3}
            old = os.environ.get("DISPATCH_MODE") or "default"
            why = None
            if ranks.get(mode, 0) > ranks.get(old, 1):
                why = "mode %s over %s is a raise, and only the owner raises a mode (an unattended caller; helm unreadable here)" % (mode, old)
        if why:
            return why
    return None


WAITER_S = 3 * SWEEP   # a waiter put from another host counts live this long past that host's last word of it


_LIVE_IDS = None   # this process's one registry scan (session_live)


def session_live(sid):
    """SID is a live Claude Code session on this host: by every login's session registry and every Orca
    profile's (dispatch-rc's sessions_live, its registry_dirs; S3's landing review, item 5). A registry that
    cannot be read: live, the safe side. Scanned once per process: apply_op asks it in every replay of the
    outbox (each view, each watch pass, each CAS retry), and each scan globbed every registry and checked
    each record's pid (S3's third landing review, item 6); one answer per process also keeps a verb's
    replays agreeing with each other."""
    global _LIVE_IDS
    if _LIVE_IDS is None:
        try:
            _LIVE_IDS = {r.get("sessionId") for r in rc_mod().sessions_live()}
        except Exception:
            _LIVE_IDS = False   # unreadable: every waiter live
    return True if _LIVE_IDS is False else sid in _LIVE_IDS


def waiter_live(e):
    """E's waiter (`by`) is a live session, so its queued step is not replaced unasked (the contract's
    Replacing; `--replace` takes it). Put on this host: session_live. Put from another host, whose registries
    cannot be read from here: by that host's word — `by_seen`, which its sweep refreshes while the session is
    live there (cmd_sweep) — or the put's own time, for WAITER_S. Never live forever: an entry whose host went
    offline blocked its branch for good, and an unattended caller is refused --replace (S3's second landing
    review, item 6).

    No record of the session counts as gone: a deliberate exception to the registry trap (AGENTS.md: "no
    record" is unknown, never ended). Here "gone" only lets a later dispatch replace a queued step, which
    keeps its place in line and loses only the waiter's claim to it; read as live, every waiter whose record
    went (a reboot, a profile removed) would block its branch until someone typed --replace.

    The put's own time is `put_at`, never `event_at`: a claim (and the refusal that returns it) restamps
    event_at, which kept a gone waiter live another WAITER_S (S3's in-round review 2; S4). An entry put
    before S4 has no put_at and reads its event_at, as it did."""
    if (e.get("from") or "").lower() not in ("", host_name()):
        put = e.get("put_at") if e.get("put_at") is not None else e.get("event_at")
        return now() - max(int(e.get("by_seen") or 0), int(put or 0)) < WAITER_S
    return session_live(e.get("by"))


def cmd_enqueue(a, ctx):
    h = host_name()
    repo = str(Path(a.repo).resolve())
    # what the queue alone refuses exits 1, so dispatch schedules the one-shot as before the queue (item 10)
    if not BRANCH_OK.fullmatch(a.branch):
        raise Refused("dispatch-queue: the queue takes a claude/* branch, not %s — a one-shot, as before the queue" % a.branch, 1)
    args = list(a.arg or [])
    env = dict(x.split("=", 1) for x in a.env or [] if "=" in x)
    # a gated flag twice is refused before anything reads it: the readers here took the first, the fired
    # dispatch the last (AGENTS.md: refuse a gated flag given twice; the third review's item 1)
    twice = sorted({f for f in ("--mode", "--account", "--priority", "--yolo") if args.count(f) > 1})
    if twice:
        raise Refused("dispatch-queue: %s given twice — refused: a gate reads the first, the run the last" % ", ".join(twice))
    # the entry's rank is --priority's, the run's the carried flag's (queue_args writes both, the same)
    if any(v != a.priority for v in flag_values(args, "--priority")):
        raise Refused("dispatch-queue: --priority %s and a carried --priority %s — refused: the rank and the run would differ"
                      % (a.priority, ", ".join(flag_values(args, "--priority"))))
    if os.environ.get("CLAUDE_UNATTENDED") or "DISPATCH_DEPTH" in env:
        env["DISPATCH_DEPTH"] = str(chain_depth(env))
    why = raise_refusal(args, env, a.priority, repo, a.branch)
    if not why and a.replace and (os.environ.get("CLAUDE_UNATTENDED") or os.environ.get("AUTOFINISH_CALLER_UNATTENDED")):
        # another session's step taken over is the owner's yes, as dispatch refuses it (S3's review, item 12).
        # No caller is exempt, as autofinish-run's unattended_caller() judges --merge: DISPATCH_LABEL is any
        # session's word, and no fired job carries --replace (FLAGS lacks it; S3's third landing review, item 3)
        why = "--replace takes over another run's step, and an unattended caller is refused it"
    if why:
        # the cap's waiting words, so a skippered run that ends on it is not held at Stop for an ask it never
        # relayed (AGENTS.md: a new dispatch refusal reuses them; the fourth review's item 12)
        raise Refused("dispatch: %s — refused: end with the WAITING line — the next step waits for a run to end and for %s "
                      "to raise it (a dispatch by hand)" % (why, getattr(common, "OWNER_NAME", "") or "the owner"))
    store, confined = route(a.repo, a.branch, a.cwd or os.getcwd(), args)
    if isinstance(store, Fleet):
        flush(store)
    k = key_of(repo, a.branch)
    # the mode the claim's yolo/dnd rule reads: --mode's, else the plist's hint, else --yolo's
    mode = (flag_values(args, "--mode") or [""])[0] or env.get("DISPATCH_MODE") or ("yolo" if "--yolo" in args else "")
    # a login label is one host's (dispatch's --next names this Mac's): another host cannot run it, and
    # its pick's "not set up on this machine" would end the step as failed (the review's item 20)
    acct = (flag_values(args, "--account") or [""])[0]
    pin = (a.pin or "").lower() or (h if acct and acct not in ("auto", "bound") else "")
    # S5: what a host may take. A need no host that may take the repo meets is never queued (exit 3, apart from the
    # busy answer's JSON: nothing is printed on stdout): the entry would sit for ever and the caller end its turn on it
    needs = sorted({n.strip().lower() for n in (a.needs or "").split(",") if n.strip()})
    if any(not NEED_RE.fullmatch(n) for n in needs):
        raise Refused("dispatch-queue: --needs takes lower-case feature names, a,b (%s)" % (a.needs or ""), 2)
    probe = {"repo": repo_word(repo), "host": pin, "needs": needs}
    feats = features()
    cands, why_c = berth_candidates(probe["repo"], h)
    if why_c.get("unreadable"):
        raise Refused("dispatch-queue: %s — refused, never queued" % why_c["unreadable"], 3)
    # a node-local queue is claimed by this host alone: the peers' lines cannot help it
    verdicts = {x: eligibility(probe, x, feats) for x in fleet_hosts(probe, local=not isinstance(store, Fleet))}
    if verdicts and all(verdicts.values()):
        raise Refused("dispatch-queue: no host meets this run — %s — refused, never queued"
                      % "; ".join("%s: %s" % kv for kv in sorted(verdicts.items())), 3)
    if not verdicts:
        raise Refused("dispatch-queue: no host may take %s (berths %s, clone hosts %s) — refused, never queued"
                      % (why_c.get("repo"), why_c.get("berths"), why_c.get("hosts")), 3)
    if needs and "--needs" not in args:
        args = args + ["--needs", ",".join(needs)]
    t = now()
    # --queued-at: a one-shot fired at its time enqueues aged from WHEN, its place in line since then (S3)
    qat = min(t, a.queued_at) if a.queued_at and a.queued_at > 0 else t
    e = {"id": uuid.uuid4().hex, "key": k, "repo": repo_word(repo), "branch": a.branch, "topic": topic_of(a.branch),
         "priority": a.priority, "needs": needs, "host": pin, "confined": confined, "state": "queued",
         "queued_at": qat, "event_at": t, "put_at": t, "by": a.by or "", "from": h, "waiter": (a.wait or "")[:200], "attempts": 0,
         "session": "", "args": args, "env": env, "mode": mode}
    if a.refused:
        # no hour's skip on the only host the entry may use (item 15's rule, here too: the fourth review)
        e.update(last_refusal=a.refused, attempts=1)
        if pin != h or a.skip_hour:
            e["refused_by"] = {h: t}
    why = bad_args(e)
    if why:
        raise Refused("dispatch-queue: %s — a one-shot, as before the queue" % why, 1)
    if a.after:
        # S9: the claim skips the entry until each predecessor is proved on origin/<main>. Its tip on origin
        # now is recorded, with whether main lacked it (the sighting landed.judge trusts later); an unattended
        # caller may name one, as it only delays. A name that is no claude/* branch, or this branch itself,
        # is refused: neither could ever land as a predecessor (2, dispatch's refusal, never the one-shot's 1)
        bad = [b for b in a.after if not BRANCH_OK.fullmatch(b) or b == a.branch]
        if bad:
            raise Refused("dispatch-queue: --after takes another claude/* branch, not %s" % ", ".join(bad))
        lm = landed_mod()
        e["after"] = [lm.sighting(repo, b) for b in dict.fromkeys(a.after)]
    put = {"op": "put", "key": k, "entry": e}
    if a.replace:
        put["replace"] = True
    else:
        # another live session's queued step is refused inside the put's own CAS round (apply_op's guard):
        # "busy queued by session …", exit 3 below. A fire-time refusal's put too (enqueue --refused, a fired
        # one-shot's): unguarded, it replaced a live session's queued step of the branch (S3's in-round review 2;
        # S4); dispatch's queue_refused reads the busy answer as the step queued already
        put["guard"] = a.by or ""
    r = store.do([put], "enqueue %s by %s" % (k, h))[0]
    refused = getattr(store, "write_refused", None)
    if refused:
        # the home answered and said no to this host's write (a hook, a lapsed grant, no push credential):
        # the put leaves the outbox, and dispatch schedules the one-shot as before the queue — the outbox
        # would hold it a day and drop it, while dispatch said "queued" (the third review's item 6)
        for p in outbox_files():
            try:
                o = json.loads(p.read_text())
            except (OSError, ValueError):
                continue
            if o.get("op") == "put" and o.get("key") == k and (o.get("entry") or {}).get("id") == e["id"]:
                p.unlink(missing_ok=True)
        event("write-refused", key="%s:%s" % (store.name, k), host=h, why=refused)
        raise Refused("dispatch-queue: the home refused this host's write (%s) — a one-shot, as before the queue" % refused, 1)
    if getattr(store, "contended", False):
        # a put that lost the lease three times while the home answered waited for the next flush, which
        # in S1 was some later queue call (the first review's item 5): once more now, after a pause
        time.sleep(random.uniform(0.5, 1.5))
        for o, got in flush(store):
            # the home answered for this put: as its first round would have. One dropped as stale (busy, a
            # clash, claimed here) is said by the roads below, never "queued" over a put the outbox let go
            if o.get("op") == "put" and o.get("key") == k and (o.get("entry") or {}).get("id") == e["id"]:
                r = got
        if not any(o.get("op") == "put" and o.get("key") == k and (o.get("entry") or {}).get("id") == e["id"] for o in outbox_ops()):
            store.offline = None
    if r == "claimed here":
        # in hand, unless that claim is dead: then this put replaces it (the second review's item 10).
        # Any error in judging that is "not dead": an uncaught one exited 1, which dispatch reads as "the
        # queue could not take it", and its one-shot ran beside the live claim (item 9)
        try:
            cur = store.view()[0].get(k) or {}
            dead = claim_dead(ctx, "%s:%s" % (store.name, k), cur)
        except Exception as x:
            cur, dead = {}, False
            event("claim-dead-unread", key="%s:%s" % (store.name, k), host=h, why="%s: %s" % (type(x).__name__, x))
        if dead:
            put["dead"] = {"job": cur.get("job") or "", "claimed_at": cur.get("claimed_at"), "state": cur.get("state")}
            r = store.do([put], "enqueue %s by %s, its claim here dead" % (k, h))[0]
            event("claim-dead", key="%s:%s" % (store.name, k), host=h, job=cur.get("job"), result=r)
    out = {"key": k, "qid": "%s:%s" % (store.name, k), "store": store.name, "result": r, "confined": confined,
           "offline": store.offline, "claimed": None, "no_room": None}
    if r.startswith("busy"):
        print(json.dumps(out))
        return 3
    if a.priority == "force" and r in ("queued", "replaced") and not os.environ.get("CLAUDE_UNATTENDED"):
        spend_force()   # one phrase, one run: spent once a force put landed (force_refusal let it in)
    if r == "claimed here":
        # this host's job of the branch is waiting already (the second review): the step is in hand
        out["claimed"] = []
        event("enqueued", key=out["qid"], host=h, priority=a.priority, result=r)
        print(json.dumps(out))
        return 0
    if r.startswith("clash"):
        raise Refused("dispatch-queue: the entry %s is another branch's (%s) — a one-shot, as before the queue" % (out["qid"], r), 1)
    event("enqueued", key=out["qid"], host=h, priority=a.priority, result=r, refused=a.refused or None, offline=store.offline)
    # the put has landed (or waits in the outbox): from here an error is said, never an exit dispatch reads
    # as "the queue could not take it", or its one-shot would run the step beside the entry (items 9, 13)
    try:
        entries, _ = store.view()
        order = sorted((rank(x), kk) for kk, x in entries.items() if x.get("state") == "queued")
        out["rank"] = next((i + 1 for i, (_, kk) in enumerate(order) if kk == k), None)
        if a.claim and not a.refused:
            ctx.own = out["qid"]
            ctx.no_room = None
            got = claim(ctx)
            out["claimed"] = [q for q, _, _ in got]
            out["log"] = next((lg for q, _, lg in got if q == out["qid"]), None)
            if out["qid"] not in out["claimed"]:
                out["no_room"] = getattr(ctx, "no_room", None)
            poll_tend(ctx)
        if isinstance(store, Fleet) and not store.offline and r in ("queued", "replaced") \
                and out["qid"] not in (out["claimed"] or []):
            # this host enqueued what it does not take now (full, refused at fire time, ineligible): kick the
            # peers that may (S8). Detached; a fleet entry only (route() keeps a confidential caller's local)
            kick_soon(out["qid"], a.cwd, ctx, full={h})
    except Exception as x:   # any: an exit 1 here would read as "the queue refused it" (AGENTS.md's exit-1 trap)
        out["claimed"] = out["claimed"] or []
        out["error"] = "%s: %s" % (type(x).__name__, x)
        event("enqueue-claim-error", key=out["qid"], host=h, why=out["error"])
    print(json.dumps(out))
    return 0


def cmd_claim(a, ctx):
    for s in stores():
        if isinstance(s, Fleet):
            flush(s)
    for qid, label, log in claim(ctx):
        print("claimed %s: job %s, log %s" % (qid, label, log))
    poll_tend(ctx)
    return 0


def records():
    out = []
    for p in sorted((logdir() / "run-seed-runs").glob("*.json")):
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, ValueError):
            continue
    return out


_RC = []


def rc_mod():
    """dispatch-rc as a module, loaded once: its running() and watcher_gone() are the one home of "is this
    run's process still the run's"."""
    if not _RC:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        ld = SourceFileLoader("dispatch_rc", str(HERE / "dispatch-rc"))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
        ld.exec_module(m)
        m.CLAIM_AT_END = False   # a run ended in this process is claimed for by this process (dispatch-rc's note)
        _RC.append(m)
    return _RC[0]


def rec_alive(r):
    """REC's run is live: its pid with the start time it recorded (a bare kill(pid, 0) took a reused pid for
    the run), or its watcher still running, which writes the run's end yet (a claude gone before its
    watcher wrote `ended` was carded as dead) — the second review's item 13. A record with no start time
    (before 2026-10-05) falls back to the pid alone."""
    try:
        pid = int(r.get("pid"))
    except (TypeError, ValueError):
        return False
    m = rc_mod()
    if r.get("proc_start") and m.running(pid, r["proc_start"]):
        return True
    if not r.get("proc_start") and m.alive(pid):
        return True
    return isinstance(r.get("watcher"), int) and not m.watcher_gone(r)


def branch_live_here(key, recs):
    """A run of KEY's branch is live on this host with no end recorded: what a refusal of a claim leaves
    marked on the entry (running_on), one branch, one host."""
    return any(r.get("session") and not r.get("ended") and key_of(r.get("repo") or "", r.get("branch") or "") == key
               and rec_alive(r) for r in recs)


def claim_dead(ctx, qid, e):
    """E is claimed or waiting on this host with nothing behind it: no reservation (the window between a
    claim and its job's start), no job launchd runs, no live run of the claim (run_gone)."""
    if e.get("state") not in ("claimed", "waiting") or (e.get("running_on") or "").lower() != host_name():
        return False
    if any(r.get("qid") == qid for r in reservations(ctx.launchctl).values()):
        return False
    return run_gone(ctx, qid, e, records())


def cards_seen():
    p = qdir() / "cards.json"
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return {}


def card(kind, qid, e, why, mark=None, say=True, after=None):
    """A card, once per entry and claim: `queue-silent` (its claimer quiet two sweeps), `queue-stuck`
    (refused past three attempts), `queue-dropped` (an outbox put refused at its replay; MARK, its entry's
    id, dedups it per put), and S9's `after-gone` and `after-overdue` (AFTER, the predecessor's branch: one
    card per entry and predecessor, kept apart from the entry's other cards, and named in the line beside
    the entry's own branch, which helm's stalls read). A line in queue.jsonl; the board's cards for the rest
    are S7's or a card of their own (the design doc's S3 as built, "Not built here"). SAY false keeps stdout
    clean for a flush inside another verb's answer (list --json)."""
    seen = cards_seen()
    mark = "%s %s" % (kind, mark) if mark else "%s %s %s" % (kind, e.get("claimed_at") or "", e.get("attempts") or "")
    # one mark per kind (two cards of one entry overwrote each other's, and both refired every sweep), and one per
    # predecessor for the after cards (S9)
    skey = "%s#%s" % (qid, kind) + (" after %s" % after if after else "")
    if seen.get(skey) == mark:
        return
    seen[skey] = mark
    try:
        qdir().mkdir(parents=True, exist_ok=True)
        (qdir() / "cards.json").write_text(json.dumps(seen, sort_keys=True))
    except OSError:
        pass
    kw = {"after": after, "repo": e.get("repo")} if after else {}
    event("card", card=kind, key=qid, host=host_name(), why=why, branch=e.get("branch"), running_on=e.get("running_on"), **kw)
    if say:
        print("card %s: %s — %s" % (kind, qid, why))


def tip_word(e):
    """The sha of E's branch tip on origin when that tip is its host's requeue (D8-B): the subject
    `Requeue: <topic> from <the host E runs on>`, committed after E's claim (an older one is a requeue the host
    has since taken back). One ls-remote, and a fetch only when the commit is not here yet. None otherwise, and
    when the repo is not cloned here or origin does not answer: silence is no word."""
    repo = repo_path(e.get("repo") or "/nonexistent")
    br, on = e.get("branch") or "", (e.get("running_on") or "").lower()
    if not on or not BRANCH_OK.fullmatch(br) or not (repo / ".git").exists():
        return None
    sha = origin_tip(repo, br)
    if not sha:
        return None
    if git_in(repo, "cat-file", "-e", sha + "^{commit}")[0] != 0:
        git_in(repo, "fetch", "-q", "--no-tags", "origin", "refs/heads/" + br, timeout=60)
    rc, out = git_in(repo, "log", "-1", "--format=%ct%n%s", sha)
    if rc != 0 or "\n" not in out:
        return None
    ct, subject = out.split("\n", 1)
    if subject.strip().lower() != (REQ_SUBJECT % (e.get("topic") or topic_of(br), on)).lower():
        return None
    return sha if ct.isdigit() and int(ct) > int(e.get("claimed_at") or 0) else None


def cmd_sweep(a, ctx):
    """The outbox, this host's own entries reconciled against its records (the claimer alone returns its
    own claim), other hosts' silent claims carded (never re-claimed: an unmoved tip proves nothing), then
    a claim — every SWEEP seconds from the queue-sweep job (`jobs` installs it), by hand `dispatch --sweep`."""
    h = host_name()
    if not claims_here():
        # a writes-only host (S10(g)): its sweep is its outbox's replay at wake — a requeue owed since the sleep
        # pushes its branch, then lands its op. It judges no entry and claims nothing
        url = home()
        if url:
            n = len(flush(Fleet(url), replay=True))
            print("queue sweep on %s (queue-mode writes): %d op(s) from the outbox written, %d owed"
                  % (h, n, len(outbox_files())))
        return 0
    kick_hold(ctx, h)
    try:
        why = kl().watchdog(h, ctx.launchctl)
        if why:
            event("listener-refused", host=h, why=why)
            print(why)
    except Exception as x:   # the watchdog never stops a sweep
        event("watchdog-error", host=h, why="%s: %s" % (type(x).__name__, x))
    recs = records()
    for s in stores():
        try:
            if isinstance(s, Fleet):
                flush(s, replay=True)
            entries = s.entries()
        except (Unreachable, Torn) as x:
            print("queue unreachable (%s): %s" % (s.name, x))
            event("sweep-unreachable", store=s.name, why=str(x))
            continue
        ops = []
        t = now()
        owed = outbox_ops()
        for k, e in entries.items():
            qid = "%s:%s" % (s.name, k)
            st = e.get("state")
            mine = (e.get("running_on") or "").lower() == h
            if st in LIVE and mine:
                rec = run_of(qid, e, recs)
                cond = {"running_on": e.get("running_on"), "claimed_at": e.get("claimed_at")}
                if rec and (str(rec.get("ending") or "").startswith(REQUEUED) or str(rec.get("end_reason") or "").startswith(REQUEUED)) \
                        and (not rec.get("ended") or any(o.get("key") == k for o in owed)):
                    pass   # S10: its requeue's op is in the outbox (or landing now), never a run's end to remove
                    # — only while one is owed: an op the replay dropped (gone, diverged) leaves the ended run to the
                    # remove below, or the entry stays running here for good (S10's finish review)
                elif rec and rec.get("ended"):
                    ops.append({"op": "remove", "key": k, "cond": dict(cond, session=rec.get("session"))
                                if st == "running" else cond})
                elif rec and rec_alive(rec):
                    f = {"seen_at": t}
                    if st != "running":
                        f.update(state="running", session=rec.get("session"), started=rec.get("started"))
                    ops.append({"op": "set", "key": k, "fields": f, "cond": cond})
                elif rec:
                    # its run started and its claude is gone with no end recorded (a crash, a reboot): the
                    # entry goes with a card — a requeue would start the step again over work it may have done
                    ops.append({"op": "remove", "key": k, "cond": cond})
                    card("queue-gone", qid, e, "its run on %s (session %s) died with no end recorded; dispatch it again "
                         "if its work is unfinished" % (h, rec.get("session")))
                elif st != "running" and job_running(ctx.launchctl, e.get("job")):
                    ops.append({"op": "set", "key": k, "fields": {"seen_at": t}, "cond": cond})
                elif st == "running":
                    # started, and no record read: one rewritten as the sweep read it (record() writes in
                    # place), or gone. Never requeued beside a run that may be live; a gone one is carded
                    # once it stays unread past the lease, and `dispatch BRANCH --cancel` here clears it
                    if t - int(e.get("seen_at") or e.get("claimed_at") or 0) >= LEASE:
                        card("queue-gone", qid, e, "running on %s with no record of its run (session %s); dispatch %s "
                             "--cancel here clears it" % (h, e.get("session"), e.get("branch")))
                elif t - int(e.get("claimed_at") or 0) >= LEASE:
                    # its own dead claim, past the lease: no record, no job — back to queued
                    ops.append({"op": "refuse", "key": k, "host": h, "at": t, "cond": cond,
                                "why": "its claim on %s died before the run started (the claimer's sweep)" % h})
                    unreserve(qid)
            elif st == "queued" and mine and not any(r.get("session") and not r.get("ended") and rec_alive(r)
                                                     and r.get("branch") == e.get("branch") and same_branch(e, r.get("repo") or "", r.get("branch") or "") for r in recs):
                ops.append({"op": "set", "key": k, "fields": {"running_on": None}, "cond": {"running_on": e.get("running_on")}})
            elif st in LIVE:
                last = max(int(e.get("seen_at") or 0), int(e.get("claimed_at") or 0))
                word = tip_word(e) if st == "running" and t - last > SWEEP and isinstance(s, Fleet) else None
                if word:
                    # D8-B: its host's own word on the branch, written by its requeue before it slept; the op the
                    # host owes may never land (cut, offline), and the step waits in nobody's hand meanwhile
                    ops.append({"op": "requeue", "key": k, "host": (e.get("running_on") or "").lower(), "at": t, "by": h,
                                "cond": {"id": e.get("id"), "state": "running", "running_on": e.get("running_on"),
                                         "claimed_at": e.get("claimed_at")}})
                    event("requeue-by-tip", key=qid, host=h, of=e.get("running_on"), tip=word[:12])
                    print("requeued %s: running on %s, unseen %d min, its tip says the host handed it back (%s)"
                          % (qid, e.get("running_on"), (t - last) // 60, word[:10]))
                elif t - last > 2 * SWEEP:
                    card("queue-silent", qid, e, "%s on %s, not seen for %d min — never re-claimed here: on %s, dispatch %s "
                         "--cancel clears it once its run is gone, and that host's sweep does"
                         % (st, e.get("running_on"), (t - last) // 60, e.get("running_on"), e.get("branch")))
            why_h = eligibility(e, h) if st == "queued" else None
            # a torn registry bars every entry for this sweep alone: no word written or cleared, no card on it
            # (S5's landing review: each tear wrote inelig_ on every entry and cleared it the next sweep)
            torn = why_h == UNREAD_WHY
            if st == "queued" and not torn and not why_h and e.get("inelig_" + h):
                # its line came back (or the berth did): the word it gave is stale
                ops.append({"op": "set", "key": k, "fields": {"inelig_" + h: None}, "cond": {"id": e.get("id"), "state": "queued"}})
                e = dict(e, **{"inelig_" + h: None})
            if st == "queued" and not torn and why_h and not e.get("inelig_" + h):
                # S5: each host trusts its own config for itself alone, and writes that it may not take the
                # entry (one flat field per host, so two hosts' writes never overwrite each other)
                ops.append({"op": "set", "key": k, "fields": {"inelig_" + h: t}, "cond": {"id": e.get("id"), "state": "queued"}})
                e = dict(e, **{"inelig_" + h: t})
            age = t - int(e.get("queued_at") or t)
            if st == "queued" and not torn and age > 2 * SWEEP:
                # no host may claim it: every host the config names has said so (its own word, above, or this
                # host's for itself) — a feature line edited since it was queued, a berth changed, a pin to a
                # host that left. Each host's reason, once per entry; a full or refusing host is not "nobody".
                # A host that never sweeps (one that left, a VM not yet dispatching, a laptop asleep) gives no
                # word: past SILENT_SWEEPS it counts by this host's config, said as such (S5's landing review)
                feats = features()
                hosts = fleet_hosts(e, local=not isinstance(s, Fleet))

                def word(x):
                    if x == h:
                        return why_h
                    mine_says = eligibility(e, x, feats)
                    if e.get("inelig_" + x):
                        return mine_says or "its own sweep says it may not"
                    if mine_says and age > SILENT_SWEEPS * SWEEP:
                        return "no word from its sweep in %d min (by %s's config: %s)" % (age // 60, h, mine_says)
                    return None
                gone = {x: word(x) for x in hosts}
                if hosts and all(gone.values()):
                    card("queue-unclaimed", qid, e, "no host may claim it (%s)" % "; ".join("%s: %s" % kv for kv in sorted(gone.items())),
                         mark=e.get("id"))
            if st == "queued" and int(e.get("attempts") or 0) > 3:
                card("queue-stuck", qid, e, "refused %s times (last: %s)" % (e.get("attempts"), e.get("last_refusal")))
            if st == "queued" and e.get("by") and (e.get("from") or "").lower() == h \
                    and t - int(e.get("by_seen") or 0) >= SWEEP // 2 and session_live(e["by"]):
                # this host's word that the waiter it put still lives, which the other hosts read (waiter_live):
                # each sweep while the session is in a registry here, so it stays fresh within WAITER_S. Batched
                # with the sweep's other ops into its one write — one commit per sweep, never one per waiter; at
                # every other sweep, one sweep missed (a Mac asleep) read a live waiter as gone (S4's review)
                ops.append({"op": "set", "key": k, "fields": {"by_seen": t}, "cond": {"id": e.get("id"), "state": "queued"}})
        if ops:
            s.do(ops, "sweep by %s" % h)
        if isinstance(s, Fleet):
            # every write and fetch leaves an orphan commit, its trees and blobs; the clone runs with
            # gc.auto=0 so a claim never waits on a collection: the sweep collects instead, under the
            # clone's lock (its pack-refs takes the ref's lock as a fetch does). A lock held past its wait
            # skips the collection, never the claim below (S2a review, item 7.3: Unreachable there, or from
            # the flush above, ended the sweep before it claimed anything)
            try:
                with s.locked():
                    s.git("-c", "gc.auto=1000", "gc", "--auto", "-q", timeout=120)
            except (Unreachable, subprocess.TimeoutExpired) as x:
                event("sweep-gc-skipped", store=s.name, why=str(x)[:200])
    for qid, label, log in claim(ctx):
        print("claimed %s: job %s, log %s" % (qid, label, log))
    if any(kicks_dir().glob("*.json")):
        # a kick heard while this pass ran: its kickstart found this job running and started nothing (launchctl
        # kickstart without -k), and the pass may have fetched before its entry existed — one more hold and claim,
        # or the entry waited for the next interval (the S8 review, G3's 30 s)
        kick_hold(ctx, h)
        for s in stores():
            if isinstance(s, Fleet):
                try:
                    flush(s)
                except (Unreachable, Torn):   # as the pass's own loop: a torn ref skips the flush, not the claim
                    pass
        for qid, label, log in claim(ctx):
            print("claimed %s: job %s, log %s (a kick heard mid-pass)" % (qid, label, log))
    poll_tend(ctx)
    return 0


def rows(all_=False, timeout=30, bad_stores=None):
    """([(store, key, entry)], [unreadable why]) — every store's entries; unless ALL, those of a repo cloned
    here and those live on this host (what this host could ever run, and what it runs). BAD_STORES, a list,
    gains {"store", "why"} per store that did not read, so a reader holds that store's branches alone."""
    h = host_name()
    out, bad = [], []
    bad_stores = [] if bad_stores is None else bad_stores
    for s in stores():
        try:
            entries, off = s.view(timeout) if isinstance(s, Fleet) else s.view()
        except Torn as x:
            bad.append("%s: %s" % (s.name, x))
            b = {"store": s.name, "why": str(x)}
            if isinstance(s, Local):
                # its keys, from the file names alone (readable when a file is not): a reader holds those
                # branches, whatever their repo's scope — route()'s cwd road puts an open repo here too
                b["keys"] = sorted(p.stem for p in s.dir.glob("*.json"))
            bad_stores.append(b)
            continue
        if off:
            bad.append("%s: unreachable (%s), the last fetch shown" % (s.name, off))
            bad_stores.append({"store": s.name, "why": "unreachable (%s)" % off})
        for k, e in entries.items():
            if all_ or (repo_path(e.get("repo") or "/nonexistent") / ".git").exists() or (e.get("running_on") or "").lower() == h:
                out.append((s, k, e))
    out.sort(key=lambda r: (r[2].get("state") != "queued", rank(r[2])))
    return out, bad


def ago(t):
    m = max(0, now() - int(t or 0)) // 60
    return "%d min ago" % m if m < 120 else "%d h ago" % (m // 60)


def cmd_list(a, ctx):
    try:
        # --status rides on every `dispatch --status`: an offline home costs it 10 s, not a minute
        bad_stores = []
        rs, bad = rows(a.all, 10 if a.status else 30, bad_stores)
    except Torn as x:
        rs, bad, bad_stores = [], [str(x)], [{"store": "*", "why": str(x)}]
    if a.json:
        # bad_stores: which store did not read (queue_holds.py holds only the branches that route there); a
        # failure no store names ("*") holds every branch
        print(json.dumps({"entries": [dict(e, qid="%s:%s" % (s.name, k)) for s, k, e in rs], "unreadable": bool(bad), "why": bad,
                          "bad_stores": bad_stores}, sort_keys=True))
        return 0
    if not rs and not bad:
        if not a.status:
            print("the queue is empty")
        return 0
    h = host_name()
    for i, (s, k, e) in enumerate(rs):
        bits = ["%s %s" % (e.get("state"), e.get("priority"))]
        if e.get("state") == "queued":
            bits.append("rank %d" % (i + 1))
            why = claimable(e, h, fleet=isinstance(s, Fleet))
            if why:
                bits.append("not here: " + why)
            if e.get("kind") == "landing":
                bits.append("a landing")
            said = after_said().get("%s:%s" % (s.name, k)) or [None, 0]
            for x in e.get("after") or []:
                b = (x or {}).get("branch") if isinstance(x, dict) else None
                if b:
                    # the claim's last word on it, when this host judged it (the claim and the sweep re-judge)
                    seg = next((x for x in (said[0] or "").split("; ") if x.startswith("after %s: " % b)), None)
                    word = seg[len("after %s: " % b):] if seg else ("not holding at the last judgement here" if said[1] else "not judged here yet")
                    bits.append("after %s (%s%s)" % (b, word, ", " + ago(said[1]) if said[1] else ""))
        if e.get("running_on"):
            bits.append("on " + e["running_on"])
        if e.get("host"):
            bits.append("pinned " + e["host"])
        if e.get("needs"):
            bits.append("needs " + ",".join(map(str, e["needs"])) if isinstance(e["needs"], list) else "needs ?")
        bits.append("queued " + ago(e.get("queued_at")))
        if e.get("last_refusal"):
            bits.append("last refused: " + str(e["last_refusal"])[:80])
        print("%-28s queue %s · %s" % (e.get("topic", k), s.name, " · ".join(bits)))
        print("    %s:%s  %s  (dispatch %s --cancel)" % (s.name, k, e.get("branch"), e.get("branch")))
    for b in bad:
        print("queue unreadable — %s" % b)
    return 0


def run_of(qid, e, recs):
    """The record of E's run: its session's, or one started from this claim."""
    return next((r for r in recs if (e.get("session") and r.get("session") == e.get("session"))
                 or (r.get("queue") == qid and int(r.get("started") or 0) >= int(e.get("claimed_at") or 0))), None)


def run_gone(ctx, qid, e, recs):
    """True when E, live on this host, has no run behind it: no live record of its session or its claim,
    and no job launchd says is running — what the claimer's sweep would take off (item 23)."""
    rec = run_of(qid, e, recs)
    if rec and not rec.get("ended") and rec_alive(rec):
        return False
    return not job_running(ctx.launchctl, e.get("job"))


def boot_job(ctx, label):
    """LABEL's launchd job out and its plist gone: a claimed or waiting entry's job, cancelled."""
    if not label:
        return
    subprocess.run([ctx.launchctl, "bootout", "gui/%d/%s" % (os.getuid(), label)], capture_output=True)
    (agents() / ("%s.plist" % label)).unlink(missing_ok=True)


def cmd_cancel(a, ctx):
    """A queued entry goes. A claimed or waiting one on this host goes with its job, booted out: no run of
    it exists yet, and `dispatch --end <topic>` would have ended the run a waiting step waits for, which
    then started (the third review's item 2). A live one on this host goes too once no run is behind it (a
    watcher that died, a reboot): nothing else but the claimer's own sweep cleared one, and it blocked every
    dispatch of its branch. A running entry's run is ended, not unqueued; a live entry on another host is
    that host's to clear."""
    repo = str(Path(a.repo).resolve())
    h = host_name()
    said = False
    for s in stores():
        if isinstance(s, Fleet):
            # a put still in the outbox shows in find()'s view, but a remove of it CASes against a ref that
            # lacks it ('gone'), and the next flush then lands the cancelled run (the second review's item 14)
            flush(s)
    torn = []
    for s, k, e, off in find(repo, a.branch, torn):
        qid = "%s:%s" % (s.name, k)
        on = (e.get("running_on") or "").lower()
        if e.get("state") == "queued":
            r = s.do([{"op": "remove", "key": k, "cond": {"id": e.get("id")}}], "cancel %s by %s" % (k, h))[0]
            print("cancelled the queue entry %s%s" % (qid, " (in the outbox: the home is unreachable)" if s.offline else "")
                  if r == "removed" else "the queue entry %s moved meanwhile (%s); look again: dispatch --queue" % (qid, r))
        elif on == h and e.get("state") in ("claimed", "waiting") and not run_of(qid, e, records()):
            # the entry first, then the job: its cleanup's `failed` then finds the entry gone and cards nothing
            r = s.do([{"op": "remove", "key": k, "cond": {"id": e.get("id"), "state": e.get("state"), "running_on": e.get("running_on"),
                                                         "job": e.get("job") or ""}}], "cancel %s by %s, its job booted out" % (k, h))[0]
            if r == "removed":
                boot_job(ctx, e.get("job"))
                unreserve(qid)
                print("cancelled the queue entry %s: %s here, its job %s booted out before its run started" % (qid, e.get("state"), e.get("job") or "-"))
            else:
                print("the queue entry %s moved meanwhile (%s); look again: dispatch --queue" % (qid, r))
        elif on == h and run_gone(ctx, qid, e, records()):
            r = s.do([{"op": "remove", "key": k, "cond": {"id": e.get("id"), "state": e.get("state"), "running_on": e.get("running_on")}}],
                     "cancel %s by %s, its run gone" % (k, h))[0]
            print("cancelled the queue entry %s: %s here with no run behind it" % (qid, e.get("state"))
                  if r == "removed" else "the queue entry %s moved meanwhile (%s); look again: dispatch --queue" % (qid, r))
        elif on == h:
            print("the queue entry %s is %s here, its run started — a run is ended, not unqueued: dispatch --end %s" % (qid, e.get("state"), e.get("topic")))
        elif e.get("state") == "running":
            print("the queue entry %s is running on %s — a run is ended, not unqueued: dispatch --end %s there, or dispatch %s "
                  "--cancel there once its run is gone" % (qid, e.get("running_on"), e.get("topic"), a.branch))
        else:
            # claimed or waiting there: --end there would end the run a waiting step waits for
            print("the queue entry %s is %s on %s — dispatch %s --cancel there boots its job out" % (qid, e.get("state"), e.get("running_on"), a.branch))
        said = True
    for s, why in torn:
        print("queue unreadable — %s: %s" % (s.name, why))
    return 0 if said else (4 if torn else 1)


# ---- the requeue (S10): a host's busy runs handed back, their work saved -------------------------------

REQUEUED = "requeued"          # end_run's reason opens with it: dispatch's fire path, finish()'s claim and the sweep skip it
REQ_SUBJECT = "Requeue: %s from %s"   # the host's own word on the branch (D8-B): only that host's requeue writes it
LAST_REPLY = 4000              # the cut run's last reply in the brief, its last characters
REQ_LOCK = "requeue.lock"      # one requeue per host: the first watcher at a sleep, or a hand
_CP = []


def caller_unattended():
    """autofinish-run's unattended_caller(), the same test: a dispatched run's session, or a peer's job for one."""
    return bool(os.environ.get("CLAUDE_UNATTENDED") or os.environ.get("AUTOFINISH_CALLER_UNATTENDED"))


def checkpoint_mod():
    """wharf's checkpoint.py, through the core's tool lookup: the requeue commits what a run left through the
    hook's own path (its forbidden-file guard), as sync.py's commit_left does. None when it is not installed."""
    if not _CP:
        p = common.tool("checkpoint.py")
        m = None
        if p:
            import importlib.util
            from importlib.machinery import SourceFileLoader
            ld = SourceFileLoader("wharf_checkpoint", str(p))
            m = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
            try:
                ld.exec_module(m)
            except Exception as x:   # a hook that will not load: the dirt stays in the worktree, said
                event("requeue-no-checkpoint", why="%s: %s" % (type(x).__name__, x))
                m = None
        _CP.append(m)
    return _CP[0]


def run_flags(args, st):
    """ARGS with --model and --effort as the cut run's record has them, each held to FLAGS (an entry is data)."""
    a, out, i = list(args or []), [], 0
    while i < len(a):
        if a[i] in ("--model", "--effort") and i + 1 < len(a):
            i += 2
            continue
        out.append(a[i])
        i += 1
    for f in ("--model", "--effort"):
        v = str(st.get(f[2:]) or "")
        if v and re.fullmatch(FLAGS[f], v):
            out += [f, v]
    return out


# the record's manager fields back into the env the entry carries (dispatch's chain_record wrote them from these)
REC_ENV = {"manager": "DISPATCH_SKIPPER", "plan": "DISPATCH_SHIP", "plan_space": "DISPATCH_PLAN_SPACE",
           "manager_host": "DISPATCH_SKIPPER_HOST", "manager_account": "DISPATCH_SKIPPER_ACCOUNT"}


def entry_of_record(st, h, t):
    """A queued entry built from a run record with none (a run from before the home, a writes-only host's own):
    the verb's put. Its rank is the record's (force as high), its flags and env what the record kept."""
    repo = str(Path(st["repo"]).resolve())
    prio = st.get("prio") if st.get("prio") in RANKS else "normal"
    prio = "high" if prio == "force" else prio
    env = {"DISPATCH_DEPTH": str(st.get("depth") or 0)}
    if st.get("task_mode") in ("default", "ask", "dnd", "yolo"):
        env["DISPATCH_MODE"] = st["task_mode"]
    for f, v in REC_ENV.items():
        if st.get(f):
            env[v] = str(st[f])
    args = run_flags(["--yolo"] if st.get("yolo") == 1 else [], st)
    if st.get("note"):
        args += ["--note", str(st["note"])[:4000]]
    return {"id": uuid.uuid4().hex, "key": key_of(repo, st["branch"]), "repo": repo_word(repo), "branch": st["branch"],
            "topic": topic_of(st["branch"]), "priority": prio, "needs": [], "host": "", "confined": False, "state": "queued",
            "queued_at": int(st.get("started") or t), "event_at": t, "put_at": t, "by": "", "from": h, "waiter": "",
            "attempts": 0, "session": "", "args": _rank_args(args, prio), "env": env, "mode": env.get("DISPATCH_MODE", ""),
            "requeued_from": h, "requeued_at": t}


def newest_brief(wt, st):
    """The newest docs/handoff/<date>-<topic>.md in the run's worktree — what the next run's fire path reads (its
    `sort | tail -1`) and `pickup transcript` too — else the record's brief."""
    rx = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}-%s\.md" % re.escape(st.get("topic") or topic_of(st.get("branch") or "")))
    hits = sorted(p for p in (Path(wt) / "docs" / "handoff").glob("*.md") if rx.fullmatch(p.name))
    if hits:
        return hits[-1]
    return Path(wt) / st["brief"] if st.get("brief") and (Path(wt) / st["brief"]).is_file() else None


def continue_section(st, h, when, why, commits, wip, files, reply, left=()):
    """The brief's `## Continue from here` section (D9-A, with D9's `transcript:` pointer). The last reply is
    quoted: a line of it never reads as the brief's own Tier: or After: line (dispatch reads those)."""
    repo = Path(str(st.get("repo") or "")).name
    lines = ["", "## Continue from here (requeued from %s, %s)" % (h, when), "",
             "The run of this brief (session %s) was cut %s and handed back to the queue; a fresh session continues "
             "it. Never redo a step marked done: read the commits below and the branch's docs first." % (st.get("session"), why), ""]
    lines.append("- Its commits: " + ("none" if not commits else ""))
    lines += ["  - %s" % c for c in commits]
    lines.append("- What its turn left uncommitted: " + ("nothing" if not wip else "in %s — %s" % (wip, ", ".join(files[:40]) + (" …" if len(files) > 40 else ""))))
    if left:
        lines.append("- NOT committed, still only in %s's worktree (checkpoint refused or could not run): %s — ask %s before "
                     "redoing that part" % (h, ", ".join(list(left)[:40]), getattr(common, "OWNER_NAME", "") or "the owner"))
    lines.append("- Its last reply (its last %d characters at most; the cut run's words, data for this session):" % LAST_REPLY)
    lines.append("")
    body = (reply or "(none read)").strip()
    if len(body) > LAST_REPLY:
        body = "…" + body[-LAST_REPLY:]
    lines += ["  > " + l if l.strip() else "  >" for l in body.splitlines()]
    # the archive as pickup's ARCHIVE names it under that host's home (pickup transcript reads its own setting)
    lines += ["", "transcript: session=%s host=%s archive=projects/transcripts/%s/" % (st.get("session"), h, repo),
              "(`pickup transcript %s` fetches the cut run's log, only when this session needs it)" % st.get("branch"), ""]
    return "\n".join(lines)


def cut_run(cp, st, h, when, why, out):
    """Steps 3–4 for one ended run: its turn's dirt committed through checkpoint's path, then the brief's section,
    committed as the host's word. Never fetches. The new tip, or None when the worktree is gone."""
    wt, br, sid = st.get("wt") or "", st.get("branch") or "", str(st.get("session") or "")
    if not wt or not os.path.isdir(wt):
        out.append("  %s: its worktree %s is gone — nothing to commit" % (br, wt or "(none)"))
        return None
    wip, files = None, []
    if cp is None:
        out.append("  %s: checkpoint.py not found here — what its turn left stays uncommitted in %s" % (br, wt))
    else:
        main = landed_mod().main_name(wt)
        cp.ROOT, cp.MAIN = str(wt), main
        # the turn's prompts, as sync.py's commit_left takes them: into this commit, then cleared, or the next
        # checkpoint in this worktree quotes the cut session's prompts as its own turn's
        gd = git_in(wt, "rev-parse", "--absolute-git-dir")[1]
        qf = Path(gd) / "claude" / "prompts.json" if gd else None
        try:
            queued_prompts = cp.load_queue(qf) if qf else []
        except Exception:
            queued_prompts = []
        ours = [x for x in queued_prompts if x.get("session") in (sid, None)]
        prompts = [x["prompt"] for x in ours if x.get("prompt")]
        try:
            note, made = cp.checkpoint(None, prompts, "wip: what session %s left when it was requeued from %s (%s)" % (sid[:8], h, when),
                                       claude_made_it=False, session=sid or "unknown")
        except subprocess.CalledProcessError as x:
            note, made = "committing failed: %s" % ((x.stderr or str(x)).strip()[:160]), False
        if made and qf:
            try:
                cp.save_queue(qf, [x for x in queued_prompts if x not in ours])   # another session's stay its own
            except Exception:
                pass
        if made:
            wip = git_in(wt, "rev-parse", "--short", "HEAD")[1]
            files = [f for f in git_in(wt, "show", "--name-only", "--format=", "HEAD")[1].splitlines() if f]
        elif note:
            out.append("  %s: %s" % (br, note))   # the refusal (a forbidden file) said, the dirt left
    started = int(st.get("started") or 0)
    rc_, log = git_in(wt, "log", "--format=%h %s", "--since=@%d" % started, "-n", "30", "HEAD")
    commits = [l for l in log.splitlines() if l and not (wip and l.startswith(wip))]
    brief = newest_brief(wt, st)
    if brief is None:
        out.append("  %s: no brief in its worktree — no section written" % br)
        return git_in(wt, "rev-parse", "-q", "--verify", "refs/heads/" + br)[1] or None
    reply = ""
    try:
        reply = rc_mod().last_answer(sid) if sid else ""
    except Exception:
        reply = ""
    left = [l[3:] for l in git_in(wt, "status", "--porcelain")[1].splitlines() if len(l) > 3]
    with open(brief, "a", encoding="utf-8") as f:
        f.write(continue_section(st, h, when, why, commits, wip, files, reply, left))
    rel = str(brief.relative_to(wt))
    rc_, said = git_in(wt, "commit", "-q", "-m", REQ_SUBJECT % (st.get("topic") or topic_of(br), h),
                       "-m", "Cut %s; the brief's new section says where it stands. Written by dispatch --requeue." % why, "--", rel)
    if rc_ != 0:
        out.append("  %s: the brief's section did not commit (%s)" % (br, said[-160:] or "exit %d" % rc_))
    return git_in(wt, "rev-parse", "-q", "--verify", "refs/heads/" + br)[1] or None


def requeue_lock():
    """This host's requeue lock, or None when another requeue holds it. A watcher at a sleep takes it before it
    starts the verb (DISPATCH_REQUEUE_LOCKED=1), so the verb it starts does not take it twice."""
    if os.environ.get("DISPATCH_REQUEUE_LOCKED") == "1":
        return True
    qdir().mkdir(parents=True, exist_ok=True)
    f = open(qdir() / REQ_LOCK, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except BlockingIOError:
        f.close()
        return None


def cmd_requeue(a, ctx):
    """dispatch --requeue TOPIC|--all [--repo DIR] [--why TEXT] [--dry-run] (S10; the requeue component's "The verb").
    Every busy run of this host (or TOPIC's) is ended, its work committed and pushed, its brief given a "Continue
    from here" section, and its entry put back to `queued` for any host. `--why lid` is the watcher's, at a sleep:
    no offline refusal, and a warm run is left as it is. Exit 0 (an op left in the outbox included), 1 no such
    run, 2 refused, 3 refused offline by hand (nothing ended), 4 another requeue holds the lock."""
    h = host_name()
    lid = (a.why or "") == "lid"
    why = "as %s closed its lid" % h if lid else "by hand on %s%s" % (h, (": " + a.why) if a.why else "")
    if caller_unattended():
        raise Refused("dispatch --requeue: an unattended caller is refused — ending runs and handing them on is the "
                      "owner's word (or the sleep's); end with the WAITING line — the next step waits for a run to end and for %s "
                      "to requeue it by hand" % (getattr(common, "OWNER_NAME", "") or "the owner"))
    url = home()
    if not url:
        raise Refused("dispatch --requeue: no queue home here (wharf-runs/queue-repo) — nothing could take a run back", 2)
    if not a.dry_run:
        lock = requeue_lock()
        if lock is None:
            print("another requeue is running on %s; nothing done here" % h)
            return 4
    rc = rc_mod()
    runs = rc.live(reap=False)
    if not a.all:
        runs = [(p, st) for p, st in runs if st.get("topic") == a.topic and (not a.repo or rc.same_repo(st.get("repo"), a.repo))]
        if not runs:
            print("no live run of %s here (dispatch --status)" % a.topic)
            return 1
    t = now()
    fleet = Fleet(url)
    left, cands = [], []
    for path, st in runs:
        br, topic = st.get("branch") or "", st.get("topic") or ""
        name = "%s (%s)" % (topic, Path(str(st.get("repo") or "")).name)
        if st.get("probe"):
            continue
        if not st.get("brief") or not BRANCH_OK.fullmatch(br):
            # a --start run (a landing, autofinish-run's /finish) has no brief and no entry to return to
            left.append("left %s: a --start run (a landing re-launches at wake, its caller decides)" % name)
            continue
        try:
            store, _ = route(st["repo"], br, st["repo"])
        except Refused:
            store = None
        if st.get("origin") or not isinstance(store, Fleet):
            left.append("left %s: confidential — its queue and its berth are this host's" % name)
            continue
        # warm and waiting first, before any read of the home: at a sleep the hold is 20 s
        warm = rc.warm(st)
        if warm and lid:
            left.append("left %s: warm — it holds nothing awake, and ending it would start its landing as the Mac sleeps" % name)
            continue
        if not warm and rc.parked(st):
            left.append("left %s: waiting at a prompt — for %s" % (name, getattr(common, "OWNER_NAME", "") or "the owner"))
            continue
        if lid:
            # the last fetch with the outbox over it, no network: the op's cond (this claim, this session) guards
            # what a newer ref would change, and a fetch here could spend the whole hold (the landing review)
            k = key_of(str(Path(st["repo"]).resolve()), br)
            try:
                view = apply_all(fleet.read(fleet.cached()), outbox_ops())
            except Torn:
                view = {}
            es = [view[k]] if k in view and same_branch(view[k], str(Path(st["repo"]).resolve()), br) else []
            if not es and st.get("queue"):
                # the run came from the queue, and the cache lags or is torn: its entry by key, judged by this
                # host and this session alone — a put here would pin the step to this Mac (the second review)
                es = [{"key": k, "running_on": h, "session": st.get("session"), "state": "running", "synth": True}]
        else:
            es = [e for s, k, e, _ in find(str(Path(st["repo"]).resolve()), br) if isinstance(s, Fleet)]
        e = es[0] if es else None
        if e and (e.get("host") or "").lower() == h:
            left.append("left %s: pinned here: stays" % name)
            continue
        if e and (e.get("state") not in LIVE or (e.get("running_on") or "").lower() != h
                  or (e.get("session") and e.get("session") != st.get("session"))):
            left.append("left %s: its entry is another step's (%s on %s)" % (name, e.get("state"), e.get("running_on") or "no host"))
            continue
        cands.append(("warm" if warm else "busy", path, st, e))
    for line in left:
        print(line)
    busy = [c for c in cands if c[0] == "busy"]
    if a.dry_run:
        for kind, _, st, e in cands:
            print("would %s %s (session %s)%s" % ("requeue" if kind == "busy" else "end, warm,", st.get("topic"), st.get("session"),
                                                 "" if e or kind != "busy" else " — with no entry: a put from its record"))
        return 0
    if busy and not lid:
        # by hand, online or nothing: one read of the home and of each branch's origin, before anything ends
        try:
            fleet.fetch()
        except Unreachable as x:
            print("refused offline: the queue home did not answer (%s) — nothing ended; at a sleep the outbox takes it" % x)
            return 3
        for _, _, st, _ in busy:
            if origin_tip(st.get("wt") or st["repo"], st["branch"]) is None:
                print("refused offline: origin of %s did not answer — nothing ended" % st["branch"])
                return 3
    for kind, path, st, _ in cands:
        if kind == "warm":
            # by hand only: its normal idle end, its landing and its entry's end as any warm run's (a lid leaves it)
            r = rc.end_run(path, st, "idle — warm, ended by dispatch --requeue")
            print("ended %s: warm, its normal idle end%s" % (st.get("topic"), "" if r == 0 else " — not ended (not provably its claude)"))
    if not busy:
        print("no busy run to requeue on %s" % h)
        return 0
    when = time.strftime("%Y-%m-%d %H:%M %Z")
    me = {"pid": os.getpid(), "pstart": rc.proc_start(os.getpid())}
    owed = []
    # (0) every op in the outbox before any run ends: a hold cut by the sleep leaves each run owed, never lost
    for _, path, st, e in busy:
        # the record's path: the replay drops an op whose run was never ended by this requeue (hold_waits)
        hold = dict(me, wt=st.get("wt") or "", branch=st["branch"], repo=str(st["repo"]), tip=None, record=str(path))
        if e:
            # this claim and this run only: a later claim of the same entry (its id kept) by this host is never
            # set back to queued by an op owed since (the landing review)
            cond = {"running_on": e.get("running_on")} if e.get("synth") else \
                {"id": e.get("id"), "running_on": e.get("running_on"), "claimed_at": e.get("claimed_at")}
            if e.get("session") or e.get("synth"):
                cond["session"] = e.get("session") or st.get("session")   # empty in a cache that lags `started`: no test
            op = {"op": "requeue", "key": e["key"], "host": h, "at": t, "hold": hold, "cond": cond}
            if not e.get("synth"):
                op["args"] = run_flags(e.get("args"), st)
            if not lid:
                op["skip"] = True
        else:
            ne = entry_of_record(st, h, t)
            if not lid:
                ne["refused_by"] = {h: t}   # by hand: this Mac skips it the hour, as the op's skip does
            op = {"op": "put", "key": ne["key"], "entry": ne, "hold": hold}
        owed.append([outbox_add(op), op, path, st])
    # (1, 2) every run ended at once, its reason `requeued`: the fire path's end, claim and landing pass it by
    from concurrent.futures import ThreadPoolExecutor
    reason = "%s from %s (%s)" % (REQUEUED, h, "lid" if lid else "by hand")
    def end_one(o):
        try:
            r = rc.end_run(o[2], o[3], reason)
        except Exception as x:   # one run's error (its record, its window) never aborts the others' hand-over
            # owed, not unlinked: end_run may have signalled already, and the replay judges the record (ended with
            # this reason: the op lands; ended its own way: dropped; not ended: it waits)
            print("  %s: its end failed (%s: %s); its op stays owed" % (o[3].get("topic"), type(x).__name__, x))
            return 2
        if r == 0:
            # the watcher's own save of its record may race end_run's `ending` (load, set last_status, save):
            # the requeue's word is written again, so the sweep and the replay read it (the landing review)
            try:
                cur = json.loads(Path(o[2]).read_text())
                if not str(cur.get("end_reason") or "").startswith(REQUEUED):
                    cur.update(end_reason=reason, ending=reason)
                    rc.save(o[2], cur)   # atomic: the fire path reads it now
            except (OSError, ValueError):
                pass
        return r
    with ThreadPoolExecutor(max_workers=len(owed)) as ex:
        ended = list(ex.map(end_one, owed))
    cp = checkpoint_mod()
    ready, said = [], []
    for o, r in zip(owed, ended):
        p, op, _, st = o
        if r == 2:
            said.append("owed %s: its end failed; the sweep replays its op once its record says how it ended" % st.get("topic"))
            continue
        if r != 0:
            p.unlink(missing_ok=True)
            said.append("left %s: not ended (not provably its claude) — still running" % st.get("topic"))
            continue
        lines = []
        try:
            tip = cut_run(cp, st, h, when, why, lines)      # (3, 4)
        except Exception as x:   # this run's commit or section failed: the others go on; its branch is pushed as it is
            lines.append("its commit or section failed (%s: %s)" % (type(x).__name__, x))
            tip = git_in(st.get("wt") or ".", "rev-parse", "-q", "--verify", "refs/heads/" + st["branch"])[1] or None
        pushed = False
        if tip and st.get("wt") and os.path.isdir(st["wt"]):  # (5)
            git_in(st["wt"], "push", "-q", "origin", "refs/heads/%s:refs/heads/%s" % (st["branch"], st["branch"]), timeout=60)
            pushed = origin_tip(st["wt"], st["branch"]) == tip
        # an op origin holds the tip of is written below; one it does not keeps this process as its holder, so the
        # flush below never retries a push the sleep has no time for — once this process is gone, it is owed
        op["hold"] = dict(op["hold"], tip=tip, **({"pid": None, "pstart": None} if pushed or not tip else {}))
        try:
            # the file as outbox_add wrote it (its queued_op_at, which the day's bound reads), the hold updated
            cur = json.loads(p.read_text())
            cur["hold"] = op["hold"]
            tmp = p.with_name("." + p.name + ".tmp")
            tmp.write_text(json.dumps(cur, sort_keys=True))
            os.replace(tmp, p)
        except (OSError, ValueError):
            pass
        if pushed or not tip:
            ready.append(p.name)
        said.append("requeued %s: ended, %s; %s" % (st.get("topic"), "pushed at %s" % tip[:10] if pushed
                                                    else "kept locally at %s (origin did not take it)" % (tip or "?")[:10] if tip else "no worktree",
                                                    "; ".join(x.strip() for x in lines) or "its work committed"))
        o.append(tip)
    # (6) the ops whose tip origin holds, in one round; the rest stay owed, replayed by a later sweep
    landed = {}
    for op, res in flush(fleet, ready=ready):
        if op.get("hold"):
            landed[op.get("key")] = res
    for line in said:
        print(line)
    for o in owed:
        if len(o) < 5:
            continue
        k = o[1]["key"]
        r = landed.get(k)
        print("  %s: %s" % (k, "queued again for any host (%s)" % r if r in ("requeued", "queued") else
                            "the home said %s" % r if r else "owed in the outbox: the next sweep pushes the branch, then writes it"))
        event("requeue", key="fleet:%s" % k, host=h, why="lid" if lid else "hand", result=r or "outbox", tip=(o[4] or "")[:12])
    return 0


def cmd_mine(a, ctx):
    """The fired job's question before it starts (dispatch --from-queue): is QID still this job's claim —
    claimed or waiting, by this host, with this job's label, and no run of the claim recorded yet? 0 yes,
    3 no, 4 unreadable. A RunAtLoad plist a kill or a power loss left behind fires again at the next login,
    and an entry may have been requeued or replaced since (the review's item 3): either way, not this job's."""
    s, k = split_qid(a.qid)
    h = host_name()
    try:
        entries, off = s.view()
    except (Torn, Unreachable) as x:
        print("unreadable: %s" % x)
        return 4
    if off:
        # offline, only the claim nobody else can hold is still known to be this job's: this host's own put
        # and this job's claim, both still in its outbox, the key absent from the last ref fetched (claim()'s
        # rule; without it the offline claim's job never ran: the second review's items 4 and 15). Any other
        # cached claim may have been returned or taken since, by this host's sweep or elsewhere
        try:
            alone = isinstance(s, Fleet) and outbox_only(k) and k not in s.read(s.cached()) and any(
                o.get("op") == "claim" and o.get("key") == k and (o.get("host") or "").lower() == h
                and (not a.label or o.get("job") == a.label) for o in outbox_ops())
        except Torn:
            alone = False
        if not alone:
            print("unreadable: %s" % off)
            return 4
    e = entries.get(k)
    if not e:
        print("gone")
        return 3
    why = None
    if e.get("state") not in ("claimed", "waiting"):
        why = "it is %s" % e.get("state")
    elif (e.get("claimed_by") or "").lower() != h or (e.get("running_on") or "").lower() != h:
        why = "claimed by %s" % e.get("claimed_by")
    elif a.label and e.get("job") != a.label:
        why = "claimed for job %s" % e.get("job")
    elif any(r.get("queue") == a.qid and int(r.get("started") or 0) >= int(e.get("claimed_at") or 0) for r in records()):
        why = "its run started already"
    print(why or "mine")
    return 3 if why else 0


def cmd_fire(a, ctx):
    """The fire path's word on its own claim (QID): waiting (after() holds it), started (the record exists),
    refused (cap, memory, no account: back to queued, this host skips it an hour), failed (any other end
    before the start: the entry goes, with a card — a requeue would fail the same way at every claim)."""
    s, k = split_qid(a.qid)
    h = host_name()
    if isinstance(s, Fleet):
        flush(s)   # an offline claim's entry lands before its job's word, which would otherwise read `gone`
    # this claim only: a host-wide condition let a stale job's word act on a newer claim of the entry
    cond = {"running_on": h, "claimed_by": h}
    if a.label:
        cond["job"] = a.label
    if a.verb == "waiting":
        # the reservation stays, marked waiting: held() counts it once the earlier run's own slot is free, so
        # that run's end cannot claim the slot this step needs (the third review's item 4)
        if not mark_waiting(a.qid, a.label):
            try:
                e = s.view()[0].get(k) or {}
                _reswrite(a.qid, "w%d" % os.getpid(), {"qid": a.qid, "at": now(), "label": a.label, "pid": os.getpid(), "waiting": True,
                                                       "repo": str(repo_path(e["repo"])), "topic": topic_of(e["branch"])})
            except (KeyError, Torn, Unreachable, OSError):
                pass
        r = s.do([{"op": "set", "key": k, "fields": {"state": "waiting", "seen_at": now()}, "cond": cond}], "waiting %s" % k)[0]
    elif a.verb == "started" and isinstance(s, Local) and s.scope == LAND_STORE:
        # a landing's record exists: it holds its slot as any run (its reservation spent by the record's `queue`),
        # and nothing else reads its entry — gone, so its branch's next landing finds none (S9)
        unreserve(a.qid, label=a.label)
        r = s.do([{"op": "remove", "key": k, "cond": cond}], "landing %s started on %s" % (k, h))[0]
        event("started", key=a.qid, host=h, session=a.session, entry_kind="landing")
    elif a.verb == "started":
        unreserve(a.qid, label=a.label)
        r = s.do([{"op": "set", "key": k, "cond": cond,
                   "fields": {"state": "running", "session": a.session or "", "started": now(), "seen_at": now()}}], "running %s on %s" % (k, h))[0]
        ev = os.environ.get("DISPATCH_EVENT_AT") or ""
        # G3 in one line: the seconds from what made the entry startable to its run's record (S7 reads it)
        event("started", key=a.qid, host=h, session=a.session, loaded_at=os.environ.get("DISPATCH_LOADED_AT"),
              event_at=int(ev) if ev.isdigit() else None, wait_s=now() - int(ev) if ev.isdigit() else None)
    elif a.verb == "refused":
        unreserve(a.qid, label=a.label)
        r = s.do([{"op": "refuse", "key": k, "host": h, "at": now(), "why": a.why or "refused", "cond": cond,
                   "skip": bool(a.skip_hour), "keep_on": h if branch_live_here(k, records()) else None}], "refused %s on %s" % (k, h))[0]
        event("refused", key=a.qid, host=h, why=a.why)
    else:
        unreserve(a.qid, label=a.label)
        entries, _ = s.view()
        r = s.do([{"op": "remove", "key": k, "cond": cond}], "failed %s on %s" % (k, h))[0]
        if r == "removed" and (a.why or "").startswith("FAILED: --if-room:"):
            # --if-room's own outcome (no week room, no run), carried by the entry as the one-shot carried it:
            # a skip, never a failure — a queue-failed card nothing reads would stand for it (S3's landing
            # review, item 7; S4). queue.jsonl keeps the line
            event("if-room-skip", key=a.qid, host=h, why=a.why)
        elif r == "removed":
            # a stale job's word moves nothing, and its card would name the newer claim and, by its mark,
            # hide that claim's own (the second review's item 16)
            card("queue-failed", a.qid, entries.get(k) or {}, a.why or "the run failed before it started")
    print("queue %s: %s%s" % (a.qid, r, " (outbox)" if s.offline else ""))
    return 0


def cmd_branch_word(a, ctx):
    """started/ended for a run by REPO and BRANCH: a run not from the queue marks a queued entry of its
    branch as live here (one branch, one host); a run's end removes the entry only while its session is
    this run's, so a pinned --next that replaced it survives (and leaves `running_on` free)."""
    repo = str(Path(a.repo).resolve())
    h = host_name()
    for s in stores():
        if isinstance(s, Fleet):
            flush(s)
    torn = []
    for s, k, e, off in find(repo, a.branch, torn):
        if a.verb == "started":
            if e.get("state") == "queued" and not e.get("running_on"):
                s.do([{"op": "set", "key": k, "fields": {"running_on": h}, "cond": {"id": e.get("id"), "state": "queued"}}], "live %s on %s" % (k, h))
        elif e.get("session") and e.get("session") == a.session:
            r = s.do([{"op": "remove", "key": k, "cond": {"session": a.session}}], "ended %s on %s" % (k, h))[0]
            event("ended", key="%s:%s" % (s.name, k), host=h, session=a.session, result=r)
        elif e.get("state") == "queued" and (e.get("running_on") or "").lower() == h:
            s.do([{"op": "set", "key": k, "fields": {"running_on": None}, "cond": {"id": e.get("id"), "state": "queued"}}], "freed %s" % k)
    for s, why in torn:
        print("queue unreadable — %s: %s (this run's word not written there)" % (s.name, why))
    return 4 if torn else 0


def cmd_has(a, ctx):
    """The readers' rule: an entry, or no answer, is "has an entry" (exit 3 or 4); 0 is a read that saw none.
    An unreadable store answers 4 only when it is the one that could hold the branch (route()'s, or route
    itself unreadable): a torn fleet ref made every confidential branch's `has` 4 (the third review's item
    5). --elsewhere: only an entry live on another host (claimed, waiting, running there) — the fire path's
    one-branch-one-host question for a run the queue did not start (item 22)."""
    repo = str(Path(a.repo).resolve())
    k = key_of(repo, a.branch)
    states = set(a.state or (LIVE if a.elsewhere else STATES))
    h = host_name()
    bad = []
    for s in stores():
        try:
            if isinstance(s, Fleet):
                flush(s)
            entries = apply_all(s.entries(), outbox_ops()) if isinstance(s, Fleet) else s.entries()
        except (Unreachable, Torn) as x:
            bad.append((s, x))
            continue
        e = entries.get(k)
        if e and same_branch(e, repo, a.branch) and e.get("state") in states and (not a.except_session or e.get("session") != a.except_session) \
                and (not a.elsewhere or (e.get("running_on") or "").lower() not in ("", h)):
            print("%s:%s %s%s" % (s.name, k, e.get("state"), " on %s" % e.get("running_on") if e.get("running_on") else ""))
            return 3
    if bad:
        try:
            own = route(a.repo, a.branch, a.repo)[0].name
        except Exception:
            own = None
        # a torn scope's store answers 4 whatever route() says here: enqueue routed by the caller's cwd,
        # which `has` does not know, so an open branch sent from a confidential checkout lives there (the
        # fourth review). Only a torn fleet ref is judged by route(), item 5's narrowing
        for s, x in bad:
            if own is None or s.name == own or not isinstance(s, Fleet):
                print("unreadable: %s (%s)" % (s.name, x))
                return 4
    return 0


WATCH_S = 15   # the home's read interval while watching (the contract: ls-remote every 15 s)


def watch_read(store, timeout):
    """(entries, offline-why) for one watch pass: a fleet ref is asked by `ls-remote` (the contract: one small
    round-trip every 15 s) and fetched only when it moved past the last fetch here; a node-local store reads
    as it is. A home that does not answer: the last fetch, said (S3's landing review, item 11 — each pass was a
    full fetch under the clone's lock, beside every claim and sweep that wants it)."""
    if not isinstance(store, Fleet):
        return store.view()
    try:
        store.ensure()
        r = store.git("ls-remote", store.url, REF, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as x:
        return apply_all(store.read(store.cached()), outbox_ops()), str(x)
    if r.returncode != 0:
        why = (r.stderr.strip().splitlines() or ["ls-remote exit %d" % r.returncode])[-1][:200]
        return apply_all(store.read(store.cached()), outbox_ops()), why
    sha = (r.stdout.split() or [""])[0]
    if sha == store.cached():
        return apply_all(store.read(sha), outbox_ops()), None
    return store.view(timeout)


def cmd_watch(a, ctx):
    """`dispatch --watch QID [--for MIN]` (S3, the contract's Waiting): block on one entry, printing each
    state it passes, never dispatching, claiming or writing. Exit 0 once it is running (or, with --until
    waiting, waiting or running: dispatch's confirm of a --next); 3 once it is gone — its run ended, it
    failed with a card, or it was cancelled — or a newer step holds its key (below); 1 when --for minutes pass
    first, apart from 2, a refusal (a bad QID, no home: S3's second landing review). This host's reservation is
    read before the home (a claim here shows at once); an unreadable read is said and the watch goes on.
    It follows the entry it first read, not the key: once that step ends, its --next may queue a newer one
    under the same key, which is not the step this caller waited on (S3's second landing review, item 9). An
    entry of another id no later in line (`queued_at` at or before the followed one's) is that step re-put while
    queued, and is followed: a put into a queued entry keeps the earlier `queued_at` (apply_op), so a re-put —
    a fired one-shot's older --queued-at included — never moves later, while a step queued once the followed
    one ended always does (S3's second landing review, item 9; S4's second review: by place, not by state).""" 
    store, key = split_qid(a.qid)
    want = ("waiting", "running") if a.until == "waiting" else ("running",)
    end = time.time() + a.for_min * 60 if a.for_min is not None else None   # --for 0: one read
    step = float(os.environ.get("DISPATCH_WATCH_S") or WATCH_S)
    last, seen = None, None   # seen: (id, queued_at) of the entry the watch follows
    while True:
        try:
            held_here = any(r.get("qid") == a.qid for r in reservations(ctx.launchctl).values())
        except Exception:
            held_here = False
        try:
            entries, off = watch_read(store, int(step) + 15)
            e = entries.get(key)
            newer = None
            if e and seen is None:
                seen = (e.get("id"), int(e.get("queued_at") or 0))
            elif e and e.get("id") != seen[0]:
                if int(e.get("queued_at") or 0) <= seen[1]:
                    seen = (e.get("id"), int(e.get("queued_at") or 0))
                else:
                    newer, e = e, None
            st = (e.get("state") or "?") if e else "gone"
            say = st + (" on %s" % e["running_on"] if e and e.get("running_on") else "")
            if newer:
                say += " (a newer step of the branch holds its key now, %s)" % (newer.get("state") or "?")
            if st == "queued" and held_here:
                say += " (claimed here: its reservation holds a slot)"
            if off:
                say += " (the home did not answer: the last fetch)"
        except Torn as x:
            st, say = "unreadable", "unreadable: %s" % x
        if say != last:
            print("%s %s: %s" % (time.strftime("%H:%M:%S"), a.qid, say), flush=True)
            last = say
        if st in want:
            return 0
        if st == "gone":
            return 3
        if end is not None and time.time() >= end:
            print("%s: still %s after %g min — it stays in the queue" % (a.qid, st, a.for_min), flush=True)
            return 1
        time.sleep(step if end is None else max(0.0, min(step, end - time.time())))


# ---- the jobs: the sweep on every host with a home, the pending poll while entries pend (S2) ------------

def job_labels(ctx):
    return ctx.prefix + ".queue-sweep", ctx.prefix + ".queue-poll"


def prev_labels(ctx):
    """The sweep's and the poll's labels under the previous prefix (dispatch's `--prefix-previous`, from
    wharf-runs/label-prefix-previous): jobs of ours still draining after a label move. Empty without one."""
    prev = (getattr(ctx, "prefix_previous", "") or "").strip()
    if not prev or prev == ctx.prefix:
        return ()
    return prev + ".queue-sweep", prev + ".queue-poll"


def drop_previous(ctx):
    """The previous prefix's sweep and poll booted out and removed — never one launchd says is running, or
    that it could not tell of: this pass may be that job (a bootout would end it mid-pass), or it is mid-pass
    for another; the next dispatch here drops it. Asked of launchd, not XPC_SERVICE_NAME, which python does not
    read reliably: a launchd job's python read "0" (sparks, 2026-09-29), and once Apple's /bin/bash 3.2 has
    exported or unset it, its children read "0" too (probed, the label-move landing review, 2026-10-30).
    → the labels dropped."""
    out = []
    for label in prev_labels(ctx):
        try:
            r = subprocess.run([ctx.launchctl, "print", "gui/%d/%s" % (os.getuid(), label)],
                               capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if "\tstate = running" not in r.stdout and job_out(ctx, label):
            out.append(label)
    return out


def job_plist(ctx, label, verb, every):
    """A StartInterval job running `dispatch --VERB` as this host's launchd runs dispatch (program()): the
    queue context is dispatch's to give (the cap, the prefix, the launcher), so the job asks dispatch."""
    log = str(logdir() / "queue-jobs.log")
    return {"Label": label, "ProgramArguments": program(ctx, ["--" + verb]),
            "EnvironmentVariables": {"PATH": "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:%s/.local/bin" % Path.home()},
            "StartInterval": every, "ProcessType": "Background", "StandardOutPath": log, "StandardErrorPath": log}


def job_loaded(ctx, label):
    """launchd holds LABEL's job in this user's domain (`launchctl print` answers for it); None when it could
    not tell (a launchctl past its 10 s on a loaded Mac): read as loaded, so a running sweep is never booted
    out mid-pass for a slow answer (S2a's finish review)."""
    try:
        return subprocess.run([ctx.launchctl, "print", "gui/%d/%s" % (os.getuid(), label)],
                              capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return None


def job_load(ctx, plist):
    """PLIST's job loaded, rewritten only when its file differs or launchd does not hold it: True when it
    loaded it now. False when nothing changed, or when the load failed: then the plist is removed, so the
    next `jobs` or poll pass tries again and `regatta check` reports no job (S2a's landing review, item 3:
    a plist left on disk unloaded was never retried, and the check read the file as the job). Never from
    inside that job (a bootout of a running job ends it): `jobs` runs from dispatch, the poll's own pass
    only ever boots the poll out, as its last act."""
    label = plist["Label"]
    if os.environ.get("XPC_SERVICE_NAME") == label:
        return False   # launchd names the job a process runs in: never reload the job this pass runs in
    p = agents() / ("%s.plist" % label)
    try:
        if p.exists() and plistlib.loads(p.read_bytes()) == plist and job_loaded(ctx, label) is not False:
            return False
    except Exception:
        pass
    agents().mkdir(parents=True, exist_ok=True)
    logdir().mkdir(parents=True, exist_ok=True)
    dom = "gui/%d" % os.getuid()
    subprocess.run([ctx.launchctl, "bootout", "%s/%s" % (dom, label)], capture_output=True)
    with open(p, "wb") as f:
        plistlib.dump(plist, f)
    for _ in range(2):
        if subprocess.run([ctx.launchctl, "bootstrap", dom, str(p)], capture_output=True).returncode == 0:
            return True
        time.sleep(2)
    if job_loaded(ctx, label) is not False:
        return False   # another pass loaded it between this one's bootout and bootstrap: its plist stays (S2a's finish review)
    p.unlink(missing_ok=True)
    event("job-unloaded", label=label, why="launchctl bootstrap failed twice; its plist removed, retried at the next pass")
    return False


def job_out(ctx, label):
    """LABEL's job booted out and its plist gone; True when there was either. The bootout runs with no plist
    too (an absent label is a no-op): a job loaded while a racing pass removed its file was left running
    every minute until logout (S2a's finish review)."""
    p = agents() / ("%s.plist" % label)
    had = p.exists()
    p.unlink(missing_ok=True)
    r = subprocess.run([ctx.launchctl, "bootout", "gui/%d/%s" % (os.getuid(), label)], capture_output=True)
    return had or r.returncode == 0


def launcher_here():
    """A job loader runs here: launchd on a Mac; elsewhere a systemd user manager that answers, which
    systemd-launchctl drives — asked through the shim's `manager` (the one home of that probe, `regatta
    check` asks it too): a systemctl on PATH with no user bus (a container, a minimal host) is no manager,
    and every pass would then fail its bootstraps (the landing review). Without one, no queue job here."""
    if sys.platform == "darwin":
        return True
    try:
        return subprocess.run([sys.executable, str(HERE / "systemd-launchctl"), "manager"],
                              capture_output=True, timeout=20).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def cmd_jobs(a, ctx):
    """The sweep where a home is, nothing where none is: dispatch runs this at each start beside the
    tidier's refresh, so a host gets its sweep at its first dispatch once a home is set, and loses both
    jobs once it is unset. On Linux the same plist through systemd-launchctl: a user timer (S7)."""
    if not launcher_here():
        print("queue jobs: no launchd or systemd user manager here; no sweep")
        return 0
    sweep, poll = job_labels(ctx)
    if not home():
        gone = [l for l in (sweep, poll) if job_out(ctx, l)] + drop_previous(ctx)
        if gone:
            print("queue jobs: no queue home here — removed %s" % ", ".join(gone))
        return 0
    if job_load(ctx, job_plist(ctx, sweep, "sweep", SWEEP)):
        print("queue jobs: %s loaded, every %d min (log %s)" % (sweep, SWEEP // 60, logdir() / "queue-jobs.log"))
    elif not (agents() / ("%s.plist" % sweep)).exists():
        print("queue jobs: %s did not load (launchctl bootstrap failed twice); the next dispatch here tries again" % sweep)
        return 0   # the previous prefix's sweep keeps sweeping meanwhile
    gone = drop_previous(ctx)   # a label move (wharf-runs/label-prefix-previous): one sweep, the new one
    if gone:
        print("queue jobs: removed %s (the previous label prefix; %s sweeps)" % (", ".join(gone), sweep))
        # the old poll was pending work here: the new one now, as the sweep's pass would load it (the
        # same cached read), not up to SWEEP later
        if any(l.endswith(".queue-poll") for l in gone):
            poll_tend(ctx)
    return 0


_KL = []


def kl():
    """wharf-runs' kicklib.py, the kick roads (S8), loaded once."""
    if not _KL:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        ld = SourceFileLoader("kicklib", str(HERE / "kicklib.py"))
        m = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
        ld.exec_module(m)
        _KL.append(m)
    return _KL[0]


def reached(h):
    """A kick road reaches host H: kicklib.reached, which states how a `wharf-runs/kick-roads` line is read
    (the S2a review's item 12). No roads file, or `none`, is not reached: the pending poll is H's way to hear."""
    return kl().reached(h)


def may_take(e, h):
    """E is an entry host H may yet take: queued, pinned nowhere else, its repo cloned here. What H cannot
    take now (its hour's skip, the branch live elsewhere, no room) may become takeable without any event
    that reaches it; an entry pinned to another host never does, nor one the fence keeps from H."""
    return e.get("state") == "queued" and not eligibility(e, h) \
        and (repo_path(e.get("repo") or "/nonexistent") / ".git").exists() and fleet_fence(e, h) is None


def poll_tend(ctx):
    """The pending poll loaded, or booted out (the kick component's "The polls, bounded", (2)): loaded on a
    host no road reaches, with room, while the fleet ref (as last fetched here, the outbox laid over it:
    no network) holds an entry it may yet take; booted out otherwise — an empty queue, or a full host,
    whose runs' ends claim. 'loaded', 'out', or None for no change. Never raises: a caller's claim stands."""
    try:
        if not launcher_here():
            return None
        _, poll = job_labels(ctx)
        h = host_name()
        url = home()
        if not (agents() / ("%s.plist" % poll)).exists() and (not url or not claims_here() or reached(h)):
            return None   # no poll loaded and none wanted: nothing to judge, no read of the ref (S2a review, item 8)
        want = False
        if url and claims_here() and not reached(h):
            f = Fleet(url)
            entries = apply_all(f.read(f.cached()), outbox_ops())
            if any(may_take(e, h) for e in entries.values()):
                want = busy(ctx.launchctl) < ctx.cap
        if want:
            if job_load(ctx, job_plist(ctx, poll, "poll", POLL)):
                event("poll-loaded", host=h)
                return "loaded"
            return None
        if (agents() / ("%s.plist" % poll)).exists():
            event("poll-out", host=h)   # before: from the poll's own pass, the bootout ends this process
            job_out(ctx, poll)
            return "out"
        return None
    except Exception as x:   # Torn, Unreachable, a launchctl that will not run: the sweep is the bound
        event("poll-unread", why="%s: %s" % (type(x).__name__, x))
        return None


# ---- the kick (S8; docs/dispatch-queue-kick-2026-10-25.md) ---------------------------------------------------

HOLD_PER = 3   # the sweep holds back this many seconds per higher-ranked host of unknown room (the component)
HOLD_CAP = 9   # …and never longer


def kicks_dir():
    return qdir() / "kicks"


def kick_hold(ctx, h):
    """The capped hold-back (the component's "The receiver"): when a kick was heard here since the last pass,
    the sweep — a job that outlives every caller, so no kicker's call waits on it — waits HOLD_PER seconds per
    host ranked above this one (the order of the scope's `berths`) whose room is unknown (not in any kick's
    `full`) and that the entry's pin, berths and features let take it, HOLD_CAP at most, so a better berth with room
    claims first. One fetch: the entry a kick is about was put a second ago, after this host's last fetch, and the
    cached view never held it (the S8 review: the hold read 0 on every fresh kick). The kicks heard are consumed; one
    older than a sweep is dropped unread. Seconds held."""
    d = kicks_dir()
    files = sorted(d.glob("*.json")) if d.is_dir() else []
    if not files:
        return 0
    t, full, heard = now(), set(), 0
    for p in files:
        try:
            k = json.loads(p.read_text())
            if t - int(k.get("at") or 0) <= SWEEP:
                full |= {x for x in k.get("full") or [] if isinstance(x, str)}
                heard += 1
        except (OSError, ValueError, TypeError, AttributeError):
            pass
        p.unlink(missing_ok=True)
    if not heard:
        return 0
    n = 0
    try:
        url = home()
        if url:
            # never the 5 s cached view: a CAS round just before (the mid-pass road's flush) may predate the entry
            # the kick is about (the S8 review, pass 2)
            _FRESH.pop(url, None)
            entries, _ = Fleet(url).view()
            for e in entries.values():
                if e.get("state") != "queued" or eligibility(e, h):
                    continue
                cands, why = berth_candidates(e.get("repo") or "/nonexistent", h)
                if not (isinstance(why.get("berths"), list) and why["berths"]) or h not in cands:
                    continue   # no berths: no ranking, nobody to wait for
                n = max(n, len([x for x in cands[:cands.index(h)] if x not in full and not eligibility(e, x)]))
    except Exception as x:   # a hold it cannot judge is no hold: the claim goes ahead
        event("kick-hold-unread", host=h, why="%s: %s" % (type(x).__name__, x))
    s = min(HOLD_CAP, HOLD_PER * n)
    event("kick-hold", host=h, kicks=heard, full=sorted(full), held_s=s)
    if s:
        time.sleep(s)
    return s


def kick_peers(e, h, full):
    """The peers to kick for E: every host the config names for it, bar this one and the known-full, that
    E's pin, berths and features let take it."""
    return [x for x in fleet_hosts(e) if x != h and x not in full and not eligibility(e, x)]


def cmd_kick(a, ctx):
    """`dispatch --kick QID`: kick every eligible peer of a queued fleet entry over its roads (kicklib), in
    parallel, each verdict in kicks.jsonl. Refused (exit 2) for a node-local entry — a node's queue never kicks
    out, a press across hosts would tell the spacesheep account a host was kicked — and for a caller whose cwd
    is in a confidential scope, or a registry that will not read (the fence trap). The kick's payload names
    hosts only. Off (exit 0, said) where no `wharf-runs/kick-roads` file is."""
    store, key = split_qid(a.qid)
    if not isinstance(store, Fleet):
        raise Refused("dispatch --kick: %s is a node-local entry; a node's queue never kicks out" % a.qid)
    reg, torn = common.read_registry()
    if torn:
        raise Refused("dispatch --kick: the registry will not read, so the caller's scope cannot be judged (fails closed)")
    cwd = a.cwd or os.getcwd()
    if confidential_scope(toplevel(cwd) or cwd, reg):
        raise Refused("dispatch --kick: refused from a confidential scope's checkout")
    if not kl().kicks_on():
        print("kick: off — no %s here" % kl().ROADS_KEY)
        return 0
    h = host_name()
    e = store.view()[0].get(key)
    if not e or e.get("state") != "queued":
        print("kick: %s is %s; nothing to kick for" % (a.qid, (e or {}).get("state") or "gone"))
        return 0
    # a host's refusal counts as full for the hour claimable() skips it, never longer (the S8 review)
    full = {h} | {x.lower() for x, at in (e.get("refused_by") or {}).items()
                  if isinstance(x, str) and now() - int(at or 0) < SKIP} \
        | {x.strip().lower() for x in (a.full or "").split(",") if x.strip()}
    full = {x for x in full if kl().host_ok(x)}
    peers = kick_peers(e, h, full)
    kid = uuid.uuid4().hex[:8]
    got = kl().kick(peers, h, full, kid) if peers else {}
    event("kick", key=a.qid, host=h, kid=kid, peers=peers, took=got)
    print(json.dumps({"qid": a.qid, "kid": kid, "full": sorted(full), "kicked": got}, sort_keys=True))
    return 0


def kick_soon(qid, cwd, ctx, full=()):
    """enqueue's kick: a queued fleet entry this host did not take. Detached — the kicker's call returns now and
    each road's verdict lands in kicks.jsonl (the component's risk: no caller waits on a road);
    DISPATCH_KICK_SYNC runs it in this process (the suites). Never raises."""
    try:
        if not kl().kicks_on():
            return
        args = ["kick", qid, "--cwd", cwd or os.getcwd(), "--host", host_name(), "--cap", str(ctx.cap), "--jobbin",
                ctx.jobbin, "--prefix", ctx.prefix, "--launchctl", ctx.launchctl, "--rch", ctx.rch or ""]
        if full:
            args += ["--full", ",".join(sorted(full))]
        if os.environ.get("DISPATCH_KICK_SYNC"):
            out = sys.stdout
            sys.stdout = sys.stderr   # enqueue's one JSON line stays alone on stdout
            try:
                main(args)
            finally:
                sys.stdout = out
            return
        logdir().mkdir(parents=True, exist_ok=True)
        with open(logdir() / "kicks.log", "a") as lf:
            subprocess.Popen([sys.executable, str(Path(__file__).resolve())] + args, stdin=subprocess.DEVNULL,
                             stdout=lf, stderr=lf, start_new_session=True)
    except Exception as x:
        event("kick-unsent", key=qid, why="%s: %s" % (type(x).__name__, x))


def cmd_kicked(a, ctx):
    """The receiver (`dispatch --claim --full HOSTS --from HOST`, or the sheep button's `--from-stream`, which reads
    the press's SS_STREAM_DATA): the kick noted in queue/kicks/ and this host's own queue-sweep job kickstarted —
    nothing else. The sweep claims under its own identity, after its hold-back: nothing reads the registry or a
    Drive link inside an Orca terminal, an ssh command or a listener (AGENTS.md's trap). Exit 0 once noted (a
    sweep job that will not start is said: its 10-minute bound stands); 2 for a payload that is not host names."""
    try:
        if a.from_stream:
            frm, full = kl().parse_payload(os.environ.get("SS_STREAM_DATA") or "null")
            road = "sheep"
        else:
            frm, full = kl().parse_payload({"kick": 1, "from": (a.from_ or "").lower(),
                                            "full": [x.strip().lower() for x in (a.full or "").split(",") if x.strip()]})
            road = "peer"
    except (ValueError, TypeError) as x:
        raise Refused("dispatch --claim: %s" % x)
    h = host_name()
    if not home() or not claims_here():
        print("kick heard from %s; no queue home that claims here — nothing to start" % frm)
        return 0
    t = now()
    kicks_dir().mkdir(parents=True, exist_ok=True)
    (kicks_dir() / ("%d-%s-%s.json" % (t, frm, uuid.uuid4().hex[:6]))).write_text(
        json.dumps({"at": t, "from": frm, "full": full, "road": road}, sort_keys=True))
    # this prefix's sweep, else the previous prefix's while a label move drains (main's rule: every reader of the
    # label prefix takes the previous one; the S8 review, pass 2)
    ok = False
    for label in (job_labels(ctx)[0],) + tuple(prev_labels(ctx)[:1]):
        if sys.platform == "darwin" or os.environ.get("DISPATCH_LAUNCHCTL"):
            cmd = [ctx.launchctl, "kickstart", "gui/%d/%s" % (os.getuid(), label)]
        else:
            cmd = ["systemctl", "--user", "start", label + ".service"]   # the timer's unit is S7's
        try:
            ok = subprocess.run(cmd, capture_output=True, text=True, timeout=10).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        if ok:
            break
    kl().log("heard", host=h, by=frm, full=full, road=road, sweep_started=ok)
    print("kick heard from %s (%s); %s" % (frm, road, "the sweep started" if ok else
                                           "the sweep job did not start (not loaded?) — its 10-minute pass is the bound"))
    return 0


def cmd_roads(a, ctx):
    """`dispatch --roads`: the `kick-roads` lines what exists here gives (kicklib.roads_lines), for the overlay."""
    for ln in kl().roads_lines(host_name(), ctx.launchctl):
        print(ln)
    if not kl().kicks_on():
        print("(the kick is off here: no %s file)" % kl().ROADS_KEY)
    return 0


def cmd_poll(a, ctx):
    """One pass of the pending poll: `git ls-remote` of the ref (one round trip, no objects); a claim only
    when the ref moved since this host's last fetch, or an entry it already holds is claimable here now
    (its hour's skip over, the branch freed, memory back: claimable() and the claim's own room check
    decide); then the poll kept or booted out (poll_tend). A home that does not answer: the pass does
    nothing, and the sweep is the bound."""
    url = home()
    h = host_name()
    if not url:
        poll_tend(ctx)
        return 0
    f = Fleet(url)
    f.ensure()
    r = f.git("ls-remote", url, REF, timeout=20)
    if r.returncode != 0:
        print("queue unreachable: %s" % ((r.stderr.strip().splitlines() or ["ls-remote exit %d" % r.returncode])[-1][:200]))
        event("poll-unreachable", host=h)
        return 0
    sha = (r.stdout.split() or [""])[0]
    try:
        seen = apply_all(f.read(f.cached()), outbox_ops())
    except Torn:
        seen = {}
    if sha != f.cached() or outbox_files() or any(not claimable(e, h, fleet=True) for e in seen.values()):
        flush(f)
        ctx.after_cached = True   # S9: the poll's claim reuses a young after hold (after_holds)
        for qid, label, log in claim(ctx):
            print("claimed %s: job %s, log %s" % (qid, label, log))
    poll_tend(ctx)
    return 0


def cmd_land(a, ctx):
    """A landing with no room (S9): `dispatch --start`'s /finish of a claude/* worktree, judged a landing by
    dispatch from what it runs. One entry in this host's queue-local/_land, pinned here (the worktree is), of
    kind landing — which ranks it above every build but force — and naming the waiting dispatch --start (pid
    and start time). It carries no prompt, list or merge right: those stay in that process, so a queued
    landing has the direct road's rights exactly, and an entry written by hand can widen none (it starts
    nothing; its claim only frees the process it names). JSON: qid, result, rank."""
    h = host_name()
    repo = str(Path(a.repo).resolve())
    if not BRANCH_OK.fullmatch(a.branch):
        raise Refused("dispatch-queue land: a claude/* branch, not %s" % a.branch, 1)
    rc = rc_mod()
    st = rc.proc_start(a.pid)
    if not st:
        raise Refused("dispatch-queue land: no process %s here" % a.pid, 1)
    s = Local(LAND_STORE)
    k = key_of(repo, a.branch)
    t = now()
    e = {"id": uuid.uuid4().hex, "key": k, "repo": repo_word(repo), "branch": a.branch, "topic": a.topic or topic_of(a.branch),
         "kind": "landing", "priority": "normal", "needs": [], "host": h, "confined": False, "state": "queued",
         "queued_at": t, "event_at": t, "put_at": t, "by": "", "from": h, "waiter": "", "attempts": 0, "session": "",
         "args": [], "env": {}, "mode": "", "waiter_pid": int(a.pid), "waiter_start": st}
    try:   # its own file alone: a sibling's removed mid-glob read the whole folder as torn (the second review)
        cur = json.loads((s.dir / ("%s.json" % k)).read_text())
    except FileNotFoundError:
        cur = None
    except (OSError, ValueError):
        raise Refused("dispatch-queue land: %s's entry does not read" % k)
    if cur and cur.get("state") == "queued" and land_waiter_alive(cur):
        raise Refused("dispatch-queue land: %s is queued already for process %s" % (a.branch, cur.get("waiter_pid")))
    if cur:
        s.do([{"op": "remove", "key": k, "cond": {"id": cur.get("id")}}], "landing %s replaced" % k)
    r = s.do([{"op": "put", "key": k, "entry": e}], "landing %s queued by %s" % (k, h))[0]
    order = []
    for st_ in stores():
        try:
            ents = st_.view()[0] if isinstance(st_, Local) else st_.read(st_.cached())   # the last fetch: no network
        except Exception:   # a store that does not read only leaves the rank unsaid
            continue
        order += [(rank(x), "%s:%s" % (st_.name, kk)) for kk, x in ents.items() if x.get("state") == "queued" and not claimable(x, h, fleet=isinstance(st_, Fleet))]
    order.sort()   # a fleet entry the fence keeps from this host is no entry ahead of the landing
    qid = "%s:%s" % (s.name, k)
    event("enqueued", key=qid, host=h, entry_kind="landing", result=r, pid=a.pid)
    print(json.dumps({"qid": qid, "result": r, "rank": next((i + 1 for i, (_, q) in enumerate(order) if q == qid), None)}))
    return 0


def cmd_land_wait(a, ctx):
    """dispatch --start's wait for its landing's claim (S9): a read of this host's own file every LAND_POLL s,
    no network. 0 once this host claimed it for process PID; 3 gone (cancelled, or taken off as dead); 1 past
    --for, the entry then removed (autofinish's sweep starts the landing again later) — 6, never 1, Python's crash."""
    s, k = split_qid(a.qid)
    if not (isinstance(s, Local) and s.scope == LAND_STORE):
        raise Refused("dispatch-queue land-wait: %s is no landing" % a.qid)
    h = host_name()
    end = time.monotonic() + (a.for_s if a.for_s is not None else LAND_WAIT)
    poll = float(os.environ.get("DISPATCH_LAND_POLL") or 3)
    f = s.dir / ("%s.json" % k)
    while True:
        # its own file alone: a sibling landing's file removed mid-glob read the whole folder as torn (the review)
        try:
            e = json.loads(f.read_text())
        except FileNotFoundError:
            e = {}
        except (OSError, ValueError):
            time.sleep(poll)   # mid-write: read again
            continue
        if not e or str(e.get("waiter_pid")) != str(a.pid):
            print("queue %s: gone" % a.qid)
            return 3
        if not land_waiter_alive(e):
            # its dispatch --start is gone (a TERM bash defers past this foreground child, a KILL): the entry
            # goes with it, never a slot claimed for nobody
            s.do([{"op": "remove", "key": k, "cond": {"id": e.get("id")}}], "landing %s: its waiter is gone" % k)
            event("landing-gone", key=a.qid, host=h, pid=a.pid)
            return 3
        if e.get("state") == "claimed" and (e.get("claimed_by") or "").lower() == h:
            print("queue %s: claimed" % a.qid)
            return 0
        if time.monotonic() >= end:
            s.do([{"op": "remove", "key": k, "cond": {"id": e.get("id"), "state": "queued"}}], "landing %s waited out" % k)
            event("landing-waited-out", key=a.qid, host=h, pid=a.pid)
            print("queue %s: waited %d s with no slot" % (a.qid, a.for_s if a.for_s is not None else LAND_WAIT))
            return 6   # never 1, which a crash exits with (AGENTS.md's probe trap)
        time.sleep(poll)


def cmd_unreserve(a, ctx):
    """A job that ran nothing (a stale claim, `mine` said no) gives its reservation back at once."""
    if not a.label:
        raise Refused("dispatch-queue unreserve: --label, so a stale job never frees a newer claim's slot")
    unreserve(a.qid, label=a.label)
    return 0


def cmd_caller_prio(a, ctx):
    """The rank this caller inherits (callers_prio): low, normal or high; nothing with no record of its own."""
    p = callers_prio()
    if p:
        print(p)
    return 0


def cmd_force_ok(a, ctx):
    """Exit 0 when this caller may have --priority force (force_refusal), else 2 with why: dispatch asks it
    before any road, so the one rule judges a run now, a one-shot and a peer's alike."""
    why = force_refusal()
    if why:
        print(why)
        return 2
    return 0


def _rank_args(args, prio):
    """ARGS with its --priority set to PRIO (added where the entry carried none: normal rides as no flag)."""
    a, out, i = list(args or []), [], 0
    while i < len(a):
        if a[i] == "--priority" and i + 1 < len(a):
            i += 2
            continue
        out.append(a[i])
        i += 1
    return out + (["--priority", prio] if prio != "normal" else [])


def cmd_floor(a, ctx):
    """The force's memory floor (FLOOR): dispatch's roomy reads it here, the one home of the number."""
    print(FLOOR)
    return 0


def cmd_cap(a, ctx):
    """The cap a start of --priority meets here (cap_for): dispatch's fire path counts against it."""
    print(cap_for(ctx.cap, a.priority))
    return 0


def cmd_reserved(a, ctx):
    """The fire path's count beside its runs: held(), the one definition of a reservation that holds a slot."""
    print(len(held(ctx.launchctl, a.except_)))
    return 0


def main(argv=None):
    global _HOST
    p = argparse.ArgumentParser(prog="dispatch-queue", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="verb", required=True)

    def ctxargs(sp):
        sp.add_argument("--host")
        sp.add_argument("--cap", type=int, default=3)
        sp.add_argument("--jobbin", default=str(HERE / "dispatch"))
        sp.add_argument("--prefix", default="org.regatta.claude")
        sp.add_argument("--prefix-previous", default="")   # wharf-runs/label-prefix-previous: jobs still draining
        sp.add_argument("--launchctl", default=LAUNCHCTL)
        sp.add_argument("--rch", default="")
    sub.add_parser("home")
    e = sub.add_parser("enqueue")
    ctxargs(e)
    e.add_argument("--repo", required=True)
    e.add_argument("--branch", required=True)
    e.add_argument("--priority", choices=sorted(RANKS), default="normal")
    e.add_argument("--pin")
    e.add_argument("--needs", default="")
    e.add_argument("--by")
    e.add_argument("--cwd")
    e.add_argument("--arg", action="append")
    e.add_argument("--env", action="append")
    e.add_argument("--refused")
    e.add_argument("--claim", action="store_true")
    e.add_argument("--log")
    e.add_argument("--wait", default="")
    e.add_argument("--replace", action="store_true")
    e.add_argument("--queued-at", type=int, default=0)
    e.add_argument("--skip-hour", action="store_true")
    e.add_argument("--after", action="append")
    ld = sub.add_parser("land")
    ctxargs(ld)
    ld.add_argument("--repo", required=True)
    ld.add_argument("--branch", required=True)
    ld.add_argument("--topic", default="")
    ld.add_argument("--pid", type=int, required=True)
    lw = sub.add_parser("land-wait")
    ctxargs(lw)
    lw.add_argument("qid")
    lw.add_argument("--pid", type=int, required=True)
    lw.add_argument("--for", dest="for_s", type=float, default=None)
    w = sub.add_parser("watch")
    ctxargs(w)
    w.add_argument("qid")
    w.add_argument("--for", dest="for_min", type=float, default=None)
    w.add_argument("--until", choices=("running", "waiting"), default="running")
    c = sub.add_parser("claim")
    ctxargs(c)
    c.add_argument("--event-at", type=int)
    for v in ("sweep", "poll", "jobs"):
        ctxargs(sub.add_parser(v))
    li = sub.add_parser("list")
    ctxargs(li)
    li.add_argument("--all", action="store_true")
    li.add_argument("--json", action="store_true")
    li.add_argument("--status", action="store_true")
    for v in ("cancel", "has", "ended"):
        sp = sub.add_parser(v)
        ctxargs(sp)
        sp.add_argument("--repo", required=True)
        sp.add_argument("--branch", required=True)
        sp.add_argument("--session")
        sp.add_argument("--state", action="append", choices=STATES)
        sp.add_argument("--except-session")
        sp.add_argument("--elsewhere", action="store_true")
    for v in ("waiting", "started", "refused", "failed"):
        sp = sub.add_parser(v)
        ctxargs(sp)
        sp.add_argument("qid", nargs="?")
        sp.add_argument("--repo")
        sp.add_argument("--branch")
        sp.add_argument("--session")
        sp.add_argument("--why")
        sp.add_argument("--label", default="")
        sp.add_argument("--skip-hour", action="store_true")
    r = sub.add_parser("reserved")
    ctxargs(r)
    r.add_argument("--except", dest="except_")
    ctxargs(sub.add_parser("caller-prio"))
    ctxargs(sub.add_parser("force-ok"))
    sub.add_parser("floor")
    cp = sub.add_parser("cap")
    ctxargs(cp)
    cp.add_argument("--priority", choices=sorted(RANKS), default="normal")
    rq = sub.add_parser("requeue")
    ctxargs(rq)
    rq.add_argument("topic", nargs="?")
    rq.add_argument("--all", action="store_true")
    rq.add_argument("--repo")
    rq.add_argument("--why", default="")
    rq.add_argument("--dry-run", action="store_true")
    m = sub.add_parser("mine")
    ctxargs(m)
    m.add_argument("qid")
    m.add_argument("--label", default="")
    k = sub.add_parser("kick")
    ctxargs(k)
    k.add_argument("qid")
    k.add_argument("--cwd")
    k.add_argument("--full", default="")
    kd = sub.add_parser("kicked")
    ctxargs(kd)
    kd.add_argument("--from", dest="from_")
    kd.add_argument("--full", default="")
    kd.add_argument("--from-stream", action="store_true")
    ctxargs(sub.add_parser("roads"))
    u = sub.add_parser("unreserve")
    ctxargs(u)
    u.add_argument("qid")
    u.add_argument("--label", default="")
    a = p.parse_args(argv)
    _HOST = (getattr(a, "host", None) or "").lower() or None
    if a.verb == "home":
        # a writes-only home (S10(g)) is no home to dispatch: nothing of this host's own is enqueued or claimed
        h = home() if claims_here() else None
        if h:
            print(h)
        return 0 if h else 1
    try:
        if a.verb == "enqueue":
            return cmd_enqueue(a, a)
        if a.verb == "claim":
            return cmd_claim(a, a)
        if a.verb == "land":
            return cmd_land(a, a)
        if a.verb == "land-wait":
            return cmd_land_wait(a, a)
        if a.verb == "sweep":
            return cmd_sweep(a, a)
        if a.verb == "poll":
            return cmd_poll(a, a)
        if a.verb == "jobs":
            return cmd_jobs(a, a)
        if a.verb == "kick":
            return cmd_kick(a, a)
        if a.verb == "kicked":
            return cmd_kicked(a, a)
        if a.verb == "roads":
            return cmd_roads(a, a)
        if a.verb == "unreserve":
            return cmd_unreserve(a, a)
        if a.verb == "list":
            return cmd_list(a, a)
        if a.verb == "cancel":
            return cmd_cancel(a, a)
        if a.verb == "has":
            return cmd_has(a, a)
        if a.verb == "reserved":
            return cmd_reserved(a, a)
        if a.verb == "caller-prio":
            return cmd_caller_prio(a, a)
        if a.verb == "cap":
            return cmd_cap(a, a)
        if a.verb == "force-ok":
            return cmd_force_ok(a, a)
        if a.verb == "floor":
            return cmd_floor(a, a)
        if a.verb == "mine":
            return cmd_mine(a, a)
        if a.verb == "requeue":
            if bool(a.topic) == bool(a.all):
                raise Refused("dispatch --requeue: TOPIC or --all, one of them")
            return cmd_requeue(a, a)
        if a.verb == "watch":
            return cmd_watch(a, a)
        if a.verb == "ended" or (a.verb == "started" and not a.qid):
            if not (a.repo and a.branch):
                raise Refused("dispatch-queue %s: a QID, or --repo and --branch" % a.verb)
            a.verb = "ended" if a.verb == "ended" else "started"
            return cmd_branch_word(a, a)
        if not a.qid:
            raise Refused("dispatch-queue %s: QID" % a.verb)
        return cmd_fire(a, a)
    except Refused as x:
        print(str(x), file=sys.stderr)
        return x.code
    except Torn as x:
        print("dispatch-queue: the queue is unreadable — %s" % x, file=sys.stderr)
        return 4
    except Exception as x:
        # 5, never Python's own 1: dispatch reads 1 as "the queue alone refused it" and schedules a one-shot,
        # which beside a put that landed ran the step twice (AGENTS.md: a probe's "refuse" exit must not be 1;
        # the third review's item 9)
        import traceback
        traceback.print_exc()
        print("dispatch-queue: %s failed (%s: %s) — could not tell" % (a.verb, type(x).__name__, x), file=sys.stderr)
        return 5


if __name__ == "__main__":
    sys.exit(main())
