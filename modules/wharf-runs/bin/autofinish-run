def load_bin(name):
    """A script in bin/ as a module (no .py, sometimes a dash: no plain import)."""
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), os.path.join(HERE, name))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def git(where, *args):
    r = subprocess.run(["git", "-C", where, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


class Tree:
    """The worktree, read from git — never from the caller's cwd."""

    def __init__(self, path):
        self.path = git(path, "rev-parse", "--show-toplevel")
        self.gitdir = git(path, "rev-parse", "--absolute-git-dir")
        common_dir = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
        self.common = common_dir
        self.primary = os.path.dirname(common_dir) if common_dir.endswith("/.git") else ""
        self.branch = git(path, "symbolic-ref", "--quiet", "--short", "HEAD")
        self.tip = git(path, "rev-parse", "HEAD")
        m = NAME_RE.match(self.branch)
        self.topic = m.group("topic") if m else self.branch.rsplit("/", 1)[-1]
        self.repo = os.path.basename(self.primary)
        self.state_dir = os.path.join(self.gitdir, "claude")
        self.window = "finish · %s" % self.topic   # dispatch adds " · <machine>" for Remote Control
        # fixed at the start: a run that crosses midnight keeps one file
        self.runlog = os.path.join(LOGS, "%s-dispatch-finish-%s.log" % (datetime.date.today().isoformat(), self.topic))

    def problem(self):
        if not self.path or not self.gitdir:
            return "not a git worktree"
        if not self.branch.startswith("claude/"):
            return "on %s, not a claude/* branch" % (self.branch or "a detached HEAD")
        if not self.primary or os.path.realpath(self.path) == os.path.realpath(self.primary):
            return "the primary checkout: a runner works in the branch's own worktree"
        return None


def read_state(t):
    try:
        with open(os.path.join(t.state_dir, STATE)) as f:
            st = json.load(f)
        return st if isinstance(st, dict) else None
    except (OSError, ValueError):
        return None


def contract(st):
    """The keys autofinish.json carries: KEYS always, OPTIONAL_KEYS only when set."""
    return dict({k: st.get(k) for k in KEYS}, **{k: st[k] for k in OPTIONAL_KEYS if st.get(k)})


def write_state(t, st):
    """The contract's keys, in its order, nothing else; through a rename, so a hook never reads half."""
    os.makedirs(t.state_dir, exist_ok=True)
    path = os.path.join(t.state_dir, STATE)
    tmp = "%s.%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(contract(st), f, indent=1, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def log(line):
    """One line in the day's autofinish log — the dry run's file and shape."""
    os.makedirs(LOGS, exist_ok=True)
    with open(os.path.join(LOGS, "autofinish-%s.log" % datetime.date.today().isoformat()), "a") as f:
        f.write(line.rstrip("\n") + "\n")


def run_record(sid):
    """(path, state) of dispatch's record of the run with this session id, or (None, None)."""
    for path in glob.glob(os.path.join(RUNS, "*.%s.json" % sid[:8])):
        try:
            with open(path) as f:
                st = json.load(f)
        except (OSError, ValueError):
            continue
        if st.get("session") == sid:
            return path, st
    return None, None


def run_live(sid):
    """True while dispatch's run of this session is not over: its claude or its watcher still
    running and no end written (dispatch-rc's unfinished())."""
    path, _ = run_record(sid)
    if not path:
        return False
    rc = load_bin("dispatch-rc")
    st = rc.load(path)
    if st.get("ended"):
        return False
    return rc.same(st) or (isinstance(st.get("watcher"), int) and not rc.watcher_gone(st))


def last_stop(t):
    """The detail of this branch's last line in `autofinished` when that line is a stop, else None."""
    entries = [e for e in common.autofinished(t.common) if e["branch"] == t.branch]
    return entries[-1]["detail"] if entries and entries[-1]["outcome"] == "stopped" else None


def chain_runs(t):
    """The sessions `--by chain` started on this worktree's tip, from CHAIN (any other tip's are void)."""
    try:
        with open(os.path.join(t.state_dir, CHAIN)) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return []
    return list(d.get("sessions") or []) if isinstance(d, dict) and d.get("tip") == t.tip else []


def chain_spent(t, prev):
    """The chain relaunches spent on this tip: CHAIN's sessions less the one dispatch refused before any
    session existed (refused) — that start is always the `prev` of the next one, so start()
    drops it from CHAIN then, and a refused start is never counted once a later one runs."""
    return [s for s in chain_runs(t) if not (prev and s == prev.get("session") and prev.get("gate") in REFUSED_GATES)]


def chain_refusal(t, prev):
    """Why the chain manager's tick may not relaunch this tip, or None (orchestration B3, chain-manager
    E3, D4 = C). The one refusal it lifts — no retry on the same tip — only for the one cause it is
    for: the last run on this very tip stopped at `no-landing` and the branch's last autofinished
    line says the network or sleep stopped it (S4_RE, anchored at the stop text's start, as
    bin/stalls.py's NET_RE: a WAITING line that quotes an API error is not one — R4). At most
    CHAIN_RELAUNCHES of them per tip; a chain start dispatch refused before any session (refused)
    leaves the stop in place and is not counted against the tip."""
    if not prev or prev.get("tip") != t.tip:
        return ("a chain relaunch is for a launch stopped on this tip, and its last run was on %s"
                % (str((prev or {}).get("tip") or "none")[:7]))
    if not prev.get("ended"):
        return "a run on this tip started %s (session %s) has not ended" % (
            prev.get("started"), str(prev.get("session"))[:8])
    started = chain_spent(t, prev)
    if not (prev.get("outcome") == "stopped" and prev.get("gate") == "no-landing") and prev.get("gate") not in REFUSED_GATES:
        return "its run on this tip ended %s at %s, not stopped by the network — no chain relaunch" % (
            prev.get("outcome"), prev.get("gate") or "no gate")
    gate, _, text = (last_stop(t) or "").partition(" ")
    if gate != "no-landing" or not S4_RE.match(text) or LOGIN_RE.search(text):
        return "the branch's last autofinished line is no network or sleep stop — no chain relaunch"
    if len(started) >= CHAIN_RELAUNCHES:
        return "%d chain relaunches on this tip already (%s) — raised, not retried" % (
            len(started), ", ".join(s[:8] for s in started))
    return None


def stopped_on(t, prev):
    """True when PREV is a run on this tip that started and ended, neither refused nor died: a stop a
    chain relaunch may be judged by where PREV was recorded (refusal()'s `sent`). One still going
    counts too, so that refusal says it has not ended."""
    if not prev or prev.get("tip") != t.tip:
        return False
    return not prev.get("ended") or (prev.get("gate") not in REFUSED_GATES and prev.get("outcome") != DIED)


def refusal(t, prev, by=None, sent=False):
    """Why no run starts now, or None. `sent`: judged on the peer, for a run the sending Mac sent
    (peer-start and its job). A chain relaunch is judged where its stop happened: the sending Mac ran
    chain_refusal on its own record of the stop, under its start lock, before it sent; the peer has
    no record of a stop on this tip unless its own last run is on it, and then judges that one. Else
    the plain refusal, which `--by sweep` gets anyway (second landing review, 1: a chain relaunch sent
    to the peer was always refused there, so the network-drop relaunch the chain exists for ran on
    neither Mac). A stop made there is a run of the peer's own on this tip that ran and ended: one it
    refused, or one that died, made no stop there, and chain_refusal would refuse it for want of one
    (third landing review, S2: the second's fix still refused those two)."""
    if by == "chain" and not (sent and not stopped_on(t, prev)):
        return chain_refusal(t, prev)
    if not prev:
        return None
    if prev.get("tip") == t.tip and prev.get("gate") not in REFUSED_GATES and prev.get("outcome") != DIED:
        if not prev.get("ended"):
            return "a run on this tip started %s (session %s) has not ended%s" % (
                prev.get("started"), str(prev.get("session"))[:8], ", on %s" % prev["host"] if on_peer(prev) else "")
        return ("its run on this tip (%s) ended %s, %s%s — no retry on the same tip" % (
            t.tip[:7], prev.get("ended"), prev.get("outcome"),
            " at %s" % prev["gate"] if prev.get("gate") else ""))
    if not prev.get("ended") and prev.get("session"):
        if on_peer(prev):   # no record of it here: the peer has it, until the waiter or the sweep settles it
            return "a run is going on %s (session %s, tip %s, started %s)" % (
                prev["host"], prev["session"][:8], str(prev.get("tip"))[:7], prev.get("started"))
        if run_live(prev["session"]):
            return "a run is going on this worktree (session %s, tip %s)" % (
                prev["session"][:8], str(prev.get("tip"))[:7])
        try:
            started = datetime.datetime.fromisoformat(prev.get("started") or "").timestamp()
        except ValueError:
            started = 0
        if not run_record(prev["session"])[0] and time.time() - started < PRE_START_S:
            return "a run was started %s and has not reached dispatch yet" % prev.get("started")
    return None


def same_session(a, b):
    """A full id and its first 8 (a trailer's) are the same session."""
    a, b = str(a or ""), str(b or "")
    return bool(a and b) and (a == b or (min(len(a), len(b)) >= 8 and (a.startswith(b) or b.startswith(a))))


def open_sessions(t, caller=None, typed=False):
    """The live sessions open on this worktree now (bin/autofinish's sessions_on, by the lock's
    holder, the last prompter and cwd): the ones `notify` tells. Read before the lock changes hands."""
    af = load_bin("autofinish")
    state = pathlib.Path(t.state_dir)
    ids = {s for s in ((common.read_owner(state) or {}).get("session"), af.queue_session(state)) if s}
    return sorted({e["sessionId"] for e in af.sessions_on(pathlib.Path(t.path), ids)
                   if not (typed and same_session(e["sessionId"], caller))})


def write_targets(t, sid, targets, told=None):
    path = os.path.join(t.state_dir, NOTIFY)
    tmp = "%s.%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump({"session": sid, "targets": targets, "ts": now_iso(), "told": told}, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def notify_text(t, st, me):
    """The message: what happened to the branch, then the run — enough to find, watch or reach it.
    Every name is read back, never built: the Remote Control name from dispatch's record (it spells
    the host as the config keys do), the run's name from the registry — which is `run-finish` for every
    run (dispatch's -n), so the session id and the worktree go with it."""
    rc = (run_record(st["session"])[1] or {}).get("rc_name") or common.autofinish_window(st, t.branch)
    name = (me or {}).get("name")
    reach = ("ListAgents lists it as %s, cwd %s" % (name, t.path)) if name else "ListAgents lists it by its cwd, %s" % t.path
    return ("autofinish picked up this session's branch %s: a fresh unattended /finish is launching it now. "
            "The run: session %s (%s), window and Remote Control \"%s\", account %s, rule %s (by %s), "
            "started %s on tip %s. It holds this worktree's lock, so writes here are refused until it ends; "
            "its outcome shows here at the next prompt and on the PR. Record %s; log %s. "
            "To stop it, type in its window or Remote Control session (/autofinish off stops only the next start). "
            "No reply needed."
            % (t.branch, st["session"], reach, rc, st.get("account") or "unchanged", st.get("rule"), st.get("by"),
               common.iso_clock(st.get("started")), (st.get("tip") or "")[:7], os.path.join(t.state_dir, STATE),
               runlog_of(t, st)))


def notify(argv):
    ap = argparse.ArgumentParser(prog="autofinish-run notify")
    ap.add_argument("worktree", nargs="?", default=".")
    args = ap.parse_args(argv)
    t = Tree(os.path.abspath(os.path.expanduser(args.worktree)))
    if t.problem():
        print("autofinish-run notify: %s: %s" % (args.worktree, t.problem()), file=sys.stderr)
        return 2
    st = read_state(t) or {}
    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    try:
        with open(os.path.join(t.state_dir, NOTIFY)) as f:
            n = json.load(f)
    except (OSError, ValueError):
        n = {}
    if not st.get("session") or st.get("ended"):
        print("nothing to send: no autofinish run is under way on %s" % t.branch)
        return 0
    if not same_session(me, st["session"]):
        # closed when unknown: anyone else sending these would speak as the run
        print("nothing to send: the run on %s is session %s, not this one (%s)"
              % (t.branch, st["session"][:8], me[:8] if me else "no CLAUDE_CODE_SESSION_ID"))
        return 0
    if n.get("session") != st["session"] or not n.get("targets"):
        print("nothing to send: no other session was open on %s when the run started" % t.branch)
        return 0
    if n.get("told"):
        print("nothing to send: the lines were printed at %s already" % common.iso_clock(n["told"]))
        return 0
    live = {e["sessionId"]: e for e in load_bin("autofinish").live_sessions()}
    text = notify_text(t, st, live.get(st["session"]))
    asked, skipped = [], []
    for sid in n["targets"]:
        e = live.get(sid)
        if not e:
            skipped.append("%s — ended since the start" % sid[:8])
            continue
        name = e.get("name") or sid
        if not e.get("messagingSocketPath"):
            skipped.append("%s — binds no inbox; checkpoint's notice tells it at its next prompt" % name)
            continue
        # ListAgents: a bare name is the address unless two rows share it (asklib's same_named, K2)
        twins = [x for x in live.values() if e.get("name") and x.get("name") == e["name"] and x["sessionId"] != sid]
        print("SendMessage to %s" % name + ("  — %d other live session(s) share the name: send to the ListAgents "
                                            "row whose cwd is %s, with its [ref]" % (len(twins), e.get("cwd"))
                                            if twins else ""))
        asked.append(sid[:8])
    if asked:
        print("with this text, word for word:\n\n%s\n" % text)
    for s in skipped:
        print("skip %s" % s)
    try:
        write_targets(t, n["session"], n["targets"], told=now_iso())
    except OSError:
        pass
    # asked=, not sent=: the model makes the sends, and one across logins may be refused (unproven, B0c)
    log("%s run %s %s notify session=%s asked=%s%s" % (now_iso(), t.repo, t.branch, st["session"][:8],
                                                       ",".join(asked) or "-", " skipped=%d" % len(skipped) if skipped else ""))
    return 0


def lock_refusal(t, caller, typed):
    """Why the worktree's lock is not this run's to take, or None. The registry is bin/autofinish's
    reader (its pid and procStart test), so both judge a live session alike."""
    lock = common.read_owner(t.state_dir)
    holder = (lock or {}).get("session")
    if not holder or same_session(holder, caller):
        return None
    live = next((e for e in load_bin("autofinish").live_sessions() if same_session(e["sessionId"], holder)), None)
    # handed over (`pickup next`, or wharf once the yard settled the block): free while the holder
    # is idle or `shell` — a finished builder still runs the Session-tab waiter, so it reads `shell`.
    # Busy, it may still be in its last turn (worker-done, then the Stop checkpoint): refused (review, 2026-10-19)
    if lock.get("handover") and (not live or live.get("status") in ("idle", "shell")):
        return None
    if live and live.get("status") != "idle":
        return "the worktree's lock is held by session %s, live and %s" % (holder[:8], live.get("status") or "with no status")
    if typed and not lock.get("handover") and time.time() - (lock.get("seen") or 0) < common.OWNER_TTL:
        return ("the worktree's lock is held by session %s (seen %d min ago), not the one that typed /finish"
                % (holder[:8], (time.time() - (lock.get("seen") or 0)) // 60))
    return None


def take_start_lock(t):
    """The path of `autofinish.json.lock`, now ours, or None while another start holds it."""
    os.makedirs(t.state_dir, exist_ok=True)
    path = os.path.join(t.state_dir, START_LOCK)
    for _ in range(2):
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(path) < START_LOCK_S:
                    return None
                os.remove(path)
            except OSError:
                pass  # gone meanwhile: the next try takes it
            continue
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
        return path
    return None


def give_back(t, sid, before, st):
    """The detach failed after the lock and the state were written: the lock as it was (or none),
    and the state ended never-started at `refused` — nothing ran, so the tip may start again."""
    path = os.path.join(t.state_dir, common.OWNER_FILE)
    if (common.read_owner(t.state_dir) or {}).get("session") == sid:
        if before is None:
            try:
                os.remove(path)
            except OSError:
                pass
        else:
            tmp = "%s.%d" % (path, os.getpid())
            with open(tmp, "w") as f:
                f.write(before)
            os.replace(tmp, path)
    st.update(ended=now_iso(), outcome="never-started", gate=REFUSED)
    write_state(t, st)


class NoAccount(Exception):
    """No row of the registry may run this now; args[0] is each row's reason."""


def account_pick(t, cached=False):
    """(label, dir, why) of the login the session runs on (header, the login). dir: the
    CLAUDE_CONFIG_DIR to start with, "" for the default login (unset), None to leave the env as
    it is. Raises NoAccount on the pick's exit 3."""
    if os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"):
        # the token outranks any dir (bin/account's header): `account which` reads only the dir
        return "oauth-token", None, "the caller's CLAUDE_CODE_OAUTH_TOKEN, kept"
    cfg = os.environ.get("CLAUDE_CONFIG_DIR")
    if not ACCOUNT and not cfg:
        return None, None, "no account tool (lighthouse not installed) — the login this run was started with"
    cooling = False
    if cfg:
        try:
            if not ACCOUNT:
                raise OSError("no account tool")
            r = subprocess.run([ACCOUNT, "which"], capture_output=True, text=True, timeout=10)
            label = r.stdout.strip() if r.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            label = ""
        # ~/.claude set explicitly is the default login, which runs logged out unless unset
        # (bin/account's header) — bin/autofinish passes it for a pick of the default row
        default = os.path.realpath(os.path.expanduser(cfg)) == os.path.realpath(os.path.expanduser("~/.claude"))
        cooling = cooling_down(cfg)
        if cooling:
            label = cooling
        else:
            # no spaces: the run lines are key=value, split on whitespace
            return re.sub(r"\s+", "_", label or cfg), "" if default else None, "the caller's CLAUDE_CONFIG_DIR, kept"
    cmd = [ACCOUNT, "pick", "--repo", t.primary, "--json"]
    try:
        r = common.run_group(cmd + (["--cached"] if cached else []), PICK_TIMEOUT)
    except subprocess.TimeoutExpired:
        try:  # a probe that hangs: the cached readings decide, as a dry run's do
            r = common.run_group(cmd + ["--cached"], 5)
        except (OSError, subprocess.TimeoutExpired) as e:
            return None, None, "account pick failed (%s) — the login this run was started with" % type(e).__name__
    except OSError as e:
        return None, None, "account pick failed (%s) — the login this run was started with" % e
    try:
        d = json.loads(r.stdout)
    except ValueError:
        d = None
    if r.returncode == 4:
        return None, None, "no account registry here — the login this run was started with"
    if r.returncode == 3 and isinstance(d, dict):
        raise NoAccount("; ".join("%s: %s" % (l, w) for l, w in d.get("skipped") or []))
    if r.returncode or not isinstance(d, dict) or not d.get("account"):
        return None, None, "account pick failed (%s) — the login this run was started with" % (
            (r.stdout or r.stderr).strip()[:120] or "exit %d" % r.returncode)
    why = d.get("reason") or ""
    if cfg and cooling:
        why = "the caller's %s is cooling down, so picked: %s" % (label, why)
    return d["account"], (d.get("env") or {}).get("CLAUDE_CONFIG_DIR", ""), why


def cooling_down(cfg):
    """The label of the row whose home is CFG when it is parked or a window of it is locked, else None. A caller's
    login is an explicit choice over the soft ceilings, never over a lock: a panel session left on
    a cooling login handed every landing it launched to that login (yard-s2, 2026-10-22, the work login
    held till 11:00). The row is read by its home, not from pick's `skipped`: pick stops at the
    first eligible row and never judges the rest, and `which` names no default row (the review)."""
    if not ACCOUNT:
        return None
    try:
        r = common.run_group([ACCOUNT, "limits", "--all", "--parked", "--json", "--cached"], 5)
        rows = json.loads(r.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    home = os.path.realpath(os.path.expanduser(cfg))
    for a in rows if isinstance(rows, list) else []:
        if not isinstance(a, dict) or not a.get("home") or os.path.realpath(a["home"]) != home:
            continue
        lim = a.get("limits") if isinstance(a.get("limits"), dict) else {}
        if a.get("enabled") is False or lim.get("locked") or str(a.get("why") or "").startswith("cooling down"):
            return re.sub(r"\s+", "_", str(a.get("label") or cfg))
    return None


def use_account(cfg):
    """The pick's dir into this process's env, so the start and the transcript's reader follow it."""
    if cfg is None:
        return
    if cfg:
        os.environ["CLAUDE_CONFIG_DIR"] = cfg
    else:
        os.environ.pop("CLAUDE_CONFIG_DIR", None)


# ---- the finisher rotation (the header) ----------------------------------------------------------

def rotation_window(today=None):
    """(end, why): the last day the rotation runs, or None and why it is off. One key is the switch and
    its end, so turning it off early is deleting the file, and it ends by itself."""
    lines, bad = common.config_read(ROTATION_KEY)
    if bad:
        return None, "rotation off: %s unreadable (%s)" % (ROTATION_KEY, bad)
    if not lines:
        return None, "rotation off: no %s" % ROTATION_KEY
    # bootstrap.sh's config_values writes each word of a value on its own line, so `until <date>` lands
    # as two lines; a hand-written file holds one. Joined, both read (S2's finish review)
    text = " ".join(l.strip() for l in lines if l.strip())
    m = ROTATION_RE.match(text)
    try:
        end = datetime.date.fromisoformat(m.group(1)) if m else None
    except ValueError:
        end = None
    if end is None:
        return None, "rotation off: %s says %r, not `until YYYY-MM-DD`" % (ROTATION_KEY, text[:60])
    if (today or datetime.date.today()) > end:
        return None, "rotation off: it ended %s" % end
    return end, "rotation on until %s" % end


def rotation_fence(primary):
    """None when a landing of this repo may rotate and be recorded, else why not. Fails closed: a torn
    registry reads as no scopes to scope_of_repo, so it is asked first (AGENTS.md's fence trap), and a
    repo in no scope is never known not to be confidential. One parse judges the tear and every scope,
    and a repo in any confidential scope is fenced, not only in the first that lists it (the core's
    gather_fence; S2's finish review). A shape scope_of_repo cannot walk fences too."""
    reg, bad = common.read_registry()
    if bad:
        return "the scope registry does not read"
    try:
        name, _ = common.scope_of_repo(primary, reg=reg) if reg is not None else (None, {})
        if not name:
            return "%s is in no scope" % os.path.basename(primary)
        for n, sc in (reg.get("scopes") or {}).items():
            if (isinstance(sc, dict) and sc.get("confidential") is True
                    and common.scope_of_repo(primary, reg={"scopes": {n: sc}})[0]):
                return "scope %s is confidential" % n
    except Exception as e:  # noqa: BLE001 — a registry it cannot walk is never known open
        return "the scope registry does not walk (%s)" % type(e).__name__
    return None


def draw_arm(t):
    """(arm, why): the arm this start runs, as the state's `arm`, or None for today's finisher."""
    end, why = rotation_window()
    if end is None:
        return None, why
    fenced = rotation_fence(t.primary)
    if fenced:
        return None, "rotation fenced: %s — today's finisher, no row" % fenced
    forced = os.environ.get("AUTOFINISH_COIN")
    coin = int(forced) if forced in ("0", "1") else random.SystemRandom().randrange(2)
    name, model, effort = ARMS[coin]
    return ({"name": name, "model": model, "effort": effort, "coin": coin, "until": end.isoformat(),
             "forced": forced in ("0", "1")}, "%s; coin %d: %s" % (why, coin, name))


def transcript_cost(sid):
    """{models, cost_usd, agents_cost_usd} from the session's transcript and its agents', priced by
    plumb's usage-report (one price table; helmlib.session_cost's walk, plus the models and the agents).
    None without the transcript or usage-report."""
    path = transcript(sid)
    ur_path = common.tool("usage-report")
    if not path or not ur_path:
        return None
    try:
        ur = importlib.machinery.SourceFileLoader("usage_report", str(ur_path)).load_module()
    except BaseException:  # noqa: BLE001 — find_core's sys.exit included: no price, never a lost row
        return None

    def walk(p):
        seen = {}
        try:
            with open(p, errors="replace") as fh:
                for line in fh:
                    if '"usage"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    msg = d.get("message") if isinstance(d, dict) and d.get("type") == "assistant" else None
                    u = (msg or {}).get("usage")
                    # Claude Code's own <synthetic> entries carry zero usage (AGENTS.md's trap)
                    if not isinstance(u, dict) or msg.get("model") in (None, "<synthetic>"):
                        continue
                    key = d.get("requestId") or d.get("uuid")
                    out = u.get("output_tokens") or 0
                    if key in seen and seen[key][1][1] >= out:
                        continue   # a streamed reply's earlier blocks
                    cc = u.get("cache_creation") or {}
                    w5, w1 = cc.get("ephemeral_5m_input_tokens"), cc.get("ephemeral_1h_input_tokens")
                    if w5 is None and w1 is None:
                        w5, w1 = u.get("cache_creation_input_tokens") or 0, 0
                    seen[key] = (msg["model"], (u.get("input_tokens") or 0, out, u.get("cache_read_input_tokens") or 0,
                                                w5 or 0, w1 or 0))
        except OSError:
            pass
        return list(seen.values())

    calls = walk(path)
    agents = [c for p in sorted(glob.glob(os.path.join(path[:-len(".jsonl")], "subagents", "*.jsonl"))) for c in walk(p)]
    models = {}
    for m, v in calls:
        models[m] = models.get(m, 0) + sum(v)
    return {"models": models,
            "cost_usd": round(sum(ur.cost_of(m, *v) for m, v in calls), 4),
            "agents_cost_usd": round(sum(ur.cost_of(m, *v) for m, v in agents), 4)}


@contextlib.contextmanager
def rotation_lock():
    """The rows' file, locked: a row appended while --settle rewrites it would be lost."""
    os.makedirs(LOGS, exist_ok=True)
    with open(os.path.join(LOGS, ROTATION_LOG + ".lock"), "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            yield os.path.join(LOGS, ROTATION_LOG)
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def rotation_row(t, st, outcome, gate, pr):
    """One row for a run that drew an arm; None written (and why) when the fence closed meanwhile."""
    arm = st.get("arm")
    if not isinstance(arm, dict):
        return None
    fenced = rotation_fence(t.primary)
    if fenced:
        return "no rotation row: %s" % fenced
    cost = transcript_cost(st["session"]) or {}
    models = cost.get("models") or {}
    row = {"ts": now_iso(), "host": os.environ.get("DISPATCH_HOST") or common.host_name(),
           "repo": t.repo, "primary": t.primary, "slug": slug(t), "main": main_of(t), "branch": t.branch, "tip": t.tip,
           "session": st["session"], "started": st.get("started"), "by": st.get("by"), "rule": st.get("rule"),
           "account": st.get("account"), "coin": arm.get("coin"), "forced": bool(arm.get("forced")),
           "arm": arm.get("name"), "model": arm.get("model"), "effort": arm.get("effort"),
           "models_returned": sorted(models), "models_unrequested": sorted(m for m in models if m != arm.get("model")),
           # a session that never answered in the arm's model is no read of it (the safeguard's fallback)
           "voided": ("no-reply" if not models else "fallback" if arm.get("model") not in models else None),
           "outcome": outcome, "gate": gate, "pr": pr, "hold": st.get("hold"),
           "cost_usd": cost.get("cost_usd"), "agents_cost_usd": cost.get("agents_cost_usd"),
           "touched_48h": None, "fix_48h": None, "settled": None}
    with rotation_lock() as path:
        with open(path, "a") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    return None


def read_rows(path):
    rows = []
    try:
        with open(path, errors="replace") as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict):
                    rows.append(r)
    except OSError:
        pass
    return rows


def settle_row(r, now):
    """Fill touched_48h and fix_48h of a launched row 48 h past its merge. False when it cannot be
    read yet (no merge time, GitHub silent, the window still open)."""
    s, pr, primary = r.get("slug"), r.get("pr"), r.get("primary")
    if not (s and pr and primary and os.path.isdir(primary)):
        return False
    code, p = common.api("GET", "/repos/%s/pulls/%s" % (s, pr))
    merged = (p or {}).get("merged_at") if code == 200 and isinstance(p, dict) else None
    if not merged:
        return False
    at = datetime.datetime.fromisoformat(merged.replace("Z", "+00:00"))
    if now - at.timestamp() < SETTLE_S:
        return False
    code, files = common.api("GET", "/repos/%s/pulls/%s/files?per_page=100" % (s, pr))
    code2, commits = common.api("GET", "/repos/%s/pulls/%s/commits?per_page=100" % (s, pr))
    if code != 200 or code2 != 200 or not isinstance(files, list) or not isinstance(commits, list):
        return False
    paths = sorted({f["filename"] for f in files if isinstance(f, dict) and f.get("filename")})
    own = {((c.get("commit") or {}).get("message") or "").split("\n")[0] for c in commits if isinstance(c, dict)}
    until = at + datetime.timedelta(seconds=SETTLE_S)
    # a remote-tracking ref older than the window's end may miss its commits, and a settled row is
    # never read again: wait until a sync.py fast-forward has moved it past (S2's finish review)
    tip = git(primary, "log", "-1", "--format=%ct", "origin/%s" % (r.get("main") or "main")).strip()
    if not tip.isdigit() or int(tip) < until.timestamp():
        return False
    # the landing's own commits, rebased onto main, keep their subjects and land at the merge: left out
    out = git(primary, "log", "origin/%s" % (r.get("main") or "main"), "--format=%H%x1f%s",
              "--since=%s" % at.isoformat(), "--until=%s" % until.isoformat(), "--", *paths) if paths else ""
    later = [l.split("\x1f", 1)[1] for l in out.splitlines() if "\x1f" in l and l.split("\x1f", 1)[1] not in own]
    r.update(touched_48h=len(later), fix_48h=sum(1 for s_ in later if FIX_RE.search(s_)),
             settled=now_iso())
    return True


def rotation(argv):
    """`autofinish-run rotation`: the rows read back (the header)."""
    ap = argparse.ArgumentParser(prog="autofinish-run rotation")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--settle", action="store_true")
    ap.add_argument("--since", metavar="YYYY-MM-DD")
    args = ap.parse_args(argv)
    if common.registry_unreadable():
        print("autofinish-run rotation: the scope registry does not read — refused, no row is shown", file=sys.stderr)
        return 3
    _, why = rotation_window()
    with rotation_lock() as path:
        rows = read_rows(path)
    settled = 0
    if args.settle:
        # GitHub is read outside the lock, so a run's end never waits on it; the answers are written
        # into the file as it is then, matched by session, branch and PR
        now, done = time.time(), {}
        for r in rows:
            if (r.get("outcome") in common.LAUNCHED_OUTCOMES and r.get("settled") is None
                    and not rotation_fence(r.get("primary") or "") and settle_row(r, now)):
                done[(r.get("session"), r.get("branch"), r.get("pr"))] = r
        if done:
            with rotation_lock() as path:
                rows = read_rows(path)
                for r in rows:
                    s_ = done.get((r.get("session"), r.get("branch"), r.get("pr")))
                    if s_ and r.get("settled") is None:
                        r.update({k: s_[k] for k in ("touched_48h", "fix_48h", "settled")})
                        settled += 1
                tmp = "%s.%d" % (path, os.getpid())
                with open(tmp, "w") as f:
                    f.writelines(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
                os.replace(tmp, path)
    open_rows = [r for r in rows if not rotation_fence(r.get("primary") or "")]
    shown = [r for r in open_rows if not args.since or str(r.get("ts") or "") >= args.since]
    arms, hosts = {}, {}
    forced = sum(1 for r in shown if r.get("forced"))
    for r in shown:
        if r.get("forced"):
            continue   # AUTOFINISH_COIN chose it, not the coin: no read of an arm
        a = arms.setdefault(r.get("arm") or "?", {"runs": 0, "launched": 0, "stopped": {}, "other": {},
                                                    "voided": 0, "fix_48h": 0, "settled": 0, "cost": []})
        a["runs"] += 1
        if r.get("voided"):
            a["voided"] += 1
        if r.get("outcome") in common.LAUNCHED_OUTCOMES:
            a["launched"] += 1
        elif r.get("outcome") == "stopped":
            a["stopped"][r.get("gate") or "?"] = a["stopped"].get(r.get("gate") or "?", 0) + 1
        else:
            a["other"][r.get("outcome") or "?"] = a["other"].get(r.get("outcome") or "?", 0) + 1
        if r.get("settled"):
            a["settled"] += 1
            a["fix_48h"] += bool(r.get("fix_48h"))
        if isinstance(r.get("cost_usd"), (int, float)):
            a["cost"].append(r["cost_usd"])
        hosts[r.get("host") or "?"] = hosts.get(r.get("host") or "?", 0) + 1
    for a in arms.values():
        c = sorted(a.pop("cost"))
        a["median_cost_usd"] = (c[len(c) // 2] if len(c) % 2 else round((c[len(c) // 2 - 1] + c[len(c) // 2]) / 2, 4)) if c else None
    out = {"window": why, "rows": len(shown), "forced": forced, "fenced_now": len(rows) - len(open_rows),
           "settled_now": settled, "arms": arms, "hosts": hosts, "file": path}
    if args.json:
        print(json.dumps(out, indent=1, ensure_ascii=False))
        return 0
    print("%s; %d row(s) in %s%s%s" % (why, len(shown), path, ", %d settled now" % settled if args.settle else "",
                                       ", %d forced (not counted)" % forced if forced else ""))
    for name, a in sorted(arms.items()):
        print("  %s: %d run(s), %d launched, stopped %s, other %s, %d voided, fix in 48 h %d of %d settled, median $%s"
              % (name, a["runs"], a["launched"], json.dumps(a["stopped"]), json.dumps(a["other"]), a["voided"],
                 a["fix_48h"], a["settled"], a["median_cost_usd"]))
    total = sum(hosts.values())
    if total:
        print("  hosts: " + ", ".join("%s %d (%d %%)" % (h, n, round(100 * n / total)) for h, n in sorted(hosts.items())))
    return 0


def finish_prompt(branch, by=None, merge=False, hold=None, sent_from=None):
    """The prompt the run starts with (the header's). `--from=<host>`: a run that host sent here, whose
    approval is that host's at /finish step 11.4 (D2-A, the header's Where); one word, so /finish's
    one-word branch argument stays one word."""
    return "/finish %s --unattended" % branch + (" --%s" % by if by in LAND_BY else "") + (" --hold" if hold else "") \
        + (" --merge" if merge else "") + (" --from=%s" % sent_from if sent_from else "")


def _lander():
    """bin/autofinish as a module: landing_mode and held_slice, the ladder's one copy (S3b). None when
    it will not load (its wharf peer missing exits at import): the caller then holds."""
    try:
        return importlib.machinery.SourceFileLoader("autofinish_lander", os.path.join(HERE, "autofinish")).load_module()
    except BaseException:  # noqa: B036 — SystemExit included: a missing peer is a hold, never a crash
        return None


def main_of(t):
    try:
        with open(os.path.join(t.primary, ".claude", "workflow.json")) as f:
            return json.load(f).get("main") or "main"
    except (OSError, ValueError, AttributeError):
        return "main"


def unattended_caller():
    """True when the launch's caller is an unattended run: CLAUDE_UNATTENDED here, or, in the peer's job,
    AUTOFINISH_CALLER_UNATTENDED, which peer-start sets when the sending Mac's caller had it. The job's
    env holds only what its plist names, so landing() there read an unattended `--by override` as a
    person (second landing review, 6). The variable can only hold a landing, never grant one."""
    return bool(os.environ.get("CLAUDE_UNATTENDED") or os.environ.get("AUTOFINISH_CALLER_UNATTENDED"))


def landing(t, by, rule):
    """(hold, mode, eff) for this launch — the landing ladder (skipper-modes S3b), read here from plan.json
    (bin/autofinish's landing_mode), never from the caller: `--by` is a label any caller may type, and
    every dispatched run's allow rules pass bin/* unseen (AGENTS.md's unattended-caller trap). `hold` is
    why the run stops at a ready PR, or None when it may merge:
      - mode `ask`: every launch holds but a person's (`override` or `typed`, no CLAUDE_UNATTENDED);
      - a mode launch (`--by yolo|dnd`, or rule M): held_slice under the mode now — `yolo` merges bar the
        launcher's own gates and the repo's `autofinish_exclude`/`in_place`, `dnd` bar the held slice, any
        other mode holds (a taken answer never lands there, yolo-veto D1) — except that a yolo launch
        with no mode at all (a run from before the mode) in a `"merge": "auto"` repo keeps its standing
        yes (E12), and only from a caller without CLAUDE_UNATTENDED: a lowered mode is a mode, and a run
        typing `--by yolo` is no person (landing review 3, 4c);
      - a ship launch (`--by ship`, the keel's yes): held_slice as a mode launch, under `yolo` when the
        ship has no landing mode — the yes was given to a blueprint before any diff, so the launcher's
        gates and the repo's `autofinish_exclude`/`in_place` still hold it (S6's finish review);
      - a brief launch (`--by brief`, rule C from the yes at the brief; autofinish-exclude S7): the yes
        predates the diff, so bin/autofinish's brief_held judges it — class 2, `in_place` and the list
        hold it, class 1 and 3 land — and mode ask holds it as any launch that is not a person's;
      - anything else: None, today's rules (a plain /finish --unattended, step 11.4 by host).
    `eff` is the mode a mode or ship launch was judged by (None for any other), for autofinish.json's
    `eff_mode`: bin/pr judges the launch again by it where the branch has no mode by then."""
    af = _lander()
    if af is None:
        return ("the lander's judge did not load (bin/autofinish)"
                if by in LAND_BY or rule == "M" or by in ("ship", "brief") else None), None, None
    mode, why_mode = af.landing_mode(t.branch, t.primary or None)  # with the repo, as the sweep's verdict reads it
    # a mode that cannot be read (helm absent, a reader that raised) is no "no mode": a mode or ship launch
    # holds, as bin/pr's re-check does — read as None, a ship was judged yolo and E12 took its standing
    # yes (the second landing review)
    unread = af.mode_unreadable(why_mode)
    # `ship` is the keel's yes to merge, not a person at the keyboard: mode ask holds it too
    person = by in PERSON_BY and not unattended_caller()
    if mode == "ask" and not person:
        return "mode ask — nothing lands by itself", mode, None
    if by == "brief":
        try:
            return af.brief_held(t.primary, t.path, main_of(t)), mode, None
        except Exception as e:  # noqa: BLE001 — what it cannot read is a hold
            return "the brief's held paths could not be read (%s)" % type(e).__name__, mode, None
    if by not in LAND_BY and rule != "M" and by != "ship":
        return None, mode, None
    # bin/autofinish's effective_mode: the one rule bin/pr's re-check reads too (follow-ups' landing review, item 8)
    standing = by == "yolo" and mode is None and not unread and not unattended_caller() and merge_auto(t)
    eff = af.effective_mode(by, mode, standing_yes=standing, unreadable=unread)
    if unread:
        return "the mode is unreadable now (%s)" % why_mode, mode, eff
    try:
        return af.held_slice(t.primary, t.path, main_of(t), eff), mode, eff
    except Exception as e:  # noqa: BLE001 — what it cannot read is a hold
        return "the held slice could not be read (%s)" % type(e).__name__, mode, eff


# the module tools /finish names ("Where the tools are"), each with the verb where only one is meant
FINISH_TOOLS = ("wharf-runs/bin/pickup", "wharf-runs/bin/check", "wharf-runs/bin/autofinish-run",
                "wharf-runs/bin/rc-hosts", "keel/bin/keel", "keel/bin/paste-paths", "keel/bin/owed",
                "atlas/bin/knowledge-commit", "wharf/libexec/pr", "wharf/bin/review-gate",
                "wharf/hooks/carried.py", "regatta/bin/regatta which", "helloworld/bin/helloworld check")


def regatta_main():
    """The regatta main checkout this core belongs to (never a worktree, which /finish removes), as
    an absolute path, or None (a plugin install: no checkout)."""
    root = common.regatta_root()
    if not root:
        return None
    gd = subprocess.run(["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                        capture_output=True, text=True).stdout.strip()
    top = os.path.dirname(gd) if gd.endswith("/.git") else str(root)
    # the root as the caller spells it when it is the main checkout: git resolves links (/var is
    # /private/var on macOS), and a rule must read as the session types the path
    return os.path.abspath(str(root)) if os.path.realpath(top) == os.path.realpath(str(root)) else top


def start_cmd(t, sid, dry=False, by=None, merge=False, hold=None, arm=None, sent_from=None):
    """dispatch --start, with E1's lists. The FINISH_TOOLS rules are the modules' in
    the regatta main checkout (/finish runs its tools there since B14b, 2026-10-23, which deleted the
    overlay's shims; B14a's D1-A), in the two spellings a session types them in: under `~/` and the
    absolute path. The deny list wins over them: a held launch keeps `pr merge` denied. No regatta
    checkout (a plugin install): no such rule, and the classifier judges those calls like any other."""
    # No allow rule for the contract's check command: since D1-A (2026-10-13) a branch may launch
    # an AGENTS.md change unwatched, and an allow rule approves before the classifier looks, so
    # the check line would become pre-approved code (code review, 2026-10-13). The classifier
    # judges the check like any command; a slower run, never a wrong one.
    # No allow rule for SendMessage either (`notify`, the header): a bare one would let text in the
    # bundle steer any live session unseen; the classifier judges each send (review, 2026-10-18)
    allow = ["Agent", "EnterWorktree", "Bash(git:*)"]
    top = regatta_main()
    roots = []
    if top:
        rel = os.path.relpath(top, HOME)
        roots = (["~/" + rel] if not rel.startswith("..") else []) + [top]
    for root in roots:
        # one rule per tool the finish skill names, never modules/*/bin/* wholesale: that pre-approved
        # every module tool, live-state writers (clock, knowledge-home, scope-pass) and the core's
        # `regatta pr merge` among them, which no deny pattern matched (the B14b landing review)
        for tool in FINISH_TOOLS:
            allow += ["Bash(%s/modules/%s*)" % (root, tool), "Bash(python3 %s/modules/%s*)" % (root, tool)]
    prompt = finish_prompt(t.branch, by, merge, hold=hold, sent_from=sent_from)
    cmd = [DISPATCH, "--start", prompt, t.path, t.window,
           "--session-id", sid]   # opus: dispatch's default (header)
    if arm:   # the rotation's arm, by full id (the header); none: dispatch's default, today's finisher
        cmd += ["--model", arm["model"], "--effort", arm["effort"]]
    for a in allow:
        cmd += ["--allow", a]
    lift = ["Bash(git push:*)", "Bash(*bin/pr ready*)", "Bash(*bin/pr merge*)",
            "Bash(*libexec/pr ready*)", "Bash(*libexec/pr merge*)",
            "Bash(*regatta pr ready*)", "Bash(*regatta pr merge*)"]
    if hold:
        # a held launch (landing(): mode ask, the dnd slice, a mode lowered since, E12's yolo outside a
        # `"merge": "auto"` repo) stops at a ready PR. The skill says so; this makes it so — prose alone
        # did not hold once (bin/dispatch, idea-redaction, 2026-10-04)
        lift.remove("Bash(*bin/pr merge*)")
        lift.remove("Bash(*libexec/pr merge*)")
        lift.remove("Bash(*regatta pr merge*)")
    for d in lift:
        cmd += ["--undeny", d]
    return cmd + (["--dry-run"] if dry else [])


def merge_auto(t):
    """The repo's standing yes: `"merge": "auto"` in .claude/workflow.json on origin/<main> (main's
    name read from the primary's copy), as /finish step 11.4 reads it. Unreadable: no."""
    try:
        cfg = json.loads(git(t.path, "show", "origin/%s:.claude/workflow.json" % main_of(t)) or "{}")
    except ValueError:
        return False
    return isinstance(cfg, dict) and cfg.get("merge") == "auto"


def start_env(t):
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith("CLAUDE") and k not in KEEP_CLAUDE) and k not in DROP_DISPATCH + DROP_JOB}
    env["DISPATCH_LOG"] = t.runlog
    return env


def bundle_text(t):
    """pickup's context bundle for the branch, as `pickup open --here` prints it."""
    try:
        from pathlib import Path
        pk = load_bin("pickup")
        root = pk.repo_root(Path(t.path))
        data = pk.collect(root, fetch=False)
        b = pk.resolve(t.branch, data["branches"])
        s = b["sessions"][0] if b["sessions"] else None
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            pk.context_bundle(b, data, s)
        return buf.getvalue()
    except Exception as e:  # pickup's Stop included: the run goes on from git alone
        return ("(no bundle: pickup could not read %s — %s: %s. The branch's commits carry its "
                "prompts: git log --reverse --format='%%h %%s%%n%%b' main..HEAD)\n" % (t.branch, type(e).__name__, e))


def write_bundle(t, st, shipped=None):
    """The bundle, from this Mac's transcripts — or, for a run the sending Mac sent here (Where),
    the text that Mac wrote from its own: the branch's sessions were there."""
    path = os.path.join(t.state_dir, BUNDLE)
    text = None
    if shipped:
        try:
            with open(shipped, errors="replace") as f:
                text = f.read()
        except OSError as e:
            text = "(the bundle the sending Mac wrote is unreadable here: %s; this Mac's own follows)\n\n%s" % (
                e, bundle_text(t))
    with open(path, "w") as f:
        f.write("# The conversation's record for /finish %s --unattended\n\n" % t.branch)
        f.write("Written %s by bin/autofinish-run for session %s, tip %s — read it as the old "
                "session's record (design section 7): its prompts, its last asks and replies.\n\n"
                % (now_iso(), st["session"], t.tip[:7]))
        f.write(text if text is not None else bundle_text(t))
    return path


# ---- after the end -------------------------------------------------------------------------------

def transcript(sid):
    dirs = {os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude"), os.path.join(HOME, ".claude")}
    for d in dirs:
        hits = glob.glob(os.path.join(d, "projects", "*", sid + ".jsonl"))
        if hits:
            return hits[0]
    return None


def last_reply(sid):
    """The session's last assistant text (a subagent's sidechain is not the session's), or None."""
    text = None
    try:
        with open(transcript(sid), errors="replace") as f:
            for line in f:
                if '"assistant"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") != "assistant" or rec.get("isSidechain"):
                    continue
                content = (rec.get("message") or {}).get("content")
                if isinstance(content, list):
                    said = "\n".join(c.get("text", "") for c in content
                                     if isinstance(c, dict) and c.get("type") == "text").strip()
                    text = said or text
    except (OSError, TypeError):
        return None
    return text


def tail_lines(path, offset=0, n=8):
    try:
        with open(path, errors="replace") as f:
            f.seek(offset)
            lines = [l.rstrip() for l in f if l.strip().strip("\0")]
    except (OSError, TypeError):
        return []
    return lines[-n:]


def gate_of(warn):
    m = STEP_RE.search(warn)
    if m:
        return "G%s" % m.group(1)
    low = warn.lower()
    return next((g for w, g in GATE_WORDS if w in low), "stop")


def read_outcome(t, sid, log_from):
    """(outcome, pr, gate, lines): lines is what the log, the record and a comment quote."""
    path, rec = run_record(sid)
    if not path:
        return "never-started", None, REFUSED, tail_lines(t.runlog, log_from) or ["(dispatch wrote nothing)"]
    text = last_reply(sid)
    if not text:
        shown = tail_lines(path + ".screen.txt", 0, 15)   # dispatch-rc's hardcopy of a never-busy screen
        return "never-started", None, "never-started", shown or tail_lines(t.runlog, log_from) or [
            "(no reply, no screen: %s)" % rec.get("end_reason", "?")]
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    # a ⚠ anywhere is a stop, read before any launch marker: a stop report may well name another
    # PR's merge or quote a rollback line (review, 2026-10-05: `merged #57` read as launched)
    warn = next((i for i, l in enumerate(lines) if "⚠" in l), None)
    if warn is not None:
        block = [l for l in lines[warn:] if not common.closing_kind(l)]
        return "stopped", None, gate_of(lines[warn]), block
    rollback = ROLLBACK_RE.search(text)
    if common.ending(text)[0] == "done" and (rollback or "Shipped:" in text):
        m = MERGED_RE.search(text) or PULL_RE.search(text) or HASH_RE.search(
            next((l for l in lines if "Shipped:" in l), "")) or HASH_RE.search(text)
        pr = int(m.group(1)) if m else merged_pr(t)
        return "launched", pr, None, [rollback.group(0).strip()] if rollback else lines[-1:]
    # the gate tokens are persisted, so they keep their word; /finish's text says either (rename S4)
    gate = "nothing-to-land" if ("Nothing to land" in text or "Nothing to launch" in text) else "no-landing"
    return "stopped", None, gate, lines[-1:]


def slug(t):
    """owner/name of origin as configured (not `get-url`, which expands insteadOf)."""
    return common.repo_slug(git(t.primary, "config", "--get", "remote.origin.url"))


def merged_pr(t):
    """The launched PR's number when the reply names none: the newest merged PR of this head."""
    s = slug(t)
    if not s:
        return None
    st, prs = common.api("GET", "/repos/%s/pulls?state=closed&per_page=5&head=%s:%s"
                         % (s, s.split("/")[0], urllib.parse.quote(t.branch, safe="")))
    hit = next((p for p in prs or [] if isinstance(p, dict) and p.get("merged_at")), None) if st == 200 else None
    return hit.get("number") if hit else None


def comment(t, st, outcome, gate, lines):
    """The stop, on the branch's PR. Returns (pr number or None, what happened)."""
    s = slug(t)
    if not s:
        return None, "no comment: origin is not on GitHub"
    pr = common.find_pr(s, t.branch)
    if not pr:
        return None, "no comment: no open pull request for %s" % t.branch
    what = {"never-started": "never started", DIED: "runner died"}.get(outcome) or "stopped at %s" % gate
    head = ("**autofinish %s** — `%s`, session `%s`, tip `%s`, rule %s, started by %s at %s."
            % (what, finish_prompt(t.branch, st.get("by"), st.get("merge"), st.get("hold"), st.get("from")), st["session"], str(st.get("tip") or t.tip)[:7], st.get("rule"), st.get("by"),
               st.get("started")))
    quoted = "\n".join(lines)
    if len(quoted) > COMMENT_CAP:
        quoted = quoted[:COMMENT_CAP - 1] + "…"
    if outcome == DIED:  # its words first, then dispatch's log as it was left
        why = (PEER_DIED_WHY % st["host"]) if on_peer(st) else DIED_WHY
        body = head + "\n\n" + why + ".\n\n" + ("```\n%s\n```" % quoted) + (
            "\n\nThe sweep may judge this branch once more — not once this PR is out of `WIP:`, nor "
            "a branch the runner had already curated locally; a second death on this tip waits for a prompt. "
            "The transcript, if any, is session `%s` on %s." % (st["session"], common.host_name()))
    else:
        body = head + "\n\n" + ("```\n%s\n```" % quoted if outcome == "never-started" else quoted) + (
            "\n\nNothing retries on this tip. A new commit can be started again; the transcript is "
            "session `%s` on %s." % (st["session"], common.host_name()))
    code, _ = common.api("POST", "/repos/%s/issues/%d/comments" % (s, pr["number"]), {"body": body})
    return pr["number"], ("commented on #%d" % pr["number"] if code == 201
                          else "comment on #%d refused (HTTP %s)" % (pr["number"], code or "none"))


def release(t, sid):
    """The lock if it is still this session's, and a `finishing` marker. Returns what was done."""
    done = []
    lock = common.read_owner(t.state_dir)
    if lock and lock.get("session") == sid:
        try:
            os.remove(os.path.join(t.state_dir, common.OWNER_FILE))
            done.append("lock released")
        except OSError as e:
            done.append("lock NOT released: %s" % e)
    marker = os.path.join(t.state_dir, "finishing")
    if os.path.exists(marker):
        try:
            os.remove(marker)
            done.append("finishing marker removed")
        except OSError as e:
            done.append("finishing marker NOT removed: %s" % e)
    return done


def end_live_run(sid):
    """A run still going when its waiter is ended (SIGTERM, a crash here): ended the way
    `dispatch --end` ends one, so nothing frees its lock under it. True when it was live."""
    path, _ = run_record(sid)
    if not path:
        return False
    rc = load_bin("dispatch-rc")
    st = rc.load(path)
    if st.get("ended") or not rc.same(st):
        return False
    reason = "ended with its autofinish waiter"
    cur = rc.load(path)
    cur["ending"] = reason
    rc.save(path, cur)
    if rc.end_session(st):
        rc.finish(path, rc.load(path), reason)
    return True


def wait_for_end(t, st, cmd):
    """The detached child: bundle, start, wait; then, whatever happened, the lock and the record."""
    def term(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)   # a closing terminal is not an end
    sid, rc, why = st["session"], None, None
    try:  # its pid for dead(); autofinish.json's keys are the hooks' contract, so a file of its own
        rc_mod = load_bin("dispatch-rc")
        with open(os.path.join(t.state_dir, WAITER), "w") as f:
            json.dump({"session": sid, "pid": os.getpid(), "start": rc_mod.proc_start(os.getpid())}, f)
    except Exception:
        traceback.print_exc()
    try:
        log_from = os.path.getsize(t.runlog)
    except OSError:
        log_from = 0
    p = None
    try:
        print("%s autofinish-run: bundle %s" % (now_iso(), write_bundle(t, st, getattr(t, "shipped", None))), flush=True)
        p = subprocess.Popen(cmd, env=start_env(t))
        rc = p.wait()
    except BaseException as e:  # SystemExit from SIGTERM included: the finally below is the point
        signal.signal(signal.SIGTERM, signal.SIG_IGN)   # a second TERM must not cut the cleanup short
        why = "the waiter ended: " + ("signal %s" % e.code if isinstance(e, SystemExit) else type(e).__name__)
        if not isinstance(e, SystemExit):
            traceback.print_exc()
        # dispatch gets a TERM it can clean up after (its start lock, its plist), not subprocess.call's KILL
        if p and p.poll() is None:
            p.terminate()
            try:
                p.wait(timeout=30)
            except subprocess.TimeoutExpired:
                p.kill()
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        notes = []
        try:
            if why and end_live_run(sid):
                notes.append("its live session ended")
        except Exception:
            traceback.print_exc()
        notes += release(t, sid)
        try:
            record(t, st, log_from, rc, why, notes)
        except Exception:
            traceback.print_exc()
            # still an end in the state: an `ended: null` would read as a run going on forever
            try:
                if not (read_state(t) or {}).get("ended"):
                    st.update(ended=now_iso(), outcome="stopped", gate="error")
                    write_state(t, st)
            except Exception:
                traceback.print_exc()
            log("%s run %s %s error session=%s — %s" % (now_iso(), t.repo, t.branch, sid[:8],
                                                         "the outcome could not be recorded; " + "; ".join(notes)))


def record_line(ended, outcome, branch, gate, pr, first, tip=None):
    """`<iso> <outcome> <branch> <detail>`: the shape hooks/common.py's autofinished() parses, and its
    phrase reads an empty launched detail as `#?` — never a `#None`; a died line as bury() writes it."""
    if outcome in common.LAUNCHED_OUTCOMES:
        detail = "%s %s%s" % (outcome, branch, " #%s" % pr if pr else "")
    elif outcome == "never-started":
        detail = "never-started %s %s" % (branch, first)
    elif outcome == DIED:
        detail = "died %s %s %s" % (branch, str(tip or "")[:7], first)
    else:
        detail = "stopped %s %s %s" % (branch, gate, first)
    return (str(ended) + " " + detail).rstrip()


def record(t, st, log_from, rc, why, notes):
    sid = st["session"]
    outcome, pr, gate, lines = read_outcome(t, sid, log_from)
    if why and outcome not in common.LAUNCHED_OUTCOMES:
        lines = [why] + lines
    if st.get("hold") and outcome == "stopped" and gate == "G11":
        # the held landing (S3b): the gate says so, and the line names the class whatever the model
        # wrote, so the board's held card (helm_render) reads it from `autofinished`, not from prose
        gate, lines = "held", ["held (%s): %s" % (st["hold"], lines[0] if lines else "a ready PR waits for the owner's tap")] + lines[1:]
    said = ""
    if outcome not in common.LAUNCHED_OUTCOMES and gate not in REFUSED_GATES:
        pr, said = comment(t, st, outcome, gate, lines)
    st.update(ended=now_iso(), outcome=outcome, pr=pr, gate=gate)
    write_state(t, st)
    # /autofinish's marker has done its job once a run ended: left behind, a `now` marker would
    # have the Stop hook judge the branch again at every later turn's end (E3's note)
    if gate not in REFUSED_GATES:
        try:
            os.unlink(os.path.join(t.state_dir, common.AUTOFINISH_OVERRIDE))
        except OSError:
            pass
        # the yes at the brief (S7) is used up the same way: left behind it would lift `autofinish: off`
        # and the gates for every later tip of this branch, or a recreated one (landing review, finding 7);
        # a chain relaunch keeps `--by brief` in its own record and needs no brief
        if st.get("by") == "brief" and t.common:
            try:
                os.unlink(os.path.join(t.common, "claude", BRIEFS, urllib.parse.quote(t.branch, safe="") + ".json"))
            except OSError:
                pass
    first = lines[0] if lines else ""
    line = record_line(st["ended"], outcome, t.branch, gate, pr, first, t.tip)
    if gate not in REFUSED_GATES:   # nothing ran: no record for the session start to report
        os.makedirs(os.path.join(t.common, "claude"), exist_ok=True)
        with open(os.path.join(t.common, "claude", RECORD), "a") as f:
            f.write(line + "\n")
    try:   # a run a peer sent here: its end where that Mac reads it
        ticket_end(t, st, line if gate not in REFUSED_GATES else None)
    except OSError:
        traceback.print_exc()
    try:
        fenced = rotation_row(t, st, outcome, gate, pr) if gate not in REFUSED_GATES else None
    except Exception as e:  # noqa: BLE001 — a lost row is said, never a lost record
        fenced = "no rotation row: %s" % type(e).__name__
    extra = [x for x in (said, "dispatch exit %s" % rc if rc not in (0, None) else "", fenced) + tuple(notes) if x]
    log(common.RUN_END % (
        st["ended"], t.repo, t.branch, outcome, " gate=%s" % gate if gate else "",
        " pr=#%s" % pr if pr else "", sid[:8], t.tip[:7], st.get("rule"), st.get("by"), st.get("account") or "-",
        first[:300], "; " + "; ".join(extra) if extra else ""))


def runlog_of(t, st):
    """The dispatch log a run wrote to: named for the day it started (Tree's is today's)."""
    day = str(st.get("started") or "")[:10] or datetime.date.today().isoformat()
    return os.path.join(LOGS, "%s-dispatch-finish-%s.log" % (day, t.topic))


def waiter_alive(state_dir, sid):
    """True while the run's waiter (autofinish-waiter.json, same session) still runs."""
    try:
        with open(os.path.join(state_dir, WAITER)) as f:
            w = json.load(f)
    except (OSError, ValueError):
        return False
    if not isinstance(w, dict) or w.get("session") != sid or not isinstance(w.get("pid"), int):
        return False
    return load_bin("dispatch-rc").running(w["pid"], w.get("start"))


def dead(t, st, now=None, state_dir=None, apply=True):
    """Why this worktree's run died without an outcome, or None: no run, an ended one, or one that
    may still live. Never a guess on the dying side — a waiter still running, a watcher not yet
    recorded, or a dispatch end its waiter is still recording, is no death. `apply` False is read-only
    (bin/autofinish's verdicts and `--dry-run`): a run sent to the peer is judged from this Mac's record
    of it and an answer this process already had, with no ssh, no record written and no lock refreshed
    (third landing review, S3); the armed sweep's bury pass, before the verdicts, asks."""
    if not st or st.get("ended") or not st.get("session") or not st.get("started"):
        return None
    if state_dir and waiter_alive(state_dir, st["session"]):
        return None
    now = time.time() if now is None else now
    if on_peer(st):   # nothing of it runs here: dead once the peer tells its end, or past its time (bury writes it)
        rec = peer_record(st["session"])[1]
        ans = peer_ask(rec, timeout=PEER_ASK_S, apply=apply) if rec else None
        kind = settle(None, st, ans, rec, apply=False) if ans is not None else None
        if kind:
            return "its waiter here is gone, and %s has the run's end (%s)" % (st["host"], kind)
        overdue = peer_overdue(st, rec, ans, now)
        if not overdue and ans is not None and state_dir and apply:
            # the peer says it goes on, and no waiter here refreshes the lock (a caller killed, a reboot):
            # the sweep does, or checkpoint.py frees it at 2 h under a /finish there (second landing review, 5)
            try:
                refresh_lock(state_dir, st["session"])
            except OSError:
                pass
        return overdue
    try:
        started = datetime.datetime.fromisoformat(st["started"]).timestamp()
    except (TypeError, ValueError):
        started = 0
    path, _ = run_record(st["session"])
    if not path:
        if now - started < PRE_START_S:
            return None
        return "no dispatch record %d min after its start" % ((now - started) // 60)
    rc = load_bin("dispatch-rc")
    try:
        rec = rc.load(path)
        age = now - os.path.getmtime(path)
    except (OSError, ValueError):
        return None
    if rec.get("ended"):
        ended = rec["ended"] if isinstance(rec["ended"], (int, float)) else now - age
        if now - ended < PRE_START_S:
            return None
        return "dispatch ended the run %d min ago (%s) and no outcome was recorded" % (
            (now - ended) // 60, rec.get("end_reason") or "no reason")
    if rc.same(rec):
        return None
    w = rec.get("watcher")
    if isinstance(w, int):
        if not rc.watcher_gone(rec):
            return None
    elif age < PRE_START_S:
        return None   # no watcher recorded yet: dispatch may still be starting it
    return "claude (pid %s) and its watcher (pid %s) are gone, and dispatch wrote no end" % (
        rec.get("pid"), w if isinstance(w, int) else "never recorded")


def bury(t, why):
    """Record the dead run as the waiter's `finally` would have: the state, the lock, the PR, the
    record and the log. Under the start lock, the state read again: None when another start or
    an end got there first, else the log line written."""
    held = take_start_lock(t)
    if not held:
        return None
    try:
        st = read_state(t)
        if not st or st.get("ended"):
            return None
        sid, prec = st["session"], None
        if on_peer(st):   # its end is the peer's to tell: written here as the waiter would have
            prec = peer_record(sid)[1]
            ans = peer_ask(prec, timeout=PEER_ASK_S) if prec else None
            kind = settle(t, st, ans, prec) if ans is not None else None
            if kind:
                return "%s run %s %s recorded from %s after its waiter here died — %s, %s" % (
                    now_iso(), t.repo, t.branch, st["host"], kind, st.get("outcome"))
            overdue = peer_overdue(st, prec, ans)
            if not overdue:
                return None
            why = "%s; %s" % (why, overdue) if why and why != overdue else overdue
            # past its time with no word from the peer: died, written as for a run here (below)
        holder = (common.read_owner(t.state_dir) or {}).get("session")
        notes = release(t, sid) if not holder or holder == sid else [
            "the lock is session %s's now: left as it is" % str(holder)[:8]]
        _, rec = run_record(sid)
        if rec and rec.get("ended"):  # the session ended, only its waiter died: its reply is the outcome
            record(t, st, 0, None, None, notes + ["recorded after its waiter died (%s)" % why])
            return "%s run %s %s recorded after its waiter died — %s" % (now_iso(), t.repo, t.branch, why)
        last = tail_lines(runlog_of(t, st), 0, 1)
        lines = last or ["(its dispatch log %s is empty or gone)" % runlog_of(t, st)]
        pr, said = None, ""
        try:
            pr, said = comment(t, st, DIED, None, lines + ["(%s)" % why])
        except Exception as e:  # noqa: BLE001 — GitHub down is no reason to leave the run undead
            said = "no comment: %s" % type(e).__name__
        st.update(ended=now_iso(), outcome=DIED, pr=pr, gate=None)   # ended after the comment: the
        write_state(t, st)                                           # retry's GitHub quiet starts here
        os.makedirs(os.path.join(t.common, "claude"), exist_ok=True)
        died_line = "%s died %s %s %s" % (st["ended"], t.branch, str(st.get("tip"))[:7], lines[0])
        with open(os.path.join(t.common, "claude", RECORD), "a") as f:
            f.write(died_line + "\n")
        try:
            ticket_end(t, st, died_line)
        except OSError:
            traceback.print_exc()
        try:
            fenced = rotation_row(t, st, DIED, None, pr)
        except Exception as e:  # noqa: BLE001 — a lost row is said, never a lost record
            fenced = "no rotation row: %s" % type(e).__name__
        extra = [x for x in [said, why, fenced] + notes if x]
        line = "%s run %s %s died session=%s tip=%s rule=%s by=%s account=%s — %s; %s" % (
            st["ended"], t.repo, t.branch, sid[:8], str(st.get("tip"))[:7], st.get("rule"), st.get("by"),
            st.get("account") or "-", lines[0][:300], "; ".join(extra + (["on %s" % st["host"]] if prec else [])))
        log(line)
        if prec:
            prec.update(ended=st["ended"], outcome=DIED, pr=pr, gate=None)
            save_peer_record(prec)
        return line
    finally:
        try:
            os.remove(held)
        except OSError:
            pass


# ---- where: a run on the peer (the header's Where) ------------------------------------------------

def self_host():
    return (os.environ.get("AUTOFINISH_HOST") or common.host_name() or "").lower()


def on_peer(st):
    """True for a run this Mac sent to its peer: its state names another host."""
    return bool(st and st.get("host") and str(st["host"]).lower() != self_host())


def _pairs(key):
    return [(h.strip().lower(), v.strip()) for h, _, v in (l.partition(":") for l in common.config_lines(key) or [])]


def peer_of():
    """(peer, alias, why): where this Mac's runs go. (None, None, None) for nowhere — no line for this
    Mac, or it is the peer; (peer, None, why) when ssh has no alias for it."""
    me = self_host()
    pin = os.environ.get("AUTOFINISH_ON")
    if pin is not None:   # the tests' pin; empty is no peer
        peer = pin.strip().lower()
    else:
        peer = next((v.lower() for key in PEER_KEYS for h, v in _pairs(key) if h == me and v), "")
    if not peer or peer == me:
        return None, None, None
    alias = next((v for h, v in _pairs(SSH_KEY) if h == peer and v), None)
    return peer, alias, None if alias else "no ssh alias for %s in the config dir's %s" % (peer, SSH_KEY)


def repo_rel(path):
    """The repo's path under the projects folder (the peer has it at the same place under its own), or None."""
    root = os.path.realpath(os.path.join(HOME, "projects")) + os.sep
    p = os.path.realpath(path)
    return p[len(root):] if p.startswith(root) else None


def quiet_git(where, *args, timeout=60):
    """(rc, out, err) of a git call that may reach origin: never a prompt, never a hang."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(["git", "-C", where, *args], capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return 124, "", "no answer in %d s" % timeout
    except OSError as e:
        return 127, "", str(e)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def is_ancestor(where, a, b):
    return subprocess.run(["git", "-C", where, "merge-base", "--is-ancestor", a, b], capture_output=True).returncode == 0


class OutOfTime(Exception):
    """The send's checks would run past the caller's wait (SEND_BUDGET): the run stays here."""


class WarmBusy(Exception):
    """The branch's warm run could not be ended before the send: a refusal, as start_here's is."""


def left(t, want):
    """Seconds a check may take: `want`, or less to keep STAY_RESERVE inside the budget. Raises
    OutOfTime with under 3 s left — a check cut that short would only fail."""
    have = getattr(t, "deadline", time.time() + want + 1000) - time.time() - getattr(t, "reserve", 0)
    if have < 3:
        raise OutOfTime("out of time for the send's checks (%d s budget)" % getattr(t, "budget", 0))
    return min(want, have)


def static_stay(t):
    """What keeps the run here without asking git or the peer (the header's list), or None."""
    if os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"):
        return "the caller's CLAUDE_CODE_OAUTH_TOKEN is a login only this caller holds"
    if not repo_rel(t.primary):
        return "%s is not under the projects folder, where the peer keeps its clones" % t.primary
    return None


def stay_reason(t, dry=False):
    """Why this run's /finish needs this Mac (the header's list), or None — pushing the tip first
    when origin lacks it and is behind it. Each call to origin within the send's budget (left())."""
    why = static_stay(t)
    if why:
        return why
    dirty = [l for l in git(t.path, "status", "--porcelain").splitlines() if l.strip()]
    if dirty:
        return "%d uncommitted file(s) in the worktree: the peer would land the branch without them" % len(dirty)
    rc, out, err = quiet_git(t.path, "ls-remote", "origin", "refs/heads/" + t.branch, timeout=left(t, 20))
    if rc:
        return "origin could not be read: %s" % (err[-160:] or "exit %d" % rc)
    remote = (out.split() or [""])[0]
    if remote == t.tip:
        return None
    if remote and not is_ancestor(t.path, remote, t.tip):
        return "origin's %s is at %s, which this worktree's tip %s does not contain" % (t.branch, remote[:7], t.tip[:7])
    if dry:
        print("would push %s to origin first (origin has %s)" % (t.tip[:7], remote[:7] or "no such branch"))
        return None
    rc, _, err = quiet_git(t.path, "push", "-q", "origin", "%s:refs/heads/%s" % (t.tip, t.branch), timeout=left(t, 45))
    return "its tip is not on origin, and the push failed: %s" % (err[-160:] or "exit %d" % rc) if rc else None


def ssh_run(alias, cmd, stdin=None, timeout=60):
    """(rc, out, err) of cmd on the peer; no connection and no answer in time are both 255. With no
    stdin to send, /dev/null: ssh would read the caller's (a sweep's, a hook's) and hand it over."""
    kw = {"input": stdin} if stdin is not None else {"stdin": subprocess.DEVNULL}
    try:
        r = subprocess.run([SSH, "-o", "ConnectTimeout=%d" % PROBE_S, "-o", "BatchMode=yes", alias, cmd],
                           capture_output=True, text=True, timeout=timeout, **kw)
    except subprocess.TimeoutExpired:
        return 255, "", "no answer in %d s" % timeout
    except OSError as e:
        return 255, "", str(e)
    return r.returncode, r.stdout, r.stderr


def remote_repo(rel):
    return '"$HOME/projects/"%s' % shlex.quote(rel)


def probe_cmd(rel):
    return (REMOTE_BIN + 'grep -q -- peer-start "$rb" 2>/dev/null || { echo "autofinish-run on $(hostname -s) '
            'predates the peer start: pull its regatta main" >&2; exit 3; }; [ -d %s/.git ] || '
            '{ echo "no clone of "%s" on $(hostname -s)" >&2; exit 3; }' % (remote_repo(rel), shlex.quote(rel)))


def sync_cmd(rec):
    return REMOTE_BIN + '"$rb" peer-sync --repo %s --branch %s --session %s' % (
        remote_repo(rec["rel"]), shlex.quote(rec["branch"]), rec["session"])


def ladder_stay(t, args, by):
    """Why the landing ladder keeps this run here, or None. landing() reads this Mac's helm plans
    (bin/autofinish's landing_mode) and the keel's no from this Mac's state; the peer has neither,
    so its job would judge the run afresh and could merge what this Mac holds. A plain landing — no
    hold, no mode, no mode or ship launch — is the one sent (merge of main's skipper-modes S3b and S6,
    2026-10-23); carrying the ladder's verdict to the peer is open (the lander digest of 2026-10-22)."""
    hold, mode, keel_hold = getattr(t, "ladder", (None, None, False, None))[:3]
    if hold or keel_hold:
        return "the landing ladder holds it here (%s): the peer has none of this Mac's plans" % hold
    if mode or by in LAND_BY or by == "ship" or args.rule == "M":
        return "a %s launch is judged by this Mac's plans, which the peer lacks" % (
            "mode %s" % mode if mode else "--by %s" % by if by in LAND_BY + ("ship",) else "rule M")
    # the yes at the brief (main's autofinish-exclude S7) is this Mac's briefs file, read by brief_held
    # here; peer-start takes no `--by brief` (the merge of main, 2026-10-25)
    if by == "brief":
        return "a --by brief launch is this Mac's yes at the brief, which the peer lacks"
    return None


def route(t, args, by=None):
    """(peer, alias) when this run goes to the peer, else None — with a line saying why when a peer
    exists and the run stays here (the header's Where). A warm run of the branch is ended before the
    checks that read the tip, so its last checkpoint goes with the send (landing review, 2026-10-22:
    it was ended after the push and the probe); one that cannot be ended raises WarmBusy. Every check
    keeps inside the send's budget (left()); one that would not stays here, saying so."""
    if args.on == "here":
        return None
    peer, alias, why = peer_of()
    if not peer:
        return None
    why = why or static_stay(t) or ladder_stay(t, args, by or args.by)
    try:
        if not why:
            busy = end_warm(t, args, cap=left(t, 90))
            if busy:
                raise WarmBusy(busy)
            t.warm_ended = True
            tip = git(t.path, "rev-parse", "HEAD")
            if tip and tip != t.tip:
                print("autofinish-run: %s moved to %s as its warm run ended: that tip is the one sent" % (t.branch, tip[:7]))
                t.tip = tip
            why = stay_reason(t, args.dry)
        if not why:
            rc, _, err = ssh_run(alias, probe_cmd(repo_rel(t.primary)), timeout=left(t, PROBE_S + 15))
            if rc == 255:
                why = "%s is unreachable (ssh exit 255%s)" % (peer, ": " + err.strip()[-120:] if err.strip() else "")
            elif rc:
                why = (err.strip().splitlines() or ["the probe of %s failed (exit %d)" % (peer, rc)])[-1]
    except OutOfTime as e:
        why = str(e)
    if why:
        print("autofinish-run: %s stays on this Mac — %s" % (t.branch, why))
        t.stay = why
        return None
    return peer, alias


def peer_record(sid):
    """(path, record) of this Mac's record of a run it sent, or (None, None)."""
    for path in glob.glob(os.path.join(PEER_RUNS, "*.%s.json" % sid[:8])):
        try:
            with open(path) as f:
                rec = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(rec, dict) and rec.get("session") == sid:
            return path, rec
    return None, None


def write_json(path, d):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(d, f, indent=1, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def save_peer_record(rec):
    path = peer_record(rec["session"])[0] or os.path.join(
        PEER_RUNS, "%s-finish-%s.%s.json" % (str(rec["started"])[:10], rec["topic"], rec["session"][:8]))
    write_json(path, rec)


_asked = {}   # sid -> (time, answer): dead() and bury() ask once per sweep, not twice
_down = {}    # alias -> time of its last ssh 255: the sweep's other sent runs on it are not asked for a minute


def peer_ask(rec, fresh=False, timeout=90, apply=True):
    """The peer's peer-sync answer about this run, or None when it cannot be had now. Each real ask is
    kept in this Mac's record of the run (save_peer_record), for peer_overdue: `answered`, the last
    answer; `asked`, the last ask; `silent`, the first ask unanswered since the last answer. A peer this
    pass found unreachable (`_down`) is not asked again, and that counts as an ask unanswered: else the
    run asked second on a down peer kept no `asked`, its silence started again every ASK_GAP_S, and k
    runs sent there took about k × PEER_WAIT_S to bury (third landing review, S3). `apply` False (the
    sweep's verdicts, `--dry-run`): no ssh — peer-sync buries on the peer — and no write; only this
    process's answer of the last minute."""
    hit = _asked.get(rec["session"])
    if hit and not fresh and time.time() - hit[0] < 60:
        return hit[1]
    if not apply:
        return None
    alias = rec.get("alias") or peer_of()[1]
    if not alias:
        return None
    if not fresh and time.time() - _down.get(alias, 0) < 60:
        rc, out = 255, ""   # this pass found the peer unreachable already: the same answer, unasked
    else:
        rc, out, _ = ssh_run(alias, sync_cmd(rec), timeout=timeout)
        if rc == 255:
            _down[alias] = time.time()
    try:
        ans = json.loads(out.strip().splitlines()[-1]) if rc == 0 else None
    except (ValueError, IndexError):
        ans = None
    ans = ans if isinstance(ans, dict) else None
    _asked[rec["session"]] = (time.time(), ans)
    t0 = now_iso()
    if ans is not None:
        rec.update(answered=t0, silent=None)
    elif not rec.get("silent") or age(rec.get("asked")) > ASK_GAP_S:
        rec["silent"] = t0   # the silence starts here: none yet, or this Mac was not asking (asleep)
    rec["asked"] = t0
    try:
        save_peer_record(rec)
    except OSError:
        pass
    return ans


def age(iso, now=None):
    try:
        return (time.time() if now is None else now) - datetime.datetime.fromisoformat(iso).timestamp()
    except (TypeError, ValueError):
        return 0


def peer_gone(st, ans, now=None):
    """True when the peer started the run (its job exited 0) and holds no record of it any more: no state
    in the ticket, and no worktree state in the run's id. Read as "still going" until the second landing
    review (10), which blocked the worktree for good."""
    tk = ans.get("ticket") if isinstance(ans.get("ticket"), dict) else {}
    rs = ans.get("state") if isinstance(ans.get("state"), dict) else {}
    return (tk.get("session") == st["session"] and tk.get("rc") == 0 and rs.get("session") != st["session"]
            and age(tk.get("scheduled"), now) > PRE_START_S)


def peer_overdue(st, rec, ans, now=None):
    """Why a run sent to the peer counts as died with no end from there, or None. Without this, a
    peer that never answers again would block the worktree for good, `--on here` included (landing
    review, 2026-10-22): no record here of the send PRE_START_S after its start (this process was
    killed between the state and the record); the peer asked and silent for PEER_WAIT_S; or the peer
    has no record of a run its job started (peer_gone). The silence is counted from the first ask
    unanswered since the last answer, and starts again when this Mac stopped asking for ASK_GAP_S —
    asleep, or neither waiter nor sweep running: a laptop that wakes offline after a night is not a
    peer silent all night (second landing review, 3: one unanswered poll past 9 h from the start buried
    a run that had answered until then). A peer that answers is believed, a run there still going
    included: its own sweep buries it."""
    started = age(st.get("started"), now)
    if not rec:
        return ("no record here of the send to %s, %d min after its start" % (st["host"], started // 60)
                if started > PRE_START_S else None)
    if ans is not None:
        return ("%s started the run and has no record of it now (no state there, no worktree in its id)"
                % st["host"] if peer_gone(st, ans, now) else None)
    silent = rec.get("silent")
    if silent and age(rec.get("asked"), now) <= ASK_GAP_S and age(silent, now) > PEER_WAIT_S:
        return "no answer from %s for %.1f h of asking (last answer %s)" % (
            st["host"], age(silent, now) / 3600, rec.get("answered") or "none")
    return None


def refresh_lock(state_dir, sid, branch=None):
    """The lock's `seen` set to now while it still names the run: checkpoint.py frees a lock unseen for
    OWNER_TTL (2 h), and a /finish on the peer may run longer, so this Mac's sessions would write under
    it (landing review, 2026-10-22). Another holder's lock is left alone. True when refreshed. The waiter
    calls it each poll, the sweep's dead() while the peer answers (second landing review, 5)."""
    lock = common.read_owner(state_dir)
    if not lock or lock.get("session") != sid:
        return False
    common.write_owner(state_dir, sid, lock.get("branch") or branch, lock.get("handover"))
    return True


def settle(t, st, ans, rec, apply=True):
    """What the peer's answer says of the run sent there: None while it goes on or cannot be told,
    else the kind of end — `ended`, `refused`, `no-account`, `lost` — and, applied, that end written
    here as the run's own would be (the header's Where)."""
    sid = st["session"]
    tk = ans.get("ticket") if isinstance(ans.get("ticket"), dict) else {}
    rs = ans.get("state") if isinstance(ans.get("state"), dict) else {}
    ours = rs.get("session") == sid
    if ours and rs.get("ended"):
        kind = "ended"
    elif tk.get("session") == sid and isinstance(tk.get("rc"), int) and tk["rc"] and not ours:
        kind = "no-account" if tk["rc"] == 4 else "refused"
    elif not ours and tk.get("session") != sid and age(st.get("started")) > PRE_START_S:
        kind, tk = "lost", dict(tk, said="the peer has no ticket for this run: it never got there")
    elif not ours and tk.get("session") == sid and tk.get("rc") is None and not tk.get("began") \
            and age(tk.get("scheduled")) > PRE_START_S:
        # a job that runs wrote `began` first, at most JOB_LATE_S after it was scheduled (main)
        kind, tk = "lost", dict(tk, said="the peer's job never ran (launchd started nothing)")
    elif not ours and tk.get("session") == sid and tk.get("rc") is None and age(tk.get("began")) > PRE_START_S:
        # it began, and wrote neither a state nor its exit: killed before its writes, so nothing ran
        kind, tk = "lost", dict(tk, said="the peer's job began %s and wrote nothing since" % tk.get("began"))
    else:
        return None
    if apply:
        record_peer_end(t, st, kind, rs, tk, ans.get("line"), rec)
    return kind


def record_peer_end(t, st, kind, rs, tk, line, rec):
    """The peer's end, written here: the state, the lock, the record line, the log and this Mac's
    record of the run. Nothing ran there (`lost`, `no-account`, or the job `refused` before any
    session): never-started at refused, so the tip may start again, as the header says — a refused
    job was gate never-started until the landing review (2026-10-22), which blocked the tip for good."""
    sid, peer = st["session"], st["host"]
    if kind == "ended":
        st.update(ended=rs["ended"], outcome=rs.get("outcome"), pr=rs.get("pr"), gate=rs.get("gate"),
                  account=rs.get("account") or st.get("account"))
        # `<iso> <outcome> <branch> <detail>`: the detail is what the log quotes
        first = (line or "").split(" ", 3)[3] if line and len(line.split(" ", 3)) == 4 else ""
        if not line:   # the state came from the peer's worktree (no ticket line): the line as record() writes it
            first = first or "its end on %s came without its line" % peer
            line = record_line(st["ended"], st["outcome"], t.branch, st.get("gate"), st.get("pr"), first, st.get("tip"))
    else:
        said = tk.get("said") or "exit %s" % tk.get("rc")
        first = "%s on %s: %s" % ({"refused": "refused", "no-account": "no account may run it"}.get(kind, "lost"), peer, said)
        st.update(ended=now_iso(), outcome="never-started", pr=None, gate=REFUSED)
        line = "%s never-started %s %s" % (st["ended"], t.branch, first)
    write_state(t, st)
    notes = release(t, sid)
    if st["gate"] not in REFUSED_GATES:
        try:
            os.unlink(os.path.join(t.state_dir, common.AUTOFINISH_OVERRIDE))
        except OSError:
            pass
        os.makedirs(os.path.join(t.common, "claude"), exist_ok=True)
        with open(os.path.join(t.common, "claude", RECORD), "a") as f:
            f.write(line.rstrip("\n") + "\n")
    log(common.RUN_END % (
        st["ended"], t.repo, t.branch, st["outcome"], " gate=%s" % st["gate"] if st.get("gate") else "",
        " pr=#%s" % st["pr"] if st.get("pr") else "", sid[:8], str(st.get("tip"))[:7], st.get("rule"), st.get("by"),
        st.get("account") or "-", first[:300], "; " + "; ".join(["on %s" % peer] + notes)))
    if rec:
        rec.update(ended=st["ended"], outcome=st["outcome"], pr=st.get("pr"), gate=st.get("gate"),
                   account=st.get("account"))
        save_peer_record(rec)


def adopt(t, prev, rec, ans):
    """peer-start refused the send because a run of the peer's own holds this tip — its answer's `ran`
    (that run's contract) and `line` (its autofinished line): that run is written here as this Mac's,
    so the next sweep meets the same-tip refusal here instead of sending again (second landing review,
    2: the refusal was given back as `refused`, which bin/autofinish's restartable() re-sends every pass,
    and this Mac never learned that run's end). Ended there: its end written as record_peer_end writes
    one — or, when this Mac had that end already (a chain relaunch the peer refused), its state put
    back. Going there: the state and the lock in its id, a record of it, and a waiter, as for a send.
    Called after give_back, under the start lock. Returns what was done, or None for no run on this tip."""
    ran, line = ans["ran"], ans.get("line")
    rsid, peer = str(ran.get("session") or ""), rec["host"]
    if not SID_RE.match(rsid) or ran.get("tip") != t.tip:
        return None
    if prev and prev.get("session") == rsid and prev.get("ended") and prev.get("outcome") == ran.get("outcome"):
        write_state(t, prev)
        return "this Mac had that run's end already (%s, %s)" % (rsid[:8], prev.get("outcome"))
    st = dict(contract(ran), host=peer, ended=None, outcome=None, pr=None, gate=None)
    st.pop("from", None)   # this Mac's record of a run on the peer: `host`, as for a send
    rec2 = dict(peer_record(rsid)[1] or rec, session=rsid, started=ran.get("started") or rec["started"],
                tip=t.tip, ended=None, outcome=None, pr=None, gate=None, answered=now_iso(), silent=None)
    if ran.get("ended"):
        record_peer_end(t, st, "ended", ran, {}, line, rec2)
        return "its run %s on this tip ended there %s, %s: recorded here" % (rsid[:8], ran.get("ended"), st.get("outcome"))
    write_state(t, st)
    common.write_owner(t.state_dir, rsid, t.branch)
    save_peer_record(rec2)
    log("%s run %s %s adopted session=%s tip=%s — its run on %s goes on there" % (
        now_iso(), t.repo, t.branch, rsid[:8], t.tip[:7], peer))
    try:
        detach(lambda: wait_on_peer(t, st, rec2, None), t.runlog)
    except OSError as e:
        return "its run %s on this tip goes on there; no waiter here (%s): the sweep settles it" % (rsid[:8], e)
    return "its run %s on this tip goes on there: this Mac waits on it" % rsid[:8]


def wait_on_peer(t, st, rec, again):
    """The detached waiter of a run sent to the peer: ask until the peer has its end, then write it
    here; `again`, the command that starts it here when the peer had no account for it."""
    def term(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    sid = st["session"]
    try:
        rc_mod = load_bin("dispatch-rc")
        with open(os.path.join(t.state_dir, WAITER), "w") as f:
            json.dump({"session": sid, "pid": os.getpid(), "start": rc_mod.proc_start(os.getpid())}, f)
    except Exception:
        traceback.print_exc()
    # past twice PEER_WAIT_S with the peer still saying the run goes on (dispatch ends one at 8 h there), the
    # waiter leaves it to the sweep's dead(), which goes on believing an answering peer and refreshing the lock
    cap, kind, quiet = time.time() + 2 * PEER_WAIT_S, None, 0
    try:
        while True:
            try:
                refresh_lock(t.state_dir, sid, t.branch)
            except OSError:
                traceback.print_exc()
            ans = peer_ask(rec, fresh=True)
            if ans is None:
                quiet += 1
                if quiet in (1, 10, 60):   # said, not every minute: a laptop on the move drops often
                    print("%s %s did not answer (try %d): asked again in %d s" % (now_iso(), st["host"], quiet, PEER_POLL), flush=True)
            else:
                quiet = 0
                cur = read_state(t) or {}
                if cur.get("session") != sid or cur.get("ended"):
                    print("%s the state is another's or ended here already: nothing to write" % now_iso(), flush=True)
                    return
                kind = settle(t, st, ans, rec)
                if kind:
                    break
            overdue = peer_overdue(st, rec, ans)
            if overdue:   # silent for PEER_WAIT_S of asking, or the peer lost the run: bury() writes `died`
                said = bury(t, overdue)
                print("%s no end from %s: %s — %s" % (now_iso(), st["host"], overdue,
                                                     said or "the sweep settles it from there"), flush=True)
                return
            if time.time() > cap:
                print("%s %s still says the run goes on after %.1f h: the sweep settles it from there" % (
                    now_iso(), st["host"], 2 * PEER_WAIT_S / 3600), flush=True)
                return
            time.sleep(PEER_POLL)
    except SystemExit as e:
        print("%s the waiter ended (signal %s): the sweep settles the run from %s" % (now_iso(), e.code, st["host"]), flush=True)
        return
    print("%s the run on %s: %s — %s" % (now_iso(), st["host"], kind, st.get("outcome")), flush=True)
    if kind == "no-account" and again:
        print("%s no account may run it on %s: starting it here — %s" % (now_iso(), st["host"], " ".join(again)), flush=True)
        r = subprocess.run(again, capture_output=True, text=True)
        print((r.stdout + r.stderr).strip(), flush=True)


def start_on_peer(t, args, prev, by, via, peer, alias):
    """Send the run to the peer (the header's Where): this Mac's state and lock in the run's id, the
    bundle on stdin, peer-start's answer, then the waiter. Under the start lock main() holds."""
    rel = repo_rel(t.primary)
    sid = str(uuid.uuid4())
    st = {"started": now_iso(), "session": sid, "tip": t.tip, "by": by, "rule": args.rule,
          "window": t.window, "account": None, "ended": None, "outcome": None, "pr": None, "gate": None,
          "merge": args.merge, "host": peer}
    # D2-A: this Mac's approval travels with the run (`--from=<this host>` in the peer's prompt, which
    # /finish step 11.4 honours there). Only a plain landing is sent (ladder_stay): no mode launch
    # (yolo, dnd, ship) and no hold reaches here, so there is no other approval to carry
    sent_from = self_host()
    cmd = REMOTE_BIN + '"$rb" peer-start --repo %s --branch %s --tip %s --run-session %s --rule %s --by %s%s%s%s' % (
        remote_repo(rel), shlex.quote(t.branch), t.tip, sid, args.rule, by, " --merge" if args.merge else "",
        " --from %s" % shlex.quote(sent_from) if sent_from else "",
        # landing() there reads it as here (unattended_caller): ssh carries no CLAUDE_UNATTENDED
        " --unattended-caller" if unattended_caller() else "")
    text = bundle_text(t)
    if args.dry:
        print("autofinish-run --dry: %s in %s, tip %s, rule %s, by %s%s — on %s" % (
            t.branch, t.path, t.tip[:7], args.rule, by, via, peer))
        print("would write %s:" % os.path.join(t.state_dir, STATE))
        print("  " + json.dumps(contract(st), ensure_ascii=False))
        print("would write %s: session %s" % (os.path.join(t.state_dir, common.OWNER_FILE), sid))
        print("would send the bundle (%d characters) to %s and run there:" % (len(text), peer))
        print("  " + " ".join(shlex.quote(c) for c in (SSH, alias, cmd)))
        return 0
    try:
        with open(os.path.join(t.state_dir, common.OWNER_FILE)) as f:
            before = f.read()
    except OSError:
        before = None
    write_state(t, st)
    common.write_owner(t.state_dir, sid, t.branch)
    if args.by == "chain":
        count_chain(t, prev, sid)
    log("%s run %s %s started session=%s tip=%s rule=%s by=%s%s account=- window=\"%s\" — on %s" % (
        st["started"], t.repo, t.branch, sid[:8], t.tip[:7], args.rule, by, via + (" merge=yes" if args.merge else ""),
        t.window, peer))
    rec = {"host": peer, "alias": alias, "repo": t.primary, "rel": rel, "branch": t.branch, "topic": t.topic,
           "session": sid, "started": st["started"], "tip": t.tip, "worktree": t.path, "peer_worktree": None,
           "label": None, "ended": None, "outcome": None, "pr": None, "gate": None, "account": None}
    save_peer_record(rec)
    # within what is left of the caller's wait less STAY_RESERVE, which a run the peer cannot take
    # still needs here (second landing review, 11), never under SSH_FLOOR: the state is written, so a
    # caller that kills this process leaves a run dead() settles from the peer
    wait = max(SSH_FLOOR, min(120, getattr(t, "deadline", time.time() + 120) - time.time() - getattr(t, "reserve", 0)))
    rc, out, err = ssh_run(alias, cmd, stdin=text, timeout=wait)
    said = (err.strip().splitlines() or ["exit %d" % rc])[-1]
    if rc not in (0, 2, 3, 4, 255):   # peer-start's traceback, a shell's 127: it scheduled nothing
        said = "%s (exit %d)" % (said, rc)
    # Only 255 (ssh's own: the connection, or no answer in time) may hide a start there. Any other
    # answer came from peer-start, which schedules last: nothing is going there (landing review,
    # 2026-10-22 — a traceback read as "maybe sent" was written off as lost and re-sent every sweep)
    if rc not in (0, 255):   # nothing scheduled there: this Mac's state given back as it was
        give_back(t, sid, before, st)
        rec.update(ended=st["ended"], outcome=st["outcome"], gate=st["gate"])
        save_peer_record(rec)
        log("%s run %s %s refused tip=%s rule=%s by=%s — %s answered: %s" % (
            now_iso(), t.repo, t.branch, t.tip[:7], args.rule, by, peer, said))
        if rc == 3:
            try:
                ran = json.loads(out.strip().splitlines()[-1]) if out.strip() else {}
            except ValueError:
                ran = {}
            adopted = adopt(t, prev, rec, ran) if isinstance(ran, dict) and isinstance(ran.get("ran"), dict) else None
            print("autofinish-run: not starting %s — refused on %s: %s%s" % (
                t.branch, peer, said, "; " + adopted if adopted else ""), file=sys.stderr)
            return 3
        if time.time() > getattr(t, "deadline", time.time()) - getattr(t, "reserve", 0):
            t.pick_cached = True   # SSH_FLOOR ate into the reserve: the pick here reads the cache
        t.stay = "%s cannot take it: %s" % (peer, said)
        print("autofinish-run: %s stays on this Mac — %s" % (t.branch, t.stay))
        return start_here(t, args, read_state(t), by, via)
    if rc == 0:
        try:
            got = json.loads(out.strip().splitlines()[-1])
        except (ValueError, IndexError):
            got = {}
        rec.update(peer_worktree=got.get("worktree"), label=got.get("label"), answered=now_iso())
        save_peer_record(rec)
        head = "started on %s: %s in %s" % (peer, finish_prompt(t.branch, by, args.merge, sent_from=sent_from), rec["peer_worktree"] or "?")
    else:   # 255 once the probe passed: the answer was lost on the way, it may be going there — never here too
        head = ("sent to %s, its answer lost (ssh exit %d: %s): the run may be going there; the waiter "
                "settles it, and it is not started here as well" % (peer, rc, said))
    again = None
    if by != "chain":   # the chain's tick relaunches by itself
        again = [os.path.join(HERE, "autofinish-run"), t.path, "--on", "here", "--rule", args.rule, "--by", by] + (
            ["--merge"] if args.merge else [])
    try:
        detach(lambda: wait_on_peer(t, st, rec, again), t.runlog)
    except OSError as e:
        head += "; no waiter here (%s): the sweep settles it from %s" % (e, peer)
    print("%s — session %s, window and Remote Control \"%s\" there; state %s; log %s" % (
        head, sid, t.window, os.path.join(t.state_dir, STATE), t.runlog))
    return 0


# the peer's half -----------------------------------------------------------------------------------

def tickets_dir(common_dir):
    """Tickets live in the common git dir: a launched branch's worktree may be gone before the
    sending Mac asks for its end."""
    return os.path.join(common_dir, "claude", "autofinish-peer")


def read_json(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def update_json(path, fn):
    """fn(the JSON at path, or None) written back unless it returns None, under an flock on `<path>.lock`:
    a ticket is written by the job's exit, by its waiter's end and by peer-start, and the job's exit
    read it before the waiter's end and wrote after, losing the end (second landing review, 12)."""
    import fcntl
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        d = fn(read_json(path))
        if d is not None:
            write_json(path, d)
        return d


def ticket_end(t, st, line):
    """The run's end into its ticket, when the run is one a peer sent here."""
    path = os.path.join(tickets_dir(t.common), "%s.json" % st.get("session"))
    if os.path.exists(path):
        update_json(path, lambda tk: dict(tk, state=contract(st), line=line) if tk is not None else None)


def worktree_of(repo, branch):
    path = None
    for line in git(repo, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line == "branch refs/heads/" + branch:
            return path
    return None


def peer_worktree(repo, branch, tip):
    """(path, 0, None) of the branch's worktree here at `tip` — found, else created from origin as
    `pickup open` does, fast-forwarded when behind — or (None, code, why): 3 refused, 4 cannot."""
    m = NAME_RE.match(branch)
    if not m:
        return None, 2, "%s is not a claude/<host>/<date>-<topic> branch" % branch
    rc, _, err = quiet_git(repo, "fetch", "-q", "origin", "+refs/heads/%s:refs/remotes/origin/%s" % (branch, branch), timeout=60)
    if rc:
        return None, 4, "fetching origin's %s failed here: %s" % (branch, err[-160:] or "exit %d" % rc)
    otip = git(repo, "rev-parse", "refs/remotes/origin/" + branch)
    if otip != tip:
        return None, 4, "origin's %s is at %s here, not %s" % (branch, otip[:7] or "nothing", tip[:7])
    wt = worktree_of(repo, branch)
    if wt and os.path.realpath(wt) == os.path.realpath(repo):
        return None, 4, "%s is checked out in the primary checkout here" % branch
    if wt and not os.path.isdir(wt):
        git(repo, "worktree", "prune")   # forget the vanished folder, or `add` refuses the branch
        wt = None
    if not wt:
        want = base = os.path.join(repo, ".claude", "worktrees", m.group("topic"))
        n = 2
        while os.path.exists(want):
            want, n = "%s-%d" % (base, n), n + 1
        local = git(repo, "rev-parse", "--verify", "--quiet", "refs/heads/" + branch)
        add = [want, branch] if local else ["--track", "-b", branch, want, "refs/remotes/origin/" + branch]
        rc, _, err = quiet_git(repo, "worktree", "add", "-q", *add, timeout=120)
        if rc or git(want, "symbolic-ref", "--short", "HEAD") != branch:
            return None, 4, "git worktree add failed here: %s" % (err[-160:] or "exit %d" % rc)
        env = os.path.join(repo, ".env")
        if os.path.lexists(env) and not os.path.lexists(os.path.join(want, ".env")):
            os.symlink(env, os.path.join(want, ".env"))
        wt = want
    if [l for l in git(wt, "status", "--porcelain").splitlines() if l.strip()]:
        return None, 4, "its worktree here (%s) has uncommitted changes" % wt
    head = git(wt, "rev-parse", "HEAD")
    if head != tip:
        if not is_ancestor(wt, head, tip):
            return None, 4, "its worktree here is at %s, apart from origin's %s" % (head[:7], tip[:7])
        here = Tree(wt)
        why = lock_refusal(here, None, False)
        if why:
            return None, 3, why
        # An unended run here keeps its tree: judged before the fast-forward, not after it as
        # peer_start's refusal() is (fourth landing review, CR 4). A dead one is buried, as there.
        prev = read_state(here)
        if prev and not prev.get("ended"):
            died = dead(here, prev, state_dir=here.state_dir)
            if not (died and bury(here, died)):
                return None, 3, "a run here on %s has not ended: its tree is not moved under it" % (prev.get("tip") or "?")[:7]
        rc, _, err = quiet_git(wt, "merge", "-q", "--ff-only", tip)
        if rc:
            return None, 4, "fast-forwarding its worktree here failed: %s" % (err[-160:] or "exit %d" % rc)
    return wt, 0, None


def job_bin():
    """The script a launchd job names: the overlay's shim where one is installed, else this module in
    its main checkout (AGENTS.md: never a worktree's copy) — dispatch's jobbin."""
    old = common.legacy_root()
    if old and os.path.isfile(os.path.join(str(old), "bin", "autofinish-run")):
        return os.path.join(str(old), "bin", "autofinish-run")
    return os.path.join(HERE, "autofinish-run")


def job_path():
    """The job's PATH: launchd gives a LaunchAgent only /usr/bin:/bin:/usr/sbin:/sbin, so `gh` from
    Homebrew was not found and no stop comment reached the PR (landing review, 2026-10-22). dispatch's
    jobs prepend the same three (its `export PATH=`); the ssh session's own PATH follows, deduplicated."""
    seen, out = set(), []
    for d in [os.path.join(HOME, ".local", "bin"), "/opt/homebrew/bin", "/usr/local/bin"] + (
            os.environ.get("PATH") or "").split(os.pathsep) + ["/usr/bin", "/bin", "/usr/sbin", "/sbin"]:
        if d and d not in seen:
            seen.add(d)
            out.append(d)
    return os.pathsep.join(out)


def launchctl(*args):
    try:
        return subprocess.run([LAUNCHCTL, *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess([], 1, "", str(e))


def peer_start(argv):
    """`peer-start`: over ssh from the sending Mac. Finds or creates the branch's worktree at the
    tip it names, keeps the shipped bundle, and schedules the start as a one-shot LaunchAgent in the
    GUI domain (the keychain, the header's Where). Prints {"worktree", "label", "host"}."""
    import plistlib
    ap = argparse.ArgumentParser(prog="autofinish-run peer-start")
    ap.add_argument("--repo", required=True)
    ap.add_argument("--branch", required=True)
    ap.add_argument("--tip", required=True)
    ap.add_argument("--run-session", required=True)
    ap.add_argument("--rule", choices="ABCDEL", default="C")
    ap.add_argument("--by", choices=("sweep", "override", "typed", "yolo", "chain"), default="override")
    ap.add_argument("--merge", action="store_true")
    ap.add_argument("--from", dest="sent_from", metavar="HOST")   # D2-A: the sending Mac, whose approval the run carries
    ap.add_argument("--unattended-caller", action="store_true")   # the sender's caller had CLAUDE_UNATTENDED
    args = ap.parse_args(argv)
    # Both markers from_refusal and run_main refuse: the job's env holds neither, so a skipper calling
    # peer-start itself would pass them on unseen (fourth landing review, CR 1)
    unattended = any(os.environ.get(n) for n in ("CLAUDE_UNATTENDED", "SKIPPER_SCOPE"))
    if args.sent_from and (not HOST_RE.match(args.sent_from) or unattended):
        # ssh carries no CLAUDE_UNATTENDED; a run on this Mac calling peer-start itself does
        print("autofinish-run peer-start: --from takes a host name, and never from an unattended caller", file=sys.stderr)
        return 2
    # The job's env holds only AUTOFINISH_JOB and PATH, so run_main's refusal never sees the caller:
    # refuse here, before anything is written (AGENTS.md trap: a person's-yes flag).
    if args.merge and (args.by not in MERGE_BY or unattended):
        print("autofinish-run peer-start: --merge needs a person's yes (--by %s, not an unattended caller)"
              % " or ".join(MERGE_BY), file=sys.stderr)
        return 2
    if not SID_RE.match(args.run_session):
        print("autofinish-run peer-start: --run-session takes a session uuid", file=sys.stderr)
        return 2
    repo = os.path.abspath(os.path.expanduser(args.repo))
    wt, code, why = peer_worktree(repo, args.branch, args.tip)
    if why:
        print("autofinish-run peer-start: %s" % why, file=sys.stderr)
        return code
    t = Tree(wt)
    bad = t.problem()
    if bad:
        print("autofinish-run peer-start: %s: %s" % (wt, bad), file=sys.stderr)
        return 4
    # What the job would refuse, refused now (exit 3): the sending Mac hears it at once and gives its
    # state back, where a refusal in the job is only read a poll later (landing review, 2026-10-22).
    # A run here that died is buried first, as peer-sync would: else its tip read as one still going
    prev = read_state(t)
    if prev and not prev.get("ended"):
        died = dead(t, prev, state_dir=t.state_dir)
        if died and bury(t, died):
            prev = read_state(t)
    why = refusal(t, prev, args.by, sent=True) or lock_refusal(t, None, args.by == "typed")
    if why:
        print("autofinish-run peer-start: %s" % why, file=sys.stderr)
        # a run of this Mac's own on that tip: its contract and line, so the sending Mac records it
        # rather than give its state back and send again every sweep (second landing review, 2)
        if prev and prev.get("tip") == t.tip and prev.get("session") and prev.get("gate") not in REFUSED_GATES \
                and prev.get("outcome") != DIED:
            tk = read_json(os.path.join(tickets_dir(t.common), "%s.json" % prev["session"])) or {}
            print(json.dumps({"ran": contract(prev), "line": tk.get("line"), "host": self_host()}, ensure_ascii=False))
        return 3
    os.makedirs(t.state_dir, exist_ok=True)
    shipped = os.path.join(t.state_dir, SHIPPED)
    with open(shipped, "w") as f:
        f.write(sys.stdin.read())
    tdir = tickets_dir(t.common)
    uid = os.getuid()
    # a job stays loaded once its one run is done (its plist file gone): booted out at the next send,
    # once its run has ended — never one still running, whose waiter it would take down. One that never
    # ran past PRE_START_S, the sending Mac has written off as lost: booted out and its plist removed,
    # or the next login would start it with that old session id (landing review, 2026-10-22)
    for old in glob.glob(os.path.join(tdir, "*.json")):
        tk = read_json(old) or {}
        if not tk.get("label") or tk.get("booted"):
            continue
        never = tk.get("rc") is None and not tk.get("began") and not tk.get("state") and age(tk.get("scheduled")) > PRE_START_S
        if (tk.get("state") or {}).get("ended") or tk.get("rc") or never:
            launchctl("bootout", "gui/%d/%s" % (uid, tk["label"]))
            if never:
                try:
                    os.remove(os.path.join(HOME, "Library", "LaunchAgents", tk["label"] + ".plist"))
                except OSError:
                    pass
            update_json(old, lambda d: dict(d, booted=True) if d is not None else None)
    label = "%s.%s.%s" % (JOB_PREFIX, re.sub(r"[^A-Za-z0-9-]", "-", t.repo), args.run_session[:8])
    ticket = os.path.join(tdir, "%s.json" % args.run_session)
    write_json(ticket, {"session": args.run_session, "scheduled": now_iso(), "rc": None, "said": None,
                        "label": label, "branch": t.branch, "worktree": t.path})
    prog = [job_bin(), t.path, "--on", "here", "--run-session", args.run_session, "--bundle", shipped,
            "--ticket", ticket, "--rule", args.rule, "--by", args.by] + (["--merge"] if args.merge else []) + (
            ["--from", args.sent_from] if args.sent_from else [])
    try:   # dispatch's launcher (TCC: one identity), when this Mac's sitting is done
        r = subprocess.run([RCHOSTS, "--launcher", prog[0]], capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            prog = [r.stdout.strip()] + prog
    except (OSError, subprocess.TimeoutExpired):
        pass
    plist = os.path.join(HOME, "Library", "LaunchAgents", label + ".plist")
    os.makedirs(os.path.dirname(plist), exist_ok=True)
    os.makedirs(os.path.dirname(t.runlog), exist_ok=True)
    with open(plist, "wb") as f:
        env = {"AUTOFINISH_JOB": plist, "PATH": job_path()}
        if args.unattended_caller:
            env["AUTOFINISH_CALLER_UNATTENDED"] = "1"   # landing() holds as it would on the sending Mac
        plistlib.dump({"Label": label, "ProgramArguments": prog, "RunAtLoad": True, "AbandonProcessGroup": True,
                       "EnvironmentVariables": env,
                       "StandardOutPath": t.runlog, "StandardErrorPath": t.runlog}, f)
    launchctl("bootout", "gui/%d/%s" % (uid, label))
    r = launchctl("bootstrap", "gui/%d" % uid, plist)
    if r.returncode:   # bootout returns before the old job is gone (dispatch's retry)
        time.sleep(2)
        r = launchctl("bootstrap", "gui/%d" % uid, plist)
    if r.returncode:
        try:
            os.remove(plist)
        except OSError:
            pass
        update_json(ticket, lambda d: dict(d or {}, rc=4, said="launchctl bootstrap failed"))
        print("autofinish-run peer-start: launchctl bootstrap failed here: %s" % (r.stderr.strip()[-160:] or r.returncode),
              file=sys.stderr)
        return 4
    print(json.dumps({"worktree": t.path, "label": label, "host": self_host()}))
    return 0


def peer_sync(argv):
    """`peer-sync`: over ssh from the sending Mac. What this Mac knows of the run: its ticket, its
    state (a dead one buried first, as the sweep here would) and its `autofinished` line, as JSON."""
    ap = argparse.ArgumentParser(prog="autofinish-run peer-sync")
    ap.add_argument("--repo", required=True)
    ap.add_argument("--branch", required=True)
    ap.add_argument("--session", required=True)
    args = ap.parse_args(argv)
    repo = os.path.abspath(os.path.expanduser(args.repo))
    cdir = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    out = {"host": self_host(), "ticket": None, "state": None, "line": None}
    tk = read_json(os.path.join(tickets_dir(cdir), "%s.json" % args.session)) if cdir else None
    out["ticket"] = tk
    if tk and isinstance(tk.get("state"), dict):
        out["state"], out["line"] = tk["state"], tk.get("line")
    else:
        wt = worktree_of(repo, args.branch) if cdir else None
        if wt and os.path.isdir(wt):
            t = Tree(wt)
            st = read_state(t)
            if st and st.get("session") == args.session and not st.get("ended"):
                why = dead(t, st, state_dir=t.state_dir)
                if why:
                    bury(t, why)
                    st = read_state(t)
                    tk = read_json(os.path.join(tickets_dir(cdir), "%s.json" % args.session)) or tk
                    out["ticket"], out["line"] = tk, (tk or {}).get("line")
            out["state"] = st
    print(json.dumps(out, ensure_ascii=False))
    return 0


def detach(fn, out_path):
    """fn() in a grandchild in its own session, its output appended to out_path; returns at once.
    Raises when no grandchild was made: the fork failed, or the child could not setsid or fork."""
    sys.stdout.flush()
    sys.stderr.flush()
    pid = os.fork()
    if pid:
        _, status = os.waitpid(pid, 0)
        if not os.WIFEXITED(status) or os.WEXITSTATUS(status):
            raise OSError("the detaching child ended with status %d" % status)
        return
    try:
        os.setsid()
        if os.fork():
            os._exit(0)
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        fd = os.open(out_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(fd, 1)
        os.dup2(fd, 2)
        fn()
        code = 0
    except BaseException:
        traceback.print_exc()
        code = 1
    finally:
        sys.stdout.flush()
        sys.stderr.flush()
    os._exit(code)


class Tee(io.TextIOBase):
    """stderr kept as it goes, for the ticket: what a refusal said reaches the sending Mac."""

    def __init__(self, real):
        self.real, self.kept = real, io.StringIO()

    def write(self, s):
        self.kept.write(s)
        return self.real.write(s)

    def flush(self):
        self.real.flush()


def lease_refusal(dry):
    """None, or the line the ship's lease refuses this caller with (the header's "A ship's lease"). The
    ship is the caller's DISPATCH_SHIP: a launch acting for a leased ship is the skipper's, the yard's
    or the owner's, never a former holder's. leaselib is helm's, found through the core's tool() beside
    helmlib; absent, the launch goes on as it did before S4."""
    ship = next((os.environ[n] for n in ("DISPATCH_SHIP", "DISPATCH_PLAN") if os.environ.get(n)), None)
    if not ship:
        return None
    lib = common.tool("leaselib.py")
    if not lib:
        return None
    if str(lib.parent) not in sys.path:
        sys.path.append(str(lib.parent))   # appended: helm's bin/ never shadows this module's own
    try:
        import leaselib
    except Exception as e:  # a helm that will not load is a line, never the launch's crash
        print("autofinish-run: the lease of ship %s not checked — helm's leaselib does not load (%s)" % (ship, e), file=sys.stderr)
        return None
    return leaselib.fence(ship, "autofinish-run", record=not dry)


# who may type `--by ship` (S6, the header's "A ship's launch"): the yard's tick, never a session. Each
# name marks a caller that is not it — a session, a dispatched run, a skipper, a ship's block
SHIP_NOT_TICK = ("CLAUDE_CODE_SESSION_ID", "CLAUDE_UNATTENDED", "SKIPPER_SCOPE", "DISPATCH_SHIP", "DISPATCH_PLAN")


def ship_caller_refusal(environ=None):
    """None when the caller may carry the keel's yes (`--by ship`), else why not: the flag stands for a
    person's yes, so an unattended caller is refused it (AGENTS.md's trap), and the tick under launchd
    is the one caller with none of these set."""
    env = os.environ if environ is None else environ
    for n in SHIP_NOT_TICK:
        if env.get(n):
            return "--by ship is the yard's tick's, and this caller is not it (%s=%s)" % (n, str(env[n])[:40])
    depth = (env.get("DISPATCH_DEPTH") or "0").strip()
    if depth != "0":
        return "--by ship is the yard's tick's, and this caller is a dispatched run (DISPATCH_DEPTH=%s)" % depth[:10]
    return None


def _helm_and_blueprints():
    """(helmlib, blueprintlib) — helm's, found as lease_refusal finds leaselib, and this module's own —
    or raises ImportError naming what is missing."""
    lib = common.tool("helmlib.py")
    if not lib:
        raise ImportError("helm's helmlib.py is not installed")
    if str(lib.parent) not in sys.path:
        sys.path.append(str(lib.parent))
    if HERE not in sys.path:
        sys.path.insert(0, HERE)
    import helmlib
    import blueprintlib
    return helmlib, blueprintlib


def same_repo(path, key):
    """True when PATH (a checkout, a task's repo) is the repo registry KEY names: the keys equal, or, for a
    repo outside the projects folder (a key that is its own absolute path), the same folder resolved."""
    mine = common.repo_key(path)
    if not mine or not key:
        return False
    if mine == key:
        return True
    return mine.startswith("/") and key.startswith("/") and os.path.realpath(mine) == os.path.realpath(key)


def ship_refusal(t, digest):
    """None when DIGEST pins one un-ended ship on this Mac whose keel said merge and whose blocks own
    T's branch, else why the keel's yes cannot be read (the header's "A ship's launch")."""
    if not digest or not re.match(r"^[0-9a-f]{64}$", digest):
        return "--by ship needs --digest D, the ship's pinned digest (64 hex)"
    try:
        helmlib, blueprintlib = _helm_and_blueprints()
    except Exception as e:  # noqa: BLE001 — what cannot be read is no yes
        return "--by ship: the keel's yes cannot be read (%s)" % e
    hits = []
    for pid in helmlib.list_plans():
        p = helmlib.load_plan(pid) or {}
        for name, rec in sorted((p.get("blueprints") or {}).items()):
            pin = rec.get("pin") if isinstance(rec, dict) else None
            if isinstance(pin, dict) and pin.get("digest") == digest and not rec.get("ended"):
                hits.append((pid, name, rec, p))
    if not hits:
        return "--by ship: no un-ended ship on this Mac is pinned at %s" % digest[:12]
    if len(hits) > 1:
        return "--by ship: %d ships are pinned at %s (%s) — which keel said yes cannot be told" % (
            len(hits), digest[:12], ", ".join("%s/%s" % (h[0], h[1]) for h in hits))
    pid, name, rec, plan = hits[0]
    where = "ship %s of plan %s" % (name, pid)
    try:
        bp = blueprintlib.load(rec.get("file") or "", key=rec["pin"].get("repo"), accepted=(digest,))
    except Exception as e:  # noqa: BLE001 — BlueprintError, OSError: the pinned text is the yes
        return "--by ship: %s's pinned copy does not read (%s)" % (where, str(e)[:160] or type(e).__name__)
    if blueprintlib.digest(bp) != digest:
        return "--by ship: %s's pinned copy %s is not at %s" % (where, rec.get("file"), digest[:12])
    if blueprintlib.merge_of(bp["meta"]) == "no":
        return "--by ship: %s's blueprint says merge: no at %s" % (where, digest[:12])
    mode = (rec.get("laid_by") or {}).get("mode") if isinstance(rec.get("laid_by"), dict) else None
    if mode != "attended":
        return "--by ship: %s was laid %s, and only an attended lay is a person's yes" % (where, mode or "by nobody recorded")
    keel = rec.get("merge") if isinstance(rec.get("merge"), dict) else {}
    if keel.get("value") == "no":
        return "--by ship: %s's keel said no (merge no: %s)" % (where, keel.get("why"))
    if not same_repo(t.primary, rec["pin"].get("repo")):
        return "--by ship: %s is not in %s's repo %s" % (t.path, where, rec["pin"].get("repo"))
    here = helmlib.host()
    tasks = plan.get("tasks") or {}
    mine = {blueprintlib.branch_of(bp, st, here) for st in bp["blocks"]}
    mine |= {x.get("seeded_branch") for k, x in tasks.items() if isinstance(x, dict) and x.get("ship") == name
             and (not x.get("repo") or same_repo(x["repo"], rec["pin"].get("repo")))}
    if t.branch not in mine - {None}:
        return "--by ship: %s is no block branch of %s" % (t.branch, where)
    return None


def main(argv):
    if argv[:1] == ["notify"]:
        return notify(argv[1:])
    if argv[:1] == ["peer-start"]:
        return peer_start(argv[1:])
    if argv[:1] == ["peer-sync"]:
        return peer_sync(argv[1:])
    if argv[:1] == ["rotation"]:
        return rotation(argv[1:])
    ap = argparse.ArgumentParser(prog="autofinish-run", description=__doc__.split("\n\n")[0])
    ap.add_argument("worktree")
    ap.add_argument("--rule", choices="ABCDELM", default="C")
    ap.add_argument("--by", choices=("sweep", "override", "brief", "typed", "yolo", "dnd", "chain", "ship"), default="override")
    ap.add_argument("--merge", action="store_true",
                    help="carry the owner's /finish --merge into the run (--by override|typed, or ship with --digest)")
    ap.add_argument("--hold", action="store_true", help="stop at a ready PR whatever the mode: the keel's no (S6)")
    ap.add_argument("--digest", metavar="D", help="--by ship's: the ship's pinned digest, whose keel said merge")
    ap.add_argument("--session", metavar="ID", help="the caller's own session: its lock is no refusal")
    ap.add_argument("--on", choices=("here",), help="keep the run on this Mac (the header's Where)")
    # the peer's job (peer-start's LaunchAgent): the id the sending Mac chose, its bundle, the ticket
    ap.add_argument("--run-session", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--bundle", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--ticket", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--from", dest="sent_from", metavar="HOST", help=argparse.SUPPRESS)   # D2-A, the job's only
    ap.add_argument("--dry", action="store_true")
    args = ap.parse_args(argv)
    if os.environ.get("AUTOFINISH_JOB"):
        try:   # a one-shot job: its plist goes at once, so a login never runs it again
            os.remove(os.environ["AUTOFINISH_JOB"])
        except OSError:
            pass
    if args.run_session and not SID_RE.match(args.run_session):
        print("autofinish-run: --run-session takes a session uuid", file=sys.stderr)
        return 2
    if args.sent_from and from_refusal(args):
        # the sending Mac's approval: only peer-start's job carries it, never an unattended caller here
        # (AGENTS.md trap: a flag that stands for a yes)
        print("autofinish-run: --from is the peer's job's — %s" % from_refusal(args), file=sys.stderr)
        return 2
    if not args.ticket:
        return run_main(args)
    real, sys.stderr = sys.stderr, Tee(sys.stderr)
    rc, late = None, []

    def begin(tk):
        """`began` written, under the ticket's lock, unless launchd started this job late: a job loaded,
        never run, then started at a login — the sending Mac writes such a run off at PRE_START_S and may
        start it again. The cutoff is JOB_LATE_S, half of that, so a job that runs has written `began`
        long before the write-off (second landing review, 7: both were PRE_START_S, and a job starting
        at 590 s ran beside the start the write-off allowed)."""
        if not tk or tk.get("session") != args.run_session or tk.get("rc") is not None:
            return None
        if age(tk.get("scheduled")) > JOB_LATE_S:
            late.append(age(tk.get("scheduled")))
            return None
        return dict(tk, began=now_iso())
    try:
        update_json(args.ticket, begin)
        if late:
            print("autofinish-run: not starting %s — its job ran %d s after it was scheduled; the sending Mac "
                  "writes it off at %d s" % (args.worktree, late[0], PRE_START_S), file=sys.stderr)
            rc = 3
            return rc
        rc = run_main(args)
        return rc
    finally:
        kept, sys.stderr = sys.stderr.kept.getvalue(), real
        lines = [l for l in kept.splitlines() if l.strip()]
        update_json(args.ticket, lambda tk: dict(tk, rc=1 if rc is None else rc, said=(lines[-1] if lines else None) if rc else None)
                    if tk and tk.get("session") == args.run_session else None)


def from_refusal(args):
    """Why `--from` is not this caller's, or None. It stands for the sending Mac's yes, so the guard is the
    job's whole shape (second landing review, 4: "some --ticket was given" was all): launchd's job env
    (AUTOFINISH_JOB, the plist peer-start wrote), a ticket that names this --run-session and has no exit
    yet, a host name, and no unattended caller or skipper (CLAUDE_UNATTENDED, SKIPPER_SCOPE)."""
    if not HOST_RE.match(args.sent_from):
        return "it takes a host name"
    for n in ("CLAUDE_UNATTENDED", "SKIPPER_SCOPE"):
        if os.environ.get(n):
            return "never an unattended caller's (%s is set)" % n
    if not os.environ.get("AUTOFINISH_JOB"):
        return "it runs only as peer-start's launchd job (no AUTOFINISH_JOB)"
    if not args.run_session or not args.ticket:
        return "it goes with --run-session and --ticket"
    tk = read_json(args.ticket) or {}
    if tk.get("session") != args.run_session or tk.get("rc") is not None:
        return "its ticket %s names no pending run of session %s" % (args.ticket, args.run_session[:8])
    return None


def run_main(args):
    if args.merge and args.by not in MERGE_BY:
        print("autofinish-run: --merge needs a person's yes, so --by %s (not %s) only" % (" or ".join(MERGE_BY), args.by),
              file=sys.stderr)
        return 2
    for n in ("CLAUDE_UNATTENDED", "SKIPPER_SCOPE"):
        if args.merge and os.environ.get(n):
            print("autofinish-run: --merge needs a person's yes, and this caller is an unattended run (%s=%s)"
                  % (n, os.environ[n]), file=sys.stderr)
            return 2
    if args.merge and args.hold:
        print("autofinish-run: --merge and --hold ask opposite things: one of them", file=sys.stderr)
        return 2
    if args.digest and not (args.by == "ship" and args.merge):
        print("autofinish-run: --digest goes with --merge --by ship", file=sys.stderr)
        return 2
    if args.by == "ship":
        why = ship_caller_refusal() or (None if args.merge or args.hold else
                                        "--by ship is the tick's landing call: --merge --digest D, or --hold")
        if why:
            print("autofinish-run: %s" % why, file=sys.stderr)
            return 2
    why = lease_refusal(args.dry)
    if why:
        print("autofinish-run: %s" % why, file=sys.stderr)
        return 4
    t = Tree(os.path.abspath(os.path.expanduser(args.worktree)))
    bad = t.problem()
    if bad:
        print("autofinish-run: %s: %s" % (args.worktree, bad), file=sys.stderr)
        return 2
    if args.by == "ship" and args.merge:
        why = ship_refusal(t, args.digest)
        if why:
            print("autofinish-run: %s" % why, file=sys.stderr)
            return 2
    t.shipped, t.stay = args.bundle, None
    typed = args.by == "typed"
    t.budget = float(os.environ.get("AUTOFINISH_SEND_BUDGET") or (SEND_BUDGET_TYPED if typed else SEND_BUDGET))
    t.deadline, t.reserve = time.time() + t.budget, STAY_RESERVE_TYPED if typed else STAY_RESERVE
    # --dry writes nothing, the start lock included: it only says what a start would meet
    held = None if args.dry else take_start_lock(t)
    if not args.dry and not held:
        why = "another start on this worktree is under way (%s)" % os.path.join(t.state_dir, START_LOCK)
        print("autofinish-run: not starting %s — %s" % (t.branch, why), file=sys.stderr)
        log("%s run %s %s refused tip=%s rule=%s by=%s — %s" % (now_iso(), t.repo, t.branch, t.tip[:7],
                                                                args.rule, args.by, why))
        return 3
    try:
        return start(t, args)
    finally:
        if held:
            try:
                os.remove(held)
            except OSError:
                pass


def refuse(t, args, why):
    print("autofinish-run: not starting %s — %s" % (t.branch, why), file=sys.stderr)
    if not args.dry:
        log("%s run %s %s refused tip=%s rule=%s by=%s — %s" % (now_iso(), t.repo, t.branch, t.tip[:7],
                                                                args.rule, args.by, why))
    return 3


def end_warm(t, args, cap=None):
    """A seeded run of this branch is kept the cache's hour, past autofinish's 40 min: it is ended
    first, then the branch launches (the owner, D2 of docs/dispatch-warm-hour-2026-10-08.md: C). A busy
    one is not the launch's to end: no launch — the why, else None.
    Under the start lock and the sweep's RUNNER_TIMEOUT (both 120 s): ending a run takes ~15 s
    with its window out of view (close tries, the SIGTERM wait, CLOSE_WAIT), so 90 s, and a
    timeout is a refusal — the next sweep tries again (re-review of 2026-10-08). A typed hand-off
    gets 30 s: cold_prompt kills this process at 45 s, and a refusal lets the /finish run in its tab."""
    warm_s = 30 if args.by == "typed" else 90
    if cap is not None:   # a send's budget (route())
        warm_s = min(warm_s, cap)
    try:
        warm = subprocess.run((shlex.split(END_WARM) if END_WARM else [sys.executable, os.path.join(HERE, "dispatch-rc"), "end-warm"])
                              + [t.branch, t.primary] + (["--dry-run"] if args.dry else []),
                              capture_output=True, text=True, timeout=warm_s)
    except subprocess.TimeoutExpired:
        warm = subprocess.CompletedProcess([], 1, "", "ending its warm run took over %d s" % warm_s)
    if warm.stdout.strip():
        print(warm.stdout.strip())
    if warm.returncode:
        return "its dispatch run could not be ended first: " + (warm.stdout.strip() or warm.stderr.strip()[-200:])
    return None


def count_chain(t, prev, sid):
    """A chain start, counted before the detach: a start that fails is refused, which chain_refusal skips."""
    tmp = os.path.join(t.state_dir, "%s.%d" % (CHAIN, os.getpid()))
    with open(tmp, "w") as f:
        json.dump({"tip": t.tip, "sessions": chain_spent(t, prev) + [sid]}, f)
    os.replace(tmp, os.path.join(t.state_dir, CHAIN))


def start(t, args):
    """The refusals, then where the run goes (the header's Where), under the start lock main() holds."""
    prev = read_state(t)
    # --run-session in the peer's job: judging a run the sending Mac sent (refusal()'s `sent`). Only the
    # job's env makes it one: a local --run-session alone skipped chain_refusal (fourth landing review, CR 3)
    sent = bool(args.run_session and os.environ.get("AUTOFINISH_JOB"))
    why = refusal(t, prev, args.by, sent=sent) or lock_refusal(t, args.session, args.by == "typed")
    if why:
        return refuse(t, args, why)
    # A chain relaunch of a yolo launch is a yolo launch again (chain-manager E3; bin/autofinish's
    # runner_by() keeps a died yolo retry yolo for the same reason): a plain /finish --unattended
    # would merge the answers yolo took where the yolo run stops at a held PR. Recorded as `yolo`,
    # so start_cmd, runner_by and the next chain relaunch all read it as one; CHAIN and the log's
    # `via=chain` say the tick started it.
    # The same for a brief or a ship launch (the autofinish-exclude landing review, finding 5): recorded
    # as `chain` it would pass landing() with no hold and bin/pr's re-judge would skip it, so a class-2
    # diff held at the brief, or a ship the keel held, would land on the tick's relaunch. Its hold, too,
    # is carried: a relaunch never holds less than the run it continues.
    # On the peer, only its own run on this tip: a sent chain's prev may be an older tip's run (refusal()'s
    # `sent`). The sending Mac resolved the launch already, and sends only a plain one (ladder_stay)
    by = (prev or {}).get("by") if args.by == "chain" and (prev or {}).get("by") in CHAIN_KEEPS \
        and (not args.run_session or (prev or {}).get("tip") == t.tip) else args.by
    via = " via=chain" if args.by == "chain" else ""
    hold, mode, eff = landing(t, by, args.rule)
    if args.by == "chain" and not hold and (prev or {}).get("hold"):
        hold = prev["hold"]
    # the keel's no (S6): a mode that would merge is not asked, and a later launch of this worktree —
    # the sweep's retry of a held run that died starts `--by sweep`, no --hold — keeps it. Its own key,
    # not the text of `hold`: a launch that another rule held first (mode ask) records that rule's
    # reason, and the keel's no must outlive it (S6's finish review)
    keel_hold = bool(args.hold or (prev or {}).get("keel_hold") or (prev or {}).get("hold") == SHIP_HOLD)
    if keel_hold and not hold:
        hold = SHIP_HOLD
    if hold and args.merge:
        args.merge = False   # a held launch merges nothing: no `--merge` in its prompt or state beside `--hold`
    t.ladder = (hold, mode, keel_hold, eff)
    try:
        where = None if args.run_session else route(t, args, by)   # the peer's own job runs here
    except WarmBusy as e:   # this Mac's warm run writes in this worktree: ended before the send, or no start
        return refuse(t, args, str(e))
    if where:
        return start_on_peer(t, args, prev, by, via, *where)
    return start_here(t, args, prev, by, via)


def start_here(t, args, prev, by, via):
    """The run on this Mac: the login, the warm run, the writes and the detach."""
    hold, mode, keel_hold, eff = t.ladder
    try:
        # cached for --dry, and for a typed hand-off: cold_prompt waits 45 s on this, in a prompt hook.
        # Before the warm run's end below: a run no account can take ends nothing. A run route() meant
        # to send had its warm run ended there already, before the pick (its last checkpoint goes with
        # the send, and the peer takes its own pick); one that then stays and finds no account ended it
        # for nothing — a seeded run's cache hour, the price of reading the tip once (second landing review, 8)
        label, cfg, picked = account_pick(t, cached=args.dry or args.by == "typed" or getattr(t, "pick_cached", False))
    except NoAccount as e:
        why = "no account may run this now — %s" % e
        refuse(t, args, why)
        return 4 if args.ticket else 3   # the peer's job: the sending Mac starts it there instead
    if getattr(t, "stay", None):
        picked += "; here: %s" % t.stay
    why = None if getattr(t, "warm_ended", False) else end_warm(t, args)   # route() ended it already
    if why:
        return refuse(t, args, why)
    use_account(cfg)
    sid = args.run_session or str(uuid.uuid4())
    try:
        arm, arm_why = draw_arm(t)
    except Exception as e:  # noqa: BLE001 — the rotation never costs a start: today's finisher
        arm, arm_why = None, "rotation off: %s" % type(e).__name__
    # the key there but no arm drawn says so in the day's log; no key file, the start line is unchanged
    arm_off = not arm and not arm_why.startswith("rotation off: no %s" % ROTATION_KEY)
    st = {"started": now_iso(), "session": sid, "tip": t.tip, "by": by, "rule": args.rule,
          "window": t.window, "account": label, "ended": None, "outcome": None, "pr": None, "gate": None,
          "merge": args.merge, "hold": hold, "keel_hold": keel_hold, "from": args.sent_from,
          "eff_mode": eff, "land_mode": mode, "arm": arm}
    cmd = start_cmd(t, sid, by=by, merge=args.merge, hold=hold, arm=arm, sent_from=args.sent_from)
    try:
        targets = open_sessions(t, args.session, args.by == "typed")
    except Exception as e:  # who to tell is never worth the launch: notify then sends nothing
        targets = []
        print("autofinish-run: the sessions open on %s were not read — %s" % (t.branch, e), file=sys.stderr)
    if args.dry:
        print("autofinish-run --dry: %s in %s, tip %s, rule %s, by %s%s" % (t.branch, t.path, t.tip[:7], args.rule, by, via))
        print("mode %s: %s" % (mode or "none", "held at a ready PR — " + hold if hold else "may merge, past the check and the review gate"))
        print("account %s%s: %s" % (label or "unchanged", " (%s)" % cfg if cfg else "", picked))
        print("finisher %s: %s" % ("%s (%s, %s)" % (arm["name"], arm["model"], arm["effort"]) if arm else "today's", arm_why))
        print("would write %s:" % os.path.join(t.state_dir, STATE))
        print("  " + json.dumps(contract(st), ensure_ascii=False))
        print("would write %s: session %s" % (os.path.join(t.state_dir, common.OWNER_FILE), sid))
        print("would write %s: tell %s" % (os.path.join(t.state_dir, NOTIFY), ", ".join(x[:8] for x in targets) or "nobody"))
        text = bundle_text(t)
        print("would write %s (%d characters), beginning:" % (os.path.join(t.state_dir, BUNDLE), len(text)))
        print("\n".join("  | " + l for l in text.splitlines()[:6]))
        print("would run, detached, output to %s:" % t.runlog)
        print("  " + " ".join(shlex.quote(c) for c in cmd))
        print("dispatch --start --dry-run says the session would be:")
        sys.stdout.flush()
        return subprocess.call(start_cmd(t, sid, dry=True, by=by, merge=args.merge, hold=hold, arm=arm, sent_from=args.sent_from), env=start_env(t))
    try:
        with open(os.path.join(t.state_dir, common.OWNER_FILE)) as f:
            before = f.read()
    except OSError:
        before = None
    write_state(t, st)
    try:
        write_targets(t, sid, targets)
    except OSError as e:  # never worth the launch: notify then finds no file and sends nothing
        print("autofinish-run: %s not written — %s" % (NOTIFY, e), file=sys.stderr)
    common.write_owner(t.state_dir, sid, t.branch)
    if args.by == "chain":
        count_chain(t, prev, sid)
    log("%s run %s %s started session=%s tip=%s rule=%s by=%s%s account=%s window=\"%s\" — %s" % (
        st["started"], t.repo, t.branch, sid[:8], t.tip[:7], args.rule, by, via + (" merge=yes" if args.merge else "")
        + (" hold=\"%s\"" % hold if hold else "") + (" arm=%s" % arm["name"] if arm else " arm=off (%s)" % arm_why if arm_off else ""),
        label or "-", t.window, picked))
    try:
        detach(lambda: wait_for_end(t, st, cmd), t.runlog)
    except OSError as e:
        # no child: a lock naming a session that never exists would refuse the panel for 2 h
        give_back(t, sid, before, st)
        print("autofinish-run: %s did not start — %s; the lock is given back" % (t.branch, e), file=sys.stderr)
        log("%s run %s %s never-started gate=%s session=%s tip=%s rule=%s by=%s — the detach failed: %s" % (
            st["ended"], t.repo, t.branch, REFUSED, sid[:8], t.tip[:7], args.rule, by, e))
        return 1
    print("started: %s — window and Remote Control \"%s\", session %s, account %s; state %s; log %s"
          % (finish_prompt(t.branch, by, args.merge, hold=hold, sent_from=args.sent_from), t.window, sid, label or "unchanged",
             os.path.join(t.state_dir, STATE), t.runlog))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
