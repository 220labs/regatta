OPTIONAL_KEYS = ("merge", "hold", "keel_hold", "host", "from", "eff_mode", "land_mode", "arm",
                 "pushed", "base", "base_tip", "queue", "land_by", "automerge", "road", "priority", "hold_from", "handover", "owed")   # written only when set: a launch without --merge or a hold keeps the file it always had
# hold_from: the session whose hold this run carries rather than judged (a chain or lander relaunch, a retry of a died
# or refused run), so a later retry carries only a hold no rule of its own would recompute (the S1 landing's review:
# a sweep's own mode-ask hold, refused by dispatch, outlived the owner's raise of the mode)
# land_by: the mode flag a lander or chain relaunch carries (stuck-ships S1): `yolo` or `dnd`, so a second hop keeps
# `--yolo`/`--dnd` in its prompt though its `by` is `lander`. automerge: the PR's auto-merge request as read at the
