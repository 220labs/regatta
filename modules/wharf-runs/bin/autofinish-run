S4_RE = re.compile(r"^(?:API Error\b|Your computer went to sleep|.{0,60}\bECONNREFUSED\b|You(?:'|’)ve hit your (?:5-hour |weekly |session )limit\b)")
LOGIN_RE = re.compile(r"Not logged in|/login\b|OAuth token|authentication_error", re.I)
CHAIN = "autofinish-chain.json"   # {"tip", "sessions"}: the chain relaunches on that tip (chain_refusal)
