DROP_MARK = ("REGATTA_UNATTENDED",)
NAME_RE = re.compile(r"^claude/(?:[a-z0-9-]+/)?\d{4}-\d{2}-\d{2}-(?P<topic>.+)$")  # pickup's NAME_RE
# --by chain (the tick, orchestration B3): which stops it may relaunch, and how often.
# The patterns are bin/stalls.py's NET_RE and LOGIN_RE, character for character (test_helm.sh compares
# them): the tick judges S4 with one copy and this file lifts its refusal with the other. The usage-limit
# alternative is Claude Code's own stop ("You've hit your 5-hour limit · resets …"): thirteen landings
# stopped on it on 2026-10-31, each re-landed by hand from a new commit (queue-followthrough). Only the
# windows `account pick` judges, by name (5-hour, weekly, session): an Opus, Sonnet or Fable week, a credit
# or spend limit is no row's verdict, so a relaunch would go back to the same login and stop at once (S5); the
# bare "You've hit your limit" is Claude Code's extra-usage-rejected form, any window, so it stays out.
S4_RE = re.compile(r"^(?:API Error\b|Your computer went to sleep|.{0,60}\bECONNREFUSED\b|You(?:'|’)ve hit your (?:5-hour |weekly |session )limit\b)")
LOGIN_RE = re.compile(r"Not logged in|/login\b|OAuth token|authentication_error", re.I)
CHAIN = "autofinish-chain.json"   # {"tip", "sessions"}: the chain relaunches on that tip (chain_refusal)
CHAIN_RELAUNCHES = 2                 # D4 = C (the owner, 2026-10-14): two retries per step, a launch's tip included
END_WARM = os.environ.get("AUTOFINISH_END_WARM")   # tests: in place of `dispatch-rc end-warm`, given BRANCH PRIMARY
# A start's checks run before this process returns, and its callers wait a bounded time: the sweep's
# start_runner RUNNER_TIMEOUT (120 s, and START_LOCK_S the same), cold_prompt's typed hand-off 45 s.
# The start keeps inside SEND_BUDGET from the start; the checks stop STAY_RESERVE short of it, what a
# run that starts here still needs (the pick, PICK_TIMEOUT + 5 s, --cached for a typed one, and the writes)
SEND_BUDGET, SEND_BUDGET_TYPED = 110, 40
ORIGIN_READ_S = 10   # the origin gate's ls-remote; a warm run's end here is capped by what the budget has left
ORIGIN_RC = 6        # the origin gate refused: nothing ran, and cold_prompt blocks rather than run /finish in its tab
STAY_RESERVE, STAY_RESERVE_TYPED = 25, 6
# What the caller prints and exits with is dispatch's verdict, read from its log, never predicted: night-landings
# finding 1, two `started:` lines for runs that dispatch then refused for room. 0 started; REFUSED_RC dispatch refused, nothing ran
# (never 1: a crashed Python exits 1, AGENTS.md's probe trap); UNCONFIRMED_RC no verdict in time, the waiter
# settles it: 0, as every caller read the detach before this verdict existed — a non-zero "may still begin" let
# cold_prompt run a second /finish beside it and dispatch's yolo_launch give the landing's slot to a claim (the
# landing review). A refusal keeps the cap's waiting words.
REFUSED_RC, UNCONFIRMED_RC = 5, 0
VERDICT_S = float(os.environ.get("AUTOFINISH_VERDICT_S") or 120)   # the longest wait for dispatch's verdict
VERDICT_MARGIN, VERDICT_MARGIN_TYPED = 8, 3   # past the send budget the caller's own timeout still allows
                        # (the sweep waits 120 s on a 110 s budget; cold_prompt 45 s on 40 s, less this)
VERDICT_FLOOR = 1   # a spent budget still waits this, inside the margin: past it the caller's timeout fires first
VERDICT_POLL = float(os.environ.get("AUTOFINISH_VERDICT_POLL") or 0.25)
HEADER_RE = r"^== claude \d+, session %s\b"   # dispatch's header for a run that began, this run's sid in it
FAILED_RE = re.compile(r"^FAILED:\s*(.*)")
EXIT_RE = re.compile(r"^== exit ")
ROLLBACK_RE = re.compile(r"^.*\brollback:\s.*$", re.M)
MERGED_RE = re.compile(r"\bmerged #(\d+)")
PULL_RE = re.compile(r"/pull/(\d+)\b")
HASH_RE = re.compile(r"#(\d+)\b")
STEP_RE = re.compile(r"\bstep (\d+)", re.I)
# a ⚠ line that names no step: the gate by its words, first match wins (the skill's steps → design's G-numbers)
# Matched as words (gate_word()), so "checkpoint" is no check and "alive" no live system (task-shape S1)
GATE_WORDS = (("open item", "G4"), ("owns the checkout", "G0"), ("lock", "G0"),
              ("another session", "G10"), ("review", "G1r"), ("deploy", "G1"), ("live", "G1"),
              ("check", "G1"), ("github", "G5"), ("merge", "G11"), ("push", "G11"), ("rebase", "G11"))
# step 1 is the check and the review gate in one step: a stop that names the review is G1r, else G1
REVIEW_RE = re.compile(r"\breview", re.I)
# a ref update in `git push`'s report: ` + 1a2b3c4...5d6e7f8 <src> -> <dst> (forced update)`, `   a..b  <src> -> <dst>`
UP_TO_DATE = "up-to-date"   # push_sent(): the last push found origin already at the branch's tip
PUSH_LINE_RE = re.compile(r"^\s*[+ ]?\s*[0-9a-f]{7,40}\.\.\.?([0-9a-f]{7,40})\s+\S+\s+->\s+(\S+)")

# The finisher rotation (the header): the arms in coin order, 0 the pin. Full ids: an alias floats
# (the builders bench's harness rules). Opus `medium` is today's finisher spelled out, so both arms
# get the same flags and differ only in the model.
ROTATION_KEY = "wharf-runs/finisher-rotation"
ARMS = (("opus-medium", "claude-opus-5-5", "medium"), ("sonnet-medium", "claude-sonnet-5-5", "medium"))
ROTATION_LOG = "finisher-rotation.jsonl"   # in LOGS: private to this Mac, outside git
ROTATION_RE = re.compile(r"^(?:until\s+)?(\d{4}-\d{2}-\d{2})$")
SETTLE_S = 48 * 3600   # a launch's fix window
FIX_RE = re.compile(r"\b(?:fix|fixes|fixed|revert|reverts|regression|broke|broken|bug)\b", re.I)

if os.environ.get("AUTOFINISH_API_STUB"):  # the tests' GitHub: find_pr and the comment go through it
    _spec = importlib.util.spec_from_file_location("api_stub", os.environ["AUTOFINISH_API_STUB"])
    _stub = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(_stub)
    common.api = _stub.api


def load_bin(name):
    """A script in bin/ as a module (no .py, sometimes a dash: no plain import)."""
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), os.path.join(HERE, name))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(mod)
    return mod


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def log_day():
    """The day a day-named log takes: AUTOFINISH_DAY (the tests' seam), else the local date."""
    return os.environ.get("AUTOFINISH_DAY") or datetime.date.today().isoformat()


def git(where, *args):
    r = subprocess.run(["git", "-C", where, *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


class Tree:
    """The worktree, read from git — never from the caller's cwd."""

    def __init__(self, path):
        self.path = git(path, "rev-parse", "--show-toplevel")
        self.gitdir = git(path, "rev-parse", "--absolute-git-dir")
        common_dir = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
        self.common = common_dir
        self.primary = os.path.dirname(common_dir) if common_dir.endswith("/.git") else ""
        self.branch = git(path, "symbolic-ref", "--quiet", "--short", "HEAD")
        self.tip = git(path, "rev-parse", "HEAD")
        m = NAME_RE.match(self.branch)
        self.topic = m.group("topic") if m else self.branch.rsplit("/", 1)[-1]
        self.repo = os.path.basename(self.primary)
        self.state_dir = os.path.join(self.gitdir, "claude")
        # dispatch's NAME, whole: its slug is the run's topic, finish-<topic>, which stalls and dispatch-rc
        # match. The session's name is dispatch's fit of it (the core's session_name), which every line
        # here quotes: the Remote Control name is it plus " · <machine>", the window "run · " it " · <repo>"
        self.window = "finish · %s" % self.topic
        # the very call dispatch makes of the NAME (`--lead work`), so the two never disagree: a topic
        # `finish-x` is finish-x in both. Guarded: a core older than this module names it as before
        name = getattr(common, "session_name", None)
        self.session = name("work", self.window, lead=True) if name else self.window
        # fixed at the start: a run that crosses midnight keeps one file
        self.runlog = os.path.join(LOGS, "%s-dispatch-finish-%s.log" % (log_day(), self.topic))

    def problem(self):
        if not self.path or not self.gitdir:
            return "not a git worktree"
        if not self.branch.startswith("claude/"):
            return "on %s, not a claude/* branch" % (self.branch or "a detached HEAD")
        if not self.primary or os.path.realpath(self.path) == os.path.realpath(self.primary):
            return "the primary checkout: a runner works in the branch's own worktree"
        return None


def read_state(t):
    try:
        with open(os.path.join(t.state_dir, STATE)) as f:
            st = json.load(f)
        return st if isinstance(st, dict) else None
    except (OSError, ValueError):
        return None


def contract(st):
    """The keys autofinish.json carries: KEYS always, OPTIONAL_KEYS only when set."""
    return dict({k: st.get(k) for k in KEYS}, **{k: st[k] for k in OPTIONAL_KEYS if st.get(k)})


def write_state(t, st):
    """The contract's keys, in its order, nothing else; through a rename, so a hook never reads half."""
    os.makedirs(t.state_dir, exist_ok=True)
    path = os.path.join(t.state_dir, STATE)
    tmp = "%s.%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(contract(st), f, indent=1, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def log(line):
    """One line in the day's autofinish log — the dry run's file and shape."""
    os.makedirs(LOGS, exist_ok=True)
    with open(os.path.join(LOGS, "autofinish-%s.log" % log_day()), "a") as f:
        f.write(line.rstrip("\n") + "\n")


def run_record(sid):
    """(path, state) of dispatch's record of the run with this session id, or (None, None)."""
    for path in glob.glob(os.path.join(RUNS, "*.%s.json" % sid[:8])):
        try:
            with open(path) as f:
                st = json.load(f)
        except (OSError, ValueError):
            continue
        if st.get("session") == sid:
            return path, st
    return None, None


def run_live(sid):
    """True while dispatch's run of this session is not over: its claude or its watcher still
    running and no end written (dispatch-rc's unfinished())."""
    path, _ = run_record(sid)
    if not path:
        return False
    rc = load_bin("dispatch-rc")
    st = rc.load(path)
    if st.get("ended"):
        return False
    return rc.same(st) or (isinstance(st.get("watcher"), int) and not rc.watcher_gone(st))


def last_stop(t):
    """The detail of this branch's last line in `autofinished` when that line is a stop, else None."""
    entries = [e for e in common.autofinished(t.common) if e["branch"] == t.branch]
    return entries[-1]["detail"] if entries and entries[-1]["outcome"] == "stopped" else None


def stop_line(t, prev):
    """The detail of the judged stop's own `autofinished` line (a stop line stamped with its `ended`, as record() and
    dispatch-queue's tomb_line write it), or None. Never the branch's last stop line instead: after a lander start that never
    replied or died that is the start's, and before another host's end line is back (tomb_line) it is an older run's, whose text would spend
    a road on a stop that was not its class (review 5; the landing review: an older run's text, not this stop's)."""
    ended = (prev or {}).get("ended")
    if ended:
        for e in reversed(common.autofinished(t.common)):
            if e["branch"] == t.branch and e["outcome"] == "stopped" and e["ts"] == ended:
                return e["detail"]
    return None


def chain_runs(t):
    """The sessions `--by chain` started on this worktree's tip, from CHAIN (any other tip's are void)."""
    try:
        with open(os.path.join(t.state_dir, CHAIN)) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return []
    return list(d.get("sessions") or []) if isinstance(d, dict) and d.get("tip") == t.tip else []


def chain_spent(t, prev):
    """The chain relaunches spent on this tip: CHAIN's sessions less the one dispatch refused before any
    session existed (refused) — that start is always the `prev` of the next one, so start()
    drops it from CHAIN then, and a refused start is never counted once a later one runs."""
    return [s for s in chain_runs(t) if not (prev and s == prev.get("session") and prev.get("gate") in REFUSED_GATES)]


def chain_refusal(t, prev, claimed=False):
    """Why the tick may not relaunch this tip, or None (orchestration B3, chain-manager
    E3, D4 = C). The one refusal it lifts — no retry on the same tip — only for the one cause it is
    for: the last run on this very tip stopped at `no-landing` and the branch's last autofinished
    line says the network, sleep or a login's usage limit stopped it (S4_RE, anchored at the stop text's
    start, as bin/stalls.py's NET_RE: a WAITING line that quotes an API error is not one — R4). A usage
    limit is the login's, not the branch's: the relaunch picks its login afresh, and a pick no row passes
    refuses before any session, which spends no relaunch (queue-followthrough, 2026-11-01). At most
    CHAIN_RELAUNCHES of them per tip; a chain start dispatch refused before any session (refused)
    leaves the stop in place and is not counted against the tip."""
    if not prev or prev.get("tip") != t.tip:
        return ("a chain relaunch is for a launch stopped on this tip, and its last run was on %s"
                % (str((prev or {}).get("tip") or "none")[:7]))
    if not prev.get("ended"):
        return "a run on this tip started %s (session %s) has not ended" % (
            prev.get("started"), str(prev.get("session"))[:8])
    started = chain_spent(t, prev)
    if not (prev.get("outcome") == "stopped" and prev.get("gate") == "no-landing") and prev.get("gate") not in REFUSED_GATES:
        return "its run on this tip ended %s at %s, not stopped by the network — no chain relaunch" % (
            prev.get("outcome"), prev.get("gate") or "no gate")
    gate, _, text = (last_stop(t) or "").partition(" ")
    if gate != "no-landing" or not S4_RE.match(text) or LOGIN_RE.search(text):
        return "the branch's last autofinished line is no network, sleep or usage-limit stop — no chain relaunch"
    # a relaunch put here and claimed here was counted at its put: that count is this start's own (round 3)
    if len(started) - (1 if claimed else 0) >= CHAIN_RELAUNCHES:
        return "%d chain relaunches on this tip already (%s) — raised, not retried" % (
            len(started), ", ".join(s[:8] for s in started))
    return None


def stopped_on(t, prev):
    """True when PREV is a run on this tip that started and ended, neither refused nor died: a stop a
    chain relaunch may be judged by where PREV was recorded (refusal()'s `sent`). One still going
    counts too, so that refusal says it has not ended."""
    if not prev or prev.get("tip") != t.tip:
        return False
    return not prev.get("ended") or (prev.get("gate") not in REFUSED_GATES and prev.get("outcome") != DIED)


class Refusal(str):
    """A refusal's text and its exit: 3 (today's: a plain wait or no), STUCK_RC or DEAD_ROAD_RC; `same_tip` marks
    today's same-tip refusal, which refuse() counts in lander.json and logs once an hour (stuck-ships S1)."""

    def __new__(cls, text, rc=3, same_tip=False):
        s = str.__new__(cls, text)
        s.rc, s.same_tip, s.road = rc, same_tip, False
        return s


class StoreUnreadable(Exception):
    """lander.json is there and does not read: no road starts on a cap it cannot count."""


class RoadSpent(Exception):
    """A road's cap reached under the store's lock, at the spend: the start refuses as stuck (args[0]: the count)."""


def lander_path():
    return pathlib.Path(common.autofinish_state_dir()) / LANDER


@contextlib.contextmanager
def lander_locked():
    """The store's lock: every write to lander.json, by any of its three writers, under flock on lander.json.lock."""
    p = lander_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    with open(str(p) + ".lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def lander_read():
    """The whole store, {} when there is none; raises StoreUnreadable when the file is there and does not parse."""
    try:
        text = lander_path().read_text()
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise StoreUnreadable(str(e))
    try:
        d = json.loads(text)
    except ValueError as e:
        raise StoreUnreadable("not JSON: %s" % e)
    if not isinstance(d, dict):
        raise StoreUnreadable("not an object")
    return d


def lander_key(primary, branch):
    """`<repo key>/<branch>`: the repo as the registry names it (a worktree's is its main checkout's); a repo outside
    the projects folder, which repo_key gives back as spelt, by its real path, so a temp folder's two spellings (a
    symlinked parent and its target, the tick's and a start's) are one key (round 2)."""
    key = common.repo_key(primary) or primary or "."
    return "%s/%s" % (os.path.realpath(key) if str(key).startswith("/") else key, branch)


def fresh_entry():
    return {"first_stop": None, "starts": 0, "relaunches": {"login": 0, "limit": 0, "stand": 0}, "reruns": 0,
            "refinishes": 0, "rounds": 0, "refusals": None, "hold": None, "state": None}


def reset_entry(e):
    """The counts and the state fresh; the hold kept until `lift` takes the label off (S1's resets), and the kept stop,
    which records the last stop, not a count (a lander start refused after a reset still has it to judge: review 3)."""
    # the hold, and the last stop: no counts; a kept key in a shape no writer makes is dropped (entry_problem)
    keep = {k: e[k] for k in ("hold", "stop", "stop_for") if k in e and (k == "stop_for" or isinstance(e[k], dict))}
    e.clear()
    e.update(fresh_entry(), **keep)


def lander_update(key, fn, replace=False, aside=False):
    """fn(entry) changes KEY's entry (a fresh one when absent) under the lock; the store written through a rename.
    Returns fn's value. Raises StoreUnreadable rather than write over a store it could not read, or over an entry
    that is there and not an object: a refusal's own count would otherwise widen what lander_entry narrowed (the
    landing review). REPLACE (a reset: the tick's or a person's) writes a fresh entry over such a one. ASIDE (the
    `lander reset --aside` verb only, refused an unattended caller) moves a store that does not parse to lander.json.unreadable-<epoch>, said on stderr,
    and starts a new one: the one road out of an unreadable store that is not a hand edit (round 1). Every write
    prunes the entries that hold nothing but old refusal counts (prune_entries)."""
    with lander_locked():
        try:
            d = lander_read()
        except StoreUnreadable as x:
            if not aside:
                raise
            p = lander_path()
            kept = "%s.unreadable-%d" % (p, int(time.time()))
            os.replace(str(p), kept)
            print("autofinish-run lander: %s did not read (%s): set aside as %s, a new store started — every "
                  "branch's caps and stuck states on this Mac are cleared with it" % (p, x, kept), file=sys.stderr)
            d = {}
        why = entry_problem(d[key]) if key in d else None
        if why and not replace:
            raise StoreUnreadable("its entry for %s %s" % (key, why))
        # a reset writes over a malformed entry, keeping the hold and the stop of one that is still an object
        e = d[key] if key in d and isinstance(d[key], dict) and (not why or replace) else fresh_entry()
        out = fn(e)
        d[key] = e
        prune_entries(d, keep=key)
        p = lander_path()
        tmp = "%s.%d" % (p, os.getpid())
        try:
            with open(tmp, "w") as f:
                json.dump(d, f, indent=1, ensure_ascii=False, sort_keys=True)
                f.write("\n")
            os.replace(tmp, str(p))
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)
    return out


COUNTERS = ("starts", "refinishes", "reruns", "rounds")
PRUNE_S = 7 * 86400   # an entry holding only refusal counts this old is dropped at the next write (round 1)


def prune_entries(d, keep=None):
    """Drop the entries that hold nothing a road, a cap or a hold reads — no count, no state, no hold, no kept stop —
    and whose last refusal count is older than PRUNE_S: count_refusal adds one per branch the sweep refuses, on any
    repo, and nothing else would ever remove it (round 1). A malformed entry is kept: it is the owner's to see."""
    now = time.time()
    for k in [k for k in d if k != keep]:
        e = d[k]
        if entry_problem(e) or any(e.get(n) for n in ("hold", "state", "stop", "spent", "stop_for", "first_stop")):
            continue
        if any(e.get(n) for n in COUNTERS) or any((e.get("relaunches") or {}).values()):
            continue
        logged = [v for v in (e.get("road_logged") or {}).values() if isinstance(v, (int, float))]
        if logged and now - max(logged) < max(REFUSAL_LOG_S, PRUNE_S):
            continue   # a road's wait logged in the last week (round 2: pruned, every wait was logged again)
        try:
            last = datetime.datetime.fromisoformat(str((e.get("refusals") or {}).get("last") or "")).timestamp()
        except ValueError:
            last = None if e.get("refusals") else 0
        if last is not None and now - last > PRUNE_S:
            del d[k]


def entry_problem(e):
    """Why a present entry does not read, or None: a key a cap or the state is read from that is there in a shape
    no writer makes — a non-object `relaunches`, a counter that is no whole number, a `state` other than `stuck` —
    narrows to nothing rather than read as 0 or as not stuck (AGENTS.md's narrowing trap; the landing review)."""
    if not isinstance(e, dict):
        return "is not an object"
    def count(v):
        return v is None or (isinstance(v, int) and not isinstance(v, bool) and v >= 0)
    for k in COUNTERS:
        if not count(e.get(k)):
            return "has %s %r, no count" % (k, e.get(k))
    rel = e.get("relaunches")
    if rel is not None and not (isinstance(rel, dict) and all(count(v) for v in rel.values())):
        return "has relaunches %r, no counts" % (rel,)
    if e.get("state") not in (None, "stuck"):
        return "has state %r, which no writer writes" % (e.get("state"),)
    for k in ("spent", "stop", "hold", "refusals", "road_logged"):
        if e.get(k) is not None and not isinstance(e.get(k), dict):
            return "has %s %r, no object" % (k, e.get(k))
    return None


def lander_entry(t):
    """The key's entry, {} when absent; one that is there and does not read (entry_problem) raises StoreUnreadable
    (a narrowing that cannot be read narrows: AGENTS.md's trap, review 5)."""
    # Only an absent key is empty: a stored null must reach entry_problem like any other non-object.
    e = lander_read().get(lander_key(t.primary, t.branch), {})
    why = entry_problem(e)
    if why:
        raise StoreUnreadable("its entry for %s %s" % (t.branch, why))
    return e


def road_add(e, road, delta):
    """The road's counter moved by DELTA, never below 0: re-finishes, else the relaunch of that class."""
    if road == "refinish":
        e["refinishes"] = max(0, int(e.get("refinishes") or 0) + delta)
    else:
        rel = e.get("relaunches") if isinstance(e.get("relaunches"), dict) else {}
        rel[road] = max(0, int(rel.get(road) or 0) + delta)
        e["relaunches"] = rel
    e["starts"] = max(0, int(e.get("starts") or 0) + delta)


def road_spent(e, road):
    if road == "refinish":
        return int(e.get("refinishes") or 0)
    return int(((e.get("relaunches") or {}) if isinstance(e.get("relaunches"), dict) else {}).get(road) or 0)


def is_person(by):
    """A person's own launch, as the lander reads one: a person's label, no unattended caller (AGENTS.md's trap: a
    bare loop under CLAUDE_UNATTENDED is `override` by label and no person), and none of PRIO_UNATTENDED — a skipper's
    `--by typed` is no person either, as judged_stop reads it (round 2: it reset a stuck key's caps)."""
    return by in PERSON_BY and not unattended_caller() and not any(os.environ.get(n) for n in PRIO_UNATTENDED)


def pr_detail(t):
    """The branch's open PR as GitHub's pulls endpoint gives it (mergeable_state, head, draft, auto_merge), or None."""
    s = slug(t)
    if not s:
        return None
    pr = common.find_pr(s, t.branch)
    if not pr:
        return None
    st, d = common.api("GET", "/repos/%s/pulls/%d" % (s, pr["number"]))
    return d if st == 200 and isinstance(d, dict) else None


def road_refinish(t, prev):
    """(a): the PR conflicts after main moved, its head is this worktree's HEAD, and the last run is one the re-finish
    road takes (launched; a no-landing stop with a ready PR; a G11 stop) — never a G1r, G4, held or ask-held stop, a
    PR labelled `hold` (a held launch's, or the owner's by hand: a re-finish would merge what the label holds) or a
    draft. "Main moved" is read from git, never from the run's recorded `base_tip`: that is main at the run's end, not
    the base its /finish rebased onto, so a conflict landed mid-run read as unmoved, and a run whose ls-remote failed
    recorded none (the landing review). Origin's main not in HEAD's history is main moved past the branch."""
    outcome, gate = prev.get("outcome"), prev.get("gate")
    if not (outcome in common.LAUNCHED_OUTCOMES or (outcome == "stopped" and gate in ("G11", "no-landing"))):
        return Refusal("its last run ended %s at %s: the refinish road takes a launched run, a no-landing stop with a "
                       "ready PR or a G11 stop" % (outcome, gate or "no gate"))
    pr = pr_detail(t)
    if not pr:
        return Refusal("no open PR for %s could be read: the refinish road waits" % t.branch)
    labels = pr.get("labels") if isinstance(pr.get("labels"), list) else None
    if labels is None:   # a narrowing that cannot be read narrows (AGENTS.md's trap): no labels read is no start
        return Refusal("PR #%s's labels could not be read: the refinish road waits" % pr.get("number"))
    if any(isinstance(l, dict) and l.get("name") == "hold" for l in labels):
        return Refusal("PR #%s is labelled `hold`: it lands by the owner's tap, never by the refinish road"
                       % pr.get("number"), DEAD_ROAD_RC)
    if pr.get("draft") is not False:
        return Refusal("its %s left PR #%s a draft (or its draft flag did not read): the refinish road takes a ready one"
                       % ("launch" if outcome in common.LAUNCHED_OUTCOMES else "%s stop" % gate, pr.get("number")))
    if str(pr.get("mergeable_state") or "").lower() != "dirty":
        return Refusal("PR #%s reads %s, not DIRTY: the refinish road waits" % (pr.get("number"), pr.get("mergeable_state") or "unknown"))
    head = ((pr.get("head") or {}) if isinstance(pr.get("head"), dict) else {}).get("sha")
    if head != t.tip:
        return Refusal("PR #%s's head %s is not this worktree's HEAD %s: another Mac's to re-finish (pr stuck lists it)"
                       % (pr.get("number"), str(head)[:7], t.tip[:7]))
    base = prev.get("base") or main_of(t)
    heads = remote_heads(t, base)
    if heads is None or not heads.get(base):
        return Refusal("origin's %s could not be read: the refinish road waits" % base)
    if is_ancestor(t.path, heads[base], t.tip):
        return Refusal("%s (%s) is in this branch's history: main has not moved past it, the refinish road waits"
                       % (base, heads[base][:7]))
    return None


def stopped_at(prev, gate):
    """True when the judged stop itself stopped at GATE: the last autofinished line alone may be an older run's (another
    host's end line not back yet), and a road must not be spent on a stop that was not its class (review 4)."""
    return bool(prev) and prev.get("outcome") == "stopped" and prev.get("gate") == gate


def road_login(t, prev):
    """(b): the last stop's text is a login failure (LOGIN_RE, read as chain_refusal reads last_stop) — the class,
    never the logged-out row, which a pick's probe may clear meanwhile."""
    gate, _, text = (stop_line(t, prev) or "").partition(" ")
    if gate != "no-landing" or not LOGIN_RE.search(text) or not stopped_at(prev, "no-landing"):
        return Refusal("the branch's last autofinished line is no login failure (a no-landing stop): no login road")
    return None


def account_home(label):
    """(home, None) for the login a run recorded, or (None, Refusal): a dir is its own home; a label is read from
    `account limits --all --parked --json --cached` by its label (spaces as the run lines write them, `_`)."""
    if not label or label == "oauth-token":
        return None, Refusal("its run recorded no registry login (%s): the limit road can never read its window"
                             % (label or "none"), DEAD_ROAD_RC)
    if label.startswith(("/", "~")) and os.path.isdir(os.path.expanduser(label)):
        return os.path.expanduser(label), None
    if not ACCOUNT:
        return None, Refusal("no account tool here: the limit road cannot read %s's window now" % label)
    try:
        r = common.run_group([ACCOUNT, "limits", "--all", "--parked", "--json", "--cached"], 10)
        rows = json.loads(r.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        return None, Refusal("account limits did not read (%s): the limit road waits" % type(e).__name__)
    if not isinstance(rows, list) or not rows:
        # no rows at all is a cache not written yet, never "no such login" (round 1): a wait
        return None, Refusal("account limits --cached read no rows: the limit road waits for a reading")
    for a in rows:
        # a label as pick records it, as the run lines write it (spaces as `_`), or a home recorded the latter way
        if isinstance(a, dict) and a.get("home") and label in (str(a.get("label") or ""),
                                                               re.sub(r"\s+", "_", str(a.get("label") or "")),
                                                               re.sub(r"\s+", "_", str(a["home"]))):
            return os.path.expanduser(a["home"]), None
    return None, Refusal("no registry row is labelled %s: the limit road can never read its window" % label, DEAD_ROAD_RC)


def seat_rows(home):
    """A test of an exhaustion row: whether it is HOME's own seat's, as lighthouse's account reads one (own_record: an
    Orca profile's exhaustion.jsonl holds the primary's rows copied in, whose reset says nothing of this login's window;
    the port's round 3). Every row counts where account does not load or HOME's login does not read, as account counts
    them itself: unknown is not nobody's."""
    try:
        path = str(common.tool("account") or "")
        ld = importlib.machinery.SourceFileLoader("afr_lh_account", path)
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
        ld.exec_module(mod)
        seat = mod.login_ids(home)
        return lambda r: mod.own_record(r, seat)
    except Exception:  # noqa: BLE001 — no account: today's reading, every row
        return lambda r: True


def road_limit(t, prev):
    """(c): the last stop is the usage-limit line, and the newest `five_hour` exhaustion row written after the run's
    start, in the exhaustion.jsonl of the login the run ran on (its `account`), has passed its `resets_at`."""
    gate, _, text = (stop_line(t, prev) or "").partition(" ")
    if gate != "no-landing" or not LIMIT_RE.search(text) or not stopped_at(prev, "no-landing"):
        return Refusal("the branch's last autofinished line is no usage-limit end: no limit road")
    home, why = account_home(prev.get("account"))
    if why:
        return why
    try:
        since = datetime.datetime.fromisoformat(prev.get("started") or "").timestamp()
    except ValueError:
        since = 0
    rows, own = [], seat_rows(home)
    try:
        with open(os.path.join(home, "exhaustion.jsonl")) as f:
            for l in f:
                try:
                    r = json.loads(l)
                except ValueError:
                    continue
                # the window the run ran in: a row written after its start, or one written before whose reset is
                # after it (record_exhaustion writes one row per window, so a probe's earlier row is that window's)
                if isinstance(r, dict) and r.get("window") == "five_hour" and isinstance(r.get("at"), (int, float)) \
                        and (r["at"] >= since or (isinstance(r.get("resets_at"), (int, float)) and r["resets_at"] > since)) \
                        and own(r):
                    rows.append(r)
    except OSError:
        pass
    if not rows:
        return Refusal("no five_hour exhaustion row for %s's window (written after its run started, or resetting "
                       "after it): the limit road can never tell its reset" % prev.get("account"), DEAD_ROAD_RC)
    newest = max(rows, key=lambda r: r["at"])
    reset = newest.get("resets_at")
    if not isinstance(reset, (int, float)):
        return Refusal("%s's newest five_hour row has no reset: the limit road can never tell it" % prev.get("account"),
                       DEAD_ROAD_RC)
    if reset > time.time():
        return Refusal("%s's 5-hour window resets at %s: the limit road waits for it" % (
            prev.get("account"), datetime.datetime.fromtimestamp(reset).isoformat(timespec="minutes")))
    return None


# keel's ITEM_RE, multiline: a D-item in any form keel reads (`- **D1 —`, `1. **D1 —`, `**D1** —`, `D1:`)
D_ITEM_RE = re.compile(r"^\s*(?:(?:[-*]|\d+\.)\s+)?\*{0,2}D\d+\*{0,2}\s*[—–\-.:]", re.M)


def road_stand(t, prev):
    """(d): the last stop is G4 and `keel status --json` reads no open item on any doc keel's stand sweep reads
    (S6 stood them; the stand's commit is HEAD). A G4 stop with no such doc is the owner's."""
    gate, _, _ = (stop_line(t, prev) or "").partition(" ")
    if gate != "G4" or not stopped_at(prev, "G4"):
        return Refusal("the branch's last autofinished line is no G4 stop: no stand road")
    af = _lander()
    if af is None:
        return Refusal("bin/autofinish did not load: the stand road cannot read keel status now")
    rc, out, err = quiet_git(t.path, "-c", "core.quotePath=false", "diff", "--name-only", "--no-renames", "--diff-filter=AM",
                             "origin/%s...HEAD" % main_of(t), "--", "*.md")
    if rc:
        return Refusal("the branch's docs could not be listed (%s): the stand road waits" % (err.strip()[-120:] or rc))
    docs, opened = [], []
    for doc in out.splitlines():
        if not stand_doc(doc):
            continue   # keel's sweep_docs: every changed Markdown doc bar handoff briefs, at any depth
        try:
            with open(os.path.join(t.path, doc), errors="replace") as f:
                if D_ITEM_RE.search(f.read()):
                    docs.append(doc)
        except OSError:
            continue
    if not docs:
        # nothing keel could ever stand: the G4 items are the owner's, raised once, never a wait each tick
        return Refusal("no D-list doc on the branch: its G4 items are the owner's, no stand road", DEAD_ROAD_RC)
    read = 0
    for doc in docs:
        st = af.memo_status(t.path, doc)
        if st is not None and not (isinstance(st.get("items"), int) and st["items"] > 0):
            continue   # D_ITEM_RE's hit on a wrapped `D1-A` line: keel reads no item there, so no stand here (round 3)
        read += 1
        if st is None:
            # memo_status reads a timeout, a crash and an answer with no verdict alike: asked again here, only keel
            # answering cleanly with no verdict is a road that never holds; anything else may pass (round 1)
            return Refusal(*keel_unread(af, t, doc))
        if st.get("verdict") == "taken":
            # keel yolo's picks: taken answers never launch where the owner has not read them (yolo-veto D1); the
            # sweep's rule D skips them too — the owner's, raised once (review 3)
            return Refusal("%s's answers were taken by keel yolo: the stand road never lands them" % doc, DEAD_ROAD_RC)
        if st.get("unanswered") and st.get("verdict") in ("too-big", "physical", "voided", "no-contract", "part-stood",
                                                           "ask-mode"):
            # keel's stand never takes these (more than ten items, a physical repo, a touch since the link, no
            # contract, a branch in mode ask): the owner's, raised once (review 4; ask-mode, the landing review)
            return Refusal("%s reads %s with %s open: keel never stands it" % (doc, st["verdict"], st["unanswered"]),
                           DEAD_ROAD_RC)
        if st.get("unanswered"):
            opened.append("%s (%s open)" % (doc, st["unanswered"]))
    if opened:
        return Refusal("%s: the stand road waits for the stand" % ", ".join(opened))
    if not read:
        return Refusal("no D-list doc on the branch keel reads items in: its G4 items are the owner's, no stand road",
                       DEAD_ROAD_RC)
    return None


def keel_unread(af, t, doc):
    """(text, rc) for a doc memo_status had no verdict for, from keel asked once more. keel answers every doc it can
    read with a verdict, and refuses one it never can (no link, not a claude/* branch, origin not on GitHub) with exit
    1 and a `memo: …` line (keel's `status --json` on a Stop): that is DEAD_ROAD_RC, no stand will change it. A
    verdict on the second ask, a missing keel, a timeout, a traceback or any other failure is a wait, exit 3 (round 2:
    the first form read keel's refusal as a wait and a passing failure as dead)."""
    memo = getattr(af, "MEMO", "") or ""
    if not os.access(memo, os.X_OK):
        return "keel is not installed here: the stand road cannot read %s now" % doc, 3
    try:
        r = subprocess.run([memo, "status", "--json", "--no-fetch", doc], cwd=t.path, capture_output=True, text=True,
                           timeout=getattr(af, "MEMO_TIMEOUT", 30))
    except (OSError, subprocess.TimeoutExpired) as e:
        return "keel status did not answer for %s (%s): the stand road waits" % (doc, type(e).__name__), 3
    err = (r.stderr or "").strip()
    if r.returncode == 1 and err.startswith("memo: ") and "Traceback" not in err:
        return "keel never stands %s (%s): the stand road never holds for it" % (doc, err.splitlines()[0][:160]), \
            DEAD_ROAD_RC
    if r.returncode == 0:
        return "keel answered for %s on a second ask: the stand road judges it at the next pass" % doc, 3
    return "keel status failed for %s (exit %d): the stand road waits" % (doc, r.returncode), 3


ROAD_PREDICATES = {"refinish": road_refinish, "login": road_login, "limit": road_limit, "stand": road_stand}
STOP_KEYS = ("session", "started", "tip", "by", "land_by", "eff_mode", "hold", "account", "ended", "outcome", "pr", "gate",
             "base", "base_tip", "pushed", "keel_hold", "hold_from", "handover", "owed")   # pushed: the refinish road's HEAD test on a kept stop (moved_since_stop)


def road_stop(prev, e):
    """The stop a road judges: the last run, or — when that run is a start dispatch refused before any session (a
    REFUSED_GATES record: no base_tip, the new pick's account, its own start time) — the stop the refused lander start
    was judged by, kept in the entry's `stop` (review 1: the road read the refused record and went dead)."""
    # a lander start that never started (no reply) or died is no stop of its own either: its road re-judges the stop
    # it passed on, under its spent cap, rather than waiting on a record no road takes (review 4)
    nothing_ran = prev and (prev.get("gate") in REFUSED_GATES or (
        prev.get("by") == "lander" and prev.get("outcome") in ("never-started", DIED)))
    # A lander record is the kept stop's whatever its session: a chain relaunch of a lander run stays `lander`
    # (CHAIN_KEEPS) under its own session, never `stop_for`, and passed on no stop of its own — judged as the stop,
    # its never-started record wedged every road (the landing review). Any other refused record needs `stop_for`.
    ours = prev and prev.get("session") and (prev.get("session") == e.get("stop_for") or prev.get("by") == "lander")
    if nothing_ran and isinstance(e.get("stop"), dict) and ours:
        return e["stop"]
    return prev


def refund_session(t, sid, restore=False):
    """Give back the road a lander start of session SID spent, under the lock, the session re-read there: at most
    once, and never another start's. Called where its refused record is written (record()), by the start itself on a
    refusal, and, as the fallback, where it is next judged."""
    def settle(e):
        if (e.get("spent") or {}).get("session") == sid:
            refund_spent(e, restore)
    lander_update(lander_key(t.primary, t.branch), settle)


def refund_spent(e, restore=False):
    """Give back the road `spent` names (one start's), and forget it: at most once per start. `restore`: the start
    left no record at all (its state write failed), so `stop_for` goes back to the session it named before (review 4)."""
    sp = e.pop("spent", None)
    if not isinstance(sp, dict) or sp.get("road") not in ROADS:
        return
    road_add(e, sp["road"], -1)
    if restore and "stop_for_before" in sp:
        if sp["stop_for_before"]:
            e["stop_for"] = sp["stop_for_before"]
        else:
            e.pop("stop_for", None)


def ran_elsewhere(st):
    """True for a run recorded here that ran on another host: a finish this host put and another claimed, whose end
    tomb_state wrote here (`host` names where it ran), or a run the peer road sent before the queue."""
    return bool(st and st.get("host") and str(st["host"]).lower() != self_host())


def lander_refusal(t, prev, road, e, dry=False):
    """A lander start's refusal, in S1's order past the key's state: a last run not ended (a queued start's included:
    a plain wait, so a queued relaunch is never answered by the cap it spent), the road's cap (STUCK_RC), the road's
    predicate (DEAD_ROAD_RC when it can never hold), then today's same-tip test, which a road whose predicate holds lifts."""
    if road not in ROADS:
        return Refusal("a lander start names its road: --road %s" % "|".join(ROADS))
    if prev and not prev.get("ended") and prev.get("session"):
        return Refusal("a run on this worktree started %s (session %s) has not ended%s: the %s road waits" % (
            prev.get("started"), str(prev.get("session"))[:8], ", on %s" % prev["host"] if ran_elsewhere(prev) else "", road))
    spent_by = e.get("spent") if isinstance(e.get("spent"), dict) else {}
    if prev and prev.get("gate") in REFUSED_GATES and prev.get("session") and spent_by.get("session") == prev["session"]:
        # a lander start spent on an unconfirmed or queued verdict that dispatch refused after all: nothing ran, so
        # its road is given back once, as chain_spent discounts such a record (review 2)
        if dry:   # --dry writes nothing: the refund owed is judged on a copy
            e = json.loads(json.dumps(e))
            refund_spent(e)
        else:
            try:
                refund_session(t, prev["session"])
                e = lander_entry(t)
            except (OSError, StoreUnreadable) as x:
                return Refusal("the lander's store %s does not write (%s): the %s road waits" % (lander_path(), x, road))
    prev = road_stop(prev, e)
    if ran_elsewhere(prev):
        # one host roads a stop, the one that ran it: its login's window, its worktree's HEAD (review 5). A finish this
        # host put and another host claimed ends here as that host's (tomb_state's `host`), never this host's road
        return Refusal("its stop ran on %s: that host's tick roads it, never this one" % prev["host"])
    if prev and prev.get("gate") in REFUSED_GATES:
        return Refusal("its last run was a start dispatch refused, and the stop before it is not kept here: the %s "
                       "road waits for a run that ends" % road)
    spent = road_spent(e, road)
    if spent >= ROAD_CAPS[road]:
        return Refusal("the %s road is spent on %s (%d of %d): stuck, the owner's" % (road, t.branch, spent, ROAD_CAPS[road]),
                       STUCK_RC)
    if not prev:
        return Refusal("no run on this worktree to road: the %s road takes a stop" % road)
    return moved_since_stop(t, prev, road) or ROAD_PREDICATES[road](t, prev)


def stand_doc(path):
    """Keel's sweep_docs file set, rather than list's shallower memo set. Keel's status judges the items."""
    return path.endswith(".md") and not path.startswith("docs/handoff/")


def moved_since_stop(t, prev, road):
    """A refusal when HEAD holds work the stop never saw (the landing review: commits added after a stop landed
    unjudged by its road), else None. `login` and `limit` re-run the stop's own tip; `stand` takes the stand's
    commits on top of it, each carrying keel's stand trailer and touching Markdown only (including a set's entry,
    whose Status stamp need not hold D-items). Anything else is new work, the sweep's to judge;
    `refinish` the tip its run pushed, where it recorded one (the PR's head then: pr_detail's test reads it now)."""
    tip = prev.get("tip")
    if road == "refinish":
        pushed = prev.get("pushed")
        if pushed and pushed != t.tip:
            return Refusal("HEAD %s is not the tip %s its last run pushed: the work since is the sweep's to judge, not "
                           "the refinish road's" % (t.tip[:7], pushed[:7]))
        if not pushed and tip != t.tip:
            # no pushed tip read back (a later push, a failed ls-remote, a run from before task-shape S1), and HEAD is
            # not the tip the run started on: nothing tells the run's own rewrite from work added since (round 2)
            return Refusal("its last run recorded no pushed tip and HEAD %s is not its start %s: the refinish road "
                           "cannot tell what the stop saw" % (t.tip[:7], str(tip)[:7]), DEAD_ROAD_RC)
        return None
    if not tip:
        return Refusal("its stop recorded no tip: the %s road cannot tell what it judged" % road, DEAD_ROAD_RC)
    if tip == t.tip or (road != "stand" and prev.get("pushed") == t.tip):
        # the stop's start tip, or the tip its own run pushed (a /finish that curated and pushed, then hit the limit
        # or a login failure: its rewrite is the stop's, not work since; round 3)
        return None
    if road != "stand":
        return Refusal("HEAD %s is past the stop's tip %s: the work since is the sweep's to judge, not the %s road's"
                       % (t.tip[:7], tip[:7], road))
    if not is_ancestor(t.path, tip, t.tip):
        return Refusal("HEAD %s does not hold the stop's tip %s: the stand road takes the stand's commits on it only"
                       % (t.tip[:7], tip[:7]))
    rc, out, err = quiet_git(t.path, "rev-list", "--parents", "%s..%s" % (tip, t.tip))
    if rc:
        return Refusal("the commits since the stop could not be listed (%s): the stand road waits" % (err.strip()[-120:] or rc))
    for row in out.splitlines():
        commit, *parents = row.split()
        # stand_apply makes one ordinary commit. A merge could introduce unjudged work without a tree diff.
        trailer = git(t.path, "show", "-s", "--format=%(trailers:key=Stood-By,valueonly)", commit)
        if len(parents) != 1 or trailer.splitlines() != ["autofinish"]:
            return Refusal("commit %s since the stop (%s) is not a keel stand commit: more than a stand's answers, "
                           "the sweep's to judge" % (commit[:7], tip[:7]))
        rc, names, err = quiet_git(t.path, "diff-tree", "--no-commit-id", "--name-only", "--no-renames", "-r", "-z", commit)
        if rc:
            return Refusal("the stand commit %s could not be read (%s): the stand road waits" % (
                commit[:7], err.strip()[-120:] or rc))
        other = [p for p in names.split("\0") if p and not stand_doc(p)]
        if other:
            return Refusal("commit %s changed %s since the stop (%s): more than a stand's answers, the sweep's to judge" % (
                commit[:7], ", ".join(other[:3]), tip[:7]))
    return None


def checked_lander_entry(t, by, sent=False):
    """(entry, refusal) for this host's cap store, before anything may end a run or move a tree. A person's start
    and a claim another host put do not read this store. Shared by tree_refusal and the later tip judgement."""
    e = {}
    # a claim of another host's put (`sent`) reads no lander.json here: that host's store is the branch's, judged at its
    # put (S1's one store, read and written by the putting host only; round 1's S2: a stuck key here tombstoned it failed)
    if not is_person(by) and not sent:
        try:
            e = lander_entry(t)
        except StoreUnreadable as x:
            # a narrowing that cannot be read narrows (AGENTS.md's trap): a stuck key it might hold refuses every
            # start that is not a person's, until the store reads again; a person's start passes as before
            # the remedy for what does not read: a malformed entry is its own key's reset; a file that does not parse
            # is set aside whole, every branch's caps with it (round 3)
            fix = ("`autofinish-run lander reset --worktree <worktree>` writes a fresh entry" if str(x).startswith("its entry")
                   else "`autofinish-run lander reset --aside --worktree <worktree>` sets it aside, clearing every branch's caps")
            why = Refusal("the lander's store %s does not read (%s): no start but a person's until it does — %s"
                          % (lander_path(), x, fix))
            why.road = True   # every caller meets it each pass: no store to count it in, so logged every time
            return e, why
        if e.get("state") == "stuck":
            why = Refusal("%s is stuck past the lander's caps: no start but a person's until it is reset" % t.branch, STUCK_RC)
            why.road = True   # the tick and the sweep meet it every pass: logged once an hour per text
            return e, why
    return e, None


def refusal(t, prev, by=None, sent=False, road=None, dry=False):
    """Why no run starts now, or None. `sent`: judged on the host that claimed a finish another host put (the
    claim's job). A chain relaunch is judged where its stop happened: the putting host ran chain_refusal on its own
    record of the stop, under its start lock, before it put; the claiming host has no record of a stop on this tip
    unless its own last run is on it, and then judges that one. Else
    the plain refusal, which `--by sweep` gets anyway (second landing review, 1: a chain relaunch sent
    to the peer was always refused there, so the network-drop relaunch the chain exists for ran on
    neither Mac). A stop made there is a run of the peer's own on this tip that ran and ended: one it
    refused, or one that died, made no stop there, and chain_refusal would refuse it for want of one
    (third landing review, S2: the second's fix still refused those two).
    The lander (stuck-ships S1): a key whose state is `stuck` refuses every start that is not a person's (STUCK_RC),
    before the chain's branch; a `--by lander` start is judged by lander_refusal() alone. A refusal is a Refusal:
    its `rc` is the exit, and today's same-tip one is marked `same_tip`."""
    e, why = checked_lander_entry(t, by, sent)
    if why:
        return why
    if by == "lander":
        why = lander_refusal(t, prev, road, e, dry=dry)
        if why:
            why = why if isinstance(why, Refusal) else Refusal(why)
            why.road = True   # the tick asks every 5 minutes: refuse() logs each text once an hour
        return why
    if by == "chain" and not (sent and not stopped_on(t, prev)):
        return chain_refusal(t, prev, claimed=bool(getattr(t, "own_claim", False)))
    if not prev:
        return None
    if prev.get("host") and str(prev["host"]).lower() != self_host() and not prev.get("ended"):
        if prev.get("tip") != t.tip:
            return None   # a run sent on another tip before the queue: this tip is new to every host
        return ("a run sent to %s before the queue (session %s, tip %s): its end is that host's — `/finish --here`, or a "
                "new commit, goes on" % (prev["host"], str(prev.get("session"))[:8], str(prev.get("tip"))[:7]))
    if prev.get("tip") == t.tip and prev.get("gate") not in REFUSED_GATES and prev.get("outcome") != DIED:
        if not prev.get("ended"):
            return "a run on this tip started %s (session %s) has not ended" % (
                prev.get("started"), str(prev.get("session"))[:8])
        return Refusal("its run on this tip (%s) ended %s, %s%s — no retry on the same tip" % (
            t.tip[:7], prev.get("ended"), prev.get("outcome"),
            " at %s" % prev["gate"] if prev.get("gate") else ""), same_tip=True)
    if not prev.get("ended") and prev.get("session"):
        if run_live(prev["session"]):
            return "a run is going on this worktree (session %s, tip %s)" % (
                prev["session"][:8], str(prev.get("tip"))[:7])
        try:
            started = datetime.datetime.fromisoformat(prev.get("started") or "").timestamp()
        except ValueError:
            started = 0
        if not run_record(prev["session"])[0] and time.time() - started < PRE_START_S:
            return "a run was started %s and has not reached dispatch yet" % prev.get("started")
    return None


def store_refusal(t, args):
    """A lander start's store must write before anything ends a warm run (tip_gate, route, start_here): the spend
    that refuses on a store that does not write came after end_warm, so the warm run was ended for a start that never
    ran, each tick (round 1). A write of the entry as it stands proves it; --dry writes nothing."""
    if args.by != "lander" or getattr(args, "dry", False):
        return None
    try:
        lander_update(lander_key(t.primary, t.branch), lambda e: None)
    except (OSError, StoreUnreadable) as e:
        return Refusal("the lander's store %s does not write (%s): the %s road cannot be spent" % (
            lander_path(), e, args.road))
    return None


def tree_refusal(t, prev, by=None, sent=False, road=None, dry=False):
    """The refusal of what no tree moves under, judged before the origin gate: a run not ended, and a run launched
    on this tip, whose own push may have left origin past it, so its same-tip refusal stands as on main. A chain
    relaunch is judged whole: it is for the stop's own tip, and one it refuses ends no warm run and moves nothing.
    So is a lander start (stuck-ships S1): its road's predicate lifts the same-tip refusal of a launched run (the
    refinish road's launched leg), which the plain test here would refuse. `by` goes along, so a stuck key refuses
    no person's start here either."""
    if by in ("chain", "lander"):
        return refusal(t, prev, by, sent=sent, road=road, dry=dry)
    _, why = checked_lander_entry(t, by, sent)
    if why:
        return why
    if prev and (not prev.get("ended") or prev.get("outcome") in common.LAUNCHED_OUTCOMES):
        # `sent` along too: a claim of another host's put reads no lander.json here (round 2)
        return refusal(t, prev, by, sent=sent)
    return None


def same_session(a, b):
    """A full id and its first 8 (a trailer's) are the same session."""
    a, b = str(a or ""), str(b or "")
    return bool(a and b) and (a == b or (min(len(a), len(b)) >= 8 and (a.startswith(b) or b.startswith(a))))


def open_sessions(t, caller=None, typed=False):
    """The live sessions open on this worktree now (bin/autofinish's sessions_on, by the lock's
    holder, the last prompter and cwd): the ones `notify` tells. Read before the lock changes hands."""
    af = load_bin("autofinish")
    state = pathlib.Path(t.state_dir)
    ids = {s for s in ((common.read_owner(state) or {}).get("session"), af.queue_session(state)) if s}
    return sorted({e["sessionId"] for e in af.sessions_on(pathlib.Path(t.path), ids)
                   if not (typed and same_session(e["sessionId"], caller))})


def write_targets(t, sid, targets, told=None):
    path = os.path.join(t.state_dir, NOTIFY)
    tmp = "%s.%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump({"session": sid, "targets": targets, "ts": now_iso(), "told": told}, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def notify_text(t, st, me):
    """The message: what happened to the branch, then the run — enough to find, watch or reach it.
    Every name is read back, never built: the Remote Control name from dispatch's record (it spells
    the host as the config keys do), the run's name from the registry — finish-<topic>, fitted, so two
    branches whose topics share a head may share it: the session id and the worktree go with it."""
    rc = (run_record(st["session"])[1] or {}).get("rc_name") or common.autofinish_window(st, t.branch)
    name = (me or {}).get("name")
    reach = ("ListAgents lists it as %s, cwd %s" % (name, t.path)) if name else "ListAgents lists it by its cwd, %s" % t.path
    return ("autofinish picked up this session's branch %s: a fresh unattended /finish is launching it now. "
            "The run: session %s (%s), window and Remote Control \"%s\", account %s, rule %s (by %s), "
            "started %s on tip %s. It holds this worktree's lock, so writes here are refused until it ends; "
            "its outcome shows here at the next prompt and on the PR. Record %s; log %s. "
            "To stop it, type in its window or Remote Control session (/autofinish off stops only the next start). "
            "No reply needed."
            % (t.branch, st["session"], reach, rc, st.get("account") or "unchanged", st.get("rule"), st.get("by"),
               common.iso_clock(st.get("started")), (st.get("tip") or "")[:7], os.path.join(t.state_dir, STATE),
               runlog_of(t, st)))


def notify(argv):
    ap = argparse.ArgumentParser(prog="autofinish-run notify")
    ap.add_argument("worktree", nargs="?", default=".")
    args = ap.parse_args(argv)
    t = Tree(os.path.abspath(os.path.expanduser(args.worktree)))
    if t.problem():
        print("autofinish-run notify: %s: %s" % (args.worktree, t.problem()), file=sys.stderr)
        return 2
    st = read_state(t) or {}
    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    try:
        with open(os.path.join(t.state_dir, NOTIFY)) as f:
            n = json.load(f)
    except (OSError, ValueError):
        n = {}
    if not st.get("session") or st.get("ended"):
        print("nothing to send: no autofinish run is under way on %s" % t.branch)
        return 0
    if not same_session(me, st["session"]):
        # closed when unknown: anyone else sending these would speak as the run
        print("nothing to send: the run on %s is session %s, not this one (%s)"
              % (t.branch, st["session"][:8], me[:8] if me else "no CLAUDE_CODE_SESSION_ID"))
        return 0
    if n.get("session") != st["session"] or not n.get("targets"):
        print("nothing to send: no other session was open on %s when the run started" % t.branch)
        return 0
    if n.get("told"):
        print("nothing to send: the lines were printed at %s already" % common.iso_clock(n["told"]))
        return 0
    live = {e["sessionId"]: e for e in load_bin("autofinish").live_sessions()}
    text = notify_text(t, st, live.get(st["session"]))
    asked, skipped = [], []
    for sid in n["targets"]:
        e = live.get(sid)
        if not e:
            skipped.append("%s — ended since the start" % sid[:8])
            continue
        name = e.get("name") or sid
        if not e.get("messagingSocketPath"):
            skipped.append("%s — binds no inbox; checkpoint's notice tells it at its next prompt" % name)
            continue
        # ListAgents: a bare name is the address unless two rows share it (asklib's same_named, K2)
        twins = [x for x in live.values() if e.get("name") and x.get("name") == e["name"] and x["sessionId"] != sid]
        print("SendMessage to %s" % name + ("  — %d other live session(s) share the name: send to the ListAgents "
                                            "row whose cwd is %s, with its [ref]" % (len(twins), e.get("cwd"))
                                            if twins else ""))
        asked.append(sid[:8])
    if asked:
        print("with this text, word for word:\n\n%s\n" % text)
    for s in skipped:
        print("skip %s" % s)
    try:
        write_targets(t, n["session"], n["targets"], told=now_iso())
    except OSError:
        pass
    # asked=, not sent=: the model makes the sends, and one across logins may be refused (unproven, B0c)
    log("%s run %s %s notify session=%s asked=%s%s" % (now_iso(), t.repo, t.branch, st["session"][:8],
                                                       ",".join(asked) or "-", " skipped=%d" % len(skipped) if skipped else ""))
    return 0


def lock_refusal(t, caller, typed):
    """Why the worktree's lock is not this run's to take, or None. The registry is bin/autofinish's
    reader (its pid and procStart test), so both judge a live session alike."""
    lock = common.read_owner(t.state_dir)
    holder = (lock or {}).get("session")
    if not holder or same_session(holder, caller):
        return None
    live = next((e for e in load_bin("autofinish").live_sessions() if same_session(e["sessionId"], holder)), None)
    # handed over (`pickup next`, or wharf once the yard settled the block): free while the holder
    # is idle or `shell` — a finished builder still runs the Session-tab waiter, so it reads `shell`.
    # Busy, it may still be in its last turn (worker-done, then the Stop checkpoint): refused (review, 2026-10-19)
    if lock.get("handover") and (not live or live.get("status") in ("idle", "shell")):
        return None
    if live and live.get("status") != "idle":
        return "the worktree's lock is held by session %s, live and %s" % (holder[:8], live.get("status") or "with no status")
    if typed and not lock.get("handover") and time.time() - (lock.get("seen") or 0) < common.OWNER_TTL:
        return ("the worktree's lock is held by session %s (seen %d min ago), not the one that typed /finish"
                % (holder[:8], (time.time() - (lock.get("seen") or 0)) // 60))
    return None


def take_start_lock(t):
    """The path of `autofinish.json.lock`, now ours, or None while another start holds it."""
    os.makedirs(t.state_dir, exist_ok=True)
    path = os.path.join(t.state_dir, START_LOCK)
    for _ in range(2):
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        except FileExistsError:
            try:
                if time.time() - os.path.getmtime(path) < START_LOCK_S:
                    return None
                os.remove(path)
            except OSError:
                pass  # gone meanwhile: the next try takes it
            continue
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
        return path
    return None


def give_back(t, sid, before, st):
    """The detach failed after the lock and the state were written: the lock as it was (or none),
    and the state ended never-started at `refused` — nothing ran, so the tip may start again."""
    path = os.path.join(t.state_dir, common.OWNER_FILE)
    if (common.read_owner(t.state_dir) or {}).get("session") == sid:
        if before is None:
            try:
                os.remove(path)
            except OSError:
                pass
        else:
            tmp = "%s.%d" % (path, os.getpid())
            with open(tmp, "w") as f:
                f.write(before)
            os.replace(tmp, path)
    st.update(ended=now_iso(), outcome="never-started", gate=REFUSED)
    write_state(t, st)


def log_verdict(path, offset, sid):
    """(kind, detail) of what dispatch said in the run log past OFFSET, or None while it has said none:
    `started` at its header naming SID (`== claude <pid>, session <sid>, …`), `refused` at a FAILED line or an
    `== exit` with no header before it (detail: the text) — a hint only, the log is shared by topic (the header),
    so await_verdict believes it once SID's state has ended. Whole lines only, the first decisive one wins."""
    header = re.compile(HEADER_RE % re.escape(sid))
    try:
        with open(path, "rb") as f:
            f.seek(offset)
            raw = f.read().decode("utf-8", "replace")
    except (OSError, TypeError):
        return None
    lines = raw.split("\n")[:-1]   # the last piece has no newline yet: dispatch is mid-line
    for line in lines:   # this run's header first, wherever it is: a sibling's FAILED line may come before it
        if header.match(line):
            return "started", line
    for line in lines:
        m = FAILED_RE.match(line)
        if m:
            return "refused", m.group(1).strip() or line
        if EXIT_RE.match(line):
            return "refused", line
    return None


def verdict_bound(t, floor=VERDICT_FLOOR):
    """Seconds to wait for a verdict: VERDICT_S, less than that when the caller's own wait (the send budget,
    plus the margin its timeout leaves) is nearly spent — but FLOOR of it, or VERDICT_S if that is less."""
    margin = VERDICT_MARGIN_TYPED if t.budget < SEND_BUDGET else VERDICT_MARGIN
    left = getattr(t, "deadline", time.time() + VERDICT_S) + margin - time.time()
    return min(VERDICT_S, max(floor, left))


def await_verdict(t, sid, log_from, bound):
    """(kind, detail) once dispatch has spoken in the run log — polled, dispatch is never run again — else
    `refused` when the waiter recorded an end first (dispatch crashed, said nothing), else `unconfirmed`
    after BOUND seconds. A refusal waits up to 10 s more (never past BOUND) for this run's end in the waiter's
    state, and is `unconfirmed` without it: a FAILED line alone may be a sibling run's of the same topic."""
    end = time.time() + bound
    verdict = None
    while verdict is None:
        verdict = log_verdict(t.runlog, log_from, sid)
        st = read_state(t) or {}
        if verdict is None and st.get("session") == sid and st.get("ended"):
            last = tail_lines(t.runlog, log_from, 1)
            verdict = "refused", (last[-1] if last else "dispatch wrote nothing")
        if verdict is None:
            if time.time() >= end:
                return "unconfirmed", None
            time.sleep(VERDICT_POLL)
    if verdict[0] == "refused":
        settled = min(time.time() + 10, max(end, time.time() + VERDICT_FLOOR))
        while True:
            st = read_state(t) or {}
            if st.get("session") == sid and st.get("ended"):
                break
            if time.time() >= settled:
                return "unconfirmed", None
            time.sleep(VERDICT_POLL)
    return verdict


def not_started_text(why):
    """`not started: <why>`; a refusal for room or the cap is a wait for a run to end, and says so in the cap's
    words (CAP_RE, ASK_EXEMPT_RE key on them: a skippered run that ends on it asks nothing, AGENTS.md)."""
    low = why.lower()
    wait = " — the next step waits for a run to end (the sweep starts this tip again)" if (
        "waits for a run to end" not in low and
        ("not starting another" in low or "no room" in low or "other runs are busy" in low)) else ""
    return "not started: %s%s" % (why, wait)


class NoAccount(Exception):
    """No row of the registry may run this now; args[0] is each row's reason."""


def account_pick(t, cached=False):
    """(label, dir, why) of the login the session runs on (header, the login). dir: the
    CLAUDE_CONFIG_DIR to start with, "" for the default login (unset), None to leave the env as
    it is. Raises NoAccount on the pick's exit 3."""
    if os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"):
        # the token outranks any dir (bin/account's header): `account which` reads only the dir
        os.environ.pop("ACCOUNT_OVERDRAW_PICK", None)   # an overdraw is this run's own pick's word alone
        return "oauth-token", None, "the caller's CLAUDE_CODE_OAUTH_TOKEN, kept"
    cfg = os.environ.get("CLAUDE_CONFIG_DIR")
    if not ACCOUNT and not cfg:
        return None, None, "no account tool (lighthouse not installed) — the login this run was started with"
    cooling = False
    if cfg:
        try:
            if not ACCOUNT:
                raise OSError("no account tool")
            r = subprocess.run([ACCOUNT, "which"], capture_output=True, text=True, timeout=10)
            label = r.stdout.strip() if r.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            label = ""
        # ~/.claude set explicitly is the default login, which runs logged out unless unset
        # (bin/account's header) — bin/autofinish passes it for a pick of the default row
        default = os.path.realpath(os.path.expanduser(cfg)) == os.path.realpath(os.path.expanduser("~/.claude"))
        cooling = cooling_down(cfg)
        if cooling:
            label = cooling
        else:
            # no spaces: the run lines are key=value, split on whitespace
            os.environ.pop("ACCOUNT_OVERDRAW_PICK", None)
            return re.sub(r"\s+", "_", label or cfg), "" if default else None, "the caller's CLAUDE_CONFIG_DIR, kept"
    cmd = [ACCOUNT, "pick", "--for", "finish", "--repo", t.primary, "--json"]
    overdraw = ["--overdraw", "--job", t.branch]
    os.environ.pop("ACCOUNT_OVERDRAW_PICK", None)   # an overdraw is this pick's word alone
    def run_pick(cached, timeout=PICK_TIMEOUT):
        # A fresh, single-use receipt for every attempt, the cached retry included.
        with common.finish_pick_env() as (env, fds):
            return common.run_group(cmd + (["--cached"] if cached else []) + overdraw, timeout, env=env, pass_fds=fds)
    try:
        # a landing is a job too (the owner, 2026-11-04): with no login under its week bar it starts past one
        # (lighthouse's account header, "Overdraw"). The pick only decides, on every road, a cached one included;
        # its `overdraw` object goes to the `dispatch --start` this runs (ACCOUNT_OVERDRAW_PICK), which logs it
        # once the session began
        r = run_pick(cached)
    except subprocess.TimeoutExpired:
        try:  # a probe that hangs: the cached readings decide, as a dry run's do
            r = run_pick(True, 5)
        except (OSError, subprocess.TimeoutExpired) as e:
            return None, None, "account pick failed (%s) — the login this run was started with" % type(e).__name__
    except OSError as e:
        return None, None, "account pick failed (%s) — the login this run was started with" % e
    try:
        d = json.loads(r.stdout)
    except ValueError:
        d = None
    if r.returncode == 4:
        return None, None, "no account registry here — the login this run was started with"
    if r.returncode == 3 and isinstance(d, dict):
        raise NoAccount("; ".join("%s: %s" % (l, w) for l, w in d.get("skipped") or []))
    if r.returncode or not isinstance(d, dict) or not d.get("account"):
        return None, None, "account pick failed (%s) — the login this run was started with" % (
            (r.stdout or r.stderr).strip()[:120] or "exit %d" % r.returncode)
    why = d.get("reason") or ""
    if cfg and cooling:
        why = "the caller's %s is cooling down, so picked: %s" % (label, why)
    if isinstance(d.get("overdraw"), dict):
        # start_env copies it to dispatch --start, which logs it at the session's start and unsets it
        os.environ["ACCOUNT_OVERDRAW_PICK"] = json.dumps(d["overdraw"], ensure_ascii=True)
    return d["account"], (d.get("env") or {}).get("CLAUDE_CONFIG_DIR", ""), why


def cooling_down(cfg):
    """The label of the row whose home is CFG when it is parked or a window of it is locked, else None. A caller's
    login is an explicit choice over the soft ceilings, never over a lock: a panel session left on
    a cooling login handed every landing it launched to that login (yard-s2, 2026-10-22, the work login
    held till 11:00). The row is read by its home, not from pick's `skipped`: pick stops at the
    first eligible row and never judges the rest, and `which` names no default row (the review)."""
    if not ACCOUNT:
        return None
    try:
        r = common.run_group([ACCOUNT, "limits", "--all", "--parked", "--json", "--cached"], 5)
        rows = json.loads(r.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    home = os.path.realpath(os.path.expanduser(cfg))
    for a in rows if isinstance(rows, list) else []:
        if not isinstance(a, dict) or not a.get("home") or os.path.realpath(a["home"]) != home:
            continue
        lim = a.get("limits") if isinstance(a.get("limits"), dict) else {}
        if a.get("enabled") is False or lim.get("locked") or str(a.get("why") or "").startswith("cooling down"):
            return re.sub(r"\s+", "_", str(a.get("label") or cfg))
    return None


def use_account(cfg):
    """The pick's dir into this process's env, so the start and the transcript's reader follow it."""
    if cfg is None:
        return
    if cfg:
        os.environ["CLAUDE_CONFIG_DIR"] = cfg
    else:
        os.environ.pop("CLAUDE_CONFIG_DIR", None)


# ---- the finisher rotation (the header) ----------------------------------------------------------

def rotation_window(today=None):
    """(end, why): the last day the rotation runs, or None and why it is off. One key is the switch and
    its end, so turning it off early is deleting the file, and it ends by itself."""
    lines, bad = common.config_read(ROTATION_KEY)
    if bad:
        return None, "rotation off: %s unreadable (%s)" % (ROTATION_KEY, bad)
    if not lines:
        return None, "rotation off: no %s" % ROTATION_KEY
    # bootstrap.sh's config_values writes each word of a value on its own line, so `until <date>` lands
    # as two lines; a hand-written file holds one. Joined, both read (S2's finish review)
    text = " ".join(l.strip() for l in lines if l.strip())
    m = ROTATION_RE.match(text)
    try:
        end = datetime.date.fromisoformat(m.group(1)) if m else None
    except ValueError:
        end = None
    if end is None:
        return None, "rotation off: %s says %r, not `until YYYY-MM-DD`" % (ROTATION_KEY, text[:60])
    if (today or datetime.date.today()) > end:
        return None, "rotation off: it ended %s" % end
    return end, "rotation on until %s" % end


def rotation_gate(primary):
    """(why, fields): why None when a landing of this repo may rotate and be recorded, else why not; fields the
    row's `scope` and `confidential`. One rule, the core's scope_rotates, which buildercoin.py's fence asks too.
    Fails closed: a torn registry reads as no scopes to scope_of_repo, so it is asked first (AGENTS.md's fence
    trap), on the one parse scope_rotates then judges; a repo in no scope is never known open; every scope that
    lists the repo is judged, not only the first (the core's gather_fence; S2's finish review), and any one with
    `rotation: false`, or a `rotation` that is no bool, fences; a shape it cannot walk fences too, and so does a
    core older than scope_rotates. A confidential scope rotates unless it opts out so (the owner, 2026-11-04)."""
    reg, bad = common.read_registry()
    if bad:
        return "the scope registry does not read", {}
    rule = getattr(common, "scope_rotates", None)
    if rule is None:
        return "the core has no scope_rotates (older than scope-rotation)", {}
    ok, why, fields = rule(primary, reg)
    return (None, fields) if ok else (why, {})


def rotation_fence(primary):
    """None when a landing of this repo may rotate and be recorded, else why not (rotation_gate's why)."""
    return rotation_gate(primary)[0]


def draw_arm(t):
    """(arm, why): the arm this start runs, as the state's `arm`, or None for today's finisher."""
    end, why = rotation_window()
    if end is None:
        return None, why
    fenced = rotation_fence(t.primary)
    if fenced:
        return None, "rotation fenced: %s — today's finisher, no row" % fenced
    forced = os.environ.get("AUTOFINISH_COIN")
    coin = int(forced) if forced in ("0", "1") else random.SystemRandom().randrange(2)
    name, model, effort = ARMS[coin]
    return ({"name": name, "model": model, "effort": effort, "coin": coin, "until": end.isoformat(),
             "forced": forced in ("0", "1")}, "%s; coin %d: %s" % (why, coin, name))


def transcript_cost(sid):
    """{models, cost_usd, agents_cost_usd} from the session's transcript and its agents', priced by
    plumb's usage-report (one price table; helmlib.session_cost's walk, plus the models and the agents).
    None without the transcript or usage-report."""
    path = transcript(sid)
    ur_path = common.tool("usage-report")
    if not path or not ur_path:
        return None
    try:
        ur = importlib.machinery.SourceFileLoader("usage_report", str(ur_path)).load_module()
    except BaseException:  # noqa: BLE001 — find_core's sys.exit included: no price, never a lost row
        return None

    def walk(p):
        seen = {}
        try:
            with open(p, errors="replace") as fh:
                for line in fh:
                    if '"usage"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    msg = d.get("message") if isinstance(d, dict) and d.get("type") == "assistant" else None
                    u = (msg or {}).get("usage")
                    # Claude Code's own <synthetic> entries carry zero usage (AGENTS.md's trap)
                    if not isinstance(u, dict) or msg.get("model") in (None, "<synthetic>"):
                        continue
                    key = d.get("requestId") or d.get("uuid")
                    out = u.get("output_tokens") or 0
                    if key in seen and seen[key][1][1] >= out:
                        continue   # a streamed reply's earlier blocks
                    cc = u.get("cache_creation") or {}
                    w5, w1 = cc.get("ephemeral_5m_input_tokens"), cc.get("ephemeral_1h_input_tokens")
                    if w5 is None and w1 is None:
                        w5, w1 = u.get("cache_creation_input_tokens") or 0, 0
                    seen[key] = (msg["model"], (u.get("input_tokens") or 0, out, u.get("cache_read_input_tokens") or 0,
                                                w5 or 0, w1 or 0))
        except OSError:
            pass
        return list(seen.values())

    calls = walk(path)
    agents = [c for p in sorted(glob.glob(os.path.join(path[:-len(".jsonl")], "subagents", "*.jsonl"))) for c in walk(p)]
    models = {}
    for m, v in calls:
        models[m] = models.get(m, 0) + sum(v)
    return {"models": models,
            "cost_usd": round(sum(ur.cost_of(m, *v) for m, v in calls), 4),
            "agents_cost_usd": round(sum(ur.cost_of(m, *v) for m, v in agents), 4)}


@contextlib.contextmanager
def rotation_lock():
    """The rows' file, locked: a row appended while --settle rewrites it would be lost."""
    os.makedirs(LOGS, exist_ok=True)
    with open(os.path.join(LOGS, ROTATION_LOG + ".lock"), "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            yield os.path.join(LOGS, ROTATION_LOG)
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def rotation_row(t, st, outcome, gate, pr):
    """One row for every finish run (task-shape S1: the rows a landing is read from, the rotation on or off);
    `arm` null when none was drawn, the model then dispatch's record of the run and the effort the skill's. None written (and
    why) when the fence is closed: the same fence as a draw's, so no repo the coins fence has a row."""
    arm = st.get("arm") if isinstance(st.get("arm"), dict) else None
    fenced, scope = rotation_gate(t.primary)
    if fenced:
        return "no rotation row: %s" % fenced
    cost = transcript_cost(st["session"]) or {}
    models = cost.get("models") or {}
    ran = run_record(st["session"])[1] or {}
    model = arm.get("model") if arm else ran.get("model")
    row = {"ts": now_iso(), "host": os.environ.get("DISPATCH_HOST") or common.host_name(),
           "repo": t.repo, "primary": t.primary, "slug": slug(t), "main": main_of(t), "branch": t.branch, "tip": t.tip,
           "session": st["session"], "started": st.get("started"), "by": st.get("by"), "rule": st.get("rule"),
           "account": st.get("account"), "coin": arm.get("coin") if arm else None, "forced": bool(arm and arm.get("forced")),
           "arm": arm.get("name") if arm else None, "model": model,
           # the finisher's effort: the finish skill's `effort: medium` (today's arm), not dispatch's default
           "effort": arm.get("effort") if arm else ARMS[0][2],
           "models_returned": sorted(models), "models_unrequested": sorted(m for m in models if m != model) if arm else [],
           # a session that never answered in the arm's model is no read of it (the safeguard's fallback); an
           # arm-less row names dispatch's alias (`opus`), which no returned id equals: only no-reply voids it
           "voided": ("no-reply" if not models else "fallback" if arm and arm.get("model") not in models else None),
           "outcome": outcome, "gate": gate, "pr": pr, "hold": st.get("hold"),
           "pushed": st.get("pushed"), "base": st.get("base"), "base_tip": st.get("base_tip"),
           "cost_usd": cost.get("cost_usd"), "agents_cost_usd": cost.get("agents_cost_usd"),
           "touched_48h": None, "fix_48h": None, "settled": None, "landing": None,
           # the scope that let it rotate, and whether it is confidential: trim counts such a row in its arm
           # tallies only, never naming it (trimlib's collect_fence)
           "scope": scope.get("scope"), "confidential": bool(scope.get("confidential"))}
    with rotation_lock() as path:
        with open(path, "a") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    return None


def read_rows(path):
    rows = []
    try:
        with open(path, errors="replace") as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if isinstance(r, dict):
                    rows.append(r)
    except OSError:
        pass
    return rows


def settle_row(r, now):
    """Fill touched_48h and fix_48h of a launched row 48 h past its merge. False when it cannot be
    read yet (no merge time, GitHub silent, the window still open)."""
    s, pr, primary = r.get("slug"), r.get("pr"), r.get("primary")
    if not (s and pr and primary and os.path.isdir(primary)):
        return False
    code, p = common.api("GET", "/repos/%s/pulls/%s" % (s, pr))
    merged = (p or {}).get("merged_at") if code == 200 and isinstance(p, dict) else None
    if not merged:
        return False
    at = datetime.datetime.fromisoformat(merged.replace("Z", "+00:00"))
    if now - at.timestamp() < SETTLE_S:
        return False
    code, files = common.api("GET", "/repos/%s/pulls/%s/files?per_page=100" % (s, pr))
    code2, commits = common.api("GET", "/repos/%s/pulls/%s/commits?per_page=100" % (s, pr))
    if code != 200 or code2 != 200 or not isinstance(files, list) or not isinstance(commits, list):
        return False
    paths = sorted({f["filename"] for f in files if isinstance(f, dict) and f.get("filename")})
    own = {((c.get("commit") or {}).get("message") or "").split("\n")[0] for c in commits if isinstance(c, dict)}
    until = at + datetime.timedelta(seconds=SETTLE_S)
    # a remote-tracking ref older than the window's end may miss its commits, and a settled row is
    # never read again: wait until a sync.py fast-forward has moved it past (S2's finish review)
    tip = git(primary, "log", "-1", "--format=%ct", "origin/%s" % (r.get("main") or "main")).strip()
    if not tip.isdigit() or int(tip) < until.timestamp():
        return False
    # the landing's own commits, rebased onto main, keep their subjects and land at the merge: left out
    out = git(primary, "log", "origin/%s" % (r.get("main") or "main"), "--format=%H%x1f%s",
              "--since=%s" % at.isoformat(), "--until=%s" % until.isoformat(), "--", *paths) if paths else ""
    later = [l.split("\x1f", 1)[1] for l in out.splitlines() if "\x1f" in l and l.split("\x1f", 1)[1] not in own]
    r.update(touched_48h=len(later), fix_48h=sum(1 for s_ in later if FIX_RE.search(s_)),
             settled=now_iso())
    return True


def _when(iso):
    """An ISO time as an aware datetime, or None (a naive or garbled one included)."""
    try:
        d = datetime.datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return None
    return d if d.tzinfo else None


def same_checkout(a, b):
    """Rows A and B are of one repo: their primaries as written or by their real paths (dispatch-rc's same_repo:
    a run's path may be /private/var for /var, or a linked projects folder; AGENTS.md trap), else the names."""
    pa, pb = a.get("primary"), b.get("primary")
    if pa and pb:
        return pa == pb or os.path.realpath(pa) == os.path.realpath(pb)
    return bool(a.get("repo")) and a.get("repo") == b.get("repo")


def later_run(r, rows, merged):
    """True when another finish run on the row's branch started after it and before the merge (condition 9):
    its push may be the head that merged; one that never started ran nothing. A run still going has no row yet, so its worktree's state is read too;
    a run on the peer Mac writes its row there, so the repo's `autofinished` lines are read too."""
    start = _when(r.get("started"))
    if not start:
        return True   # no start to order by: never known to be the last
    for o in rows:
        s = _when(o.get("started"))
        if (o is not r and o.get("session") != r.get("session") and o.get("branch") == r.get("branch")
                and o.get("outcome") != "never-started" and same_checkout(o, r) and s and start < s < merged):
            return True
    primary = r.get("primary") or ""
    # an end written here reaches this repo's `autofinished`; a line holds its end, not its start:
    # one of the branch dated after this row (whose own line is written before it) and before the merge ran
    # later. A never-started line ran nothing. No row time to order by: every line counts (fail-safe)
    cdir = git(primary, "rev-parse", "--path-format=absolute", "--git-common-dir") if os.path.isdir(primary) else ""
    after = _when(r.get("ts")) or start
    for e in common.autofinished(cdir) if cdir else ():
        at = _when(e["ts"])
        if e["branch"] == r.get("branch") and e["outcome"] != "never-started" and at and after < at < merged:
            return True
    wt = worktree_of(primary, r.get("branch") or "") if os.path.isdir(primary) else None
    gd = git(wt, "rev-parse", "--absolute-git-dir") if wt else ""
    st = {}
    if gd:
        try:
            with open(os.path.join(gd, "claude", STATE)) as f:
                st = json.load(f)
        except (OSError, ValueError):
            pass
    s = _when(st.get("started")) if isinstance(st, dict) else None
    return bool(s and st.get("session") != r.get("session") and st.get("outcome") != "never-started"
                and start < s < merged)


def settle_landing(r, rows):
    """A `no-landing` row (a finish that readied its PR and left it to automerge) read against GitHub (task-shape
    S1). {landing: settled} only when all nine hold: (1) `pushed`, `base`, `base_tip` and `pr` recorded; (2) the PR
    merged after the run started; (3) into the recorded base; (4) at the head this run pushed; (5) a head that is
    not the base's tip (a branch reset onto main); (6) a merge commit that is not the head itself; (7) someone or
    something merged it; (8) a diff that is not empty (work that nets to nothing); (9) no later finish run on the
    branch started before the merge. A failed one once the PR is closed: {landing: unknown} and which. None while
    it cannot be read yet (the PR open, GitHub silent), and for a row missing a field, which is never read: no row
    from before S1 settles, and none settles on its branch name (AGENTS.md's vacuous-proofs trap)."""
    if not all(r.get(k) for k in ("pushed", "base", "base_tip", "pr", "slug")):
        return None
    code, p = common.api("GET", "/repos/%s/pulls/%s" % (r["slug"], r["pr"]))
    if code != 200 or not isinstance(p, dict):
        return None
    merged = p.get("merged_at")
    if not merged:
        return {"landing": "unknown", "landing_why": "(2) the PR closed unmerged",
                "merged_at": None} if p.get("state") == "closed" else None
    at, start = _when(merged), _when(r.get("started"))
    mcs, head = p.get("merge_commit_sha"), (p.get("head") or {}).get("sha")
    adds, dels = p.get("additions"), p.get("deletions")
    why = ("(2) no merge time or start to order" if not (at and start) else
           "(2) merged before the run started" if at <= start else
           "(3) merged into %s, not %s" % ((p.get("base") or {}).get("ref"), r["base"]) if (p.get("base") or {}).get("ref") != r["base"] else
           "(4) the merged head is not the one this run pushed" if head != r["pushed"] else
           "(5) the pushed head is the base's tip" if r["pushed"] == r["base_tip"] else
           "(6) no merge commit apart from the head" if not mcs or mcs == r["pushed"] else
           "(7) no merged_by" if not p.get("merged_by") else
           "(8) an empty diff" if not (isinstance(adds, int) and isinstance(dels, int) and adds + dels > 0) else
           "(9) a later finish run started before the merge" if later_run(r, rows, at) else None)
    return {"landing": "unknown" if why else "settled", "landing_why": why, "merged_at": merged}


def landed_row(r):
    """A row whose run landed its branch: launched, or a no-landing --settle proved merged (task-shape S1)."""
    return r.get("outcome") in common.LAUNCHED_OUTCOMES or r.get("landing") == "settled"


def rotation(argv):
    """`autofinish-run rotation`: the rows read back (the header)."""
    ap = argparse.ArgumentParser(prog="autofinish-run rotation")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--settle", action="store_true")
    ap.add_argument("--since", metavar="YYYY-MM-DD")
    args = ap.parse_args(argv)
    if common.registry_unreadable():
        print("autofinish-run rotation: the scope registry does not read — refused, no row is shown", file=sys.stderr)
        return 3
    _, why = rotation_window()
    with rotation_lock() as path:
        rows = read_rows(path)
    settled = landed = 0
    if args.settle:
        # GitHub is read outside the lock, so a run's end never waits on it; the answers are written
        # into the file as it is then, matched by session, branch and PR
        now, done, lands = time.time(), {}, {}
        for r in rows:
            if rotation_fence(r.get("primary") or ""):
                continue
            key = (r.get("session"), r.get("branch"), r.get("pr"))
            if r.get("outcome") == "stopped" and r.get("gate") == "no-landing" and r.get("landing") is None:
                upd = settle_landing(r, rows)
                if upd:
                    r.update(upd)
                    lands[key] = upd
            if landed_row(r) and r.get("settled") is None and settle_row(r, now):
                done[key] = r
        if done or lands:
            with rotation_lock() as path:
                rows = read_rows(path)
                for r in rows:
                    key = (r.get("session"), r.get("branch"), r.get("pr"))
                    if key in lands and r.get("landing") is None:
                        r.update(lands[key])
                        landed += r["landing"] == "settled"
                    s_ = done.get(key)
                    if s_ and r.get("settled") is None:
                        r.update({k: s_[k] for k in ("touched_48h", "fix_48h", "settled")})
                        settled += 1
                tmp = "%s.%d" % (path, os.getpid())
                with open(tmp, "w") as f:
                    f.writelines(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
                os.replace(tmp, path)
    open_rows = [r for r in rows if not rotation_fence(r.get("primary") or "")]
    shown = [r for r in open_rows if not args.since or str(r.get("ts") or "") >= args.since]
    arms, hosts = {}, {}
    forced = sum(1 for r in shown if r.get("forced"))
    armless = sum(1 for r in shown if not r.get("arm"))
    for r in shown:
        if r.get("forced"):
            continue   # AUTOFINISH_COIN chose it, not the coin: no read of an arm
        # a run with no arm drawn (the rotation off, since task-shape S1) is counted apart, never in an arm
        a = arms.setdefault(r.get("arm") or "(no arm)", {"runs": 0, "launched": 0, "landed_settled": 0, "stopped": {},
                                                         "other": {}, "voided": 0, "fix_48h": 0, "settled": 0, "cost": []})
        a["runs"] += 1
        if r.get("voided"):
            a["voided"] += 1
        if r.get("outcome") in common.LAUNCHED_OUTCOMES:
            a["launched"] += 1
        elif r.get("landing") == "settled":
            a["landed_settled"] += 1   # `launched (settled)`: its own count, the run's own word kept in the row
        elif r.get("outcome") == "stopped":
            a["stopped"][r.get("gate") or "?"] = a["stopped"].get(r.get("gate") or "?", 0) + 1
        else:
            a["other"][r.get("outcome") or "?"] = a["other"].get(r.get("outcome") or "?", 0) + 1
        if r.get("settled"):
            a["settled"] += 1
            a["fix_48h"] += bool(r.get("fix_48h"))
        if isinstance(r.get("cost_usd"), (int, float)):
            a["cost"].append(r["cost_usd"])
        hosts[r.get("host") or "?"] = hosts.get(r.get("host") or "?", 0) + 1
    for a in arms.values():
        c = sorted(a.pop("cost"))
        a["median_cost_usd"] = (c[len(c) // 2] if len(c) % 2 else round((c[len(c) // 2 - 1] + c[len(c) // 2]) / 2, 4)) if c else None
    out = {"window": why, "rows": len(shown), "forced": forced, "armless": armless, "fenced_now": len(rows) - len(open_rows),
           "settled_now": settled, "landings_settled_now": landed, "arms": arms, "hosts": hosts, "file": path}
    if args.json:
        print(json.dumps(out, indent=1, ensure_ascii=False))
        return 0
    print("%s; %d row(s) in %s%s%s%s" % (why, len(shown), path,
                                         ", %d settled now, %d landing(s) settled now" % (settled, landed) if args.settle else "",
                                         ", %d forced (not counted)" % forced if forced else "",
                                         ", %d with no arm (apart)" % armless if armless else ""))
    for name, a in sorted(arms.items()):
        print("  %s: %d run(s), %d launched, %d launched (settled), stopped %s, other %s, %d voided, fix in 48 h %d of %d settled, median $%s"
              % (name, a["runs"], a["launched"], a["landed_settled"], json.dumps(a["stopped"]), json.dumps(a["other"]),
                 a["voided"], a["fix_48h"], a["settled"], a["median_cost_usd"]))
    total = sum(hosts.values())
    if total:
        print("  hosts: " + ", ".join("%s %d (%d %%)" % (h, n, round(100 * n / total)) for h, n in sorted(hosts.items())))
    return 0


def finish_prompt(branch, by=None, merge=False, hold=None, sent_from=None, land_by=None):
    """The prompt the run starts with (the header's). `--from=<host>`: a run that host sent here, whose
    approval is that host's at /finish step 11.4 (D2-A, the header's Where); one word, so /finish's
    one-word branch argument stays one word. `land_by`: the mode flag a lander or chain relaunch carries
    (stuck-ships S1), so `--yolo`/`--dnd` survives a hop whose `by` is not the mode's."""
    flag = land_by if land_by in LAND_BY else by if by in LAND_BY else None
    return "/finish %s --unattended" % branch + (" --%s" % flag if flag else "") + (" --hold" if hold else "") \
        + (" --merge" if merge else "") + (" --from=%s" % sent_from if sent_from else "")


def _lander():
    """bin/autofinish as a module: landing_mode and held_slice, the ladder's one copy (S3b). None when
    it will not load (its wharf peer missing exits at import): the caller then holds."""
    try:
        return importlib.machinery.SourceFileLoader("autofinish_lander", os.path.join(HERE, "autofinish")).load_module()
    except BaseException:  # noqa: B036 — SystemExit included: a missing peer is a hold, never a crash
        return None


def main_of(t):
    try:
        with open(os.path.join(t.primary, ".claude", "workflow.json")) as f:
            return json.load(f).get("main") or "main"
    except (OSError, ValueError, AttributeError):
        return "main"


def unattended_caller():
    """True when the launch's caller is an unattended run: CLAUDE_UNATTENDED here, or, in a claimed finish's job,
    AUTOFINISH_CALLER_UNATTENDED, which queued_main sets when the entry's put came from an unattended caller. The job's
    env holds only what its plist names, so landing() there read an unattended `--by override` as a
    person (second landing review, 6). The variable can only hold a landing, never grant one. The rule is the
    core's (common.unattended_caller: REGATTA_UNATTENDED, CLAUDE_UNATTENDED, AUTOFINISH_CALLER_UNATTENDED), one
    home for council, harness and this file. A core older than that function (a plugin install whose regatta has
    not updated) reads the three variables here, as before (AGENTS.md's rename trap; round 6's third review)."""
    rule = getattr(common, "unattended_caller", None)
    if rule is None:
        return bool(os.environ.get("REGATTA_UNATTENDED") or os.environ.get("CLAUDE_UNATTENDED")
                    or os.environ.get("AUTOFINISH_CALLER_UNATTENDED"))
    return bool(rule())


def lander_flag(stop):
    """The mode flag a lander start may carry from the stop it roads: the stop's own `land_by`, else its `by` when
    that was a mode launch (start()'s land_by, before the branch's mode is weighed)."""
    stop = stop if isinstance(stop, dict) else {}
    flag = stop.get("land_by") or stop.get("by")
    return flag if flag in LAND_BY else None


def flag_rides(t, flag, stop, mode):
    """True when a relaunch may carry the stopped run's mode flag (start()'s land_by, landing()'s mode launch) — the one
    predicate both read (round 2: two copies with two inputs). The flag is the mode's yes to the taken answers: it
    rides only while the branch's mode still says it. Never under E12's standing yes with no mode: that yes is a
    person's, and the one automated caller of a lander start, helm's tick, runs under launchd with no unattended
    marker, so no caller test here can tell it from a person (round 3)."""
    return flag in LAND_BY and mode == flag


def landing(t, by, rule):
    """(hold, mode, eff) for this launch — the landing ladder (skipper-modes S3b), read here from plan.json
    (bin/autofinish's landing_mode), never from the caller: `--by` is a label any caller may type, and
    every dispatched run's allow rules pass bin/* unseen (AGENTS.md's unattended-caller trap). `hold` is
    why the run stops at a ready PR, or None when it may merge:
      - mode `ask`: every launch holds but a person's (`override` or `typed`, no CLAUDE_UNATTENDED);
      - a mode launch (`--by yolo|dnd`, or rule M): held_slice under the mode now — `yolo` merges bar the
        launcher's own gates and the repo's `autofinish_exclude`/`in_place`, `dnd` bar the held slice, any
        other mode holds (a taken answer never lands there, yolo-veto D1) — except that a yolo launch
        with no mode at all (a run from before the mode) in a `"merge": "auto"` repo keeps its standing
        yes (E12), and only from a caller without CLAUDE_UNATTENDED: a lowered mode is a mode, and a run
        typing `--by yolo` is no person (landing review 3, 4c);
      - a ship launch (`--by ship`, the keel's yes): held_slice as a mode launch, under `yolo` when the
        ship has no landing mode — the yes was given to a blueprint before any diff, so the launcher's
        gates and the repo's `autofinish_exclude`/`in_place` still hold it (S6's finish review);
      - a brief launch (`--by brief`, rule C from the yes at the brief; autofinish-exclude S7): the yes
        predates the diff, so bin/autofinish's brief_held judges it — class 2, `in_place` and the list
        hold it, class 1 and 3 land — and mode ask holds it as any launch that is not a person's;
      - a handed launch (`--by handed`, dispatch's hand-over of a done build; task-shape S2): judged as a
        typed /finish under D1-C — bin/autofinish's handed_held, whose slice is empty, holds only a diff or
        config that will not read, a binary, a `.gitattributes` change or the launcher's own gates — yet no
        person's yes: mode ask
        holds it (and a mode that cannot be read), `--merge` is refused, and with rule M it is a mode launch,
        judged by held_slice as one, so held in mode default (dispatch never sends that pair);
      - a lander launch (`--by lander`, stuck-ships S1): as a handed one; carrying the stopped run's mode flag (the
        branch's mode still that flag), as that mode's launch;
      - anything else: None, today's rules (a plain /finish --unattended, step 11.4 by host).
    `eff` is the mode a mode or ship launch was judged by (None for any other), for autofinish.json's
    `eff_mode`: bin/pr judges the launch again by it where the branch has no mode by then."""
    af = _lander()
    if af is None:
        return ("the lander's judge did not load (bin/autofinish)"
                if by in LAND_BY or rule == "M" or by in ("ship", "brief", HANDED, "lander") else None), None, None
    mode, why_mode = af.landing_mode(t.branch, t.primary or None)  # with the repo, as the sweep's verdict reads it
    # a mode that cannot be read (helm absent, a reader that raised) is no "no mode": a mode or ship launch
    # holds, as bin/pr's re-check does — read as None, a ship was judged yolo and E12 took its standing
    # yes (the second landing review)
    unread = af.mode_unreadable(why_mode)
    # `ship` is the keel's yes to merge, not a person at the keyboard: mode ask holds it too
    person = by in PERSON_BY and not unattended_caller()
    if mode == "ask" and not person:
        return "mode ask — nothing lands by itself", mode, None
    # stuck-ships S1, task-shape D1-C (the skipper's settlement, 2026-11-01): a lander start is judged as a handed
    # one, since it lands what a typed /finish lands — handed_held, bar a rule-M start, which is a mode launch; and a
    # lander start that will carry the stopped run's mode flag (`--yolo`/`--dnd`, start()'s land_by: only while the
    # branch's mode still says it) is that mode's launch too, judged by held_slice as a chain relaunch of it is
    stop = getattr(t, "stop", None) or {}
    flag = lander_flag(stop) if by == "lander" else None
    # a claimed lander start: the flag rides only where its put judged the same one (enqueue's `land_by`), settled
    # before the slice is chosen, so the start and bin/pr's re-judge read one rule (round 1)
    word = getattr(t, "flag_word", None)
    if word is not None and word[0] != flag:
        flag = None
    if by == "lander" and flag and not unread and flag_rides(t, flag, stop, mode):
        # the flag rides (flag_rides, start()'s land_by too): the mode's launch, judged by held_slice; under E12 the
        # `standing` line below grants the yes on its own terms, as for a person's yolo launch (round 2)
        by = flag
    if by == "brief":
        try:
            return af.brief_held(t.primary, t.path, main_of(t)), mode, None
        except Exception as e:  # noqa: BLE001 — what it cannot read is a hold
            return "the brief's held paths could not be read (%s)" % type(e).__name__, mode, None
    if by in (HANDED, "lander") and rule != "M":
        # judged as `typed` under D1-C (bin/autofinish's handed_held: an empty slice), bar what will not read;
        # mode ask is handed's one wall, so a mode that cannot be read holds it as it holds a mode launch
        if unread:
            return "the mode is unreadable now (%s)" % why_mode, mode, None
        try:
            return af.handed_held(t.primary, t.path, main_of(t)), mode, None
        except Exception as e:  # noqa: BLE001 — what it cannot read is a hold
            return "the %s slice could not be read (%s)" % (by, type(e).__name__), mode, None
    if by not in LAND_BY and rule != "M" and by != "ship":
        return None, mode, None
    # bin/autofinish's effective_mode: the one rule bin/pr's re-check reads too (follow-ups' landing review, item 8)
    standing = by == "yolo" and mode is None and not unread and not unattended_caller() and merge_auto(t)
    eff = af.effective_mode(by, mode, standing_yes=standing, unreadable=unread)
    if unread:
        return "the mode is unreadable now (%s)" % why_mode, mode, eff
    try:
        return af.held_slice(t.primary, t.path, main_of(t), eff), mode, eff
    except Exception as e:  # noqa: BLE001 — what it cannot read is a hold
        return "the held slice could not be read (%s)" % type(e).__name__, mode, eff


# the module tools /finish names ("Where the tools are"), each with the verb where only one is meant
FINISH_TOOLS = ("wharf-runs/bin/pickup", "wharf-runs/bin/check", "wharf-runs/bin/autofinish-run",
                "wharf-runs/bin/rc-hosts", "keel/bin/keel", "keel/bin/paste-paths", "keel/bin/owed",
                "atlas/bin/knowledge-commit", "wharf/libexec/pr", "wharf/bin/review-gate",
                "wharf-runs/bin/build-review covers",
                # the landing's own review loop (landing-fixes-in-run): its rounds and end, by the finish phase alone,
                # never the build's record, which `covers` reads (build-review refuses a --phase given twice)
                "wharf-runs/bin/build-review round * --phase finish", "wharf-runs/bin/build-review end * --phase finish",
                "wharf-runs/bin/build-review picks", "wharf-runs/bin/build-review cap",
                "wharf/hooks/carried.py", "regatta/bin/regatta which", "helloworld/bin/helloworld check")


def regatta_main():
    """The regatta main checkout this core belongs to (never a worktree, which /finish removes), as
    an absolute path, or None (a plugin install: no checkout)."""
    root = common.regatta_root()
    if not root:
        return None
    gd = subprocess.run(["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                        capture_output=True, text=True).stdout.strip()
    top = os.path.dirname(gd) if gd.endswith("/.git") else str(root)
    # the root as the caller spells it when it is the main checkout: git resolves links (/var is
    # /private/var on macOS), and a rule must read as the session types the path
    return os.path.abspath(str(root)) if os.path.realpath(top) == os.path.realpath(str(root)) else top


def handover_of(by, args_by, src):
    """(whether this start carries the hand-over note, the stamps dispatch's judge waived). A handed start reads the
    judge's own word (HANDOVER_OWED: dispatch's env on the direct start, the entry's rights on a claim); a chain or
    lander relaunch of a handed landing reads it from the stop it continues, which recorded both (`handover`, `owed`),
    else a relaunch after a review, login or limit stop held on the very items the judge waived (the re-landing's
    review, 2026-11-06)."""
    env = [x for x in os.environ.get("HANDOVER_OWED", "").split("\n") if x.strip()]
    if by == HANDED and args_by == HANDED:
        return True, env
    src = src if isinstance(src, dict) else {}
    if by in (HANDED, "lander") and (src.get("by") == HANDED or src.get("handover")):
        return True, env or [x for x in src.get("owed") or [] if isinstance(x, str)]
    return False, []


def start_cmd(t, sid, dry=False, by=None, merge=False, hold=None, arm=None, sent_from=None, priority=None, queue=None, land_by=None):
    """dispatch --start, with E1's lists. The FINISH_TOOLS rules are the modules' in
    the regatta main checkout (/finish runs its tools there since B14b, 2026-10-23, which deleted the
    overlay's shims; B14a's D1-A), in the two spellings a session types them in: under `~/` and the
    absolute path. The deny list wins over them: a held launch keeps `pr merge` denied. No regatta
    checkout (a plugin install): no such rule, and the classifier judges those calls like any other."""
    # No allow rule for the contract's check command: since D1-A (2026-10-13) a branch may launch
    # an AGENTS.md change unwatched, and an allow rule approves before the classifier looks, so
    # the check line would become pre-approved code (code review, 2026-10-13). The classifier
    # judges the check like any command; a slower run, never a wrong one.
    # No allow rule for SendMessage either (`notify`, the header): a bare one would let text in the
    # bundle steer any live session unseen; the classifier judges each send (review, 2026-10-18)
    allow = ["Agent", "EnterWorktree", "Bash(git:*)"]
    top = regatta_main()
    roots = []
    if top:
        rel = os.path.relpath(top, HOME)
        roots = (["~/" + rel] if not rel.startswith("..") else []) + [top]
    for root in roots:
        # one rule per tool the finish skill names, never modules/*/bin/* wholesale: that pre-approved
        # every module tool, live-state writers (clock, knowledge-home, scope-pass) and the core's
        # `regatta pr merge` among them, which no deny pattern matched (the B14b landing review)
        for tool in FINISH_TOOLS:
            allow += ["Bash(%s/modules/%s*)" % (root, tool), "Bash(python3 %s/modules/%s*)" % (root, tool)]
    prompt = finish_prompt(t.branch, by, merge, hold=hold, sent_from=sent_from, land_by=land_by)
    ho, owed = getattr(t, "handover", None) or handover_of(by, by, None)
    if ho:
        handover = importlib.machinery.SourceFileLoader("handover", os.path.join(HERE, "handover.py")).load_module()
        prompt += "\n\n" + handover.finish_note(t.path, t.branch, "origin/" + main_of(t), owed="\n".join(owed))
    cmd = [DISPATCH, "--start", prompt, t.path, t.window,
           "--session-id", sid]   # opus: dispatch's default (header)
    if arm:   # the rotation's arm, by full id (the header); none: dispatch's default, today's finisher
        cmd += ["--model", arm["model"], "--effort", arm["effort"]]
    if priority:   # force-any: the finish's rank, judged in run_main (prio_refusal)
        cmd += ["--priority", priority]
    if queue:   # a claimed finish: dispatch's start holds that claim's slot and asks `mine` again (finish-as-task)
        cmd += ["--queued", queue[0], "--job", queue[1]]
    for a in allow:
        cmd += ["--allow", a]
    lift = ["Bash(git push:*)", "Bash(*bin/pr ready*)", "Bash(*bin/pr merge*)",
            "Bash(*libexec/pr ready*)", "Bash(*libexec/pr merge*)",
            "Bash(*regatta pr ready*)", "Bash(*regatta pr merge*)"]
    if hold:
        # a held launch (landing(): mode ask, the dnd slice, a mode lowered since, E12's yolo outside a
        # `"merge": "auto"` repo) stops at a ready PR. The skill says so; this makes it so — prose alone
        # did not hold once (bin/dispatch, idea-redaction, 2026-10-04)
        lift.remove("Bash(*bin/pr merge*)")
        lift.remove("Bash(*libexec/pr merge*)")
        lift.remove("Bash(*regatta pr merge*)")
    for d in lift:
        cmd += ["--undeny", d]
    return cmd + (["--dry-run"] if dry else [])


def merge_auto(t):
    """The repo's standing yes: `"merge": "auto"` in .claude/workflow.json on origin/<main> (main's
    name read from the primary's copy), as /finish step 11.4 reads it. Unreadable: no."""
    try:
        cfg = json.loads(git(t.path, "show", "origin/%s:.claude/workflow.json" % main_of(t)) or "{}")
    except ValueError:
        return False
    return isinstance(cfg, dict) and cfg.get("merge") == "auto"


def start_env(t):
    env = {k: v for k, v in os.environ.items()
           if not (k.startswith("CLAUDE") and k not in KEEP_CLAUDE) and k not in DROP_DISPATCH + DROP_JOB + DROP_MARK}
    env["DISPATCH_LOG"] = t.runlog
    return env


ORIGIN_MOVE = "autofinish-origin.json"   # the gate's last fast-forward, for a start after a fast-forward-and-stop


def origin_note(t):
    """What the origin gate took in, for the run (the header's): empty unless a fast-forward made this tip — this
    start's, or one an earlier start made and then stopped on (every caller but a person's), read from ORIGIN_MOVE
    while the tip is still the one it moved to."""
    old = getattr(t, "moved_from", None)
    if not old:
        try:
            with open(os.path.join(t.state_dir, ORIGIN_MOVE)) as f:
                rec = json.load(f)
            old = rec.get("from") if rec.get("to") == t.tip else None
        except (OSError, ValueError, AttributeError):
            old = None
    if not old:
        return ""
    # `keel pull` finds nothing once the tree holds origin's tip, so the answers are named by the diff that brought them
    return ("The origin gate fast-forwarded this worktree from %s to %s before this run, so /finish's step that takes in "
            "what GitHub has finds nothing to take, and `keel pull` reports nothing new. Read these commits as that step "
            "would; if one answers a memo, `git diff %s %s -- <memo>` shows the answers: act on them before step 6:\n%s\n\n" % (
                old[:7], t.tip[:7], old[:7], t.tip[:7],
                git(t.path, "log", "--format=%h %s", "%s..%s" % (old, t.tip)).replace("\n", "\n  ").join(["  ", ""])))


def bundle_text(t):
    """The origin gate's note, then pickup's context bundle for the branch, as `pickup open --here` prints it."""
    return origin_note(t) + pickup_bundle(t)


def pickup_bundle(t):
    """pickup's context bundle, or a line saying what to read instead."""
    try:
        from pathlib import Path
        pk = load_bin("pickup")
        root = pk.repo_root(Path(t.path))
        data = pk.collect(root, fetch=False)
        b = pk.resolve(t.branch, data["branches"])
        s = b["sessions"][0] if b["sessions"] else None
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            pk.context_bundle(b, data, s)
        return buf.getvalue()
    except Exception as e:  # pickup's Stop included: the run goes on from git alone
        return ("(no bundle: pickup could not read %s — %s: %s. The branch's commits carry its "
                "prompts: git log --reverse --format='%%h %%s%%n%%b' main..HEAD)\n" % (t.branch, type(e).__name__, e))


def write_bundle(t, st):
    """The bundle, from this host's transcripts. A finish claimed from another host's put says so at its head: the
    branch's sessions ran there, and their record is that host's (finish-as-task: no transcript rides in an entry)."""
    path = os.path.join(t.state_dir, BUNDLE)
    text = bundle_text(t)
    if st.get("from") and str(st["from"]).lower() != self_host():
        text = ("(this finish was put on %s and claimed here: the branch's sessions there are not in this record; "
                "read the branch's commits and its PR for what they did)\n\n%s" % (st["from"], text))
    with open(path, "w") as f:
        f.write("# The conversation's record for /finish %s --unattended\n\n" % t.branch)
        f.write("Written %s by bin/autofinish-run for session %s, tip %s — read it as the old "
                "session's record (design section 7): its prompts, its last asks and replies.\n\n"
                % (now_iso(), st["session"], t.tip[:7]))
        f.write(text)
    return path


# ---- after the end -------------------------------------------------------------------------------

def transcript(sid):
    dirs = {os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude"), os.path.join(HOME, ".claude")}
    for d in dirs:
        hits = glob.glob(os.path.join(d, "projects", "*", sid + ".jsonl"))
        if hits:
            return hits[0]
    return None


def last_reply(sid):
    """The session's last assistant text (a subagent's sidechain is not the session's), or None."""
    text = None
    try:
        with open(transcript(sid), errors="replace") as f:
            for line in f:
                if '"assistant"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") != "assistant" or rec.get("isSidechain"):
                    continue
                content = (rec.get("message") or {}).get("content")
                if isinstance(content, list):
                    said = "\n".join(c.get("text", "") for c in content
                                     if isinstance(c, dict) and c.get("type") == "text").strip()
                    text = said or text
    except (OSError, TypeError):
        return None
    return text


def push_sent(sid, branch):
    """The sha (as git abbreviated it) the session's own last `git push` sent to the branch, read from that
    push's report in the transcript; None when no push of it succeeded. A tool result is read only when its
    call was a `git … push`, so a log the session printed never counts (task-shape S1). UP_TO_DATE when that last
    push of it (its command naming the branch) found origin already there: the checkpoint hook pushed first."""
    pushes, sent = {}, None
    try:
        with open(transcript(sid), errors="replace") as f:
            for line in f:
                if '"tool_use' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("isSidechain"):
                    continue
                for c in (rec.get("message") or {}).get("content") or []:
                    if not isinstance(c, dict):
                        continue
                    if c.get("type") == "tool_use" and c.get("name") == "Bash":
                        cmd = str((c.get("input") or {}).get("command") or "")
                        if re.search(r"\bgit\b.*\bpush\b", cmd):
                            pushes[c.get("id")] = cmd
                    elif c.get("type") == "tool_result" and c.get("tool_use_id") in pushes:
                        body = c.get("content")
                        if isinstance(body, list):
                            body = "\n".join(str(b.get("text") or "") for b in body if isinstance(b, dict))
                        body, hit = str(body or ""), None
                        for l in body.splitlines():
                            m = PUSH_LINE_RE.match(l)
                            if m and m.group(2) in (branch, "refs/heads/" + branch):
                                hit = m.group(1)
                        if not hit and "Everything up-to-date" in body and re.search(
                                r"(?:^|[\s:])%s(?:$|[\s:])" % re.escape(branch), pushes[c.get("tool_use_id")]):
                            hit = UP_TO_DATE
                        sent = hit or sent
    except (OSError, TypeError):
        return None
    return sent


def remote_heads(t, *names):
    """{name: sha} of origin's branches by `ls-remote`, at this moment; None when origin did not answer."""
    rc, out, _ = quiet_git(t.primary, "ls-remote", "origin", *("refs/heads/" + n for n in names), timeout=30)
    if rc != 0:
        return None
    heads = {}
    for l in out.splitlines():
        sha, _, ref = l.partition("\t")
        if ref.startswith("refs/heads/"):
            heads[ref[len("refs/heads/"):]] = sha
    return heads


def landing_fields(t, sid):
    """{pushed, base, base_tip} for the record and the row (task-shape S1). `pushed` is the sha the finish's
    own push sent, kept only when origin's branch still holds it at the run's end (a later push, the hook's or
    another run's, or a branch already merged and deleted reads unknown); never the local HEAD alone. A push
    that found origin up to date names no sha: origin's head counts only while the worktree's HEAD is it too."""
    base = main_of(t)
    heads = remote_heads(t, t.branch, base) or {}
    sent = push_sent(sid, t.branch)
    now = heads.get(t.branch)
    if sent == UP_TO_DATE:
        path = getattr(t, "path", None)
        pushed = now if now and path and git(path, "rev-parse", "HEAD") == now else None
    else:
        pushed = now if sent and now and now.startswith(sent) else None
    return {"pushed": pushed, "base": base, "base_tip": heads.get(base)}


def tail_lines(path, offset=0, n=8):
    try:
        with open(path, errors="replace") as f:
            f.seek(offset)
            lines = [l.rstrip() for l in f if l.strip().strip("\0")]
    except (OSError, TypeError):
        return []
    return lines[-n:]


def gate_of(warn):
    """The gate a ⚠ line names: its step first ("⚠ step 1 — not merged" is G1, never the merge's G11),
    step 1 split into the review's G1r and the check's G1; else the first of GATE_WORDS it holds as words."""
    m = STEP_RE.search(warn)
    if m:
        if m.group(1) == "1":
            # G1r only when the review is the stop the line names: the first of the two after the step, so
            # "the check failed; the review never ran" stays G1 (the fix round of 2026-10-30)
            rest = warn[m.end():].lower()
            rv, ck = REVIEW_RE.search(rest), gate_word("check").search(rest)
            return "G1r" if rv and not (ck and ck.start() < rv.start()) else "G1"
        return "G%s" % m.group(1)
    low = warn.lower()
    return next((g for w, g in GATE_WORDS if gate_word(w).search(low)), "stop")


def gate_word(w):
    """A GATE_WORDS entry as a word and its forms: "open items", "merged", "pushes", "reviewer", "deployment",
    "unmerged", "automerge", "redeploy", never the entry inside a longer word ("checkpoint", "alive")."""
    stem, forms = ((w[:-1], "e|es|ed|ing|er|ers|ement|ements") if w.endswith("e") else
                   (w, "|s|es|ed|ing|er|ers|ment|ments"))
    # a prefix main's substring match also read: "automerge", "redeploy", "recheck", "deadlock" (S1's landing review)
    return re.compile(r"\b(?:un|re|auto|dead|pre|non-?)?%s(?:%s)\b" % (re.escape(stem), forms))


def read_outcome(t, sid, log_from):
    """(outcome, pr, gate, lines): lines is what the log, the record and a comment quote."""
    path, rec = run_record(sid)
    if not path:
        return "never-started", None, REFUSED, tail_lines(t.runlog, log_from) or ["(dispatch wrote nothing)"]
    text = last_reply(sid)
    if not text:
        shown = tail_lines(path + ".screen.txt", 0, 15)   # dispatch-rc's hardcopy of a never-busy screen
        return "never-started", None, "never-started", shown or tail_lines(t.runlog, log_from) or [
            "(no reply, no screen: %s)" % rec.get("end_reason", "?")]
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    # a ⚠ anywhere is a stop, read before any launch marker: a stop report may well name another
    # PR's merge or quote a rollback line (review, 2026-10-05: `merged #57` read as launched)
    warn = next((i for i, l in enumerate(lines) if "⚠" in l), None)
    if warn is not None:
        block = [l for l in lines[warn:] if not common.closing_kind(l)]
        return "stopped", None, gate_of(lines[warn]), block
    rollback = ROLLBACK_RE.search(text)
    if common.ending(text)[0] == "done" and (rollback or "Shipped:" in text):
        m = MERGED_RE.search(text) or PULL_RE.search(text) or HASH_RE.search(
            next((l for l in lines if "Shipped:" in l), "")) or HASH_RE.search(text)
        pr = int(m.group(1)) if m else merged_pr(t)
        return "launched", pr, None, [rollback.group(0).strip()] if rollback else lines[-1:]
    # the gate tokens are persisted, so they keep their word; /finish's text says either (rename S4)
    gate = "nothing-to-land" if ("Nothing to land" in text or "Nothing to launch" in text) else "no-landing"
    return "stopped", None, gate, lines[-1:]


def slug(t):
    """owner/name of origin as configured (not `get-url`, which expands insteadOf)."""
    return common.repo_slug(git(t.primary, "config", "--get", "remote.origin.url"))


def merged_pr(t):
    """The launched PR's number when the reply names none: the newest merged PR of this head."""
    s = slug(t)
    if not s:
        return None
    st, prs = common.api("GET", "/repos/%s/pulls?state=closed&per_page=5&head=%s:%s"
                         % (s, s.split("/")[0], urllib.parse.quote(t.branch, safe="")))
    hit = next((p for p in prs or [] if isinstance(p, dict) and p.get("merged_at")), None) if st == 200 else None
    return hit.get("number") if hit else None


FINISH_LOOP = "build-review-finish.json"   # build-review --phase finish: the landing's own review loop


def findings_left(t, st):
    """True when this run's own review loop stopped with findings left: build-review's finish record (beside this
    state) kept by this run's session, ended held or cap. A G1r stop that is not so (a plan refused, a principal
    route, reviewers that never ran) has no fix round to hand on (the round-1 verifier's finding)."""
    try:
        with open(os.path.join(t.state_dir, FINISH_LOOP)) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return False
    return isinstance(d, dict) and d.get("session") == st.get("session") and d.get("outcome") in ("held", "cap")


def fix_round_line(t, st):
    """The Do-this-now line of a review stop (G1r) with real findings left: the fix round, dispatched at the landing's
    own priority, else high (landing-fixes-in-run, the owner, 2026-11-03: claim-after-failed-start's stop was queued
    as a plain `normal` build, rank 19-23 behind the fleet, hours of wait). A finish ranks ahead of a build of the same
    priority (dispatch-queue's rank()), and its fix round is the finish's tail, so it never waits behind the builds the
    finish already outranked. Its brief is the stop's own: the finish skill commits a `## Fix round` brief on the
    branch before it stops (step 1), so dispatch finds one on a branch /finish never curated. For whoever acts on the
    stop, the owner or a skipper: an unattended caller may not raise a run's priority (dispatch's force-any rule)."""
    prio = st.get("priority") if st.get("priority") in ("high", "force") else "high"
    return ("**Do this now** — the fix round, at the landing's priority (`%s`; a finish ranks ahead of a build, and "
            "its fix is the finish's tail, so never a plain `normal` dispatch): `%s %s --repo %s --priority %s`. Its "
            "brief is the `## Fix round` section the run committed in `docs/handoff/` on the branch; once that round "
            "ends clean, its landing starts as any build's does." % (
                prio, shlex.quote(os.path.join(HERE, "dispatch")), shlex.quote(t.branch), shlex.quote(t.primary), prio))


def comment(t, st, outcome, gate, lines):
    """The stop, on the branch's PR. Returns (pr number or None, what happened)."""
    s = slug(t)
    if not s:
        return None, "no comment: origin is not on GitHub"
    pr = common.find_pr(s, t.branch)
    if not pr:
        return None, "no comment: no open pull request for %s" % t.branch
    what = {"never-started": "never started", DIED: "runner died"}.get(outcome) or "stopped at %s" % gate
    head = ("**autofinish %s** — `%s`, session `%s`, tip `%s`, rule %s, started by %s at %s."
            % (what, finish_prompt(t.branch, st.get("by"), st.get("merge"), st.get("hold"), st.get("from"), st.get("land_by")), st["session"], str(st.get("tip") or t.tip)[:7], st.get("rule"), st.get("by"),
               st.get("started")))
    quoted = "\n".join(lines)
    if len(quoted) > COMMENT_CAP:
        quoted = quoted[:COMMENT_CAP - 1] + "…"
    if outcome == DIED:  # its words first, then dispatch's log as it was left
        why = DIED_WHY
        body = head + "\n\n" + why + ".\n\n" + ("```\n%s\n```" % quoted) + (
            "\n\nThe sweep may judge this branch once more — not once this PR is out of `WIP:`, nor "
            "a branch the runner had already curated locally; a second death on this tip waits for a prompt. "
            "The transcript, if any, is session `%s` on %s." % (st["session"], common.host_name()))
    else:
        body = head + "\n\n" + ("```\n%s\n```" % quoted if outcome == "never-started" else quoted) + (
            # G1 too: a held or capped loop's ⚠ line may name the check before the review (round 2's verifier);
            # findings_left is what proves the stop is the run's own loop
            "\n\n" + fix_round_line(t, st) if outcome == "stopped" and gate in ("G1", "G1r") and findings_left(t, st)
            else "") + (
            "\n\nNothing retries on this tip. A new commit can be started again; the transcript is "
            "session `%s` on %s." % (st["session"], common.host_name()))
    code, _ = common.api("POST", "/repos/%s/issues/%d/comments" % (s, pr["number"]), {"body": body})
    return pr["number"], ("commented on #%d" % pr["number"] if code == 201
                          else "comment on #%d refused (HTTP %s)" % (pr["number"], code or "none"))


def release(t, sid):
    """The lock if it is still this session's, and a `finishing` marker. Returns what was done."""
    done = []
    lock = common.read_owner(t.state_dir)
    if lock and lock.get("session") == sid:
        try:
            os.remove(os.path.join(t.state_dir, common.OWNER_FILE))
            done.append("lock released")
        except OSError as e:
            done.append("lock NOT released: %s" % e)
    marker = os.path.join(t.state_dir, "finishing")
    if os.path.exists(marker):
        try:
            os.remove(marker)
            done.append("finishing marker removed")
        except OSError as e:
            done.append("finishing marker NOT removed: %s" % e)
    return done


def end_live_run(sid):
    """A run still going when its waiter is ended (SIGTERM, a crash here): ended the way
    `dispatch --end` ends one, so nothing frees its lock under it. True when it was live."""
    path, _ = run_record(sid)
    if not path:
        return False
    rc = load_bin("dispatch-rc")
    st = rc.load(path)
    if st.get("ended") or not rc.same(st):
        return False
    reason = "ended with its autofinish waiter"
    cur = rc.load(path)
    cur["ending"] = reason
    rc.save(path, cur)
    if rc.end_session(st):
        rc.finish(path, rc.load(path), reason)
    return True


def wait_for_end(t, st, cmd):
    """The detached child: bundle, start, wait; then, whatever happened, the lock and the record."""
    def term(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)   # a closing terminal is not an end
    sid, rc, why = st["session"], None, None
    try:  # its pid for dead(); autofinish.json's keys are the hooks' contract, so a file of its own
        rc_mod = load_bin("dispatch-rc")
        with open(os.path.join(t.state_dir, WAITER), "w") as f:
            json.dump({"session": sid, "pid": os.getpid(), "start": rc_mod.proc_start(os.getpid())}, f)
    except Exception:
        traceback.print_exc()
    try:
        log_from = os.path.getsize(t.runlog)
    except OSError:
        log_from = 0
    p = None
    try:
        print("%s autofinish-run: bundle %s" % (now_iso(), write_bundle(t, st)), flush=True)
        with common.finish_pick_env(start_env(t), target="dispatch") as (env, fds):
            p = subprocess.Popen(cmd, env=env, pass_fds=fds)
        rc = p.wait()
    except BaseException as e:  # SystemExit from SIGTERM included: the finally below is the point
        signal.signal(signal.SIGTERM, signal.SIG_IGN)   # a second TERM must not cut the cleanup short
        why = "the waiter ended: " + ("signal %s" % e.code if isinstance(e, SystemExit) else type(e).__name__)
        if not isinstance(e, SystemExit):
            traceback.print_exc()
        # dispatch gets a TERM it can clean up after (its start lock, its plist), not subprocess.call's KILL
        if p and p.poll() is None:
            p.terminate()
            try:
                p.wait(timeout=30)
            except subprocess.TimeoutExpired:
                p.kill()
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        notes = []
        try:
            if why and end_live_run(sid):
                notes.append("its live session ended")
        except Exception:
            traceback.print_exc()
        notes += release(t, sid)
        try:
            record(t, st, log_from, rc, why, notes)
        except Exception:
            traceback.print_exc()
            # still an end in the state: an `ended: null` would read as a run going on forever
            try:
                if not (read_state(t) or {}).get("ended"):
                    st.update(ended=now_iso(), outcome="stopped", gate="error")
                    write_state(t, st)
            except Exception:
                traceback.print_exc()
            log("%s run %s %s error session=%s — %s" % (now_iso(), t.repo, t.branch, sid[:8],
                                                         "the outcome could not be recorded; " + "; ".join(notes)))


def record_line(ended, outcome, branch, gate, pr, first, tip=None):
    """`<iso> <outcome> <branch> <detail>`: the shape hooks/common.py's autofinished() parses, and its
    phrase reads an empty launched detail as `#?` — never a `#None`; a died line as bury() writes it."""
    if outcome in common.LAUNCHED_OUTCOMES:
        detail = "%s %s%s" % (outcome, branch, " #%s" % pr if pr else "")
    elif outcome == "never-started":
        detail = "never-started %s %s" % (branch, first)
    elif outcome == DIED:
        detail = "died %s %s %s" % (branch, str(tip or "")[:7], first)
    else:
        detail = "stopped %s %s %s" % (branch, gate, first)
    return (str(ended) + " " + detail).rstrip()


def record(t, st, log_from, rc, why, notes):
    sid = st["session"]
    outcome, pr, gate, lines = read_outcome(t, sid, log_from)
    if why and outcome not in common.LAUNCHED_OUTCOMES:
        lines = [why] + lines
    if st.get("hold") and outcome == "stopped" and gate == "G11":
        # the held landing (S3b): the gate says so, and the line names the class whatever the model
        # wrote, so the board's held card (helm_render) reads it from `autofinished`, not from prose
        gate, lines = "held", ["held (%s): %s" % (st["hold"], lines[0] if lines else "a ready PR waits for the owner's tap")] + lines[1:]
    said = ""
    if outcome not in common.LAUNCHED_OUTCOMES and gate not in REFUSED_GATES:
        pr, said = comment(t, st, outcome, gate, lines)
    st["ended"] = now_iso()   # the run's end, before ls-remote's up to 30 s below
    if gate not in REFUSED_GATES:   # what --settle proves a landing by (task-shape S1); nothing ran: nothing to prove
        try:
            st.update(landing_fields(t, sid))
        except Exception as e:  # noqa: BLE001 — an unread push is an unknown row, never a lost record
            notes = list(notes) + ["landing fields unread (%s)" % type(e).__name__]
        try:   # stuck-ships S1: the PR's auto-merge request at the stop, never at a later fetch
            st["automerge"] = automerge_at_end(t)
        except Exception as e:  # noqa: BLE001 — an unread request is no key, never a lost record
            notes = list(notes) + ["automerge unread (%s)" % type(e).__name__]
    st.update(outcome=outcome, pr=pr, gate=gate)
    write_state(t, st)
    if gate in REFUSED_GATES and st.get("by") == "lander":
        # an unconfirmed lander start dispatch refused after all: nothing ran, its road given back here,
        # before another start can replace this record and leave the spend unmatched (review 3)
        try:
            refund_session(t, sid)
        except (OSError, StoreUnreadable) as e:
            notes = list(notes) + ["lander refund not written (%s)" % type(e).__name__]
    # /autofinish's marker has done its job once a run ended: left behind, a `now` marker would
    # have the Stop hook judge the branch again at every later turn's end (E3's note)
    if gate not in REFUSED_GATES:
        try:
            os.unlink(os.path.join(t.state_dir, common.AUTOFINISH_OVERRIDE))
        except OSError:
            pass
        # the yes at the brief (S7) is used up the same way: left behind it would lift `autofinish: off`
        # and the gates for every later tip of this branch, or a recreated one (landing review, finding 7);
        # a chain relaunch keeps `--by brief` in its own record and needs no brief
        if st.get("by") == "brief" and t.common:
            try:
                os.unlink(os.path.join(t.common, "claude", BRIEFS, urllib.parse.quote(t.branch, safe="") + ".json"))
            except OSError:
                pass
    first = lines[0] if lines else ""
    line = record_line(st["ended"], outcome, t.branch, gate, pr, first, t.tip)
    if gate not in REFUSED_GATES:   # nothing ran: no record for the session start to report
        os.makedirs(os.path.join(t.common, "claude"), exist_ok=True)
        with open(os.path.join(t.common, "claude", RECORD), "a") as f:
            f.write(line + "\n")
    finished_word(st, outcome, gate, pr, line if gate not in REFUSED_GATES else None)
    try:
        fenced = rotation_row(t, st, outcome, gate, pr) if gate not in REFUSED_GATES else None
    except Exception as e:  # noqa: BLE001 — a lost row is said, never a lost record
        fenced = "no rotation row: %s" % type(e).__name__
    extra = [x for x in (said, "dispatch exit %s" % rc if rc not in (0, None) else "", fenced) + tuple(notes) if x]
    log(common.RUN_END % (
        st["ended"], t.repo, t.branch, outcome, " gate=%s" % gate if gate else "",
        " pr=#%s" % pr if pr else "", sid[:8], t.tip[:7], st.get("rule"), st.get("by"), st.get("account") or "-",
        first[:300], "; " + "; ".join(extra) if extra else ""))


def automerge_at_end(t):
    """The open PR's auto-merge request as GitHub reads it now ({"merge_method", "enabled_by"}), or None: none set,
    no open PR (a merged one has none to read), or origin not on GitHub."""
    s = slug(t)
    pr = common.find_pr(s, t.branch) if s else None
    am = pr.get("auto_merge") if isinstance(pr, dict) else None
    if not isinstance(am, dict):
        return None
    return {"merge_method": am.get("merge_method"), "enabled_by": (am.get("enabled_by") or {}).get("login")
            if isinstance(am.get("enabled_by"), dict) else None}


def runlog_of(t, st):
    """The dispatch log a run wrote to: named for the day it started (Tree's is today's)."""
    day = str(st.get("started") or "")[:10] or log_day()
    return os.path.join(LOGS, "%s-dispatch-finish-%s.log" % (day, t.topic))


def waiter_alive(state_dir, sid):
    """True while the run's waiter (autofinish-waiter.json, same session) still runs."""
    try:
        with open(os.path.join(state_dir, WAITER)) as f:
            w = json.load(f)
    except (OSError, ValueError):
        return False
    if not isinstance(w, dict) or w.get("session") != sid or not isinstance(w.get("pid"), int):
        return False
    return load_bin("dispatch-rc").running(w["pid"], w.get("start"))


def dead(t, st, now=None, state_dir=None, apply=True):
    """Why this worktree's run died without an outcome, or None: no run, an ended one, or one that
    may still live. Never a guess on the dying side — a waiter still running, a watcher not yet
    recorded, or a dispatch end its waiter is still recording, is no death. `apply` False is read-only
    (bin/autofinish's verdicts and `--dry-run`), with no record written; the armed sweep's bury pass,
    before the verdicts, asks."""
    if not st or st.get("ended") or not st.get("session") or not st.get("started"):
        return None
    if state_dir and waiter_alive(state_dir, st["session"]):
        return None
    if st.get("host") and str(st["host"]).lower() != self_host():
        # a run the peer road sent there before the queue (finish-as-task): its end is that host's, unknown here — never
        # buried `died` (the sweep would retry a tip that host may still run); a person's /finish or a new commit goes on
        return None
    now = time.time() if now is None else now
    try:
        started = datetime.datetime.fromisoformat(st["started"]).timestamp()
    except (TypeError, ValueError):
        started = 0
    path, _ = run_record(st["session"])
    if not path:
        if now - started < PRE_START_S:
            return None
        return "no dispatch record %d min after its start" % ((now - started) // 60)
    rc = load_bin("dispatch-rc")
    try:
        rec = rc.load(path)
        age = now - os.path.getmtime(path)
    except (OSError, ValueError):
        return None
    if rec.get("ended"):
        ended = rec["ended"] if isinstance(rec["ended"], (int, float)) else now - age
        if now - ended < PRE_START_S:
            return None
        return "dispatch ended the run %d min ago (%s) and no outcome was recorded" % (
            (now - ended) // 60, rec.get("end_reason") or "no reason")
    if rc.same(rec):
        return None
    w = rec.get("watcher")
    if isinstance(w, int):
        if not rc.watcher_gone(rec):
            return None
    elif age < PRE_START_S:
        return None   # no watcher recorded yet: dispatch may still be starting it
    return "claude (pid %s) and its watcher (pid %s) are gone, and dispatch wrote no end" % (
        rec.get("pid"), w if isinstance(w, int) else "never recorded")


def bury(t, why):
    """Record the dead run as the waiter's `finally` would have: the state, the lock, the PR, the
    record and the log. Under the start lock, the state read again: None when another start or
    an end got there first, else the log line written."""
    held = take_start_lock(t)
    if not held:
        return None
    try:
        st = read_state(t)
        if not st or st.get("ended"):
            return None
        sid = st["session"]
        holder = (common.read_owner(t.state_dir) or {}).get("session")
        notes = release(t, sid) if not holder or holder == sid else [
            "the lock is session %s's now: left as it is" % str(holder)[:8]]
        _, rec = run_record(sid)
        if rec and rec.get("ended"):  # the session ended, only its waiter died: its reply is the outcome
            record(t, st, 0, None, None, notes + ["recorded after its waiter died (%s)" % why])
            return "%s run %s %s recorded after its waiter died — %s" % (now_iso(), t.repo, t.branch, why)
        last = tail_lines(runlog_of(t, st), 0, 1)
        lines = last or ["(its dispatch log %s is empty or gone)" % runlog_of(t, st)]
        pr, said = None, ""
        try:
            pr, said = comment(t, st, DIED, None, lines + ["(%s)" % why])
        except Exception as e:  # noqa: BLE001 — GitHub down is no reason to leave the run undead
            said = "no comment: %s" % type(e).__name__
        st.update(ended=now_iso(), outcome=DIED, pr=pr, gate=None)   # ended after the comment: the
        write_state(t, st)                                           # retry's GitHub quiet starts here
        os.makedirs(os.path.join(t.common, "claude"), exist_ok=True)
        died_line = "%s died %s %s %s" % (st["ended"], t.branch, str(st.get("tip"))[:7], lines[0])
        with open(os.path.join(t.common, "claude", RECORD), "a") as f:
            f.write(died_line + "\n")
        finished_word(st, DIED, None, pr, died_line)
        try:
            fenced = rotation_row(t, st, DIED, None, pr)
        except Exception as e:  # noqa: BLE001 — a lost row is said, never a lost record
            fenced = "no rotation row: %s" % type(e).__name__
        extra = [x for x in [said, why, fenced] + notes if x]
        line = "%s run %s %s died session=%s tip=%s rule=%s by=%s account=%s — %s; %s" % (
            st["ended"], t.repo, t.branch, sid[:8], str(st.get("tip"))[:7], st.get("rule"), st.get("by"),
            st.get("account") or "-", lines[0][:300], "; ".join(extra))
        log(line)
        return line
    finally:
        try:
            os.remove(held)
        except OSError:
            pass


# ---- where: the queue (the header's Where; finish-as-task) ----------------------------------------

QUEUE = os.environ.get("AUTOFINISH_QUEUE") or os.path.join(HERE, "dispatch-queue")
QUEUE_S = 120   # a queue verb's bound: its fetch may wait 45 s for the clone's lock and 30 s for the home
OWN_FRESH_S = int(os.environ.get("AUTOFINISH_OWN_FRESH_S") or 600)   # the variable is the suite's (test_finish_queue)
# OWN_FRESH_S: a claim this soon after its put, on the putting host, is the put's own handover: its caller's lock and
                    # its tree as they are; later, the caller may be at work again, and the start judges both as any
_PUT = [False]      # the put was sent: a crash after it exits not confirmed, never "nothing ran"


def queue_home():
    """True when this host has a queue home (`dispatch-queue home` exits 0): then every finish is a queue entry."""
    try:
        return subprocess.run([sys.executable, QUEUE, "home"], capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def queue_word(*argv):
    """(rc, out, err) of one dispatch-queue verb; never raises (a word that did not land is said, never a lost run)."""
    try:
        r = subprocess.run([sys.executable, QUEUE] + list(argv), capture_output=True, text=True, timeout=QUEUE_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 5, "", str(e)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def finished_word(st, outcome, gate, pr, line=None):
    """A claimed finish's outcome into its queue entry (dispatch-queue finished): the tombstone that keeps its tip
    from a second run on any host, or, for a start that never ran, the entry gone so the tip may start again."""
    if not st.get("queue"):
        return
    rc, out, err = queue_word("finished", st["queue"], "--session", st["session"], "--outcome", str(outcome),
                              "--gate", str(gate or ""), "--pr", str(pr or ""), *(["--line", line[:500]] if line else []))
    if rc:
        print("autofinish-run: the queue did not take %s's outcome (exit %d: %s)" % (st["queue"], rc, (err or out)[-200:]))


def ladder_stay(t, args, by):
    """Why the landing ladder pins this finish to this host, or None. landing() reads this host's helm plans
    (bin/autofinish's landing_mode), the yes at a brief and the keel's no from this host's state; another host has
    none of them, so its claim would judge the run afresh and could merge what this host holds. A plain landing —
    no hold, no mode, no mode or ship launch — goes to any host; carrying the ladder's verdict in the entry is open
    (TODO.md [finish-ladder])."""
    hold, mode, keel_hold = getattr(t, "ladder", (None, None, False, None))[:3]
    if hold or keel_hold:
        return "the landing ladder holds it (%s), judged by this host's plans" % hold
    if mode or by in LAND_BY or by == "ship" or args.rule == "M":
        return "a %s launch is judged by this host's plans" % (
            "mode %s" % mode if mode else "--by %s" % by if by in LAND_BY + ("ship",) else "rule M")
    if by == "brief":
        return "a --by brief launch is this host's yes at the brief"
    if by == HANDED:
        return "a --by handed launch is judged by this host's plans (mode ask holds it)"
    # stuck-ships S1: a lander start's caps are this host's lander.json, and its road judged this host's record of the
    # stop; carrying either to the fleet is TODO.md [finish-ladder]'s
    if by == "lander":
        return "a --by lander start is this host's road, its caps in this host's lander.json"
    return None


def finish_runs_here():
    """Whether this host may claim a finish: dispatch-queue's `finish-queue` need, judged as builtin_met and the feature
    line judge it for the host itself (Darwin or local readiness, an explicit grant, and a negation over either). A
    pin to a host that cannot claim a finish is a deadlock: no host may take the entry, and it waits for a person (the
    node's handed landing of principal tier S4, 2026-11-04: `queue-unclaimed`, cancelled by hand and put again from a
    Mac). A queue module that will not load reads as yes: the pin as before."""
    try:
        dq = load_bin("dispatch-queue")
        h = dq.host_name()
        feats = dq.features()
        grants = feats.get(h, set())
        return dq.finish_feature_refusal(h, feats) is None and (
            dq.FINISH_NEED in grants or dq.builtin_met(dq.FINISH_NEED, h))
    except BaseException:   # core_path.require() exits on a missing core
        return True


def enqueue(t, args, by, via):
    """The finish put in the queue (dispatch --queue-finish): one entry of kind finish at this tip, with its rights
    (by, rule, merge, hold, from, digest), claimed here at once with room, else by any host with room — pinned here
    when only this host can judge or run it (`--on here`, the ladder where this host claims finishes, a tip origin lacks). The warm run of the branch
    here is ended first and the tip pushed when origin lacks it, so the host that claims it lands this tip. Nothing
    of the run is written here: no state, no lock, no waiter (the claiming host's start writes its own)."""
    if not getattr(t, "warm_ended", False):   # the origin gate ended it, to move the tree
        busy = end_warm(t, args, cap=left(t, 90))
        if busy:
            return refuse(t, args, busy)
        t.warm_ended = True
        tip = git(t.path, "rev-parse", "HEAD")
        if tip and tip != t.tip and not args.dry:
            print("autofinish-run: %s moved to %s as its warm run ended: that tip is the one queued" % (t.branch, tip[:7]))
            t.tip = tip
            stop = judged_stop(t, args)
            if stop:
                raise TipMoved(stop)
    pin = "--on here" if args.on == "here" else ladder_stay(t, args, by)
    # the ladder's pin goes where this host cannot run a finish: the entry goes to the fleet, and a hold the ladder
    # judged here rides in its rights (a ready PR wherever it is claimed), so no other host merges what this one holds
    # at the put; a mode changed here later is not seen there. The hold rides as `--hold`, which the claimer records as
    # the keel's sticky no for that worktree until a hold of its own can travel (TODO.md [finish-ladder]).
    # Kept pinned, as before (each waits unclaimed there, TODO.md [finish-ladder]): a typed --on here, the caller's own
    # word; a ship (the claimer's ship_refusal reads the keel's yes from its own plans, and its exit 2 tombstones the
    # tip `failed`); a brief (its yes file lives in this host's git dir, used up only where the run ends); and a chain
    # whose launch resolved to another --by here (the rights carry `chain`, which the claimer judges as plain);
    # a lander, whose caps and stop are this host's alone (stuck-ships S1).
    unpinned = None
    asked_by = getattr(t, "asked", (args.by,))[0]
    if (pin and args.on != "here" and by not in ("ship", "brief", "lander") and asked_by == by
            and not finish_runs_here()):
        unpinned, pin = pin, None
        print("autofinish-run: not pinned here (%s): this host cannot claim a finish (no finish-queue), so any host "
              "with room takes it%s" % (unpinned, ", held at a ready PR" if t.ladder[0] or t.ladder[2] else ""))
    pushed_fail = None
    remote = read_origin(t)
    if remote is not None and remote != t.tip:
        if remote and not is_ancestor(t.path, remote, t.tip):
            raise TipMoved("origin's %s is at %s, which this worktree's tip %s does not contain" % (t.branch, remote[:7], t.tip[:7]))
        if args.dry:
            print("would push %s to origin first (origin has %s)" % (t.tip[:7], remote[:7] or "no such branch"))
        else:
            rc, _, err = quiet_git(t.path, "push", "-q", "origin", "%s:refs/heads/%s" % (t.tip, t.branch), timeout=left(t, 45))
            if rc:   # the put's own held_here pins it (commits origin lacks), a pin each sweep judges again
                pushed_fail = "its tip is not on origin, and the push failed: %s" % (err[-160:] or "exit %d" % rc)
                print("autofinish-run: %s" % pushed_fail)
    hold = t.ladder[0]
    # the caller's own words (t.asked): a chain stays a chain, judged by its stop where it is claimed, and a ship's merge
    # keeps its digest even when the ladder holds it here (the claim judges the ladder again, on this host: pinned)
    by0, merge0, digest0 = getattr(t, "asked", (args.by, bool(args.merge), args.digest))
    if t.ladder[2]:
        merge0 = False   # the keel's sticky no: held, never a merge beside it (finish_bad refuses the pair)
    if unpinned and hold:
        merge0 = False   # the ladder's hold, judged here, is the entry's own now: a ready PR on the claiming host
    rights = {"by": by0, "rule": args.rule, "merge": merge0, "hold": bool(args.hold or t.ladder[2] or (unpinned and hold)),
              "from": self_host()}
    if digest0 and merge0:
        rights["digest"] = digest0
    if by0 == "lander":
        # the road the claim judges again (lander_refusal), and the mode flag this put judged: the claim keeps a flag
        # only where its own judgement and this word agree, so an entry's word never widens what this host read
        rights["road"] = args.road
        if getattr(t, "land_by", None):
            rights["land_by"] = t.land_by
    ho, owed = getattr(t, "handover", None) or handover_of(by0, by0, None)
    if by0 in (HANDED, "lander") and ho and owed:   # the stamps dispatch's judge waived: the claim's start has no env of the put's
        rights["owed"] = owed
    line = ["--repo", t.primary, "--branch", t.branch, "--tip", t.tip, "--finish", json.dumps(rights, sort_keys=True),
            "--priority", args.priority or "normal", "--cwd", t.path] + (["--pin", self_host()] if pin else ["--prefer", self_host()])
    if args.session:
        line += ["--by", args.session]
    if args.dry:
        print("autofinish-run --dry: %s in %s, tip %s, rule %s, by %s%s" % (t.branch, t.path, t.tip[:7], args.rule, by, via))
        print("mode %s: %s" % (t.ladder[1] or "none", "held at a ready PR — " + hold if hold else "may merge, past the check and the review gate"))
        print("would queue a finish: dispatch --queue-finish %s" % " ".join(shlex.quote(x) for x in line))
        print("%s" % ("pinned here: %s" % pin if pin else "any host with room claims it, this one first (pinned here at the put "
                                                       "if its worktree holds what origin lacks)"))
        return 0
    # the refusals are done: the start lock goes before the put, whose inline claim may start the job here at once,
    # which takes that lock itself (run_main's finally finds it gone)
    if getattr(t, "held", None):
        try:
            os.remove(t.held)
        except OSError:
            pass
        t.held = None
    # the caller's own env, bar a fired job's words: the put judges its priority against the caller who asked, as
    # dispatch does a build's (raise_refusal; prio_refusal judged it here already)
    job = load_bin("dispatch-rc").JOB_ENV
    _PUT[0] = True   # from here a crash may leave a put behind (the wrapper's not confirmed)
    import tempfile
    outf = tempfile.TemporaryFile(mode="w+")
    p = subprocess.Popen([DISPATCH, "--queue-finish"] + line, stdout=outf, stderr=subprocess.STDOUT, text=True, cwd=t.path,
                         env={k: v for k, v in os.environ.items() if k not in job}, start_new_session=True)
    try:
        p.wait(timeout=max(10, left(t, QUEUE_S)))
    except (subprocess.TimeoutExpired, OutOfTime):
        # never killed mid-put (a CAS, a claim): it finishes on its own, and one run per tip stays the queue's
        print("not confirmed: the queue took longer than the start's budget to answer, and the put goes on; read it with "
              "dispatch --queue — window and Remote Control \"%s\" once it starts" % t.session)
        return UNCONFIRMED_RC
    outf.seek(0)
    said = outf.read()
    r = subprocess.CompletedProcess(p.args, p.returncode, said, said)
    try:
        d = json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
    except ValueError:
        d = {}
    if r.returncode == 1 and not d:
        # the queue alone could not take it (no home after all, the home refused this host's write): the start here,
        # as before the queue (dispatch's own rule for a build's one-shot)
        # the start lock went before the put: taken again, or another start that came meanwhile owns this worktree
        # (the finish review, 2026-11-02: two fallbacks overwrote each other's state). run_main's finally releases it
        t.held = take_start_lock(t)
        if not t.held:
            return refuse(t, args, "the queue did not take the finish, and another start on this worktree is under way")
        print("autofinish-run: the queue did not take the finish (%s); starting it here, as before the queue"
              % ((r.stderr or r.stdout).strip()[-200:] or "exit 1"))
        return start_here(t, args, read_state(t), by, via)
    if r.returncode not in (0, 1, 2, 3) or (r.returncode and d.get("qid")):
        # the queue could not tell whether the put took (a crash after it, a torn read, a signal): never a refusal,
        # which cold_prompt reads as "not started" and runs the typed /finish beside a queued one (AGENTS.md's trap on
        # a new non-zero exit; the landing review, 2026-11-03)
        print("not confirmed: the queue could not say whether the finish was put (exit %d); read it with dispatch --queue "
              "— /finish --here only if nothing is queued; window and Remote Control \"%s\" once it starts" % (r.returncode, t.session))
        return UNCONFIRMED_RC
    res = str(d.get("result") or "")
    if args.by == "chain" and r.returncode == 0 and res in ("queued", "replaced"):
        # counted where its stop is judged (chain_refusal reads this host's CHAIN), once the put took: a relaunch
        # claimed elsewhere writes nothing here, and its claim here counts it no second time (chain_refusal's `claimed`)
        count_chain(t, read_state(t), "queued-%d" % int(time.time()))
    if res.startswith("busy") and res.endswith("(a finish)"):
        # the branch's finish is live, or queued by another live session: in hand, exit 0 — a refusal would let a typed
        # /finish run in its tab beside it
        print("queued: %s, in hand — window and Remote Control \"%s\" where it runs (dispatch --queue)" % (res, t.session))
        return 0
    if r.returncode or not res or res.startswith(("busy", "ran ", "clash")):
        return refuse(t, args, "the queue: %s" % (res or (r.stderr or r.stdout).strip()[-300:] or "exit %d" % r.returncode))
    if not res.startswith("queued already"):
        # a person's finish put here resets this host's lander caps, the one store of the branch's (stuck-ships S1): a
        # claim elsewhere writes none there (start_here's `sent`), and a claim here resets again, to the same
        lander_after_start(t, args, read_state(t))
    log("%s run %s %s queued %s tip=%s rule=%s by=%s%s%s — %s; %s" % (
        now_iso(), t.repo, t.branch, d.get("qid"), t.tip[:7], args.rule, by, via, " merge=yes" if args.merge else "",
        res, "pinned here: %s" % pin if pin else "claimed here" if d.get("qid") in (d.get("claimed") or []) else
        "any host with room"))
    here = d.get("qid") in (d.get("claimed") or [])
    print("queued: %s (a finish of %s), %s — window and Remote Control \"%s\" once it starts%s" % (
        d.get("qid"), t.tip[:7], "claimed here: its job starts it now" if here else
        "%s: its rights stand (dispatch %s --cancel, then a new /finish, to change them)" % (res, t.branch)
        if res.startswith("queued already") else
        ("pinned here (%s): it starts at this host's first free slot" % pin if pin else
         "rank %s: the first host with room claims it" % (d.get("rank") or "?")), t.session,
        "; log %s" % d["log"] if here and d.get("log") else ""))
    return 0


def raise_queued(t, args):
    """A finish of this branch already queued: raised in place to --priority (dispatch-queue raise), never a second
    start beside it. Its exit, or None when none is queued (the start goes on). raise asks force-ok again and spends
    the mark itself; a raised force may have a slot over the cap free here: dispatch's claim at this host's cap."""
    rc, out, err = queue_word("raise", "--repo", t.primary, "--branch", t.branch, "--priority", args.priority,
                              *(["--dry-run"] if args.dry else []))
    if rc == 3:
        return None
    if out:
        print(out)
    if rc:
        # a refusal (2) or a raise that could not tell: a finish of the branch may still be queued, so "may be going"
        # exits 0 (AGENTS.md: a non-zero exit reads as not started to every caller)
        print("autofinish-run: the raise of %s's finish did not land (raise exit %d: %s); a finish queued waits at its "
              "rank, and the sweep starts the branch again if none does" % (t.branch, rc, err[-300:] or "-"))
        return 0
    if out.startswith("raised"):
        job = load_bin("dispatch-rc").JOB_ENV
        env = {k: v for k, v in start_env(t).items() if k not in job}
        try:
            c = subprocess.run([DISPATCH, "--claim"], env=env, cwd=HOME, timeout=300, capture_output=True, text=True)
        except (OSError, subprocess.TimeoutExpired) as e:
            print("autofinish-run: the claim after the raise did not finish (%s); the finish waits at its rank" % e)
        else:
            if c.returncode:
                print("autofinish-run: the claim after the raise took nothing (exit %d); the finish waits at its rank" % c.returncode)
    return 0


def queued_main(argv):
    """`autofinish-run queued QID --repo R --branch B`: a claimed finish's start on this host, from its launchd job
    (dispatch-queue start_job, through dispatch --finish). Its rights are the entry's, read under this very claim
    (`mine --json`: claimed here, by this job, no run of it yet), never a flag; its worktree is found or made here
    from origin at the entry's tip; then the start as any (run_main), its dispatch --start holding the claim. What
    keeps it from starting goes back to the queue: `refused` (back to queued, this host skips it the hour) for this
    host's state, `failed` (its tombstone holds the tip) for a tip origin no longer has."""
    ap = argparse.ArgumentParser(prog="autofinish-run queued")
    ap.add_argument("qid")
    ap.add_argument("--repo", required=True)
    ap.add_argument("--branch", required=True)
    a = ap.parse_args(argv)
    label = os.environ.get("DISPATCH_LABEL") or ""
    if not label:
        print("autofinish-run queued: the claim's launchd job's verb (DISPATCH_LABEL unset)", file=sys.stderr)
        return 2
    rc, out, err = queue_word("mine", a.qid, "--label", label, "--json")
    if rc:
        print("== a stale queue job: %s is not this job's claim now (%s); not running" % (a.qid, (out or err or "exit %d" % rc)[-200:]))
        queue_word("unreserve", a.qid, "--label", label)
        return 0
    try:
        e = json.loads(out.splitlines()[-1])
    except (ValueError, IndexError):
        e = {}
    f, tip = e.get("finish") or {}, str(e.get("tip") or "")
    repo = os.path.realpath(a.repo)

    def back(word, why):
        print("FAILED: %s; %s" % (why, "handed back to the queue" if word == "refused" else "not running"))
        queue_word(word, a.qid, "--label", label, "--why", why[:300])
        return 0
    if e.get("branch") != a.branch or not tip:
        return back("failed", "the job's branch %s is not its entry's (%s)" % (a.branch, e.get("branch")))
    sent = bool(f.get("from")) and str(f["from"]).lower() != self_host()
    fresh = time.time() - float(e.get("put_at") or 0) < OWN_FRESH_S   # the put's caller is still at the handover
    pinned = not sent and str(e.get("host") or "").lower() == self_host()
    wt, code, why = queued_worktree(repo, a.branch, tip, own=not sent and fresh, pinned=pinned)
    if not wt:
        return back("failed" if code in (2, 5) else "refused", why)
    # claimed on the host that put it: the putting caller's own session (the entry's `by`, cold_prompt's panel) holds
    # the worktree's lock and is no refusal, as `--session` made it on the direct start — past the handover too: nothing
    # holds the lock for a queued finish now, so the panel that typed it still owns it when a slot frees later, and
    # lock_refusal still refuses that session once it is back at work (the landing review, 2026-11-03)
    own = e.get("by") if not sent and isinstance(e.get("by"), str) and e.get("by") else None
    if e.get("unattended"):
        # the put's caller was an unattended run: so is this start, for landing() and judged_stop (a mode-ask hold, E12's
        # standing yes), as AUTOFINISH_CALLER_UNATTENDED told the peer's job (round 2's S1). DROP_JOB keeps it out of
        # the session's own env
        os.environ["AUTOFINISH_CALLER_UNATTENDED"] = "1"
    # a handed finish's waived stamps ride in its rights, as dispatch's HANDOVER_OWED does on the direct start
    os.environ["HANDOVER_OWED"] = "\n".join(f.get("owed") or []) if f.get("by") in (HANDED, "lander") else ""
    try:   # a run of this worktree here that died (a disarmed host's sweep never buries one): buried first
        here = Tree(wt)
        prev = read_state(here)
        if prev and not prev.get("ended"):
            died = dead(here, prev, state_dir=here.state_dir)
            if died:
                bury(here, died)
    except Exception:   # noqa: BLE001 — the start's own refusal judges what is left
        traceback.print_exc()
    args = argparse.Namespace(
        worktree=wt, rule=f.get("rule") or "C", by=f.get("by") or "sweep", merge=bool(f.get("merge")),
        hold=bool(f.get("hold")), digest=f.get("digest") or None, session=own, on="here",
        priority=e.get("priority") if e.get("priority") in ("high", "force") else None, dry=False,
        queue=a.qid, job=label, sent=sent, sent_from=f["from"] if sent else None,
        road=f.get("road") if f.get("by") == "lander" else None, entry_land_by=f.get("land_by"))
    print("== the claimed finish %s: %s at %s in %s, by %s%s" % (a.qid, a.branch, tip[:7], wt, args.by,
                                                               ", put on %s" % f["from"] if sent else ""))
    try:
        rc = run_main(args)
    except Exception as x:   # noqa: BLE001 — handed back now, never left claimed to crash again past the lease
        traceback.print_exc()
        return back("refused", "autofinish-run crashed here (%s: %s)" % (type(x).__name__, x))
    if rc in (0, UNCONFIRMED_RC):
        return 0   # started, or dispatch's verdict still to come: its start writes `started`, its end `ended`
    why = getattr(args, "refused_why", None) or "autofinish-run exit %d" % rc
    return back("failed" if claim_final(rc, sent, args.by, why) else "refused", why)


def claim_final(rc, sent, by, why):
    """Whether a claimed finish that ran nothing holds its tip (failed) or hands it back (refused).

    A reason any host would meet holds the tip; this host's own state hands it back. A lander road stuck or dead
    is final too where this host put it: the put judged it under the same store a moment before. Never on a claim
    of another host's put, which reads no store here (refusal()'s `sent`), nor on another launch a stuck key
    refused: its `failed` would outlive the `lander reset` that clears the key (the S1 landing's review)."""
    return (rc in (2, ORIGIN_RC) or (not sent and by == "lander" and rc in (STUCK_RC, DEAD_ROAD_RC))
            or "no retry on the same tip" in why)


def self_host():
    return (os.environ.get("AUTOFINISH_HOST") or common.host_name() or "").lower()


def quiet_git(where, *args, timeout=60):
    """(rc, out, err) of a git call that may reach origin: never a prompt, never a hang."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(["git", "-C", where, *args], capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return 124, "", "no answer in %d s" % timeout
    except OSError as e:
        return 127, "", str(e)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def is_ancestor(where, a, b):
    return subprocess.run(["git", "-C", where, "merge-base", "--is-ancestor", a, b], capture_output=True).returncode == 0


class OutOfTime(Exception):
    """A check would run past the caller's budget (left())."""


class TipMoved(Exception):
    """Origin's branch holds what the tip lacks, found after the origin gate passed: a refusal, never a stay."""


def left(t, want):
    """Seconds a check may take: `want`, or less to keep STAY_RESERVE inside the budget. Raises
    OutOfTime with under 3 s left — a check cut that short would only fail."""
    have = getattr(t, "deadline", time.time() + want + 1000) - time.time() - getattr(t, "reserve", 0)
    if have < 3:
        raise OutOfTime("out of time for the start's checks (%d s budget)" % getattr(t, "budget", 0))
    return min(want, have)


def read_origin(t, strict=False):
    """Origin's tip of the branch: a sha, "" when it has no such branch, None when it could not be read in time
    (a line says so: the origin gate's one pass, the header's). `strict`: a read past the budget a send may have spent."""
    try:
        rc, out, err = quiet_git(t.path, "ls-remote", "origin", "refs/heads/" + t.branch,
                                 timeout=ORIGIN_READ_S if strict else left(t, ORIGIN_READ_S))
    except OutOfTime as e:
        rc, out, err = 1, "", str(e)
    if rc:
        print("autofinish-run: %s's tip %s was not compared with origin's — %s" % (t.branch, t.tip[:7], err[-160:] or "exit %d" % rc))
        return None
    return (out.split() or [""])[0]


def judged_stop(t, args):
    """Why a start stops on a tip other than the one its caller judged, or None: only a person's launch goes on (the
    header's). PRIO_UNATTENDED, not unattended_caller(): a skipper's `--by override` is no person either."""
    judged = getattr(t, "judged", t.tip)
    if t.tip == judged or (args.by in PERSON_BY and not any(os.environ.get(n) for n in PRIO_UNATTENDED)):
        return None
    return "this start was judged on %s, not %s: the next start judges that tip" % (judged[:7], t.tip[:7])


def tip_gate(t, args, follow=True, strict=False):
    """Why no run starts on this tip, or None — the header's origin gate. `follow`: a tip behind origin's branch
    may be fast-forwarded, which moves t.tip; a road that judged a tip already may not, and refuses. `strict`: an
    origin that cannot be read refuses too (the send's fallback, the header's)."""
    t.judged = getattr(t, "judged", t.tip)
    remote = read_origin(t, strict)
    if remote is None and strict:
        return "origin's %s could not be read to confirm tip %s: not started on it" % (t.branch, t.tip[:7])
    if not remote or remote == t.tip:
        return judged_stop(t, args)
    if not git(t.path, "rev-parse", "--verify", "--quiet", remote + "^{commit}"):
        if args.dry:
            print("autofinish-run --dry: origin's %s is at %s, not here: a start fetches it and judges it" % (t.branch, remote[:7]))
            t.tip = remote
            return judged_stop(t, args)
        spec = "+refs/heads/%s:refs/remotes/origin/%s" % (t.branch, t.branch)
        try:
            rc, _, err = quiet_git(t.path, "fetch", "-q", "origin", spec, timeout=left(t, 30))
        except OutOfTime as e:
            rc, err = 1, str(e)
        if rc:
            return "origin's %s is at %s, which this worktree lacks, and fetching it failed: %s" % (
                t.branch, remote[:7], err[-160:] or "exit %d" % rc)
        remote = git(t.path, "rev-parse", "refs/remotes/origin/" + t.branch) or remote
    if is_ancestor(t.path, remote, t.tip):
        return judged_stop(t, args)
    if not is_ancestor(t.path, t.tip, remote):
        return ("origin's %s is at %s, apart from this worktree's tip %s: neither holds the other, so a landing would "
                "drop or replay one of them. Settle the two by hand, then start again" % (t.branch, remote[:7], t.tip[:7]))
    if not follow:
        return "origin's %s moved on to %s, past the tip %s this run was given" % (t.branch, remote[:7], t.tip[:7])
    if not getattr(t, "warm_ended", False):
        # before the tree moves: its busy check sees a run on any login, and its last turn may move the tip or clean the tree
        try:
            why = end_warm(t, args, cap=left(t, 90))
        except OutOfTime as e:
            why = str(e)
        if why:
            return why
        t.warm_ended = True
        t.tip = (None if args.dry else git(t.path, "rev-parse", "HEAD")) or t.tip
        return tip_gate(t, args, strict=True)   # proved behind: from here an unread origin is no pass
    dirty = [l for l in git(t.path, "status", "--porcelain").splitlines() if l.strip()]
    if dirty:
        return ("origin's %s is at %s, ahead of this worktree's tip %s, and %d uncommitted file(s) keep it from "
                "fast-forwarding. Commit or clear them, then start again" % (t.branch, remote[:7], t.tip[:7], len(dirty)))
    if args.dry:
        print("autofinish-run --dry: would fast-forward %s from %s to %s, origin's tip, and land that" % (t.branch, t.tip[:7], remote[:7]))
    else:
        try:
            left(t, 30)   # asked first: quiet_git's timeout is a kill, and a killed checkout leaves index.lock and half a tree
        except OutOfTime as e:
            return "%s not fast-forwarded to origin's %s: %s" % (t.branch, remote[:7], e)
        rc, _, err = quiet_git(t.path, "merge", "-q", "--ff-only", remote, timeout=600)
        if rc or git(t.path, "rev-parse", "HEAD") != remote:
            return "fast-forwarding %s to origin's %s failed: %s" % (t.branch, remote[:7], err[-160:] or "exit %d" % rc)
        print("autofinish-run: %s fast-forwarded from %s to %s, origin's tip: that tip is the one landed" % (t.branch, t.tip[:7], remote[:7]))
        t.moved_from = t.tip
        try:   # for the next start, when this one stops after the move (judged_stop): its bundle names the move too
            with open(os.path.join(t.state_dir, ORIGIN_MOVE), "w") as f:
                json.dump({"from": t.tip, "to": remote}, f)
        except (OSError, AttributeError):
            pass
    t.tip = remote
    return judged_stop(t, args)


def worktree_of(repo, branch):
    path = None
    for line in git(repo, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line == "branch refs/heads/" + branch:
            return path
    return None


def queued_worktree(repo, branch, tip, own=False, pinned=False):
    """(path, 0, None) of the branch's worktree here at `tip` — found, else created from origin as
    `pickup open` does, fast-forwarded when behind — or (None, code, why): 3 refused, 4 cannot here,
    5 never anywhere (origin's branch is not at the tip: the finish was put for a tip origin has moved past)."""
    wt = worktree_of(repo, branch)
    if (own or pinned) and wt and os.path.isdir(wt) and os.path.realpath(wt) != os.path.realpath(repo) and git(wt, "rev-parse", "HEAD") == tip \
            and (own or not [l for l in git(wt, "status", "--porcelain").splitlines() if l.strip()]):
        # claimed on the host that put it, its worktree at the tip: the run lands it as it is, origin read or not, its
        # own work in it — as the direct start always did. Another host's stale copy goes through the checks below.
        # PINNED: an entry pinned to this host, claimed past the put's handover (a full host): its tree is still the one
        # the pin names, often for commits origin lacks (a push that failed), which the fetch below would refuse for
        # good; it is taken clean only, as the caller may be at work in it again (the finish review, 2026-11-02)
        return wt, 0, None
    if pinned and not own and wt and os.path.isdir(wt) and git(wt, "rev-parse", "HEAD") == tip:
        # pinned here, its tree at the tip but not clean: the caller is at work in it again. Handed back, never the fetch
        # below, which reads a tip origin lacks (the reason for the pin) as never anywhere (the landing review, 2026-11-03)
        return None, 3, "%s's worktree here is at the queued tip with changes in it: the finish waits until it is clean" % branch
    m = NAME_RE.match(branch)
    if not m:
        return None, 2, "%s is not a claude/<host>/<date>-<topic> branch: no worktree can be made for it here" % branch
    rc, _, err = quiet_git(repo, "fetch", "-q", "origin", "+refs/heads/%s:refs/remotes/origin/%s" % (branch, branch), timeout=60)
    if rc:
        return None, 4, "fetching origin's %s failed here: %s" % (branch, err[-160:] or "exit %d" % rc)
    otip = git(repo, "rev-parse", "refs/remotes/origin/" + branch)
    if otip != tip:
        return None, 5, "origin's %s is at %s, not the queued tip %s" % (branch, otip[:7] or "nothing", tip[:7])
    wt = worktree_of(repo, branch)
    if wt and os.path.realpath(wt) == os.path.realpath(repo):
        return None, 4, "%s is checked out in the primary checkout here" % branch
    if wt and not os.path.isdir(wt):
        git(repo, "worktree", "prune")   # forget the vanished folder, or `add` refuses the branch
        wt = None
    if not wt:
        want = base = os.path.join(repo, ".claude", "worktrees", m.group("topic"))
        n = 2
        while os.path.exists(want):
            want, n = "%s-%d" % (base, n), n + 1
        local = git(repo, "rev-parse", "--verify", "--quiet", "refs/heads/" + branch)
        add = [want, branch] if local else ["--track", "-b", branch, want, "refs/remotes/origin/" + branch]
        rc, _, err = quiet_git(repo, "worktree", "add", "-q", *add, timeout=120)
        if rc or git(want, "symbolic-ref", "--short", "HEAD") != branch:
            return None, 4, "git worktree add failed here: %s" % (err[-160:] or "exit %d" % rc)
        env = os.path.join(repo, ".env")
        if os.path.lexists(env) and not os.path.lexists(os.path.join(want, ".env")):
            os.symlink(env, os.path.join(want, ".env"))
        wt = want
    if [l for l in git(wt, "status", "--porcelain").splitlines() if l.strip()]:
        return None, 4, "its worktree here (%s) has uncommitted changes" % wt
    head = git(wt, "rev-parse", "HEAD")
    if head != tip:
        if not is_ancestor(wt, head, tip):
            return None, 4, "its worktree here is at %s, apart from origin's %s" % (head[:7], tip[:7])
        here = Tree(wt)
        why = lock_refusal(here, None, False)
        if why:
            return None, 3, why
        # An unended run here keeps its tree: judged before the fast-forward, not after it as
        # start()'s refusal() is (fourth landing review, CR 4). A dead one is buried first.
        prev = read_state(here)
        if prev and not prev.get("ended"):
            died = dead(here, prev, state_dir=here.state_dir)
            if not (died and bury(here, died)):
                return None, 3, "a run here on %s has not ended: its tree is not moved under it" % (prev.get("tip") or "?")[:7]
        rc, _, err = quiet_git(wt, "merge", "-q", "--ff-only", tip)
        if rc:
            return None, 4, "fast-forwarding its worktree here failed: %s" % (err[-160:] or "exit %d" % rc)
    return wt, 0, None


# The waiters a detach may start, by name: the grandchild execs this script fresh (`autofinish-run waiter`) and
# finds its function here, never a closure carried across the fork (waiter-fork-crash, 2026-11-03)
WAITERS = ("wait_for_end",)
WAITER_SPEC = "AUTOFINISH_WAITER_SPEC"   # the exec'd waiter's spec, JSON, popped from its environment at its start
WAITER_READY = "AUTOFINISH_WAITER_READY"   # the fd the waiter says "ok" on once its spec read, popped likewise
WAITER_START_S = 60   # how long detach() waits for that "ok"; a waiter still starting then is killed


def _read_until(r, deadline, done=lambda got: False):
    """What the pipe r holds until EOF or done(got), or what it held at the deadline (then None as the second
    value), read once more at the deadline so an answer written at the last moment is not lost. poll, not
    select: select refuses a descriptor past FD_SETSIZE with a ValueError no caller catches (finish review)."""
    got = b""
    p = select.poll()
    p.register(r, select.POLLIN | select.POLLHUP)
    while True:
        left = deadline - time.monotonic()
        if not p.poll(max(0, int(left * 1000))):
            if left > 0:
                continue
            return got, None
        chunk = os.read(r, 64)
        if not chunk:
            return got, True
        got += chunk
        if done(got):
            return got, False


def detach(waiter, t, args, out_path):
    """waiter(t, *args) in a grandchild in its own session, its output appended to out_path; returns once the
    waiter has started. The grandchild execs a fresh interpreter on this script (`waiter`, its spec in
    WAITER_SPEC) rather than run the function in the forked image: once this process has resolved a name, a
    forked child's next getaddrinfo dies in Apple's Network framework (SIGSEGV in
    nw_nat64_v4_address_requires_synthesis; fourteen waiters on the laptop died so, 2026-11-01/03: a local
    landing's at its first lookup, before dispatch wrote a line, and the peer road's hours in). Between the fork
    and the exec the children make syscalls only. A pipe carries the grandchild's pid, then either its exec's
    errno or the waiter's "ok", written once it has read its spec and bound its arguments, before it runs them.
    Raises OSError when no waiter was made: the spec would not serialise, the log would not open, the fork
    failed, the child could not setsid or fork, the exec failed, the waiter died at its start (its traceback is
    in out_path), or it said nothing in WAITER_START_S (then it is killed). The caller then gives the lock back,
    which a waiter that died after the exec could never do."""
    if waiter not in WAITERS:
        raise OSError("no such waiter: %s" % waiter)
    try:   # Tree's fields are plain data (paths, the tip, the budget, flags); a tuple comes back a list
        spec = json.dumps({"waiter": waiter, "tree": vars(t), "args": list(args)})   # ASCII: no locale decides it
    except (TypeError, ValueError) as e:
        raise OSError("the waiter's spec does not serialise: %s" % e)
    if not sys.executable:
        raise OSError("no interpreter to exec the waiter with (sys.executable is empty)")
    try:   # encoded here, not in the grandchild, where a failure would leave nothing behind but a silent exit
        argv = [os.fsencode(a) for a in (sys.executable, os.path.abspath(__file__), "waiter")]
        env = {os.fsencode(k): os.fsencode(v) for k, v in dict(os.environ, **{WAITER_SPEC: spec}).items()}
    except (UnicodeError, ValueError) as e:
        raise OSError("the waiter's spec does not encode: %s" % e)
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    opened = []
    try:
        opened.append(os.open(out_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644))
        opened.append(os.open(os.devnull, os.O_RDONLY))
        opened.extend(os.pipe())   # both close-on-exec (PEP 446); w is made inheritable in the grandchild alone
        for i, x in enumerate(opened):   # never on 0-2: the grandchild's dup2s would overwrite one with another
            if x <= 2:
                opened[i] = fcntl.fcntl(x, fcntl.F_DUPFD_CLOEXEC, 3)
                os.close(x)
    except OSError:
        for x in opened:
            os.close(x)
        raise
    fd, null, r, w = opened
    env[os.fsencode(WAITER_READY)] = str(w).encode()
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        pid = os.fork()
    except OSError:
        for x in opened:
            os.close(x)
        raise
    if pid == 0:
        code = 1
        try:
            os.close(r)
            os.setsid()
            if os.fork():
                os._exit(0)
            os.write(w, b"%d\n" % os.getpid())
            os.dup2(null, 0)
            os.dup2(fd, 1)
            os.dup2(fd, 2)
            os.set_inheritable(w, True)
            os.execve(argv[0], argv, env)
        except BaseException as e:   # anything: a grandchild that exits unheard would read as a waiter made
            try:
                os.write(w, (str(e.errno) if isinstance(e, OSError) and e.errno else type(e).__name__).encode())
            except BaseException:
                pass
            code = 3
        finally:
            os._exit(code)
    for x in (fd, null, w):
        os.close(x)
    # The wait is the run's own budget at most (a caller killed mid-wait gives nothing back), never under 10 s
    wait = min(WAITER_START_S, max(10, getattr(t, "deadline", time.time() + WAITER_START_S) - time.time()))
    try:
        _, status = os.waitpid(pid, 0)
        got, eof = _read_until(r, time.monotonic() + wait, lambda got: got.partition(b"\n")[2].startswith(b"ok"))
        head, _, said = got.partition(b"\n")
        if said.startswith(b"ok"):   # decisive: the waiter runs, whatever else the pipe or the child says
            return
        if eof is None and head.isdigit():   # killed before r closes, so its "ok" can never land unread
            try:
                os.kill(int(head), signal.SIGKILL)
            except OSError:
                pass
    finally:
        os.close(r)
    if not os.WIFEXITED(status) or os.WEXITSTATUS(status):
        raise OSError("the detaching child ended with status %d%s" % (status, " (%s)" % got.decode(errors="replace") if got else ""))
    if eof is None:
        raise OSError("the waiter said nothing in %d s: killed" % wait)
    if not said:
        raise OSError("the waiter died at its start (its traceback is in %s)" % out_path)
    if said.isdigit():
        raise OSError(int(said), "the waiter's exec failed: %s" % os.strerror(int(said)))
    raise OSError("the waiter's exec failed: %s" % said.decode(errors="replace"))


def waiter_main():
    """`autofinish-run waiter`: the exec'd grandchild of detach(), its stdout and stderr the run's log. The spec
    names one of WAITERS, the Tree's fields and its arguments; it leaves the environment before anything runs,
    so dispatch and the session never inherit it. "ok" goes to detach() only once the spec read and the
    arguments bind to the waiter's own signature (the file on disk may be newer than the caller's), so a waiter
    that cannot run is the caller's OSError and its lock is given back. Exit 0 once the waiter returned, 1 on
    its traceback."""
    raw = os.environ.pop(WAITER_SPEC, None)
    ready = os.environ.pop(WAITER_READY, None)
    try:
        spec = json.loads(raw or "")
        fn = globals()[spec["waiter"]] if spec.get("waiter") in WAITERS else None
        if fn is None:
            raise ValueError("no waiter named %r" % spec.get("waiter"))
        t = Tree.__new__(Tree)   # read from git once, by the caller: the tip and the budget as it judged them
        t.__dict__.update(spec["tree"])
        inspect.signature(fn).bind(t, *spec["args"])
        if ready and ready.isdigit():
            try:   # a caller gone mid-wait (killed by its own caller) gives nothing back: run on, as it meant
                os.write(int(ready), b"ok")
            except BrokenPipeError:
                pass
            os.close(int(ready))
        fn(t, *spec["args"])
        code = 0
    except BaseException:
        traceback.print_exc()
        code = 1
    finally:
        sys.stdout.flush()
        sys.stderr.flush()
    return code


def lease_refusal(dry):
    """None, or the line the ship's lease refuses this caller with (the header's "A ship's lease"). The
    ship is the caller's DISPATCH_SHIP: a launch acting for a leased ship is the skipper's, the yard's
    or the owner's, never a former holder's. leaselib is helm's, found through the core's tool() beside
    helmlib; absent, the launch goes on as it did before S4."""
    ship = next((os.environ[n] for n in ("DISPATCH_SHIP", "DISPATCH_PLAN") if os.environ.get(n)), None)
    if not ship:
        return None
    lib = common.tool("leaselib.py")
    if not lib:
        return None
    if str(lib.parent) not in sys.path:
        sys.path.append(str(lib.parent))   # appended: helm's bin/ never shadows this module's own
    try:
        import leaselib
    except Exception as e:  # a helm that will not load is a line, never the launch's crash
        print("autofinish-run: the lease of ship %s not checked — helm's leaselib does not load (%s)" % (ship, e), file=sys.stderr)
        return None
    return leaselib.fence(ship, "autofinish-run", record=not dry)


# who may type `--by ship` (S6, the header's "A ship's launch"): the yard's tick, never a session. Each
# name marks a caller that is not it — a session, a dispatched run, a skipper, a ship's block
SHIP_NOT_TICK = ("CLAUDE_CODE_SESSION_ID", "REGATTA_UNATTENDED", "CLAUDE_UNATTENDED", "SKIPPER_SCOPE", "DISPATCH_SHIP", "DISPATCH_PLAN")


def ship_caller_refusal(environ=None):
    """None when the caller may carry the keel's yes (`--by ship`), else why not: the flag stands for a
    person's yes, so an unattended caller is refused it (AGENTS.md's trap), and the tick under launchd
    is the one caller with none of these set."""
    env = os.environ if environ is None else environ
    for n in SHIP_NOT_TICK:
        if env.get(n):
            return "--by ship is the yard's tick's, and this caller is not it (%s=%s)" % (n, str(env[n])[:40])
    depth = (env.get("DISPATCH_DEPTH") or "0").strip()
    if depth != "0":
        return "--by ship is the yard's tick's, and this caller is a dispatched run (DISPATCH_DEPTH=%s)" % depth[:10]
    return None


def _helm_and_blueprints():
    """(helmlib, blueprintlib) — helm's, found as lease_refusal finds leaselib, and this module's own —
    or raises ImportError naming what is missing."""
    lib = common.tool("helmlib.py")
    if not lib:
        raise ImportError("helm's helmlib.py is not installed")
    if str(lib.parent) not in sys.path:
        sys.path.append(str(lib.parent))
    if HERE not in sys.path:
        sys.path.insert(0, HERE)
    import helmlib
    import blueprintlib
    return helmlib, blueprintlib


def same_repo(path, key):
    """True when PATH (a checkout, a task's repo) is the repo registry KEY names: the keys equal, or, for a
    repo outside the projects folder (a key that is its own absolute path), the same folder resolved."""
    mine = common.repo_key(path)
    if not mine or not key:
        return False
    if mine == key:
        return True
    return mine.startswith("/") and key.startswith("/") and os.path.realpath(mine) == os.path.realpath(key)


def ship_refusal(t, digest):
    """None when DIGEST pins one un-ended ship on this Mac whose keel said merge and whose blocks own
    T's branch, else why the keel's yes cannot be read (the header's "A ship's launch")."""
    if not digest or not re.match(r"^[0-9a-f]{64}$", digest):
        return "--by ship needs --digest D, the ship's pinned digest (64 hex)"
    try:
        helmlib, blueprintlib = _helm_and_blueprints()
    except Exception as e:  # noqa: BLE001 — what cannot be read is no yes
        return "--by ship: the keel's yes cannot be read (%s)" % e
    hits = []
    for pid in helmlib.list_plans():
        p = helmlib.load_plan(pid) or {}
        for name, rec in sorted((p.get("blueprints") or {}).items()):
            pin = rec.get("pin") if isinstance(rec, dict) else None
            if isinstance(pin, dict) and pin.get("digest") == digest and not rec.get("ended"):
                hits.append((pid, name, rec, p))
    if not hits:
        return "--by ship: no un-ended ship on this Mac is pinned at %s" % digest[:12]
    if len(hits) > 1:
        return "--by ship: %d ships are pinned at %s (%s) — which keel said yes cannot be told" % (
            len(hits), digest[:12], ", ".join("%s/%s" % (h[0], h[1]) for h in hits))
    pid, name, rec, plan = hits[0]
    where = "ship %s of plan %s" % (name, pid)
    try:
        bp = blueprintlib.load(rec.get("file") or "", key=rec["pin"].get("repo"), accepted=(digest,))
    except Exception as e:  # noqa: BLE001 — BlueprintError, OSError: the pinned text is the yes
        return "--by ship: %s's pinned copy does not read (%s)" % (where, str(e)[:160] or type(e).__name__)
    if blueprintlib.digest(bp) != digest:
        return "--by ship: %s's pinned copy %s is not at %s" % (where, rec.get("file"), digest[:12])
    if blueprintlib.merge_of(bp["meta"]) == "no":
        return "--by ship: %s's blueprint says merge: no at %s" % (where, digest[:12])
    mode = (rec.get("laid_by") or {}).get("mode") if isinstance(rec.get("laid_by"), dict) else None
    if mode != "attended":
        return "--by ship: %s was laid %s, and only an attended lay is a person's yes" % (where, mode or "by nobody recorded")
    keel = rec.get("merge") if isinstance(rec.get("merge"), dict) else {}
    if keel.get("value") == "no":
        return "--by ship: %s's keel said no (merge no: %s)" % (where, keel.get("why"))
    if not same_repo(t.primary, rec["pin"].get("repo")):
        return "--by ship: %s is not in %s's repo %s" % (t.path, where, rec["pin"].get("repo"))
    here = helmlib.host()
    tasks = plan.get("tasks") or {}
    mine = {blueprintlib.branch_of(bp, st, here) for st in bp["blocks"]}
    mine |= {x.get("seeded_branch") for k, x in tasks.items() if isinstance(x, dict) and x.get("ship") == name
             and (not x.get("repo") or same_repo(x["repo"], rec["pin"].get("repo")))}
    if t.branch not in mine - {None}:
        return "--by ship: %s is no block branch of %s" % (t.branch, where)
    return None


def main(argv):
    if argv[:1] == ["notify"]:
        return notify(argv[1:])
    if argv[:1] == ["queued"]:
        return queued_main(argv[1:])
    if argv[:1] == ["rotation"]:
        return rotation(argv[1:])
    if argv[:1] == ["lander"]:
        return lander_cmd(argv[1:])
    if argv[:1] == ["waiter"] and WAITER_SPEC in os.environ:   # a worktree named `waiter` stays a finish
        return waiter_main()
    ap = argparse.ArgumentParser(prog="autofinish-run", description=__doc__.split("\n\n")[0])
    ap.add_argument("worktree")
    ap.add_argument("--rule", choices="ABCDELM", default="C")
    ap.add_argument("--by", choices=BY_WORDS, default="override")
    ap.add_argument("--road", choices=ROADS, help="--by lander's: the road the tick names (stuck-ships S1)")
    ap.add_argument("--merge", action="store_true",
                    help="carry the owner's /finish --merge into the run (--by override|typed, or ship with --digest)")
    ap.add_argument("--hold", action="store_true", help="stop at a ready PR whatever the mode: the keel's no (S6)")
    ap.add_argument("--digest", metavar="D", help="--by ship's: the ship's pinned digest, whose keel said merge")
    ap.add_argument("--session", metavar="ID", help="the caller's own session: its lock is no refusal")
    ap.add_argument("--on", choices=("here",), help="pin the finish to this host (the header's Where)")
    ap.add_argument("--priority", choices=("high", "force"),
                    help="the finish's rank in the queue, as dispatch's --priority (force: the owner's word)")
    ap.add_argument("--dry", action="store_true")
    args = ap.parse_args(argv)
    args.queue = args.job = args.sent_from = None
    args.sent = False
    return run_main(args)


def run_main(args):
    if (args.by == "lander") != bool(args.road):
        print("autofinish-run: --by lander names its road (--road %s), and only a lander start names one"
              % "|".join(ROADS), file=sys.stderr)
        return 2
    if args.merge and args.by not in MERGE_BY:
        print("autofinish-run: --merge needs a person's yes, so --by %s (not %s) only" % (" or ".join(MERGE_BY), args.by),
              file=sys.stderr)
        return 2
    # the claim's job (args.queue) carries the yes its entry carries: judged at its put, on the host it was given on
    for n in PRIO_UNATTENDED:
        if args.merge and os.environ.get(n):
            print("autofinish-run: --merge needs a person's yes, and this caller is an unattended run (%s=%s)"
                  % (n, os.environ[n]), file=sys.stderr)
            return 2
    if args.merge and args.hold:
        print("autofinish-run: --merge and --hold ask opposite things: one of them", file=sys.stderr)
        return 2
    if args.digest and not (args.by == "ship" and args.merge):
        print("autofinish-run: --digest goes with --merge --by ship", file=sys.stderr)
        return 2
    if args.by == "ship":
        why = ship_caller_refusal() or (None if args.merge or args.hold else
                                        "--by ship is the tick's landing call: --merge --digest D, or --hold")
        if why:
            print("autofinish-run: %s" % why, file=sys.stderr)
            return 2
    # a claimed finish's priority was judged where it was put (prio_refusal, and dispatch-queue's raise_refusal); the
    # job's own env holds no caller to judge
    why = None if args.queue else prio_refusal(args.priority)
    if why:
        print("autofinish-run: %s: end with the WAITING line — the next step waits for a run to end" % why, file=sys.stderr)
        return 2
    why = lease_refusal(args.dry)
    if why:
        print("autofinish-run: %s" % why, file=sys.stderr)
        return 4
    t = Tree(os.path.abspath(os.path.expanduser(args.worktree)))
    bad = t.problem()
    if bad:
        print("autofinish-run: %s: %s" % (args.worktree, bad), file=sys.stderr)
        return 2
    # the raise takes the finish in hand as it is: a caller with rights of its own (--merge, --hold, a ship's
    # --digest) goes to start(), whose put says no rather than drop them (the review)
    if args.priority and not args.queue and not (args.merge or args.hold or args.digest):
        rc = raise_queued(t, args)
        if rc is not None:
            return rc
    if args.by == "ship" and args.merge:
        why = ship_refusal(t, args.digest)
        if why:
            print("autofinish-run: %s" % why, file=sys.stderr)
            return 2
    t.stay = None
    typed = args.by == "typed" and not args.queue   # cold_prompt's budget; a claimed job has nobody waiting
    t.budget = float(os.environ.get("AUTOFINISH_SEND_BUDGET") or (SEND_BUDGET_TYPED if typed else SEND_BUDGET))
    t.deadline, t.reserve = time.time() + t.budget, STAY_RESERVE_TYPED if typed else STAY_RESERVE
    # --dry writes nothing, the start lock included: it only says what a start would meet
    held = None if args.dry else take_start_lock(t)
    if not args.dry and not held:
        # through refuse(): a lander start's refusal is logged once an hour per text, as every other one of its own
        return refuse(t, args, "another start on this worktree is under way (%s)" % os.path.join(t.state_dir, START_LOCK))
    t.held = held
    try:
        rc = start(t, args)
        if rc == 0 and args.priority == "force" and not args.dry:
            spend_force()   # one phrase, one run: past every refusal (started or queued)
        return rc
    finally:
        if t.held:   # enqueue gave it up before its put: the claimed job here may hold it now
            try:
                os.remove(t.held)
            except OSError:
                pass


def lander_target(args):
    """(primary, branch) a `lander` verb acts on: --worktree's, else --repo (a checkout: its main checkout) and --branch."""
    if args.worktree:
        t = Tree(os.path.abspath(os.path.expanduser(args.worktree)))
        if not t.primary or not t.branch:
            raise ValueError("%s is not a branch's worktree" % args.worktree)
        return t.primary, t.branch
    if not (args.repo and args.branch):
        raise ValueError("name the branch: --worktree W, or --repo R --branch B")
    repo = os.path.abspath(os.path.expanduser(args.repo))
    cd = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir") if os.path.isdir(repo) else ""
    return (os.path.dirname(cd) if cd.endswith("/.git") else repo), args.branch


def tick_here():
    """None when a tick runs on this Mac, else why not — helm's poll_tick's own test: the laptop, or a host some
    scope's yard names (a registry that does not read is no tick: the yard gate fails closed)."""
    lib = common.tool("helmlib.py")
    if not lib:
        return "helm is not installed: no tick"
    if str(lib.parent) not in sys.path:
        sys.path.append(str(lib.parent))
    try:
        import helmlib
        import surfaces
        if surfaces.host() == common.LAPTOP:
            return tick_disarmed()
        yards, torn = helmlib.yard_hosts()
    except Exception as e:  # noqa: BLE001 — what cannot be told is no tick
        return "helm's tick test did not run (%s)" % type(e).__name__
    if torn:
        return "the registry does not read: a yard's tick fails closed"
    if helmlib.host() not in yards:
        return "%s is neither the laptop nor a scope's yard: no tick runs here" % helmlib.host()
    return tick_disarmed()


def tick_disarmed():
    """None when helm's tick acts here (`helm tick --arm`, past its dry hours: stalls_tick's mode() is `armed`), else
    why not: a tick that runs disarmed or dry calls nothing, so no road would move a stop (the landing review)."""
    try:
        import stalls_tick
        mode, why = stalls_tick.mode()
    except Exception as e:  # noqa: BLE001 — what cannot be told is no tick
        return "helm's tick state did not read (%s)" % type(e).__name__
    return None if mode == "armed" else "helm's tick is %s: %s" % (mode, why)


def lander_armed():
    """None when a stop on this Mac will be moved by a road: the relaunch gate is on (autofinish's `armed`; the
    `landings` switch, task-shape S3's) and a tick runs here. Else why not."""
    landings = getattr(common, "autofinish_landings", lambda: False)
    if not (common.autofinish_armed() or landings()):
        return "the relaunch gate is off (no armed or landings file in %s)" % common.autofinish_state_dir()
    try:
        lander_read()
    except StoreUnreadable as e:
        return "the lander's store %s does not read (%s): no start but a person's runs here" % (lander_path(), e)
    return tick_here()


def lander_cmd(argv):
    """`autofinish-run lander VERB` — the store's verbs (the header's "The lander")."""
    ap = argparse.ArgumentParser(prog="autofinish-run lander")
    ap.add_argument("verb", choices=("show", "hold", "lift", "stuck", "reset", "spend", "armed"))
    ap.add_argument("what", nargs="?", choices=tuple(SPEND_CAPS), help="spend's counter")
    ap.add_argument("--worktree")
    ap.add_argument("--repo")
    ap.add_argument("--branch")
    ap.add_argument("--head", help="hold: the PR's head the hold was taken at")
    ap.add_argument("--reason", choices=HOLD_REASONS, help="hold: why the lander holds the PR")
    ap.add_argument("--started", action="store_true", help="hold: the road's session has started")
    ap.add_argument("--aside", action="store_true",
                    help="reset: set a lander.json that does not parse aside and start a new store — every branch's caps "
                         "and stuck states with it, so a person's or the tick's word only")
    a = ap.parse_args(argv)
    if a.verb == "armed":
        why = lander_armed()
        print("armed: a stop here is the lander's" if not why else "not armed: %s" % why)
        return 0 if not why else 3
    if (a.verb == "spend") != bool(a.what):
        print("autofinish-run lander: spend names its counter (%s), and only spend takes one" % "|".join(SPEND_CAPS),
              file=sys.stderr)
        return 2
    if a.verb == "hold" and not (a.head and a.reason):
        print("autofinish-run lander: hold takes --head SHA and --reason %s" % "|".join(HOLD_REASONS), file=sys.stderr)
        return 2
    if a.aside and a.verb != "reset":
        print("autofinish-run lander: --aside goes with reset only", file=sys.stderr)
        return 2
    if a.verb in ("reset", "lift") and (unattended_caller() or any(os.environ.get(n) for n in PRIO_UNATTENDED)):
        # a reset clears a stuck ship's caps and a lift its hold: the tick's (launchd, S8's label road) or a person's,
        # never a run's own way past its cap or its hold (AGENTS.md's unattended-caller trap; the landing review)
        print("autofinish-run lander: %s is the tick's or a person's, never an unattended run's" % a.verb, file=sys.stderr)
        return 2
    if a.verb == "show" and not (a.worktree or a.repo or a.branch):
        try:
            print(json.dumps(lander_read(), indent=1, ensure_ascii=False, sort_keys=True))
        except StoreUnreadable as e:
            print("autofinish-run lander: %s does not read — %s" % (lander_path(), e), file=sys.stderr)
            return 3
        return 0
    try:
        key = lander_key(*lander_target(a))
    except ValueError as e:
        print("autofinish-run lander: %s" % e, file=sys.stderr)
        return 2
    said = []

    def act(e):
        if a.verb == "hold":
            e["hold"] = {"label": LANDER_HOLD, "head": a.head, "reason": a.reason, "started": bool(a.started)}
        elif a.verb == "lift":
            e["hold"] = None
        elif a.verb == "stuck":
            e["state"] = "stuck"
        elif a.verb == "reset":
            reset_entry(e)
        elif a.verb == "spend":
            n = int(e.get(a.what) or 0)
            if n >= SPEND_CAPS[a.what]:
                said.append("%s spent on %s (%d of %d): stuck, the owner's" % (a.what, key, n, SPEND_CAPS[a.what]))
                return STUCK_RC
            e[a.what] = n + 1
        said.append(json.dumps(e, ensure_ascii=False, sort_keys=True))
        return 0
    try:
        if a.verb == "show":
            e = lander_read().get(key)
            print(json.dumps(e if isinstance(e, dict) else None, ensure_ascii=False, sort_keys=True))
            return 0
        rc = lander_update(key, act, replace=a.verb == "reset", aside=a.aside)
    except StoreUnreadable as e:
        print("autofinish-run lander: %s does not read — %s; nothing written" % (lander_path(), e), file=sys.stderr)
        return 3
    print(said[-1] if said else "", file=sys.stderr if rc else sys.stdout)
    return rc


# the callers prio_refusal judges as unattended: a raise from one is judged on its own run's record
PRIO_UNATTENDED = ("REGATTA_UNATTENDED", "CLAUDE_UNATTENDED", "SKIPPER_SCOPE", "AUTOFINISH_CALLER_UNATTENDED")


def prio_refusal(prio):
    """Why this caller may not give the landing PRIO, or None (force-any; the header's --priority): dispatch's
    own rule, judged in this process, since dispatch --start runs under the detached waiter with no session.
    force never from an unattended caller, else dispatch-queue's force-ok; high from an unattended caller only
    when its own run's record is high (caller-prio)."""
    if not prio:
        return None
    unattended = [n for n in PRIO_UNATTENDED if os.environ.get(n)]
    q = os.path.join(HERE, "dispatch-queue")
    if prio == "force":
        if unattended:
            return ("--priority force is the owner's word for one run, and an unattended caller never raises to it (%s)"
                    % unattended[0])
        r = subprocess.run([sys.executable, q, "force-ok"], capture_output=True, text=True)
        return None if r.returncode == 0 else (r.stdout.strip() or r.stderr.strip()[-200:] or "the force check failed")
    if unattended:
        r = subprocess.run([sys.executable, q, "caller-prio"], capture_output=True, text=True)
        if r.stdout.strip() != "high":
            return ("--priority high is a raise, and an unattended caller never raises a run's priority (its own run's "
                    "record says %s)" % (r.stdout.strip() or "none"))
    return None


def spend_force():
    """The caller's force mark spent (dispatch-queue's spend_force, the one home of where it lives)."""
    try:
        load_bin("dispatch-queue").spend_force()
    except Exception:  # noqa: BLE001 — a mark left behind ages out at MARK_AGE; never worth the start
        traceback.print_exc()


def refuse(t, args, why):
    """Say the refusal and exit with its code (a Refusal's rc, else 3). Today's same-tip refusal is counted in
    lander.json's `refusals` under the store's lock, never in autofinish.json (a refuser rewriting the run record
    while a run may be live would race record()), and logged once an hour per branch (stuck-ships S1: a caller's
    loop wrote 20 lines every 120 s)."""
    if isinstance(why, Refusal):   # one line, its rc and marks kept: cold_prompt reads the last line as the whole reason
        flat = Refusal(" ".join(why.split()), why.rc, why.same_tip)
        flat.road = why.road
        why = flat
    else:
        why = " ".join(str(why).split())
    args.refused_why = why   # a claimed finish's word to the queue (queued_main)
    print("autofinish-run: not starting %s — %s" % (t.branch, why), file=sys.stderr)
    road = " road=%s" % args.road if getattr(args, "road", None) else ""
    quiet = (getattr(why, "same_tip", False) and not is_person(args.by)) or getattr(why, "road", False) \
        or args.by == "lander"   # every lander refusal, a lock's or no account's too: the tick asks every 5 min
    # a claim of another host's put writes no lander.json here (S1's one store is the putting host's): logged plainly
    sent = bool(getattr(args, "sent", False))
    if getattr(why, "same_tip", False) and not args.dry and not quiet and not sent:
        count_refusal(t, args.by)   # a person's: counted, and logged every time
    if not args.dry and (not quiet or sent or count_refusal(t, args.by, counted=getattr(why, "same_tip", False), text=str(why))):
        log("%s run %s %s refused tip=%s rule=%s by=%s%s — %s" % (now_iso(), t.repo, t.branch, t.tip[:7],
                                                                  args.rule, args.by, road, why))
    return getattr(why, "rc", 3)


def count_refusal(t, by, counted=True, text=""):
    """One same-tip refusal counted per tip ({tip, n, first, last, by, logged}); True when it is to be logged (the
    first on a tip, or an hour since the last logged). A store that does not read or write: logged, uncounted. A lander
    road's wait (counted False) is not counted, only logged once an hour (its own `road_logged`): the tick asks every
    5 minutes (review 1)."""
    now = time.time()

    def wait(e):
        # {text: when logged}, the hour's only: a text logged in the last hour is not logged again
        seen = {k: v for k, v in (e.get("road_logged") or {}).items() if isinstance(v, (int, float))
                and now - v < REFUSAL_LOG_S} if isinstance(e.get("road_logged"), dict) else {}
        key = re.sub(r"\d+", "#", text)   # a pick's reasons quote figures that move every tick (review 4)
        say = key not in seen
        if say:
            seen[key] = now
        e["road_logged"] = seen
        return say

    def bump(e):
        r = e.get("refusals") if isinstance(e.get("refusals"), dict) else None
        if not r or r.get("tip") != t.tip:
            r = {"tip": t.tip, "n": 0, "first": now_iso(), "last": None, "by": by, "logged": 0}
        n, logged = r.get("n"), r.get("logged")   # a count is the log's, never a cap: a bad one restarts, never crashes
        r.update(n=(n if isinstance(n, int) and not isinstance(n, bool) else 0) + 1, last=now_iso(), by=by)
        say = now - (logged if isinstance(logged, (int, float)) and not isinstance(logged, bool) else 0) >= REFUSAL_LOG_S
        if say:
            r["logged"] = now
        e["refusals"] = r
        return say
    try:
        return lander_update(lander_key(t.primary, t.branch), bump if counted else wait)
    except (OSError, StoreUnreadable):
        return True


def refuse_tip(t, args, why):
    """The origin gate's refusal: ORIGIN_RC."""
    refuse(t, args, why)
    return ORIGIN_RC


def end_warm(t, args, cap=None):
    """A seeded run of this branch is kept the cache's hour, past autofinish's 40 min: it is ended
    first, then the branch launches (the owner, D2 of docs/dispatch-warm-hour-2026-10-08.md: C). A busy
    one is not the launch's to end: no launch — the why, else None.
    Under the start lock and the sweep's RUNNER_TIMEOUT (both 120 s): ending a run takes ~15 s
    with its window out of view (close tries, the SIGTERM wait, CLOSE_WAIT), so 90 s, and a
    timeout is a refusal — the next sweep tries again (re-review of 2026-10-08). A typed hand-off
    gets 30 s: cold_prompt kills this process at 45 s, and a refusal lets the /finish run in its tab."""
    warm_s = 30 if args.by == "typed" else 90
    if cap is not None:   # a send's budget (route())
        warm_s = min(warm_s, cap)
    try:
        warm = subprocess.run((shlex.split(END_WARM) if END_WARM else [sys.executable, os.path.join(HERE, "dispatch-rc"), "end-warm"])
                              + [t.branch, t.primary] + (["--dry-run"] if args.dry else []),
                              capture_output=True, text=True, timeout=warm_s)
    except subprocess.TimeoutExpired:
        warm = subprocess.CompletedProcess([], 1, "", "ending its warm run took over %d s" % warm_s)
    if warm.stdout.strip():
        print(warm.stdout.strip())
    if warm.returncode:
        return "its dispatch run could not be ended first: " + (warm.stdout.strip() or warm.stderr.strip()[-200:])
    t.warm_stopped = bool(warm.stdout.strip()) and not args.dry   # end-warm names each run it ended, and only then speaks
    return None


def lander_spend(t, args, n, sid=None, restore=False):
    """A lander start's road spent (n 1) before the run's state is written, or refunded (n -1) when dispatch refused
    it or no child started (stuck-ships S1: spent on every exit-0 verdict — started, unconfirmed — never on a
    refusal). Spent before the detach, not after the verdict: a caller's timeout that kills this process during the
    verdict wait leaves a run going and must not leave its road unspent (review 1). The spend keeps `spent` {session,
    road}, so a refused record of that session later gives it back once (lander_refusal), and the stop it passed on as
    `stop`, `stop_for` that session, so the next road judges the stop, never the refused record. True when written,
    False when it cannot be: a spend that cannot be written refuses the start (an uncapped road: review 2); a refund
    that cannot is said. A Refusal (STUCK_RC) when the road's cap, judged again under the store's lock, is spent."""
    road = args.road
    stop = getattr(t, "stop", None) or {}

    def spend(e):
        if n < 0:
            if (e.get("spent") or {}).get("session") == sid:   # this start's own, never another's (review 4)
                refund_spent(e, restore)
            return
        if road_spent(e, road) >= ROAD_CAPS[road]:
            # the cap again, under the store's lock: lander_refusal read it without one, and a start lock gone stale
            # past a slow predicate lets a second lander start reach here (the /finish review, 2026-11-03)
            raise RoadSpent(road_spent(e, road))
        road_add(e, road, 1)
        e["spent"] = {"session": sid, "road": road, "stop_for_before": e.get("stop_for")}
        e["first_stop"] = e.get("first_stop") or stop.get("ended")
        if stop and stop.get("gate") not in REFUSED_GATES:
            e["stop"] = {k: stop.get(k) for k in STOP_KEYS}
        if e.get("stop"):
            e["stop_for"] = sid
    try:
        lander_update(lander_key(t.primary, t.branch), spend)
        return True
    except RoadSpent as e:
        return Refusal("the %s road is spent on %s (%d of %d): stuck, the owner's" % (
            road, t.branch, e.args[0], ROAD_CAPS[road]), STUCK_RC)
    except (OSError, StoreUnreadable) as e:
        print("autofinish-run: lander.json not written (the %s road's %s) — %s" % (
            road, "spend" if n > 0 else "refund", e), file=sys.stderr)
        return False


def keep_chain_stop(t, prev, sid):
    """A chain relaunch of a lander run keeps that run as the entry's stop, `stop_for` its own session, no road spent:
    should it never start or die, the next road judges the lander run it relaunched — which usually rebased and
    pushed — never the older stop before it, on which every road would refuse a HEAD it never saw (round 2)."""
    if not prev or prev.get("gate") in REFUSED_GATES:
        return
    try:
        lander_update(lander_key(t.primary, t.branch),
                      lambda e: e.update(stop={k: prev.get(k) for k in STOP_KEYS}, stop_for=sid))
    except (OSError, StoreUnreadable) as e:
        print("autofinish-run: lander.json not written (the chain's kept stop) — %s" % e, file=sys.stderr)


def lander_after_start(t, args, prev):
    """After an exit-0 verdict: a person's start (typed, or one carrying --merge, with no unattended caller; never
    `override` alone, the default of an unnamed caller) resets the counts and the state, the hold kept."""
    if not (is_person(args.by) and (args.by == "typed" or args.merge)):
        return
    try:
        lander_update(lander_key(t.primary, t.branch), reset_entry, replace=True)
    except (OSError, StoreUnreadable) as e:
        print("autofinish-run: lander.json not written (the reset) — %s" % e, file=sys.stderr)


def write_chain(t, sessions):
    """CHAIN for this tip, replaced whole (count_chain and uncount_chain)."""
    tmp = os.path.join(t.state_dir, "%s.%d" % (CHAIN, os.getpid()))
    with open(tmp, "w") as f:
        json.dump({"tip": t.tip, "sessions": sessions}, f)
    os.replace(tmp, os.path.join(t.state_dir, CHAIN))


def count_chain(t, prev, sid):
    """A chain start, counted before the detach: a start that fails is refused, which chain_refusal skips."""
    write_chain(t, chain_spent(t, prev) + [sid])


def start(t, args):
    """The refusals, then the queue or the start here (the header's Where), under the start lock main() holds."""
    prev = read_state(t)
    # a claimed finish another host put: judged here as a run that host sent (refusal()'s `sent`) — only the claim's
    # job makes it one (queued_main, past `mine`)
    sent = bool(args.queue and args.sent)
    t.own_claim = bool(args.queue and not args.sent)
    # The origin gate between what no tree moves under and the refusals that read the tip: they judge the tip that
    # lands (a stop on the old tip is no refusal of the one origin moved on to; AGENTS.md's launched-tip trap). A
    # lander start is judged whole before it (tree_refusal), as a chain relaunch is: its road names the stop's tip
    road = getattr(args, "road", None)
    why = tree_refusal(t, prev, args.by, sent, road=road, dry=getattr(args, "dry", False)) \
        or lock_refusal(t, args.session, args.by == "typed") or store_refusal(t, args)
    if why:
        return refuse(t, args, why)
    # a claimed finish lands the tip its entry names: its tree is never moved here (queued_worktree put it there).
    # A lander start judged its tip whole above: tip_gate never moves the tree or ends a warm run for it (round 3:
    # a fast-forward before judged_stop's refusal left HEAD past the stop's tip, and every road refused it after)
    why = tip_gate(t, args, follow=not args.queue and args.by != "lander")
    if why:
        return refuse_tip(t, args, why)
    # a lander start was judged whole above, on this very tip (tip_gate refuses it any other): its road's predicate
    # reads GitHub and spends nothing twice
    why = None if args.by == "lander" else refusal(t, prev, args.by, sent=sent)
    if why:
        return refuse(t, args, why)
    # A chain relaunch of a yolo launch is a yolo launch again (chain-manager E3; bin/autofinish's
    # runner_by() keeps a died yolo retry yolo for the same reason): a plain /finish --unattended
    # would merge the answers yolo took where the yolo run stops at a held PR. Recorded as `yolo`,
    # so start_cmd, runner_by and the next chain relaunch all read it as one; CHAIN and the log's
    # `via=chain` say the tick started it.
    # The same for a brief or a ship launch (the autofinish-exclude landing review, finding 5): recorded
    # as `chain` it would pass landing() with no hold and bin/pr's re-judge would skip it, so a class-2
    # diff held at the brief, or a ship the keel held, would land on the tick's relaunch. Its hold, too,
    # is carried: a relaunch never holds less than the run it continues.
    # Claimed from another host's put, only its own run on this tip: a sent chain's prev may be an older tip's run
    # (refusal()'s `sent`). The putting host resolved the launch already, and leaves only a plain one unpinned (ladder_stay)
    by = (prev or {}).get("by") if args.by == "chain" and (prev or {}).get("by") in CHAIN_KEEPS \
        and (not sent or (prev or {}).get("tip") == t.tip) else args.by
    via = " via=chain" if args.by == "chain" else ""
    if args.by == "lander":   # stuck-ships S1: recorded `lander`, logged with the stopped run's by
        try:
            judged = road_stop(prev, lander_entry(t)) or {}
        except StoreUnreadable:
            judged = prev or {}
        via = " via=%s" % (judged.get("by") or "none")
        t.stop = judged
    elif by == "lander":
        # a chain relaunch of a lander run (CHAIN_KEEPS): its stop is that run, whose flag landing() weighs as the
        # lander start's own (round 1: judged by handed_held, it carried --dnd with no --hold)
        t.stop = prev or {}
    # a claimed lander start carries its put's word on the flag (enqueue's `land_by`), which landing() reads first
    t.flag_word = (getattr(args, "entry_land_by", None),) if args.queue and args.by == "lander" else None
    # a hand-over's note and waiver: its own on a handed start, the stop's on a chain or lander relaunch of one
    t.handover = handover_of(by, args.by, t.stop if by == "lander" else prev if args.by == "chain" else None)
    hold, mode, eff = landing(t, by, args.rule)
    hold_from = None   # whose hold this start carries, where it carries one rather than judging it (OPTIONAL_KEYS)
    # A carried hold rides on whether or not this start's own landing() also holds: decided apart from `hold`, so a
    # start held by its own judgement (mode ask) still records the hold it carries, and a mode raised before the next
    # start never drops it (the S1 landing's review, round 2)
    if args.by == "chain" and (prev or {}).get("hold"):
        hold, hold_from = prev["hold"], prev.get("hold_from") or prev.get("session")
    if args.by == "lander" and t.stop.get("hold"):
        hold = t.stop["hold"]   # the stopped run's hold, verbatim: a run the mode held is held again for the tap
        hold_from = t.stop.get("hold_from") or t.stop.get("session")
    # the mode flag (stuck-ships S1): a mode launch writes its own; a lander or chain relaunch carries the stopped
    # run's, else its by when that was a mode launch — `via` is the log's only, so a second hop would drop it
    p = prev or {}
    if args.by == "lander":
        p = t.stop   # the stop the road judged, past a refused start's record
    # a chain relaunch that fell back to `chain` (a new tip) carries no flag: landing() judges `chain` by no slice, so a
    # flag there would land a mode launch held_slice never saw (the /finish review, 2026-11-03)
    t.land_by = (by if by in LAND_BY else lander_flag(p)) \
        if args.by == "lander" or (args.by == "chain" and by != "chain") else None
    if by not in LAND_BY and t.land_by and not flag_rides(t, t.land_by, p, mode):
        # the flag is the mode's yes to the taken answers: carried only while the branch's mode still says it (a mode
        # lowered since would have a lander relaunch land what a chain relaunch's held_slice holds: review 1)
        t.land_by = None
    if args.queue and args.by == "lander" and t.land_by != getattr(args, "entry_land_by", None):
        # a claimed lander start keeps a flag only where its put judged the same one (enqueue's `land_by`): the
        # entry's word narrows this judgement, never widens it
        t.land_by = None
    # the keel's no (S6): a mode that would merge is not asked, and a later launch of this worktree —
    # the sweep's retry of a held run that died starts `--by sweep`, no --hold — keeps it. Its own key,
    # not the text of `hold`: a launch that another rule held first (mode ask) records that rule's
    # reason, and the keel's no must outlive it (S6's finish review)
    keel_hold = bool(args.hold or (prev or {}).get("keel_hold") or (prev or {}).get("hold") == SHIP_HOLD)
    if args.by == "lander":   # the keel's no of the stop the road judged, past a refused start's record (round 3)
        keel_hold = keel_hold or bool(t.stop.get("keel_hold") or t.stop.get("hold") == SHIP_HOLD)
    if ((prev or {}).get("outcome") == DIED or (prev or {}).get("gate") in REFUSED_GATES) \
            and prev.get("hold") and prev.get("hold_from") \
            and not (is_person(args.by) and (args.by == "typed" or args.merge)):
        # A retry carries the prior hold, as a chain relaunch does. Dispatch refusing a start (or a failed detach)
        # replaces `died` with a refused record, but releases no hold. Its caller may now be `sweep` or a mode
        # launch instead of `lander`: the hold must survive every retry. A person's own launch (typed, or carrying
        # --merge, as lander_after_start reads one) is that person's yes, never held by it. A changed tip gives no tap.
        # Only a carried hold rides on (`hold_from`): a hold the retried run judged itself by the mode (ask) is
        # judged again by this start's landing(), so a mode raised since is read
        hold, hold_from = prev["hold"], prev["hold_from"]
    # a lander start's own hold that is no mode ask (handed_held's slice, a mode that will not read) is one a sweep
    # retry's landing() never judges again, so it is marked carried, from this run (start_here fills the session)
    t.hold_own = bool(args.by == "lander" and hold and not hold_from and mode != "ask")
    if keel_hold and not hold:
        hold = SHIP_HOLD
    t.hold_from = hold_from   # start_here records it beside the hold (OPTIONAL_KEYS)
    t.asked = (args.by, bool(args.merge), args.digest)   # the put's rights: the caller's words, the ladder judged again where it is claimed
    if hold and args.merge:
        args.merge = False   # a held launch merges nothing: no `--merge` in its prompt or state beside `--hold`
    if by == "lander" and t.land_by and not eff:
        eff = t.land_by   # the mode the kept flag stands for, so the next hop from this record keeps it (review 5)
    t.ladder = (hold, mode, keel_hold, eff)
    if not args.queue and queue_home():
        try:
            return enqueue(t, args, by, via)
        except OutOfTime as e:
            return refuse(t, args, str(e))
        except TipMoved as e:
            return refuse_tip(t, args, str(e))
    return start_here(t, args, prev, by, via)


def start_here(t, args, prev, by, via):
    """The run on this Mac: the login, the warm run, the writes and the detach."""
    hold, mode, keel_hold, eff = t.ladder
    try:
        # cached for --dry, and for a typed hand-off: cold_prompt waits 45 s on this, in a prompt hook.
        # Before the warm run's end below: a run no account can take ends nothing, bar a tip behind origin,
        # whose warm run the origin gate ended before moving the tree
        label, cfg, picked = account_pick(t, cached=args.dry or (args.by == "typed" and not args.queue) or getattr(t, "pick_cached", False))
    except NoAccount as e:
        why = "no account may run this now — %s" % e
        return refuse(t, args, why)
    if getattr(t, "stay", None):
        picked += "; here: %s" % t.stay
    # route() or the origin gate ended it already. Capped by the budget: past it no caller is still waiting
    why = None if getattr(t, "warm_ended", False) else end_warm(t, args, cap=max(3, t.deadline - time.time()))
    if why:
        return refuse(t, args, why)
    if getattr(t, "warm_stopped", False) and not getattr(t, "warm_ended", False):
        # a run just ended here: its last checkpoint is the tip, and its last push is origin's
        t.tip = git(t.path, "rev-parse", "HEAD") or t.tip
        why = tip_gate(t, args, follow=False, strict=True)
        if why:
            return refuse_tip(t, args, why)
    use_account(cfg)
    sid = str(uuid.uuid4())
    try:
        arm, arm_why = draw_arm(t)
    except Exception as e:  # noqa: BLE001 — the rotation never costs a start: today's finisher
        arm, arm_why = None, "rotation off: %s" % type(e).__name__
    # the key there but no arm drawn says so in the day's log; no key file, the start line is unchanged
    arm_off = not arm and not arm_why.startswith("rotation off: no %s" % ROTATION_KEY)
    st = {"started": now_iso(), "session": sid, "tip": t.tip, "by": by, "rule": args.rule,
          "window": t.session, "account": label, "ended": None, "outcome": None, "pr": None, "gate": None,
          "merge": args.merge, "hold": hold, "keel_hold": keel_hold, "from": args.sent_from, "queue": args.queue,
          "eff_mode": eff, "land_mode": mode, "arm": arm, "land_by": getattr(t, "land_by", None),
          "hold_from": (getattr(t, "hold_from", None) or (sid if getattr(t, "hold_own", False) else None)) if hold else None,
          "road": args.road if args.by == "lander" else None,
          # a hand-over's, for a relaunch of this landing (handover_of): written only on one
          "handover": bool(getattr(t, "handover", (False,))[0]) or None,
          "owed": list(getattr(t, "handover", (False, []))[1]) or None,
          # the landing's rank (--priority): a review stop's fix round goes at it, or high (fix_round_line)
          "priority": getattr(args, "priority", None)}
    cmd = start_cmd(t, sid, by=by, merge=args.merge, hold=hold, arm=arm, sent_from=args.sent_from,
                    priority=getattr(args, "priority", None), land_by=st["land_by"],
                    queue=(args.queue, args.job) if args.queue else None)
    try:
        targets = open_sessions(t, args.session, args.by == "typed")
    except Exception as e:  # who to tell is never worth the launch: notify then sends nothing
        targets = []
        print("autofinish-run: the sessions open on %s were not read — %s" % (t.branch, e), file=sys.stderr)
    if args.dry:
        print("autofinish-run --dry: %s in %s, tip %s, rule %s, by %s%s" % (t.branch, t.path, t.tip[:7], args.rule, by, via))
        print("mode %s: %s" % (mode or "none", "held at a ready PR — " + hold if hold else "may merge, past the check and the review gate"))
        print("account %s%s: %s" % (label or "unchanged", " (%s)" % cfg if cfg else "", picked))
        print("finisher %s: %s" % ("%s (%s, %s)" % (arm["name"], arm["model"], arm["effort"]) if arm else "today's", arm_why))
        print("would write %s:" % os.path.join(t.state_dir, STATE))
        print("  " + json.dumps(contract(st), ensure_ascii=False))
        print("would write %s: session %s" % (os.path.join(t.state_dir, common.OWNER_FILE), sid))
        print("would write %s: tell %s" % (os.path.join(t.state_dir, NOTIFY), ", ".join(x[:8] for x in targets) or "nobody"))
        text = bundle_text(t)
        print("would write %s (%d characters), beginning:" % (os.path.join(t.state_dir, BUNDLE), len(text)))
        print("\n".join("  | " + l for l in text.splitlines()[:6]))
        print("would run, detached, output to %s:" % t.runlog)
        print("  " + " ".join(shlex.quote(c) for c in cmd))
        print("dispatch --start --dry-run says the session would be:")
        sys.stdout.flush()
        # without --priority: judged above (prio_refusal). dispatch's own force check would see this caller's claude
        # among its parents and no session id (start_env drops it), and refuse what the real start, under the
        # detached waiter, passes; the session it prints is the same either way
        with common.finish_pick_env(start_env(t), target="dispatch") as (env, fds):
            return subprocess.call(start_cmd(t, sid, dry=True, by=by, merge=args.merge, hold=hold, arm=arm, sent_from=args.sent_from,
                                             land_by=st["land_by"]),
                                   env=env, pass_fds=fds)
    try:
        with open(os.path.join(t.state_dir, common.OWNER_FILE)) as f:
            before = f.read()
    except OSError:
        before = None
    lander = args.by == "lander"
    spent = lander_spend(t, args, 1, sid) if lander else True
    if isinstance(spent, Refusal):
        return refuse(t, args, spent)
    if not spent:
        return refuse(t, args, "the lander's store %s does not write: the %s road cannot be spent" % (lander_path(), args.road))
    try:
        write_state(t, st)
    except OSError:
        if lander:
            lander_spend(t, args, -1, sid, restore=True)   # nothing ran, no record: the road and stop_for given back
        raise
    try:
        write_targets(t, sid, targets)
    except OSError as e:  # never worth the launch: notify then finds no file and sends nothing
        print("autofinish-run: %s not written — %s" % (NOTIFY, e), file=sys.stderr)
    common.write_owner(t.state_dir, sid, t.branch)
    if args.by == "chain" and by == "lander":
        keep_chain_stop(t, prev, sid)
    if args.by == "chain" and not (args.queue and not args.sent):   # a put here counted it already (enqueue)
        count_chain(t, prev, sid)
    log("%s run %s %s started session=%s tip=%s rule=%s by=%s%s account=%s window=\"%s\" — %s" % (
        st["started"], t.repo, t.branch, sid[:8], t.tip[:7], args.rule, by, via + (" merge=yes" if args.merge else "")
        + (" road=%s stopped_on=%s" % (args.road, getattr(t, "stop", {}).get("account") or "-") if args.by == "lander" else "")
        + (" hold=\"%s\"" % hold if hold else "") + (" arm=%s" % arm["name"] if arm else " arm=off (%s)" % arm_why if arm_off else ""),
        label or "-", t.session, picked))
    try:
        log_from = os.path.getsize(t.runlog)
    except OSError:
        log_from = 0
    try:
        detach("wait_for_end", t, (st, cmd), t.runlog)
    except OSError as e:
        # no child: a lock naming a session that never exists would refuse the panel for 2 h
        if lander:
            lander_spend(t, args, -1, sid)
        give_back(t, sid, before, st)
        print("autofinish-run: %s did not start — %s; the lock is given back" % (t.branch, e), file=sys.stderr)
        log("%s run %s %s never-started gate=%s session=%s tip=%s rule=%s by=%s — the detach failed: %s" % (
            st["ended"], t.repo, t.branch, REFUSED, sid[:8], t.tip[:7], args.rule, by, e))
        return 1
    # What happened is dispatch's to say (night-landings finding 1): `started` only once its header is in the
    # log, never at the detach. The waiter records the end of a refusal itself
    bound = verdict_bound(t)
    kind, detail = await_verdict(t, sid, log_from, bound)
    if kind in ("refused", "no-account"):
        if lander:
            lander_spend(t, args, -1, sid)
    elif not args.sent:   # a finish another host put: its caps are that host's store, reset at its put (enqueue)
        lander_after_start(t, args, prev)
    return report_verdict(t, kind, detail, bound, "state %s; log %s" % (os.path.join(t.state_dir, STATE), t.runlog),
                          "started: %s — window and Remote Control \"%s\", session %s, account %s; state %s; log %s" % (
                              finish_prompt(t.branch, by, args.merge, hold=hold, sent_from=args.sent_from,
                                            land_by=st["land_by"]), t.session, sid,
                              label or "unchanged", os.path.join(t.state_dir, STATE), t.runlog))


def report_verdict(t, kind, detail, bound, where, started_line):
    """Print the caller's line for a verdict (started on stdout, the rest on stderr, which a sweep quotes) and
    return the exit code: 0, REFUSED_RC or UNCONFIRMED_RC. Not confirmed is on stdout with the window, as a start
    is: cold_prompt names the window from it."""
    if kind == "started":
        print(started_line)
        return 0
    if kind in ("refused", "no-account"):
        print(not_started_text(str(detail)) + "; " + where, file=sys.stderr)
        return REFUSED_RC
    line = ("not confirmed after %d s: dispatch has not said whether the run began, and it may still — window and "
            "Remote Control \"%s\"; read %s" % (bound, t.session, t.runlog))
    print(line)
    return UNCONFIRMED_RC


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception:   # noqa: BLE001 — never Python's 1
        traceback.print_exc()
        if _PUT[0]:   # a put may have landed: 0, not confirmed — any non-zero lets a typed /finish run in its tab beside it
            print("not confirmed: autofinish-run crashed after its put (above); read the queue: dispatch --queue")
            sys.exit(UNCONFIRMED_RC)
        print("not started: autofinish-run crashed before any put (above)", file=sys.stderr)
        sys.exit(REFUSED_RC)
