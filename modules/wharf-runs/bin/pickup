out["context"] = {k: context_of(f) for k, f in out["transcripts"].items()}
def replies_of(f):  # branch_replies comes from bin/pickup too: a fresh start's bundle needs them
    try:
        with open(f, encoding="utf-8", errors="replace") as fh:
            return branch_replies(fh, branch)
    except OSError:
        return []
out["replies"] = {k: replies_of(f) for k, f in out["transcripts"].items()}
print(json.dumps(out))
'''


class Stop(Exception):
    """A clean stop with a message for the owner, never a traceback. code 2 = ambiguous REF."""
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


# ---- small helpers ----------------------------------------------------------------------

def run(args, timeout=30, env=None, input=None):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env, input=input)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(args, 124, "", f"timed out after {timeout} s")


def git(where, *args, timeout=30):
    return run(["git", "-C", str(where), *args], timeout=timeout)


def out(where, *args):
    return git(where, *args).stdout.strip()


def epoch(iso):
    try:
        return datetime.datetime.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except (TypeError, ValueError):
        return 0.0


def ago(ts):
    if not ts:
        return "?"
    s = max(0, time.time() - ts)
    if s < 90:
        return "just now"
    if s < 3600:
        return f"{int(s // 60)} min ago"
    if s < 36 * 3600:
        return f"{int(s // 3600)} h ago"
    return f"{int(s // 86400)} d ago"


def short(text, n=110):
    text = " ".join((text or "").split())
    return text if len(text) <= n else text[:n - 1] + "…"


def rel(path, root):
    try:
        return str(Path(path).relative_to(root))
    except ValueError:
        return str(path)


def repo_root(where):
    """The primary checkout that owns `where` (through any worktree), or None."""
    r = git(where, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if r.returncode:
        return None
    common_dir = Path(r.stdout.strip())
    return common_dir.parent.resolve() if common_dir.name == ".git" else None


def main_branch(root):
    try:
        return json.loads((root / ".claude" / "workflow.json").read_text()).get("main") or "main"
    except (OSError, ValueError):
        return "main"


def parse_name(name):
    """(host, date, topic) of claude/<host>/<date>-<topic>; hostless names predate 2026-09-22."""
    m = NAME_RE.match(name)
    return (m.group("host"), m.group("date"), m.group("topic")) if m else (None, None, name.rsplit("/", 1)[-1])


# ---- transcripts and the live registry --------------------------------------------------

def clean_prompt(text):
    """What the owner typed: IDE context blocks dropped, a slash command shown as typed, and a
    block the harness injected (a <task-notification>, which checkpoint.py also quotes as a
    "prompt") dropped entirely."""
    text = IDE_BLOCK.sub("", text or "").strip()
    m = COMMAND.search(text)
    if m:
        return f"{m.group('name')} {(m.group('args') or '').strip()}".strip()
    return "" if re.match(r"<[a-z][\w-]*(?:\s[^>]*)?>", text) else text


def prompt_text(record):
    c = (record.get("message") or {}).get("content")
    return clean_prompt(c if isinstance(c, str) else " ".join(
        b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text"))


def context_step(line, st):
    """One transcript line into `st`: the context the last main-chain API call carried
    (docs/record/pickup-cold-handoff-2026-09-29.md E1). `ctx` = input + cache read + cache write of
    the last call — a compaction shows as a drop, so the last one wins; `ctx_at` = when that request
    began (the last user/tool-result record before it), `ctx_end` = the record's own time, `ttl` =
    the cache bucket its writes go into ("5m" in usage overage), `first_ctx` = the first call's size,
    a fresh session's cost here. What counts as a call is the core's `transcript.call_line`
    (sidechains, `<synthetic>` stand-ins and zero totals skipped), the one rule every reader shares;
    it parses only lines that name an assistant and a usage. User lines — tool output runs to
    megabytes a line and `list` reads every transcript — get substring tests only, and the lines
    themselves are kept (references, not copies) for context_done() to read the times from, once.
    PEER_PROBE carries this source and the core's to the other machine.
    The record type decides first: a user record holding an Agent tool's result carries a
    `"usage":{` of its own (toolUseResult.usage) and is still a request's start (review
    2026-09-29). `isSidechain` is the record's second key, so only the head is searched."""
    # An assistant record's tool input is structured JSON and can hold `"type":"user"` (7 of
    # 55,392 on this Mac, 2026-09-29); no user record holds `"type":"assistant"` (0 of 32,336).
    if '"type":"user"' in line and '"type":"assistant"' not in line:
        if '"isSidechain":true' not in line[:300]:
            st["_user"] = line
        return
    c = call_line(line)
    if not c:
        return
    total = c[2]
    n = {}
    for m in USAGE_NUM.finditer(line, max(0, line.find('"usage":{'))):  # the top-level fields come first; `iterations` repeats them
        n.setdefault(m.group(1), int(m.group(2)))
        if len(n) == 5:
            break
    w5, w1 = n.get("ephemeral_5m_input_tokens", 0), n.get("ephemeral_1h_input_tokens", 0)
    if w5 or w1:  # a call that wrote nothing says nothing about the TTL: keep the last one's
        st["ttl"] = "5m" if w5 and not w1 else "1h"
    st.update(ctx=total, first_ctx=st.get("first_ctx") or total, _last=line, _asked=st.get("_user"))


def context_done(st):
    """The times context_step() left as lines: `ctx_end` = the usage record's own, `ctx_at` =
    the request's start, i.e. the user or tool-result record before it (0fe75666's tail: user
    03:27:35.856 → assistant 03:27:45.484), else a minute before the end. In a record the
    timestamp follows `message`, so it is searched from the `"type"` key on — and from the
    start when a writer sorted the keys (one transcript does, review 2026-09-29)."""
    stamp = re.compile(r'"timestamp":"([^"]+)"')

    def at(text, key):
        text = text or ""
        m = stamp.search(text, max(0, text.find(key))) or stamp.search(text)
        try:
            return datetime.datetime.strptime(m.group(1)[:19], "%Y-%m-%dT%H:%M:%S").replace(
                tzinfo=datetime.timezone.utc).timestamp()
        except (AttributeError, ValueError):
            return 0.0
    last, asked = st.pop("_last", None), st.pop("_asked", None)
    st.pop("_user", None)
    if last:
        end, begun = at(last, '"type":"assistant"'), at(asked, '"type":"user"')
        st.update(ctx_end=end, ctx_at=begun if 0 < begun <= end else end - 60, ttl=st.get("ttl") or "1h")
    return st


def scan(path):
    """What one transcript says about branches. Metadata records lead with their type
    (checked 2026-09-25: 8,622 of 8,622), so only those and human prompts are JSON-parsed;
    the rest — tool output up to megabytes a line — is only searched for `gitBranch`."""
    if path in SCANNED and SCANNED[path]["mtime"] == path.stat().st_mtime:
        return SCANNED[path]
    s = {"id": path.stem, "path": path, "mtime": path.stat().st_mtime, "title": None,
         "custom": None, "relocated": None, "wt": None, "on": {}, "last_branch": None,
         "prs": set(), "entrypoint": None, "asked": {}, "human": 0, "pickups": 0, "cwd0": None,
         "ctx": 0, "ctx_at": 0.0, "ctx_end": 0.0, "ttl": None, "first_ctx": 0,
         "reply": None, "pending": set(), "cwd_last": None, "reply_at": "", "prompt_at": "", "reply_branch": None}
    SCANNED[path] = s
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if line.startswith('{"type":"') and line[9:line.find('"', 9)] in META:
                kind = line[9:line.find('"', 9)]
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if kind == "ai-title":
                    s["title"] = r.get("aiTitle") or s["title"]
                elif kind == "custom-title":
                    s["custom"] = r.get("customTitle") or s["custom"]
                elif kind == "relocated":
                    s["relocated"] = r.get("relocatedCwd")
                elif kind == "worktree-state":
                    w = r.get("worktreeSession") or None
                    s["wt"] = {"path": w.get("worktreePath"), "branch": w.get("worktreeBranch")} if w else None
                elif kind == "pr-link" and r.get("prNumber"):
                    # with its repository: one session links PRs of several repos (the shop's
                    # 32a18e0f links site #4, and the shop has a #4 of its own)
                    s["prs"].add((r.get("prRepository"), r["prNumber"]))
                continue
            context_step(line, s)
            # the last reply on the main chain, for the status rules (reply_status); parsed
            # once, at the end, and only when it carries text or a tool call — not thinking alone
            if ('"type":"assistant"' in line and '"isSidechain":true' not in line[:300] and '"role":"assistant"' in line
                    and ('"type":"text"' in line or '"type":"tool_use"' in line)):
                s["reply"] = line
                t = STAMP.search(line)
                s["reply_at"] = t.group(1) if t else s["reply_at"]
                s["pending"].update(TOOL_USE_ID.findall(line))
                c = CWD.search(line)
                s["cwd_last"] = c.group(1) if c else s["cwd_last"]
                b = GIT_BRANCH.search(line)
                s["reply_branch"] = b.group(1) if b else s["reply_branch"]
            elif '"tool_use_id":"' in line:
                s["pending"].difference_update(TOOL_RESULT_ID.findall(line))
            m = GIT_BRANCH.search(line)
            if not m:
                continue
            branch = m.group(1)
            t = STAMP.search(line)
            if t:
                s["on"][branch] = t.group(1)  # the file is chronological: last write wins
            s["last_branch"] = branch
            if s["entrypoint"] is None:
                e = ENTRY.search(line)
                s["entrypoint"] = e.group(1) if e else None
            if s["cwd0"] is None:
                c = CWD.search(line)
                s["cwd0"] = c.group(1) if c else None
            if '"kind":"human"' in line:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("type") == "user" and (r.get("origin") or {}).get("kind") == "human":
                    text = prompt_text(r)
                    if text:
                        s["asked"][branch] = (r.get("timestamp"), text)
                        s["human"] += 1
                        s["pickups"] += text.startswith("/pickup")
                        s["pending"].clear()  # a call left open before the owner's next prompt is history
                        s["prompt_at"] = max(s["prompt_at"], r.get("timestamp") or "")
    context_done(s)
    return s


def slug_dirs(root, worktree_paths):
    base = slug(root)
    dirs = [PROJECTS / base, *sorted(PROJECTS.glob(base + "--claude-worktrees-*"))]
    dirs += [PROJECTS / slug(p) for p in worktree_paths]
    seen, found = set(), []
    for d in dirs:
        if d not in seen and d.is_dir():
            seen.add(d)
            found.append(d)
    return found


def running(pid, proc_start):
    """Alive, and the same process: the registry's procStart is `ps -o lstart` in UTC
    (checked 2026-09-25 on five live sessions), which catches a pid reused after a crash."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    except OSError:
        return False
    if not proc_start:
        return True
    r = run(["ps", "-o", "lstart=", "-p", str(pid)], env={**os.environ, "TZ": "UTC", "LC_ALL": "C"})
    return " ".join(r.stdout.split()) == " ".join(proc_start.split())


LIVE_RANK = {"busy": 2, "waiting": 1}  # which of two processes on one session speaks for it


def live_sessions():
    """{session id: registry entry} for every claude process running on this machine."""
    live = {}
    for f in REGISTRY.glob("*.json"):
        try:
            e = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(e.get("pid"), int) and e.get("sessionId") and running(e["pid"], e.get("procStart")):
            # two processes on one session (a reopened one beside the original): the busier one wins,
            # so a busy entry is never hidden by an idle one globbed after it
            prev = live.get(e["sessionId"])
            if prev is None or LIVE_RANK.get(e.get("status"), 0) > LIVE_RANK.get(prev.get("status"), 0):
                live[e["sessionId"]] = e
    return live


def this_session():
    """Who is asking: id, entrypoint, and how many prompts it had before /pickup — a session
    that already did other work should not adopt a second topic (--new-tab instead)."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    earlier = 0
    for f in PROJECTS.glob(f"*/{sid}.jsonl") if sid else []:
        s = scan(f)
        earlier = s["human"] - s["pickups"]
        break
    return {"id": sid, "entry": os.environ.get("CLAUDE_CODE_ENTRYPOINT") or "", "earlier": earlier}


def archived(root, prefix):
    """The copy archive_transcript.py keeps past Claude Code's 30-day sweep, if any."""
    hits = sorted((ARCHIVE / root.name).glob(f"*-{prefix[:8]}.jsonl"))
    return str(hits[-1]) if hits else None


# ---- the other machine (D6, D7) -------------------------------------------------------------

def peers_for(b):
    """[(host, alias)] of the other machines to ask about this branch, the one its name (or its
    PR) carries first. A branch's name says where it was made, not where it went on: a
    `claude/laptop/…` branch continued on the build Mac was never looked for there, and pickup
    said "no transcript on the other machine" (2026-09-30). So every peer is asked — but only
    when something points away from here: the name or PR names a peer, a commit names a
    session with no transcript on this machine, or no session here worked on it at all.
    Otherwise the ssh round trip (6 s when a peer sleeps) buys nothing."""
    me = common.host_name()
    hosts = dict(PEERS)
    hosts.update({k[len("PICKUP_PEER_"):].lower(): v for k, v in os.environ.items()
                  if k.startswith("PICKUP_PEER_") and v})
    hosts.pop(me, None)
    named = b.get("host") or b.get("pr_host")  # a name from before 2026-09-22 carries no host
    if not (named in hosts or b["elsewhere"] or not b["sessions"]):
        return []
    return sorted(hosts.items(), key=lambda h: h[0] != named)


def ssh(alias, command, input=None, timeout=30):
    return run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", alias, command],
               timeout=timeout, input=input)


def peer_tool(name):
    """A wharf-runs tool as the peer's own core runs it (its config dir's `home` names that checkout):
    the command shape for an ssh line shown to the owner, run on the peer. Single-quoted whole, so
    the pasting shell hands it to ssh as it is and the peer's shell expands it (review: a double-quoted
    one sent this Mac's checkout path, which the peer does not have)."""
    return f'\'"$(head -1 "${{REGATTA_CONFIG:-$HOME/.config/regatta}}/home")/modules/wharf-runs/bin/{name}"\''


def peer_probe_source():
    """PEER_PROBE with the context reader in front — the core's call test and pickup's step reader:
    the same code measures a transcript there as here, rather than a second copy of the rules that
    could drift."""
    return "\n".join(["import datetime, re", f"USAGE_NUM = re.compile({USAGE_NUM.pattern!r})",
                      inspect.getsource(call), inspect.getsource(call_line), inspect.getsource(context_step), inspect.getsource(context_done),
                      inspect.getsource(branch_replies), PEER_PROBE])


def probe_peers(root, b):
    """Every peer peers_for() names, read: (the best, all). The best holds a transcript of a
    session the commits name, else one with records on the branch, else a session running on
    it, else its worktree; a tie goes to the host the name carries, and one that did not answer
    ranks last. (None, []) when no peer is asked."""
    try:
        rel = Path(root).resolve().relative_to((Path.home() / "projects").resolve())
    except ValueError:
        return None, []
    found = [probe_peer(rel, b, host, alias) for host, alias in peers_for(b)]
    if not found:
        return None, []
    named = {e["id"] for e in b["elsewhere"]}

    def rank(p):
        if p.get("error"):
            return (-1,)
        t = p["transcripts"]
        return (bool(named & set(t)), bool(t), bool(p["alive"]), bool(p["worktree"]))
    return max(found, key=rank), found   # max keeps the first of equals: the named host


def probe_peer(rel, b, host, alias):
    """What one other machine holds for this branch, read over ssh — {"error": …} when that
    machine does not answer. Never writes there: the classifier refuses an agent's remote
    writes, and the handoff never needs one."""
    prefixes = [e["id"] for e in b["elsewhere"]]
    r = ssh(alias, shlex.join(["python3", "-", str(rel), b["name"], ",".join(prefixes)]),
            input=peer_probe_source())
    try:
        peer = json.loads(r.stdout)
    except ValueError:
        return {"host": host, "alias": alias, "error": short(r.stderr or r.stdout or f"exit {r.returncode}", 100)}
    wt = peer.get("worktree")
    ids = set(prefixes) | {((peer.get("lock") or {}).get("session") or "")[:8]} - {""}
    alive = [s for s in peer.get("sessions", [])
             if (wt and s.get("cwd") and (s["cwd"] == wt or s["cwd"].startswith(wt + "/")))
             or any((s.get("sessionId") or "").startswith(p) for p in ids)]
    return {"host": host, "alias": alias, "home": peer.get("home"), "worktree": wt,
            "dirty": peer.get("dirty") or [], "moved": peer.get("moved") if isinstance(peer.get("moved"), dict) else None,
            "alive": alive, "transcripts": peer.get("transcripts") or {},
            "context": peer.get("context") or {}, "replies": peer.get("replies") or {}}


def peer_hit(b):
    """(key, path) of the other machine's transcript `carry` would copy: a session its commits
    name first, else the newest with records on the branch. None when there is none."""
    found = (b.get("peer") or {}).get("transcripts") or {}
    return next(((e["id"], found[e["id"]]) for e in b["elsewhere"] if e["id"] in found), None) \
        or (("branch", found["branch"]) if "branch" in found else None)


def peer_warnings(b):
    """The ⚠ lines about the other machine, for show and open. Never a block."""
    p = b.get("peer")
    if not p or p.get("error"):
        return []
    lines = []
    for s in p["alive"]:
        sid = (s.get("sessionId") or "?")[:8]
        idle = ago((s.get("statusUpdatedAt") or 0) / 1000)
        end = (f"ssh {p['alias']} {peer_tool('rc-hosts')} --end {sid}"
               if s.get("entrypoint") == "sdk-cli" else f"close it on {p['host']}")
        lines.append(f"⚠ ALIVE on {p['host']}: session {sid} \"{s.get('name') or '?'}\" (pid {s.get('pid')},"
                     f" {s.get('status') or '?'} since {idle}) — two machines on one branch diverge; end it"
                     f" first: {end}")
    if p["dirty"]:
        files = ", ".join(p["dirty"][:4]) + (f" +{len(p['dirty']) - 4}" if len(p["dirty"]) > 4 else "")
        lines.append(f"⚠ {len(p['dirty'])} uncommitted file(s) in {p['host']}'s worktree, not on origin: {files}"
                     f" — sync.py there commits and pushes them at a session start once nobody is in it")
    return lines


def carry_transcript(b, root, wt, notes, dry):
    """D7: the other machine's transcript of this branch's session, copied here as a fork.
    Returns (new session id, title)."""
    p = b.get("peer") or {}
    hit = peer_hit(b)
    if not hit:
        raise Stop(f"no transcript of {b['name']}'s session found on {p.get('host') or 'the other machine'}"
                   + (f" ({p['error']})" if p.get("error") else "") + " — use --here")
    prefix, src = hit
    if dry:
        notes.append(f"would copy {p['host']}:{src} here as a fork")
        return prefix, None
    r = ssh(p["alias"], shlex.join(["cat", src]), timeout=180)
    if r.returncode or not r.stdout.strip():
        raise Stop(f"could not read {p['host']}:{src}: {short(r.stderr, 120)}")
    # fork_transcript takes the file name for the old id; an archived copy is named
    # `<date>-<id8>.jsonl`, so name it after the id its own records carry.
    old = next((m.group(1) for m in re.finditer(r'"sessionId":"([0-9a-f-]{36})"', r.stdout[:200000])), None)
    with tempfile.TemporaryDirectory() as tmp:
        copy = Path(tmp) / f"{old or Path(src).stem}.jsonl"
        copy.write_text(r.stdout, encoding="utf-8")
        new_id = str(uuid.uuid4())
        dest, title, n = fork_transcript(copy, PROJECTS / slug(root), new_id, origin=p.get("host"))
    # Their paths → ours: the worktree first (its folder may be named differently here), then
    # the projects folder. Whole path components only, so `…/tools` never rewrites `…/tools-2`.
    pairs = [(p["worktree"], str(wt))] if p.get("worktree") else []
    if p.get("home"):
        pairs.append((p["home"] + "/projects", str(Path.home() / "projects")))
    text = rewrite(dest.read_text(encoding="utf-8"), pairs)
    text += json.dumps({"type": "relocated", "sessionId": new_id, "relocatedCwd": str(root)},
                       ensure_ascii=False, separators=(",", ":")) + "\n"
    dest.write_text(text, encoding="utf-8")
    if scan(dest)["relocated"] != str(root):
        raise Stop(f"the copied transcript {dest} does not end relocated to {root}")
    notes.append(f"✓ {p['host']}'s session {Path(src).stem[:8]} copied here as {new_id[:8]} ({n} records),"
                 f" paths rewritten to this machine's; the original there is untouched")
    return new_id, title


# ---- GitHub -------------------------------------------------------------------------------

def pull_requests(root):
    """({head branch: PR}, note). An open PR beats a closed one for the same branch; then the
    most recently updated. PICKUP_PRS names a JSON fixture instead of the API (tests)."""
    fixture = os.environ.get("PICKUP_PRS")
    repo = common.repo_slug(out(root, "remote", "get-url", "origin"))
    if fixture:
        prs = json.loads(Path(fixture).read_text())
    else:
        if not repo:
            return {}, None
        tok = common.token()
        if not tok:
            return {}, "no GitHub token — PR state unknown"
        prs = []
        for state, n in (("open", 100), ("closed", 50)):
            st, page = common.api("GET", f"/repos/{repo}/pulls?state={state}&per_page={n}"
                                         f"&sort=updated&direction=desc", tok=tok)
            if st != 200:
                return {}, f"GitHub answered {st or 'nothing'} — PR state unknown"
            prs += page or []
    by = {}
    for p in prs:
        ref = (p.get("head") or {}).get("ref")
        if not ref:
            continue
        rec = {"repo": repo, "number": p["number"],
               "state": "merged" if p.get("merged_at") else p.get("state"),
               "draft": bool(p.get("draft")), "title": p.get("title") or "",
               "url": p.get("html_url") or "", "updated": p.get("updated_at") or "",
               "body": p.get("body") or ""}
        old = by.get(ref)
        if old is None or ((rec["state"] == "open") > (old["state"] == "open")) or (
                (rec["state"] == "open") == (old["state"] == "open") and rec["updated"] > old["updated"]):
            by[ref] = rec
    return by, None


# ---- branches -----------------------------------------------------------------------------

def launched_verdicts(root, main, prs):
    """{branch: (verdict, proof, carried)} from hooks/branches.py — the one home for "did this
    launch": `launched` only on proof that cannot be wrong (tips on origin/main, or every changed
    path's ls-tree entry identical there), `probably` for a patch-id or reverse-apply hint, and
    carry records as pointers. It looks only at branches idle over a day and not locked, so a
    young branch is never judged. Any failure here leaves every branch a candidate."""
    try:
        import branches
        done, maybe, pending = branches.survey(
            root, main=main, prs={n: (p["number"], p["state"]) for n, p in prs.items()},
            deadline=time.monotonic() + SURVEY_SECONDS)
    except Exception as e:  # noqa: BLE001 — a broken survey must not cost the pickup
        return {}, f"launched check skipped ({short(str(e), 80)})"
    verdicts = {}
    for verdict, group in (("launched", done), ("probably launched", maybe), (None, pending)):
        for b in group:
            carried = [f"{c} ({how})" for c, how in getattr(b, "carried", [])]
            if verdict or carried:
                verdicts[b.name] = (verdict, getattr(b, "proof", None), carried)
    return verdicts, None


def worktrees(root):
    """{branch: {"path", "missing"}} from `git worktree list --porcelain`."""
    found, cur = {}, {}
    for line in out(root, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if cur.get("branch") and cur.get("worktree"):
                p = Path(cur["worktree"])
                found[cur["branch"]] = {"path": p, "missing": not p.is_dir()}
            cur = {}
            continue
        key, _, val = line.partition(" ")
        if key == "worktree":
            cur["worktree"] = val
        elif key == "branch":
            cur["branch"] = val[len("refs/heads/"):] if val.startswith("refs/heads/") else val
    return found


def prompts_from_body(body):
    """The prompts checkpoint.py quotes into a commit body (`> ` lines; a bare `>` is a blank
    line inside one prompt, an empty line separates two)."""
    m = PROMPT_HEAD.search(body or "")
    if not m:
        return []
    blocks, cur = [], []
    for line in body[m.end():].lstrip("\n").splitlines():
        if line.startswith(">"):
            cur.append(line[2:] if line.startswith("> ") else line[1:])
        elif not line.strip():
            if cur:
                blocks.append("\n".join(cur).strip())
                cur = []
        else:
            break  # the trailers
    if cur:
        blocks.append("\n".join(cur).strip())
    return [p for p in (clean_prompt(b) for b in blocks) if p]


def read_lock(path):
    """common.read_owner, plus where it lives (for open's take-over)."""
    lock = common.read_owner(path.parent)
    return {**lock, "path": str(path)} if lock else None


def placement(path, root):
    """root: in the repo's own slug; parked: in one of its worktrees' slugs (unparkable);
    other: another project's — a session of a sibling repo that committed here with
    `cd <repo> && git …`. Only `parked` may ever be moved, and only into root's slug."""
    d, base = Path(path).parent.name, slug(root)
    return "root" if d == base else "parked" if d.startswith(base + "--claude-worktrees-") else "other"


def reply_status(s, live_entry):
    """(status, rule) of one session from code alone — bin/session_status.py decide(), the rules
    the sessions bench scores (docs/record/jev-sessions-bench-2026-10-02.md D2, D5, D6). A guarded
    session's reply is never parsed; no model is asked, here or anywhere in pickup."""
    guarded = rules.is_guarded(Path(s["path"]).parent.name, s["cwd0"], s["cwd_last"])
    live_status = (live_entry or {}).get("status")
    if live_entry and live_status not in ("busy", "waiting") and busy_files(s["id"]):
        live_status = "task"  # idle in the registry, a background task or subagent still writing
    # a prompt typed after the last reply and never answered: that reply says nothing about it,
    # so no text rule may read the session as done — unsure, unless a live signal says more
    unanswered = bool(s["prompt_at"]) and s["prompt_at"] > s["reply_at"]
    text, api_error = "", False
    if s["reply"] and not guarded and not unanswered:
        try:
            r = json.loads(s["reply"])
        except ValueError:
            r = {}
        content = (r.get("message") or {}).get("content")
        if isinstance(content, list):
            text = "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text").strip()
        api_error = bool(r.get("isApiErrorMessage"))
    return rules.decide(text, 0 if unanswered else len(s["pending"]), api_error, live_status, guarded)


def session_view(s, branch, when, live, root):
    wt = s["wt"] or {}
    # the status reads the session's last reply, which belongs to the branch it was written on; on
    # any other branch it would describe other work, so none is shown there
    status, rule = (reply_status(s, live.get(s["id"])) if (s["reply_branch"] or s["last_branch"]) == branch
                    else (None, None))
    asked = s["asked"].get(branch)
    place = placement(s["path"], root)
    return {"id": s["id"], "title": s["custom"] or s["title"] or "(untitled)", "named": bool(s["custom"]),
            "when": when, "live": live.get(s["id"]), "path": str(s["path"]),
            "place": place, "parked": place == "parked",
            # the directory whose slug holds the transcript — where `claude --resume` finds it
            "cwd": str(root) if place == "root" else (s["relocated"] or wt.get("path") or s["cwd0"]),
            "entrypoint": s["entrypoint"], "wt": s["wt"], "cwd0": s["cwd0"],
            # where `claude --resume` will put it: its last worktree, if it never exited one
            "on_branch": wt.get("branch") == branch,
            "moved_on": wt.get("branch") if wt.get("branch") and wt.get("branch") != branch else None,
            "asked": asked[1] if asked else None, "asked_at": epoch(asked[0]) if asked else 0,
            "status": status, "status_rule": rule,
            **{k: s[k] for k in CONTEXT_KEYS}}


def branch_info(root, main, name, loc, rem, wt, pr, transcripts, live, me, verdict=None):
    host, date, topic = parse_name(name)
    tip = name if loc else f"origin/{name}"
    b = {"name": name, "host": host, "date": date, "topic": topic, "local": bool(loc),
         "remote": bool(rem), "tip": tip, "track": (loc or {}).get("track", ""),
         "time": max((loc or {}).get("time", 0), (rem or {}).get("time", 0)), "pr": pr,
         "worktree": str(wt["path"]) if wt else None, "wt_missing": bool(wt and wt["missing"]),
         "dirty": 0, "lock": None, "moved": None, "finishing": False, "mine": False}
    b["ahead"] = int(out(root, "rev-list", "--count", f"{main}..{tip}") or 0)
    b["behind_main"] = int(out(root, "rev-list", "--count", f"{tip}..{main}") or 0)
    b["unpushed"] = b["incoming"] = 0
    if loc and rem:
        lr = out(root, "rev-list", "--left-right", "--count", f"{name}...origin/{name}").split()
        if len(lr) == 2:
            b["unpushed"], b["incoming"] = int(lr[0]), int(lr[1])
    commits = []
    log = out(root, "log", "--format=%h%x1f%ct%x1f%s%x1f%(trailers:key=Claude-Session,valueonly,"
                           "separator=%x2C)%x1f%b%x1e", f"{main}..{tip}")
    for rec in log.split("\x1e"):
        parts = rec.strip("\n").split("\x1f")
        if len(parts) < 5:
            continue
        by = SEEDED_BY.search(parts[4])
        commits.append({"sha": parts[0], "time": int(parts[1] or 0), "subject": parts[2],
                        "sessions": [t.strip() for t in parts[3].split(",") if t.strip()],
                        "prompts": prompts_from_body(parts[4]), "seeded_by": by.group(1) if by else None,
                        "body": parts[4]})
    b["commits"] = commits
    # A seed (`pickup seed`): every commit is a `Seed:` one — the first checkpoint of the
    # session that picks it up makes it an ordinary branch.
    b["seed"] = None
    # branches.seed_task()'s test, on pickup's own commit list: every path under docs/handoff/ too,
    # so a "seed" the reaper would not call one is never listed as a seed here (review, 2026-10-04)
    # (the diff only for a branch whose commits are all Seed: ones — one git call per branch otherwise)
    seed_paths = out(root, "diff", "--name-only", f"{main}...{tip}").splitlines() if commits and all(
        c["subject"].startswith(SEED_SUBJECT) and c["seeded_by"] for c in commits) else []
    # a routed doc whose diff is its `Routed:` line alone counts too (branches.seed_paths_ok)
    if seed_paths and seed_paths_ok(root, out(root, "merge-base", main, tip), tip, seed_paths,
                                    [c["body"] for c in commits]):
        files = out(root, "diff-tree", "--no-commit-id", "--name-only", "-r", commits[-1]["sha"]).splitlines()
        b["seed"] = {"brief": next((f for f in files if f.startswith(HANDOFF_DIR + "/") and f.endswith(".md")), None),
                     "by": commits[-1]["seeded_by"]}
    if wt and not wt["missing"]:
        b["dirty"] = len([l for l in out(wt["path"], "status", "--porcelain").splitlines() if l.strip()])
        state = Path(out(wt["path"], "rev-parse", "--absolute-git-dir")) / "claude"
        b["lock"] = read_lock(state / "owner.json")
        b["finishing"] = (state / "finishing").exists()
        b["moved"] = common.moved(state)  # /move's marker: the branch goes on elsewhere

    trailers = []  # session prefixes, newest commit first
    for c in commits:
        trailers += [p for p in c["sessions"] if p not in trailers]
    hint = HOOK_PR.search(pr["body"]) if pr else None
    if hint and hint.group("sid") not in trailers:
        trailers.append(hint.group("sid"))
    b["pr_host"] = hint.group("host").strip().lower() if hint else None
    lock_sid = (b["lock"] or {}).get("session")
    # A trailer naming a session this repo's folders don't hold: look in every project's
    # (by file name only — cheap), for the sibling-repo case.
    ids = {s["id"] for s in transcripts}
    extra = [scan(f) for p in trailers if not any(i.startswith(p) for i in ids)
             for f in PROJECTS.glob(f"*/{p}*.jsonl")]
    linked = []
    for s in transcripts + extra:
        why = [w for w, hit in (
            ("records", name in s["on"]),
            ("worktree", (s["wt"] or {}).get("branch") == name),
            ("commits", any(s["id"].startswith(p) for p in trailers)),
            ("pr", bool(pr) and (pr["repo"], pr["number"]) in s["prs"]),
            ("lock", lock_sid == s["id"])) if hit]
        if not why:
            continue
        if s["id"] == me:
            b["mine"] = True  # this very session worked on it: nothing to hand over
            continue
        v = session_view(s, name, epoch(s["on"].get(name, "")) or s["mtime"], live, root)
        v["why"] = why
        linked.append(v)
    # A session with records on the branch did the work; one linked only by a trailer, a PR
    # link or the lock ranks after it, whatever its file's mtime says.
    linked.sort(key=lambda v: ("records" in v["why"], v["when"]), reverse=True)
    b["sessions"] = linked
    here = ids | {s["id"] for s in extra}
    b["elsewhere"] = [{"id": p, "archived": archived(root, p)}
                      for p in trailers if not any(i.startswith(p) for i in here)]

    last_prompt = next((c["prompts"][-1] for c in commits if c["prompts"]), None)
    b["asked"] = next((v["asked"] for v in linked if v["asked"]), None) or last_prompt
    b["active"] = max([b["time"]] + [v["when"] for v in linked])
    kind, proof, carried = verdict or (None, None, [])
    b["proof"], b["carried"] = proof, carried
    # A merged PR proves the commits, not the worktree: uncommitted work there is not on main
    # (shop/site, 2026-09-25 — "landed: merged" hid the one file that was the remaining work).
    if pr and pr["state"] == "merged" and not b["dirty"]:
        b["status"], b["proof"] = "launched", f"PR #{pr['number']} merged"
    elif kind == "launched":
        b["status"] = "launched"
    elif kind == "probably launched":
        b["status"] = "probably launched"
    elif pr and pr["state"] == "closed":
        b["status"] = "closed"
    elif b["track"] == "[gone]" and not rem:
        b["status"] = "gone"  # upstream deleted on GitHub, which is what a merge does
    elif not (b["ahead"] or b["dirty"]) and not (wt and linked):
        # Every commit is already in main (fast-forwarded, or none made). Only a worktree with
        # a session in it — started, nothing committed yet — is still work in progress.
        b["status"] = "in main"
    else:
        b["status"] = "open"
    return b


def collect(root, fetch=True):
    notes = []
    has_origin = git(root, "remote", "get-url", "origin").returncode == 0
    if fetch and has_origin:
        r = git(root, "fetch", "-q", "--prune", "origin", timeout=45)
        if r.returncode:
            notes.append(f"fetch failed ({short(r.stderr, 80)}) — origin may be stale")
    main = main_branch(root)
    wts = worktrees(root)
    local, remote = {}, {}
    for line in out(root, "for-each-ref", "--format=%(refname:short)%09%(upstream:track)%09"
                                          "%(committerdate:unix)", "refs/heads/claude/").splitlines():
        name, track, ts = (line.split("\t") + ["", ""])[:3]
        local[name] = {"track": track, "time": int(ts or 0)}
    for line in out(root, "for-each-ref", "--format=%(refname:short)%09%(committerdate:unix)",
                    "refs/remotes/origin/claude/").splitlines():
        ref, ts = (line.split("\t") + [""])[:2]
        remote[ref[len("origin/"):]] = {"time": int(ts or 0)}
    prs, note = pull_requests(root) if has_origin else ({}, None)
    if note:
        notes.append(note)
    transcripts = []
    for d in slug_dirs(root, [w["path"] for w in wts.values()]):
        for f in d.glob("*.jsonl"):
            try:
                transcripts.append(scan(f))
            except OSError:
                continue
    live = live_sessions()
    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    verdicts, note = launched_verdicts(root, main, prs)
    if note:
        notes.append(note)
    branches = [branch_info(root, main, n, local.get(n), remote.get(n), wts.get(n), prs.get(n),
                            transcripts, live, me, verdicts.get(n))
                for n in sorted(set(local) | set(remote)) if not n.endswith("-raw")]
    branches.sort(key=lambda b: b["active"], reverse=True)
    return {"root": root, "main": main, "branches": branches, "notes": notes,
            "host": common.host_name()}


# ---- choosing -----------------------------------------------------------------------------

def resolve(ref, branches):
    """The one branch REF names. Stop(code 2) lists the candidates when it names several."""
    r = ref.strip()
    r = r[len("origin/"):] if r.startswith("origin/") else r
    for b in branches:
        if b["name"] == r:
            return b
    m = re.fullmatch(r"(?:#|pr)?(\d+)", r, re.I)
    if m:
        hits = [b for b in branches if b["pr"] and b["pr"]["number"] == int(m.group(1))]
        if hits:
            return hits[0]
    if re.fullmatch(r"[0-9a-f]{6,}(?:-[0-9a-f-]*)?", r):
        hits = [b for b in branches if any(s["id"].startswith(r) for s in b["sessions"])
                or any(e["id"].startswith(r[:8]) for e in b["elsewhere"])]
        if len(hits) == 1:
            return hits[0]
    hits = [b for b in branches if r.lower() in b["name"].lower()]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        raise Stop(f"no claude/* branch matches {ref!r}")
    raise Stop(f"{ref!r} matches {len(hits)} branches:\n" + "\n".join(f"  {b['name']}" for b in hits), 2)


def plan(b, me, root):
    """The handoff `open` makes when not told otherwise, with the one-line reason."""
    if b["status"] in LAUNCHED:
        return "none", f"already on main ({b['proof']}) — nothing to pick up"
    if b["mine"]:
        return "here", "this session already worked on it"
    # Another repo (--repo, list --all): a vscode:// link opens in THIS window, whose session
    # list is this repo's, and VS Code answers an id it cannot find with a fresh session.
    foreign = me.get("repo") != root
    s = b["sessions"][0] if b["sessions"] else None
    if s is None:
        scoped = foreign and scoped_here(me, root)
        if foreign and not scoped:
            return "elsewhere", f"it is {root.name}'s: open that repo's window and run /pickup {b['name']} there"
        if scoped and (b.get("peer") or {}).get("transcripts"):
            # a fork files under root's own slug, which this window (the anchor's) never lists
            # (review 2026-10-15): carrying stays where it was before scopes
            return "elsewhere", (f"its session is on {b['peer']['host']}: carry it from a {root.name}-first window"
                                 f" — /pickup {b['name']} there")
        if (b.get("peer") or {}).get("transcripts") and me["entry"] in ("claude-vscode", "cli"):
            return "carry", (f"its session is on {b['peer']['host']}: the conversation comes over as a fork,"
                             f" in {'a VS Code tab' if me['entry'] == 'claude-vscode' else 'a new Terminal window'}")
        if me["earlier"] and me["entry"] == "claude-vscode":
            return "new-tab", "no session for it on this machine, and this one already has other work"
        where = f"on {b['host']}" if b["host"] and b["host"] != common.host_name() else "on this machine"
        return "here", f"no transcript for it {where}: this session adopts it"
    if s["live"] and not s.get("handed_over"):
        return "live", "its session is running now"
    # This window lists its own repo's sessions (and, once unparked, its worktrees'); a
    # sibling repo's session that committed here lives in that repo's list.
    window = slug(me["repo"]) if me.get("repo") else None
    listed = (not foreign and s["place"] in ("root", "parked")) or Path(s["path"]).parent.name == window
    # filed under root's scope's anchor (started in that window, then moved into root's worktree):
    # the scope's window lists it, found or opened from its file (bin/scopes)
    home = unpark_home(s, root) if s["parked"] else transcript_home(s, root, me)
    listed = listed or (home is not None and not same_dir(home, root) and home != me.get("repo"))
    if me["entry"] == "claude-vscode" and listed:
        if s["parked"] and not unpark_possible(s, unpark_home(s, root)):
            return "terminal", "its transcript is parked and cannot be moved back"
        return "vscode", "reopen it in a VS Code tab" + (" (unparked first)" if s["parked"] else "")
    if me["entry"] in ("cli", "claude-vscode"):
        return "terminal", "reopen it in a new Terminal window" + (
            "" if listed else f" (its session belongs to another repo's window)")
    return "here", "not in VS Code or a terminal (the phone?): this session adopts it"


def unpark_possible(s, root):
    dest_dir = PROJECTS / slug(root)
    return dest_dir.is_dir() and not (dest_dir / Path(s["path"]).name).exists()


# ---- reopen or fresh (docs/record/pickup-cold-handoff-2026-09-29.md) --------------------------------

CHOICE_KINDS = ("vscode", "terminal", "carry")  # the handoffs that bring a whole conversation back


def kilo(n):
    return f"{n // 1000}k"  # down, never up: 99,600 must not read "100k" beside a missing choice


def span(s):
    if s is None:
        return "?"
    s = int(s)
    return f"{s} s" if s < 90 else f"{s // 60} min" if s < 3600 else f"{s // 3600} h" if s < 36 * 3600 \
        else f"{s // 86400} d"


def fresh_base(root):
    """What a fresh session's first call costs in this repo: the median first call of the five
    newest transcripts with a human prompt (always-loaded files differ by repo — the shop's
    CLAUDE.md alone is 85 KB), else FRESH_BASE."""
    files = [f for d in slug_dirs(root, []) for f in d.glob("*.jsonl")]
    firsts = []
    def mtime(f):  # a transcript moved by EnterWorktree between the glob and here
        try:
            return f.stat().st_mtime
        except OSError:
            return 0
    for f in sorted(files, key=mtime, reverse=True):
        try:
            s = scan(f)
        except OSError:
            continue
        if s["human"] and s["first_ctx"]:
            firsts.append(s["first_ctx"])
            if len(firsts) == 5:
                break
    return sorted(firsts)[len(firsts) // 2] if firsts else FRESH_BASE


def context_source(b, kind, s=None):
    """The measured context of the conversation this handoff would bring back: the other
    machine's transcript for `carry`, else the session (the first linked one by default)."""
    if kind == "carry":
        hit = peer_hit(b)
        return ((b.get("peer") or {}).get("context") or {}).get(hit[0]) if hit else None
    return s or (b["sessions"][0] if b["sessions"] else None)


def advice(c, base, now=None, kind=None):
    """E2: reopen or fresh, with the reason in the words it was explained in. None when the
    size is unknown (a transcript with no usage: an old one, a fixture, a format change) —
    `open` then behaves as before, never blocking on an unknown."""
    if not c or not c.get("ctx"):
        return None
    now = time.time() if now is None else now
    tokens, ttl_s = c["ctx"], 300 if c.get("ttl") == "5m" else 3600
    # The cache lives from the START of the request that last read or wrote it; a wrong "warm"
    # costs a full write, a wrong "cold" nothing, so the last two minutes count as cold — and
    # so does an unreadable time, and a `carry`: the fork opens on this machine with its
    # paths rewritten, a different prefix than the one the build Mac cached (review 2026-09-29).
    known = c.get("ctx_end", 0) > 0
    warm = known and kind != "carry" and now < c["ctx_at"] + ttl_s - WARM_MARGIN
    idle = max(0, now - c["ctx_end"]) if known else None
    # D2 (b), 2026-09-29: fresh whenever large, warm or cold. Warmth saves one write (2 × the
    # context, once), about half a turn's reads; the size is paid on every call.
    recommend = "fresh" if tokens >= FRESH_TOKENS else "reopen"
    k = kilo(tokens)
    cost = (f"reopening reads {k} per call" if warm else  # the multiplier follows the TTL the transcript names
            f"reopening re-writes ~{k} at {'2×' if ttl_s == 3600 else '1.25×'}, then reads {k} per call")
    if kind == "carry":
        cost = f"carrying it over forks it here, which re-writes ~{k} at {'2×' if ttl_s == 3600 else '1.25×'}, then reads {k} per call"
    reason = (f"{k} tokens, idle {span(idle)} ({'1 h' if ttl_s == 3600 else '5 min'} cache, "
              f"{'warm' if warm else 'cold'}): {cost} — ~{CALLS_PER_TURN} calls a turn; fresh starts at ~{kilo(base)} here")
    return {"tokens": tokens, "idle_s": None if idle is None else int(idle), "ttl_s": ttl_s, "warm": warm, "base": base,
            "last": c.get("ctx_end") or 0, "recommend": recommend, "reason": reason}


def context_lines(adv, kind, host=None):
    """E3: the `context` line; for a large session a handoff would bring back, the two
    `choice` lines, the recommended one first. show and open print the same lines."""
    last = f"{datetime.datetime.fromtimestamp(adv['last']):%Y-%m-%d %H:%M}" if adv["last"] else "?"
    lines = [f"  context   {kilo(adv['tokens'])} tokens · last call {last} (idle {span(adv['idle_s'])}) · "
             f"{'1 h' if adv['ttl_s'] == 3600 else '5 min'} cache: {'warm' if adv['warm'] else 'cold'}"
             f" · fresh here ≈ {kilo(adv['base'])}"]
    if adv["tokens"] >= FRESH_TOKENS and kind in CHOICE_KINDS:
        text = {"fresh": adv["reason"],
                "reopen": "the whole conversation" + (f", carried from {host}" if kind == "carry" else "")
                          + f", at {kilo(adv['tokens'])} per call"}
        for opt in sorted(text, key=lambda o: o != adv["recommend"]):
            lines.append(f"  choice    {opt}{' (recommended)' if opt == adv['recommend'] else ''} — {text[opt]}")
    return lines


def stat_lines(root, main, tip, keep):
    """`git diff --stat` for main...tip, cut to `keep` files plus the summary line."""
    stat = git(root, "diff", "--stat=100", f"{main}...{tip}").stdout.rstrip().splitlines()
    return stat if len(stat) <= keep + 1 else stat[:keep] + [" …"] + stat[-1:]


# ---- printing -------------------------------------------------------------------------------

def where_line(b, root):
    if b["worktree"] and not b["wt_missing"]:
        state = f"{b['dirty']} uncommitted" if b["dirty"] else "clean"
        return f"worktree {rel(b['worktree'], root)} ({state})"
    if b["local"]:
        return "local branch, no worktree" + (" (its folder is gone)" if b["wt_missing"] else "")
    return "only on origin"


def moved_text(m):
    """`⇢ moved to buildbox (session 65046969, 2 h ago)` / `⇢ waiting for laptop (prepared …)`."""
    try:
        when = ago(float(m.get("at") or 0))
    except (TypeError, ValueError):
        when = "?"
    return "⇢ " + common.moved_line(m, when)


def session_line(v):
    # "live now", not "RUNNING": `running` is the status word for a busy session (D5), and an
    # idle live one ends in its reply's status like any other
    state = f"live now ({(v['live'] or {}).get('status', '?')})" if v["live"] else f"closed, last here {ago(v['when'])}"
    extra = " · parked in its worktree" if v["parked"] and not v["live"] else ""
    extra += f" · moved on to {v['moved_on']}" if v["moved_on"] else ""
    return f"session {v['id'][:8]} \"{short(v['title'], 60)}\" · {state}{extra}" + (f" → {rules.label(v['status'], v['status_rule'])}" if v["status"] else "")


def print_list(data, me, show_all=False):
    root = data["root"]
    open_ = [b for b in data["branches"] if b["status"] == "open"]
    rest = [b for b in data["branches"] if b["status"] != "open"]
    print(f"{root.name} — {len(open_)} open, most recently active first (this machine: {data['host']})")
    for n in data["notes"]:
        print(f"  ⚠ {n}")
    for i, b in enumerate(open_, 1):
        pr = b["pr"]
        head = f"#{pr['number']}{' draft' if pr['draft'] else ''} \"{short(pr['title'], 50)}\"" if pr else "no PR"
        origin = f" · from {b['host']}" if b["host"] and b["host"] != data["host"] else ""
        print(f"{i:>2}. {b['topic']} · {b['name']}{origin}")
        print(f"    {head} · {b['ahead']} commit(s) ahead of main · last commit {ago(b['time'])} · {where_line(b, root)}")
        if b["moved"]:
            print(f"    {moved_text(b['moved'])}")
        for v in b["sessions"][:2]:
            print(f"    {session_line(v)}")
        if not b["sessions"] and b["seed"]:
            print(f"    seed — {seed_state(b)}; brief {b['seed']['brief'] or '?'}")
        elif not b["sessions"]:
            others = ", ".join(e["id"] for e in b["elsewhere"]) or "none recorded"
            print(f"    no session on this machine (commits name: {others})")
        if b["carried"]:
            print(f"    ⚠ carried by {', '.join(b['carried'])}, not proved — the work may go on there")
        if b["asked"]:
            print(f"    last asked: \"{short(b['asked'], 140)}\"")
    if not open_:
        print("   nothing open")
    if rest:
        print("  not open: " + " · ".join(f"{b['topic']} ({status_text(b)})" for b in rest[:12])
              + (f" · +{len(rest) - 12} more" if len(rest) > 12 else ""))
    print(f"  this session: {me['entry'] or '?'}, {me['earlier']} earlier prompt(s)")


def seed_started(b):
    """A seed with an open WIP: PR ran somewhere — a headless dispatch on the build Mac opens one at
    its first push — even with no session here and nothing committed (three on 2026-10-04,
    docs/record/branch-reaping-2026-10-04.md section 2)."""
    pr = b["pr"]
    return bool(b["seed"] and pr and pr["state"] == "open" and (pr.get("title") or "").startswith("WIP:"))


def seed_state(b):
    if not seed_started(b):
        return "not started"
    return f"started on {b['pr_host'] or 'another machine'} (PR #{b['pr']['number']}), nothing committed"


def status_text(b):
    if b["status"] in LAUNCHED + PROBABLY and b["proof"]:
        return f"{b['status']}: {b['proof']}"
    if b["status"] == "closed":
        return f"PR #{b['pr']['number']} closed unmerged"
    return b["status"]


def print_show(b, data, me):
    root = data["root"]
    kind, why = plan(b, me, root)
    pr = b["pr"]
    print(b["name"])
    print(f"  status    {status_text(b)}" + (f" · from {b['host']}" if b["host"] else "")
          + (" (this machine)" if b["host"] == data["host"] else ""))
    if b["carried"]:
        print(f"  carried   by {', '.join(b['carried'])} — a pointer, not proof: the work may go on there")
    print(f"  where     {where_line(b, root)}" + (" · a /finish was in progress" if b["finishing"] else ""))
    if b["moved"]:
        print(f"  moved     {moved_text(b['moved'])}")
    if pr:
        print(f"  PR        #{pr['number']} {pr['state']}{' draft' if pr['draft'] else ''} \"{pr['title']}\" {pr['url']}")
    print(f"  commits   {b['ahead']} ahead of main, last {ago(b['time'])}"
          + (f"; main has {b['behind_main']} newer" if b["behind_main"] else ""))
    if b["local"] and b["remote"]:
        print(f"  origin    {sync_text(b)}")
    lock = b["lock"]
    if lock:
        print(f"  lock      {lock_text(lock, b)}")
    for p in b.get("peers") or []:
        if p.get("error"):
            print(f"  {p['host']:<9} not read ({p['alias']}: {p['error']})")
            continue
        print(f"  {p['host']:<9} " + (f"worktree {p['worktree']}, {len(p['dirty'])} uncommitted" if p["worktree"]
                                    else "no worktree for it") + f", {len(p['alive'])} session(s) running on it,"
              f" transcript {'found' if p['transcripts'] else 'not found'}")
        if p.get("moved"):
            print(f"            {moved_text(p['moved'])} — the marker on {p['host']}")
        if p is b["peer"]:
            for w in peer_warnings(b):
                print(f"            {w}")
    print("  sessions  (most recent on this branch first)")
    if b["seed"] and not b["sessions"]:
        print(f"    seed — {seed_state(b)}; brief {b['seed']['brief'] or '?'}, seeded by {b['seed']['by'] or '?'}")
    for v in b["sessions"]:
        print(f"    {session_line(v)}")
        print(f"       {v['id']} · linked by {', '.join(v['why'])}" + (f" · last asked: \"{short(v['asked'], 100)}\"" if v["asked"] else ""))
    for e in b["elsewhere"]:
        print(f"    session {e['id']} — no transcript on this machine"
              + (f" (archived copy: {e['archived']})" if e["archived"] else ""))
    adv = advice(context_source(b, kind), fresh_base(root), kind=kind)
    if adv:
        print("\n".join(context_lines(adv, kind, (b.get("peer") or {}).get("host"))))
    prompts = [p for c in reversed(b["commits"]) for p in c["prompts"]]
    if prompts:
        print("  prompts on the branch (oldest first)")
        for p in prompts[-12:]:
            print(f"    - {short(p, 150)}")
    stat = stat_lines(root, data["main"], b["tip"], 14)
    if stat:
        print("  files")
        for line in stat:
            print(f"   {line}")
    print(f"  handoff   {kind} — {why}")


def sync_text(b):
    if b["unpushed"] and b["incoming"]:
        return f"DIVERGED: {b['unpushed']} local, {b['incoming']} on origin — reconcile by hand, never force"
    if b["incoming"]:
        return f"{b['incoming']} newer on origin (pushed from the other machine?)"
    if b["unpushed"]:
        return f"{b['unpushed']} local commit(s) not pushed yet"
    return "in sync"


def lock_text(lock, b):
    sid = lock.get("session") or "?"
    idle = time.time() - lock.get("seen", 0)
    alive = any(v["id"] == sid and v["live"] for v in b["sessions"])
    if idle >= OWNER_TTL:
        return f"expired ({sid[:8]}, idle {ago(lock.get('seen'))}) — the next writer takes it"
    if lock.get("handover"):
        return f"handed over by {sid[:8]} {ago(lock['handover'])} (pickup next) — the next writer takes it"
    return f"held by {sid[:8]}, {'running' if alive else 'NOT running (stale)'}, last write {ago(lock.get('seen'))}"


# ---- open -----------------------------------------------------------------------------------

def ensure_worktree(root, b, s, notes, dry):
    """The branch's worktree: the one it has; else where its session last had it (Claude Code
    goes back there by itself on a reopen); else .claude/worktrees/<topic>. Returns the path."""
    if b["worktree"] and not b["wt_missing"]:
        return Path(b["worktree"])
    want = None
    for p in ((s or {}).get("wt") or {}).get("path"), b["worktree"]:
        if p and not Path(p).exists() and Path(p).parent == root / ".claude" / "worktrees":
            want = Path(p)
            break
    if want is None:
        want = base = root / ".claude" / "worktrees" / b["topic"]
        n = 2
        while want.exists():
            want, n = Path(f"{base}-{n}"), n + 1
    source = b["name"] if b["local"] else f"origin/{b['name']}"
    if dry:
        notes.append(f"would create worktree {rel(want, root)} from {source}")
        return want
    if b["wt_missing"]:
        git(root, "worktree", "prune")  # forget the vanished folder, or `add` refuses the branch
    args = [str(want), b["name"]] if b["local"] else ["--track", "-b", b["name"], str(want), source]
    r = git(root, "worktree", "add", "-q", *args, timeout=120)
    if r.returncode or out(want, "symbolic-ref", "--short", "HEAD") != b["name"]:
        raise Stop(f"git worktree add failed: {short(r.stderr or r.stdout, 200)}")
    notes.append(f"✓ worktree {rel(want, root)} created from {source}"
                 + (" (tracks it)" if not b["local"] else ""))
    env = root / ".env"
    if os.path.lexists(env) and not os.path.lexists(want / ".env"):
        os.symlink(env, want / ".env")
        notes.append("✓ .env linked")
    b["worktree"], b["wt_missing"], b["local"] = str(want), False, True
    return want


def catch_up(b, wt, keep_sid, notes, dry):
    """Fast-forward to origin when only origin moved; say so otherwise. Never merge, never force."""
    if not (b["local"] and b["remote"]):
        return
    if b["incoming"] and not b["unpushed"]:
        if b["dirty"]:
            notes.append(f"⚠ origin has {b['incoming']} newer commit(s); not fast-forwarded — the worktree has uncommitted changes")
            return
        lock = b["lock"] or {}
        if lock.get("session") not in (None, keep_sid) and any(v["id"] == lock["session"] and v["live"] for v in b["sessions"]):
            notes.append(f"⚠ origin has {b['incoming']} newer commit(s); not fast-forwarded — a running session holds the worktree")
            return
        if dry:
            notes.append(f"would fast-forward {b['incoming']} commit(s) from origin")
            return
        r = git(wt, "merge", "-q", "--ff-only", f"origin/{b['name']}")
        if r.returncode == 0:
            b["caught_up"] = b["incoming"]
            notes.append(f"✓ fast-forwarded {b['incoming']} commit(s) from origin")
        else:
            notes.append(f"⚠ fast-forward failed: {short(r.stderr, 120)}")
    elif b["incoming"]:
        notes.append(f"⚠ {sync_text(b)}")
    elif b["unpushed"]:
        notes.append(f"ℹ {b['unpushed']} local commit(s) not on origin yet — the hook pushes them next turn")


def release_stale_lock(b, keep_sid, notes, dry):
    """A lock whose owner is not running, taken by a session that ended without SessionEnd
    (a crash, a killed window): checkpoint.py would refuse the next writer for up to 2 h."""
    lock = b["lock"]
    if not lock or lock.get("session") == keep_sid or time.time() - lock.get("seen", 0) >= OWNER_TTL:
        return
    owner = lock.get("session") or ""
    if lock.get("handover"):
        # Taken now, by the session adopting it: a marked lock lets in ANY next writer (a stale
        # read-only tab, a sibling checkout's `cd <wt> && git …`), so the window closes at the
        # tab's /pickup rather than at its first write (review 2026-10-05).
        if not keep_sid or dry:
            notes.append(f"{'would take' if dry else '✓ left for the first write:'} the lock session {owner[:8]}"
                         f" handed over (pickup next)")
            return
        common.write_owner(Path(lock["path"]).parent, keep_sid, b["name"])
        notes.append(f"✓ took over the lock session {owner[:8]} handed over (pickup next): this session writes here")
        return
    if any(v["id"] == owner and v["live"] for v in b["sessions"]) or owner in live_sessions():
        notes.append(f"⚠ session {owner[:8]} is running and holds this worktree: writes here stay refused")
        return
    if dry:
        notes.append(f"would release the stale lock of {owner[:8]} (not running)")
        return
    Path(lock["path"]).unlink(missing_ok=True)
    notes.append(f"✓ released a stale lock: session {owner[:8]} held it and is not running")


def unpark(s, root, notes, dry):
    """Move a parked transcript back to the repo's own slug: ExitWorktree's move and stamp
    (relocateSessionTranscript, CLI 2.1.282) — the jsonl, its <id>/ folder (subagents, tool
    output), then a `relocated` record naming the repo root. Compact JSON: the VS Code list
    probes raw substrings of a transcript's head and tail (fork_claude_session.py)."""
    src = Path(s["path"])
    dest_dir = PROJECTS / slug(root)
    dest, side, side_dest = dest_dir / src.name, src.with_suffix(""), dest_dir / src.stem
    if not dest_dir.is_dir() or dest.exists() or (side.is_dir() and side_dest.exists()):
        raise Stop(f"cannot unpark {s['id'][:8]}: {dest} is taken or {dest_dir} is missing")
    if dry:
        notes.append(f"would move {s['id'][:8]}'s transcript back from {src.parent.name}")
        return
    os.rename(src, dest)
    try:
        if side.is_dir():
            os.rename(side, side_dest)
    except OSError:
        os.rename(dest, src)
        raise
    with open(dest, "rb") as fh:
        fh.seek(-1, os.SEEK_END)
        newline = fh.read(1) != b"\n"
    with open(dest, "a", encoding="utf-8") as fh:
        fh.write(("\n" if newline else "") + json.dumps(
            {"type": "relocated", "sessionId": s["id"], "relocatedCwd": str(root)},
            ensure_ascii=False, separators=(",", ":")) + "\n")
    if scan(dest)["relocated"] != str(root):
        raise Stop(f"unpark of {s['id'][:8]} did not take: {dest} does not end relocated to {root}")
    s["path"], s["parked"], s["cwd"] = str(dest), False, str(root)
    notes.append(f"✓ unparked {s['id'][:8]}: its transcript is back in the repo's session list")


def orientation(b, wt, s, note, how="Picked up with /pickup"):
    """The first message the reopened session gets (pre-filled in VS Code, sent in a terminal).
    Worded to make sense in a fresh session too: that is what VS Code opens for an id it
    cannot find. `how`: what brought it here (`move` says where it came from)."""
    facts = [f"{b['dirty']} uncommitted file(s)" if b["dirty"] else "clean"]
    if b.get("caught_up"):
        facts.append(f"fast-forwarded {b['caught_up']} commit(s) another machine pushed — read them")
    elif b["incoming"] and b["unpushed"]:
        facts.append(f"diverged from origin ({b['unpushed']} here, {b['incoming']} there) — "
                     f"reconcile before anything else, never force")
    elif b["incoming"]:
        facts.append(f"origin has {b['incoming']} newer commit(s), not merged here")
    if b["behind_main"]:
        facts.append(f"main has {b['behind_main']} commit(s) this branch lacks")
    lines = [f"{how} ({datetime.datetime.now():%Y-%m-%d %H:%M}): {b['name']}.",
             f"Worktree: {wt} — {'; '.join(facts)}."]
    if s and not s["on_branch"]:
        lines.append(f"You are not in that worktree now{' (you moved on to ' + s['moved_on'] + ')' if s['moved_on'] else ''}: "
                     f"ExitWorktree (keep) if you are in another, then EnterWorktree {wt}, before touching anything.")
    lines.append("Re-read the state there first (git status, git log -5), then tell me in three lines "
                 "where this stands and what is next" + (f". Then: {note}" if note else ", and wait for my go."))
    return "\n".join(lines)


BUNDLE_BUDGET = 20_000  # characters: the Bash tool files a large output away behind a 2 KB preview (72.9 KB, 2026-09-29)
# Over budget, cut the replies first, then the prompts: (reply cap, prompt cap), tried in order.
BUNDLE_CUTS = ((2500, 600), (1200, 600), (600, 600), (600, 300), (600, 150))


def clip(text, n):
    """`text` cut to n characters with …, newlines kept (a reply's structure is its meaning)."""
    text = (text or "").strip()
    return text if len(text) <= n else text[:n - 1].rstrip() + "…"


def context_bundle(b, data, s, me_is_owner=False):
    """What this session reads before adopting a branch: from a session gone to the other
    machine or swept, or — the fresh handoff — from one too large to bring back whole. It is
    the only record of what the branch was for (/finish step 2), within BUNDLE_BUDGET."""
    root, pr = data["root"], b["pr"]
    head = ["── context ──"]
    if s:
        size = f" — {kilo(s['ctx'])} tokens" if s.get("ctx") else ""
        if s.get("handed_over"):
            head.append(f"Continues session {s['id'][:8]} \"{s['title']}\"{size}, which handed this stage over"
                        f" (pickup next); its tab is still open — the next step is the note below")
        else:
            state = "running now" if s.get("live") else f"closed {ago(s.get('ctx_end') or s['when'])}"
            head.append(f"Continues session {s['id'][:8]} \"{s['title']}\"{size}, {state}; its transcript is untouched:"
                        f" pickup open '{b['name']}' --reopen brings the whole conversation back")
    hit = peer_hit(b) if not s else None
    if hit:  # the conversation is on the other machine: name it, and bring its replies
        peer = b["peer"]
        ctx = (peer["context"].get(hit[0]) or {}).get("ctx")
        head.append(f"Continues session {Path(hit[1]).stem[:8] if hit[0] == 'branch' else hit[0][:8]} on {peer['host']}"
                    + (f" — {kilo(ctx)} tokens" if ctx else "") + "; its transcript there is untouched:"
                    f" pickup open '{b['name']}' --reopen carries the whole conversation over")
    if pr:
        head.append(f"PR #{pr['number']} {pr['state']} \"{pr['title']}\" {pr['url']}")
        body = pr["body"].strip()
        if body and not HOOK_PR.search(body):
            head.append(short(body, 1500))
    head.append(f"Commits on main..branch ({len(b['commits'])}, newest first):")
    head += [f"  {c['sha']} {ago(c['time']):>11}  {short(c['subject'], 100)}" for c in b["commits"][:15]]
    prompts = [p for c in reversed(b["commits"]) for p in c["prompts"]][-8:]
    path = (s or {}).get("path") or next((e["archived"] for e in b["elsewhere"] if e["archived"]), None)
    asks, replies = tail(Path(path), b["name"]) if path else ([], [])
    if hit and not path:
        path, replies = f"{b['peer']['host']}:{hit[1]}", b["peer"]["replies"].get(hit[0]) or []
    # Two words of the topic when it has two: one pulls every line naming "claude" for
    # `claude-md-lazy`, all of them matched nothing for 9 of the shop's 13 topics (2026-09-29).
    words = [w.lower() for w in re.findall(r"[A-Za-z]{4,}", b["topic"])]
    todo = [l.strip() for l in git(root, "show", f"{b['tip']}:TODO.md").stdout.splitlines()
            if l.strip() and words and sum(w in l.lower() for w in words) >= min(2, len(words))][:5]
    stat = stat_lines(root, data["main"], b["tip"], 20)

    def render(reply_cap, prompt_cap):
        lines = list(head)
        if prompts:
            lines.append("Prompts on the branch (oldest first, last 8):")
            lines += [f"  {i}. {short(p, prompt_cap)}" for i, p in enumerate(prompts, 1)]
        if path:
            lines.append(f"From the transcript ({Path(path).name}):")
            lines += [f"  asked: {short(a, 400)}" for a in asks[-3:]]
            for r in replies[-3:]:  # D1: the last three assistant messages
                lines.append("  replied: " + clip(r, reply_cap).replace("\n", "\n    "))
        if todo:
            lines.append(f"TODO.md at the branch tip, lines on \"{b['topic']}\":")
            lines += [f"  {short(l, 300)}" for l in todo]
        if stat:
            lines.append("Files (main...branch):")
            lines += ["  " + l for l in stat if l]
        return "\n".join(lines)

    for caps in BUNDLE_CUTS:
        text = render(*caps)
        if len(text) <= BUNDLE_BUDGET:
            break
    print(text if len(text) <= BUNDLE_BUDGET else text[:BUNDLE_BUDGET - 1] + "…")


def branch_replies(lines, branch):
    """The last three assistant texts on this branch, from a transcript's lines. Uses only
    `json`, because PEER_PROBE carries its source to the other machine (a fresh start of a
    conversation carried from there still gets them, D1)."""
    replies, key = [], '"gitBranch":"%s"' % branch
    for line in lines:
        if key not in line or '"type":"assistant"' not in line:
            continue
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("type") == "assistant":
            for c in (r.get("message") or {}).get("content") or []:
                if isinstance(c, dict) and c.get("type") == "text" and len(c.get("text", "")) > 40:
                    replies.append(c["text"])
    return replies[-3:]


def tail(path, branch):
    """The last human prompts and assistant texts a transcript recorded on this branch."""
    asks, key = [], f'"gitBranch":"{branch}"'
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if key not in line or '"kind":"human"' not in line:
                continue
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("type") == "user" and (r.get("origin") or {}).get("kind") == "human":
                text = prompt_text(r)
                if text:
                    asks.append(text)
    with open(path, encoding="utf-8", errors="replace") as fh:
        return asks[-6:], branch_replies(fh, branch)


# Which window a tab opens in. A vscode:// link goes to the last-focused window unless its query
# carries `windowId=<n>`: VS Code's URL router hands it to the first window whose `window:<id>`
# matches (probed 2026-10-05, Code 1.140: a link with windowId=5 started a Claude session under
# extension-host [5] while window 1 had focus). The match is an unanchored RegExp (mainImpl.js,
# URLHandlerRouter.routeCall), so windowId=1 also matches window:12: an id that is the prefix of
# another open window's is no id at all here — and the first `windowId=` in the query wins, so
# send_link puts it first, before a prompt that could carry the same words. This session's
# window: the extension host among its ancestors (the one whose parent is VSCODE_PID), which
# `code --status` prints as `extension-host [<n>]` beside its pid, 2–4 s. Unknown or ambiguous —
# a Terminal session, a VS Code that prints otherwise — means no link to it: vscode_target finds
# another window of the repo, or none, and the caller says why (never the focused window).
# PICKUP_VSCODE_WINDOW forces one (0: never; empty: unset); PICKUP_VSCODE_CLI is the tests'.
#
# Another repo's window (vscode_windows_on): the Claude extension writes `<config>/ide/<port>.lock`
# when each window activates — its workspaceFolders, and a WebSocket server on 127.0.0.1:<port>
# inside that window's extension host (extension 2.1.296 and 2.1.299; its `pid` field is
# process.ppid, VS Code's main process, the same for every window, so it is not used). The
# port's listener is the extension host, and `code --status` names its window. The lock sits in
# the extension host's own CLAUDE_CONFIG_DIR, so every ~/.claude*/ide is read (ide_windows).

# not on PATH on the laptop (2026-10-14): a caller outside VS Code has no VSCODE_PID to find it by
APP_CLI = Path("/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code")


def code_cli():
    """VS Code's `code` CLI: the running app's own (VSCODE_PID), else the one on PATH, else the
    app bundle's. PICKUP_VSCODE_CLI, the tests' stand-in, is final when set: a missing file means
    no CLI, never a real `code` behind the test's back (review 2026-10-14)."""
    if "PICKUP_VSCODE_CLI" in os.environ:
        cli = os.environ["PICKUP_VSCODE_CLI"]
        return cli if cli and Path(cli).exists() else None
    cli = ""
    vpid = os.environ.get("VSCODE_PID")
    if vpid and vpid.isdigit():  # .../Code.app/Contents/MacOS/Code → .../Contents/Resources/app/bin/code
        exe = run(["ps", "-o", "comm=", "-p", vpid]).stdout.strip()
        cli = str(Path(exe).parent.parent / "Resources" / "app" / "bin" / "code") if exe else ""
    if not (cli and Path(cli).exists()):
        cli = shutil.which("code") or (str(APP_CLI) if APP_CLI.exists() else "")
    return cli if cli and Path(cli).exists() else None


_STATUS = []


def code_status(fresh=False):
    """`code --status`, read once per run (2–5 s each); `fresh` reads it again — poll_window, waiting
    for a window that was not there."""
    if _STATUS and not fresh:
        return _STATUS[0]
    cli = code_cli()
    out = None
    if cli:
        try:
            out = subprocess.run([cli, "--status"], capture_output=True, text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            out = None
    _STATUS[:] = [out]
    return out


def host_window(status, host):
    """The window id `code --status` prints beside extension host `host` (a pid), or None —
    also when another open window's id starts with it (VS Code's unanchored match)."""
    m = re.search(rf"^\s*\S+\s+\S+\s+{host}\s+extension-host \[(\d+)\]", status or "", re.M)
    if not m:
        return None
    # anchored like the match above: a child process's argv in the listing can hold the same words
    others = set(re.findall(r"^\s*\S+\s+\S+\s+\d+\s+(?:window|extension-host) \[(\d+)\]", status, re.M))
    others.discard(m.group(1))
    return None if any(o.startswith(m.group(1)) for o in others) else m.group(1)


_OWN_WINDOW = []


def vscode_window():
    if _OWN_WINDOW:  # fresh_kind() and start_vscode() both ask; the probe is 2–4 s
        return _OWN_WINDOW[0]
    _OWN_WINDOW.append(_vscode_window())
    return _OWN_WINDOW[0]


def _vscode_window():
    forced = (os.environ.get("PICKUP_VSCODE_WINDOW") or "").strip()
    if forced:
        return str(int(forced)) if forced.isdigit() and int(forced) else None
    vpid = os.environ.get("VSCODE_PID")
    if not (vpid and vpid.isdigit()):
        return None
    table = run(["ps", "-A", "-o", "pid=,ppid="]).stdout  # one table, walked here: no ps per hop
    parent = dict(l.split() for l in table.splitlines() if len(l.split()) == 2)
    pid, host = str(os.getpid()), None
    for _ in range(30):
        ppid = parent.get(pid)
        if not ppid or ppid in ("0", "1"):
            return None
        if ppid == vpid:
            host = pid
            break
        pid = ppid
    if host is None:
        return None
    return host_window(code_status(), host)


def same_dir(a, b):
    try:
        return Path(a).resolve() == Path(b).resolve()
    except (OSError, RuntimeError):
        return False


def ide_windows(fresh=False):
    """(window id, first folder, every folder) for every open window whose Claude extension wrote
    an IDE lock.
    A stale lock (a window closed without cleaning up) has no listener and drops out; so does a
    window whose id is ambiguous (host_window)."""
    found = []
    status = None
    for lock in sorted(Path.home().glob(".claude*/ide/*.lock")):
        try:
            folders = json.loads(lock.read_text()).get("workspaceFolders") or []
        except (OSError, ValueError, AttributeError):
            continue
        if not (lock.stem.isdigit() and folders):
            continue
        hosts = run(["lsof", "-nP", "-a", f"-iTCP:{lock.stem}", "-sTCP:LISTEN", "-t"]).stdout.split()
        if not hosts:
            continue
        if status is None:
            status = code_status(fresh) or ""
        for h in hosts:
            w = host_window(status, h)
            if w and all(w != f for f, _, _ in found):
                found.append((w, folders[0], folders))
    return found


def in_repo(folder, root):
    """`folder` is `root`'s repo: the root itself or one of its worktrees (the git common dir)."""
    return same_dir(folder, root) or (Path(folder).is_dir() and repo_root(folder) == repo_root(root))


def vscode_window_on(folder, exact=True, fresh=False):
    """The first of vscode_windows_on(), or None."""
    ids = vscode_windows_on(folder, exact, fresh)
    return ids[0] if ids else None


def vscode_windows_on(folder, exact=True, fresh=False):
    """The ids of the open VS Code windows on `folder`'s repo, best first; [] when none: no such
    window, its extension not up yet, or its id ambiguous. exact: the window's first folder is
    `folder` itself — the folder its session list is scoped to, which a reopened session's
    transcript needs. Otherwise a window on the root wins, then any whose first folder is in the
    same repo (a worktree), then the window of `folder`'s scope that shows it — its anchor first
    (bin/scopes; the owner, D2 of docs/scopes-2026-10-14.md: "I want the session to open in the scoped
    window even if it's not targeting the first folder"), lowest id first: a fresh tab only needs a
    window that holds the repo, and moves into its worktree from the anchor. Only the scope's own
    window: the launcher repo is in every scope's file, and its branch belongs in the knowledge scope's."""
    on, near, scoped = [], [], []
    anchor = None if exact else scope_anchor(folder)
    roots = {}

    def top(f):  # one `git rev-parse` per folder per call: a scope window lists twenty (review 2026-10-15)
        if f not in roots:
            roots[f] = repo_root(f) if Path(f).is_dir() else None
        return roots[f]

    def holds(f, d):
        return same_dir(f, d) or (top(f) is not None and top(f) == top(d))

    for w, first, every in ide_windows(fresh):
        if same_dir(first, folder):
            on.append(w)
        elif not exact and holds(first, folder):
            near.append(w)
        elif anchor and holds(first, anchor) and any(holds(f, folder) for f in every[1:]):
            scoped.append(w)
    return sorted(on, key=int) + sorted(near, key=int) + sorted(scoped, key=int)


try:
    WINDOW_WAIT = int(os.environ.get("PICKUP_VSCODE_WAIT") or 20)  # s for a window `code` opened to show up
except ValueError:
    WINDOW_WAIT = 20


def vscode_target(root, notes, dry, me=None, exact=False):
    return _vscode_target(root, notes, dry, me, exact)[0]


def _vscode_target(root, notes, dry, me=None, exact=False):
    """(window, its first folder) — the first folder None when unknown. The windowId a link for `root` goes to — always a window of that repo, never whichever has
    focus (the owner, 2026-10-13: "I don't want to mix things in my repos"): this session's own when it
    is on `root`, else an open window on the repo, else the one `code -n <root>` opens. None: no
    window could be identified for sure — nothing is sent, and the caller says what to do instead,
    with the reason in `notes`."""
    # This session's own window only when it is one of them: a session whose cwd moved into another
    # repo's worktree (EnterWorktree into a sibling) still sits in its first repo's window, whose
    # tabs run there (2026-10-14: the laptop probe aimed at the pipeline window for a launcher-repo branch).
    # A reopen (exact) needs the window on the root itself: there a lock showing own on anything
    # else (a worktree, as /move's `open -a … wt` makes) rules it out. A window no lock names is
    # unknown, not foreign — its extension may not have written one yet.
    ids = vscode_windows_on(root, exact)
    # a scope's window is this session's own too when it is the anchor's (scoped_here)
    own = vscode_window() if me is not None and (me.get("repo") == root or (not exact and scoped_here(me, root))) else None
    first = next((f for w, f, _ in ide_windows() if w == own), None) if own and own not in ids else None
    if own and (own in ids or first is None or (not exact and in_repo(first, root))):
        return own, window_first(own) or (me.get("repo") if me else None)
    if ids:
        return ids[0], window_first(ids[0])
    cli = code_cli()
    if not cli:
        notes.append(f"⚠ no VS Code window on {root.name} could be identified, and no `code` CLI to open one")
        return None, None
    # the scope's workspace file when root is in one (bin/scopes, its anchor first): any tab there
    # moves into root's worktree from the anchor. A reopen (exact) needs root first, so the file
    # only when root is the anchor; otherwise the bare folder
    ws = scope_workspace(root)
    if ws and not file_lists(ws, root):
        ws = None  # a file that lacks root opens a window that never shows it (review 2026-10-15)
    anchor = scope_anchor(root) if ws else None
    if ws and exact and not (anchor and same_dir(anchor, root)):
        ws = None
    what = ws or root
    opened_first = anchor if ws else root
    # PICKUP_NO_START still runs the tests' stand-in CLI, which opens no window
    if dry or (NO_START and not os.environ.get("PICKUP_VSCODE_CLI")):
        notes.append(f"{'would run' if dry else 'not opened (PICKUP_NO_START)'}: code -n {shlex.quote(str(what))}")
        return "<its id once open>", opened_first
    # -n: with window.openFoldersInNewWindow off, a bare `code <dir>` swaps the focused window's
    # folder — possibly the window of the session running this (review 2026-10-14)
    r = run([cli, "-n", str(what)])
    window = None if r.returncode else poll_window(root, exact or not ws)
    if not window:
        notes.append(f"⚠ `code -n {what}` " + (f"failed ({short(r.stderr, 100)})" if r.returncode else
                     f"opened no window whose id could be read in {WINDOW_WAIT} s"))
        return None, None
    notes.append(f"✓ `code -n {what}` opened {root.name}'s VS Code window (window {window})")
    return window, window_first(window) or opened_first


_SCOPES = {}


def scopes_say(verb, root):
    """bin/scopes VERB ROOT's one line, or None (no scope, no file, no tool); asked once per run.
    PICKUP_SCOPES is the tests' stand-in for bin/scopes."""
    key = (verb, str(root))
    if key not in _SCOPES:
        tool = os.environ.get("PICKUP_SCOPES") or str(common.tool("scopes") or BIN / "scopes")   # wharf's
        r = run([sys.executable, tool, verb, str(root)]) if Path(tool).exists() else None
        _SCOPES[key] = r.stdout.strip() if r is not None and r.returncode == 0 and r.stdout.strip() else None
    return _SCOPES[key]


def scope_workspace(root):
    """The VS Code workspace file of `root`'s scope (bin/scopes), or None: no scope, no file yet."""
    p = scopes_say("workspace", root)
    return Path(p) if p and Path(p).is_file() else None


def scope_anchor(root):
    """The anchor of `root`'s scope — the first folder of its file, where that window's sessions
    start — or None when root is in no scope."""
    p = scopes_say("anchor", root)
    return Path(p) if p else None


def window_first(window):
    return next((f for w, f, _ in ide_windows() if w == window), None)


def scoped_here(me, root):
    """This VS Code session runs in the anchor of root's scope, so its window is root's scope's: a
    fresh session for root belongs here and moves into root's worktree (D2, docs/scopes-2026-10-14.md)."""
    if me.get("entry") != "claude-vscode" or not me.get("repo") or me["repo"] == root:
        return False
    anchor = scope_anchor(root)
    if not anchor or not same_dir(repo_root(anchor) or anchor, me["repo"]):
        return False
    # its cwd says anchor, but a session can EnterWorktree into the anchor's repo from any window
    # (review 2026-10-15): the window's own first folder decides, and an unknown window is not it
    own = vscode_window()
    first = window_first(own) if own else None
    return bool(first) and in_repo(first, anchor)


def foreign_to(me, root):
    """root is another repo's, and this session's window is not root's scope's either."""
    return me.get("repo") != root and not scoped_here(me, root)


def transcript_home(s, root, me):
    """The folder whose window lists session `s`: the one whose project dir holds its transcript —
    root, this session's repo, or the anchor of root's scope (a session started in the scope's window
    that moved into root's worktree keeps its transcript there). None when it is none of them."""
    d = Path(s["path"]).parent.name
    for c in (root, me.get("repo"), scope_anchor(root)):
        if c and slug(c) == d:
            return Path(c)
    return None


def unpark_home(s, root):
    """Where a parked transcript goes back to — where ExitWorktree would have put it: the folder
    the session started in, when that is root's scope's anchor (a session of the scope's window
    that entered root's worktree; review 2026-10-15); else root, as always."""
    cwd0, anchor = s.get("cwd0"), scope_anchor(root)
    if cwd0 and anchor and same_dir(cwd0, anchor) and not same_dir(anchor, root):
        return anchor
    return root


def file_lists(ws, root):
    """The workspace file `ws` has a folder in root's repo (strict JSON, as bin/scopes writes it)."""
    try:
        data = json.loads(Path(ws).read_text())
    except (OSError, ValueError):
        return False
    return any(in_repo(os.path.normpath(os.path.join(str(Path(ws).parent), str(f.get("path") or ""))), root)
               for f in data.get("folders") or [] if isinstance(f, dict) and f.get("path"))


def typed_line(again, root):
    """The `/pickup …` the owner types by hand: with `--repo` when root's scope has another anchor, since
    a tab in the scope's window starts there."""
    anchor = scope_anchor(root)
    return with_repo(again, root) if anchor and not same_dir(anchor, root) else again


def with_repo(prompt, root):
    """`/pickup …` with `--repo root` before its closing `--fresh` (the skill keys on that ending)."""
    flag = f" --repo {shlex.quote(str(root))}"
    return prompt[:-len(" --fresh")] + flag + " --fresh" if prompt.endswith(" --fresh") else prompt + flag


def poll_window(folder, exact=True):
    """The id of the window on `folder` just opened or raised: its extension writes the lock
    once it activates, so this waits up to WINDOW_WAIT, reading `code --status` afresh each time.
    Not exact: the scope's window that shows it counts (a scope's file was opened)."""
    deadline = time.time() + WINDOW_WAIT
    while True:
        window = vscode_window_on(folder, exact, fresh=True)
        if window or time.time() >= deadline:
            return window
        time.sleep(1)


def send_link(params, window, notes, dry):
    if window:  # first: VS Code's router takes the first `windowId=` in the query
        params = {"windowId": window, **params}
    url = f"{SCHEME}://anthropic.claude-code/open?" + urllib.parse.urlencode(params, quote_via=urllib.parse.quote)
    if dry or NO_START:
        notes.append(f"{'would open' if dry else 'not opened (PICKUP_NO_START)'}: {url}")
        return
    r = run(["open", url])
    if r.returncode:
        raise Stop(f"`open` could not hand the link to VS Code: {short(r.stderr, 200)}")


def start_vscode(params, notes, dry, root, me=None, exact=False):
    """→ True once the link is sent (dry: would be) to a window of `root`'s repo; False: none
    identified (vscode_target), nothing sent."""
    window, first = _vscode_target(root, notes, dry, me, exact)
    if window is None:
        return False
    # a tab in root's scope's window starts in its anchor: the `/pickup` it runs needs root named
    prompt = params.get("prompt") or ""
    if prompt.startswith("/pickup ") and first and not in_repo(first, root):
        params = {**params, "prompt": with_repo(prompt, root)}
    send_link(params, window, notes, dry)
    return True


def own_login_env():
    """This session's login for a Terminal window that stands in for a tab of its window: the tab
    would have run on it, and the transcripts pickup read live under it (CONFIG)."""
    d = os.environ.get("CLAUDE_CONFIG_DIR")
    return {"CLAUDE_CONFIG_DIR": d} if d else {}


# ---- which account a start runs on (docs/record/multi-account-design-2026-10-02.md, E4) ------------
#
# `--account auto` (the default) asks `bin/account pick` for a fresh Terminal window only: that is
# the one start whose login pickup chooses. A VS Code tab runs on its window's login — the
# CLAUDE_CONFIG_DIR the panel gives every session there, from a VS Code profile's
# claudeCode.environmentVariables or VS Code's own environment (work-account P3, P9) — and the
# link takes no account. E4 said "the laptop's login"; on 2026-10-13 a laptop VS Code session ran
# on a second login, so the rule is the window's: a named account is kept for a tab in this session's
# window only when it is this session's login (CONFIG), and another repo's window, whose login
# pickup cannot read, gets a Terminal window instead. A reopen keeps the default unless a label
# is named. No registry on this machine: starts as before.

ACCOUNT = common.tool("account")   # lighthouse's (G12); None: every start runs on the one login


def seed_task(root, b):
    """A seed brief's optional `kind:` and `provider:` — from its YAML-style frontmatter only (a
    leading `---` block), so a sentence in the body never routes a start; a provider nothing
    starts (anything but claude or codex) is no hint (code review 2026-10-03)."""
    brief = (b.get("seed") or {}).get("brief")
    if not brief:
        return {}
    lines = out(root, "show", f"{b['name']}:{brief}").splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    task = {}
    for line in lines[1:]:
        if line.strip() == "---":
            break
        key, _, value = line.partition(":")
        if key.strip().lower() in ("kind", "provider") and value.strip():
            task.setdefault(key.strip().lower(), value.strip().lower())
    if task.get("provider") not in (None, "claude", "codex"):
        task.pop("provider")
    return task


def named_account(want, force, dry, root=None):
    """`--account LABEL`: that row, refused unless it can run here — a Claude account, set up on
    this Mac, enabled, and inside its own rules and deny list unless --force (the owner's override,
    never a skill's)."""
    if not ACCOUNT:
        raise Stop(f"--account {want}: no account tool here (lighthouse is not installed) — nothing was opened")
    r = run([sys.executable, str(ACCOUNT), "limits", want, "--json"] + (["--cached"] if dry else [])
            + (["--repo", str(root)] if root else []), timeout=150)
    rows = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []
    if not rows:
        raise Stop(f"--account {want}: {short(r.stderr or 'no such enabled account', 200)}")
    a = rows[0]
    if a["provider"] != "claude":
        raise Stop(f"--account {want} is a {a['provider']} account; pickup starts claude only (design E7)")
    if not a["here"]:
        raise Stop(f"--account {want} is not set up on this machine — {ACCOUNT} add {want}")
    if a.get("denied"):  # the guard would block every prompt: --force never crosses a deny list
        raise Stop(f"--account {want}: {a['why']} — open it on the default login (no --account)", code=3)
    if not a["eligible"] and not force and not (a["limits"] is None and (dry or a["primary"])):
        raise Stop(f"--account {want}: {a['why']} — --force runs it there anyway", code=3)
    return a


def account_for(root, b, args, fresh_window):
    """→ (label or None, env, note). None: the default login, as before this existed."""
    want, force, dry = getattr(args, "account", "auto"), getattr(args, "force", False), args.dry_run
    if want and want != "auto":
        a = named_account(want, force, dry, root)
        return (None if a["primary"] else want), a["env"], f"account {want}, as asked"
    if not fresh_window:
        return None, {}, None
    if not ACCOUNT:   # G12: no lighthouse, no pick — the default login, as with no registry
        return None, {}, None
    task = seed_task(root, b)
    # --repo: a row whose deny list names this repo is skipped (work-account E2: a second login never
    # starts in a guarded repo)
    argv = [sys.executable, str(ACCOUNT), "pick", "--json", "--repo", str(root)] + (["--cached"] if dry else [])
    for key in ("kind", "provider"):
        if task.get(key):
            argv += [f"--{key}", task[key]]
    r = run(argv, timeout=150)  # a probe is ≤ 2 × 30 s per row; two rows fit
    if r.returncode == 4:
        return None, {}, None
    if r.returncode == 3:
        why = "; ".join(f"{l}: {w}" for l, w in json.loads(r.stdout or '{"skipped": []}')["skipped"])
        raise Stop(f"no account may start {b['name']} now — {why}. Nothing was opened;"
                   f" --account <label> --force overrides ({OWNER}'s call, never a skill's)", code=3)
    try:
        p = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        p = None
    if not p:  # a pick that could not decide never blocks a start: the primary, as before
        return None, {}, f"⚠ account pick failed ({short(r.stderr or r.stdout, 120)}) — the default login"
    if p.get("provider", "claude") != "claude":  # a Codex row (Orca's, 2026-10-16): claude with CODEX_HOME is the default login
        raise Stop(f"account pick gave {p['account']}, a {p['provider']} login — pickup starts claude only (design E7)."
                   f" Nothing was opened", code=3)
    return (None if p["primary"] else p["account"]), p["env"], f"account {p['account']}: {p['reason']}"


def vscode_account(args):
    """A tab in this session's window runs on this session's login: refuse a named other one."""
    want = getattr(args, "account", "auto")
    if want and want != "auto" and not same_dir(os.path.expanduser(named_account(want, True, True)["home"]), CONFIG):
        raise Stop(f"a VS Code tab runs on its window's login ({CONFIG}), not {want}; use --terminal")


def fresh_kind(me, root, via):
    """Where `open --fresh` hands a branch over, with the reason. A session that has done
    nothing else adopts it — this is also the tab a fresh pickup opens, whose `/pickup …
    --fresh` arrives here. One with other work opens a fresh one pre-filled with that command;
    the old transcript stays where it is. Another repo's branch (--repo) never arrives in this
    window: a new tab here lists this repo, and adopting here takes the other repo's worktree
    into this session — so a Terminal window running from that repo's root; and a plain
    shell, which is no session to adopt anything, gets one too (review 2026-09-29). From VS Code,
    that repo's own VS Code window instead, when this window's id can be read and a `code` CLI
    is there to find or open the other (2026-10-13: a Terminal session holds its transcript, and
    the extension never takes over a session another process holds — the owner got the browser)."""
    if (foreign_to(me, root) and me["entry"] == "claude-vscode" and me["id"] and via == "vscode"
            and vscode_window() and code_cli()):
        return "foreign-vscode", f"fresh, as asked: a new tab in {root.name}'s VS Code window adopts it"
    if (foreign_to(me, root) and me["entry"] in ("claude-vscode", "cli")) or not me["id"]:
        return "window", "fresh, as asked: a new Terminal window in that repo adopts it"
    if not me["earlier"] or me["entry"] not in ("claude-vscode", "cli"):
        return "here", "fresh, as asked: this session adopts it with the bundle"
    if via == "vscode":
        return "new-tab", "fresh, as asked: a new VS Code tab adopts it"
    return "window", "fresh, as asked: a new Terminal window adopts it"


def unattended_stop(verb):
    """`open` and `next` hand a session to the owner — a tab, a window. In an unattended run nobody is
    there to press Enter, and since D1 (2026-10-05) the next step starts with dispatch --next."""
    if os.environ.get("CLAUDE_UNATTENDED"):
        raise Stop(f"`pickup {verb}` hands a session to {OWNER}, and this is an unattended run "
                   f"(CLAUDE_UNATTENDED={os.environ['CLAUDE_UNATTENDED']}): nobody is there to press "
                   f"Enter — start the next step with dispatch --next, or end naming what it waits on")


def cmd_open(data, b, me, args):
    unattended_stop("open")
    root = data["root"]
    gave = handed_over(b) if args.fresh else None
    if gave:  # `pickup next` in that session: still running, but it has said it writes nothing more
        b = {**b, "sessions": [{**v, "handed_over": True} if v["id"] == gave else v for v in b["sessions"]]}
    kind, why = plan(b, me, root)
    if kind == "carry" and (args.vscode or args.terminal):
        why = "as asked"  # the carried conversation still comes along; the flag picks where it opens
    elif args.transcript or args.vscode or args.terminal or args.here or args.new_tab:
        kind = ("carry" if args.transcript else "vscode" if args.vscode else "terminal" if args.terminal
                else "here" if args.here else "new-tab")
        why = "as asked"
    # --fresh on another repo's branch with no session here is exactly the Terminal window
    # fresh_kind() opens in that repo — a seed there has no session by definition (2026-09-29).
    # Only then: from the phone fresh_kind says "here", which would adopt another repo's worktree.
    via = "vscode" if args.vscode else "terminal" if args.terminal or me["entry"] != "claude-vscode" else "vscode"
    if kind in ("none", "elsewhere") and not args.here and not (
            kind == "elsewhere" and args.fresh and fresh_kind(me, root, via)[0] in ("window", "foreign-vscode")):
        raise Stop(why)
    s = b["sessions"][0] if b["sessions"] else None
    if args.session:
        s = next((v for v in b["sessions"] if v["id"].startswith(args.session)), None)
        if s is None:
            raise Stop(f"no session {args.session} on this machine is linked to {b['name']}")
        if not (args.transcript or args.vscode or args.terminal or args.here or args.new_tab):
            # plan() judged the first session; the one picked may be closed while that one
            # runs (a traceback until the review of 2026-09-29), or the other way round
            kind, why = plan({**b, "sessions": [s] + [v for v in b["sessions"] if v is not s]}, me, root)
    if kind in ("vscode", "terminal") and s is None:
        raise Stop(f"no session for {b['name']} on this machine to reopen — use --here")
    if kind in ("vscode", "terminal") and s["live"] and not s.get("handed_over"):
        kind = "live"  # first, and unchanged: nothing below overrides a running session
    # Reopen or fresh (D1, 2026-09-29). A large conversation is never reopened or replaced
    # silently: without --reopen or --fresh, `open` stops with both, exit 3, having changed
    # nothing. --vscode, --terminal and --transcript name a reopen shape, so they count as
    # the choice made (the skill's "run it again with --terminal").
    adv = advice(context_source(b, kind, s), fresh_base(root), kind=kind) if kind in CHOICE_KINDS else None
    choose = (adv is not None and adv["tokens"] >= FRESH_TOKENS and not args.fresh
              and not (args.reopen or args.vscode or args.terminal or args.transcript))
    if args.fresh and kind not in ("live", "none"):
        kind, why = fresh_kind(me, root, via)
        if kind == "foreign-vscode" and getattr(args, "account", "auto") not in (None, "auto"):
            kind, why = "window", (f"fresh, as asked: a new Terminal window in that repo on {args.account} —"
                                   f" a tab there would run on that window's login")
        if (kind in ("new-tab", "window", "foreign-vscode") and not (args.new_tab or args.vscode or args.terminal)
                and dispatchable(root, b)):
            why = f"fresh, as asked: dispatch starts it — {dispatch_where()}"
    notes = []
    # the rerun the choice asks for, with everything this run was given
    flags = "".join([f" --repo {shlex.quote(str(root))}" if me.get("repo") != root else "",
                     f" --session {shlex.quote(args.session)}" if args.session else "",
                     f" --note {shlex.quote(args.note)}" if args.note else ""])
    print(f"{b['name']} → choice: reopen ({kind}) or fresh — its conversation is large" if choose
          else f"{b['name']} → {kind}: {why}")
    warn = {"closed": "its PR was closed without merging", "gone": "its upstream is gone from GitHub",
            **{w: f"probably on main already ({b['proof']})" for w in PROBABLY},
            "in main": "main already has every commit on it"}.get(b["status"])
    if b["carried"]:
        warn = f"carried by {', '.join(b['carried'])}, not proved — the work may go on there"
    if warn:
        print(f"  ⚠ {warn} — make sure this is the work meant")
    for w in peer_warnings(b):
        print(f"  {w}")
    if b.get("moved"):  # E4's review (d): opening it here makes a second writer of a moved branch
        print(f"  ⚠ {common.moved_reason(b['moved'], b['name'])}")
    if choose:
        print("\n".join(context_lines(adv, kind, (b.get("peer") or {}).get("host"))))
        raise Stop(f"choose: pickup open '{b['name']}'{flags} --reopen | --fresh", code=3)
    if getattr(args, "account", "auto") not in (None, "auto") and kind in ("here", "live"):
        print(f"  ⚠ --account {args.account} not applied: {kind} starts nothing — the session keeps its own login")
    if kind == "here":
        # `--here` overrides the `live` plan, and a lock idle over 2 h is released silently, so
        # without this nothing says the branch's own session is still up — the /finish <branch>
        # case: an idle Remote Control session in another slot (review, 2026-09-25).
        for v in b["sessions"]:
            e = v["live"] if not v.get("handed_over") else None
            if e:
                end = (f"{BIN}/rc-hosts --end {v['id'][:8]}" if e.get("entrypoint") == "sdk-cli"
                       else "close it where it runs")
                print(f"  ⚠ session {v['id'][:8]} \"{v['title']}\" worked on this branch and is running here"
                      f" ({e.get('status', '?')}, pid {e.get('pid')}) — two writers on one branch; end it first: {end}")
    if kind == "live":
        e = s["live"]
        print(f"  session {s['id'][:8]} \"{s['title']}\" is running: {e.get('entrypoint')} "
              f"(pid {e.get('pid')}, {e.get('status', '?')}, cwd {rel(e.get('cwd', ''), root)}). Switch to it there;"
              f" nothing was opened or changed.")
        return
    # The slash command itself, not a request to run it: the skill is owner-only
    # (disable-model-invocation), and `--fresh` keeps the new session from asking again.
    # The owner's instruction travels with it; the skill passes --note on to `open`.
    note = (f" --session {shlex.quote(args.session)}" if args.session and args.fresh else "") \
        + (f" --note {shlex.quote(args.note)}" if args.note else "")
    again = f"/pickup '{b['name']}'{note} --fresh" if args.fresh else f"/pickup {b['name']}{note}"
    fresh_dispatch = (args.fresh and kind in ("new-tab", "window", "foreign-vscode")
                      and not (args.new_tab or args.vscode or args.terminal) and dispatchable(root, b))
    # a VS Code tab's login rule is the tab's: a dispatched run picks its own (review 2026-10-13)
    if (kind in ("new-tab", "vscode") or (kind == "carry" and via == "vscode")) and not fresh_dispatch:
        vscode_account(args)
    # a Terminal reopen or carry: the named account is checked before the worktree, the lock or a
    # fork is touched, so a refusal leaves nothing behind (code review 2026-10-03)
    resume_env = account_for(root, b, args, False)[1] if kind in ("terminal", "carry") and via != "vscode" else {}
    # a new session where dispatch takes the repo: a dispatched run, not a tab or a window (dispatch_fresh)
    if fresh_dispatch and dispatch_fresh(root, b, args):
        return
    if fresh_dispatch and kind == "new-tab":
        vscode_account(args)   # dispatch refused: the tab after all, under its own rule
    if kind in ("new-tab", "foreign-vscode"):
        if start_vscode({"prompt": again}, notes, args.dry_run, root, me):
            if not (args.dry_run or NO_START):
                notes.append(f"✓ a new tab in {root.name}'s VS Code window is open with `{typed_line(again, root)}` pre-filled"
                             " — press Enter there")
            print("\n".join(f"  {n}" for n in notes))
            return
        if kind == "new-tab" or getattr(args, "tab_only", False):
            # A pre-filled tab waits for the owner's Enter (D2 b); a Terminal window would run it at once,
            # so with no window of this repo identified nothing starts — never the focused window
            # either (review 2026-10-14). tab_only: a seed opened without --start (start_seed).
            notes.append(f"nothing started: type `{typed_line(again, root)}` in a {root.name} VS Code window")
            print("\n".join(f"  {n}" for n in notes))
            return
        kind = "window"  # another repo's branch, fresh as asked: its Terminal window, as before 2026-10-13
    if kind == "window":
        # `claude "<prompt>"` sends the prompt as typed input, and a leading slash command is
        # dispatched there (R1, docs/record/pickup-cold-handoff-2026-09-29.md; proved by a real run 2026-09-29).
        acct, env, why = account_for(root, b, args, True)
        # the label in the name is what the shared registry, `pickup list` and VS Code's list show (R6)
        name = f"{root.name}: {b['topic']}" + (f" · {acct}" if acct else "")
        argv = [shutil.which("claude") or "claude", "--name", name, again]
        if why:
            notes.append(why)
        pre = "".join(f"{k}={shlex.quote(v)} " for k, v in env.items())
        if args.dry_run or NO_START:
            notes.append(f"{'would run' if args.dry_run else 'not opened (PICKUP_NO_START)'} in {root}: "
                         f"{pre}claude --name {shlex.quote(name)} {shlex.quote(again)}")
        else:
            open_in_terminal(Path(root), argv, env=env)
            notes.append(f"→ a fresh session in a new Terminal window, named \"{name}\", running `{again}`")
        print("\n".join(f"  {n}" for n in notes))
        return
    # the window first: a reopen needs the window on the root itself (its list holds the transcript),
    # and with none identified it opens in Terminal — before unpark moves the transcript to the root
    window = None
    if kind == "vscode" or (kind == "carry" and via == "vscode"):
        # the window whose session list holds the transcript: root's — or, for another repo's branch
        # whose session this window lists (plan()'s `listed`), this session's own (review 2026-10-14)
        target = root
        if kind == "vscode":
            target = unpark_home(s, root) if s["parked"] else (transcript_home(s, root, me) or root)
        window = vscode_target(target, notes, args.dry_run, me, exact=True)
        if window is None:
            if kind == "vscode":
                kind = "terminal"
            via = "terminal"
            resume_env = resume_env or own_login_env()
    keep = s["id"] if kind in ("vscode", "terminal") else None if kind == "carry" else me["id"]
    wt = ensure_worktree(root, b, s if kind != "carry" else None, notes, args.dry_run)
    catch_up(b, wt, keep, notes, args.dry_run)
    release_stale_lock(b, keep, notes, args.dry_run)
    if kind == "carry":
        new_id, title = carry_transcript(b, root, wt, notes, args.dry_run)
        # The fork dropped the worktree bookkeeping, so it opens in the repo root: the
        # orientation tells it to enter the worktree, as for a session that moved on.
        prompt = orientation(b, wt, {"on_branch": False, "moved_on": None}, args.note)
        name = f"{root.name}: {b['topic']}"
        if via == "vscode":
            if not (args.dry_run or NO_START):
                announce(root, new_id, title or name)  # the sidebar reads a new transcript only when told
            send_link({"session": new_id, "prompt": prompt}, window, notes, args.dry_run)
            notes.append(f"→ the {b['peer']['host']} conversation opens in a VS Code tab, first message pre-filled — press Enter")
        else:
            env = resume_env
            argv = [shutil.which("claude") or "claude", "--resume", new_id, "--name", name, " ".join(prompt.split())]
            if args.dry_run or NO_START:
                notes.append(f"{'would run' if args.dry_run else 'not opened (PICKUP_NO_START)'} in {root}: claude --resume {new_id}")
            else:
                open_in_terminal(Path(root), argv, env=env)
                notes.append(f"→ the {b['peer']['host']} conversation reopened in a new Terminal window, named \"{name}\"")
        for n in notes:
            print(f"  {n}")
        print("  prompt:")
        print("\n".join("    " + l for l in prompt.splitlines()))
        return
    if kind == "vscode" and s["parked"]:
        unpark(s, unpark_home(s, root), notes, args.dry_run)
    prompt = orientation(b, wt, s, args.note)
    if kind == "vscode":
        send_link({"session": s["id"], "prompt": prompt}, window, notes, args.dry_run)
        notes.append(f"→ \"{s['title']}\" ({s['id'][:8]}) opens in a VS Code tab, first message pre-filled — press Enter")
    elif kind == "terminal":
        name = s["title"] if s["named"] else f"{root.name}: {b['topic']}"
        # One line: the prompt travels inside an AppleScript string literal (open_in_terminal).
        argv = [shutil.which("claude") or "claude", "--resume", s["id"], "--name", name,
                " ".join(prompt.split())]
        cwd = s["cwd"] or str(root)
        env = resume_env
        if args.dry_run or NO_START:
            notes.append(f"{'would run' if args.dry_run else 'not opened (PICKUP_NO_START)'} in {cwd}: claude --resume {s['id']}")
        else:
            open_in_terminal(Path(cwd), argv, env=env)
            notes.append(f"→ \"{s['title']}\" ({s['id'][:8]}) reopened in a new Terminal window, named \"{name}\"")
    for n in notes:
        print(f"  {n}")
    if kind == "here":
        print(f"  → adopt it here: EnterWorktree {wt}, read the context below")
        context_bundle(b, data, s)
    if kind in ("vscode", "terminal"):
        print("  prompt:")
        print("\n".join("    " + l for l in prompt.splitlines()))


# ---- next: a stage hands over to the next (docs/subagent-cache-2026-10-04.md D6–D7) -----------
#
# After a memo Save the session goes on by itself (D6). Under STAGE_TOKENS of context it just
# continues — a parent waiting on answers holds 60–100k, so going on costs 1–10% more than a
# fresh tab (that doc, section 1). Above, a session cannot type /clear itself; the nearest is a
# fresh VS Code tab with the next step pre-filled (one Enter). That tab is a new session in the
# SAME worktree, which this one's lock would make read-only, so the lock is first marked
# `handover`: checkpoint.py's held_by_other() holds nobody out on a marked lock, the mark
# survives this session's own Stop commit (claim()), and a new prompt here withdraws it. The
# tab runs `/pickup … --fresh`, whose `open` sees the mark and does not refuse this session as
# running (handed_over()).

try:  # a bad value must not cost every other verb a traceback at import (review 2026-10-05)
    STAGE_TOKENS = int(os.environ.get("PICKUP_STAGE_TOKENS") or 120_000)  # D7: "~120k"
except ValueError:
    STAGE_TOKENS = 120_000


def handed_over(b):
    """The session id that marked this branch's lock handed over, or None."""
    lock = b.get("lock") or {}
    return lock.get("session") if lock.get("handover") else None


def dispatch_takes(top):
    """True when dispatch would start a branch of the repo at TOP: on the worktree workflow and its
    contract saying `physical: none` — dispatch's physical_ok and paste-paths' seedable()."""
    common_dir = out(top, "rev-parse", "--path-format=absolute", "--git-common-dir")
    primary = Path(common_dir).parent if common_dir.endswith(".git") else None
    if primary is None:
        return None
    try:
        if json.loads((primary / ".claude" / "workflow.json").read_text()).get("checkpoint") is not True:
            return None
    except (OSError, ValueError):
        return None
    for name in ("AGENTS.md", "CLAUDE.md"):
        try:
            lines = (primary / name).read_text().splitlines()
        except OSError:
            continue
        phys = next((l for l in lines if l.startswith("- physical:")), None)
        if phys is not None:
            return primary if phys.startswith("- physical: none") else None
    return None


def dispatchable(root, b):
    """(primary, True) when dispatch takes the repo at ROOT and branch B, here locally, carries its
    brief; else None. Local only: `dispatch --next` checks what a plain dispatch would not — work
    after the brief, a lock another session holds — so a branch only on origin keeps the tab or
    window (review 2026-10-13)."""
    primary = dispatch_takes(root)
    if not primary:
        return None
    topic = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", b["name"].rsplit("/", 1)[-1])
    local = git(primary, "show-ref", "--verify", "--quiet", f"refs/heads/{b['name']}").returncode == 0
    if not local:
        return None
    ref = f"refs/heads/{b['name']}"
    brief = re.compile(rf"docs/handoff/\d{{4}}-\d{{2}}-\d{{2}}-{re.escape(topic)}\.md")
    if not any(brief.fullmatch(f) for f in out(primary, "ls-tree", "-r", "--name-only", ref, "--", "docs/handoff").splitlines()):
        return None
    return primary, local


def dispatched(root, b):
    """"<when> to <host>" when bin/dispatch scheduled this seed's topic for this branch (its
    mark_dispatched), else None: a run on the peer opens its WIP PR only at its first push, so
    seed_started() cannot see it yet, and `seeds --open` would send it a second time."""
    topic = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", b["name"].rsplit("/", 1)[-1])
    common = out(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    try:
        when, host, branch = (Path(common) / "claude" / "dispatched" / topic).read_text().split()[:3]
    except (OSError, ValueError):
        return None
    return f"{ago(int(when))} to {host}" if branch == b["name"] and when.isdigit() else None


def branch_origin(root, b):
    """The scope marker a `seed --from` left on branch B (its docs/handoff/*.review's `origin`), or None —
    so every start path (`seeds --open`, `open`, a retry) carries --origin and opens no tab, not only
    cmd_seed's (S5's landing re-review)."""
    ref = b["name"] if b.get("local") else f"origin/{b['name']}"
    for p in sorted(out(root, "ls-tree", "-r", "--name-only", ref, "--", "docs/handoff").splitlines(), reverse=True):
        if p.endswith(REVIEW_SUFFIX):
            try:
                o = json.loads(out(root, "show", f"{ref}:{p}") or "null")
            except ValueError:
                continue
            o = o.get("origin") if isinstance(o, dict) else None
            if isinstance(o, str) and o.startswith(common.SCOPE_MARK):
                return o
    return None


def dispatch_fresh(root, b, args, origin=None):
    """A fresh session for a branch, started by dispatch — on the build Mac by default, the laptop when it
    does not answer (dispatch's header, Where) — instead of a pre-filled VS Code tab or a Terminal
    window (the owner, 2026-10-13: "pickup that needs to start a new session should also use dispatch").
    Only where dispatch takes the repo and the branch carries its brief (docs/handoff/<date>-<topic>.md,
    what the run reads; a seed always does); False otherwise, and the caller opens the tab or window
    as before. A local branch goes by `--next`, which pushes it and confirms the start from the run's
    log. Explicit --new-tab, --vscode or --terminal keep theirs; a refusal (exit 2) falls back to them.
    ORIGIN: the confidential scope a `seed --from` came out of, passed on as `--origin` (S5); its caller
    opens no tab or window, so a refusal here only says why."""
    derived = origin is None and branch_origin(root, b)
    origin = origin or derived or None
    took = dispatchable(root, b)
    if not took:
        if derived:   # a seed of confidential origin starts by dispatch or not at all: never the tab
            raise Stop(f"{b['name']} came out of a confidential scope and dispatch cannot start it from here "
                       f"(not local, or the repo not dispatch's) — no tab:\n{from_start_line(root, b['name'], origin)}")
        return False
    primary, local = took
    rs = os.environ.get("PICKUP_DISPATCH") or str(BIN / "dispatch")   # tests: a stand-in
    cmd = [rs, b["name"], "--repo", str(primary), "--next"] \
        + (["--note", args.note] if getattr(args, "note", None) else []) \
        + (["--account", args.account] if getattr(args, "account", "auto") not in (None, "auto") else []) \
        + (["--origin", origin] if origin else [])
    if args.dry_run:
        print(f"  would dispatch it: {' '.join(shlex.quote(c) for c in cmd)}")
        return True
    r = run(cmd, timeout=330, env={**os.environ})   # --next blocks up to about 3 min
    said = "\n".join(l for l in (r.stdout + r.stderr).splitlines() if l.strip())
    if r.returncode == 2 and origin:
        print(f"  dispatch refused it (exit 2), so it is not started:\n" + "\n".join(f"    {l}" for l in said.splitlines()))
        if derived:
            raise Stop(f"{b['name']} came out of a confidential scope: no tab\n{from_start_line(root, b['name'], origin)}")
        return False
    if r.returncode and origin:   # the seed is pushed: the line that keeps its --origin, not a bare retry
        raise Stop(f"dispatch failed (exit {r.returncode}) — nothing confirmed started:\n{said}\n{from_start_line(root, b['name'], origin)}")
    if r.returncode == 2:
        # a refusal checked before anything was scheduled (work after the brief, a lock another
        # session holds, the run cap): the tab or window as before, with dispatch's reason (review 2026-10-13)
        print(f"  dispatch refused it (exit 2), so the tab or window instead:\n" + "\n".join(f"    {l}" for l in said.splitlines()))
        return False
    if r.returncode:
        raise Stop(f"dispatch failed (exit {r.returncode}) — nothing confirmed started:\n{said}")
    print(f"  dispatched {b['name']}: a fresh session runs it unattended, not a tab")
    print("\n".join(f"  {l}" for l in said.splitlines()))
    return True


def seed_next(me, args, where, branch, prompt, primary):
    """D1 (2026-10-05, docs/record/run-seed-launch-2026-10-05.md, C): where dispatch takes the repo, the
    next stage is not a tab but an unattended run. The prompt becomes the branch's newest brief
    (docs/handoff/<today>-<topic>.md, the file dispatch reads), committed last, and `dispatch
    --next` pushes, frees this session's lock and starts it — its guards (chain depth, the run
    cap, an unchanged brief, a lock already handed to a tab) are dispatch's, not copied here."""
    top = Path(out(where, "rev-parse", "--show-toplevel"))
    topic = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", branch.rsplit("/", 1)[-1])
    rel = f"docs/handoff/{datetime.date.today():%Y-%m-%d}-{topic}.md"
    dirty = [l for l in out(top, "status", "--porcelain").splitlines() if l[3:] != rel]
    if dirty:
        raise Stop(f"uncommitted changes in {top} ({', '.join(l[3:] for l in dirty[:3])}): commit "
                   f"the stage's work first — the next stage's brief is committed last, and dispatch "
                   f"refuses a dirty worktree")
    rs = os.environ.get("PICKUP_DISPATCH") or str(BIN / "dispatch")   # tests: a stand-in
    cmd = [rs, branch, "--next", "--repo", str(primary)]
    if args.dry_run:
        print(f"seeded (dry run) — would commit the prompt as {rel} on {branch} and run: "
              f"{' '.join(shlex.quote(c) for c in cmd)}")
        return
    (top / rel).parent.mkdir(parents=True, exist_ok=True)
    (top / rel).write_text(f"# {topic} — next stage, handed on by pickup next ({datetime.date.today():%Y-%m-%d}, "
                           f"session {me['id'][:8]})\n\n{prompt}\n")
    git(top, "add", "--", rel)
    if git(top, "diff", "--cached", "--quiet").returncode:   # unchanged (a rerun): nothing to commit
        r = git(top, "commit", "-q", "-m", f"Seed: the next stage of {topic} (pickup next)", "--", rel)
        if r.returncode:
            raise Stop(f"could not commit {rel}: {(r.stderr or r.stdout).strip()}")
    # dispatch --next blocks up to about 3 min: header in the log, then still going 20 s later
    r = run(cmd, timeout=330, env={**os.environ})
    said = "\n".join(l for l in (r.stdout + r.stderr).splitlines() if l.strip())
    if r.returncode:
        raise Stop(f"dispatch refused or failed (exit {r.returncode}) — the brief is committed at "
                   f"{rel}; nothing started:\n{said}")
    print(f"seeded {branch} — the next stage runs unattended (dispatch --next, its brief {rel}); "
          f"this session writes nothing more there")
    print("\n".join(f"  {l}" for l in said.splitlines()))


def cmd_next(me, args):
    if not me["id"]:
        raise Stop("no session id (CLAUDE_CODE_SESSION_ID): `next` runs inside a Claude Code session")
    # `-`: the prompt from stdin, so a quoted heredoc carries code spans and `$` untouched — in
    # double quotes on the command line the shell would run them (review 2026-10-05)
    prompt = (sys.stdin.read() if args.prompt == "-" else args.prompt).strip()
    if not prompt:
        raise Stop("an empty prompt: the next stage needs one")
    found = next(iter(PROJECTS.glob(f"*/{me['id']}.jsonl")), None)
    if found is None:
        raise Stop(f"no transcript for session {me['id'][:8]} under {PROJECTS}")
    ctx = scan(found)["ctx"]  # the context of the call that ran `next`; this_session() already scanned it
    if not ctx:
        raise Stop(f"session {me['id'][:8]}'s transcript has no API call with usage yet: no size to judge by")
    if ctx < STAGE_TOKENS and not args.tab:
        print(f"continue — this session is at {kilo(ctx)} context, under {kilo(STAGE_TOKENS)}: "
              f"go on here with the next step, no tab")
        return
    where = Path.cwd()
    branch = out(where, "symbolic-ref", "--quiet", "--short", "HEAD")
    if not branch.startswith("claude/"):
        raise Stop(f"on {branch or 'a detached HEAD'}, not a claude/* branch: nothing to hand over — "
                   f"a fresh tab needs a branch to /pickup")
    primary = dispatch_takes(where)
    if primary:
        return seed_next(me, args, where, branch, prompt, primary)
    unattended_stop("next")   # a tab needs someone at it; continue and seeded do not
    if me["entry"] != "claude-vscode":
        raise Stop(f"a {me['entry'] or 'plain shell'} session: the pre-filled tab is VS Code's — "
                   f"go on here, or /clear by hand")
    lock_path = Path(out(where, "rev-parse", "--absolute-git-dir")) / "claude" / common.OWNER_FILE
    lock = read_lock(lock_path) or {}
    owner = lock.get("session")
    # Refused only where checkpoint.py would refuse this session a write: another session's
    # fresh, unmarked lock, and that session running. Its own lock, none, an expired or marked
    # one, a crashed owner's: this session marks it — always, because the tab's `open --fresh`
    # keys on the mark and without one refuses this running session as live (review 2026-10-05).
    if (owner and owner != me["id"] and not lock.get("handover")
            and time.time() - lock.get("seen", 0) < OWNER_TTL and owner in live_sessions()):
        raise Stop(f"session {owner[:8]} holds this worktree, not this one: not this session's to hand over")
    again = f"/pickup '{branch}' --note {shlex.quote(prompt)} --fresh"
    notes = []
    # first: a failed `open` leaves no mark behind. No window of this repo identified for sure:
    # nothing starts — the tab waits for the owner's Enter, a Terminal window would not, and the focused
    # window may be another repo's (review 2026-10-14)
    if not start_vscode({"prompt": again}, notes, args.dry_run, me.get("repo") or where, me):
        raise Stop("\n".join(notes + [f"nothing started, the lock left as it is: type `{typed_line(again, me.get('repo') or where)}` in a"
                                      f" {(me.get('repo') or where).name} VS Code window"]))
    if args.dry_run:
        notes.append("would mark this session's lock handed over")
    else:
        common.write_owner(lock_path.parent, me["id"], branch, handover=time.time())
        notes.append("✓ lock marked handed over: the new tab's /pickup takes it")
        if not NO_START:
            notes.append(f"✓ a new VS Code tab is open with `{again}` pre-filled — press Enter there")
    why = "--tab" if ctx < STAGE_TOKENS else f"over {kilo(STAGE_TOKENS)}"
    print(f"tab — this session is at {kilo(ctx)} context ({why}): the next step goes to a fresh tab;"
          f" this session writes nothing more")
    print("\n".join(f"  {n}" for n in notes))


# ---- move: the conversation goes with the branch (docs/record/teleport-design-2026-10-02.md) --------
#
# E2 sends (`--to HOST`), E3 pulls (`--from HOST`). `--prepare` is the send half for a target
# that cannot be reached (the build Mac has no ssh to the laptop, D2): commit, push, a pending marker,
# and the line to type there. `--check ID` reads an arrived fork's first reply for its model and
# effort (R2); `--cancel` drops a pending marker. Every gate stops with exit 3 and a reason
# before anything is written. The source session is never ended (D4): the marker
# (common.MOVED_FILE) makes its writes refused, and its tab is the owner's to close — bar a Terminal window
# once the move is proved: dispatch-rc tidy ends that session and closes its window when it goes
# idle, unless the owner typed into it since (common.HANDOFFS; the owner, 2026-10-08).

QUIET_S = 30  # a subagent or background task that wrote within this is still running
PROOF_S = float(os.environ.get("PICKUP_PROOF_SECONDS") or 60)  # the arrival's registry poll
# Claude Code's per-session scratch root (the session's own scratchpad path names it); tests
# point it into their scratch HOME. The peer scripts read the same variable, so the ssh-peer
# stand-in keeps both ends inside the test.
SCRATCH = os.environ.get("PICKUP_SCRATCH_ROOT") or f"/private/tmp/claude-{os.getuid()}"
SIDE_DIRS = ("subagents", "tool-results")  # beside <id>.jsonl, under <id>/
EFFORTS = ("low", "medium", "high", "xhigh")  # what a settings file can pin; `max` cannot (schema)

# The arrival place on the target: stdin to `python3 -`, argv = repo path under ~/projects,
# branch ("" for a transcript-only move from main), topic, the model pin as JSON. Fetches, makes
# or fast-forwards the worktree, links .env, writes the pin. One JSON object out.
MOVE_ARRIVE = r'''
import json, os, subprocess, sys
from pathlib import Path
rel, branch, topic, pin, sender = sys.argv[1], sys.argv[2], sys.argv[3], json.loads(sys.argv[4]), sys.argv[5]
home = Path.home()
repo = home / "projects" / rel
# resolved: the tar is extracted with -C /, and tar refuses to write through a symlink (/var, /tmp)
out = {"home": os.path.realpath(str(home)),
       "scratch": os.path.realpath(os.environ.get("PICKUP_SCRATCH_ROOT") or "/private/tmp/claude-%d" % os.getuid())}
def git(where, *a):
    r = subprocess.run(["git", "-C", str(where)] + list(a), capture_output=True, text=True, timeout=120)
    return r.returncode, (r.stdout + r.stderr).strip()
def done(**k):
    out.update(k)
    print(json.dumps(out))
    sys.exit(0)
if not (repo / ".git").exists():
    done(error="no %s under %s/projects" % (rel, home))
wt = str(repo)
if branch:
    code, msg = git(repo, "fetch", "-q", "origin", branch)
    if code:
        done(error="git fetch: " + msg[-200:])
    wt = None
    for block in git(repo, "worktree", "list", "--porcelain")[1].split("\n\n"):
        lines = block.splitlines()
        if lines and lines[0].startswith("worktree ") and "branch refs/heads/" + branch in lines:
            wt = lines[0][len("worktree "):]
    out["made"] = not wt
    if not wt:
        base = repo / ".claude" / "worktrees" / topic
        want, n = base, 2
        while want.exists():
            want, n = Path("%s-%d" % (base, n)), n + 1
        local = git(repo, "rev-parse", "--verify", "-q", "refs/heads/" + branch)[0] == 0
        code, msg = git(repo, "worktree", "add", "-q", *([str(want), branch] if local else
                        ["--track", "-b", branch, str(want), "origin/" + branch]))
        if code:
            done(error="git worktree add: " + msg[-200:])
        wt = str(want)
    elif git(wt, "--no-optional-locks", "status", "--porcelain")[1]:
        done(error="its worktree there has uncommitted files: " + wt)
    code, msg = git(wt, "merge", "-q", "--ff-only", "origin/" + branch)
    if code:
        done(error="fast-forward to origin there failed (diverged?): " + msg[-200:])
    # The marker an earlier return leg left here says "moved to <sender>": this trip brings the
    # branch back, so it goes — or the session arriving here has every write refused (review,
    # 2026-10-03). A marker naming any other machine is someone else's move: stop.
    mark = Path(git(wt, "rev-parse", "--absolute-git-dir")[1]) / "claude" / "teleported.json"
    if mark.exists():
        try:
            to = json.loads(mark.read_text()).get("to")
        except Exception:
            to = None
        if to != sender:
            done(error="its worktree there is marked as moved to %s" % to)
        mark.unlink()
        out["cleared"] = True
    env = repo / ".env"
    if os.path.lexists(str(env)) and not os.path.lexists(os.path.join(wt, ".env")):
        os.symlink(str(env), os.path.join(wt, ".env"))
        out["env"] = True
if pin and branch and git(wt, "check-ignore", "-q", ".claude/settings.local.json")[0]:
    out["pin"] = "not pinned: .claude/settings.local.json is not gitignored there"
elif pin and branch:  # never in a primary checkout: it would pin every session there
    f = Path(wt) / ".claude" / "settings.local.json"
    try:
        cur = json.loads(f.read_text()) if f.exists() else {}
    except Exception:
        cur = None  # never overwrite what the owner wrote there with the pin alone
    if not isinstance(cur, dict):
        done(worktree=wt, pin="not pinned: .claude/settings.local.json there is unreadable")
    out["pin"] = "pinned"
    for k, v in pin.items():
        if k == "modelSettings":
            for m, ms in v.items():
                cur.setdefault(k, {}).setdefault(m, {}).update(ms)
        else:
            cur[k] = v
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(cur, indent=2) + "\n")
done(worktree=wt)
'''
# A session's transcript, its side folders and its scratchpad, as one tar on stdout (arcnames
# relative to /), with what it found in a first `__meta__.json` member. argv = the transcript.
MOVE_PACK = r'''
import glob, io, json, os, sys, tarfile
src = sys.argv[1]
scratch = os.environ.get("PICKUP_SCRATCH_ROOT") or "/private/tmp/claude-%d" % os.getuid()
old = os.path.basename(src)[:-len(".jsonl")]
pads = glob.glob(os.path.join(scratch, "*", old, "scratchpad"))
meta = json.dumps({"home": os.path.expanduser("~"), "scratch": scratch, "pad": pads[0] if pads else None}).encode()
with tarfile.open(fileobj=sys.stdout.buffer, mode="w|") as t:
    info = tarfile.TarInfo("__meta__.json")
    info.size = len(meta)
    t.addfile(info, io.BytesIO(meta))
    for p in [src, src[:-len(".jsonl")]] + pads[:1]:
        if os.path.exists(p):
            t.add(p, arcname=p.lstrip("/"))
'''
# Retire the worktree a move leaves on the peer (E3): write the marker, commit what is
# uncommitted through checkpoint.py's own path (sync.py's commit_left does the same for a dead
# session), and push — always: the Stop hook pushes at most every 10 minutes, and once the
# marker is there nothing pushes from that worktree again (review, 2026-10-03). origin must hold
# its tip, or the marker is taken back and nothing is changed but the commit. argv = worktree,
# branch, marker JSON.
MOVE_RETIRE = r'''
import json, subprocess, sys
from pathlib import Path
wt, branch, marker = sys.argv[1], sys.argv[2], json.loads(sys.argv[3])
def git(*a):
    return subprocess.run(["git", "-C", wt] + list(a), capture_output=True, text=True, timeout=120).stdout.strip()
state = Path(git("rev-parse", "--absolute-git-dir")) / "claude"
state.mkdir(exist_ok=True)
mark = state / "teleported.json"
mark.write_text(json.dumps(marker))
out = {"marker": str(mark)}
try:
    # checkpoint.py is wharf's: in the peer's regatta clone (its config dir's `home`; the overlay's
    # hooks/ was the fallback until B14b, 2026-10-23, which deleted its shims)
    import os
    cfg = Path(os.environ.get("REGATTA_CONFIG") or Path.home() / ".config" / "regatta").expanduser()
    try:
        home = os.environ.get("REGATTA_HOME") or (cfg / "home").read_text().split("\n")[0].strip()
    except OSError:
        home = ""
    if home and (Path(home).expanduser() / "modules" / "wharf" / "hooks" / "checkpoint.py").is_file():
        sys.path.insert(0, str(Path(home).expanduser() / "modules" / "wharf" / "hooks"))
    import checkpoint as cp
    top = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent
    try:
        main = json.loads((top / ".claude" / "workflow.json").read_text()).get("main") or "main"
    except Exception:
        main = "main"
    cp.ROOT, cp.MAIN = wt, main
    sid = marker.get("from_session") or "unknown"
    if git("--no-optional-locks", "status", "--porcelain"):
        queue = cp.load_queue(state / "prompts.json")
        note, made = cp.checkpoint(None, [e["prompt"] for e in queue], "wip: moved to %s" % marker.get("to"),
                                   claude_made_it=False, session=sid)
        if made:
            cp.save_queue(state / "prompts.json", [])
        out["commit"] = note
    if git("--no-optional-locks", "status", "--porcelain"):
        out["error"] = out.get("commit") or "files are still uncommitted"
    else:
        out["push"] = cp.publish(state, branch, sid, force=True)
        if git("rev-list", "--count", "@{u}..HEAD") != "0":
            out["error"] = "its tip is not on origin: %s" % (out["push"] or "push failed or no upstream")
except Exception as exc:
    out["error"] = "%s: %s" % (type(exc).__name__, exc)
if out.get("error"):
    mark.unlink()
print(json.dumps(out))
'''
# The arrival's proof (R1): the registry of the machine it runs on names the new session, alive.
# argv = session id, seconds to wait. Polls files, never the session itself.
MOVE_PROOF = r'''
import json, os, sys, time
from pathlib import Path
sid, end = sys.argv[1], time.time() + float(sys.argv[2])
while True:
    for f in (Path.home() / ".claude" / "sessions").glob("*.json"):
        try:
            e = json.loads(f.read_text())
            os.kill(int(e["pid"]), 0)
        except Exception:
            continue
        if e.get("sessionId") == sid:
            print(json.dumps({k: e.get(k) for k in ("pid", "status", "cwd")}))
            sys.exit(0)
    if time.time() >= end:
        print("{}")
        sys.exit(0)
    time.sleep(2)
'''


def ssh_bytes(alias, command, data, timeout=300):
    """ssh with bytes both ways (a tar stream). A timeout is a result, never a traceback."""
    try:
        return subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", alias, command],
                              input=data, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess([], 124, b"", b"timed out")


def peer_json(alias, script, *argv, timeout=120):
    """Run one of the scripts above on a peer; its JSON, or {"error": …}."""
    r = ssh(alias, shlex.join(["python3", "-", *argv]), input=script, timeout=timeout)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {"error": short(r.stderr or r.stdout or f"exit {r.returncode}", 160)}


def iso_ms(t):
    return t.strftime("%Y-%m-%dT%H:%M:%S.") + f"{t.microsecond // 1000:03d}Z"


def turn_start(path):
    """The cutoff for a session that is running this move: 1 ms before the first record of its
    last turn (every user record of a turn carries the turn's promptId), so the /move turn and
    its dangling tool call stay behind (R3). None when the transcript names no turn."""
    first, last = {}, None
    for r in records_of(path):
        pid = r.get("promptId")
        if r.get("type") == "user" and pid and r.get("timestamp"):
            first.setdefault(pid, r["timestamp"])
            last = pid
    if not last:
        return None
    t = datetime.datetime.strptime(first[last], "%Y-%m-%dT%H:%M:%S.%fZ") - datetime.timedelta(milliseconds=1)
    return iso_ms(t)


def records_of(path):
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if isinstance(r, dict):
                yield r


def model_of(path, before=None):
    """(model, effort) of the last real assistant record, at or before `before` when given.
    Claude Code writes `effort` beside `message.model` on every assistant record (design,
    section 1); a `<synthetic>` stand-in names no model."""
    found = (None, None)
    for r in records_of(path):
        m = (r.get("message") or {}).get("model") if r.get("type") == "assistant" else None
        if m and not m.startswith("<") and not (before and (r.get("timestamp") or "") > before):
            found = (m, r.get("effort"))
    return found


def pin_for(model, effort):
    """The settings.local.json keys that start the target on this model and effort. `max` has no
    settings spelling, so it pins the model only and the start goes by Terminal with flags."""
    if not model:
        return {}
    pin = {"model": model}
    if effort in EFFORTS:
        pin.update({"effortLevel": effort, "modelSettings": {model: {"effortLevel": effort}}})
    return pin


def write_pin(wt, pin):
    """None when pinned; else why not — the file is not gitignored (the next checkpoint would
    commit it), or it does not parse (overwriting it would lose what the owner wrote there)."""
    if git(wt, "check-ignore", "-q", ".claude/settings.local.json").returncode:
        return ".claude/settings.local.json is not gitignored here"
    f = Path(wt) / ".claude" / "settings.local.json"
    try:
        cur = json.loads(f.read_text()) if f.exists() else {}
    except (OSError, ValueError):
        cur = None
    if not isinstance(cur, dict):
        return ".claude/settings.local.json here is unreadable"
    for k, v in pin.items():
        if k == "modelSettings":
            for m, ms in v.items():
                cur.setdefault(k, {}).setdefault(m, {}).update(ms)
        else:
            cur[k] = v
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text(json.dumps(cur, indent=2) + "\n")
    return None


def rewrite(text, pairs):
    """Each (theirs, ours) in order, whole path components only — `…/tools` never rewrites
    `…/tools-2`. Most specific first: the later, wider pairs see only what is left."""
    for theirs, ours in pairs:
        if theirs and theirs != ours:
            text = re.sub(re.escape(theirs) + r"(?![\w.-])", lambda m: ours, text)
    return text


def stage_fork(src, side, pad, new_id, cutoff, origin, pairs, relocated, dest_dir, dest_pad, stage):
    """The fork and everything that goes with it, written under `stage` at the paths it will
    have (`stage` + dest_dir, + dest_pad): the transcript cut at `cutoff` with its paths
    rewritten and `relocated` appended, the side folders under the new id — each subagent
    record's sessionId rewritten too, or usage-report's cutoff (keyed by session) misses them
    and their calls count twice — and the scratchpad. Returns (title, records copied)."""
    old_id = src.stem
    with tempfile.TemporaryDirectory() as tmp:
        dest, title, n = fork_transcript(src, Path(tmp), new_id, cutoff=cutoff, origin=origin)
        text = rewrite(dest.read_text(encoding="utf-8"), pairs)
    text += json.dumps({"type": "relocated", "sessionId": new_id, "relocatedCwd": str(relocated)},
                       ensure_ascii=False, separators=(",", ":")) + "\n"
    home = stage / str(dest_dir).lstrip("/")
    home.mkdir(parents=True, exist_ok=True)
    (home / f"{new_id}.jsonl").write_text(text, encoding="utf-8")
    for sub in SIDE_DIRS:
        for f in sorted((side / sub).rglob("*")) if side and (side / sub).is_dir() else []:
            if not f.is_file():
                continue
            to = home / new_id / sub / f.relative_to(side / sub)
            to.parent.mkdir(parents=True, exist_ok=True)
            if f.suffix == ".jsonl":
                first = next((r.get("timestamp") for r in records_of(f) if r.get("timestamp")), None)
                if cutoff and first and first > cutoff:
                    continue  # the /move turn's own subagent: it belongs to the turn left behind
                lines = []
                for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
                    try:
                        r = json.loads(line)
                    except ValueError:
                        lines.append(line)
                        continue
                    if isinstance(r, dict) and r.get("sessionId") == old_id:
                        r["sessionId"] = new_id
                    lines.append(json.dumps(r, ensure_ascii=False, separators=(",", ":")))
                to.write_text(rewrite("\n".join(lines) + "\n", pairs), encoding="utf-8")
            else:
                shutil.copy2(f, to)
    if pad and pad.is_dir():
        shutil.copytree(pad, stage / str(dest_pad).lstrip("/"), dirs_exist_ok=True)
    return title, n


def tar_bytes(stage):
    """`stage` as a tar stream, member names relative to / — extracted on the target with -C /.
    Files only: a directory member would have tar restore the mode and time of /Users or
    /private/tmp, which it may not; the parents it makes for a file get the default mode."""
    import io
    import tarfile
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as t:
        for f in sorted(stage.rglob("*")):
            if f.is_file():
                t.add(f, arcname=str(f.relative_to(stage)), recursive=False)
    return buf.getvalue()


def install(stage):
    """`stage`'s files at their real paths here, file by file, for the same reason."""
    for f in sorted(stage.rglob("*")):
        if f.is_file():
            to = Path("/") / f.relative_to(stage)
            to.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, to)


def own_outputs():
    """(device, inode) of the files this call writes its output to. Claude Code points a Bash
    call's stdout and stderr at `<scratch>/<project>/<sid>/tasks/<id>.output` (lsof, 2026-10-04),
    so the busy gate would see its own caller. Ours first; then every ancestor's below claude (one
    ps, one lsof), for a call piped through `| tail`, where our stdout is a pipe but a shell above
    still holds the file. A real background task's shell is a sibling under claude, never an
    ancestor. If ps or lsof fails, only ours count: a piped call then refuses, the safe side."""
    own = set()
    for fd in (1, 2):
        try:
            st = os.fstat(fd)
            own.add((st.st_dev, st.st_ino))
        except OSError:
            pass
    try:
        procs = {}
        for x in subprocess.run(["ps", "-axo", "pid=,ppid=,comm="], capture_output=True, text=True,
                                timeout=5).stdout.splitlines():
            f = x.split(None, 2)
            if len(f) == 3:
                procs[int(f[0])] = (int(f[1]), os.path.basename(f[2]))
        chain, pid = [], os.getppid()
        while pid > 1 and pid not in chain and procs.get(pid, (0, ""))[1] != "claude":
            chain.append(pid)
            pid = procs.get(pid, (0, ""))[0]
        lines = subprocess.run(["lsof", "-a", "-p", ",".join(map(str, chain)), "-d", "1,2", "-FDi"],
                               capture_output=True, text=True, timeout=5).stdout.splitlines() if chain else []
        dev = None
        for x in lines:  # per file: D<hex device>, then i<inode>
            if x[:1] == "f":
                dev = None
            elif x[:1] == "D":
                dev = int(x[1:], 16)
            elif x[:1] == "i" and dev is not None:
                own.add((dev, int(x[1:])))
                dev = None
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return own


def busy_files(sid):
    """(path, mtime) of files a still-running subagent or background task of session `sid`
    wrote in the last QUIET_S seconds: its result would arrive in a closed tab. The caller's own
    output file is not one (own_outputs). Each file is stat'ed once: a call's output file is
    deleted when the call ends, any time between the glob and here."""
    now, fresh = time.time(), []
    for f in list(Path(SCRATCH).glob(f"*/{sid}/tasks/*")) + list(PROJECTS.glob(f"*/{sid}/subagents/*.jsonl")):
        try:
            st = f.stat()
        except OSError:
            continue
        if abs(now - st.st_mtime) < QUIET_S:  # a clock ahead counts too
            fresh.append((f, st))
    if not fresh:
        return []
    own = own_outputs()
    return [(f, st.st_mtime) for f, st in fresh if (st.st_dev, st.st_ino) not in own]


def under_projects(root):
    """The repo's path under ~/projects — what the peer scripts take (it is the same there)."""
    try:
        return Path(root).resolve().relative_to((Path.home() / "projects").resolve())
    except ValueError:
        raise Stop(f"{root} is not under ~/projects: the other machine finds repos only there", code=3)


def homes(theirs_home, ours_home):
    """The (theirs, ours) pairs for the projects folder and the home itself, in every spelling
    this machine's home has (a resolved and an unresolved one differ under /var → /private/var)."""
    spell = {str(Path(ours_home)), str(Path(ours_home).resolve())}
    return ([(f"{h}/projects", f"{theirs_home}/projects") for h in sorted(spell)]
            + [(h, theirs_home) for h in sorted(spell)])


def on_workflow(root):
    try:
        opted = json.loads((root / ".claude" / "workflow.json").read_text()).get("checkpoint") is True
    except (OSError, ValueError):
        opted = False
    return opted and not (root / ".claude" / "no-workflow").exists()


def state_dir(wt):
    gd = out(wt, "rev-parse", "--absolute-git-dir")
    return Path(gd) / "claude" if gd else None


def host_alias(h):
    """The skill's words (design D1): `home` is the dispatch host, `laptop` the laptop; any other
    name stands for itself (a `home` with no dispatch host and no peer stays `home`, which
    peer_alias then refuses with the peers it knows)."""
    if h == "home":
        return dispatch_host() or h
    return common.LAPTOP if h == "laptop" else h


def peer_alias(host):
    """The ssh alias this machine reads `host` with. None for the laptop seen from the build Mac: no
    ssh runs that way (D2), so a move there is prepared here and finished from the laptop."""
    hosts = dict(PEERS)
    hosts.update({k[len("PICKUP_PEER_"):].lower(): v for k, v in os.environ.items()
                  if k.startswith("PICKUP_PEER_") and v})
    if host == common.host_name():
        raise Stop(f"{host} is this machine — a move goes to the other one", code=3)
    if host not in hosts and host != common.LAPTOP:
        raise Stop(f"no ssh alias for {host} (PEERS: {', '.join(sorted(hosts)) or 'none'})", code=3)
    return hosts.get(host)


def move_source(b, me, wt):
    """(session id, transcript path, cutoff) of the conversation that goes. The session running
    this move, when it worked on the branch: cut before its current turn. Else the newest
    session here on the branch, which must be closed: two processes on one transcript interleave."""
    if me["id"] and (b.get("mine") or any(v["id"] == me["id"] for v in b["sessions"]) or b.get("main_move")):
        hits = list(PROJECTS.glob(f"*/{me['id']}.jsonl"))
        if hits:
            busy = busy_files(me["id"])
            if busy:
                raise Stop(f"a subagent or background task of this session is still running ({busy[0][0].name},"
                           f" written {int(time.time() - busy[0][1])} s ago) — wait or stop it;"
                           f" its result would arrive in a closed tab", code=3)
            return me["id"], hits[0], turn_start(hits[0])
    s = next((v for v in b["sessions"] if Path(v["path"]).is_file()), None)
    if s is None:
        raise Stop(f"no session's transcript for {b['name']} on this machine — nothing to move;"
                   f" /pickup '{b['name']}' --fresh on the other machine brings the branch", code=3)
    if s["live"]:
        raise Stop(f"session {s['id'][:8]} \"{s['title']}\" is running here — type /move in that session,"
                   f" not this one", code=3)
    return s["id"], Path(s["path"]), None


def save_and_push(root, main, b, wt, sid, host, notes, dry):
    """Commit what the session left (checkpoint.py's own commit, queued prompts and all) and push
    the branch; stop if either does not go through. The session's own worktree, under its own lock."""
    import checkpoint as cp  # noqa: E402 — lazily, as sync.py does
    state = state_dir(wt)
    dirty = [l for l in out(wt, "--no-optional-locks", "status", "--porcelain").splitlines() if l.strip()]
    if dry:
        notes.append(f"would commit {len(dirty)} file(s) and push {b['name']}" if dirty else f"would push {b['name']}")
        return
    cp.ROOT, cp.MAIN = str(wt), main
    state.mkdir(parents=True, exist_ok=True)  # publish() keeps its push stamp there
    if dirty:
        queue = cp.load_queue(state / "prompts.json")
        try:
            note, made = cp.checkpoint(None, [e["prompt"] for e in queue], f"wip: moved to {host}",
                                       claude_made_it=False, session=sid)
        except subprocess.CalledProcessError as exc:
            git(wt, "reset", "-q")  # checkpoint staged everything first
            raise Stop(f"not moved: the commit failed: {short(exc.stderr or str(exc), 160)}", code=3)
        if made:
            cp.save_queue(state / "prompts.json", [])
        if out(wt, "--no-optional-locks", "status", "--porcelain"):
            raise Stop(f"not moved: {note or 'the uncommitted files did not commit'}", code=3)
        notes.append(note)
    pushed = cp.publish(state, b["name"], sid, force=True)
    if out(wt, "rev-list", "--count", "@{u}..HEAD") != "0":
        raise Stop(f"not moved: {b['name']} is not on origin — {pushed or 'the push did not go through'}", code=3)
    b["dirty"] = 0
    notes.append(f"✓ {b['name']} on origin at {out(wt, 'rev-parse', '--short', 'HEAD')}")


def mark(wt, m, notes, dry):
    if dry:
        notes.append(f"would mark this worktree: {common.moved_line(m)}")
        return
    state = state_dir(wt)
    state.mkdir(parents=True, exist_ok=True)
    (state / common.MOVED_FILE).write_text(json.dumps(m))
    notes.append(f"✓ marked here: {common.moved_line(m)} — writes in this worktree are refused from now on")


def cmd_move(data, b, me, args):
    root = data["root"]
    if not on_workflow(root):
        raise Stop(f"{root.name} is not on the worktree workflow — nothing there reads the marker,"
                   f" so a move could leave two writers; /pickup … --transcript copies it instead", code=3)
    if args.cancel:
        return move_cancel(b)
    if args.from_host == CLOUD:
        return move_from_cloud(data, b, me, args)
    if args.from_host:
        return move_from(data, b, me, args)
    if args.to == CLOUD:
        return move_to_cloud(data, b, me, args)
    return move_to(data, b, me, args)


def move_cancel(b):
    """A pending marker, or a cloud one: the cloud leg runs in a Terminal tab this script never
    watches, so when /teleport did not take it there, this is the way back to writing here."""
    m = b.get("moved")
    if not m or not (m.get("pending") or m.get("to") == CLOUD):
        raise Stop(f"{b['name']} has no pending move to cancel" + (f" ({moved_text(m)})" if m else ""), code=3)
    if m.get("to") == CLOUD:
        # Not once the cloud has the work: a commit it signed since the marker means /teleport arrived,
        # and writing here again would diverge from it.
        wt = Path(b["worktree"])
        git(wt, "fetch", "-q", "origin", b["name"])
        since = f"--since=@{int(m.get('at') or 0)}"
        signed = [s for s in (cloud_link(x) for x in out(wt, "log", f"origin/{b['name']}", since,
                                                          "--format=%B%x00").split("\0")) if s]
        if signed:
            raise Stop(f"the cloud session {signed[0]} has pushed to {b['name']} since the move — it arrived;"
                       f" /move --from-cloud '{b['topic']}' brings it back", code=3)
    (state_dir(b["worktree"]) / common.MOVED_FILE).unlink()
    print(f"{b['name']}: the {'pending ' if m.get('pending') else ''}move to {m.get('to')} is cancelled"
          f" — this worktree takes writes again")


def move_to(data, b, me, args):
    """E2: the send direction."""
    root, host, notes, dry = data["root"], args.to, [], args.dry_run
    alias = peer_alias(host)
    rel_repo = str(under_projects(root))
    if alias is None:
        args.prepare = True
    main = b.get("main_move") and data["main"]
    m = b.get("moved")
    if m and not (m.get("pending") and m.get("to") == host):
        raise Stop(f"{b['name']} has already gone: {moved_text(m)}", code=3)
    wt = Path(b["worktree"]) if b.get("worktree") and not b.get("wt_missing") else None
    if not main and wt is None:
        raise Stop(f"{b['name']} has no worktree here — nothing of it runs here to move;"
                   f" /move --from-… on the machine that has it", code=3)
    sid, src, cutoff = move_source(b, me, wt)
    model, effort = model_of(src, cutoff)
    print(f"{b['name']} → move to {host}: session {sid[:8]}, cut "
          + (f"before its current turn ({cutoff})" if cutoff else "at its end")
          + (f", {model} / {effort or '?'}" if model else ""))
    peer = None if args.prepare else probe_peer(Path(rel_repo), {**b, "elsewhere": b.get("elsewhere") or []}, host, alias)
    if peer and peer.get("error"):
        notes.append(f"⚠ {host} does not answer ({peer['error']}) — preparing the move instead")
        peer = None
    if peer and not main:
        if peer["alive"]:
            v = peer["alive"][0]
            raise Stop(f"session {(v.get('sessionId') or '?')[:8]} runs on {b['name']} on {host}"
                       f" ({v.get('status') or '?'}) — two writers; end it there first", code=3)
        if peer["dirty"]:
            raise Stop(f"{host}'s worktree for {b['name']} has {len(peer['dirty'])} uncommitted file(s)"
                       f" ({', '.join(peer['dirty'][:3])}) — /move --from-{host} brings them here first", code=3)
    if not main:
        save_and_push(root, data["main"], b, wt, sid, host, notes, dry)
    elif out(root, "--no-optional-locks", "status", "--porcelain"):
        raise Stop(f"{root.name}'s main has uncommitted files — {OWNER}'s own edits; they stay, and so does this"
                   f" session, until they are committed or set aside", code=3)
    if peer is None:  # --prepare: everything the target needs is on origin; it pulls the rest
        if main:
            raise Stop(f"a session on {data['main']} moves only while {host} answers — nothing to prepare", code=3)
        mark(wt, {"to": host, "session": None, "from_session": sid, "at": int(time.time()),
                  "branch": b["name"], "pending": True}, notes, dry)
        print("\n".join(f"  {n}" for n in notes))
        line = (f"/move --from-{common.host_name()} '{b['topic']}'" if host == common.LAPTOP
                else f"/move --to-{host}")
        print(f"  → on {host if host == common.LAPTOP else 'this machine, once ' + host + ' answers'}: {line}")
        return
    if dry:
        notes.append(f"would make the worktree on {host}, carry the conversation and open it there")
        print("\n".join(f"  {n}" for n in notes))
        return
    arrival = peer_json(alias, MOVE_ARRIVE, rel_repo, "" if main else b["name"], b["topic"],
                     json.dumps(pin_for(model, effort)), common.host_name())
    if arrival.get("error"):
        raise Stop(f"not moved: {host}: {arrival['error']}" + (" — the branch is on origin; nothing else changed"
                                                              if not main else ""), code=3)
    rwt, rhome, rscratch = arrival["worktree"], arrival["home"], arrival["scratch"]
    notes.append(f"✓ {host}: worktree {rwt}" + (" made" if arrival.get("made") else " caught up")
                 + (", .env linked" if arrival.get("env") else "")
                 + (f", {arrival['pin']}" + (f" {model} / {effort}" if arrival["pin"] == "pinned" else "") if arrival.get("pin") else "")
                 + (", the marker of its last trip back cleared" if arrival.get("cleared") else ""))
    new_id, rslug = str(uuid.uuid4()), slug(rwt)
    side = src.with_suffix("")
    pads = sorted(Path(SCRATCH).glob(f"*/{sid}/scratchpad"))
    pad = pads[0] if pads else None
    pairs = ([(str(wt), rwt)] if wt else [(str(root), rwt)]) + [
        (str(side), f"{rhome}/.claude/projects/{rslug}/{new_id}"),
        (str(pad.parent) if pad else "", f"{rscratch}/{rslug}/{new_id}")] + homes(rhome, Path.home())
    with tempfile.TemporaryDirectory() as tmp:
        title, n = stage_fork(src, side, pad, new_id, cutoff, common.host_name(), pairs, rwt,
                              f"{rhome}/.claude/projects/{rslug}", f"{rscratch}/{rslug}/{new_id}/scratchpad",
                              Path(tmp))
        r = ssh_bytes(alias, "tar -xf - -C /", tar_bytes(Path(tmp)))
    if r.returncode:
        raise Stop(f"not moved: the conversation did not reach {host}: {short(r.stderr.decode(errors='replace'), 160)}"
                   f" — the branch and the worktree there are ready; nothing here is marked", code=3)
    notes.append(f"✓ conversation {sid[:8]} → {host} as {new_id[:8]} ({n} records"
                 + (", side folders" if side.is_dir() else "") + (", scratchpad" if pad else "") + ")")
    # Marked now, not after the start: from here the conversation is there, and the start and
    # its proof can take a minute and a half — a run killed in it must not leave this tab writing.
    if not main:
        mark(wt, {"to": host, "session": new_id, "from_session": sid, "at": int(time.time()),
                  "branch": b["name"], "pending": False}, notes, dry)
    name = f"{root.name}: {b['topic']}"
    prompt = orientation(b, Path(rwt), {"on_branch": True, "moved_on": None}, args.note,
                         how=f"Moved from {common.host_name()} with /move")
    terminal = (f"cd {shlex.quote(rwt)} && claude --resume {new_id}" + (f" --model {model}" if model else "")
                + (f" --effort {effort}" if effort else "") + f" --name {shlex.quote(name)}")
    started = start_remote(alias, rwt, new_id, prompt, effort, title or name, notes)
    seen = proof(alias, new_id) if started else None
    if seen:
        notes.append(f"✓ running on {host}: pid {seen.get('pid')}, {seen.get('status') or '?'}, cwd {seen.get('cwd')}")
        # proved, so the session left here is done: dispatch-rc tidy closes its Terminal window
        # once it goes idle (common.HANDOFFS). Not proved: it stays, its line still to run.
        common.handed_off(sid, host, "move", new_id)
        run([str(BIN / "dispatch-rc"), "tidy-soon"])   # about a minute after this turn, not the 10-minute pass
    else:
        notes.append(("⚠ not seen in " + f"{int(PROOF_S)} s" if started else "not started")
                     + f" — on {host}: {terminal}")
    ctx = scan(src).get("ctx") or 0
    if ctx:
        notes.append(f"ℹ its first call on {host} writes ~{kilo(ctx)} once: prompt caches are per machine")
    print("\n".join(f"  {n}" for n in notes))
    print(f"  → moved to {host} as {new_id} — " + ("proved running there" if seen else "not proved: start it with the line above"))


# The start on the target, as `open` makes it here: VS Code on the worktree, the new
# transcript announced (the sidebar re-reads its list only for a live session it does not
# know — fork_claude_session.announce, shipped as source), then the session's link.
# argv = worktree, link, session id, title.
MOVE_START = r'''
import json, os, subprocess, sys, time
from pathlib import Path
wt, url, sid, title = sys.argv[1:5]
subprocess.run(["open", "-a", "Visual Studio Code", wt], check=True, timeout=30)
time.sleep(3)
announce(Path(wt), sid, title)
subprocess.run(["open", url], check=True, timeout=30)
'''


def start_remote(alias, rwt, new_id, prompt, effort, title, notes):
    """Open the worktree in VS Code on the peer, then the session in it (today's proven step:
    the hand-made fork of 2026-10-02 loaded this way). `max` effort has no settings spelling,
    so it is the Terminal line instead. True when a start was attempted."""
    url = f"{SCHEME}://anthropic.claude-code/open?" + urllib.parse.urlencode(
        {"session": new_id, "prompt": prompt}, quote_via=urllib.parse.quote)
    if effort == "max":
        notes.append("ℹ effort max cannot be pinned in settings: start it by the Terminal line below")
        return False
    if NO_START:
        notes.append(f"not opened (PICKUP_NO_START): {url}")
        return False
    script = "\n".join(["import json, os, sys, time", "from pathlib import Path",
                        inspect.getsource(announce), MOVE_START])
    r = ssh(alias, shlex.join(["python3", "-", rwt, url, new_id, title]), input=script, timeout=60)
    if r.returncode:
        notes.append(f"⚠ could not open VS Code there: {short(r.stderr, 120)}")
        return False
    return True


def proof(alias, new_id):
    """The new session alive in the registry, read where it runs (alias None: here)."""
    if alias is None:
        r = run([sys.executable, "-", new_id, str(PROOF_S)], input=MOVE_PROOF, timeout=PROOF_S + 30)
    else:
        r = ssh(alias, shlex.join(["python3", "-", new_id, str(PROOF_S)]), input=MOVE_PROOF, timeout=PROOF_S + 30)
    try:
        return json.loads(r.stdout.strip().splitlines()[-1]) or None
    except (ValueError, IndexError):
        return None


def move_from(data, b, me, args):
    """E3: the pull direction — `open --transcript`'s carry with the gates. It arrives in this
    machine's worktree, as `--to` arrives in the target's: that is where the model pin is read
    when the session starts (review, 2026-10-03), so VS Code opens a window on it."""
    import io
    import tarfile
    root, host, notes, dry = data["root"], args.from_host, [], args.dry_run
    alias = peer_alias(host)
    if alias is None:
        raise Stop(f"no path from here to {host} (ssh runs {host} → here only): on {host} type"
                   f" `/move --to-home '{b['topic']}'`; without {host}, `/pickup '{b['name']}' --fresh` here"
                   f" brings the branch, not the conversation", code=3)
    p = probe_peer(under_projects(root), b, host, alias)
    b["peer"] = p
    if p.get("error"):
        raise Stop(f"{host} does not answer: {p['error']}", code=3)
    if p.get("moved") and not p["moved"].get("pending"):
        raise Stop(f"{b['name']} has already left {host}: {moved_text(p['moved'])}", code=3)
    busy = [s for s in p["alive"] if s.get("status") == "busy"]
    if busy:
        raise Stop(f"session {(busy[0].get('sessionId') or '?')[:8]} on {host} is mid-turn on {b['name']}"
                   f" — try again when it is idle", code=3)
    src_remote = live_transcript(p, alias) or (peer_hit(b) or (None, None))[1]
    if not src_remote:
        raise Stop(f"no transcript of {b['name']}'s session on {host} — /pickup '{b['name']}' --fresh"
                   f" brings the branch without it", code=3)
    print(f"{b['name']} → move from {host}: {Path(src_remote).name}")
    here = b.get("worktree") and not b.get("wt_missing")
    if here and b["dirty"]:
        raise Stop(f"this machine's worktree for {b['name']} has {b['dirty']} uncommitted file(s) — look at"
                   f" them first; the move would mix two machines' work", code=3)
    if b.get("local") and b.get("remote") and git(root, "merge-base", "--is-ancestor", b["name"],
                                                  f"origin/{b['name']}").returncode:
        raise Stop(f"{b['name']} here has commits origin lacks — the two machines diverged;"
                   f" push or reconcile here first", code=3)
    if dry:
        notes.append(f"would mark {host}'s worktree, commit and push what it holds, carry {src_remote} here and open it")
        print("\n".join(f"  {n}" for n in notes))
        return
    new_id, peer_mark = str(uuid.uuid4()), None
    try:
        with tempfile.TemporaryDirectory() as tmp:
            r = ssh_bytes(alias, shlex.join(["python3", "-c", MOVE_PACK, src_remote]), b"", timeout=300)
            if r.returncode or not r.stdout:
                raise Stop(f"could not read {host}:{src_remote}: {short(r.stderr.decode(errors='replace'), 160)}", code=3)
            with tarfile.open(fileobj=io.BytesIO(r.stdout), mode="r:") as t:
                t.extractall(tmp)
            meta = json.loads(Path(tmp, "__meta__.json").read_text())
            src = Path(tmp) / src_remote.lstrip("/")
            # an archived copy is named <date>-<id8>.jsonl: the id its records carry names it
            old_id = next((rr.get("sessionId") for rr in records_of(src) if rr.get("sessionId")), None) or src.stem
            if src.stem != old_id:
                src = src.rename(src.with_name(f"{old_id}.jsonl"))
            side = Path(tmp) / src_remote.lstrip("/")[:-len(".jsonl")]
            pad = Path(tmp) / meta["pad"].lstrip("/") if meta.get("pad") else None
            if p.get("worktree"):
                m = {"to": common.host_name(), "session": new_id, "from_session": old_id, "at": int(time.time()),
                     "branch": b["name"], "pending": False}
                got = peer_json(alias, MOVE_RETIRE, p["worktree"], b["name"], json.dumps(m))
                if got.get("error"):
                    raise Stop(f"not moved: {host}: {got['error']} — its worktree is not marked", code=3)
                peer_mark = got.get("marker")
                notes.append(f"✓ {host}: its worktree is marked {common.moved_line(m)}, its tip on origin"
                             + (f"; {got['commit']}" if got.get("commit") else ""))
                git(root, "fetch", "-q", "origin", b["name"])
                b["remote"] = True
            wt = ensure_worktree(root, b, None, notes, False)
            fast_forward(wt, b, notes)
            rhome = meta.get("home") or p.get("home")
            pairs = ([(p["worktree"], str(wt))] if p.get("worktree") else []) + [
                (f"{Path(src_remote).parent}/{old_id}", str(PROJECTS / slug(wt) / new_id)),
                (str(Path(meta["pad"]).parent) if meta.get("pad") else "", f"{SCRATCH}/{slug(wt)}/{new_id}"),
                (rhome + "/projects", str(Path.home() / "projects")), (rhome, str(Path.home()))]
            title, n = stage_fork(src, side, pad, new_id, None, host, pairs, wt, PROJECTS / slug(wt),
                                  f"{SCRATCH}/{slug(wt)}/{new_id}/scratchpad", Path(tmp, "stage"))
            model, effort = model_of(src)
            sides = side.is_dir()
            install(Path(tmp, "stage"))
    except BaseException:
        if peer_mark:  # nothing arrived here: the peer's worktree takes writes again
            ssh(alias, shlex.join(["rm", "-f", peer_mark]))
            print(f"  ↺ {host}'s marker taken back; what it committed stays on origin", file=sys.stderr)
        raise
    notes.append(f"✓ {host}'s session {old_id[:8]} copied here as {new_id[:8]} ({n} records"
                 + (", side folders" if sides else "") + (", scratchpad" if pad else "")
                 + "), paths rewritten to this machine's")
    pin = pin_for(model, effort)
    if pin:
        why = write_pin(wt, pin)
        notes.append(f"⚠ not pinned: {why} — pick the model by hand" if why else
                     f"✓ pinned {model} / {effort or '?'} in {rel(wt, root)}/.claude/settings.local.json")
    m_here = b.get("moved")
    if m_here:
        (state_dir(wt) / common.MOVED_FILE).unlink(missing_ok=True)
        notes.append(f"✓ this worktree's marker cleared ({common.moved_line(m_here)}): it takes writes again")
    prompt = orientation(b, wt, {"on_branch": True, "moved_on": None}, args.note,
                         how=f"Moved from {host} with /move")
    name = f"{root.name}: {b['topic']}"
    terminal = (f"cd {shlex.quote(str(wt))} && claude --resume {new_id}" + (f" --model {model}" if model else "")
                + (f" --effort {effort}" if effort else "") + f" --name {shlex.quote(name)}")
    started = False
    if effort == "max":
        notes.append("ℹ effort max cannot be pinned in settings: start it by the Terminal line below")
    elif NO_START:
        send_link({"session": new_id, "prompt": prompt}, None, notes, False)
    else:
        run(["open", "-a", "Visual Studio Code", str(wt)])
        window = poll_window(wt)  # the worktree's own window, never whichever has focus
        if window:
            announce(wt, new_id, title or name)  # the sidebar reads a new transcript only when told
            send_link({"session": new_id, "prompt": prompt}, window, notes, False)
            started = True
        else:
            notes.append(f"⚠ no VS Code window id for {wt} in {WINDOW_WAIT} s: no link sent")
    seen = proof(None, new_id) if started else None
    notes.append(f"✓ running here: pid {seen.get('pid')}" if seen else
                 ("⚠ not seen in " + f"{int(PROOF_S)} s" if started else "not started") + f" — {terminal}")
    print("\n".join(f"  {n}" for n in notes))
    print("  prompt:")
    print("\n".join("    " + l for l in prompt.splitlines()))
    print(f"  → moved from {host} as {new_id} — " + ("proved running here" if seen else "not proved: start it with the line above"))
    if p["alive"]:
        print("  Do this now — the session left on " + host + " (an agent never ends one, D4):")
        for v in p["alive"]:
            sid8 = (v.get("sessionId") or "?")[:8]
            print(f"    ssh {alias} {peer_tool('rc-hosts')} --end {sid8}"
                  if v.get("entrypoint") == "sdk-cli" else f"    close session {sid8} \"{v.get('name') or '?'}\" on {host}")


def fast_forward(wt, b, notes):
    """The worktree up to origin's tip of its branch, which the other side just pushed."""
    ahead = out(wt, "rev-list", "--count", f"HEAD..origin/{b['name']}")
    if ahead not in ("", "0"):
        r = git(wt, "merge", "-q", "--ff-only", f"origin/{b['name']}")
        if r.returncode:
            raise Stop(f"not moved: the fast-forward here failed: {short(r.stderr, 120)}", code=3)
        b["caught_up"] = int(ahead)
        notes.append(f"✓ fast-forwarded {ahead} commit(s) from origin")


# ---- the cloud (teleport design E6) ------------------------------------------------------------
# Claude Code's own `/teleport` and `--teleport` do the crossing; `move` does what surrounds it
# here: the gates, the commit and push, the marker, and the session's id read from git. Two
# first-run checks stay open until the owner's first real run, both interactive by nature (named in
# skills/move/SKILL.md): whether `/teleport` as a reopened fork's first prompt pushes the session
# up (the binary says "Send this session to the cloud"; the cloud-sessions page says the CLI
# cannot), and whether `claude -p --teleport ID` writes the local copy headless.

CLOUD = "cloud"
CLAUDE = os.environ.get("PICKUP_CLAUDE") or shutil.which("claude") or "claude"  # tests: a stub
# A cloud session signs every commit with its link; a REF may be that link or the bare id.
CLOUD_LINK = re.compile(r"claude\.ai/code/(session_[A-Za-z0-9]{8,})")
CLOUD_REF = re.compile(r"(?:https?://)?(?:claude\.ai/code/)?(session_[A-Za-z0-9]{8,})/?")
TRAILER = re.compile(r"^Claude-Session: ", re.M)
TELEPORT_S = 420  # the headless teleport's cap; with PROOF_S it stays inside the skill's 600 s Bash timeout


def cloud_link(msg):
    """The session a commit was signed by, or None. A checkpoint commit (its `Claude-Session:`
    trailer) only quotes a prompt that may hold someone's link — never a cloud session's own."""
    if TRAILER.search(msg):
        return None
    m = CLOUD_LINK.search(msg)
    return m.group(1) if m else None


def cloud_brief(b, root, note):
    """The fallback's first message: a cloud session started with `claude --cloud` gets the
    branch, not the conversation, so it is told where the work is and to read it first."""
    return (f"Continue the work on branch {b['name']} of {root.name}: check it out, read its last commits"
            f" and the docs they touch, say in three lines where it stands, then carry on."
            + (f" {note}" if note else ""))


def move_to_cloud(data, b, me, args):
    """E6, the send leg: the gates, the commit and push, the marker (`to: cloud`, no session id
    — the cloud names it), then a Terminal tab continuing a FORK of this session with `/teleport`
    as its first prompt: a skill cannot type a built-in, a fresh process can (design E6 (b)),
    and the running tab is never reopened twice. The owner answers /teleport's own question there."""
    root, notes, dry = data["root"], [], args.dry_run
    main = b.get("main_move")
    m = b.get("moved")
    if m:
        raise Stop(f"{b['name']} has already gone: {moved_text(m)}"
                   + (" — /move --cancel first" if m.get("pending") else
                      f" — /move --from-cloud '{b['topic']}' brings it back, or /move --cancel if it never got there"
                      if m.get("to") == CLOUD else ""), code=3)
    wt = Path(b["worktree"]) if b.get("worktree") and not b.get("wt_missing") else None
    if not main and wt is None:
        raise Stop(f"{b['name']} has no worktree here — nothing of it runs here to move", code=3)
    sid, src, cutoff = move_source(b, me, wt)
    model, effort = model_of(src, cutoff)
    print(f"{b['name']} → move to the cloud: session {sid[:8]}" + (f", {model} / {effort or '?'}" if model else ""))
    if main:
        if out(root, "--no-optional-locks", "status", "--porcelain"):
            raise Stop(f"{root.name}'s main has uncommitted files — {OWNER}'s own edits; a cloud session starts"
                       f" from origin and would not see them", code=3)
        if out(root, "rev-list", "--count", f"origin/{data['main']}..{data['main']}") not in ("", "0"):
            raise Stop(f"{root.name}'s {data['main']} has commits origin lacks — a cloud session starts from origin"
                       f" and would not see them; they launch through a PR first", code=3)
    else:
        save_and_push(root, data["main"], b, wt, sid, CLOUD, notes, dry)
    # The fork is made here, as `--to HOST` makes it there: cut before the running /move turn (a
    # `--resume --fork-session` would carry that turn and its dangling tool call, R3), relocated
    # into the worktree so /teleport runs on the pushed branch, never on the root's main.
    cwd = wt or root
    name = f"{root.name}: {b['topic']}"
    new_id = str(uuid.uuid4())
    argv = [CLAUDE, "--resume", new_id] + (["--model", model] if model else []) \
        + (["--effort", effort] if effort else []) + ["--name", name, "/teleport"]
    fallback = f"cd {shlex.quote(str(cwd))} && claude --cloud {shlex.quote(cloud_brief(b, root, args.note))}"
    if dry:
        notes.append(f"would mark this worktree moved to the cloud, fork {sid[:8]} and run in {cwd}: "
                     f"{shlex.join(argv[1:])}")
        print("\n".join(f"  {n}" for n in notes))
        return
    if not main:
        mark(wt, {"to": CLOUD, "session": None, "from_session": sid, "at": int(time.time()),
                  "branch": b["name"], "pending": False}, notes, dry)
    try:
        side, dslug = src.with_suffix(""), slug(str(cwd))
        pads = sorted(Path(SCRATCH).glob(f"*/{sid}/scratchpad"))
        pad = pads[0] if pads else None
        pairs = [(str(side), str(PROJECTS / dslug / new_id)),
                 (str(pad.parent) if pad else "", f"{SCRATCH}/{dslug}/{new_id}")]
        with tempfile.TemporaryDirectory() as tmp:
            _, n = stage_fork(src, side, pad, new_id, cutoff, common.host_name(), pairs, cwd, PROJECTS / dslug,
                              f"{SCRATCH}/{dslug}/{new_id}/scratchpad", Path(tmp))
            install(Path(tmp))
        notes.append(f"✓ forked {sid[:8]} as {new_id[:8]} ({n} records"
                     + (", cut before its current turn" if cutoff else "") + ")")
        if NO_START:
            notes.append(f"not opened (PICKUP_NO_START) in {cwd}: claude {shlex.join(argv[1:])}")
        else:
            open_in_terminal(Path(cwd), argv)
            notes.append(f"→ a new Terminal window continues the fork {new_id[:8]} with /teleport — answer it there")
    except BaseException as exc:
        # Nothing has crossed yet: the marker goes, so this tab is not left unable to write (review, 2026-10-03).
        if not main:
            (state_dir(wt) / common.MOVED_FILE).unlink(missing_ok=True)
            print("  ↺ the marker here taken back; the branch stays pushed", file=sys.stderr)
        if isinstance(exc, Exception):
            raise Stop(f"not moved: {short(getattr(exc, 'stderr', None) or str(exc), 160)} — start it by hand: {fallback}",
                       code=3)
        raise
    notes.append(f"if /teleport there only offers to pull: {fallback}"
                 + (" — a new cloud session from the pushed branch, without the conversation" if not main else ""))
    if not main:
        notes.append(f"if neither reaches the cloud: /move --cancel here takes the marker back")
    print("\n".join(f"  {n}" for n in notes))
    print(f"  → to the cloud from a new Terminal window — this session's work is on origin" if not main
          else f"  → to the cloud from a new Terminal window")


def cloud_ref(root, ref, branches):
    """(cloud session id, branch) for a REF that is a claude.ai/code link, a bare session_… id or
    anything `resolve` takes. The id is read from git — the newest commit on the branch (origin's
    copy first: that is where the cloud pushes) whose message carries the session's link; no
    login token is read. A bare id finds its branch the same way, over every open one."""
    m = CLOUD_REF.fullmatch(ref.strip())
    if m:
        sid = m.group(1)
        log = out(root, "log", "--branches", "--remotes=origin", "-F", f"--grep=claude.ai/code/{sid}",
                  "--format=%H%x00%B%x01")
        hit = next((h for h, _, body in (e.strip("\n").partition("\0") for e in log.split("\x01") if e.strip())
                    if cloud_link(body) == sid), None)
        names = {n[len("origin/"):] if n.startswith("origin/") else n
                 for n in out(root, "branch", "-a", "--contains", hit, "--format=%(refname:short)").split()} if hit else set()
        found = [x for x in branches if x["status"] == "open" and x["name"] in names]
        if not found:
            raise Stop(f"no open claude/* branch here carries {sid} in a commit — the cloud session has not pushed"
                       f" yet, or `git fetch` first; `claude --teleport {sid}` in a clean checkout brings it by hand",
                       code=3)
        if len(found) > 1:
            raise Stop(f"{sid} is on {len(found)} open branches ({', '.join(x['name'] for x in found)})"
                       f" — name the one: /move --from-cloud '<branch>'", code=3)
        return sid, found[0]
    b = resolve(ref, branches)
    tip = f"origin/{b['name']}" if b.get("remote") else b["name"]
    # Moved to the cloud from here: only a session that pushed since then is the one that went —
    # an older link on the branch is a previous trip's (review, 2026-10-03).
    m = b.get("moved") or {}
    since = [f"--since=@{int(m.get('at') or 0)}"] if m.get("to") == CLOUD else []
    for msg in out(root, "log", "-n", "200", *since, "--format=%B%x00", tip).split("\0"):
        sid = cloud_link(msg)
        if sid:
            return sid, b
    if since:
        raise Stop(f"no cloud session has pushed to {b['name']} since it moved there — pass its id or"
                   f" claude.ai/code link: /move --from-cloud <link>", code=3)
    raise Stop(f"no commit on {b['name']} carries a claude.ai/code/session_… link — no cloud session pushed to it;"
               f" a session on another Mac is /move --from-{a_peer()}", code=3)


def move_from_cloud(data, b, me, args):
    """E6, the pull leg: the id from the branch's commits, the worktree here caught up, then
    `claude -p --teleport ID` headless (first-run check 2) — its JSON names the local copy, whose
    model is pinned and which opens in a VS Code window on the worktree, as `--from` does. If no
    copy appears, a Terminal window runs `claude --teleport ID` and the conversation goes on
    there. The cloud session itself stays on claude.ai: archiving it is the owner's (D4)."""
    root, notes, dry = data["root"], [], args.dry_run
    sid = b["cloud"]
    print(f"{b['name']} → move from the cloud: {sid}")
    m_here = b.get("moved")
    if m_here and m_here.get("to") != CLOUD:
        raise Stop(f"{b['name']} here is marked {moved_text(m_here)} — its work goes on there, not in the cloud", code=3)
    live = [s for s in b["sessions"] if s.get("live") and s["id"] != me.get("id")]
    if live:
        raise Stop(f"session {live[0]['id'][:8]} \"{live[0]['title']}\" is open on {b['name']} here — close it"
                   f" first: once the marker goes it would write beside the session coming back", code=3)
    if b.get("worktree") and not b.get("wt_missing") and b["dirty"]:
        raise Stop(f"this machine's worktree for {b['name']} has {b['dirty']} uncommitted file(s) — look at"
                   f" them first; the move would mix the cloud's work with them", code=3)
    if b.get("local") and b.get("remote") and git(root, "merge-base", "--is-ancestor", b["name"],
                                                  f"origin/{b['name']}").returncode:
        raise Stop(f"{b['name']} here has commits origin lacks — this machine and the cloud diverged;"
                   f" push or reconcile here first", code=3)
    # No hooks, no tools, no MCP, as bin/sparks' headless calls: the one turn only has to make
    # the copy, never act on a conversation that may end in an instruction (review, 2026-10-03).
    headless = [CLAUDE, "-p", "--teleport", sid, "--settings", '{"disableAllHooks": true}', "--strict-mcp-config",
                "--tools", "", "--output-format", "json", "Say ready, nothing else."]
    if dry:
        notes.append(f"would catch up the worktree here and run: claude {shlex.join(headless[1:])}")
        print("\n".join(f"  {n}" for n in notes))
        return
    wt = ensure_worktree(root, b, None, notes, False)
    fast_forward(wt, b, notes)
    if m_here:
        (state_dir(wt) / common.MOVED_FILE).unlink(missing_ok=True)
        notes.append(f"✓ this worktree's marker cleared ({common.moved_line(m_here)}): it takes writes again")
    new_id, copy = None, None
    if NO_START and not os.environ.get("PICKUP_CLAUDE"):
        notes.append(f"not run (PICKUP_NO_START): claude {shlex.join(headless[1:])}")
    else:
        # A child of this session: what Claude Code reads from the environment to tie a process to
        # its parent (entrypoint, session id, child-session flag) is dropped, so the copy is its own.
        env = {k: v for k, v in os.environ.items()
               if not k.startswith("CLAUDECODE") and k not in ("CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SESSION_ID",
                                                                "CLAUDE_CODE_CHILD_SESSION")}
        try:
            r = subprocess.run(headless, cwd=wt, env=env, capture_output=True, text=True, timeout=TELEPORT_S)
        except (OSError, subprocess.TimeoutExpired) as exc:
            r = subprocess.CompletedProcess(headless, 1, "", str(exc))
        try:
            new_id = json.loads(r.stdout.strip().splitlines()[-1]).get("session_id")
        except (ValueError, IndexError, AttributeError):
            new_id = None
        hits = list(PROJECTS.glob(f"*/{new_id}.jsonl")) if new_id else []
        copy = hits[0] if hits else None
        if copy is None:
            notes.append(f"⚠ `claude -p --teleport` wrote no local copy ({short(r.stderr or r.stdout or f'exit {r.returncode}', 120)})")
        # Teleport checks out the cloud session's own branch where it runs (2.1.288 source): any other
        # branch here means the copy belongs elsewhere, and nothing is pinned or opened on it.
        on = out(wt, "symbolic-ref", "--short", "HEAD")
        if on != b["name"]:
            print("\n".join(f"  {n}" for n in notes))
            raise Stop(f"teleport left {wt} on {on or 'a detached HEAD'}, not {b['name']} — the cloud session works on"
                       f" another branch; nothing opened" + (f" (copy {new_id})" if copy else ""), code=3)
    name = f"{root.name}: {b['topic']}"
    if copy is None:
        argv = [CLAUDE, "--teleport", sid, "--name", name]
        if NO_START:
            notes.append(f"not opened (PICKUP_NO_START) in {wt}: claude {shlex.join(argv[1:])}")
        else:
            open_in_terminal(wt, argv)
            notes.append("→ a new Terminal window runs claude --teleport — the conversation continues there")
        print("\n".join(f"  {n}" for n in notes))
        print(f"  → from the cloud into a Terminal window: {sid}")
        return
    # The copy's last turn is the "ready" just asked for, on this machine's default model: the pin
    # is the cloud's own last model, read before that turn.
    model, effort = model_of(copy, turn_start(copy))
    pin = pin_for(model, effort)
    if pin:
        why = write_pin(wt, pin)
        notes.append(f"⚠ not pinned: {why} — pick the model by hand" if why else
                     f"✓ pinned {model} / {effort or '?'} in {rel(wt, root)}/.claude/settings.local.json")
    notes.append(f"✓ the cloud session copied here as {new_id[:8]} ({copy.parent.name})")
    prompt = orientation(b, wt, {"on_branch": True, "moved_on": None}, args.note,
                         how="Moved from the cloud with /move")
    terminal = (f"cd {shlex.quote(str(wt))} && claude --resume {new_id}" + (f" --model {model}" if model else "")
                + (f" --effort {effort}" if effort else "") + f" --name {shlex.quote(name)}")
    started = False
    if effort == "max":
        notes.append("ℹ effort max cannot be pinned in settings: start it by the Terminal line below")
    elif NO_START:
        send_link({"session": new_id, "prompt": prompt}, None, notes, False)
    else:
        run(["open", "-a", "Visual Studio Code", str(wt)])
        window = poll_window(wt)  # the worktree's own window, never whichever has focus
        if window:
            announce(wt, new_id, name)  # the sidebar reads a new transcript only when told
            send_link({"session": new_id, "prompt": prompt}, window, notes, False)
            started = True
        else:
            notes.append(f"⚠ no VS Code window id for {wt} in {WINDOW_WAIT} s: no link sent")
    seen = proof(None, new_id) if started else None
    notes.append(f"✓ running here: pid {seen.get('pid')}" if seen else
                 ("⚠ not seen in " + f"{int(PROOF_S)} s" if started else "not started") + f" — {terminal}")
    notes.append(f"the cloud session stays on claude.ai/code/{sid} — archive it there once this one runs (D4)")
    print("\n".join(f"  {n}" for n in notes))
    print(f"  → moved from the cloud as {new_id} — " + ("proved running here" if seen else "not proved: start it with the line above"))


def live_transcript(p, alias):
    """The transcript of the session alive on the peer's worktree, newest first — the current
    conversation. Commit trailers name the session that last committed, which after a round trip
    is an older fork (review, 2026-10-03). None when no live session has one there."""
    for v in sorted(p.get("alive") or [], key=lambda v: -(v.get("statusUpdatedAt") or 0)):
        sid = v.get("sessionId") or ""
        if not re.fullmatch(r"[0-9a-f-]{36}", sid):
            continue
        r = ssh(alias, f"ls -t \"$HOME\"/.claude/projects/*/{sid}.jsonl")
        hit = (r.stdout.split("\n") or [""])[0].strip()
        if r.returncode == 0 and hit:
            return hit
    return None


def move_check(ref):
    """R2: the model and effort of the fork's first reply, against the source's last one. Reads
    the fork here, else on each peer. Exit 3 on a mismatch, 1 while there is no reply yet."""
    hits = list(PROJECTS.glob(f"*/{ref}*.jsonl"))
    lines = None
    if hits:
        lines = hits[0].read_text(encoding="utf-8", errors="replace").splitlines()
    else:
        for host, alias in PEERS.items():
            if host == common.host_name():
                continue
            r = ssh(alias, f"cat $HOME/.claude/projects/*/{shlex.quote(ref)}*.jsonl", timeout=60)
            if r.returncode == 0 and r.stdout.strip():
                lines = r.stdout.splitlines()
                break
    if lines is None:
        raise Stop(f"no transcript {ref} here or on a peer")
    before, after, past = (None, None), None, False
    for line in lines:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if r.get("type") == "forked-from":
            past = True
            continue
        m = (r.get("message") or {}).get("model") if r.get("type") == "assistant" else None
        if not m or m.startswith("<"):
            continue
        if not past:
            before = (m, r.get("effort"))
        elif after is None:
            after = (m, r.get("effort"))
    if not past:
        raise Stop(f"{ref} is no fork: no forked-from record")
    if after is None:
        raise Stop(f"{ref} has no reply since the move yet — press Enter there first")
    said = f"source {before[0]} / {before[1]}, here {after[0]} / {after[1]}"
    if after != before:
        raise Stop(f"⚠ model or effort differs — {said}", code=3)
    print(f"✓ same model and effort — {said}")


# ---- seeds (docs/record/followup-handoff-2026-09-29.md) ---------------------------------------------

def brief_caps(text):
    """The brief's lines; Stop when it is over the caps `seed` and `brief` share."""
    lines = text.rstrip("\n").splitlines()
    if len(lines) > BRIEF_LINES or len(text) > BRIEF_CHARS:
        raise Stop(f"the brief is {len(lines)} lines, {len(text):,} characters — over {BRIEF_LINES} lines or "
                   f"{BRIEF_CHARS:,} characters; a design goes in docs/, with a two-line brief pointing at it")
    return lines


def read_brief(path):
    """The brief's text and its `Task:` sentence; Stop when it is missing, too long or has no task."""
    try:
        text = Path(path).expanduser().read_text()
    except (OSError, UnicodeDecodeError) as e:
        raise Stop(f"cannot read the brief {path}: {e}")
    lines = brief_caps(text)
    task = next((l[len("Task:"):].strip() for l in lines if l.startswith("Task:")), "")
    if not task:
        raise Stop("the brief has no `Task:` line — the one sentence the fresh session starts from")
    return text if text.endswith("\n") else text + "\n", task


def start_lines(root, b, me):
    """How the owner starts a seed that was not opened: the slash command, and what "start it"
    here would run. From VS Code another repo's seed opens in that repo's window, pre-filled;
    from anywhere else it goes to a Terminal window, which runs at once."""
    here = not foreign_to(me, root)
    repo = "" if me.get("repo") == root else f" --repo {shlex.quote(str(root))}"
    # The full name, quoted: /pickup takes anything ending in --fresh as an exact branch, and a
    # bare topic can match a PR number or another branch (review 2026-09-29).
    if dispatchable(root, b):
        return [f"  start it: bash {BIN / 'dispatch'} '{b['name']}' --next --repo {shlex.quote(str(root))}"
                f" ({dispatch_where()}; Bash timeout 300000)"]
    typed = typed_line(f"/pickup '{b['name']}' --fresh", root)
    lines = [f"  start it: `{typed}` in a {root.name} {'tab' if here else 'window'}"]
    lines.append(f"  or say \"start it\" here → {BIN / 'pickup'} open '{b['name']}'{repo} --fresh"
                 + ("" if here else f" (a Terminal window that runs it at once, ~{kilo(fresh_base(root))} tokens before your go)"))
    return lines


def start_seed(data, b, me, start, dry, account="auto", force=False):
    """D2 (b), the owner, 2026-09-29: a seed in this repo opens its pre-filled VS Code tab at once —
    nothing runs until Enter. A Terminal window would run it at once, so it opens only on
    `--start` (the owner's "start it"); a session that would adopt it here never does. Since 2026-10-13,
    where dispatch takes the repo, both are a dispatched run instead (dispatch_fresh), at once."""
    root = data["root"]
    sent = dispatched(root, b)
    if sent:
        print(f"  already dispatched {sent} — not started again (dispatch --status there says how it runs)")
        return False
    kind, _ = fresh_kind(me, root, "vscode" if me["entry"] == "claude-vscode" else "terminal")
    # where dispatch takes the repo, the window runs nothing here: dispatch starts it (dispatch_fresh)
    # foreign-vscode: another repo's seed from VS Code — that repo's pre-filled tab, like new-tab here
    if not (kind in ("new-tab", "foreign-vscode") or (kind == "window" and (start or dispatchable(root, b)))):
        print("\n".join(start_lines(root, b, me)))
        return False
    cmd_open(data, b, me, argparse.Namespace(
        vscode=False, terminal=False, transcript=False, here=False, new_tab=False, reopen=False,
        fresh=True, session=None, note=None, dry_run=dry, account=account, force=force, tab_only=not start))
    return True


def handoff_blueprint(root, topic, today, brief):
    """(path, text) of the handoff as a one-block ship, docs/blueprints/<date>-<topic>.md, or (None,
    why) when it would not pass `wharf check` (wharf-on-orca S5, B9: a handoff is a ship Orca can run).
    The block is the topic itself (a claude-code block's id is its seed topic), `provider: claude-code`,
    the brief's lines as its `## <topic>` section — a `## ` in the brief becomes `###`, a heading there
    would name a block. No `done_when`: blueprintlib refuses one on a claude-code block (the seeded
    session ends by its own launch), so a marker the brief names stays in its text."""
    try:
        import blueprintlib
        rel = root.name if root.parent.resolve() == (Path.home() / "projects").resolve() else str(root)
        body, fence = [], None
        for line in brief.rstrip("\n").splitlines():
            if line.lstrip().startswith(("```", "~~~")):
                mark = line.lstrip()[:3]
                fence = None if fence == mark else (fence or mark)
            body.append("#" + line if fence is None and line.startswith("## ") else line)
        # quoted (a JSON string is a YAML one): a topic like `yes`, `off` or `017` stays a string
        text = (f"---\nship: {json.dumps(topic)}\nrepo: {json.dumps(rel)}\ncreated: {today}\nblocks:\n"
                f"  - id: {json.dumps(topic)}\n    depends_on: []\n    provider: claude-code\n---\n"
                f"## {topic}\n" + "\n".join(body) + "\n")
        path = f"{BLUEPRINT_DIR}/{today}-{topic}.md"
        blueprintlib.load(Path(path), text=text)
        return path, text
    except Exception as e:   # BlueprintError names every problem; anything else is as good a reason to leave it out
        return None, short(str(e), 200)


def route_docs(root, base, name, brief, check=False, drop=False, routing=(), dry=False):
    """The docs `brief` names that have a spacesheep page, each with its `Routed:` line written (or, `drop`,
    taken out) by keel's `routed line`, for this seed's or brief's own commit — before any dispatch, so the
    run and the line never diverge (routed comments S2, finding D). `check` (a seed: new work) runs keel's
    gate on each first and refuses on its exit 3, less the threads `routing` names (the ones this start
    routes). `dry` (--dry-run): keel logs nothing. Returns ([(rel, text)], the brief's last step, notes).
    No keel here (PICKUP_KEEL empty, or none found): no line, one note; a keel that fails fails a check
    closed and a plain brief open."""
    keel = os.environ.get("PICKUP_KEEL")
    if keel is None:
        keel = str(common.tool("keel") or "")
    if not keel:
        return [], "", ["no keel here: no `Routed:` line written"]
    r = run([keel, "routed", "line", "--repo", str(root), "--ref", base, "--branch", name, "--brief", "-"]
            + (["--check"] if check else []) + (["--drop"] if drop else []) + (["--dry-run"] if dry else [])
            + (["--routing", *routing] if routing else []), timeout=180, input=brief)
    try:
        res = json.loads((r.stdout or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        res = None
    if r.returncode == 3 and res:
        raise Stop("keel's gate refused: " + " | ".join(res.get("refused") or ["(no reason given)"]))
    if r.returncode or not isinstance(res, dict):
        why = short((r.stderr or r.stdout or "").strip().splitlines()[-1] if (r.stderr or r.stdout or "").strip() else f"exit {r.returncode}", 160)
        if check:
            raise Stop(f"keel routed line failed ({why}) — the gate could not run: run it again")
        return [], "", [f"keel routed line failed ({why}): no `Routed:` line written"]
    return ([(d["rel"], d["text"]) for d in res.get("docs") or []], res.get("last_step") or "",
            list(res.get("notes") or []))


def with_last_step(text, last, notes):
    """The brief with keel's last step under it, when it fits the caps; else as it was, with a note."""
    if not last:
        return text
    new = text.rstrip("\n") + "\n\n" + last + "\n"
    try:
        brief_caps(new)
    except Stop:
        notes.append("the brief is at its caps: the routed check's last step is not in it")
        return text
    return new


# ---- seed --from: the one write out of a confidential scope (confidential-reach S5) -------------

REVIEW_SUFFIX = ".review"   # docs/handoff/<date>-<topic>.review, beside the brief it vouches for


def registry_snapshot(tmp):
    """One parse of the registry, written to a file under TMP for every later read — or None when it is torn.
    A fence that asked registry_unreadable() once and then let each scope_match() read the file again
    judged a target against whatever a concurrent `scopes set` left mid-loop (S5's landing re-review)."""
    d, torn = common.read_registry()
    if torn:
        return None
    f = Path(tmp) / "repos.json"
    f.write_text(json.dumps(d or {}), encoding="utf-8")
    return str(f)


def confidential_target(root, path):
    """The confidential scope (by the registry snapshot PATH) that ROOT belongs to, or None: by its paths,
    and by its key against each scope's own entries and globs, so a clone not yet registered that a
    confidential glob would take reads as that scope's (S5's landing re-review)."""
    key = common.repo_key(str(root))
    for n, sc in common.confidential_scopes(path).items():
        if common.scope_match(n, path)(str(root)):
            return n
        ms = sc.get("repos") if isinstance(sc.get("repos"), list) else []
        if any(isinstance(m, str) and (fnmatch.fnmatchcase(key or "", m) if common.is_glob(m) else m == key) for m in ms):
            return n
    return None


def from_scope_refusal(root, scope, repo_given, cwd=None):
    """Why `seed --from SCOPE` may not go to ROOT from CWD, or None. Reads only: the registry (once), the
    vault key, tenancy and the target's contract. Every doubt refuses (an unreadable registry, a tenancy
    that will not read)."""
    with tempfile.TemporaryDirectory() as tmp:
        reg = registry_snapshot(tmp)
        if reg is None:
            return f"the registry {common.repos_json()} cannot be read, so no scope can be judged (fails closed)"
        why = from_scope_judge(root, scope, repo_given, cwd, reg)
    return why


def from_scope_judge(root, scope, repo_given, cwd, reg):
    scopes = common.confidential_scopes(reg)
    if scope not in common.scope_registry(reg)[1]:
        return f"no scope {scope!r} in the registry"
    if scope not in scopes:
        return (f"scope {scope} is not confidential: --from is the way out of a confidential scope, "
                f"and an open one's seed needs none")
    here = str(Path(cwd or os.getcwd()))
    if not common.scope_match(scope, reg)(here):
        return f"this session's directory ({here}) is not in scope {scope}: --from names the scope it runs in"
    if not repo_given:
        return "--from takes --repo: the open repo the seed goes to, named, never the cwd's"
    n = confidential_target(root, reg)
    if n:
        return f"{root.name} is in confidential scope {n}: a seed out of {scope} goes to an open repo"
    key = common.repo_key(str(root))
    vault = common.config_line("lighthouse/vault")
    if vault and key == vault:
        return f"{key} is the owner's vault, a private repo: a seed out of {scope} goes to an open repo"
    acct = common.tool("account")
    if acct:
        try:
            from importlib.machinery import SourceFileLoader
            m = SourceFileLoader("pickup_account", str(acct)).load_module()
            areg = m.load_registry()
            tenants = areg.get("tenants") or {}
            # read_tenants_file() gives {} ("tenancy is off") when the file is written but reads nothing and
            # no last good copy holds: that is no answer, so it refuses (S5's landing re-review)
            # since S7b (regatta#243) account closes tenancy itself — its CLOSED tenant holds every repo; an older
            # account gave {} ("tenancy is off"), read as no answer: both refuse here (S5's landing re-review)
            if (getattr(m, "CLOSED", None) in tenants) or (not tenants and m.tenants_file() and m.tenants_read(write=False)[1] == "none"):
                return f"lighthouse's tenancy file is written but does not read, so {key} may be a tenant's — fails closed"
            for name, entries in tenants.items():
                if entries and m.denied({"routed": dict.fromkeys(entries)}, str(root)):
                    return f"{key} is tenant {name}'s repo, a private one: a seed out of {scope} goes to an open repo"
        except (Exception, SystemExit) as e:   # account exits on a torn registry; a crash is no answer either
            return f"lighthouse's account could not say whether {key} is a tenant's ({short(str(e), 120)}) — fails closed"
    if not dispatch_takes(root):
        # its run starts by dispatch or not at all (never a tab), so a repo dispatch refuses would hold a
        # pushed seed nothing may start (S5's landing re-review)
        return f"dispatch does not take {key} (not on the worktree workflow, or no `physical: none`): its seed could never start"
    return None


def confined_refusal(root, cwd=None):
    """Why a plain `seed` or `brief` (no --from) may not write ROOT from CWD, or None: out of a confidential
    scope the only way is `seed --from`, reviewed, whose Seeded-By names a marker, never the repo
    (S5's landing re-review: a plain seed wrote the node's repo name into an open repo). A torn
    registry refuses only a session that may be confined: one whose cwd no scope can be judged for."""
    here = str(Path(cwd or os.getcwd()))
    with tempfile.TemporaryDirectory() as tmp:
        reg = registry_snapshot(tmp)
        if reg is None:
            return (f"the registry {common.repos_json()} cannot be read, so whether this session is in a "
                    f"confidential scope cannot be told (fails closed)")
        for n in common.confidential_scopes(reg):
            if common.scope_match(n, reg)(here) and not common.scope_match(n, reg)(str(root)):
                return f"this session runs in a confidential scope: a seed out of it goes by --from, reviewed"
    return None


def outbound_tail(name, by):
    """What leaves with a seed's brief besides it, as scope-pass judges it: the branch name and the
    Seeded-By line. aurora's bench/brief-review builds the same two lines (keep them in step)."""
    return f"\nBranch: {name}\nSeeded-By: {by}\n"


def review_brief(scope, text, extra):
    """The .review's JSON text for TEXT leaving SCOPE, or Stop. aurora's scope-pass reads the brief and
    EXTRA (what else leaves with it: the branch name, the Seeded-By line) as one file — its scan, then
    the gate's scope.brief judge — and both must say clean of the bytes hashed here. A bundle that
    names SCOPE itself is refused before it is built: the name never reaches an open repo, nor the
    judge's prompt (S5's landing review; scope-pass's --judge scan refuses it too)."""
    own = re.compile(r"(?<![A-Za-z0-9])" + re.escape(scope) + r"(?![A-Za-z0-9])", re.I)
    if own.search(text + extra):
        raise Stop(f"the brief names confidential scope {scope} (its own name, in the brief or the topic) — nothing seeded")
    sp = common.tool("scope-pass")
    if not sp:
        raise Stop(f"aurora's scope-pass is not installed: a brief leaving confidential scope {scope} is reviewed "
                   f"by it, so nothing is seeded")
    bundle = (text + extra).encode("utf-8")
    with tempfile.TemporaryDirectory() as tmp:
        f = Path(tmp) / "outbound.md"
        f.write_bytes(bundle)
        try:
            r = subprocess.run([str(sp), "check", scope, str(f), "--judge", "--json"],
                               capture_output=True, text=True, timeout=1300)   # the gate: 600 s an attempt, one retry
        except (OSError, subprocess.TimeoutExpired) as e:
            raise Stop(f"scope-pass check did not answer ({e}): no review, no seed")
    try:
        v = json.loads((r.stdout.strip().splitlines() or ["null"])[-1])
    except ValueError:
        v = None
    said = "\n".join(f"    {l}" for l in r.stderr.splitlines() if l.strip())
    if not isinstance(v, dict):
        raise Stop(f"scope-pass check gave no verdict (exit {r.returncode}): no review, no seed\n{said}")
    if v.get("sha256") != hashlib.sha256(bundle).hexdigest():
        raise Stop("scope-pass judged other bytes than the seed would send: no seed")
    if v.get("scan") != "clean":
        raise Stop(f"the brief names confidential scope {scope} (scope-pass check: {v.get('scan')}) — nothing seeded:\n{said}")
    if v.get("judge") != "clean" or r.returncode != 0:
        why = "judged a leak" if v.get("judge") == "leak" else f"could not be judged ({v.get('error') or v.get('judge')})"
        raise Stop(f"the brief {why} by the gate's {v.get('site') or 'scope.brief'} judge — nothing seeded:\n{said}")
    rec = {"review": "confidential-reach S5", "origin": common.scope_marker(scope), "sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
           "scan": "clean", "judge": "clean", "judged_sha256": v["sha256"]}
    rec.update({k: v.get(k) for k in ("site", "provider", "model", "cost_usd", "time")})
    return json.dumps(rec, indent=1) + "\n"


def from_start_line(root, name, scope):
    return (f"  start it: bash {BIN / 'dispatch'} '{name}' --next --repo {shlex.quote(str(root))} --origin {shlex.quote(scope)}"
            f" ({dispatch_where()}; Bash timeout 300000)")


def cmd_seed(data, me, args):
    """One commit on a new claude/<host>/<date>-<topic> branch, made from local main by git
    plumbing — no worktree, no checkout, so it works from any session — holding the brief at
    docs/handoff/<date>-<topic>.md, then pushed. It must add a file: a branch with no net
    change reads as launched to hooks/branches.py and is archived within a day."""
    root, main, topic = data["root"], data["main"], args.ref
    # The weekly Sextant runs in `auto` mode, where an allow rule pinned to `--no-start` refuses
    # nothing: a seed it makes must never start (the S7 /finish review's F1). Its dispatch is
    # `--at reset … --if-room`, which dispatch itself holds to under WEEKLY_RUN.
    if os.environ.get("WEEKLY_RUN") and not args.no_start:
        raise Stop(f"under WEEKLY_RUN={os.environ['WEEKLY_RUN']} a seed takes --no-start: "
                   f"the queue dispatches it at the reset with --if-room")
    if not TOPIC_RE.match(topic):
        raise Stop(f"a seed topic is 3–40 characters of a-z, 0-9 and -: {topic!r}")
    try:
        opted = json.loads((root / ".claude" / "workflow.json").read_text()).get("checkpoint") is True
    except (OSError, ValueError):
        opted = False
    if (root / ".claude" / "no-workflow").exists() or not opted:
        # no checkpoints, pushes or PRs there, and `list --all` skips the knowledge repos
        raise Stop(f"{root.name} is not on the worktree workflow — put the follow-up in its TODO.md or a doc instead")
    text, task = read_brief(args.file)
    today = datetime.date.today().isoformat()
    name = f"claude/{data['host']}/{today}-{topic}"
    taken = [b["name"] for b in data["branches"] if b["name"] == name or (b["status"] == "open" and b["topic"] == topic)]
    if taken or git(root, "show-ref", "--verify", "--quiet", f"refs/heads/{name}").returncode == 0:
        raise Stop(f"{topic} is already open as {(taken or [name])[0]} — pick that up, or choose another topic")
    base = out(root, "rev-parse", "--verify", "--quiet", f"refs/heads/{main}")
    if not base:
        raise Stop(f"no local {main} in {root} to seed from")
    path = f"{HANDOFF_DIR}/{today}-{topic}.md"
    scope = getattr(args, "from_scope", None)
    # the docs the brief names that have a page: the gate first (new work), then their `Routed:` line
    # in this commit (routed comments S2); the brief's last step is the run's own check. A seed out of a
    # confidential scope routes nothing: keel would read its brief before the review below (S5)
    if scope:
        routed, rnotes = [], ["a seed out of a confidential scope routes nothing: keel would read the brief before its review"]
    else:
        routed, last, rnotes = route_docs(root, base, name, text, check=True, routing=args.routing, dry=args.dry_run)
        text = with_last_step(text, last, rnotes)
    # out of a confidential scope the cwd's repo and the scope's name are both the node's: Seeded-By
    # carries the scope's marker, which only this host's registry reads back (S5's landing review)
    mark = common.scope_marker(scope) if scope else None
    by = f"{mark or (me['repo'].name if me.get('repo') else '?')}/{me['id'][:8] or 'shell'} on {data['host']}"
    msg = (f"{SEED_SUBJECT}{topic}\n\nPrompt:\n> {task}\n\n"
           f"Seeded-By: {by}\n" + (f"Routed-By: pickup seed ({', '.join(r for r, _ in routed)})\n" if routed else "")
           + "Co-Authored-By: Claude <noreply@anthropic.com>\n")
    behind = out(root, "rev-list", "--count", f"{main}..origin/{main}") if out(
        root, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{main}") else "0"
    bpath, bnote = (None, None) if args.no_blueprint else handoff_blueprint(root, topic, today, text)   # bnote: the text, or why none
    if bpath and git(root, "cat-file", "-e", f"{base}:{bpath}").returncode == 0:
        # a ship's blueprint of the same name is on main: never overwrite it with a one-block one
        bpath, bnote = None, f"{bpath} is already on {main}"
    rpath = review = None
    if scope:   # reviewed before any write: the scan and the judge both, or nothing (S5)
        rpath = path[:-len(".md")] + REVIEW_SUFFIX
        review = review_brief(scope, text, outbound_tail(name, by))
        print(f"reviewed: the brief leaving {scope} is clean by its scan and the gate's judge")
    if args.dry_run:
        print(f"would seed {name} in {root}: commit {path} ({len(text.splitlines())} lines)"
              + (f" and {bpath}" if bpath else "") + (f" and {rpath}" if rpath else "")
              + "".join(f", {r}'s Routed: line" for r, _ in routed)
              + f" on local {main} ({base[:7]}), then push it" + "".join(f"\n  {n}" for n in rnotes))
        return

    def g(*a, **kw):
        r = run(["git", "-C", str(root), *a], **kw)
        if r.returncode:
            raise Stop(f"seed: git {a[0]} failed: {short(r.stderr, 160)}")
        return r.stdout.strip()

    blob = g("hash-object", "-w", "--stdin", input=text)
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        g("read-tree", base, env=env)
        g("update-index", "--add", "--cacheinfo", f"100644,{blob},{path}", env=env)
        if bpath:
            g("update-index", "--add", "--cacheinfo", f"100644,{g('hash-object', '-w', '--stdin', input=bnote)},{bpath}", env=env)
        if rpath:
            g("update-index", "--add", "--cacheinfo", f"100644,{g('hash-object', '-w', '--stdin', input=review)},{rpath}", env=env)
        for rel, doc in routed:
            g("update-index", "--add", "--cacheinfo", f"100644,{g('hash-object', '-w', '--stdin', input=doc)},{rel}", env=env)
        tree = g("write-tree", env=env)
    if tree == out(root, "rev-parse", f"{base}^{{tree}}"):
        raise Stop(f"{path} is already on {main} as written — nothing to seed")
    commit = g("commit-tree", tree, "-p", base, "-F", "-", input=msg)
    g("update-ref", f"refs/heads/{name}", commit, "0" * len(commit))  # refuses if another seed won the race
    if git(root, "remote", "get-url", "origin").returncode:
        state = "no origin: on this machine only"
    elif git(root, "push", "-q", "-u", "origin", f"refs/heads/{name}:refs/heads/{name}", timeout=60).returncode:
        state = (f"⚠ not pushed — on this machine only until: git -C {shlex.quote(str(root))} push -u origin {name}")
    else:
        state = "pushed"
    print(f"seeded {name} in {root.name} — {path}, {len(text.splitlines())} lines; {state}")
    if rpath:
        print(f"  and its review {rpath} (origin {mark}, which is {scope} here: the brief's sha256, both verdicts)")
    for rel, _ in routed:
        print(f"  routed: {rel} carries its Routed: line in this commit")
    for n in rnotes:
        print(f"  {n}")
    if bpath:
        print(f"  and its one-block blueprint {bpath} (wharf check <it> to see the ship)")
    elif bnote:
        print(f"  no blueprint beside the brief: {bnote}")
    if behind not in ("", "0"):
        print(f"  ⚠ local {main} is {behind} behind origin — the follow-up rebases at its /finish")
    fresh = collect(root, fetch=False)
    b = resolve(name, fresh["branches"])
    if scope:   # dispatched with its origin, or the line to: never a tab or a window here
        if args.no_start or not dispatch_fresh(root, b, args, origin=mark):
            print(from_start_line(root, name, mark))
        return
    if args.no_start:
        # the default since 2026-10-04 (skills/todo, "Handing off"): the seeding session starts it.
        # --repo always: dispatch's default is the launcher repo, not the seeding session's repo (review 2026-10-05)
        print(f"  start it now, unattended: bash {BIN / 'dispatch'} '{b['name']}' --next"
              f" --repo {shlex.quote(str(root))} (Bash timeout 300000)")
        if not dispatch_takes(root):
            print("\n".join(start_lines(root, b, me)))
    else:
        start_seed(fresh, b, me, args.start, False, args.account, args.force)


# ---- brief: a handoff brief onto an existing branch (Lookout and Hail design, S4) ----------
#
# `dispatch BRANCH` needs a committed docs/handoff/<date>-<topic>.md on the branch, and `seed_next`
# writes one into the CALLER's worktree — which a launchd job has none of. `brief` is that write as
# plumbing, as cmd_seed does it: a blob, a tree, `commit-tree`, the ref moved. The subject is `Brief:`,
# never `Seed:`: a branch with work on it must not read as an unstarted seed (branches.seed_only).
#
# Three refusals, each one a clash with somebody's work: the local branch and origin's have diverged
# (nothing here rebases); a worktree holds the branch with uncommitted changes (dispatch refuses a dirty
# one, and the commit would land under the edits); another session holds that worktree (owner.json
# under OWNER_TTL, not handed over — checkpoint.py's held_by_other). A clean, unheld worktree gets the
# commit by `merge --ff-only` inside it, which moves its files with the ref: update-ref alone would
# leave it looking dirty, and dispatch's own clean-worktree check would then refuse the run.

def mid_operation(root, name):
    """(worktree, "rebase"|"bisect") when a worktree has `name` mid-rebase or mid-bisect: it is
    detached while that runs, so worktrees() does not list it, and its end rewrites the ref."""
    cur = None
    for line in out(root, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            cur = Path(line[len("worktree "):])
        elif line == "detached" and cur and cur.is_dir():
            gd = out(cur, "rev-parse", "--absolute-git-dir")
            for sub, what in (("rebase-merge/head-name", "rebase"), ("rebase-apply/head-name", "rebase"),
                              ("BISECT_START", "bisect")):
                try:
                    head = (Path(gd) / sub).read_text().strip() if gd else ""
                except OSError:
                    continue
                if head in (f"refs/heads/{name}", name):
                    return cur, what
    return None


def cmd_brief(root, me, args):
    name = args.ref
    if not name.startswith("claude/"):
        raise Stop(f"brief takes the full claude/<host>/<date>-<topic> branch name, not {name!r}")
    topic = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", name.rsplit("/", 1)[-1])
    if not TOPIC_RE.match(topic):
        raise Stop(f"{name}: its topic {topic!r} is not 3–40 characters of a-z, 0-9 and -")
    if not on_workflow(root):   # as cmd_seed: dispatch would refuse the run there anyway
        raise Stop(f"{root.name} is not on the worktree workflow — put the follow-up in its TODO.md or a doc instead")
    text = (sys.stdin.read() if args.text == "-" else args.text).strip("\n")
    if not text.strip():
        raise Stop("an empty brief: --text needs the step's text (or - for stdin)")
    text += "\n"
    brief_caps(text)   # measured as written, newline included, as read_brief measures a seed's
    today = datetime.date.today().isoformat()
    path = f"{HANDOFF_DIR}/{today}-{topic}.md"

    def g(*a, **kw):
        r = run(["git", "-C", str(root), *a], **kw)
        if r.returncode:
            raise Stop(f"brief: git {a[0]} failed: {short(r.stderr, 160)}")
        return r.stdout.strip()

    has_origin = git(root, "remote", "get-url", "origin").returncode == 0
    if has_origin and not args.no_fetch:   # the one branch only: a fetch of everything is the sync's work
        r = git(root, "fetch", "-q", "origin", f"+refs/heads/{name}:refs/remotes/origin/{name}", timeout=60)
        # a failed fetch leaves the old tracking ref in place: briefing on it would push a branch
        # GitHub deleted at its landing back into being, or build on a tip origin has moved past
        if r.returncode and "couldn't find remote ref" in r.stderr:
            raise Stop(f"{name} is not on origin (landed and deleted, or never pushed): "
                       f"nothing to brief — `git -C {root} push -u origin {name}` first if it is still wanted")
        if r.returncode:
            raise Stop(f"could not fetch {name} from origin: {short(r.stderr, 160)} — "
                       f"--no-fetch briefs on what this machine has")
    local = out(root, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}")
    remote = out(root, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{name}")
    if not local and not remote:
        raise Stop(f"no branch {name} here or on origin — `pickup seed` starts a new one")
    notes = []
    if local and remote and local != remote:
        if git(root, "merge-base", "--is-ancestor", local, remote).returncode == 0:
            notes.append(f"fast-forwarded from origin ({local[:7]} → {remote[:7]})")
            base = remote
        elif git(root, "merge-base", "--is-ancestor", remote, local).returncode == 0:
            base = local   # ahead of origin: the push sends it
        else:
            raise Stop(f"{name} has diverged from origin/{name} (local {local[:7]}, origin {remote[:7]}): "
                       f"nothing rebases here — settle it with the session whose work it is")
    elif local:
        base = local
    else:
        base = remote
        notes.append(f"no local branch: made from origin/{name} ({remote[:7]})")

    busy = mid_operation(root, name)
    if busy:
        raise Stop(f"{name} is mid-{busy[1]} at {busy[0]} (the worktree is detached while it runs): "
                   f"a ref moved under it is overwritten when it ends — let it finish first")
    wt = worktrees(root).get(name)
    if wt:
        if wt["missing"]:
            raise Stop(f"{name} is checked out at {wt['path']}, which is gone: `git -C {root} worktree prune`")
        want = root / ".claude" / "worktrees" / topic
        if wt["path"].resolve() != want.resolve():   # dispatch --next runs it there and nowhere else
            raise Stop(f"{name} is checked out at {wt['path']}; the run needs it at {want} — dispatch would refuse it")
        # unstripped: out() would cut the leading space of a first " M file" line, and a name with it
        dirty = [l[3:] for l in git(wt["path"], "status", "--porcelain").stdout.splitlines() if l.strip()]
        if dirty:
            raise Stop(f"{name} is checked out at {wt['path']} with uncommitted changes ({', '.join(dirty[:3])}"
                       f"{', …' if len(dirty) > 3 else ''}): its session commits them first — dispatch would refuse it too")
        state = state_dir(wt["path"])
        if not state:
            raise Stop(f"cannot read the git dir of {wt['path']}: its lock is unknown, so nothing goes there")
        if (state / common.MOVED_FILE).exists() or (state / "finishing").exists():
            what = "was moved to another machine (pickup move)" if (state / common.MOVED_FILE).exists() else "has a /finish in progress"
            raise Stop(f"{name} at {wt['path']} {what}: its work is not settled here, so no brief goes there")
        lock = common.read_owner(state)
        if (lock and lock.get("session") != me["id"] and not lock.get("handover")
                and time.time() - lock.get("seen", 0) < OWNER_TTL):
            raise Stop(f"{name} is held by session {str(lock.get('session'))[:8]} at {wt['path']} "
                       f"(seen {ago(int(lock.get('seen', 0)))}): it must end, or idle 2 h, before a brief goes there")

    # the docs the brief names that have a page get their `Routed:` line in this commit, before dispatch
    # (routed comments S2, finding D); --unroute (a released start) takes it out. Never gated: answer and
    # talk runs pass through here with talking threads (cutover's table)
    routed, last, rnotes = route_docs(root, base, name, text, drop=args.unroute, dry=args.dry_run)
    text = with_last_step(text, last, rnotes)
    by = f"{me['repo'].name if me.get('repo') else '?'}/{me['id'][:8] or 'shell'} on {common.host_name()}"
    first = next((l for l in text.splitlines() if l.strip()), "")
    task = next((l[len("Task:"):].strip() for l in text.splitlines() if l.startswith("Task:")), first.lstrip("# "))
    msg = (f"Brief: the next step of {topic} (pickup brief)\n\nPrompt:\n> {task}\n\n"
           f"Briefed-By: {by}\n" + (f"Routed-By: pickup brief ({', '.join(r for r, _ in routed)})\n" if routed else "")
           + "Co-Authored-By: Claude <noreply@anthropic.com>\n")
    # the same brief already there: hashed without -w, so --dry-run says it too and writes nothing
    if not routed and g("hash-object", "--stdin", input=text) == out(root, "rev-parse", "--verify", "--quiet", f"{base}:{path}"):
        if local != base and not args.dry_run:   # still bring this machine's branch up to it, or dispatch reads a stale tip
            if wt:
                git(wt["path"], "merge", "-q", "--ff-only", base)
            else:
                g("update-ref", f"refs/heads/{name}", base, local or "0" * len(base))
        raise Stop(f"{path} is already on {name} as written — nothing to brief")
    if args.dry_run:
        print(f"would brief {name} in {root}: commit {path} ({len(text.splitlines())} lines) on {base[:7]}"
              + "".join(f"; {n}" for n in notes) + (f"; worktree {wt['path']} moves with it" if wt else "")
              + (", then push it" if has_origin else ", no origin: on this machine only"))
        return
    blob = g("hash-object", "-w", "--stdin", input=text)
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp) / "index")}
        g("read-tree", base, env=env)
        g("update-index", "--add", "--cacheinfo", f"100644,{blob},{path}", env=env)
        for rel, doc in routed:
            g("update-index", "--add", "--cacheinfo", f"100644,{g('hash-object', '-w', '--stdin', input=doc)},{rel}", env=env)
        tree = g("write-tree", env=env)
    commit = g("commit-tree", tree, "-p", base, "-F", "-", input=msg)
    if wt:
        r = git(wt["path"], "merge", "-q", "--ff-only", commit)
        if r.returncode:
            raise Stop(f"could not move {wt['path']} to the brief: {short(r.stderr or r.stdout, 160)}")
    elif local:
        g("update-ref", f"refs/heads/{name}", commit, local)   # refuses if the branch moved under us
    else:
        g("update-ref", f"refs/heads/{name}", commit, "0" * len(commit))
    if not has_origin:
        state = "no origin: on this machine only"
    elif git(root, "push", "-q", "-u", "origin", f"refs/heads/{name}:refs/heads/{name}", timeout=60).returncode:
        # unlike a seed's new branch, this push can be refused because origin moved after the fetch;
        # a brief kept here would leave the branch diverged, the state brief itself refuses. So the
        # ref goes back to where it was and the call fails: a caller's `brief && dispatch` stops, retries later
        if wt:
            git(wt["path"], "reset", "-q", "--keep", local)
        elif local:
            git(root, "update-ref", f"refs/heads/{name}", local, commit)
        else:
            git(root, "update-ref", "-d", f"refs/heads/{name}", commit)
        raise Stop(f"the push of {name} failed, so the brief was taken back; nothing changed — "
                   f"origin may have moved: run it again")
    else:
        state = "pushed"
    print(f"briefed {name} in {root.name} — {path}, {len(text.splitlines())} lines; {state}"
          + "".join(f"\n  {n}" for n in notes)
          + "".join(f"\n  {'unrouted' if args.unroute else 'routed'}: {r}" for r, _ in routed)
          + "".join(f"\n  {n}" for n in rnotes))


def cmd_seeds(roots, me, args):
    """Seeds no session has started (no session linked, no worktree). --mine: those this
    session seeded. --open: D2 (c) — /finish opens a tab for each, as `seed` did."""
    if args.mine and not me["id"]:
        raise Stop("--mine needs a session (CLAUDE_CODE_SESSION_ID)")
    found = 0
    for root in roots:
        data = collect(root, fetch=not args.no_fetch)
        for b in data["branches"]:
            s = b["seed"]
            if b["status"] != "open" or not s or b["sessions"] or b["worktree"] or seed_started(b):
                continue  # started elsewhere: /finish must not open a second tab for it
            if args.mine and f"/{me['id'][:8]} " not in (s["by"] or ""):
                continue
            found += 1
            print(f"seed {b['topic']} · {b['name']} in {root.name} — brief {s['brief'] or '?'}, seeded {ago(b['time'])}")
            if b["asked"]:
                print(f"  task: \"{short(b['asked'], 140)}\"")
            if args.open:
                try:   # one seed dispatch could not start stops neither the pass nor the others
                    started = start_seed(data, b, me, False, args.dry_run)
                except Stop as e:
                    print(f"  ⚠ {e}")
                    continue
                if started and not (args.dry_run or NO_START):
                    time.sleep(1.5)  # one vscode:// link at a time: a second may arrive before the first tab exists
            else:
                print("\n".join(start_lines(root, b, me)))
    if not found:
        print("no seed waiting" + (" from this session" if args.mine else ""))


# ---- main -----------------------------------------------------------------------------------

def jsonable(x):
    if isinstance(x, dict):
        return {k: jsonable(v) for k, v in x.items()}
    if isinstance(x, (list, tuple, set)):
        return [jsonable(v) for v in x]
    return str(x) if isinstance(x, Path) else x


def all_roots(first):
    roots = [first] if first else []
    try:
        repos = json.loads((common.repos_json() or Path("/nonexistent")).read_text())["repos"]
    except (OSError, ValueError, KeyError):
        repos = {}
    for path, spec in repos.items():
        p = Path.home() / "projects" / path
        if not spec.get("knowledge") and (p / ".git").exists() and p.resolve() not in roots:
            roots.append(p.resolve())
    return roots


def carried_hint(root, name, b, tgt):
    """branches.carried() for EVERY tip, local and origin, like prove() and probably() — a commit
    the other machine pushed must not ride along unchecked (review, 2026-10-01). Worded so a
    review never calls content on another unlaunched branch "launched"."""
    import branches
    hints = [branches.carried(root, name, t, tgt) for t in b.tips]
    if not hints or not all(hints):
        return None
    h = next((h for h in hints if h != "every line it adds is on main"), hints[0])
    return h.replace("carried by ", "not on main yet, but carried by ", 1)


def review_lines(root, main, name):
    """The evidence for one probably-launched branch (D6), as lines. Read-only."""
    import branches
    b = branches.collect(root).get(name)
    tgt = branches.target(root, main)
    if b is None or not tgt:
        return [f"  review    {name}: no local or origin copy to read, or no main to read it against"]
    tip = b.local or b.remote
    base = branches.out(root, "merge-base", tgt, tip)
    proof = branches.prove(root, b, tgt)
    hint = None if proof else (branches.probably(root, b, tgt) or carried_hint(root, name, b, tgt))
    lines = [f"  verdict   " + (f"launched: {proof}" if proof else f"probably launched: {hint}" if hint
                                 else "not on main: nothing shows its content is there")]
    # Each commit, with the main commit that carries the same change (patch-id), or none.
    def patch_ids(rev_range):
        logp = branches.git(root, "log", "-p", "--no-merges", "--format=commit %H", rev_range)
        r = subprocess.run(["git", "-C", str(root), "patch-id", "--stable"], input=logp.stdout,
                           capture_output=True, text=True)
        return dict(l.split()[:2] for l in r.stdout.splitlines() if len(l.split()) >= 2)
    on_main = {pid: sha for pid, sha in patch_ids(f"{base}..{tgt}").items()} if base else {}
    mine = patch_ids(f"{base}..{tip}") if base else {}
    by_sha = {sha: pid for pid, sha in mine.items()}
    commits = branches.out(root, "log", "--reverse", "--format=%H %s", f"{base}..{tip}").splitlines() if base else []
    lines.append(f"  commits   {len(commits)} since it left main")
    for c in commits[:20]:
        sha, _, subj = c.partition(" ")
        eq = on_main.get(by_sha.get(sha, ""))
        lines.append(f"    {sha[:7]} {short(subj, 70)} — " + (f"on main as {eq[:7]}" if eq else "no equivalent on main"))
    paths = branches.changed_paths(root, base, tip) if base else None
    differ = []
    if paths:
        at_tip = branches.tree_entries(root, tip, paths) or {}
        at_main = branches.tree_entries(root, tgt, paths) or {}
        lines.append(f"  files     {len(paths)} changed")
        for f in paths[:30]:
            if at_tip.get(f) == at_main.get(f):
                state = "identical on main"
            else:
                differ.append(f)
                edited = branches.git(root, "diff", "--quiet", base, tgt, "--", f).returncode == 1
                state = "differs — main edited it since" if edited else "differs"
            lines.append(f"    {f} — {state}")
    # What archiving loses is what the branch ADDED that main's version does not contain — not the
    # whole main→branch diff, which is mostly main's own later edits (review of the first draft
    # on the shop's billing sync, 2026-09-26: 400 lines, nearly all of them main's).
    lost = []
    for f in differ:
        added = [l[1:] for l in branches.git(root, "diff", "--no-color", base, tip, "--", f).stdout.splitlines()
                 if l.startswith("+") and not l.startswith("+++")]
        there = set(branches.git(root, "show", f"{tgt}:{f}").stdout.splitlines())
        gone = [l for l in added if l.strip() and l not in there]
        if gone:
            lost.append((f, gone))
    if not differ:
        lines.append("  would lose nothing: every file it changed is as on main")
    elif not lost:
        lines.append(f"  would lose nothing it wrote: {len(differ)} file{'s' if len(differ) != 1 else ''} differ, "
                     "but every line the branch added is on main (main moved on since)")
    else:
        n = sum(len(g) for _, g in lost)
        lines.append(f"  would lose {n} line{'s' if n != 1 else ''} the branch added that main does not have (first 40):")
        shown = 0
        for f, gone in lost:
            if shown >= 40:
                break
            lines.append(f"    {f}:")
            for l in gone[:40 - shown]:
                lines.append(f"      + {short(l, 110)}")
                shown += 1
        if n > shown:
            lines.append(f"    … {n - shown} more")
    items, checked, total = branches.evidence(root, b, tgt)
    if items:
        lines.append("  open items " + ", ".join(f"{p} ({n})" for p, n in items) + " — they stay on main either way")
    lines.append(f"  reopen    {BIN / 'pickup'} open {name}")
    lines.append(f"  archive   {BIN / 'pickup'} archive {name} --confirmed")
    return lines


def cmd_archive(root, main, name, confirmed, pb=None, pr_unknown=False):
    """The owner's exit for a probably-launched branch, or for a seed no session has started (pb is
    pickup's own record of the branch, which knows seeds). Refuses anything else, a worktree
    that is dirty or under a fresh lock, and a run without --confirmed."""
    import branches
    if not confirmed:
        raise Stop(f"archive needs --confirmed: it records that {OWNER} confirmed the branch launched")
    b = branches.collect(root).get(name)
    tgt = branches.target(root, main)
    if b is None or not tgt:
        raise Stop(f"{name}: nothing to archive")
    seed = bool(pb and pb.get("seed"))
    if seed and (pb["sessions"] or seed_started(pb)):
        raise Stop(f"{name}: a seed a session has started ({seed_state(pb) if not pb['sessions'] else 'a session is linked'})"
                   " — pick it up, or end that session first")
    # pb judges the local tip, but archive deletes the GitHub copy too: a seed origin moved past,
    # one with any open PR (a readied one is no longer WIP:), or one whose PR state could not be
    # read may have been started on the other Mac (review, 2026-10-19)
    if seed and pb["incoming"]:
        raise Stop(f"{name}: GitHub has {pb['incoming']} commit(s) this copy lacks — it was started elsewhere")
    if seed and pb["pr"] and pb["pr"]["state"] == "open":
        raise Stop(f"{name}: PR #{pb['pr']['number']} is open — a session has it; close it first")
    if seed and pr_unknown:
        raise Stop(f"{name}: PR state unknown, so whether a session started it is too — try again online")
    # carried(): every line it adds is on main or another claude/* branch (2026-10-01) — a hint,
    # like probably(); the owner's --confirmed is what makes it an archive, and the ref stays 7 days.
    if not seed and not (branches.prove(root, b, tgt) or branches.probably(root, b, tgt)
                         or carried_hint(root, name, b, tgt)):
        raise Stop(f"{name} is not on main — nothing shows its content is there; pick it up instead")
    for path, wname, gitdir in branches.worktrees(root)[1:]:
        if wname == name:
            if gitdir and branches.lock_fresh(gitdir, time.time()):
                raise Stop(f"{name}: a live session holds its worktree {path} — end it first")
            if branches.uncommitted(path):
                raise Stop(f"{name}: its worktree {path} has uncommitted work — pick it up instead")
            r = subprocess.run(["git", "-C", str(root), "worktree", "remove", str(path)], capture_output=True, text=True)
            if r.returncode:
                raise Stop(f"{name}: its worktree {path} could not be removed: {r.stderr.strip()[:120]}")
            print(f"removed its clean worktree {path}")
    reason = SEED_DROPPED if seed else branches.CONFIRMED
    ok, phrase = branches.archive(root, b, reason)
    if not ok:
        raise Stop(phrase)
    print(f"archived {phrase} — {reason}; kept {branches.ARCHIVE_TTL_DAYS} days as "
          f"{branches.archive_ref(name)}, restore: git -C {shlex.quote(str(root))} branch {name} {branches.archive_ref(name)}")


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd = argv.pop(0) if argv and argv[0] in ("list", "show", "open", "review", "archive", "seed", "seeds", "move",
                                              "next", "brief") else "list"
    repo_given = any(a == "--repo" or a.startswith("--repo=") for a in argv)
    ap = argparse.ArgumentParser(prog=f"pickup {cmd}")
    ap.add_argument("--repo", default=".")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-fetch", action="store_true")
    if cmd in ("list", "seeds"):
        ap.add_argument("--all", action="store_true")
    elif cmd == "next":
        ap.add_argument("prompt")
        ap.add_argument("--tab", action="store_true")  # a fresh tab whatever the size
        ap.add_argument("--dry-run", action="store_true")
    elif cmd == "move":
        ap.add_argument("ref", nargs="?")
        way = ap.add_mutually_exclusive_group(required=True)
        way.add_argument("--to")
        way.add_argument("--from", dest="from_host")
        way.add_argument("--cancel", action="store_true")
        way.add_argument("--check", metavar="ID")
        ap.add_argument("--prepare", action="store_true")
        ap.add_argument("--note")
        ap.add_argument("--dry-run", action="store_true")
    else:
        ap.add_argument("ref")
    if cmd in ("seed", "open"):
        # which login a fresh Terminal session runs on: auto = bin/account pick (multi-account E4)
        ap.add_argument("--account", default="auto")
        ap.add_argument("--force", action="store_true")  # a named account past its own rules
    if cmd == "seed":
        ap.add_argument("--file", required=True)
        ap.add_argument("--dry-run", action="store_true")
        ap.add_argument("--no-blueprint", action="store_true")
        ap.add_argument("--routing", nargs="+", default=[])   # the page threads this seed routes: keel's gate passes them
        when = ap.add_mutually_exclusive_group()
        # --launch / --no-launch: the old names, aliases for a week (S8 of docs/wharf-rename-2026-10-16.md)
        when.add_argument("--start", "--launch", dest="start", action="store_true")
        when.add_argument("--no-start", "--no-launch", dest="no_start", action="store_true")
        ap.add_argument("--from", dest="from_scope")   # out of a confidential scope, reviewed (S5)
    if cmd == "brief":
        ap.add_argument("--text", required=True)   # `-`: from stdin, so a heredoc carries `$` and backticks untouched
        ap.add_argument("--dry-run", action="store_true")
        ap.add_argument("--unroute", action="store_true")   # a released start: the docs' Routed: line comes out
    if cmd == "seeds":
        ap.add_argument("--mine", action="store_true")
        ap.add_argument("--open", action="store_true")
        ap.add_argument("--dry-run", action="store_true")
    if cmd == "archive":
        ap.add_argument("--confirmed", action="store_true")
    if cmd == "open":
        ap.add_argument("--session")
        ap.add_argument("--note")
        ap.add_argument("--dry-run", action="store_true")
        for flag in ("--vscode", "--terminal"):
            ap.add_argument(flag, action="store_true")
        # each names a different handoff: two at once is a mistake, not a combination
        how = ap.add_mutually_exclusive_group()
        for flag in ("--here", "--new-tab", "--transcript", "--reopen", "--fresh"):
            how.add_argument(flag, action="store_true")
    args = ap.parse_args(argv)
    root = repo_root(Path(args.repo).expanduser())
    if root is None and cmd in ("list", "seeds"):
        args.all = True  # run from ~/projects or a phone session's folder: every repo
    elif root is None:
        raise Stop(f"{Path(args.repo).resolve()} is not inside a git repository")
    me = this_session()
    me["repo"] = repo_root(Path.cwd())
    if cmd == "next":
        cmd_next(me, args)
        return 0
    if cmd == "seeds":
        cmd_seeds(all_roots(root) if args.all else [root], me, args)
        return 0
    if cmd == "brief":
        why = confined_refusal(root)
        if why:
            raise Stop(f"brief: {why}")
        cmd_brief(root, me, args)
        return 0
    if cmd == "seed":
        if args.from_scope:   # judged before anything reads the target's origin, let alone writes
            if args.start:
                raise Stop("--from takes no --start: the run goes by dispatch, with its --origin, or not at all")
            why = from_scope_refusal(root, args.from_scope, repo_given)
            if why:
                raise Stop(f"seed --from {args.from_scope}: {why}")
        else:
            why = confined_refusal(root)
            if why:
                raise Stop(f"seed: {why}")
        cmd_seed(collect(root, fetch=not args.no_fetch), me, args)
        return 0
    if cmd == "list":
        roots = all_roots(root) if args.all else [root]
        results = [collect(r, fetch=not args.no_fetch) for r in roots]
        if args.json:
            print(json.dumps(jsonable({"this_session": me, "repos": results}), ensure_ascii=False, indent=1))
            return 0
        quiet = [d["root"].name for d in results[1:]
                 if not any(b["status"] == "open" for b in d["branches"])]
        for i, data in enumerate(d for d in results if d["root"].name not in quiet or d is results[0]):
            if i:
                print()
            print_list(data, me)
        if quiet:
            print(f"\nnothing open in: {', '.join(quiet)}")
        return 0
    if cmd == "move":
        if args.check:
            move_check(args.check)
            return 0
        args.to, args.from_host = (host_alias(h) if h else h for h in (args.to, args.from_host))
        if args.from_host and not args.ref:
            raise Stop("move --from needs the branch: pickup move REF --from HOST")
        data = collect(root, fetch=not args.no_fetch)
        ref = args.ref or out(Path(args.repo).expanduser(), "symbolic-ref", "--short", "HEAD")
        if args.from_host == CLOUD:  # REF may be a claude.ai/code link or a session_… id too
            sid, b = cloud_ref(root, ref, data["branches"])
            b["cloud"] = sid
        elif ref == data["main"] and args.to:
            # a session on main moves its conversation only: no worktree, no marker (design E2)
            b = {"name": ref, "topic": ref, "main_move": True, "sessions": [], "elsewhere": [], "worktree": None,
                 "moved": None, "dirty": 0, "incoming": 0, "unpushed": 0, "behind_main": 0}
        else:
            b = resolve(ref, data["branches"])
        cmd_move(data, b, me, args)
        return 0
    data = collect(root, fetch=not args.no_fetch)
    if cmd == "archive":
        name = args.ref[len("origin/"):] if args.ref.startswith("origin/") else args.ref
        pb = None
        try:
            pb = resolve(args.ref, data["branches"])
            name = pb["name"]
        except Stop:
            if not name.startswith("claude/"):
                raise
        cmd_archive(root, data["main"], name, args.confirmed, pb,
                    pr_unknown=any("PR state unknown" in n for n in data["notes"]))
        return 0
    b = resolve(args.ref, data["branches"])
    if b["status"] not in LAUNCHED and not b["mine"]:
        b["peer"], b["peers"] = probe_peers(root, b)  # ssh reads, for show and open only: list stays local
    if args.json and cmd == "show":
        kind, why = plan(b, me, root)
        adv = advice(context_source(b, kind), fresh_base(root), kind=kind)
        print(json.dumps(jsonable({"this_session": me, "branch": b, "handoff": kind, "why": why, "context": adv}),
                         ensure_ascii=False, indent=1))
        return 0
    if cmd == "show":
        print_show(b, data, me)
    elif cmd == "review":
        print_show(b, data, me)
        print("\n".join(review_lines(root, data["main"], b["name"])))
    else:
        cmd_open(data, b, me, args)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Stop as e:
        print(f"pickup: {e}", file=sys.stderr)
        sys.exit(e.code)
