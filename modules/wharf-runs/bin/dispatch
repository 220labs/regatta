#!/usr/bin/env bash
# dispatch BRANCH [--repo DIR] [--at WHEN] [--on auto|HOST|here [--fallback here]] [--note TEXT] [--model M] [--effort E]
#                 [--account auto|bound|LABEL [--force]] [--headless] [--background allow|deny] [--yolo] [--if-room]
#                 [--mode default|ask|dnd|yolo] [--priority low|normal|high|force] [--origin SCOPE|MARKER] [--wait REASON] [--replace]
#                 [--needs a,b]
#                 [--after BRANCH2]... [--probe] [--dry-run]
# dispatch BRANCH --next [--repo DIR] [--on here] [--note TEXT] [--model M] [--effort E] [--headless]
#                 [--background allow|deny] [--yolo] [--mode default|ask|dnd|yolo] [--priority low|normal|high|force]
#                 [--origin SCOPE|MARKER] [--wait REASON] [--replace] [--after BRANCH2]...
# dispatch --watch QID [--for MIN]
# dispatch --status
# dispatch --slots
# dispatch --queue [--all] [--json]
# dispatch --sweep
# dispatch --claim [--event-at EPOCH]
# dispatch --claim --full HOSTS --from HOST | --claim --from-stream
# dispatch --kick QID
# dispatch --roads
# dispatch --poll
# dispatch --end TOPIC [--repo DIR]
# dispatch --requeue TOPIC|--all [--repo DIR] [--why TEXT] [--dry-run]
# dispatch --start PROMPT DIR NAME [--session-id ID] [--resume ID [--fork]] [--allow TOOL]... [--undeny TOOL]...
#                   [--model M] [--effort E] [--headless] [--dry-run]
#
# Start a seeded claude/* branch (pickup seed: its brief is docs/handoff/*-<topic>.md on the
# branch) as an unattended Claude Code session — on the dispatch host by default (Where, below) — now or once at a local time. Written
# for the first case, 2026-10-03: a session that should begin on the build Mac when the weekly limit
# resets (Sun 2026-10-04 04:00 Pacific), with nobody at a keyboard.
#
# The model and effort are opus/high unless given, or unless the brief's `Tier:` line names a principal
# tier (`principal-architect` fable xhigh, `principal-worker` opus xhigh; blueprintlib's TIER_RUN), read
# when the run fires; a given --model or --effort below that tier is refused, `--effort max` allowed.
#
# Named run-seed until 2026-10-05 (the owner: "isn't named right"). Its on-disk state keeps the old
# name — ~/Library/Caches/run-seed, …/run-seed-runs — so a run live across the rename stays
# visible to --status and the reaper; bin/run-seed is a shim for callers of the old name.
#
# The run is visible (the owner, 2026-10-04: "How can I see these runs?"): an interactive
# `claude --remote-control "<topic> · <machine>"` inside a detached `screen -S run-<topic>` (no
# tmux: a new dependency), so it shows on the phone, in VS Code's side panel (whose list hides
# every `claude -p` transcript — entrypoint sdk-cli, extension 2.1.289) and, on the laptop, in a
# Terminal window titled "run · <topic>" tiled on Desktop 5 (bin/tiling). Once its session record
# has said idle for 10 minutes after it was first busy, bin/dispatch-rc ends the claude process,
# the screen and the window, and logs the session id; a busy session is never ended. The screen
# lives in ~/Library/Caches/run-seed/screen (SCREENDIR: launchd's TMPDIR is not the shell's);
# `--status` prints the attach line. Each run's record: ~/Library/Logs/claude-weekly/run-seed-runs/.
#
# Where (the owner, 2026-10-13: "dispatch to [the build Mac] by default, not the laptop"): a run anyone
# starts goes to the dispatch host — `--on <it> --fallback here` unless a host is named — and to this
# Mac only when it does not answer; `--on here` keeps it here. --next too: the step is confirmed from
# the peer's log over ssh. The dispatch host is `wharf-runs/dispatch-host` in the regatta config dir;
# absent, the first host `wharf-runs/ssh` names (one stderr line says so); neither, none: here. Not the default for what runs here by nature: a fired job, --start, --yolo, a bare clock time,
# the --next of an unattended run here (the code's comment says why). --cancel looks on both. A run sent this way replaces a pending /later job of its branch
# on the peer (the peer cannot tell a direct run from a scheduled one there).
#
#   --headless  the run as before 2026-10-04: `claude -p`, output in the log, invisible elsewhere —
#               only when asked. Nothing falls back to it since 2026-10-13 (the owner: "always launch in
#               a terminal, never headless"): an untrusted repo is trusted first (ensure_trusted), and
#               a visible run whose session never got busy (DISPATCH_START_WAIT) is retried once,
#               visible, then FAILED.
#   --background  allow|deny: whether the session may background work (CLAUDE_CODE_DISABLE_BACKGROUND_TASKS).
#               Default deny, in both modes (the owner, 2026-10-05: "foreground process as the default"): -p
#               ends at its reply and what still runs dies unread; a visible run is ended once its
#               session has been idle 10 min, and one waiting on a background check may read as idle
#               (inferred from dispatch-rc's watch, not observed). `allow` exists to run one brief both
#               ways side by side; the log's "== background" line and the run's record say which it
#               had. The prompt is the same both ways, so only the switch differs. Side by side means
#               two branches (one branch's runs go one after another, in one worktree), each with the
#               brief under its own topic. Per step, not per chain: a --next step takes the default.
#   --account   which login runs it (work-account E5, docs/work-account-2026-10-06.md section 3): `auto`,
#               the default for a seeded run, asks `bin/account pick --repo <repo>` AT FIRE TIME on the host
#               that runs it — the limits that matter are the ones when the run starts — so a second login's row
#               first in the walk takes it unless the repo is on its deny list; LABEL takes that row,
#               refused past its rules unless --force, and in a denied repo always. Exit 3 from the pick (nobody may
#               run) is `FAILED:` with each row's reason, no retry — with a queue home, `queued again` when a reset
#               would free a row (pick_account's resets()), as a named LABEL past its limits is. No registry (exit 4): the default login,
#               as before. The pick's CLAUDE_CONFIG_DIR is exported to the run (the runner keeps it), and
#               trust is read from that dir. --next inherits the running session's account when it is an
#               enabled secondary (`account which`; a default-dir session's step stays auto); --start and --probe keep the caller's login unless --account is given.
#               `--at reset` with a LABEL is that row's weekly reset, else this Mac's default login's.
#               `bound` (the owner, 2026-10-10: "design sessions should be pinned to [the primary]") is `account pick --bound`
#               at fire time: the registry's primary row, for work the account owns — a Claude Design
#               artifact belongs to the login that published it (hooks/design_route.py sends design work
#               here). Exit 3 is FAILED as for auto. The run carries DISPATCH_PIN=bound, so its --next
#               stays bound; --force does not apply (pick --bound has no rules to cross).
#   --yolo      the unattended one-pass run (E12 of docs/autofinish-design-2026-10-02.md; D1-D3 of
#               docs/subagent-cache-2026-10-04.md, the owner: B, B, A): a brief that would stop for the owner's answers to
#               a D-list goes on instead. The prompt carries the gate: the session runs `bin/keel yolo <doc>`,
#               which answers every open item with a bare pick — `Reversible: no` included since
#               skipper-modes D1 ("--yolo goes all the way") — with `Taken unattended (<owner>'s yolo, <date>):
#               <pick>`, or stops at the first with none, a conditional or a reopened one (exit 3) and writes
#               nothing; the build then runs inline in the session. Mode yolo (--mode) is this switch. The build run keeps every guard
#               below — the prompt's "do not push … never launch", the denied list. Once it ends on its own
#               (headless: exit 0; interactive: idle 10 min after its last turn — the warm hour is
#               for a session the owner picks up again, never this one), its last reply not stopping for the owner, no
#               next step scheduled, autofinish armed here and the week not tight, its worktree clean
#               and no doc the branch changed holding an item the owner has not settled (yolo_launch's
#               gates), this script starts the launch: `autofinish-run <worktree> --rule M --by yolo` (E1's start:
#               `/finish --unattended --yolo`, whose own list lifts the push and bin/pr denials for that run only).
#               Whether it merges is the landing ladder's (skipper-modes S3b), which autofinish-run reads from
#               plan.json, not from this flag: in mode yolo it merges on any host once the check and the review
#               gate pass; a ship lowered since stops at a ready PR, labelled `hold` (docs/yolo-veto-2026-10-07.md
#               D1, kept for default and ask). A mode raised by an unattended caller is refused (--mode). The
#               log says which, or why no launch started. Per step, not per chain: a --next step is yolo only
#               when it says --yolo.
#   --if-room   at fire time, after the account pick: refuse to start when autofinish's week_tight says
#               `tight` or `none` (no account may run it), or when reading it raised. For a run scheduled
#               a week ahead (Sextant's sounding queue, `--at reset`: the Sounding design's section 5,
#               the overlay's docs/record/proposer-2026-10-16.md): it spends the week it fires in, so the budget
#               is read then, never when it was queued. No reading is room, review-gate's rule: no
#               registry, no sample, or a sample from before the reset (last week's figure) — which at
#               `--at reset` is the usual case, so there `none` is what refuses in practice. The verdict
#               alone is tested, not the tuple's detail. A refusal is `FAILED: --if-room: …` in the run's
#               log and the job is gone; the branch stays a seed, and soundings' `refresh` returns its
#               entry to the queue once the week is past. Crosses to the peer like --yolo.
#   --after     BRANCH2 (repeatable; a seed brief's `After:` line, each claude/* name on it, reads the same):
#               the step waits until BRANCH2 has landed — proved on origin/<main> by bin/landed.py, the reader
#               helm's dependency check shares (dispatch-queue S9, the owner's "add after-landed", 2026-10-28) — and
#               its run merges origin/<main> into the branch first (a merge, never a rebase; a conflict is
#               FAILED). With a queue home the entry waits and the claim judges it, every claim and sweep; with
#               none it runs only once every predecessor has landed, else is refused in the cap's waiting words.
#               An unattended caller may pass it: it only delays.
#   --mode      the sent task's mode (docs/skipper-modes-2026-10-21.md S1, S3): `default` — the prompt as
#               below, a skipper answers `Reversible: yes` asks; `ask` — nothing answers but the owner, the
#               prompt says so; `dnd` — the prompt's gate runs `keel yolo --dnd <doc>`, builds on what it
#               took and relays each item it holds (D1-A's classes); `yolo` — `--yolo`, whose gate runs
#               `keel yolo <doc>` (every bare pick, Reversible: no included; D1's answer). Written as
#               DISPATCH_MODE into the plist, the run's record (`task_mode`: the record's `mode` is rc or
#               headless) and the session's environment, and into the ship's plan.json task when the ship
#               is on this Mac. At fire time the run reads its mode again — plan.json first (`helm mode`
#               changes it mid-flight), DISPATCH_MODE a hint, then the repo's scope `mode` in repos.json,
#               then `default` (helmlib.task_mode) — so a mode changed after scheduling holds. A --next
#               keeps its run's mode, bar yolo (per step, as --yolo). Not for --start or --probe. A dnd run
#               launches as a yolo one does (S3b), `--by dnd`, and lands bar the held slice. Raising a mode —
#               --mode or --yolo above the caller's own, helmlib.raise_refusal — exits 2 under
#               CLAUDE_UNATTENDED (a fired job's plist excepted): the mode is a yes to merge, the owner's alone.
#   --on auto   the host berth picks (skipper-modes S6b; modules/wharf-runs/bin/berth): the repo's scope's
#               `berths` in repos.json crossed with its clone hosts, then slots and load. The default
#               where a host would have been defaulted (Where, below): DISPATCH_DEFAULT_ON is `auto` unless
#               set. A pick of this Mac runs here; a peer's is scheduled there with `--fallback here` only
#               when this Mac is among the candidates (a scope whose berths leave it out never falls back
#               here); no candidate is a refusal, exit 2. A host is reached by its `wharf-runs/ssh` alias
#               (`<host>:<alias>`); a berth that cannot run keeps the dispatch host (Where). With a queue
#               home the load pick retires (S5): a run now is enqueued, and a host the berths, the clone
#               hosts, the pin and the run's --needs allow claims it; berth still picks for a one-shot.
#   --needs a,b features a claiming host must have (S5 of docs/dispatch-queue-2026-10-25.md): lower-case
#               opaque names, each host's in the config's `wharf-runs/features` (`<host>:<name>,<name>`; a
#               host with no line meets none). The entry carries them; a host claims it only if its line
#               names every one. A need no host that may take the repo meets is refused at enqueue, never
#               queued (dispatch-queue enqueue exits 3; here exit 2, the cap's waiting words). `pickup seed`
#               passes a brief's `needs:` line on. No queue home: said and dropped.
#   --slots     `<busy> <cap>` for this Mac: the runs counted against the cap, and the cap (berth reads
#               a peer's over ssh, so the cap has one home).
#   --cap       this Mac's cap alone, without counting runs: bin/wharf and helm's stalls_tick ask it,
#               so the number lives only here (both carried a copy, stale at every change until 2026-10-25).
#   --status    every run of the last 7 days: running/ended, last activity, session id, VS Code link.
#               It also ends an orphan (its watcher gone, claude still there) once idle 1 min — a look
#               at the runs is when one is noticed, and a separate verb would be one more to remember.
#   --end       end TOPIC's live run now, busy or not: claude, its screen and window, its lock.
#   --requeue   hand this Mac's busy runs (TOPIC's, or --all) back to the queue with their work saved (S10 of
#               docs/dispatch-queue-2026-10-25.md; the requeue component): each op goes to the outbox first, then
#               every run is ended at once (its record's reason opens `requeued`, so this script's fire path neither
#               ends its entry, nor launches its landing, nor claims), its turn's files committed through
#               checkpoint's path, its brief given a "Continue from here" section committed as `Requeue: <topic>
#               from <host>`, the branch pushed, and the entry put back to `queued` once origin holds that tip — or
#               left owed in the outbox, which a later sweep replays branch first. By hand, before a lid closes: an
#               unattended caller is refused, and so is a Mac offline (exit 3, nothing ended); a warm run gets its
#               normal idle end, a waiting, pinned-here, confidential or --start run is named and left. `--why lid`
#               is the run watcher's, at a sleep (dispatch-rc): it goes on offline and leaves warm runs alone.
#
# Without --at, a run is scheduled a minute out rather than run in this shell: launchd then owns
# the watcher. Run in a session's Bash call, it died with that call's process tree and left claude
# and the screen running unwatched — `--status` said running, the topic's next run waited 2 h and
# failed (two runs on 2026-10-05). macOS has no setsid(1) to detach it otherwise; launchd is the
# path every scheduled run already takes. --dry-run still runs here.
#
# The queue (S1 and S2's first half of docs/dispatch-queue-2026-10-25.md; bin/dispatch-queue's header has the mechanics): once a
# home is configured (`wharf-runs/queue-repo`, set on purpose: no fallback yet), a run now on this Mac — a direct
# run, a --next — is an entry on the fleet's queue ref, one per branch, and this Mac claims what it has room
# for, best first (force, high, normal, low, then age), starting each at once through a RunAtLoad job that
# runs `dispatch BRANCH … --from-queue STORE:KEY`. A full Mac leaves the entry queued, and the caller — a
# direct run or a --next alike — gets exit 0 and the one closing line (S3, below); a one-shot (--at) enters
# the queue at its fire time, aged from WHEN. A fired run refused by the cap,
# memory or the account pick goes back into the queue, the host noted (it skips the entry an hour, bar one pinned to it), never
# lost; any other end before its record removes a claimed entry with a card. A run's end removes its entry
# only while the entry is still its own, so a live run's --next — pinned to that run's host, which after()
# needs — survives it. A branch live on another host is refused here (one branch, one host). Each claim
# holds a slot until its record exists; the cap and --slots count it. A confidential scope's runs queue
# node-local (the confidential note); a torn registry refuses. No home: every path is as before the queue.
#   --priority  low|normal|high|force, default normal: the entry's rank, and `prio` in the record (S4 of
#               docs/dispatch-queue-2026-10-25.md, D2-A and D3-A). Apart from --force, the account override.
#               force: the claiming host starts it one slot over its cap (at most one run ever above it; a
#               second force entry waits first in line) and on headroom's force floor (--floor 5: avail 5 %,
#               swap and rate kept). Who may: an attended session high on its own judgement; force only on
#               the owner's words — the session's force mark (hooks/force_mark.py: "use the force" in the
#               owner's typed message), spent once the dispatch that uses it lands — or typed outside any
#               session (no claude among dispatch's ancestors: dispatch-queue force-ok).
#               An unattended caller never raises: a --next inherits its own run's rank from its record
#               (the record whose claude is an ancestor of this dispatch, never a session id), force as
#               high; a --priority high it names passes only when that record is high, force never.
#   --queue     the entries this Mac could run, or every one (--all); --json for a reader, whose rule is that
#               an unreadable queue counts as an entry (dispatch-queue has: exit 4).
#   --sweep     the outbox, this Mac's own entries reconciled with its records, cards, then a claim — what the
#               queue-sweep job runs every 10 min on every Mac with a home (dispatch-queue jobs, run as each
#               run starts and at each enqueue here, installs it; `regatta check` names a Mac without it).
#   --claim     claim what this Mac has room for now: what a run's watcher runs when its run turns parked or
#               ends with no fire path behind it (dispatch-rc); --event-at, when the slot freed (G3's start).
#   --poll      one pass of the pending poll, the 60 s job loaded only while entries pend on a Mac no kick
#               road reaches and with room (dispatch-queue poll). Without a home, each is a no-op.
#   --kick QID  kick every eligible peer of a queued fleet entry over its roads (S8; bin/kicklib.py: a spacesheep
#               press, an Orca terminal, an ssh alias, in the order `wharf-runs/kick-roads` names them, else what
#               exists), each verdict in claude-weekly/kicks.jsonl; the payload names hosts only. Refused for a
#               node-local entry or from a confidential checkout. An enqueue here kicks by itself, detached, for a
#               fleet entry it did not take; nothing kicks where no kick-roads file is.
#   --claim --full HOSTS --from HOST, --claim --from-stream  the receiver of a kick (ssh and Orca; the sheep
#               button reads the press's SS_STREAM_DATA): notes it and kickstarts this Mac's queue-sweep job,
#               which holds back 3 s per higher-ranked berth of unknown room (9 s at most) and then claims.
#   --roads     the kick-roads lines what exists here gives, for the overlay to write.
# The caller's contract (S3; docs/dispatch-queue-contract-2026-10-25.md): dispatch, hand off, close — wait
# only with a reason, never retry. Once the queue holds the step the caller ends its turn on the line
# dispatch prints, `<the WAITING FOR SOMETHING prefix>queued <branch> (<priority>); the next step waits for
# a run to end; the skipper finishes it` — the `pending` closing kind, whose words the Stop hook's
# ASK_EXEMPT_RE and helm's CAP_RE pass — and its own branch is handed off (common.handed_off), so its run
# ends and its window closes once it idles. The readers read the queue first: helm's stalls a queued branch
# as `queued`, never S1's retry; autofinish holds a branch with an entry, session or none.
#   --wait REASON  the caller waits for this run rather than ending: the reason is named in the entry (its
#               waiter), and dispatch prints the one way to wait, `dispatch --watch <entry>`.
#   --watch QID [--for MIN]  block on an entry, printing each state (this Mac's reservation first, then the
#               home every 15 s); exit 0 once it runs, 3 once it is gone, 1 when --for passes. Never dispatches.
#   --replace   take over the branch's entry: a claimed, waiting or running one (the step is queued behind
#               it, pinned to the host it is live on unless --on here or a login label pins it) or another
#               live session's queued one — refused without.
#   --wait and --replace go with a run now through this Mac's queue: refused with --at or a typed --on HOST,
#               ignored (and said) with no queue home on any other road. With no --on they keep the run here, past the default
#               host (berth's pick): its one-shot there would have no entry for them.
#
# Limits (review of 2026-10-05: nothing bounded an unattended chain):
#   - a run is ended at DISPATCH_MAX_H hours (default 8) even if never idle, and caffeinate ends with it;
#     a run that goes idle is kept for DISPATCH_IDLE (the prompt cache's hour, the owner 2026-10-06) with
#     caffeinate released, and its window closed once it is dead or cold (dispatch-rc tidy); a
#     --start run keeps the old 10 min, since its caller waits on the watcher (autofinish-run);
#   - a chain of runs, each started by the one before, stops at depth DISPATCH_MAX_DEPTH (5):
#     DISPATCH_DEPTH travels in the plist and the session's environment;
#   - `--next` from an unattended run is refused while the branch's newest brief is the very one
#     that run started from (DISPATCH_BRIEF, the brief's blob): it would run the same step again;
#   - a run starts only while fewer than $max_runs other runs are busy — 6 on the dispatch host, 3
#     elsewhere (the owner, 2026-10-08, 2026-10-19, 2026-10-20, 2026-10-23, 2026-10-25), DISPATCH_MAX_RUNS
#     over either; a warm, idle run does not count (D1 of docs/dispatch-warm-hour-2026-10-08.md), nor one
#     waiting at a prompt or a question (dispatch-rc parked(); the owner, 2026-10-08: "don't clog the
#     pipeline"). A host whose memory is past its wharf-runs/headroom line has no room either, whatever its
#     count (bin/headroom, 2026-10-22). With no room the run is queued, never refused (S3 of
#     docs/dispatch-queue-2026-10-25.md): the caller gets `queued as <entry>` and the one closing line, exit 0,
#     and a fire-time refusal says `queued again: <why>`. This supersedes the 2026-10-08 rule, "refused, not
#     queued: a queue would need a waiter that outlives the scheduler" — the queue's ref and its claims are
#     that waiter (the owner, 2026-10-25: "it still shouldn't be the session's job to repeatedly try to
#     dispatch"). A Mac with no queue home (wharf-runs/queue-repo) still refuses, as before it;
#   --at     WHEN is `reset` (the next weekly limit reset + 10 min — what /later uses by default),
#            `reset+MIN`, "YYYY-MM-DD HH:MM" in the target host's local time, or `@EPOCH`.
#            Writes a one-shot launchd job (<prefix>.dispatch.<repo>.<topic>.<YYYYmmddHHMM>; the prefix
#            is `wharf-runs/label-prefix` in the regatta config dir, else org.regatta.claude) that
#            runs this script once and then removes itself. launchd's calendar interval has no year,
#            so a job that did not remove itself would fire again next year. Scheduling replaces the
#            branch's other jobs except one launchd reports running: that is a run going on now,
#            maybe the caller's own. One label per scheduled run, because a run that scheduled its
#            successor under its own label booted itself out — launchd ends the job's whole process
#            tree — and died at its last step with exit 137, the successor never scheduled (model
#            gate S3, 2026-10-04). "Schedule once this job has exited" is no alternative: whatever
#            would wait for that is in the same process tree; only another job outlives it. A run
#            that fires while an earlier run of its branch is alive waits for it to end (up to
#            DISPATCH_PREV_WAIT s, default 2 h); the earlier run, idle, is then ended after 1 min, not 10.
#   --on     schedule it on a peer over ssh: HOST is one `wharf-runs/ssh` names (<host>:<ssh alias> a
#            line, compared case-blind); any other name is refused, listing the ones it holds. The
#            peer runs its own core (its config dir's `home`). The time is resolved here to an epoch
#            and turned into that host's local clock there, so a timezone gap cannot move it.
#            `--fallback here` (the owner, 2026-10-10: "auto-dispatch to [the build Mac] (run locally as
#            fallback)"): a 10-second probe first (ssh ConnectTimeout, BatchMode — the host entry sets
#            no timeout, and an asleep peer would hold the connect for the OS's ~75 s); on its exit
#            255 (unreachable), or a peer whose dispatch predates `--account bound`, the run is
#            scheduled on this Mac instead, at least 90 s out, through this Mac's own checks
#            (`physical:`), and says so. Once the probe passed, the real call is made and its
#            answer stands: a dropped connection after the peer scheduled can never put the branch
#            on both hosts. A run the peer accepts and refuses at fire time (its cap of 6) is in
#            the peer's log. --cancel with --on cancels there only; with no host, here and on the dispatch host.
#            `--account bound` over ssh always carries that version guard (exit 3 without
#            --fallback): the peer's checkout pulls main only at a session start (review 2026-10-10).
#   --note   extra instructions appended to the brief — a build-now/measure-later split goes here,
#            because the brief says what "done" is and a run before its inputs exist cannot meet it.
#   --origin the confidential scope a seed came out of (`pickup seed --from`, confidential-reach S5): the
#            core's scope_marker() `confidential:<8 hex>` as the seed commit carries it, or a scope's name.
#            A marker is read back against this host's registry (common.scope_of_marker) and refused
#            when no confidential scope here has it, or the registry will not read; given twice, refused.
#            Carried as given to the dispatch host and a scheduled job, and as its marker alone in a
#            queue entry, which queues node-local (dispatch-queue's route: queue-local/_spawn/, never
#            the fleet ref, until S6 reviews a spawn at claim); a claimed job it refuses hands its entry
#            back (refused), never left claimed; the run's record keeps the
#            scope's name as `origin` (local state; nothing pushed names it) and the marker as
#            `origin_mark`. Recorded only here: refusing a confidential origin without its review is S6's.
#   --next   a finished step starts the next one itself, on the dispatch host (header, Where), in about two minutes — instead of a
#            prompt for the owner to paste (the owner, 2026-10-04: "I don't have time to copy-paste prompts for
#            you"). The sequence the model gate S3 proved that day, so no session re-derives it: the
#            branch's brief (docs/handoff/*-<topic>.md) committed and its worktree clean; the branch
#            pushed (your own claude/* branch — what the checkpoint hook does anyway, now rather than
#            at session end, so the run fetches this commit); this session's lock on that worktree
#            freed (another live session's is refused); --at now + 90 s; then it waits for the run's
#            header in the log and fails unless the run is still going 20 s later. Blocks up to
#            about 3 min: give the Bash call a 300000 ms timeout. A session that entered the
#            worktree leaves it (ExitWorktree, keep) right after and writes nothing more there.
#            A run that is a block of a ship (its DISPATCH_SHIP (or DISPATCH_PLAN) and DISPATCH_TASK name a block with a
#            successor in the plan's blueprint: `wharf next`) starts nothing here: the successor is the
#            blueprint's next block and `wharf apply` (the tick or the skipper) starts it; --next says
#            so and exits 0 (wharf-on-orca S5, B9). Any other caller — a seed, wharf's own start, the
#            last block — is scheduled as before; a check that fails (exit 2) stops with its message.
#            For a fresh seed: `pickup seed TOPIC --file BRIEF --no-start`, then this. Here, not a
#            `pickup next`: every step but the push and the lock is this script's own scheduling and
#            log, and its tests already stand in for launchd. A worktree lock marked `handover`
#            (pickup next, 96f3c9d) counts as free.
#   --probe  the visible path with the prompt "reply with the single word ok", in the repo, no
#            worktree: Remote Control in a screen, ended by the watcher once idle (1 min), the answer
#            logged as "probe answered: ok". Proves a launchd-started claude is logged in and the
#            interactive path works. Under launchd the login is the GUI session's, not the SSH
#            shell's CLAUDE_CODE_OAUTH_TOKEN, and that difference is exactly what to test.
#            With --headless: `claude -p "reply …"` as before.
#   --start  the visible run for a caller with its own trigger and its own prompt — bin/autofinish-run
#            (docs/autofinish-design-2026-10-02.md E1): PROMPT, as it is, in the worktree DIR (its
#            branch, its repo), now and in this process, which returns once the watcher has ended
#            the session (exit 3: never busy; no headless retry — the caller decides about another
#            start). Remote Control "NAME · <machine>", window "run · NAME · <repo>", the run's topic
#            NAME as a slug. --session-id is the caller's, so it can write the worktree lock before
#            the start; --allow adds to the allowlist below and --undeny takes an exact entry off the
#            denied list (an entry not there is refused: the lists stay this file's). The start lock,
#            the run cap, the trust step and the watcher are a run's as above; no
#            `physical:` check, no brief, no chain depth check: those are the caller's. The caller
#            detaches it — run in a Bash call, it dies with the call (header). --dry-run prints the
#            script screen would run, claude's whole command line included. A landing — /finish of the
#            worktree's own claude/* branch, judged from PROMPT and DIR, never a flag — that meets the cap or
#            the memory line with a queue home here waits in the queue instead of FAILED (dispatch-queue S9,
#            night landings' finding 8): `queued as <qid> (a landing), …`, then this process blocks until a
#            claim here takes it (ranked above every build but force) and runs it as above. Its prompt and
#            lists, and so its merge rights, never leave this process; autofinish-run reads that line as its
#            `queued` verdict.
#            --launch is its old name, kept as an alias for a week (S8 of docs/wharf-rename-2026-10-16.md
#            drops it): a runner loaded before the rename still calls it; "launch" is the release verb now.
#            --resume ID continues that session instead of starting a fresh one (bin/harness V2,
#            orchestration B5; the owner's open D9 of docs/orchestration-2026-10-11.md — this is its option A,
#            in a commit of its own, so B or C reverts it whole): PROMPT is the next turn. Without --fork
#            the session keeps its id, so --session-id is refused (claude 2.1.300: "--session-id can only
#            be used with --continue or --resume if --fork-session is also specified"); with --fork, claude
#            copies the transcript under a new id — --session-id's, else a fresh one — and leaves the
#            original as it was. The record names the session it came from (`resumed_from`). Known gap:
#            dispatch-rc's watcher reads "the transcript holds an answer" as busy (replied()), and a
#            continued transcript already holds one, so a continued run is never "never busy" (exit 3): one
#            stuck before its first turn is ended idle instead, after the same 10 minutes.
#
# The run writes in a worktree of its own (the primary stays on main) on the branch as it is on
# origin. It never launches: the checkpoint hook commits and pushes the branch, /finish merges. The
# guards are the prompt, hooks/checkpoint.py (command text; it runs under -p) and the repo's
# pre-push (refs), and a repo whose contract says `physical: none` (refused otherwise);
# --disallowedTools is a habit guard only — a wrapper (`bash -c`, `python3 -c`) passes it, so the
# allowlist names no interpreter wildcard and leaves wrappers to the classifier. Headless, with
# no host to answer --permission-prompts, anything that would prompt is denied (probed), so the
# mode is `auto`, as interactive sessions run: acceptEdits + an allowlist refused git fetch/merge,
# web and curl in four of seven runs on 2026-10-04 (docs/record/run-seed-permissions-2026-10-04.md).
# The allowlist only spares the classifier read-only and commit calls. Interactive (the default
# since 2026-10-04), a call that would prompt may wait at its prompt instead of being denied —
# answerable from the phone — and the watcher ends only an idle session; neither is probed yet.
# `reset` is read from THIS
# Mac's plan cache: it is the reset of the account signed in here, so state which account the
# job will run under. Log: the path printed when scheduled (~/Library/Logs/claude-weekly/).
# DISPATCH_NEXT_DELAY, _WAIT and _SETTLE time --next (seconds: start, give up, still running);
# DISPATCH_HOST names the machine (the laptop gets the window; the dispatch host's run cap is 6); the tests replace commands with
# DISPATCH_SCREEN, _OPEN, _YABAI (and dispatch-rc's _POLL, _IDLE, _START_WAIT seconds),
# DISPATCH_RCHOSTS bin/rc-hosts (asked whether claude-host may start the job and the claude: --launcher),
# DISPATCH_CLAUDE the `claude` command and DISPATCH_LAUNCHCTL `launchctl`.
set -uo pipefail
# Named run-seed until 2026-10-05: a job scheduled before then, and a session it started, still
# carry RUN_SEED_*, and its session's hooks and skills now call this name directly — so the chain
# depth and the unchanged-brief guard hold across the rename (review of 2026-10-05).
for v in LABEL LOG YEAR DEPTH BRIEF; do
  o="RUN_SEED_$v"; n="DISPATCH_$v"
  if [ -n "${!o:-}" ]; then [ -n "${!n:-}" ] || export "$n=${!o}"; unset "$o"; fi
done
here="$(cd "$(dirname "$0")/.." && pwd)"   # this module (wharf-runs), anchored on this script, never the caller's cwd
# The regatta core (lib/core_path.py, C2) and the peers it finds (common.tool): keel (M4), account and
# trust-projects (lighthouse, G12), ask and helm (helm, G22; the overlay's until B12). One call, read
# once; a missing peer is an empty value and its caller's fallback.
core=""; overlay=""; p_account=""; p_trust=""; p_keel=""; p_ask=""; p_helm=""
# The private values (the scrub's conventions): the peers and their ssh aliases (`wharf-runs/ssh`,
# <host>:<alias> a line), the dispatch host (`wharf-runs/dispatch-host`), the launchd label prefix
# (`wharf-runs/label-prefix`, and `wharf-runs/label-prefix-previous`: the one before a move, whose jobs
# are still ours while they drain — found and cleared, never written), the laptop and the owner (the core's), the projects folder. Read
# through the core; where it cannot load (a config the overlay left incomplete), the files
# themselves, so a missing key is a default and never a broken run.
peers=""; dhost=""; lprefix="org.regatta.claude"; lprev=""; laptop="laptop"; owner=""; handover=""; pendpre=""; projects="$HOME/projects"; qkeys=""
eval "$(python3 - "$here" <<'CORE'
import os, shlex, sys
sys.path.insert(0, os.path.join(sys.argv[1], "lib"))
import core_path
out = {"core": core_path.add() or ""}
try:
    import common
except ImportError:
    common = None
cfg = os.path.expanduser(os.environ.get("REGATTA_CONFIG") or "~/.config/regatta")
def lines(name):
    if common:
        return common.config_lines(name) or []
    try:
        with open(os.path.join(cfg, name), encoding="utf-8-sig") as f:
            return [l.strip() for l in f if l.strip()]
    except (OSError, ValueError):
        return []
def first(name, default=""):
    return (lines(name) or [default])[0]
out["peers"] = " ".join("%s:%s" % (n.strip(), a.strip()) for n, a in
                        (l.split(":", 1) for l in lines("wharf-runs/ssh") if ":" in l) if n.strip() and a.strip())
out["dhost"] = first("wharf-runs/dispatch-host")
out["lprefix"] = first("wharf-runs/label-prefix", "org.regatta.claude")
out["lprev"] = first("wharf-runs/label-prefix-previous")
out["lprev"] = "" if out["lprev"] == out["lprefix"] else out["lprev"]
out["laptop"] = common.LAPTOP if common else (os.environ.get("REGATTA_LAPTOP") or first("regatta/laptop", "laptop"))
out["owner"] = common.OWNER_NAME if common else first("regatta/owner")
out["handover"] = common.marked("handed", common.HANDOVER_LINE) if common else ""   # ⏳ first: MARKS in the core (no apostrophe: bash 3.2 heredoc)
out["pendpre"] = common.marked("pending", common.PENDING_PREFIX) if common else ""   # the closing line of a queued step opens with it (S3)
out["projects"] = str(common.PROJECTS) if common else os.path.expanduser("~/projects")
# whether a queue home may be configured (queue_on asks bin/dispatch-queue only then): its key's file —
# `wharf-runs/queue-repo` alone until S2 (dispatch-queue's header: no helm/logbook-repo fallback yet)
out["qkeys"] = "1" if os.path.exists(os.path.join(cfg, "wharf-runs/queue-repo")) else ""
if common:
    old = common.overlay_root()
    if old and (old / "bin").is_dir():
        # its main checkout, as the old code anchored on its own: a worktree goes away at /finish
        import subprocess
        gd = subprocess.run(["git", "-C", str(old), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
        out["overlay"] = os.path.dirname(gd) if gd.endswith("/.git") else str(old.resolve())
    for var, name in (("p_account", "account"), ("p_trust", "trust-projects"), ("p_keel", "keel"),
                      ("p_ask", "ask"), ("p_helm", "helm")):
        found = common.tool(name)
        out[var] = str(found) if found else ""
for k, v in out.items():
    print("%s=%s" % (k, shlex.quote(v)))
CORE
)"
# The run prompt names helm's own files, which tool() finds (bin/ask, libexec/helm), since B14a
# (2026-10-23): until then it named the overlay's shims, the paths each account dir's allow rules
# named. The overlay's bootstrap.sh --hooks writes rules for the module paths since that step, and it
# runs on both Macs before this lands — a run refused its report stalls its ship (S5 review).
# DISPATCH_ASK, DISPATCH_HELM: the tests' stand-ins; set but empty is "not installed" (G22's case)
[ -n "${DISPATCH_ASK+x}" ] && p_ask="$DISPATCH_ASK"
[ -n "${DISPATCH_HELM+x}" ] && p_helm="$DISPATCH_HELM"
# the check runner the run prompt names: this module's own, in the checkout dispatch runs from (since
# B14b every helper names the module path; no allow rule names it, the classifier judges the call)
p_check="$here/bin/check"
[ -n "$core" ] || { echo "dispatch: the regatta core is missing — install the \`regatta\` plugin, or name a clone in the regatta config dir's \`home\` file" >&2; exit 2; }
# The default repo: the overlay's checkout where one is installed (the config dir's `regatta/overlay`),
# else the main checkout of the clone this file sits in — never a worktree, whose branch is not the run's.
# The job's script path likewise: the overlay's shim (the path its jobs always named, kept for good:
# claude-host starts only the overlay's scripts, B14a's D2), else this module in the main checkout; a
# worktree's copy goes away at /finish.
mainco="$(cd "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P)"
primary="${overlay:-$mainco}"
jobbin="$mainco/modules/wharf-runs/bin/dispatch"
[ -n "$overlay" ] && [ -f "$overlay/bin/dispatch" ] && jobbin="$overlay/bin/dispatch"
RCH="${DISPATCH_RCHOSTS:-$here/bin/rc-hosts}"
LC="${DISPATCH_LAUNCHCTL:-launchctl}"
# The launcher (dispatch-queue S7's Linux half): launchd's launchctl on a Mac, as before; elsewhere this module's
# systemd-launchctl, the same verbs over systemd's user manager (its header says why one shim). Every job below
# goes through $LC and every job's plist stays in $LA, so this line is the whole seam. $OSTYPE, not uname: no fork
case "${DISPATCH_LAUNCHCTL:-}$OSTYPE" in darwin*) ;; linux*) LC="$here/bin/systemd-launchctl";; esac
# this host's name, as the config keys and the queue spell it: macOS's LocalHostName, else the kernel's short one,
# lower-cased and every character but [a-z0-9-] a hyphen — the core's host_name() exactly, which dispatch-queue
# reads, so `srv_01` is one host to both (the landing review)
local_host() { { scutil --get LocalHostName 2>/dev/null || hostname -s; } | tr 'A-Z' 'a-z' | sed -e 's/[^a-z0-9-]/-/g' -e 's/^-*//' -e 's/-*$//' -e 's/^$/host/'; }
# BSD date on a Mac, GNU elsewhere (AGENTS.md's date trap), each failing cleanly on the other: an epoch's local
# time in FORMAT (dateat EPOCH +FORMAT), and a local "YYYY-MM-DD HH:MM" as an epoch (epochof)
dateat() { date -r "$1" "$2" 2>/dev/null || date -d "@$1" "$2"; }
epochof() { date -j -f '%Y-%m-%d %H:%M' "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null; }
lc() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }   # host names compare lower-case (bash 3.2 has no ${x,,})
# --on NAME: a host `wharf-runs/ssh` names, case-blind -> $pname (as the key spells it) and $peer (its
# ssh alias); 1 when the key names no such host
peer_of() {
  local p
  for p in $peers; do
    [ "$(lc "${p%%:*}")" = "$(lc "$1")" ] && { pname="${p%%:*}"; peer="${p#*:}"; return 0; }
  done
  return 1
}
unknown_host() {
  local p names=""
  for p in $peers; do names="$names${names:+, }${p%%:*}"; done
  echo "dispatch: unknown host $1 — wharf-runs/ssh names ${names:-no host}; or here" >&2; exit 2
}
pname=""; peer=""
# The dispatch host: the build Mac a run goes to when nobody names one (header, Where), and the one
# with the larger cap below. `wharf-runs/dispatch-host`; absent, the first host `wharf-runs/ssh`
# names, said once on stderr where the default is taken; neither, none (runs stay here).
dispatch_host="$dhost"; dh_note=""
if [ -z "$dispatch_host" ] && [ -n "$peers" ]; then
  dispatch_host="${peers%% *}"; dispatch_host="${dispatch_host%%:*}"
  dh_note="dispatch: no wharf-runs/dispatch-host in the regatta config — taking $dispatch_host, the first host wharf-runs/ssh names"
fi
# Runs live at once before another is refused. The build Mac (10 cores, 16 GB, never sleeps)
# takes 6; the laptop keeps 3, its own sessions share it (the owner, 2026-10-08: "increase
# [the build Mac's] capacity to 5"; 2026-10-19, the regatta build at 5 runs left the build Mac at
# load 6 on 10 cores while the laptop sat at 150: "bump [its] concurrent run to 8, see if it can
# sustain that load"; 2026-10-20, "push [it] to 10 actually, it's going too slow"; 2026-10-23, back
# to 8: at 10 the build Mac sat at load 110-130 for hours (uptime that evening) with its CI runner
# beside the runs, and every check there took twice its quiet time; 2026-10-25, 6: "it's too slow" at 8). So: 6 on the
# dispatch host, 3 on any other Mac. DISPATCH_MAX_RUNS overrides either; DISPATCH_HOST is
# machine()'s, for the tests. The only home of these numbers: every other reader asks `--cap`.
self_host="${DISPATCH_HOST:-$(local_host)}"
if [ -n "$dispatch_host" ] && [ "$(lc "$self_host")" = "$(lc "$dispatch_host")" ]; then
  max_runs="${DISPATCH_MAX_RUNS:-6}"
else
  max_runs="${DISPATCH_MAX_RUNS:-3}"
fi
# The queue (header, The queue): bin/dispatch-queue, handed the facts this file holds the one home of.
# queue_on asks once whether a home is configured; without one, every path below is as before it.
Q="${DISPATCH_QUEUE_BIN:-$here/bin/dispatch-queue}"   # the tests stand one in: a queue verb that crashes
QG="$here/bin/dispatch-queue"   # the rank gates (force-ok, caller-prio) never take the stand-in: a variable is no gate
qctx=(--host "$self_host" --cap "$max_runs" --jobbin "$jobbin" --prefix "$lprefix" --launchctl "$LC" --rch "$RCH")
[ -z "$lprev" ] || qctx+=(--prefix-previous "$lprev")   # the queue's jobs under it are dropped once the new sweep loads
queue_on() {
  if [ -z "${qhome+x}" ]; then
    # no queue-repo key in the config dir (qkeys, read with the core above): no home, without one more python start
    if [ -n "$qkeys" ]; then qhome=$(python3 "$Q" home 2>/dev/null); else qhome=""; fi
  fi
  [ -n "$qhome" ]
}
# the queue's jobs (dispatch-queue jobs): the sweep where a home is, neither where none is — a plist compare
# when nothing changed, and no python at all with no queue key and no job left behind (S2)
queue_jobs() {
  [ -n "$qkeys" ] || ls "$LA/$lprefix".queue-*.plist >/dev/null 2>&1 || { [ -n "$lprev" ] && ls "$LA/$lprev".queue-*.plist >/dev/null 2>&1; } || return 0
  python3 "$Q" jobs "${qctx[@]}"
}
# the slots this host reserved for claims whose run has no record yet, bar this run's own (dispatch-queue reserved)
qreserved() {
  local r ex="${fromq:-$landq}"   # a queued landing's own claim (S9) is this run's slot, as a fired job's is
  # one python start, not two: no queue key and no claims folder is no reservation (the fourth review's item 14)
  [ -n "$qkeys" ] || [ -d "$cache/queue/claims" ] || { echo 0; return; }
  r=$(python3 "$Q" reserved "${qctx[@]}" ${ex:+--except "$ex"} 2>/dev/null)
  case "$r" in ''|*[!0-9]*) echo 0;; *) echo "$r";; esac
}
who="${owner:-the owner}"   # text addressed to the owner (common.OWNER_NAME)
# The line a yolo or dnd run ends on to hand its landing to yolo_launch (yolo-launch, 2026-10-25): the
# core's HANDOVER_LINE, a WAITING FOR SOMETHING line of its own closing kind, `handed`. Until then the
# prompt named no line, the house rules made each run write its own, and yolo_launch read every one as
# "waits on its own work": two runs on 2026-10-24 (b14b-shrink, hookwatch-date) waited on dispatch while
# dispatch declined, each landing found by hand. The kind lives in the core so that dispatch, dispatch-rc
# (ends the run at once) and helm (raises a launch that never started) read one fact (review D1-B).
# no apostrophe inside a ${…}: bash looks for its closing quote there, even within double quotes, and
# the script's parse runs away (this line's first form broke every dispatch call)
[ -n "$handover" ] || handover="THIS SESSION IS WAITING FOR SOMETHING — dispatch's launch (autofinish-run)"
handnext="${handover%% — *} — <the next step, in one line>"   # a dnd step that scheduled the next one
[ -n "$pendpre" ] || pendpre="THIS SESSION IS WAITING FOR SOMETHING — "
# Memory beside the cap (2026-10-22: six runs left a 16 GB host thrashing, load 65 and swap full,
# with four slots still free): bin/headroom reads this host's memory against its wharf-runs/headroom
# line. Over it (exit 3), prints why and fails — the run is refused as at the cap; anything else that
# is not 0 (unreadable, or a crash: Python's own exit 1) says so on stderr and passes, since a broken
# probe must not stop every run. Sampled before the start lock: it sleeps 2 s.
roomy() {
  local why rc fl=()
  # the force's floor (D2-A): avail lowered to dispatch-queue's FLOOR, swap and rate kept
  [ "$prio" = force ] && fl=(--floor "$(python3 "$QG" floor 2>/dev/null || echo 5)")
  why=$(python3 "$here/bin/headroom" check ${fl[@]+"${fl[@]}"}); rc=$?
  [ "$rc" = 3 ] && { echo "$why"; return 1; }
  [ "$rc" = 0 ] || echo "dispatch: no memory reading ($why) — going ahead" >&2
  return 0
}
# The cap this run's start meets here: force's one slot over it (dispatch-queue's cap_for, the one home of
# the rule, asked only for a force run: one python start where it matters)
pcap() {
  local c
  if [ "$prio" = force ]; then
    c=$(python3 "$QG" cap --priority force "${qctx[@]}" 2>/dev/null)
    case "$c" in ''|*[!0-9]*) echo "$max_runs";; *) echo "$c";; esac
  else echo "$max_runs"; fi
}
origin_re='^([A-Za-z0-9][A-Za-z0-9._-]*|confidential:[0-9a-f]{8})$'
needs_re='^[a-z0-9][a-z0-9._-]{0,39}(,[a-z0-9][a-z0-9._-]{0,39})*$'   # dispatch-queue's NEED_RE, comma-joined
branch=""; repo="$primary"; repo_given=""; at=""; on=""; cancel=0; next=0; note=""; origin=""; model="opus"; effort="high"; model_given=0; effort_given=0; probe=0; dry=0; headless=0; end=""; bg=""; yolo=0; mode=""; mode_given=0
account=""; force=0; fallback=""; on_here=0; on_typed=0; on_default=0; at_default=0; on_auto=0; ifroom=0
start=0; lprompt=""; ldir=""; lname=""; lsid=""; lresume=""; lfork=0; extra_allow=(); undeny=()
prio=normal; prio_given=0; fromq=""; qdone=0; sweep=0; qverb=""; evat=""; waitwhy=""; replace=0; needs=""
kfull=""; kfrom=""; kstream=0; kick=""   # S8: the receiver's payload, the sheep button's, and --kick QID
requeue=0; rqtopic=""; rqall=0; rqwhy=""   # S10: dispatch --requeue TOPIC|--all [--why]
afters=(); brief_afters=(); landq=""   # S9: --after's predecessors; a queued landing's own queue id (dispatch --start, no room)
# before the flags: --slots counts the queue's claims (qreserved) under $cache, and every later home path is
# written through it, $LA or $runs (S2a's landing review, item 2: a public line names no $HOME path of its own)
cache="$HOME/Library/Caches/run-seed"; lockd="$cache/start.lock"
while [ $# -gt 0 ]; do
  case "$1" in
    --start|--launch) [ $# -ge 4 ] || { echo "dispatch: --start PROMPT DIR NAME" >&2; exit 2; }
              start=1; lprompt="$2"; ldir="$3"; lname="$4"; shift 4;;
    --session-id) lsid="$2"; shift 2;;
    --resume) lresume="${2:-}"; [ -n "$lresume" ] || { echo "dispatch: --resume takes a session id" >&2; exit 2; }; shift 2;;
    --fork) lfork=1; shift;;
    --allow) extra_allow+=("$2"); shift 2;;
    --undeny) undeny+=("$2"); shift 2;;
    --repo) repo="$2"; repo_given=1; shift 2;;
    # once: the last would win, so `--at reset --at <clock>` would pass a rule pinned to `--at reset`
    # (the sounding queue's allow rules in aurora's weekly-run; the S7 /finish review's R5)
    --at) [ -z "$at" ] || { echo "dispatch: --at given twice" >&2; exit 2; }; at="$2"; shift 2;;
    --note) note="$2"; shift 2;;
    --origin) [ -z "$origin" ] || { echo "dispatch: --origin given twice" >&2; exit 2; }; origin="${2:-}"
      # [[ =~ ]], not grep: grep matches line by line, so a value with a newline passed (S5's landing re-review)
      [[ $origin =~ $origin_re ]] \
        || { echo "dispatch: --origin takes a scope's name or its confidential:<8 hex> marker" >&2; exit 2; }; shift 2;;
    --model) model="$2"; model_given=1; shift 2;;
    --effort) effort="$2"; effort_given=1; shift 2;;
    --probe) probe=1; shift;;
    --account) account="${2:-}"; [ -n "$account" ] || { echo "dispatch: --account takes auto or a label" >&2; exit 2; }; shift 2;;
    --force) force=1; shift;;
    --dry-run) dry=1; shift;;
    --on) on="${2:-}"; [ "$(lc "$on")" = here ] && { on=""; on_here=1; on_typed=1; }; [ "$(lc "$on")" = auto ] && { on=""; on_auto=1; }; shift 2;;
    --fallback) fallback="${2:-}"; [ "$fallback" = here ] || { echo "dispatch: --fallback takes here" >&2; exit 2; }; shift 2;;
    --cancel) cancel=1; shift;;
    --next) next=1; shift;;
    --headless) headless=1; shift;;
    --yolo) yolo=1; mode_given=1; shift;;   # mode yolo, written to plan.json as --mode yolo is (landing review 11)
    --if-room) ifroom=1; shift;;
    --mode) mode="${2:-}"; case "$mode" in default|ask|dnd|yolo) mode_given=1;; *) echo "dispatch: --mode takes default, ask, dnd or yolo" >&2; exit 2;; esac; shift 2;;
    --background) bg="${2:-}"; case "$bg" in allow|deny) ;; *) echo "dispatch: --background takes allow or deny" >&2; exit 2;; esac; shift 2;;
    --priority) prio="${2:-}"; case "$prio" in low|normal|high|force) prio_given=1;; *) echo "dispatch: --priority takes low, normal, high or force" >&2; exit 2;; esac; shift 2;;
    --from-queue) fromq="${2:-}"; [ -n "$fromq" ] || { echo "dispatch: --from-queue takes a queue id" >&2; exit 2; }; shift 2;;
    --queue) shift; exec python3 "$Q" list "$@" --host "$self_host";;
    --sweep) sweep=1; shift;;
    --wait) waitwhy="${2:-}"; [ -n "$waitwhy" ] || { echo "dispatch: --wait takes a reason: why this session waits for the run rather than ending" >&2; exit 2; }; shift 2;;
    --watch) shift; [ -n "${1:-}" ] || { echo "dispatch: --watch takes a queue id (dispatch --queue names each)" >&2; exit 2; }
             exec python3 "$Q" watch "$@" "${qctx[@]}";;
    --replace) replace=1; shift;;
    --needs) [ -z "$needs" ] || { echo "dispatch: --needs given twice" >&2; exit 2; }; needs="$(lc "${2:-}")"
             [[ $needs =~ $needs_re ]] \
               || { echo "dispatch: --needs takes lower-case feature names, a,b (wharf-runs/features names each host's)" >&2; exit 2; }
             # sorted and once each, the entry's form: bad_args compares the carried flag with the entry's needs
             needs="$(printf '%s\n' "$needs" | tr , '\n' | sort -u | paste -sd , -)"; shift 2;;
    # S9: wait in the queue until BRANCH2 is proved on origin/<main> (wharf-runs' landed.py), then merge it in
    # first. Repeatable; an unattended caller may name one, as it only delays (no raise)
    --after) [[ ${2:-} =~ ^claude/[A-Za-z0-9._/-]{1,200}$ ]] || { echo "dispatch: --after takes a claude/* branch" >&2; exit 2; }
             afters+=("$2"); shift 2;;
    --claim|--poll) qverb="${1#--}"; shift;;
    --event-at) evat="${2:-}"; case "$evat" in ''|*[!0-9]*) echo "dispatch: --event-at takes an epoch" >&2; exit 2;; esac; shift 2;;
    # S8: a kick's payload, host names only (dispatch-queue kicked judges each); --kick names a queue id
    --full) kfull="${2:-}"; [ -n "$kfull" ] || { echo "dispatch: --full takes host names, a,b" >&2; exit 2; }; shift 2;;
    --from) kfrom="${2:-}"; [ -n "$kfrom" ] || { echo "dispatch: --from takes the kicking host" >&2; exit 2; }; shift 2;;
    --from-stream) kstream=1; shift;;
    --kick) kick="${2:-}"; [ -n "$kick" ] || { echo "dispatch: --kick takes a queue id (dispatch --queue names each)" >&2; exit 2; }; shift 2;;
    --roads) exec python3 "$Q" roads "${qctx[@]}";;
    --status) python3 "$here/bin/dispatch-rc" status; rc=$?
              python3 "$Q" list --status --host "$self_host" 2>/dev/null; exit "$rc";;
    --cap) echo "$max_runs"; exit 0;;
    # the reservations count beside the records: a claimed run holds its slot before its record exists
    --slots) n=$(python3 "$here/bin/dispatch-rc" live --no-reap "" "" 2>/dev/null) || n="?"
             [ -n "$n" ] && [ "$n" != "?" ] && n=$((n + $(qreserved))); echo "${n:-?} $max_runs"; exit 0;;
    --end) end="$2"; shift 2;;
    --requeue) requeue=1; shift
               case "${1:-}" in --all) rqall=1; shift;; ''|-*) echo "dispatch: --requeue takes a TOPIC or --all" >&2; exit 2;; *) rqtopic="$1"; shift;; esac;;
    --why) rqwhy="${2:-}"; [ -n "$rqwhy" ] || { echo "dispatch: --why takes a reason" >&2; exit 2; }; shift 2;;
    -h|--help) sed -n '2,/^set -uo/p' "$0" | sed '$d'; exit 0;;   # the whole header, however long
    -*) echo "dispatch: unknown option $1" >&2; exit 2;;
    *) branch="$1"; shift;;
  esac
done
# The weekly Sextant (aurora's weekly-run exports WEEKLY_RUN) runs in `auto` mode: its allow rules
# only spare the classifier, they refuse nothing. So the one shape it may schedule is held here — a
# branch at a reset slot with --if-room and nothing else; the fired run never carries WEEKLY_RUN
# (the S7 /finish review's F1, F5). The queue's verbs (--claim, --poll, --event-at) are refused with the
# rest: each starts work beside the one shape (S2a's landing review, item 6).
if [ -n "${WEEKLY_RUN:-}" ]; then
  case "$at" in reset|reset+30|reset+60) slot=1;; *) slot=0;; esac
  if [ "$slot" = 0 ] || [ "$ifroom" = 0 ] || [ -z "$branch" ] \
     || [ "$cancel$next$yolo$start$probe$force$headless" != 0000000 ] || [ -n "$end${requeue#0}$rqwhy$account$note$bg$on$mode$origin$fromq${prio_given#0}$qverb$evat$waitwhy${replace#0}$needs${afters[*]+x}$kfull$kfrom${kstream#0}$kick" ] || [ "$sweep" = 1 ] \
     || [ "$model/$effort" != opus/high ]; then
    echo "dispatch: under WEEKLY_RUN=$WEEKLY_RUN only <branch> --repo R --at reset|reset+30|reset+60 --if-room" >&2; exit 2
  fi
  # the job carries opus/high in so many words: the fired run reads the brief's Tier: line, and a principal
  # tier there then refuses (principal_flags) rather than raise the weekly pass's run to Fable xhigh
  model_given=1; effort_given=1
fi
# --origin, read back on this host (S5's landing review): a scope's name never travels in what is
# pushed, so the seed commit carries the marker and only a registry here can say which scope. A name
# is held to the same test, a confidential scope here: an open scope's name, or a typo, would be
# recorded as a confidential origin S6 trusts (the re-review). A fired job refused here removes its
# own plist first: the cleanup trap is not set yet, and a plist left behind fires again next year. A
# job the queue claimed hands its entry back first (refused, as queue_refused does): exiting here left
# it claimed with no job, its slot held for the lease (the S5 rebase review). The why names no scope:
# a refusal is pushed with a fleet entry. Bootout last: it signals this script.
LA="$HOME/Library/LaunchAgents"
origin_refuse() {
  echo "dispatch: --origin $origin: $1" >&2
  [ -n "$fromq" ] && [ "$dry" = 0 ] \
    && python3 "$Q" refused "$fromq" --label "${DISPATCH_LABEL:-}" --why "its confidential origin does not read in $self_host's registry" "${qctx[@]}" >&2
  [ -n "${DISPATCH_LABEL:-}" ] && { rm -f "$LA/$DISPATCH_LABEL.plist"; "$LC" bootout "gui/$(id -u)/$DISPATCH_LABEL" 2>/dev/null; }
  exit 2
}
origin_scope=""; origin_marker=""
if [ -n "$origin" ]; then
  # two lines: the scope's name, then its marker — what the queue's entry carries (queue_args). One
  # read of the registry judges the tear and the scopes (the torn-registry trap)
  origin_read=$(python3 - "$core" "$origin" <<'PY' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
import common
reg, torn = common.read_registry()
if torn:
    sys.exit(3)
o = sys.argv[2]
s = (common.scope_of_marker(o, reg=reg) if o.startswith(common.SCOPE_MARK) else (o if o in common.confidential_scopes(reg=reg) else "")) or ""
print(s + "\n" + (common.scope_marker(s) if s else ""))
PY
) || origin_refuse "the registry cannot be read here, so no scope can be judged (fails closed)"
  origin_scope=${origin_read%%$'\n'*}; origin_marker=${origin_read#*$'\n'}
  [ -n "$origin_scope" ] || origin_refuse "names no confidential scope in this host's registry"
fi
repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "dispatch: no such repo" >&2; exit 2; }   # launchd starts in /
[ "$sweep" = 0 ] || exec python3 "$Q" sweep "${qctx[@]}"
# a claim now (a run's watcher, as its slot frees) and the pending poll's pass: nothing without a home
if [ -n "$kfull$kfrom" ] || [ "$kstream" = 1 ]; then
  [ "$qverb" = claim ] || { echo "dispatch: --full, --from and --from-stream go with --claim (a kick's receiver)" >&2; exit 2; }
fi
if [ -n "$kick" ]; then
  queue_on || { echo "dispatch: --kick: no queue home here" >&2; exit 0; }
  exec python3 "$Q" kick "$kick" --cwd "${DISPATCH_ORIGIN:-$PWD}" "${qctx[@]}"
fi
if [ -n "$qverb" ]; then
  queue_on || [ "$qverb" = poll ] || exit 0   # the poll's pass removes a poll job left by a home since unset
  # a kick's receiver (S8): note it, kickstart the sweep, return — never a claim inside an Orca terminal or a listener
  if [ -n "$kfull$kfrom" ]; then exec python3 "$Q" kicked --from "$kfrom" --full "$kfull" "${qctx[@]}"; fi
  if [ "$kstream" = 1 ]; then exec python3 "$Q" kicked --from-stream "${qctx[@]}"; fi
  [ "$qverb" = claim ] && exec python3 "$Q" claim ${evat:+--event-at "$evat"} "${qctx[@]}"
  exec python3 "$Q" poll "${qctx[@]}"
fi
# --from-queue is the queue's own job (dispatch-queue's start_job), nobody's flag to type
if [ -n "$fromq" ] && { [ -z "${DISPATCH_LABEL:-}" ] || [ -n "$at$end" ] || [ "$cancel$next$start$probe" != 0000 ]; }; then
  echo "dispatch: --from-queue is the queue's launchd job's flag (dispatch-queue start_job), with no --at, --next, --start, --probe or --cancel" >&2; exit 2
fi
if [ "$requeue" = 1 ]; then
  rqa=(); if [ "$rqall" = 1 ]; then rqa+=(--all); else rqa+=("$rqtopic"); fi
  [ -n "$repo_given" ] && rqa+=(--repo "$repo")
  [ -n "$rqwhy" ] && rqa+=(--why "$rqwhy")
  [ "$dry" = 1 ] && rqa+=(--dry-run)
  exec python3 "$Q" requeue "${rqa[@]}" "${qctx[@]}"
fi
[ -z "$rqwhy" ] || { echo "dispatch: --why goes with --requeue" >&2; exit 2; }
if [ -n "$end" ]; then
  if [ -n "$repo_given" ]; then exec python3 "$here/bin/dispatch-rc" end "$end" "$repo"; fi
  exec python3 "$here/bin/dispatch-rc" end "$end"
fi
if { [ "${#extra_allow[@]}${#undeny[@]}${lsid}${lresume}" != 00 ] || [ "$lfork" = 1 ]; } && [ "$start" = 0 ]; then
  echo "dispatch: --session-id, --resume, --fork, --allow and --undeny go with --start only" >&2; exit 2
fi
if [ "$lfork" = 1 ] && [ -z "$lresume" ]; then echo "dispatch: --fork goes with --resume ID" >&2; exit 2; fi
if [ -n "$lresume" ] && [ "$lfork" = 0 ] && [ -n "$lsid" ]; then
  echo "dispatch: --resume keeps the session's own id; --session-id goes with --fork only" >&2; exit 2
fi
if [ "$start" = 1 ]; then
  [ -z "$branch$at$on$note$mode$origin${afters[*]+x}" ] && [ "$cancel$next$probe$yolo$ifroom$prio_given" = 000000 ] || { echo "dispatch: --start takes no BRANCH, --at, --on, --note, --origin, --cancel, --next, --probe, --yolo, --if-room, --mode, --priority or --after" >&2; exit 2; }
  [ -n "$lprompt" ] && [ -n "$lname" ] || { echo "dispatch: --start needs a PROMPT and a NAME" >&2; exit 2; }
  ldir="$(cd "$ldir" 2>/dev/null && pwd -P)" || { echo "dispatch: --start: no such directory" >&2; exit 2; }
  branch=$(git -C "$ldir" symbolic-ref --quiet --short HEAD) || { echo "dispatch: --start: $ldir is on no branch" >&2; exit 2; }
  # the repo is the worktree's own, whatever --repo said: the run record's repo is what --status and the cap read
  repo="$(cd "$(git -C "$ldir" rev-parse --path-format=absolute --git-common-dir)/.." && pwd -P)"
fi
[ -n "$branch" ] || { echo "dispatch: BRANCH required" >&2; exit 2; }
topic="${branch##*/}"; topic="$(echo "$topic" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//')"
# a start's topic is its NAME as a slug: "finish · autofinish-runner" → finish-autofinish-runner, so the
# screen, the record and `dispatch --end` tell it from a seeded run of the same branch
[ "$start" = 1 ] && topic=$(printf '%s' "$lname" | LC_ALL=C tr -cs 'A-Za-z0-9-' '-' | sed 's/^-*//; s/-*$//' | tr 'A-Z' 'a-z')
# a brief is docs/handoff/<YYYY-MM-DD>-<topic>.md exactly: `*-demo.md` also matched `…-foo-demo.md`
topic_re="$(printf '%s' "$topic" | sed 's/[][\.*^$]/\\&/g')"
brief_re="^docs/handoff/[0-9]{4}-[0-9]{2}-[0-9]{2}-$topic_re\.md\$"
# A principal tier runs at its own model and effort (principal tier S5, docs/principal-tier-2026-10-26.md):
# the brief's Tier: line names it, blueprintlib's TIER_RUN says at what, and a --model or --effort given
# wins for its half. Without this a principal brief ran at the opus/high above, the tier in name only.
# Read here from the branch as this Mac knows it (the dry run's, --next's and the queued line's), and
# again at fire time from the worktree's brief, which decides; a job or a peer is handed only the flags
# given, so the fire-time read is never overridden by a default written into its plist.
tier=""; model0="$model"; effort0="$effort"
tier_run() {  # tier_run < <brief text>: sets $tier, and $model and $effort where no flag named them
  local out t m e
  # each read starts from the given-or-default pair: a stale early read's principal tier never outlives
  # the fire-time read that decides (the S5 landing review)
  model="$model0"; effort="$effort0"
  out=$(python3 -c 'import sys
sys.path.insert(0, sys.argv[1])
import blueprintlib as b
t = b.brief_tier(sys.stdin.read())
print(t or "-", *(b.TIER_RUN[t] if b.principal(t) else ("-", "-")))' "$here/bin") || return 1
  read -r t m e <<<"$out"
  [ "$t" = - ] && tier="" || tier="$t"
  [ "$m" = - ] && return 0
  [ "$model_given" = 1 ] || model="$m"
  [ "$effort_given" = 1 ] || effort="$e"
}
# principal_flags: a --model or --effort given that would run a principal tier below itself is refused, as
# blueprintlib and helm send refuse it: /later, /todo and a stall's re-start pass flags, and a given flag
# wins, so a demotion would otherwise be silent. `max` stays allowed (after a named miss). Prints why.
principal_flags() {
  case "$tier" in
    "?") echo "its Tier: line says principal but names no principal tier exactly (principal-architect, principal-worker)"; return 1;;
    principal-architect) pm=fable;; principal-worker) pm=opus;; *) return 0;;
  esac
  if [ "$effort_given" = 1 ] && [ "$effort" != xhigh ] && [ "$effort" != max ]; then
    echo "tier $tier runs at xhigh (max only after a named miss); --effort $effort is below it"; return 1
  fi
  case "$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')" in
    *"$pm"*) ;;
    *) echo "tier $tier runs on $pm; --model $model would run it elsewhere"; return 1;;
  esac
}
if [ "$start" = 0 ]; then
  for ref in "refs/heads/$branch" "refs/remotes/origin/$branch"; do
    trel=$(git -C "$repo" ls-tree -r --name-only "$ref" -- docs/handoff 2>/dev/null | grep -E -- "$brief_re" | sort | tail -1)
    [ -n "$trel" ] || continue
    tier_run < <(git -C "$repo" show "$ref:$trel" 2>/dev/null) || true   # unread here: the fire-time read decides
    # S9: a seed brief's `After:` line names the step's predecessors, read as --after (each claude/* name on
    # it); read here, where the queue's entry is written, and never again at fire time — the entry and the
    # one-shot's flags carry them from here
    [ "$probe" = 1 ] || while read -r b; do
      case " ${afters[*]-} " in *" $b "*) ;; *) [ "$b" = "$branch" ] || { afters+=("$b"); brief_afters+=("$b"); };; esac
    done < <(git -C "$repo" show "$ref:$trel" 2>/dev/null | sed -nE 's/^[[:space:]*-]*[Aa]fter[*]*:[*]*[[:space:]]+(.*)$/\1/p' \
             | grep -oE 'claude/[A-Za-z0-9._/-]{1,200}' | sed -E 's/[.]+$//')
    break
  done
  if ! why=$(principal_flags); then echo "dispatch: $branch's brief — $why" >&2; exit 2; fi
fi
# The mode (header, --mode): a fired job's plist carries it as DISPATCH_MODE; a --next from a run keeps
# its run's (the session's DISPATCH_MODE), bar yolo, which is per step as --yolo always was. --yolo is
# mode yolo and mode yolo is --yolo: one switch under two names.
if [ "$mode_given" = 0 ] && [ -n "${DISPATCH_MODE:-}" ]; then
  if [ -n "${DISPATCH_LABEL:-}" ]; then mode="$DISPATCH_MODE"
  elif [ "$next" = 1 ] && [ "$DISPATCH_MODE" != yolo ]; then mode="$DISPATCH_MODE"; fi
fi
case "$mode" in default|ask|dnd|yolo|'') ;; *) mode="";; esac   # a plist's stray value is no mode
if [ "$yolo" = 1 ]; then
  case "$mode" in ''|yolo) mode=yolo;; *) echo "dispatch: --yolo is mode yolo, not $mode" >&2; exit 2;; esac
elif [ "$mode" = yolo ]; then yolo=1; fi
[ -z "$mode" ] || [ "$probe" = 0 ] || { echo "dispatch: --mode is a seeded run's, not a probe's" >&2; exit 2; }
# skipper-modes S3b: landing follows the mode, so a raise is a yes to merge, and only the owner gives it. An
# unattended caller (CLAUDE_UNATTENDED: every dispatched run) naming --mode or --yolo above the target's
# mode is refused — helmlib.raise_refusal against the target branch's mode (helmlib.branch_mode: the plan
# task naming it, a `helm mode --branch`, its newest run), else the caller's own (a run handing on its
# mode to a new branch keeps it); never the caller's alone, or a dnd run could raise a sibling the owner
# lowered (landing review 5). ship_mode checks the ship's task again before it writes. A fired job
# (DISPATCH_LABEL) carries the plist's mode, which a guarded dispatch wrote. Without helm here, the
# caller's DISPATCH_MODE or `default` is its mode: the refusal fails closed.
if [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ] && [ -z "${DISPATCH_LABEL:-}" ] && [ -n "$mode" ] && { [ "$mode_given" = 1 ] || [ "$yolo" = 1 ]; }; then
  why=$(python3 - "$core" "$mode" "$branch" "$repo" <<'PY' 2>/dev/null
import os, sys
sys.path.insert(0, sys.argv[1])
rank = {"ask": 0, "default": 1, "dnd": 2, "yolo": 3}
try:
    import common
    p = common.tool("helmlib.py")
    sys.path.insert(0, str(p.parent))
    import helmlib
    old = helmlib.branch_mode(sys.argv[3], sys.argv[4])[0] or helmlib.run_mode()[0]
    print(helmlib.raise_refusal(old, sys.argv[2]) or "")
except Exception:
    old = os.environ.get("DISPATCH_MODE") or "default"
    if rank.get(sys.argv[2], 0) > rank.get(old, 1):
        print("mode %s over %s is a raise, and only the owner raises a mode (an unattended caller; helm unreadable here)" % (sys.argv[2], old))
PY
) || why="the mode's raise check failed"
  [ -z "$why" ] || { echo "dispatch: $why" >&2; exit 2; }
fi
# A --next inherits its own run's rank, never the environment: the record whose claude is this dispatch's
# ancestor (dispatch-queue caller-prio), force read as high — the owner's force buys one run. An unattended
# caller never raises (the trap: a flag that stands for a person's yes refuses an unattended caller): force
# never, high only when that record is high.
if [ "$prio_given" = 0 ] && [ "$next" = 1 ] && [ -z "${DISPATCH_LABEL:-}" ]; then
  inh=$(python3 "$QG" caller-prio 2>/dev/null) || inh=""
  case "$inh" in low|high) prio="$inh";; esac
fi
# force: one rule for every caller and road (dispatch-queue force-ok): never unattended; from a session (its
# variables, or a claude among this dispatch's ancestors: a session can unset the variables, not its parent)
# only with its force mark; else the owner's typing. No caller is exempt, a DISPATCH_LABEL's least: a real
# fired job carries no CLAUDE_UNATTENDED and no session, and passes as the owner's own schedule (the landing review)
# main's plain refusal first, before any python: an unattended caller never forces, whatever force-ok answers
# (the final landing review: a DISPATCH_QUEUE_BIN stand-in made the check exit 0)
if [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}${AUTOFINISH_CALLER_UNATTENDED:-}" ] && [ "$prio_given" = 1 ] && [ "$prio" = force ]; then
  echo "dispatch: --priority force is the owner's word for one run, and an unattended caller never raises to it: end with the WAITING line — the next step waits for a run to end" >&2; exit 2
fi
if [ "$prio" = force ] && [ "$prio_given" = 1 ]; then
  why=$(python3 "$QG" force-ok 2>&1) || { echo "dispatch: ${why:-the force check failed}: end with the WAITING line — the next step waits for a run to end" >&2; exit 2; }
fi
if [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}${AUTOFINISH_CALLER_UNATTENDED:-}" ] && [ "$prio_given" = 1 ] && [ "$prio" = high ]; then
  inh=$(python3 "$QG" caller-prio 2>/dev/null) || inh=""
  [ "$inh" = high ] || { echo "dispatch: --priority high is a raise, and an unattended caller never raises a run's priority (its own run's record says ${inh:-none}): end with the WAITING line — the next step waits for a run to end" >&2; exit 2; }
fi
# --replace takes over another session's queued step or a claimed or running one: a yes that is the owner's,
# so an unattended caller is refused it (the same trap; S3's landing review, item 12). No caller is exempt, as
# autofinish-run's unattended_caller() judges --merge: a DISPATCH_LABEL is any session's word, and no fired job
# carries --replace (S3's third landing review, item 3)
if [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}${AUTOFINISH_CALLER_UNATTENDED:-}" ] && [ "$replace" = 1 ]; then
  echo "dispatch: --replace takes over another run's step, and an unattended caller is refused it: end with the WAITING line — the next step waits for a run to end (dispatch --queue names whose it is)" >&2; exit 2
fi
# Where a run goes when nobody names a host (the owner, 2026-10-13: "dispatch to [the build Mac] by
# default, not the laptop"): berth's pick (`--on auto`, skipper-modes S6b), and this Mac only when the
# pick does not answer (--fallback here). `--on here` keeps it here. Not for what runs here by nature: a
# fired job (DISPATCH_LABEL), --start's caller, a probe, a bare clock time (ambiguous across hosts), a
# --yolo build (its launch needs autofinish armed, and the build Mac stays disarmed), and the --next of
# an unattended run here: dispatch-rc after() makes the next step wait for this run's last turn only on
# one host (review 2026-10-13). A probe and a dry run take the default too, so they test the host the
# real call would use. --cancel looks on both (below).
# DISPATCH_DEFAULT_ON names the host (`auto`, the default: berth's pick); empty turns the default off
# (the tests). When berth cannot run, and for a cancel, the default is DISPATCH_BERTH_FALLBACK, else the
# dispatch host (above). A host the ssh key gives no alias for cannot be reached: one stderr line, and
# the run stays here, as with none.
# --on auto (header): berth's pick, into on/fallback, or a refusal. A berth that cannot run at all (no
# core, a crash) keeps the default before S6b — the dispatch host, falling back here.
berth_pick() {
  local out rc
  out=$(python3 "$here/bin/berth" "$repo" --json $([ "$dry" = 1 ] && echo --no-log) 2>/dev/null); rc=$?
  if [ "$rc" = 3 ]; then
    echo "dispatch: no berth for $repo — $(printf '%s' "$out" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("reason", "?"))' 2>/dev/null)" >&2; exit 2
  fi
  if [ "$rc" != 0 ]; then
    on="${DISPATCH_BERTH_FALLBACK-$dispatch_host}"; [ "$(lc "$on")" = "$(lc "$self_host")" ] && on=""; [ -n "$on" ] && fallback=here
    [ -n "${DISPATCH_BERTH_FALLBACK+x}" ] || [ -z "$on" ] || [ -z "$dh_note" ] || echo "$dh_note" >&2
    if [ -n "$on" ] && ! peer_of "$on"; then   # as the dispatch-host default always did: here, never a refusal
      echo "dispatch: the dispatch host $on has no line in wharf-runs/ssh (<host>:<ssh alias>) — running here" >&2
      on=""; fallback=""
    fi
    echo "dispatch: berth failed (exit $rc); the default before it: ${on:-here}" >&2; return 0
  fi
  local pick here_ok
  read -r pick here_ok < <(printf '%s' "$out" | python3 -c 'import json, sys; d = json.load(sys.stdin); print(d.get("pick") or "-", "1" if sys.argv[1] in (d.get("candidates") or []) else "0")' "$self_host")
  echo "dispatch: berth — $pick ($(printf '%s' "$out" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("reason", ""))' 2>/dev/null))" >&2
  if [ "$(lc "$pick")" = "$(lc "$self_host")" ]; then on=""; on_here=1
  else on="$pick"; [ "$here_ok" = 1 ] && fallback=here; fi
}
# --wait and --replace speak to the queue's entry of a run now, which this Mac's queue holds (any host with room
# claims it): they take this road, never the default's, whose one-shot on a peer has no entry for them — they
# were refused there, naming an --on the caller never typed (S3's third landing review, item 5). With no queue
# home they are said and dropped first, so the default road applies as it would without them (the in-round review)
# (a typed --on HOST or --at keeps its refusal, below: `on` holds only a typed host here)
if { [ -n "$waitwhy" ] || [ "$replace" = 1 ]; } && [ "$cancel" = 0 ] && [ -z "$on$at" ] && ! queue_on; then
  echo "dispatch: $([ -n "$waitwhy" ] && echo --wait)$([ -n "$waitwhy" ] && [ "$replace" = 1 ] && echo " and ")$([ "$replace" = 1 ] && echo --replace) ignored — no queue home here (wharf-runs/queue-repo), so nothing is queued to wait on or take over" >&2
  waitwhy=""; replace=0
fi
# --needs are the queue's: a claiming host's feature line is judged at claim and at enqueue. With no queue
# home nothing is queued, so they are said and dropped, as --wait is (S5)
if [ -n "$needs" ] && ! queue_on; then
  echo "dispatch: --needs ignored — no queue home here (wharf-runs/queue-repo), so no host claims by its features" >&2
  needs=""
fi
default_on="${DISPATCH_DEFAULT_ON-auto}"; dpeer=""
if [ -z "$on" ] && [ "$on_here" = 0 ] && [ "$on_auto" = 0 ] && [ -n "$default_on" ] && [ "$(lc "$self_host")" != "$(lc "$default_on")" ] \
   && [ -z "${DISPATCH_LABEL:-}" ] && [ "$start$yolo" = 00 ] && [ -z "$waitwhy" ] && [ "$replace" = 0 ] \
   && ! { [ "$next" = 1 ] && [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ]; }; then
  case "$at" in
    # a cancel looks on auto's peer, never on this Mac itself: from that peer it would ssh to itself
    ''|reset*|@*) if [ "$cancel" = 1 ]; then
                    [ "$default_on" = auto ] && [ "$(lc "$self_host")" = "$(lc "${DISPATCH_BERTH_FALLBACK-$dispatch_host}")" ] || on_default=1
                  elif [ "$default_on" = auto ]; then on_auto=1; on_default=1
                  else on="$default_on"; fallback=here; on_default=1; fi;;
  esac
fi
# a cancel looks on the default's peer: berth's first peer has no meaning without a run to place
[ "$default_on" = auto ] && default_on="${DISPATCH_BERTH_FALLBACK-$dispatch_host}"
if [ "$on_default" = 1 ] && [ -z "$on" ] && [ -n "$default_on" ]; then
  if peer_of "$default_on"; then dpeer="$peer"; default_on="$pname"
  elif [ "$cancel" = 1 ]; then
    echo "dispatch: the dispatch host $default_on has no line in wharf-runs/ssh (<host>:<ssh alias>) — looking here only" >&2
  fi
fi
if [ "$on_default" = 1 ] && [ -n "$on" ]; then
  if ! peer_of "$on"; then
    echo "dispatch: the dispatch host $on has no line in wharf-runs/ssh (<host>:<ssh alias>) — running here" >&2
    on=""; fallback=""; on_default=0
  else
    [ -n "${DISPATCH_DEFAULT_ON+x}" ] || [ -z "$dh_note" ] || echo "$dh_note" >&2
    dpeer="$peer"
  fi
fi
# --wait and --replace speak to this Mac's entry, and with a queue home any host with room claims it: a typed
# `--on auto` adds nothing berth could pick, and was refused below naming the host berth picked, one the caller
# never typed (S3's finish review; S4). Dropped instead, the queue places it
# Berth's load pick retires with a queue home (S5): a run now is enqueued here and any host that may take it
# (the scope's berths, the clone hosts, its feature line, the pin: dispatch-queue's eligibility) claims it with
# room, so the load rule has no pick to make. A one-shot (--at), a probe, a dry run, --start and a cancel keep
# berth; its privacy filters and peer probe stay for --status and for them
qplace=0
if [ -z "$at" ] && [ "$cancel$dry$probe$start" = 0000 ] && [ -z "${DISPATCH_LABEL:-}" ] && queue_on; then qplace=1; fi
qauto=0
if [ "$on_auto" = 1 ] && [ -z "$on" ] && [ "$cancel" = 0 ] && { [ -n "$waitwhy" ] || [ "$replace" = 1 ] || [ "$qplace" = 1 ]; } && queue_on; then
  [ "$qplace" = 1 ] && qauto=1   # a queue that then cannot take the run falls back below, under berth's filters
  on_auto=0; on_default=0
fi
[ "$on_auto" = 1 ] && [ "$cancel" = 0 ] && berth_pick
# a named host: one the ssh key names (its spelling from here on), else refused, naming those it holds
if [ -n "$on" ]; then peer_of "$on" || unknown_host "$on"; on="$pname"; fi
# --on with no --at: now, on the peer — the margin a direct run takes here (below)
[ -z "$on" ] || [ -n "$at" ] || [ "$cancel$next" != 00 ] || { at="@$(( $(date +%s) + ${DISPATCH_NEXT_DELAY:-90} ))"; at_default=1; }
[ "$yolo$probe" != 11 ] || { echo "dispatch: --yolo is a seeded run's, not a probe's" >&2; exit 2; }
# --wait and --replace speak to the queue's entry of a run now on this Mac (queue_dispatch). A one-shot (--at:
# it enters the queue at its time, without them), a peer's run (--on HOST: a one-shot there) and a Mac with
# no queue home have none, and dropped them silently (S3's second landing review, item 11): refused where
# the caller named such a road, said and ignored where nothing here queues at all
if [ -n "$waitwhy" ] || [ "$replace" = 1 ]; then
  qf="$([ -n "$waitwhy" ] && echo --wait)$([ -n "$waitwhy" ] && [ "$replace" = 1 ] && echo " and ")$([ "$replace" = 1 ] && echo --replace)"
  # the cap's waiting words in each refusal (AGENTS.md: a new dispatch refusal reuses them; the in-round review)
  [ -z "$on" ] || { echo "dispatch: $qf go with a run now through this Mac's queue; --on $on schedules a one-shot there, which enters its queue at its time without them — dispatch --on here, or on $on; else end with the WAITING line — the next step waits for a run to end" >&2; exit 2; }
  [ -z "$at" ] || { echo "dispatch: $qf go with a run now through the queue; --at schedules a one-shot, which enters the queue at its time without them; else end with the WAITING line — the next step waits for a run to end" >&2; exit 2; }
fi
ACCT="${DISPATCH_ACCOUNT:-${p_account:-$here/bin/account}}"   # the tests stand one in; lighthouse's
[ "$force" = 0 ] || case "$account" in ''|auto|bound) echo "dispatch: --force goes with --account LABEL" >&2; exit 2;; esac
[ -z "$fallback" ] || [ -n "$on" ] || { echo "dispatch: --fallback goes with --on" >&2; exit 2; }
[ -z "$fallback" ] || [ "$cancel" = 0 ] || { echo "dispatch: --fallback is not for --cancel: cancel on each host" >&2; exit 2; }
# How deep in a chain of unattended runs this one is: launchd hands the fired run its depth in the
# plist (DISPATCH_LABEL set); anything else — a person, a session, a run's own session — is one
# deeper than its own environment says (a person's shell has none: 0).
case "${DISPATCH_DEPTH:-}" in ''|*[!0-9]*) d0=0;; *) d0=$DISPATCH_DEPTH;; esac
if [ -n "${DISPATCH_LABEL:-}" ]; then depth=$(( d0 > 0 ? d0 : 1 )); else depth=$((d0 + 1)); fi
maxdepth=${DISPATCH_MAX_DEPTH:-5}
# skipper-modes S1: the run's mode at fire time (header, --mode): a `helm mode --branch` on this branch
# (helmlib.branch_override, with the repo: the lowering verb for a run with no ship — follow-ups item 5)
# under plan.json's task, then its ship (both on this Mac only; a ship's mode is a ceiling), the plist's
# DISPATCH_MODE a hint, the repo's scope, `default` — helmlib.fire_mode, the ladder's one reader, which
# mode_now asks again at the launch (the follow-ups' landing review, item 8). Not branch_mode whole: its
# newest run record may be an earlier step's (a --next drops yolo per step). Without helm here, the hint
# or `default`. Into the session's environment and the record — bar a mode read while repos.json is torn
# (helmlib.torn_read): that `ask` is this run's alone, so no DISPATCH_MODE goes on, and the record says
# `mode_unread` (a sent task, no mode), and the mode heals with the registry (item 6). A torn read
# happens only with no hint: task_mode reads a hint before the scope (the second landing review).
read_mode() {   # HINT — "<torn 0|1> <mode>" (torn first: an empty mode must not shift the fields)
  python3 - "$core" "${DISPATCH_SHIP:-${DISPATCH_PLAN:-}}" "$topic" "$repo" "$1" "$branch" <<'PY' 2>/dev/null || echo "0 $1"
import sys
sys.path.insert(0, sys.argv[1])
import common
p = common.tool("helmlib.py")
if not p:
    print(0, sys.argv[5]); sys.exit()
sys.path.insert(0, str(p.parent))
import helmlib
# a helmlib out of step with this file (a peer's, an older checkout's) reads as it can: fire_mode, else
# the entry before task_mode as item 5 did; torn_read, else no tear — never the bare hint of a crash
# (the second landing review)
if hasattr(helmlib, "fire_mode"):
    m = helmlib.fire_mode(sys.argv[2] or None, sys.argv[3], sys.argv[4], sys.argv[5] or None, sys.argv[6])
else:
    over = getattr(helmlib, "branch_override", lambda b, r: None)(sys.argv[6], sys.argv[4])
    m = over or helmlib.task_mode(sys.argv[2] or None, sys.argv[3], sys.argv[4], sys.argv[5] or None)
print(int(getattr(helmlib, "torn_read", lambda pair: False)(m)), m[0])
PY
}
mode_torn=0
resolve_mode() {
  local out
  read -r mode_torn out < <(read_mode "$mode")
  mode="${out:-${mode:-default}}"
  # plan.json wins both ways: a yolo hint changed to dnd is no yolo run, a mode changed to yolo is one
  if [ "$mode" = yolo ]; then yolo=1; else yolo=0; fi
  if [ "$mode_torn" = 1 ]; then
    echo "== mode $mode (repos.json is unreadable: ask for this run only, kept nowhere)"
  else
    chain+=(DISPATCH_MODE="$mode")
    echo "== mode $mode"
  fi
}
# Refusals say what to do instead. `pickup next` is the hand-over only in a repo dispatch refuses
# (D1, 2026-10-05); here the step ends naming what it waits on (the overlay's working rules).
deep() { echo "dispatch: this would be run $depth of a chain of unattended runs, each started by the one before (DISPATCH_DEPTH); past $maxdepth a person starts the next — end with the WAITING line: the next step waits for $who to start it (dispatch --next by hand starts a new chain)"; }
# the repo is in the label (two repos may seed one topic); a probe has its own, so it cannot cancel the real job
# (the prefix: `wharf-runs/label-prefix`, read above; the overlay's jobs carry the one it names)
base="$lprefix.dispatch.$(basename "$repo").$topic"
[ "$probe" = 1 ] && base="$base.probe"
old="$lprefix.run-seed.${base#"$lprefix".dispatch.}"   # the label before 2026-10-05
# the same two under the previous prefix (wharf-runs/label-prefix-previous): a job scheduled before a label
# move is still this branch's, for --cancel, a reschedule and yolo's "a next step is scheduled"; a new job
# takes the new prefix only
pbase=""; pold=""
[ -z "$lprev" ] || { pbase="$lprev.dispatch.${base#"$lprefix".dispatch.}"; pold="$lprev.run-seed.${base#"$lprefix".dispatch.}"; }
# A peer runs its own core (the scrub's conventions): the regatta checkout its config dir's `home`
# file names, read there by the peer's shell. Its projects folder is taken as ~/projects, the core's
# default (PROJECTS): a repo is named relative to this Mac's projects folder, the primary by its
# checkout's basename.
rbin='"$(head -1 "${REGATTA_CONFIG:-$HOME/.config/regatta}/home" 2>/dev/null)/modules/wharf-runs/bin/dispatch"'
# this branch's jobs here: one per fire minute, the undated label of before 2026-10-04, and both
# under the old name, so --cancel and a reschedule still find a job run-seed scheduled
jobs() { local b; for b in "$base" "$old" $pbase $pold; do ls "$LA/$b.plist" "$LA/$b".[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].plist 2>/dev/null; done; }
# a job whose run is going now; booting it out kills that run (probed: one tab, then this line)
running() { "$LC" print "gui/$(id -u)/$1" 2>/dev/null | grep -qx $'\tstate = running'; }
# every job of the branch but one that is running: pending, or a leftover of a run that died
clear_jobs() {   # KEEP-PLIST VERB
  local p l
  while read -r p; do
    [ -n "$p" ] && [ "$p" != "$1" ] || continue
    l=$(basename "$p" .plist)
    if running "$l"; then echo "left $l: its run is going (maybe this very one) — a run is ended, not unscheduled; dispatch --status"
    else rm -f "$p"; "$LC" bootout "gui/$(id -u)/$l" 2>/dev/null; echo "$2 $l"; fi
  done < <(jobs)
}
# fixed when scheduled and handed to the fired run in the plist: a run next Sunday logs where
# the scheduling line said it would, not to a file dated by the day it fires
log="${DISPATCH_LOG:-$HOME/Library/Logs/claude-weekly/$(date +%Y-%m-%d)-dispatch-$topic.log}"

if [ "$cancel" = 1 ]; then
  if [ -n "$on" ]; then
    rel=""; [ "$repo" != "$primary" ] && rel=" --repo \$HOME/projects/$(printf '%q' "${repo#"$projects"/}")"
    exec ${DISPATCH_SSH:-ssh} "$peer" "$rbin $(printf '%q' "$branch") --cancel$rel"
  fi
  out=$(clear_jobs "" cancelled); echo "${out:-nothing scheduled for $branch here}"
  # its queue entry, wherever it is queued (the fleet ref is every host's): a live one is ended, not unqueued
  queue_on && python3 "$Q" cancel --repo "$repo" --branch "$branch" "${qctx[@]}"
  if [ "$on_default" = 1 ] && [ -n "$dpeer" ]; then   # a default run may sit on the peer: look there too, unreachable or not
    rel=""; [ "$repo" != "$primary" ] && rel=" --repo \$HOME/projects/$(printf '%q' "${repo#"$projects"/}")"
    ${DISPATCH_SSH:-ssh} -o ConnectTimeout=10 -o BatchMode=yes "$dpeer" "$rbin $(printf '%q' "$branch") --cancel$rel"
    case $? in
      0) ;;
      255) echo "dispatch: $default_on did not answer — a job scheduled there stays (dispatch $branch --cancel --on $default_on later)" >&2;;
      *) echo "dispatch: $default_on could not look (no such repo there?) — nothing of this branch can be scheduled there" >&2;;
    esac
  fi
  exit 0
fi

# never a repo that acts on the real world: auto mode approves what nobody is there to see. /later
# says the same; this makes it hold for a direct call too (review of 2026-10-04). The contract's
# `physical:` line is the marker: none in a repo of code and records; a sweep in one that drives a house.
physical_ok() {
  phys=$(grep -h -m1 -E '^- physical:' "$repo/AGENTS.md" "$repo/CLAUDE.md" 2>/dev/null | head -1)
  case "$phys" in "- physical: none"*) return 0;; esac
  echo "dispatch: $repo's contract must say \`physical: none\` (it says: ${phys:-nothing})"; return 1
}

# session-asks R1 (docs/session-asks-2026-10-09.md): who a run relays its asks to. A run started by
# another run keeps that run's skipper; a run a watched session starts names that session. Read
# where the job is scheduled — launchd and the runner strip the caller's CLAUDE_* — and carried in
# the plist beside DISPATCH_DEPTH. An unattended caller with no skipper (autofinish) passes none.
# A login as one word both sides agree on: the config dir's real path (the default login's is
# ~/.claude). `account which` printed nothing for the default dir while the run's pick said
# the primary login, so one account read as two and SendMessage refused (launch review, finding 6).
acct_dir() {
  local d="${1:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
  (cd "$d" 2>/dev/null && pwd -P) || printf '%s\n' "$d"
}
# The skipper's road and its ship (rename S5, helm-vocabulary H1): read under the new name, else the
# old one (a launchd plist or a run from before S5 has only the old), and written under both until S8.
# SKIPPER_ENV pairs each value with its names, new first.
SKIPPER_ENV="skipper:DISPATCH_SKIPPER skipper:DISPATCH_MANAGER skacct:DISPATCH_SKIPPER_ACCOUNT skacct:DISPATCH_MANAGER_ACCOUNT skplan:DISPATCH_SHIP skplan:DISPATCH_PLAN skspace:DISPATCH_PLAN_SPACE skhost:DISPATCH_SKIPPER_HOST skhost:DISPATCH_MANAGER_HOST"
SKIPPER_UNSET=(-u DISPATCH_SKIPPER -u DISPATCH_MANAGER -u DISPATCH_SKIPPER_ACCOUNT -u DISPATCH_MANAGER_ACCOUNT -u DISPATCH_SHIP -u DISPATCH_PLAN -u DISPATCH_PLAN_SPACE -u DISPATCH_SKIPPER_HOST -u DISPATCH_MANAGER_HOST)
skipper_env() {
  skipper="${DISPATCH_SKIPPER:-${DISPATCH_MANAGER:-}}"; skacct="${DISPATCH_SKIPPER_ACCOUNT:-${DISPATCH_MANAGER_ACCOUNT:-}}"
  skplan="${DISPATCH_SHIP:-${DISPATCH_PLAN:-}}"; skspace="${DISPATCH_PLAN_SPACE:-}"
  skhost="${DISPATCH_SKIPPER_HOST:-${DISPATCH_MANAGER_HOST:-}}"
  if [ -z "$skipper" ] && [ -z "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    skipper="$CLAUDE_CODE_SESSION_ID"; skacct=$(acct_dir); sktyped=1
    # where the skipper runs: bin/ask reads "no record here" as an ended skipper only on its own Mac
    skhost="${DISPATCH_HOST:-$(local_host)}"
  fi
  [ -n "$skipper" ] || return 0
  [ -n "$skplan" ] || skplan="$skipper"   # one ship per skipper by default (bin/helm ship)
  # the plan's page, when the skipper published one: the Talk address (R4)
  [ -n "$skspace" ] || skspace=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("space") or "")' \
    "${PLANS_DIR:-$HOME/Library/Logs/claude-weekly/plans}/$skplan/plan.json" 2>/dev/null) || skspace=""
  return 0
}
# peer-manager-relay S1 (D1-A): a typed skipper with no page gets one at its first dispatch, so a run on a
# peer Mac always has a Talk address — on 2026-10-26 a build-box run parked 3 h, every road refused, for a
# laptop skipper that had published none. `helm page` makes the ship and publishes once, under helm's
# publish budget; later dispatches read the space in skipper_env and publish nothing. A refusal (exit 3,
# its line on stderr) or a failure still starts the run, as before, and says so in one line. Only the
# skipper's own dispatch publishes (skipper_env's sktyped): a run passing its skipper on has the page in
# DISPATCH_PLAN_SPACE, or never will here (the ship lives on the skipper's Mac). A dry run publishes
# nothing. Called once the refusals have run, never from skipper_env: a publish and a ship are a write
# that goes after every refusal (AGENTS.md's Traps; the S1 landing review).
skipper_page() {
  local perr
  if [ -z "$skspace" ] && [ "$sktyped" = 1 ] && [ "$dry" = 0 ] && [ -x "$p_helm" ]; then   # no helm here: no page, as before
    perr=$(mktemp)
    skspace=$("$p_helm" page "$skplan" 2>"$perr" | tail -n 1) || skspace=""
    [ -n "$skspace" ] || echo "dispatch: no plan page for the skipper, so the run has no Talk road to it — $(tail -n 1 "$perr" 2>/dev/null | cut -c1-200)" >&2
    rm -f "$perr"
  fi
  return 0
}
skipper=""; skacct=""; skplan=""; skspace=""; skhost=""; sktyped=0
# what pickup reads to tell a seed already sent off from one never started (`seeds --open` at /finish
# would dispatch it a second time: a run on the peer opens its WIP PR only at its first push — review
# 2026-10-13): <common git dir>/claude/dispatched/<topic>, "<epoch> <host> <branch>"
mark_dispatched() {   # HOST
  local d
  # the force mark spent here, at each road's success (the queue's put, the plist, the peer's yes), never
  # before a refusal: a refused dispatch kept costing the owner another "use the force" (AGENTS.md: a write
  # that stands for a newer word goes after every refusal)
  if [ "$prio" = force ] && [ -z "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ]; then
    case "${CLAUDE_CODE_SESSION_ID:-}" in ''|*[!A-Za-z0-9_-]*) ;; *) rm -f "$cache/force/$CLAUDE_CODE_SESSION_ID";; esac
  fi
  d="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/claude/dispatched"
  mkdir -p "$d" 2>/dev/null && printf '%s %s %s\n' "$(date +%s)" "$1" "$branch" > "$d/$topic" 2>/dev/null
  return 0
}

if [ "$next" = 1 ]; then
  [ -z "$at" ] && [ "$probe$dry$cancel" = 000 ] || { echo "dispatch: --next schedules now + 90 s, on the dispatch host unless --on here: no --at, --probe, --dry-run or --cancel" >&2; exit 2; }
  case "$branch" in claude/*) ;; *) echo "dispatch: --next takes a claude/* branch, not $branch" >&2; exit 2;; esac
  # A run that is a block of a ship has its successor in the blueprint's graph, and `wharf apply` — the
  # tick or the skipper — starts it, gates and all (wharf-on-orca S5, B9): a second scheduler here would
  # start it twice. `wharf next` decides from the caller's own DISPATCH_SHIP or DISPATCH_PLAN, and DISPATCH_TASK; reads the
  # file and the plan only (never the Orca app), and says 1 for "not a ship's block" and 2 for "could not
  # tell": that one stops here, so a broken check is never read as a seed.
  nerr=$(mktemp); ship=$(python3 "$here/bin/wharf" next "$branch" --repo "$repo" 2>"$nerr"); nrc=$?
  case $nrc in
    0) rm -f "$nerr"; echo "dispatch: $ship"; exit 0;;
    1) rm -f "$nerr";;
    *) echo "dispatch: wharf next could not tell whether $branch is a ship's block — $(tail -n 3 "$nerr" | tr '\n' ' ')" >&2; rm -f "$nerr"; exit 2;;
  esac
  physical_ok >&2 || exit 2
  git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || { echo "dispatch: no local $branch in $repo" >&2; exit 2; }
  [ "$depth" -le "$maxdepth" ] || { deep >&2; exit 2; }
  # the run reads the latest brief; one older than the branch's work is the brief THIS step started from
  brief=$(git -C "$repo" ls-tree -r --name-only "refs/heads/$branch" -- docs/handoff | grep -E -- "$brief_re" | sort | tail -1)
  [ -n "$brief" ] || { echo "dispatch: $branch has no committed docs/handoff/<date>-$topic.md — write the next step's brief there and commit it" >&2; exit 2; }
  # A run that commits nothing could --next itself on its own brief forever (review of 2026-10-05).
  # Its session carries the blob of the brief it started from; the next step needs a new one.
  if [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ] && [ -n "${DISPATCH_BRIEF:-}" ] \
     && [ "$(git -C "$repo" rev-parse "refs/heads/$branch:$brief" 2>/dev/null)" = "$DISPATCH_BRIEF" ]; then
    echo "dispatch: $brief is the brief this run started from, unchanged — a --next would run the same step again. Write the next step's brief (a new docs/handoff/<date>-$topic.md), or end with what is left for $who" >&2; exit 2
  fi
  # the cap is the host's that runs it: the peer applies its own at fire time (its own max_runs)
  # with the queue on, the claim judges room after the push (queue_dispatch), and a full host queues the step
  if [ -n "$on" ] || ! queue_on; then
    n=0; [ -n "$on" ] || n=$(python3 "$here/bin/dispatch-rc" live "$repo" "$topic") || n=0
    [ "$n" -lt "$(pcap)" ] || { echo "dispatch: $n runs are busy already (dispatch --status; warm or waiting ones not counted) — refused, with no queue home here (wharf-runs/queue-repo): end with the WAITING line — the next step waits for a run to end (dispatch --next once one has)" >&2; exit 2; }
    [ -n "$on" ] || why=$(roomy) || { echo "dispatch: $why — refused, with no queue home here (wharf-runs/queue-repo): end with the WAITING line — the next step waits for a run to end and memory to free (dispatch --next once one has)" >&2; exit 2; }
  fi
  since=$(git -C "$repo" diff --name-only "$(git -C "$repo" log -1 --format=%H "refs/heads/$branch" -- "$brief")" "refs/heads/$branch" -- . ':!docs/handoff' | head -3)
  [ -z "$since" ] || { echo "dispatch: work was committed after $brief (${since//$'\n'/, }) — it is the brief this step started from; write the next step's brief there last and commit it" >&2; exit 2; }
  # the run reuses .claude/worktrees/<topic> when it is on the branch; git refuses a second checkout of it elsewhere
  wt=$(git -C "$repo" worktree list --porcelain | awk -v b="branch refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0==b{print w}')
  if [ -n "$wt" ]; then
    [ "$(cd "$wt" && pwd -P)" = "$(cd "$repo" && pwd -P)/.claude/worktrees/$topic" ] \
      || { echo "dispatch: $branch is checked out at $wt; the run needs it at $repo/.claude/worktrees/$topic" >&2; exit 2; }
    [ -z "$(git -C "$wt" status --porcelain)" ] || { echo "dispatch: $wt has uncommitted changes — commit them first; the run would stop on them" >&2; exit 2; }
    owner="$(git -C "$wt" rev-parse --absolute-git-dir)/claude/owner.json"
    held=$(python3 -c '
import json, sys, time
try:
    o = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit()
if o.get("session") == sys.argv[2] and o.get("handover"):
    print("handed")   # this session ran pickup next: a tab owns the next step already
elif o.get("session") == sys.argv[2]:
    print("mine")
elif o.get("handover"):   # pickup next marked it (96f3c9d): checkpoint.py holds nobody out on it
    pass
elif time.time() - o.get("seen", 0) < 2 * 3600:   # checkpoint.py OWNER_TTL
    print("held by session " + str(o.get("session"))[:8])
' "$owner" "${CLAUDE_CODE_SESSION_ID:-}")
    case "$held" in handed) echo "dispatch: this session handed the worktree to a tab (pickup next) — one hand-over per step" >&2; exit 2;; esac
    case "$held" in held*) echo "dispatch: $wt is $held — it must end (or idle 2 h) before the next step can write there" >&2; exit 2;; esac
  fi
  git -C "$repo" push -q -u origin "refs/heads/$branch:refs/heads/$branch" 2>&1 || { echo "dispatch: push of $branch failed" >&2; exit 1; }
  if [ "${held:-}" = mine ]; then rm -f "$owner"; echo "freed this session's lock on $wt"; fi
  # checkpoint.py re-takes the lock at this session's next write there
  [ -n "$wt" ] && case "$(pwd -P)/" in "$(cd "$wt" && pwd -P)/"*)
    echo "⚠ this shell is inside $wt: leave it now (ExitWorktree, keep) and write nothing more there — the next step owns it";; esac
  at="@$(( $(date +%s) + ${DISPATCH_NEXT_DELAY:-90} ))"
  # the next step stays on this session's account unless told otherwise (E5); a bound run's stays bound.
  # On the peer, `auto` picks there at fire time: this session's login may not be set up on it.
  [ -n "$account" ] || [ "${DISPATCH_PIN:-}" != bound ] || account=bound
  [ -n "$account" ] || [ -n "$on" ] || account=$("$ACCT" which 2>/dev/null) || account=""
  size0=0; [ -f "$log" ] && size0=$(wc -c < "$log")   # `wc -c < missing` errs before 2>/dev/null applies
fi

# --next: the run's own header in the log, then still going 20 s later (no FAILED, no exit line).
# Only the bytes written after scheduling count: the log is per day and topic, and may hold an
# earlier run.
# A step sent to the peer is confirmed from the peer's log (rlog, a path under its own $HOME), over ssh.
logread() {
  if [ -n "${rlog:-}" ]; then ${DISPATCH_SSH:-ssh} -o ConnectTimeout=10 -o BatchMode=yes "$peer" "tail -c +$((size0 + 1)) $rlog 2>/dev/null"
  else tail -c +"$((size0 + 1))" "$log" 2>/dev/null; fi
}
confirm() {
  # wall time, not summed sleeps: on the peer each poll is an ssh round trip too (review 2026-10-13)
  local t0=$SECONDS waited=0 limit=${DISPATCH_NEXT_WAIT:-$(( ${DISPATCH_NEXT_DELAY:-90} + 90 ))} new where=""
  [ -n "${rlog:-}" ] && where=" on $on"
  while :; do
    new=$(logread)
    printf '%s\n' "$new" | grep -qF "dispatch $branch (" && break
    if [ "$waited" -ge "$limit" ]; then
      [ -n "${q_qid:-}" ] && { queue_unstarted "$waited"; return $?; }   # the queue's entry decides (S3)
      echo "dispatch: NOT STARTED$where — no run header in ${rlog:-$log} after ${waited} s; ${rlog:+ssh $peer }launchctl list | grep $base" >&2; return 1
    fi
    sleep 5; waited=$((SECONDS - t0))
  done
  sleep "${DISPATCH_NEXT_SETTLE:-20}"
  new=$(logread)
  if printf '%s\n' "$new" | grep -qE '^(FAILED|== exit)'; then
    echo "dispatch: the run started and already ended$where — ${rlog:-$log}:" >&2; printf '%s\n' "$new" | tail -5 >&2; return 1
  fi
  # put back in the queue at fire time (queue_refused's `queued again:`), or queued there by a one-shot's fire
  # (queue_fire): the queue holds the step, which no FAILED says any more — queued, the closing line, never
  # "started" (S3's third landing review, item 1)
  local held
  held=$(printf '%s\n' "$new" | grep -E '^(queued again: |== into the queue at its time: queued as |== the queue holds .* already)' | tail -1)
  if [ -n "$held" ]; then
    echo "queued$where: the run of $branch went back into the queue at its start (${held#== }) — log ${rlog:-$log}"
    queue_close; return 0
  fi
  if printf '%s\n' "$new" | grep -qF "waiting for the run of $topic"; then
    echo "queued$where: the next run of $branch ($model $effort) waits for this run to end — end your turn now; log ${rlog:-$log}"
  elif [ "$headless" = 1 ]; then echo "started$where: claude -p is running $branch ($model $effort); log ${rlog:-$log}"
  else echo "started$where: claude is running $branch ($model $effort) in screen run-$(basename "$repo")-$topic; ${rlog:+ssh $peer }dispatch --status; log ${rlog:-$log}"; fi
  [ "$yolo" = 1 ] && echo "  --yolo: the launch starts from this run once it ends; the log says whether"
  return 0
}

# A direct run goes through launchd (header), --next's margin out: launchd's calendar has minutes,
# so "+60 s" fired anywhere from 0 to 60 s later, and a fire minute already begun never fires.
direct=0
if [ -z "$at" ] && [ "$cancel" = 0 ] && [ -z "${DISPATCH_LABEL:-}" ] && [ "$dry" = 0 ] && [ "$start" = 0 ]; then
  at="@$(( $(date +%s) + ${DISPATCH_NEXT_DELAY:-90} ))"; direct=1
  [ "$probe" = 0 ] && queue_on || echo "dispatch: through launchd, in about $(( ${DISPATCH_NEXT_DELAY:-90} / 60 + 1 )) min — run here, it would die with this shell" >&2
fi

# skipper-modes S1: `dispatch --mode` into the ship's plan.json task (helm mode's write), when the ship is
# on this Mac — plan.json is the authority every reader reads at its decision. A ship elsewhere, or none,
# keeps DISPATCH_MODE alone (the hint). Never fails the schedule.
ship_mode() {
  [ "$mode_given" = 1 ] && [ -n "$skplan" ] && [ "$dry" = 0 ] || return 0
  # an unattended raise of the ship's own task is refused here too (exit 3, the reason on stdout): the
  # early check read the branch, and the ship's task may name another (landing review 5)
  python3 - "$core" "$skplan" "$topic" "$mode" <<'PY' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
import common
p = common.tool("helmlib.py")
if p:
    sys.path.insert(0, str(p.parent))
    import helmlib
    pid, task, mode = sys.argv[2:5]
    with helmlib.locked(pid):
        plan = helmlib.load_plan(pid)
        if plan is not None:
            t = (plan.get("tasks") or {}).get(task) or {}
            old = t.get("mode") if t.get("mode") in helmlib.MODES else helmlib.task_mode(pid, task)[0]
            why = helmlib.raise_refusal(old, mode)
            if why:
                print("dispatch: " + why)
                sys.exit(3)
            plan.setdefault("tasks", {}).setdefault(task, {})["mode"] = mode
            helmlib.save_plan(plan)
            print("mode %s written to ship %s, task %s" % (mode, pid, task))
PY
  [ "$?" = 3 ] && return 3
  return 0
}
# A `--mode`/`--yolo` given here is a newer word on this branch than a `helm mode --branch` entry set
# before it: once the job is scheduled, the entry is replaced by this mode (helmlib.yield_branch_entry),
# so the last writer wins without a reader comparing the entry's ts with a plist's (the follow-ups'
# landing review, item 7). Replaced, not dropped, and only after every refusal: a drop let the branch's
# older run record read through until the run fired, and stayed dropped when a later check refused (the
# second landing review). It passed the raise check above against that entry, so an unattended caller
# writes only a mode it may lower to. A later `helm mode --branch` is newer again. Never fails the schedule.
branch_entry_yield() {
  { [ "$mode_given" = 1 ] || [ "$yolo" = 1 ]; } && [ "$dry" = 0 ] && [ "$probe" = 0 ] && [ -n "$mode" ] || return 0
  python3 - "$core" "$branch" "$repo" "$mode" <<'PY' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
import common
p = common.tool("helmlib.py")
if p:
    sys.path.insert(0, str(p.parent))
    import helmlib
    was = helmlib.yield_branch_entry(sys.argv[2], sys.argv[3], sys.argv[4]) if hasattr(helmlib, "yield_branch_entry") else None
    if was:
        print("dispatch: the helm mode --branch entry on %s (%s) gives way to --mode %s, the newer word"
              % (sys.argv[2], was.get("mode"), sys.argv[4]))
PY
  return 0
}
# The caller's own branch went elsewhere — a peer's schedule, the queue: the session that asked is done
# here, and dispatch-rc tidy closes its Terminal window once it goes idle (hooks/common.py HANDOFFS; the
# owner, 2026-10-08). Nothing for a branch that is not the caller's own (/later takes any): its work stays.
own_branch() {
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "$branch" = "$(git -C "$PWD" branch --show-current 2>/dev/null)" ] \
    && [ "$(cd "$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" \
         = "$(cd "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" ]
}
hand_off() {   # TO
  own_branch || return 0
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import common; common.handed_off(*sys.argv[2:])' \
    "$core" "$CLAUDE_CODE_SESSION_ID" "$1" dispatch "$branch" 2>/dev/null
  # and closed about a minute after this turn ends, not at the next 10-minute tidy (the owner,
  # 2026-10-13: "close the terminal window as soon as dispatch succeeds"); a run's own window
  # goes by its watcher (dispatch-rc idle_limit), which reads the same record
  python3 "$here/bin/dispatch-rc" tidy-soon >/dev/null 2>&1
  return 0
}
# The caller's end once the queue holds the step (S3; the contract's Closing and Waiting): never a retry.
# A caller that waits says why (--wait, named in the entry) and is told the one way to wait, `dispatch
# --watch`; any other ends its turn on the pending line, whose "the next step waits for a run to end" the
# Stop hook's ASK_EXEMPT_RE and helm's CAP_RE pass unchanged, its own branch handed off (hand_off), as --on
# does: dispatch-rc's left_behind() then ends the caller's run after its last turn, and tidy-soon closes
# the window. No new closing kind: `handed` stays the yolo launch's.
queue_close() {
  [ "${qclosed:-0}" = 0 ] || return 0   # once: confirm's own road may have closed already
  qclosed=1
  if [ -n "$waitwhy" ]; then
    echo "waiting ($waitwhy): \`dispatch --watch ${q_qid:-<its entry, as dispatch --queue names it>} [--for MIN]\` blocks until it runs (exit 0), and prints each state — never dispatch it again"
    return 0
  fi
  hand_off queue
  echo "end your turn on this line: ${pendpre}queued $branch ($prio); the next step waits for a run to end; the skipper finishes it"
}
# A --next claimed here with no run header by DISPATCH_NEXT_WAIT: its entry says (S3, the contract: confirm()'s
# NOT STARTED becomes the entry's state, read once by dispatch-queue watch). `waiting` for this run to end, or
# `running`: confirmed. Still claimed or queued: the queue holds it — its job starts it, or its claimer's
# sweep returns it past the lease — and the caller ends on the closing line, nothing to retry. Gone before
# any header: NOT STARTED, as before the queue. Any other exit could not tell: exit 2, the session kept.
queue_unstarted() {   # WAITED
  local out rc
  out=$(python3 "$Q" watch "$q_qid" --until waiting --for 0 "${qctx[@]}" 2>&1); rc=$?
  # exit 1 whose one read was unreadable (a torn tree), or only the last fetch (the home did not answer), is
  # no answer, not "still claimed": could not tell — a stale cache may hold an entry the home has dropped, and
  # the caller would be handed off beside a step that is gone (S3's finish review; S4)
  # the same for exit 0 read off the last fetch: "waiting" or "running" there may be a state the home has left, and exit 3:
  # "gone" there may be a step the home still holds (the final landing review)
  case "$rc:$(printf '%s\n' "$out" | head -1)" in 1:*": unreadable"*|[013]:*"(the home did not answer"*) rc=4;; esac
  case "$rc" in
    0) case "$(printf '%s\n' "$out" | head -1)" in
         *": waiting"*) echo "queued: the next run of $branch ($model $effort) waits for this run to end — end your turn now; queue entry $q_qid; log $log";;
         *) echo "started: claude is running $branch ($model $effort) from queue entry $q_qid; dispatch --status; log $log";;
       esac
       return 0;;
    3) echo "dispatch: NOT STARTED — no run header in $log after $1 s, and its queue entry $q_qid is gone (dispatch --queue; queue.jsonl names why)" >&2
       return 1;;
    1) echo "dispatch: $q_qid is claimed here, no run header in $log after $1 s ($(printf '%s\n' "$out" | head -1 | python3 -c 'import sys; print(sys.stdin.readline().rstrip("\n")[:160])')): the queue holds it — its job starts it, or its claimer's sweep returns it" >&2
       queue_close; return 0;;
    # a refusal (2), a crash (5) or a signal says nothing of the entry: never "held", never handed off — the
    # entry may be gone, and the step with it (S3's third landing review, item 6)
    *) echo "dispatch: could not tell whether the queue holds it (queue entry $q_qid) — dispatch-queue watch exit $rc: $(printf '%s\n' "$out" | head -1 | python3 -c 'import sys; print(sys.stdin.readline().rstrip("\n")[:160])') — and no run header in $log after $1 s — not handed off. End with the WAITING line — the next step waits for a run to end and for the queue to read (\`dispatch --watch $q_qid\` follows it)" >&2
       return 2;;
  esac
}
# The queue's verbs (header, The queue). queue_args: the run's flags and environment as its entry carries
# them into $qa — what the one-shot plist would carry; dispatch-queue's FLAGS and ENV_OK name all a claimed
# entry may hand the fired dispatch. --model and --effort only when given, as the plist and the ssh line carry
# them: written always, the claimed job read the default as typed flags, and the brief's Tier: line could no
# longer decide them (tier_run), or principal_flags refused a principal brief (S3's second landing review, item 1)
queue_args() {
  local v val
  qa=()
  [ "$model_given" = 1 ] && qa+=(--arg=--model "--arg=$model")
  [ "$effort_given" = 1 ] && qa+=(--arg=--effort "--arg=$effort")
  [ -n "$note" ] && qa+=(--arg=--note "--arg=$note")
  [ "$headless" = 1 ] && qa+=(--arg=--headless)
  [ "$yolo" = 1 ] && qa+=(--arg=--yolo)
  [ "$ifroom" = 1 ] && qa+=(--arg=--if-room)
  # --mode only when one was given: an inherited one rides as the hint (DISPATCH_MODE, below), which the fire
  # path reads as the one-shot's plist does, and enqueue judged it a raise (the fourth review's item 12)
  [ "$mode_given" = 1 ] && [ -n "$mode" ] && [ "$mode" != yolo ] && qa+=(--arg=--mode "--arg=$mode")
  [ -n "$bg" ] && qa+=(--arg=--background "--arg=$bg")
  [ -n "$account" ] && qa+=(--arg=--account "--arg=$account")
  [ "$force" = 1 ] && qa+=(--arg=--force)
  [ -n "$needs" ] && qa+=(--arg=--needs "--arg=$needs")   # beside --needs itself: a host that predates S5 skips the flag it does not know
  [ "$prio" = normal ] || qa+=(--arg=--priority "--arg=$prio")
  # the marker alone, never the name it was given: an entry is pushed to the queue's home (S5's rule)
  [ -n "$origin_marker" ] && qa+=(--arg=--origin "--arg=$origin_marker")
  # S9: the predecessors as the entry's own field (enqueue --after records each one's sighting), never as a
  # carried flag: the claim judges them, and its job is handed them back (start_job) to merge origin/<main>
  local b; for b in ${afters[@]+"${afters[@]}"}; do qa+=(--after "$b"); done
  qa+=(--env "DISPATCH_DEPTH=$depth")
  [ -n "$mode" ] && qa+=(--env "DISPATCH_MODE=$mode")
  for v in $SKIPPER_ENV; do
    val="${v%%:*}"; val="${!val}"; [ -n "$val" ] && qa+=(--env "${v#*:}=$val")
  done
}
# run_shown: the run's `== started:` line in its log by DISPATCH_NEXT_WAIT (confirm's limit), the bytes after
# size0 — queue_started prints it once the run's record exists, after every refusal the job meets (mine, the
# account, the cap, memory, the fetch, the worktree, the brief, the tier). The header comes before all of them,
# and a job that refused after it had its caller handed off already (S3's third landing review, item 4).
# 0 started; 1 no line by the limit; 2 the job ended first (FAILED, a stale claim, a refusal the queue did not
# take back); 3 put back in the queue at its start (queued again:), which holds the step. Never `== exit`: every
# end of the job before its start prints one of those first, and an earlier run of the topic, ended by this
# job's after(), writes its own `== exit` here after this header (the second in-round review)
run_shown() {
  local t0=$SECONDS limit=${DISPATCH_NEXT_WAIT:-$(( ${DISPATCH_NEXT_DELAY:-90} + 90 ))} new
  while :; do
    # from the last header of the branch on: lines an earlier run of the topic wrote before it are not this job's
    new=$(logread | awk -v h="dispatch $branch (" 'index($0, h) { buf = "" } { buf = buf $0 "\n" } END { printf "%s", buf }')
    printf '%s\n' "$new" | grep -qF "dispatch $branch (" || { [ $((SECONDS - t0)) -ge "$limit" ] && return 1; sleep 2; continue; }
    printf '%s\n' "$new" | grep -qF "== started: $branch, session " && return 0
    printf '%s\n' "$new" | grep -qE '^queued again: ' && return 3
    printf '%s\n' "$new" | grep -qE '^(FAILED|== a stale queue job|== the queue did not take it back)' && return 2
    [ $((SECONDS - t0)) -ge "$limit" ] && return 1
    sleep 2
  done
}
qparse() {   # dispatch-queue enqueue's JSON line -> q_res q_qid q_ours q_rank q_off q_why q_err, as shell words
  printf '%s\n' "$1" | tail -1 | python3 -c 'import json, shlex, sys
try:
    d = json.loads(sys.stdin.read())
except ValueError:
    d = {}
q = d.get("qid") or ""
v = dict(q_res=d.get("result") or "", q_qid=q, q_ours="1" if q and q in (d.get("claimed") or []) else "0",
         q_rank=str(d.get("rank") or "?"), q_off=d.get("offline") or "", q_why=d.get("no_room") or "", q_err=d.get("error") or "")
print(" ".join("%s=%s" % (k, shlex.quote(x)) for k, x in v.items()))'
}
# A run now on this Mac, through the queue: enqueued and, with room here, claimed and started at once.
# Exits on every answer the queue gave; returns 1 when it could not take the run (the one-shot then).
# The pin from a live run's --next (the ref component's "The pin"): onto this run's own host, so after()
# still serialises the chain, with the run's session as `by`, which lets it replace that run's entry and
# survive its end. Queued with no room, or claimed here already: exit 0 and the one closing line, a --next
# as a direct run (S3, queue_close); one branch live on another host stays a refusal, exit 2 with the cap's
# waiting words (CAP_RE and ASK_EXEMPT_RE key on them), --replace naming the way past it.
queue_dispatch() {
  local out rc pin="" by="${CLAUDE_CODE_SESSION_ID:-}" qerr q_res="" q_qid="" q_ours=0 q_rank="" q_off="" q_err="" q_why="" qhow=""
  queue_args
  # a direct run's start is read from the bytes its job writes after this (run_shown); a --next set it already
  [ "$next" = 1 ] || { size0=0; [ -f "$log" ] && size0=$(wc -c < "$log"); }
  [ "$next" = 1 ] && [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ] && pin="$self_host"
  # a typed --on here keeps it here (the header's promise): unpinned, another host's claim took it (the third
  # review's item 21). berth's pick of this host stays unpinned: a load pick, which any host with room serves
  [ "$on_typed" = 1 ] && pin="$self_host"
  qerr=$(mktemp)
  out=$(python3 "$Q" enqueue --repo "$repo" --branch "$branch" --priority "$prio" ${pin:+--pin "$pin"} ${by:+--by "$by"} \
        ${waitwhy:+--wait "$waitwhy"} $([ "$replace" = 1 ] && echo --replace) ${needs:+--needs "$needs"} \
        --cwd "${DISPATCH_ORIGIN:-$PWD}" --log "$log" "${qa[@]}" --claim "${qctx[@]}" 2>"$qerr"); rc=$?
  eval "$(qparse "$out")"
  # an exit that still printed its entry's id put the entry: it is queued, whatever failed after (the
  # one-shot beside it would run the step twice; the review's items 9 and 13)
  case "$rc" in 0|1|2|3) ;; *) [ -n "$q_qid" ] && rc=0;; esac
  case "$rc" in
    0|3) cat "$qerr" >&2; rm -f "$qerr";;
    2) cat "$qerr" >&2; rm -f "$qerr"; exit 2;;   # refused: a torn registry, a raise by an unattended caller
    1) cat "$qerr" >&2; rm -f "$qerr"; return 1;;   # what the queue alone refuses (its Refused, code 1): the one-shot
    # a queue that does not read counts as an entry of this branch (the readers' rule): a one-shot beside it
    # could run the step on a second Mac (the second review's item 5). Any other exit is a crash (5, or a
    # signal) that could not tell whether the put landed: the same (the third review's item 9)
    *) cat "$qerr" >&2; rm -f "$qerr"
       echo "dispatch: the queue does not read (dispatch-queue exit $rc) — refused, not scheduled: a one-shot beside an entry it cannot see could run $branch twice. End with the WAITING line — the next step waits for a run to end and for the queue to read (dispatch --queue says why; dispatch again once it reads)" >&2; exit 2;;
  esac
  if [ "$q_res" = "claimed here" ]; then
    # this Mac's job of the branch has fired and holds the step (dispatch-queue's put): nothing was queued.
    # In hand, so the caller ends, a --next as a direct run (S3): its exit 2 read as a refusal, and pickup
    # opened a tab beside the job (the first review's open item 1)
    echo "$branch is claimed here already (queue entry $q_qid): its job runs the step, nothing queued again (dispatch --queue)"
    queue_close; exit 0
  fi
  if [ "$rc" = 3 ] && [ -z "$q_qid" ]; then
    # nothing was put: no host that may take the repo meets the run's needs (S5; the reasons are above). The cap's
    # waiting words (CAP_RE, ASK_EXEMPT_RE), as every refusal here: the next step waits for a run to end
    echo "dispatch: $branch is refused, never queued — end with the WAITING line — the next step waits for a run to end and for a host to meet it (the queue's reason is above: a feature line in wharf-runs/features, the repo's berths or clone hosts, or the pin)" >&2; exit 2
  fi
  if [ "$rc" = 3 ]; then
    # the cap's waiting words (CAP_RE, ASK_EXEMPT_RE): this too is a wait for a run to end, elsewhere
    # --end names a run: only a running entry has one; a claimed or waiting one is its job's, and --end there
    # would end the run a waiting step waits for (the third review's item 2). A pin of the caller's own stays
    # with --replace (S3's second review, item 4): the step then waits here for the run there to end
    local behind="there" rp=""; [ "$on_typed" = 1 ] && behind="here, to start once it ends there"
    # --replace is named to an attended caller only: an unattended one is refused it (S3's third landing review, item 6)
    [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}${AUTOFINISH_CALLER_UNATTENDED:-}" ] || rp="; --replace queues this step behind it $behind"
    case "$q_res" in
      "busy running"*) qhow="dispatch --end it there to start it here, or dispatch $branch --cancel there once its run is gone$rp";;
      "busy queued by"*) qhow="that session's step, still queued$([ -n "$rp" ] && echo "; --replace takes it over")";;
      *) qhow="dispatch $branch --cancel there boots its job out$rp";;
    esac
    echo "dispatch: $branch is ${q_res#busy } (queue entry $q_qid) — one branch, one host: end with the WAITING line — the next step waits for a run to end (that one; $qhow)" >&2; exit 2
  fi
  # the reason, not "did not answer" alone: a put that lost the lease thrice waits there too (the fourth review's item 11)
  [ -n "$q_off" ] && echo "dispatch: the entry waits in this Mac's outbox ($q_off), which every queue call and the sweep retry" >&2
  [ -z "$q_err" ] || echo "dispatch: queued as $q_qid, but its claim here failed ($q_err) — a later claim starts it (dispatch --queue)" >&2
  # one pending run per branch, as the one-shot's --next kept it: the queued step replaces a pending one
  [ "$next" = 1 ] && clear_jobs "" "replaced the pending" >&2
  branch_entry_yield >&2
  mark_dispatched "$self_host"
  queue_jobs >&2
  if [ "$q_ours" = 1 ]; then
    # a --next that waits is told the way to wait once confirm has its answer (S3's second review, item 11)
    [ "$next" = 1 ] && { confirm; rc=$?; [ "$rc" = 0 ] && [ -n "$waitwhy" ] && queue_close; exit $rc; }
    echo "started from the queue: $q_qid ($prio) on this Mac, at once; log $log"
    [ -n "$waitwhy" ] && { queue_close; exit 0; }
    own_branch || exit 0
    # the caller's own branch is handed off once its run shows started — its `== started:` line, past the job's
    # refusals (run_shown) — never at the job's load: a job that then failed left the step with its session
    # already gone (S3's second landing review, item 8; the third's item 4). No line by DISPATCH_NEXT_WAIT, or a
    # job that ended first: the session stays, told how to follow the entry
    run_shown; rc=$?
    case "$rc" in
      0) hand_off queue;;
      # the queue holds it again (a fire-time refusal): queued, the closing line, as confirm() reads it
      3) echo "queued: the run of $branch went back into the queue at its start (log $log)"; queue_close;;
      2) echo "dispatch: the run of $branch did not start — its job ended first (log $log); this session is not handed off: \`dispatch --watch $q_qid\` says where the entry is";;
      *) echo "dispatch: no run started in $log yet — this session is not handed off: \`dispatch --watch $q_qid\` follows the entry, and the queue holds it";;
    esac
    exit 0
  fi
  # queued, with no room here: exit 0 for a --next too (S3: it kept exit 2 and the cap's words in S1), and
  # the one closing line — the caller never dispatches the step again
  echo "queued as $q_qid ($prio), rank $q_rank: no room on this Mac now${q_why:+ ($q_why)} — it starts once a slot frees and a claim takes it (dispatch --queue; dispatch $branch --cancel takes it off)"
  queue_close; exit 0
}
# A fire-time refusal — the cap, memory, no account may run it — back into the queue (G1: no run lost at
# fire time): a claimed entry returns to queued with this host's refusal (it skips it an hour), a one-shot's
# run is enqueued with it. Never a --start (autofinish-run re-runs itself) or a probe. Returns 0 once the
# queue holds it, and says `queued again: WHY` — the contract's fire-time line, in place of the FAILED one
# (S3: helm's follow-up reads FAILED as a fire-time refusal that spends no retry, and starts the step again
# itself — beside the entry the queue still holds, which then ran it twice); 1 with nothing said when no
# queue took it, and the caller says FAILED as before the queue. SKIP: the hour's skip here even when the
# entry is pinned here — a named login past its limits is pinned to its host, whose next claim (a sweep, a
# run's end) would meet the same limit, and the host re-claimed it every pass until the login reset (S3's
# landing review, item 4).
queue_refused() {   # WHY [skip]
  [ "$dry" = 0 ] && [ "$start$probe" = 00 ] || return 1
  local sk=(); [ "${2:-}" = skip ] && sk=(--skip-hour)
  if [ -n "$fromq" ]; then
    local rrc
    python3 "$Q" refused "$fromq" --label "${DISPATCH_LABEL:-}" --why "$1" ${sk[@]+"${sk[@]}"} "${qctx[@]}"; rrc=$?
    # a crash or an unread home put nothing back: said, and the caller's FAILED and the exit's `failed` follow,
    # never "queued again" (S3's second landing review, item 7)
    [ "$rrc" = 0 ] || { echo "== the queue did not take it back (dispatch-queue refused exit $rrc): not queued again"; return 1; }
    qdone=1
    if [ ${#sk[@]} -gt 0 ]; then
      echo "queued again: $1 — this Mac skips it for an hour, pinned here or not (dispatch --queue)"
    else
      echo "queued again: $1 — a host with room claims it; this Mac skips it for an hour, unless it is pinned here (dispatch --queue)"
    fi
    return 0
  fi
  [ -n "${DISPATCH_LABEL:-}" ] && queue_on || return 1
  skipper_env; queue_args
  # the caller's cwd as its one-shot recorded it (DISPATCH_ORIGIN): launchd starts the job in /, and a run
  # sent from a confidential scope's checkout must queue in that scope, never the fleet ref (item 4)
  local qrc out q_res="" q_qid="" q_ours=0 q_rank="" q_off="" q_why="" q_err=""
  out=$(python3 "$Q" enqueue --repo "$repo" --branch "$branch" --priority "$prio" --cwd "${DISPATCH_ORIGIN:-$repo}" ${needs:+--needs "$needs"} "${qa[@]}" --refused "$1" ${sk[@]+"${sk[@]}"} "${qctx[@]}"); qrc=$?
  if [ "$qrc" = 0 ]; then
    echo "queued again: $1 — this Mac skips it for an hour; a host with room claims it (dispatch --queue)"
    return 0
  fi
  # the put is guarded as every other (S4): a live session's step of the branch, queued already, is kept, and
  # this one-shot adds nothing — the queue holds the branch's step, so no FAILED (helm would start it again)
  if [ "$qrc" = 3 ]; then
    eval "$(qparse "$out")"
    case "$q_res" in "busy queued by"*)
      qdone=1; echo "queued again: $1 — a live session's step of $branch waits in the queue already (${q_res#busy }, $q_qid); this one-shot adds nothing (dispatch --queue)"
      return 0;; esac
  fi
  # the code read before any other command runs: after an `if`, $? was the if's own 0 (S3's review, item 9)
  echo "== not queued (dispatch-queue exit $qrc): this run is lost, as before the queue"
  return 1
}
# A one-shot at its fire time, into the queue (S3, the contract's Replacing: "--at WHEN stays a one-shot; at
# fire time it enqueues (age from WHEN)"): its label's minute is WHEN. 0 once the queue holds it — claimed
# here and started by the claim's own job, or queued for the next claim; this job is then done. One branch
# live on another host, or a refusal (a torn registry), is FAILED here as the --elsewhere check says it. 1
# when the queue cannot take it (exit 1) or does not read (4): the run goes ahead as before the queue. A crash
# is FAILED. Called after the fire path's quiet refusals (fire_refusals), so a refusal the run would meet
# here anyway — the depth, physical, --if-room — files no queue card (S3's second landing review, item 5).
queue_fire() {
  local when out rc q_res="" q_qid="" q_ours=0 q_rank="" q_off="" q_why=""
  # the seconds spelled out: BSD date fills a field the format leaves out from the clock
  # GNU date reads no packed stamp: a one-shot's twelve digits spelled out for epochof (a claimed job's `q` stamp
  # reads on neither, as before)
  when=$(date -j -f %Y%m%d%H%M%S "${DISPATCH_LABEL##*.}00" +%s 2>/dev/null) \
    || { m="${DISPATCH_LABEL##*.}"; case "$m" in [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9])
         when=$(epochof "${m:0:4}-${m:4:2}-${m:6:2} ${m:8:2}:${m:10:2}");; *) false;; esac; } || when=""
  skipper_env; queue_args
  # a one-shot sent to a typed host stays there (DISPATCH_HOST_PIN, its plist's): unpinned, any host's claim took it
  out=$(python3 "$Q" enqueue --repo "$repo" --branch "$branch" --priority "$prio" ${when:+--queued-at "$when"} \
        $([ "${DISPATCH_HOST_PIN:-}" = 1 ] && echo "--pin $self_host") ${needs:+--needs "$needs"} \
        --cwd "${DISPATCH_ORIGIN:-$repo}" --log "$log" "${qa[@]}" --claim "${qctx[@]}"); rc=$?
  eval "$(qparse "$out")"
  case "$rc" in 0|1|2|3) ;; *) [ -n "$q_qid" ] && rc=0;; esac
  case "$rc" in
    0) ;;
    3) case "$q_res" in "busy queued by"*)
         # a live session's own step of the branch waits in line already: this one-shot adds nothing to it
         echo "== the queue holds $branch already ($q_qid, ${q_res#busy }); this one-shot adds nothing"; return 0;; esac
       # exit 3 with no entry: no host meets the run's needs, or may take the repo (S5); nothing was put
       [ -n "$q_qid" ] || { echo "FAILED: the queue refused it at fire time (above): no host meets it; not running"; exit 1; }
       echo "FAILED: $branch is ${q_res#busy } through the queue ($q_qid) — one branch, one host; not running"; exit 1;;
    2) echo "FAILED: the queue refused it at fire time (above); not running"; exit 1;;
    1) [ -z "$needs" ] || { echo "FAILED: the queue could not take it at fire time, and a run before the queue cannot judge --needs $needs; not running"; exit 1; }
       echo "== the queue could not take it at fire time; running it as before the queue"; return 1;;
    4) [ -z "$needs" ] || { echo "FAILED: the queue did not read at fire time (dispatch-queue exit 4), and a run before the queue cannot judge --needs $needs; not running"; exit 1; }
       echo "== the queue did not read at fire time (dispatch-queue exit 4); running it as before the queue"; return 1;;
    # a crash (5, a signal) could not tell whether the put landed: run here, the step could run twice, as
    # queue_dispatch refuses it (S3's second landing review)
    *) echo "FAILED: the queue crashed at fire time (dispatch-queue exit $rc) and may hold the step; not running (dispatch --queue says)"; exit 1;;
  esac
  if [ "$q_res" = "claimed here" ]; then echo "== the queue: $q_qid is claimed here already; its job runs the step"
  elif [ "$q_ours" = 1 ]; then echo "== into the queue at its time: $q_qid ($prio), claimed here, started by its own job"
  else echo "== into the queue at its time: queued as $q_qid ($prio), rank $q_rank${q_why:+ — no room here ($q_why)}; a claim starts it (dispatch --queue)"; fi
  return 0
}
# `mine` could not tell (4 unreadable, or a crash): the claim goes back to queued, conditional on still being
# this job's — the refusal waits in the outbox while the home is away. Exiting as "stale" left the entry
# claimed or waiting here with no job, and S1 has no sweep to return it (the third review's item 10). 3 is
# the one "not mine": never this job's to move.
queue_unsure() {   # MRC WHY
  case "$1" in 0|3) return 0;; esac
  queue_refused "the queue did not read at fire time on $self_host (mine exit $1: ${2:-no answer})" \
    || echo "FAILED: the queue did not say whether $fromq is still this job's claim (exit $1: ${2:-no answer}); not running"
  exit 1
}
# A stale job ran nothing: its reservation goes now, not at the lease (the first review's item 10); by its own
# label only, so a newer claim of the entry keeps its slot
queue_unreserve() {
  [ -n "${DISPATCH_LABEL:-}" ] && python3 "$Q" unreserve "$fromq" --label "$DISPATCH_LABEL" "${qctx[@]}" >/dev/null 2>&1
  return 0
}
# The record exists: a claimed entry is running; a run not from the queue marks a queued entry of its
# branch as live here (one branch, one host).
queue_started() {
  # S9: a queued landing's entry goes once its record holds the slot (dispatch-queue started, the _land store)
  [ -n "$landq" ] && { python3 "$Q" started "$landq" --label "landing.$$" --session "$sid" "${qctx[@]}" > /dev/null 2>&1; }
  [ "$start$probe" = 00 ] || return 0
  echo "== started: $branch, session $sid"   # past every refusal: what run_shown hands its caller off on
  if [ -n "$fromq" ]; then python3 "$Q" started "$fromq" --label "${DISPATCH_LABEL:-}" --session "$sid" "${qctx[@]}"; qdone=1
  elif queue_on; then python3 "$Q" started --repo "$repo" --branch "$branch" --session "$sid" "${qctx[@]}"; fi
}
# The run's end: its entry goes, by CAS, only while its session is this run's — a pinned --next that
# replaced it stays (the ref component's "The end")
# S10: dispatch --requeue ended this run (its record's end_reason opens `requeued`): its entry is the requeue's,
# queued again by its op, so no end removes it, no landing starts, and a Mac about to sleep claims nothing
# `ending` too: a headless run writes its own exit code over the reason end_run gives (the landing review)
requeued_end() {
  [ -n "${state:-}" ] && [ -f "$state" ] || return 1
  python3 -c 'import json, sys
st = json.load(open(sys.argv[1]))
sys.exit(0 if any(str(st.get(k) or "").startswith("requeued") for k in ("ending", "end_reason")) else 1)' "$state" 2>/dev/null
}
queue_ended() {
  [ "$start$probe" = 00 ] && [ -n "${sid:-}" ] || return 0
  requeued_end && { echo "== requeued: its entry is the requeue's (dispatch --requeue), not this end's"; return 0; }
  [ -n "$fromq" ] || queue_on || return 0
  python3 "$Q" ended --repo "$repo" --branch "$branch" --session "$sid" "${qctx[@]}"
}
# This run's slot is free: a claim takes what waits for one, or a --next queued on a full host sat until
# some unrelated dispatch (the second review's item 6). After yolo_launch, and not at all when it started
# a landing: the landing (autofinish-run, its dispatch --start a few seconds on) takes this slot, and its
# own end claims — a claim first took the slot and refused the landing at its cap, at every run end (the
# third review's item 11). S2's watcher claim takes this over for every run.
queue_claim() {
  [ "$probe" = 0 ] && [ "${launched:-0}" = 0 ] || return 0
  requeued_end && return 0
  queue_on && python3 "$Q" claim "${qctx[@]}"
}
if [ -n "$at" ]; then
  [ "$probe" = 1 ] || skipper_env
  [ "$probe" = 1 ] || ship_mode >&2 || exit 2
  [ "$probe" = 1 ] || [ "$depth" -le "$maxdepth" ] || { deep >&2; exit 2; }
  [ -n "$on" ] || physical_ok >&2 || exit 2   # with --on, the peer's dispatch checks its own copy
  # fail now, not at fire time after the job has removed itself
  git -C "$repo" ls-remote --exit-code origin "$branch" >/dev/null 2>&1 || { echo "dispatch: $branch is not on origin" >&2; exit 1; }
  # bound: the pick is made at fire time, but a primary already out of room this week is said now,
  # not in a log after the caller reported the run as started (review 2026-10-10); --at reset waits for it
  if [ "$account" = bound ]; then case "$at" in reset*) ;; *)
    # stdout alone is the answer; a warning on stderr is quoted, never parsed (pick_account's note)
    berr=$(mktemp); bout=$("$ACCT" pick --bound --repo "$repo" --json --cached 2>"$berr"); brc=$?
    bout="$(tr '\n' ' ' < "$berr")$bout"; rm -f "$berr"
    [ $brc != 3 ] || { echo "dispatch: --account bound: the primary has no room now ($(printf '%s' "$bout" | tr '\n' ' ' | cut -c1-200)); $([ "$next" = 1 ] && echo "end with the WAITING line naming its weekly reset" || echo "--at reset waits for its weekly reset")" >&2; exit 1; };;
  esac; fi
  case "$at" in
    reset|reset+*)
      # tier_check.weekly() is the one reader of the plan's resets_at (it rolls a stale cache forward)
      case "$account" in
        ''|auto|bound) epoch=$(python3 -c '   # bound: the primary is the default dir, ~/.claude.json
import json, os, sys
sys.path.insert(0, sys.argv[1])
import common
from importlib.machinery import SourceFileLoader
tc = common.tool("tier_check.py")   # plumb (M7): without it the reset is unknown here
if not tc:
    sys.exit(1)
tier_check = SourceFileLoader("tier_check", str(tc)).load_module()
w = tier_check.weekly(json.load(open(os.path.expanduser("~/.claude.json"))))
if not w or not w[2]:
    sys.exit(1)
print(int(w[2]) + int((sys.argv[2] or "+10").lstrip("+")) * 60)
' "$core" "${at#reset}") || { echo "dispatch: the weekly reset time is unknown here; give --at a time" >&2; exit 1; };;
        *) # a named account: its own week, from its last probe here (E5)
           epoch=$("$ACCT" limits "$account" --cached --json 2>/dev/null | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except ValueError:
    rows = None
r = (rows[0].get("limits") or {}).get("seven_day_resets") if rows else None
if not r:
    sys.exit(1)
print(int(r) + int((sys.argv[1] or "+10").lstrip("+")) * 60)
' "${at#reset}") || { echo "dispatch: $account's weekly reset is unknown here (account limits $account probes it); give --at a time" >&2; exit 1; };;
      esac
      at="@$epoch";;
  esac
  if [ -n "$on" ]; then
    case "$at" in @*) ;; *) echo "dispatch: --on needs reset or @EPOCH (a bare clock time is ambiguous across hosts)" >&2; exit 2;; esac
    [ "$repo" = "$primary" ] || case "$repo" in "$projects/"*) ;; *) echo "dispatch: --on needs a repo under $projects" >&2; exit 2;; esac
    # the skipper's page before the defaulted now is taken again below, so its publish eats no margin
    [ "$probe" = 1 ] || skipper_page
    # a defaulted "now": taken again here, after the push and the checks, so the peer's fire minute
    # has not begun by the time it schedules (review 2026-10-13); a little more margin for the ssh
    [ "$at_default" = 1 ] || [ "$next" = 1 ] && at="@$(( $(date +%s) + ${DISPATCH_NEXT_DELAY:-90} + 15 ))"
    # the peer's checkout of this repo; its own clock turns the epoch into its local time
    # the peer adds one to the depth, as this script would
    skenv=""; for v in $SKIPPER_ENV; do
      val="${v%%:*}"; val="${!val}"; [ -n "$val" ] && skenv="$skenv ${v#*:}=$(printf '%q' "$val")"
    done
    # a host the caller typed (not the dispatch host's default, nor berth's load pick) is a pin: the one-shot
    # there carries it, and its fire-time enqueue keeps it there (S3's landing review, item 8)
    pinv=""; [ "$on_default$on_auto" = 00 ] && pinv="DISPATCH_HOST_PIN=1 "
    cmd="${skenv# }${skenv:+ }${pinv}DISPATCH_DEPTH=$d0 $rbin $(printf '%q' "$branch") --at $at"
    # only the flags given: the peer's fire-time read of the brief's Tier: line decides the rest (tier_run)
    [ "$model_given" = 1 ] && cmd="$cmd --model $(printf '%q' "$model")"
    [ "$effort_given" = 1 ] && cmd="$cmd --effort $(printf '%q' "$effort")"
    # another repo: its path under the projects folder, whose home differs per host (one login name each)
    [ "$repo" != "$primary" ] && case "$repo" in "$projects/"*) cmd="$cmd --repo \$HOME/projects/$(printf '%q' "${repo#"$projects"/}")";; *) echo "dispatch: --on needs a repo under $projects" >&2; exit 2;; esac
    echo "scheduling on $on for epoch ${at#@} ($(dateat "${at#@}" '+%F %H:%M %Z') on this Mac)" >&2
    [ -n "$note" ] && cmd="$cmd --note $(printf '%q' "$note")"
    [ -n "$origin" ] && cmd="$cmd --origin $(printf '%q' "$origin")"
    [ "$probe" = 1 ] && cmd="$cmd --probe"
    [ "$headless" = 1 ] && cmd="$cmd --headless"
    [ "$yolo" = 1 ] && cmd="$cmd --yolo"
    [ "$ifroom" = 1 ] && cmd="$cmd --if-room"
    [ -n "$mode" ] && [ "$mode" != yolo ] && cmd="$cmd --mode $mode"
    [ -n "$bg" ] && cmd="$cmd --background $bg"
    [ -n "$account" ] && cmd="$cmd --account $(printf '%q' "$account")"
    [ "$force" = 1 ] && cmd="$cmd --force"
    [ "$prio" = normal ] || cmd="$cmd --priority $prio"
    [ -n "$needs" ] && cmd="$cmd --needs $needs"
    for b in ${afters[@]+"${afters[@]}"}; do cmd="$cmd --after $(printf '%q' "$b")"; done   # S9: the peer waits on them too
    [ "$dry" = 1 ] && cmd="$cmd --dry-run"
    # --next: its log named here, so the start can be confirmed from it (confirm, over ssh)
    if [ "$next" = 1 ]; then
      rlog="\$HOME/Library/Logs/claude-weekly/$(printf '%q' "$(date +%Y-%m-%d)-dispatch-$topic.log")"; cmd="DISPATCH_LOG=$rlog $cmd"
    fi
    # a peer whose dispatch predates bound would read it as a label and fail at fire time, unseen here
    # (the peer runs its core's module: that file is the one read)
    guard='grep -qs -- "pick --bound" "$(head -1 "${REGATTA_CONFIG:-$HOME/.config/regatta}/home" 2>/dev/null)/modules/wharf-runs/bin/dispatch" || { echo "dispatch on $(hostname -s) predates --account bound: pull its regatta main" >&2; exit 3; }; '
    [ "$account" = bound ] || guard=""
    remote=1
    # the repo must be there too: one cloned only here (2026-10-13) falls back like an old peer, and so
    # does a peer whose config dir names no core
    rdir="\$HOME/projects/$(printf '%q' "$(basename "$primary")")"; [ "$repo" != "$primary" ] && rdir="\$HOME/projects/$(printf '%q' "${repo#"$projects"/}")"
    if [ -n "$fallback" ]; then   # header, --fallback: probe, then the real call whose answer stands
      ${DISPATCH_SSH:-ssh} -o ConnectTimeout=10 -o BatchMode=yes "$peer" "${guard}[ -x $rbin ] || { echo \"dispatch: no regatta core on \$(hostname -s)\" >&2; exit 3; }; [ -d $rdir ] || { echo \"dispatch: no $rdir on \$(hostname -s)\" >&2; exit 3; }"; rc=$?
      case "$rc" in
        0) ;;
        255) echo "dispatch: $on is unreachable (ssh exit 255); scheduling it on this Mac instead (--fallback here)" >&2; remote=0;;
        3) echo "dispatch: scheduling it on this Mac instead (--fallback here)" >&2; remote=0;;
        *) echo "dispatch: the probe of $on failed (exit $rc); not scheduling" >&2; exit "$rc";;
      esac
    fi
    if [ "$remote" = 1 ]; then
      [ "$next" = 1 ] && size0=$(${DISPATCH_SSH:-ssh} "$peer" "[ -f $rlog ] && wc -c < $rlog || echo 0" 2>/dev/null | tr -dc 0-9)
      size0=${size0:-0}
      ${DISPATCH_SSH:-ssh} "$peer" "$guard$cmd"; rc=$?
      # --next: scheduled is not started — the run's header in the peer's log, as here
      [ "$rc" = 0 ] && [ "$dry$probe" = 00 ] && mark_dispatched "$on"
      [ "$rc" = 0 ] && branch_entry_yield >&2   # the peer replaces its own; this Mac's sweep reads this one
      [ "$rc" = 0 ] && [ "$next" = 1 ] && { confirm || rc=1; }
      # scheduled there: the session that asked is done here, and dispatch-rc tidy closes its Terminal
      # window once it goes idle (hooks/common.py HANDOFFS; the owner, 2026-10-08). A dry run hands nothing off,
      # nor a probe, nor a branch that is not the caller's own (/later takes any): its work stays here.
      [ "$rc" = 0 ] && [ "$dry" = 0 ] && [ "$probe" = 0 ] && [ "${qclosed:-0}" = 0 ] && hand_off "$on"   # once: confirm's queue_close may have
      exit "$rc"
    fi
    # here, by this Mac's rules: the check the peer would have made, and a fire minute not yet begun
    physical_ok >&2 || exit 2
    rlog=""; on=""; direct=$at_default   # a defaulted "now" is a direct run: it replaces no /later job here
    if [ "$next" = 1 ]; then   # the cap and the account --next would have taken here (with the queue, the claim's)
      if ! queue_on; then
        n=$(python3 "$here/bin/dispatch-rc" live "$repo" "$topic") || n=0
        [ "$n" -lt "$(pcap)" ] || { echo "dispatch: $n runs are busy already here, and the peer is unreachable — refused, with no queue home here (wharf-runs/queue-repo): end with the WAITING line" >&2; exit 2; }
        why=$(roomy) || { echo "dispatch: $why here, and the peer is unreachable — refused, with no queue home here (wharf-runs/queue-repo): end with the WAITING line" >&2; exit 2; }
      fi
      [ -n "$account" ] || account=$("$ACCT" which 2>/dev/null) || account=""
      size0=0; [ -f "$log" ] && size0=$(wc -c < "$log")
    fi
    soon=$(( $(date +%s) + 90 )); [ "${at#@}" -ge "$soon" ] || at="@$soon"
  fi
  # a run now on this Mac (a direct run, a --next) goes through the queue once it has a home: enqueued,
  # then claimed here if this host has room — started at once by a RunAtLoad job — else left queued for
  # the next claim (header, The queue). A queue that cannot take it leaves the one-shot below.
  # S9: --after with no queue home here has nowhere to wait: the run goes only if every predecessor has landed
  # now, and is refused otherwise in the cap's waiting words (CAP_RE, ASK_EXEMPT_RE: a skippered run ending on it
  # is no unrelayed ask). With a home, the entry waits and the claim judges (dispatch-queue after_holds)
  if [ "$probe$dry" = 00 ] && [ ${#afters[@]} -gt 0 ] && [ -z "$on" ] && { [ "$direct" = 1 ] || [ "$next" = 1 ]; } && ! queue_on; then
    for b in "${afters[@]}"; do
      v=$(python3 "$here/bin/landed.py" judge "$repo" "$b" 2>&1) \
        || { echo "dispatch: --after $b has not landed (${v:-no answer}), and there is no queue home here to wait in (wharf-runs/queue-repo) — refused: end with the WAITING line — the next step waits for a run to end and for $b to land (dispatch again once it has)" >&2; exit 2; }
    done
  fi
  if [ "$probe$dry" = 00 ] && { [ "$direct" = 1 ] || [ "$next" = 1 ]; } && queue_on; then
    # the entry carries the skipper's env (queue_args), so the page goes first; only the queue's own
    # refusals follow it (peer-manager-relay S1, on main's queue road)
    skipper_page
    if ! queue_dispatch; then
      # a --next skipped the up-front cap for the claim's; with no claim it meets the cap here, or a full
      # host would schedule a one-shot the fire time refuses and loses (the fourth landing review)
      if [ "$next" = 1 ] && [ -z "$on" ]; then
        n=$(python3 "$here/bin/dispatch-rc" live "$repo" "$topic") || n=0
        [ "$n" -lt "$(pcap)" ] || { echo "dispatch: $n runs are busy already, and the queue could not take it (above) — refused: end with the WAITING line — the next step waits for a run to end (dispatch --next once one has)" >&2; exit 2; }
        why=$(roomy) || { echo "dispatch: $why, and the queue could not take it (above) — refused: end with the WAITING line — the next step waits for a run to end and memory to free (dispatch --next once one has)" >&2; exit 2; }
      fi
      # the one-shot judges neither the run's needs nor the scope's berths: where berth's pick was skipped for the
      # queue's claim, a run that needs a feature is refused, and one for a repo this Mac may not take (berth's
      # privacy filters) too (S5's review)
      [ -z "$needs" ] || { echo "dispatch: the queue could not take it (above), and a one-shot cannot judge --needs $needs — refused: end with the WAITING line — the next step waits for a run to end and for the queue to take it (dispatch again once it can)" >&2; exit 2; }
      if [ "$qauto" = 1 ]; then
        bout=$(python3 "$here/bin/berth" "$repo" --json --no-log 2>/dev/null); brc=$?
        if [ "$brc" = 3 ] || { [ "$brc" = 0 ] && ! printf '%s' "$bout" | python3 -c 'import json, sys; sys.exit(0 if sys.argv[1].lower() in [c.lower() for c in json.load(sys.stdin).get("candidates") or []] else 1)' "$self_host" 2>/dev/null; }; then
          echo "dispatch: the queue could not take it (above), and the repo's berths or clone hosts leave this Mac out — refused: end with the WAITING line — the next step waits for a run to end and for the queue to take it" >&2; exit 2
        fi
      fi
      echo "dispatch: the queue could not take it — scheduling it as before, a one-shot" >&2
    fi
  fi
  case "$at" in @*) at="$(dateat "${at#@}" '+%Y-%m-%d %H:%M')";; esac
  # "YYYY-MM-DD HH:MM" -> the four keys launchd matches on
  read -r d t <<<"$at"; IFS=- read -r yr mo dy <<<"$d"; IFS=: read -r hr mi <<<"$t"
  [ -n "${mi:-}" ] || { echo "dispatch: --at wants \"YYYY-MM-DD HH:MM\"" >&2; exit 2; }
  # launchd's calendar has no year: a time already past would sit loaded and fire next year
  when=$(epochof "$at") && [ "$when" -gt "$(date +%s)" ] || { echo "dispatch: $at is not in the future" >&2; exit 2; }
  # …and one a year or more ahead would fire at the first match, meet the year guard and vanish
  [ $((when - $(date +%s))) -lt 31536000 ] || { echo "dispatch: $at is a year or more ahead; launchd's calendar has no year" >&2; exit 2; }
  # here, the page after every refusal; a publish that outlasted the margin to the fire minute is refused
  # as any past time is, and the page stays for the next dispatch, which publishes nothing (the S1 review)
  if [ "$probe" = 0 ] && [ -z "$skspace" ] && [ "$sktyped" = 1 ]; then
    skipper_page
    [ "$when" -gt "$(date +%s)" ] || { echo "dispatch: $at passed while the skipper's page published; dispatch again — the page is kept" >&2; exit 2; }
  fi
  # its own label: a job that has fired has a minute at or before now, this one's is after it
  label="$base.$(dateat "$when" +%Y%m%d%H%M)"; plist="$LA/$label.plist"
  args="<string>$jobbin</string><string>$branch</string><string>--repo</string><string>$repo</string>"
  # only the flags given, as over ssh: the job reads the brief's Tier: line when it fires (tier_run)
  [ "$model_given" = 1 ] && args="$args<string>--model</string><string>$model</string>"
  [ "$effort_given" = 1 ] && args="$args<string>--effort</string><string>$effort</string>"
  [ -n "$note" ] && args="$args<string>--note</string><string>$(printf '%s' "$note" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')</string>"
  [ -n "$origin" ] && args="$args<string>--origin</string><string>$(printf '%s' "$origin" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')</string>"
  [ "$probe" = 1 ] && args="$args<string>--probe</string>"
  [ "$headless" = 1 ] && args="$args<string>--headless</string>"
  [ "$yolo" = 1 ] && args="$args<string>--yolo</string>"
  [ "$ifroom" = 1 ] && args="$args<string>--if-room</string>"
  [ -n "$bg" ] && args="$args<string>--background</string><string>$bg</string>"
  [ -n "$account" ] && args="$args<string>--account</string><string>$account</string>"
  [ "$force" = 1 ] && args="$args<string>--force</string>"
  [ -n "$needs" ] && args="$args<string>--needs</string><string>$needs</string>"
  [ "$prio" = normal ] || args="$args<string>--priority</string><string>$prio</string>"
  # S9: a one-shot judges its predecessors when it fires (after_merge), or carries them into the queue then
  for b in ${afters[@]+"${afters[@]}"}; do args="$args<string>--after</string><string>$b</string>"; done
  # behind claude-host once this Mac's sitting is done (docs/tcc-one-identity-2026-10-18.md): a job
  # that starts bash is charged to bash, and every third-party program it starts — the run's claude
  # among them — to its own path, which for claude every update replaces
  launch=$("$RCH" --launcher "$jobbin" 2>/dev/null) && args="<string>$launch</string>$args"
  # the caller's cwd, for the queue's route should the run be refused at fire time (queue_refused): a
  # fired job starts in /, and a run sent from a confidential scope's checkout stays in that scope
  # (not $origin: that is --origin's scope or marker, S5)
  ocwd="${DISPATCH_ORIGIN:-$PWD}"
  # pinned to this Mac: a typed `--on here`, or a peer's typed `--on <this host>` (DISPATCH_HOST_PIN from its ssh line;
  # its own name: DISPATCH_PIN is a bound run's account pin, `bound`, which its --next reads — S3's second review)
  # and an unattended --next, pinned here on the queue road (queue_dispatch: after() waits for its run on this
  # host): the one-shot it falls back to, should the queue not take it, keeps that pin at its fire-time enqueue
  # (S3's finish review; S4)
  opin=""; { [ "$on_typed" = 1 ] || [ "${DISPATCH_HOST_PIN:-}" = 1 ] || { [ "$next" = 1 ] && [ -n "${REGATTA_UNATTENDED:-${CLAUDE_UNATTENDED:-}}" ]; }; } && opin=1
  skipper_plist() {   # the skipper's five, under both names, only when there is a skipper (R1)
    local k v
    for k in $SKIPPER_ENV; do
      v="${k%%:*}"; v="${!v}"; [ -n "$v" ] && printf '<key>%s</key><string>%s</string>' "${k#*:}" "$(printf '%s' "$v" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
    done
  }
  xml="<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>$args</array>
  <key>EnvironmentVariables</key><dict><key>DISPATCH_LABEL</key><string>$label</string><key>DISPATCH_LOG</key><string>$log</string><key>DISPATCH_YEAR</key><string>$yr</string><key>DISPATCH_DEPTH</key><string>$depth</string><key>DISPATCH_ORIGIN</key><string>$(printf '%s' "$ocwd" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')</string>${opin:+<key>DISPATCH_HOST_PIN</key><string>1</string>}${mode:+<key>DISPATCH_MODE</key><string>$mode</string>}$(skipper_plist)</dict>
  <key>StartCalendarInterval</key><dict><key>Month</key><integer>$((10#$mo))</integer><key>Day</key><integer>$((10#$dy))</integer><key>Hour</key><integer>$((10#$hr))</integer><key>Minute</key><integer>$((10#$mi))</integer></dict>
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
</dict></plist>"
  if [ "$dry" = 1 ]; then echo "$xml"; exit 0; fi
  mkdir -p "$(dirname "$plist")" "$(dirname "$log")"
  # one pending run per branch, as before — but a direct run leaves a pending /later job alone: it
  # was scheduled on purpose, and replacing it unasked would lose it silently (re-review 2026-10-05)
  if [ "$direct" = 1 ]; then
    for p in $(jobs); do [ "$p" = "$plist" ] || echo "left $(basename "$p" .plist) scheduled: a direct run replaces no /later job (dispatch --cancel clears it)" >&2; done
  else
    clear_jobs "$plist" "replaced the pending" >&2
  fi
  printf '%s\n' "$xml" > "$plist"
  "$LC" bootout "gui/$(id -u)/$label" 2>/dev/null
  # bootout returns before the old job is gone (rc-hosts met "5: Input/output error" here): retry once
  "$LC" bootstrap "gui/$(id -u)" "$plist" 2>/dev/null || { sleep 2; "$LC" bootstrap "gui/$(id -u)" "$plist"; } || { rm -f "$plist"; echo "dispatch: launchctl bootstrap failed (plist removed)" >&2; exit 1; }
  echo "scheduled $label for $at (host-local); log $log"
  branch_entry_yield >&2
  [ "$probe" = 1 ] || mark_dispatched "$self_host"
  [ "$next" = 1 ] || exit 0
  confirm; exit $?
fi

# From here on: the run itself (fired by launchd, or --dry-run).
held=""   # the start lock is ours (take_lock); $cache and $lockd are set before the flags
# plist first: bootout SIGTERMs this very script, and a plist left behind fires again next year.
# Its own label only, never the branch's: a successor this run scheduled is another job.
cleanup() {
  drop_lock 2>/dev/null
  # the plist before the queue's network call below: a shutdown's timeout cut short here would leave a
  # RunAtLoad job that fires again at the next login (the review's item 3)
  [ -n "${DISPATCH_LABEL:-}" ] && rm -f "$LA/$DISPATCH_LABEL.plist"
  # a claim whose run ended before its record (no brief, not on origin, the depth…): the entry goes with
  # a card, never back to queued, where every claim would fail the same way
  if [ -n "$fromq" ] && [ "$qdone" = 0 ] && [ "$dry" = 0 ]; then
    # its reason from the bytes this job wrote: the log is the day's for the topic, and an earlier run's
    # FAILED line is not this one's (the second review's item 7)
    python3 "$Q" failed "$fromq" --label "${DISPATCH_LABEL:-}" --why "$(tail -c +$((qlog0 + 1)) "$log" 2>/dev/null | grep '^FAILED' | tail -1 | cut -c1-200)" "${qctx[@]}" >> "$log" 2>&1
  fi
  [ -n "${DISPATCH_LABEL:-}" ] && "$LC" bootout "gui/$(id -u)/$DISPATCH_LABEL" 2>/dev/null
}
qlog0=0; [ -f "$log" ] && qlog0=$(wc -c < "$log" | tr -d ' ')
trap cleanup EXIT
# a job that survived a crash or reboot fires a year late: refuse it. A queue job's plist carries no year (it
# runs at load, and `mine` judges a stale one): a claim in a year's last seconds failed its entry (the first
# review's item 6; dispatch-queue start_job)
if [ -n "${DISPATCH_YEAR:-}" ] && [ "$DISPATCH_YEAR" != "$(date +%Y)" ]; then echo "dispatch: scheduled for $DISPATCH_YEAR, it is $(date +%Y); not running" >&2; exit 0; fi
exec 3>&1   # --dry-run prints here, past the log redirect
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
mkdir -p "$(dirname "$log")" "$cache"
# No `Bash(python3:*)` / `Bash(bash:*)`: an allow rule approves before the classifier looks, so an
# interpreter wildcard would wave any wrapped command past it (review of 2026-10-04).
tools=(Read Write Edit Glob Grep Agent "Bash(./bootstrap.sh --check)"
       "Bash(ls:*)" "Bash(grep:*)" "Bash(date:*)" "Bash(wc:*)" "Bash(git status:*)" "Bash(git diff:*)"
       "Bash(git log:*)" "Bash(git show:*)" "Bash(git add:*)" "Bash(git commit:*)")
# a bound run is account work (hooks/design_route.py): it publishes Artifacts and shares them in Chrome
[ "$account" = bound ] && tools+=(Artifact mcp__claude-in-chrome)
# bin/pr (and wharf's libexec/pr, the no-overlay path /finish names, and the core's `regatta pr`, its C1 way in) by its launch verbs only: `*bin/pr*` would also refuse /usr/bin/printf and `git log -- bin/pr`
# AskUserQuestion: nobody watches a run, and in auto mode the classifier would answer it (R2 of
# docs/session-asks-2026-10-09.md); the PreToolUse hook (hooks/ask_guard.py) is the guard, this the belt
# dispatch-queue's enqueue and claim: a run reaches the queue through dispatch, whose raise checks run
# first; enqueue repeats them (its raise_refusal), and this is the habit guard (queue-s1 review, item 1).
# S2's verbs beside them: dispatch --claim and --poll (the watcher's and the poll job's, never a session's),
# dispatch-queue poll and jobs (they load and boot out launchd jobs), unreserve (it frees a claim's slot)
# — S2a's landing review, item 6. S8's --kick and dispatch-queue kick (a kick reaches other hosts) join them, and
# dispatch-rc kick-listen (it writes the owner's listener service; it refuses an unattended caller too).
# Each is a habit guard, not a fence (S2a's finish review, item 11): a rule reads the words as typed, so
# `dispatch --event-at 1 --claim` (flag order) passes `*dispatch --claim*`, and `--sweep` claims too and stays
# allowed (S1's hand fallback); what holds is that each verb judges its caller, and a claim starts only what the
# queue holds
denied=("Bash(git push:*)" "Bash(gh:*)" "Bash(ssh:*)" "Bash(*bin/pr ready*)" "Bash(*bin/pr merge*)" "Bash(*libexec/pr ready*)" "Bash(*libexec/pr merge*)" "Bash(*regatta pr ready*)" "Bash(*regatta pr merge*)" "Bash(python3 scripts/deploy.py:*)" "Bash(*dispatch-queue enqueue*)" "Bash(*dispatch-queue claim*)" "Bash(*dispatch-queue sweep*)" "Bash(*dispatch --claim*)" "Bash(*dispatch --poll*)" "Bash(*dispatch-queue poll*)" "Bash(*dispatch-queue jobs*)" "Bash(*dispatch-queue unreserve*)" "Bash(*dispatch --requeue*)" "Bash(*dispatch-queue requeue*)" "Bash(*dispatch --kick*)" "Bash(*dispatch-queue kick*)" "Bash(*dispatch-rc kick-listen*)" AskUserQuestion)
# The fence (dispatch-queue S7's Linux half): a run never reads a confidential scope's work it was not started
# in. A host that carries one beside open repos (a scope's node opened to fleet work) denies the run's Read and
# Edit of every path the core's scope_paths() names for each such repo cloned here (its checkout, its worktrees,
# PROJECTS/transcripts/<repo>/, each login dir's projects/<slug>/: the transcripts and the auto-memory), and any
# Bash line naming one — a guard against an accident, as every command-text rule is (AGENTS.md); the scope's
# own hooks are the wall. Each cloned key is judged by the core's scope_of_repo against each confidential scope
# in turn (a glob, a key the registry's `repos` lacks; an umbrella scope listed first hides nothing), and a run
# inside a confidential scope keeps its own scope's. Nothing confidential cloned here: no rule, as before.
# One read of the registry: scope_paths is handed a registry of the fenced keys alone, written from that read,
# so a second read can neither tear nor widen it. A torn read (the fence trap: torn reads as no scopes, which
# is open) exits 3, and any other exit but 0 (a crash, a config the overlay left incomplete: the core will not
# import) draws the same wide deny in bash below, with no core: every folder in the projects folder bar the
# ones the run needs (its repo, this module's checkout, the core's, the overlay's), walking into a group folder
# on the way to one of those. The run goes ahead, as the torn read's own rule has it (ask for
# this run, the follow-ups' item 6): a fence that cannot be drawn narrows the run, it never stops one (the
# second landing review: an incomplete config stopped every dispatched run on every host).
# A Bash rule names a path from its parent folder's name (`*/projects/vault-kb/*`, then the path at the end
# of the line and before a space): the bare key had no boundary, and `*/220labs*` denied a run in 220labs.dev
# its own checkout (the landing reviews); the parent's name keeps a top-level key from matching a nested
# repo or a folder of the run's own (`docs`, `bin`).
# One python -c, its text free of apostrophes (bash 3.2 and a quote inside "$(…)", AGENTS.md)
rhome="${REGATTA_CONFIG:-$HOME/.config/regatta}/home"   # the config dir's `home`; its overlay marker beside it
fence_keep=()
for fkp in "$repo" "$mainco" "${core%/modules/regatta/hooks}" "$overlay" "$(head -1 "$rhome" 2>/dev/null)" \
           "$(head -1 "${rhome%/home}/regatta/overlay" 2>/dev/null)"; do
  case "$fkp" in "~"*) fkp="$HOME${fkp#\~}";; esac
  [ -n "$fkp" ] && fkp=$(cd "$fkp" 2>/dev/null && pwd -P) && fence_keep+=("$fkp")
done
fence=$(python3 -c '
import json, os, sys, tempfile
from pathlib import Path
sys.path.insert(0, sys.argv[1])
import common
reg, torn = common.read_registry()
if torn:
    sys.exit(3)
P = common.PROJECTS
mine = Path(sys.argv[2]).resolve()
keep = [Path(k) for k in sys.argv[3:] if k]
def needed(p):   # a path the run needs, inside one, or a folder holding one
    r = Path(os.path.realpath(p))
    return any(r == k or k in r.parents or r in k.parents for k in keep)
repos = (reg or {}).get("repos") or {}
conf = common.confidential_scopes(reg=reg)
def held(key, n, sc):
    return common.scope_of_repo(key, reg={"scopes": {n: sc}, "repos": repos})[0] == n
def walk(d, depth):   # each git checkout under d, never into one, three folders down at most
    try:
        kids = sorted((e for e in os.scandir(d) if e.is_dir() and not e.name.startswith(".")), key=lambda e: e.name)
    except OSError:
        return
    for e in kids:
        if os.path.exists(os.path.join(e.path, ".git")):
            yield Path(e.path)
        elif depth < 3:
            yield from walk(e.path, depth + 1)
cloned = {str(p.relative_to(P)) for p in walk(P, 1)} if conf and P.is_dir() else set()
for sc in conf.values():
    cloned |= {k for k in common.scope_members(sc, repos) if (P / k).is_dir()}
mykey = common.repo_key(str(mine))
seen, out = set(), []
for n, sc in conf.items():
    if mykey and held(mykey, n, sc):
        continue
    ks = sorted(k for k in cloned if held(k, n, sc) and not needed(P / k))
    if not ks:
        continue
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        json.dump({"repos": {k: {} for k in ks}, "scopes": {n: {"repos": ks}}}, f)
    try:
        paths = common.scope_paths(n, path=f.name)
    finally:
        os.unlink(f.name)
    for p in paths:
        if str(p) in seen or needed(p) or any(str(p).startswith(x + "/") for x in seen):
            continue
        seen.add(str(p))
        try:
            word = "%s/%s" % (P.name, p.relative_to(P))
        except ValueError:
            word = "/".join(p.parts[-2:])
        out.append("%s\t%s" % (p, word))
print("\n".join(out))
' "$core" "$repo" ${fence_keep[@]+"${fence_keep[@]}"} 2>/dev/null); frc=$?
# the wide deny: $1's folders, bar the ones the run needs; into a folder that holds one
fence_wide() {
  local c r k on
  for c in "$1"/*/; do
    c="${c%/}"; [ -d "$c" ] || continue
    r=$(cd "$c" 2>/dev/null && pwd -P) || continue
    on=0
    for k in ${fence_keep[@]+"${fence_keep[@]}"}; do
      case "$r/" in "$k/"*) on=2; break;; esac
      case "$k/" in "$r/"*) on=1;; esac
    done
    case $on in 0) printf '%s\t%s\n' "$c" "${projects##*/}/${c#"$projects"/}";; 1) fence_wide "$c";; esac
  done
}
if [ "$frc" != 0 ]; then
  if [ "$frc" = 3 ]; then fwhy="the registry does not read"; else fwhy="the fence's registry check exited $frc (a crash, or a config the core will not load)"; fi
  echo "== $fwhy: every other checkout in the projects folder is denied to this run (the fence)"
  fence=$([ -d "$projects" ] && fence_wide "$projects")
fi
while IFS=$'\t' read -r fp fk; do
  [ -n "$fp" ] && denied+=("Read(/$fp/**)" "Edit(/$fp/**)" "Bash(*/$fk/*)" "Bash(*/$fk)" "Bash(*/$fk *)")
done <<<"$fence"
# --start's changes to both lists (bash 3.2: an empty array under set -u needs the ${a[@]+…} form)
for t in ${extra_allow[@]+"${extra_allow[@]}"}; do
  case " ${tools[*]} " in *" $t "*) ;; *) tools+=("$t");; esac
done
for t in ${undeny[@]+"${undeny[@]}"}; do
  kept=(); hit=0
  for d in "${denied[@]}"; do if [ "$d" = "$t" ]; then hit=1; else kept+=("$d"); fi; done
  [ "$hit" = 1 ] || { echo "dispatch: --undeny $t: not on the denied list (${denied[*]})" >&2; exit 2; }
  denied=(${kept[@]+"${kept[@]}"})
done
# The claude command, as words: through claude-host once this Mac's sitting is done (bin/rc-hosts
# --launcher; docs/tcc-one-identity-2026-10-18.md). A run that outlives its job — autofinish-run's
# detached /finish, a screen whose watcher died — would otherwise be charged to its own versioned
# path, and claude-host makes itself responsible wherever it starts. The pid a run records is
# still claude's own: pid_of_claude below.
if [ -n "${DISPATCH_CLAUDE:-}" ]; then CL=("$DISPATCH_CLAUDE")
elif hl=$("$RCH" --launcher claude 2>/dev/null); then CL=("$hl" claude)
else CL=(claude); fi
C="${CL[*]}"   # for the log lines
# pid_of_claude PID FILE: through claude-host, the pid claude-host wrote to FILE (its
# CLAUDE_HOST_PIDFILE) once it spawned claude, within 10 s; else PID. dispatch-rc reads
# ~/.claude/sessions/<pid>.json, which only claude's own pid has; a child list read with pgrep
# could catch the runner's short-lived `$(env | sed …)` subshell instead (review, 2026-10-18).
# hpf_env FILE: the env word that asks claude-host for it, nothing when claude runs bare.
# It only prints: a --dry-run prints the runner too and must remove nothing (run_rc and
# run_headless clear a stale file first).
hpf_env() { [ "${#CL[@]}" -gt 1 ] && printf '%s\n' "CLAUDE_HOST_PIDFILE=$1"; }
pid_of_claude() {
  local p=$1 f=$2 k=""
  [ "${#CL[@]}" -gt 1 ] || { echo "$p"; return; }
  for _ in $(seq 1 20); do [ -s "$f" ] && { read -r k < "$f"; break; }; sleep 0.5; done
  rm -f "$f"
  echo "${k:-$p}"
}
# -p ends with the reply and kills whatever still runs, so nothing may run in the background: the
# switch turns off run_in_background for Bash and background agents alike (read in claude 2.1.289's
# source, 2026-10-05). With it on, a call that times out is killed, not backgrounded, and the overlay's
# test_checkpoint.sh alone took 465 s: 30 min as the default also lifts the 600 s cap (the cap is
# max(600 s, BASH_MAX_TIMEOUT_MS or the default), same source).
# Both modes take the switch by default (header, --background) and the 30-minute Bash default, so
# the prompt's "one Bash call stops at 30 minutes" holds for both. `--background allow` lifts the
# switch (the owner, 2026-10-05: "configurable, so we can test side by side").
run_env() {   # headless|rc -> the session's variables in $renv; the choice goes to the log and $bgeff
  bgeff="${bg:-deny}"
  renv=(REGATTA_UNATTENDED=dispatch CLAUDE_UNATTENDED=dispatch BASH_DEFAULT_TIMEOUT_MS=1800000)   # the marker under both names (vendor-fence, stage 1)
  [ "$bgeff" = deny ] && renv+=(CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1)
  echo "== background $bgeff$([ -n "$bg" ] && echo " (--background)" || echo " (default for $1)")"
}
rname="$(basename "$repo")"
runs="$HOME/Library/Logs/claude-weekly/run-seed-runs"; mkdir -p "$runs"
# what the session inherits from the run: the chain guards (header, "Limits")
chain=(DISPATCH_DEPTH="$depth" DISPATCH_REPO="$repo")   # the repo: bin/helm report records it for the guard (K6)
# a seeded run's skipper (R1), from the plist; a --start run (autofinish) has none
skipper_chain() {
  local v
  [ "$start" = 0 ] || return 0
  # a plan with no skipper (wharf's tick from launchd seeds a ship's block): the session still
  # reports to its plan, so its block ends; nothing to relay to
  # the plist's values, read under either name (skipper_env), passed on under both until S8
  local skipper skacct skplan skspace skhost
  skipper="${DISPATCH_SKIPPER:-${DISPATCH_MANAGER:-}}"; skplan="${DISPATCH_SHIP:-${DISPATCH_PLAN:-}}"
  if [ -z "$skipper" ]; then
    [ -n "$skplan" ] && chain+=(DISPATCH_SHIP="$skplan" DISPATCH_PLAN="$skplan" DISPATCH_TASK="$topic")
    return 0
  fi
  skacct="${DISPATCH_SKIPPER_ACCOUNT:-${DISPATCH_MANAGER_ACCOUNT:-}}"; skspace="${DISPATCH_PLAN_SPACE:-}"
  skhost="${DISPATCH_SKIPPER_HOST:-${DISPATCH_MANAGER_HOST:-}}"
  for v in $SKIPPER_ENV; do
    local val="${v%%:*}"; val="${!val}"
    [ -n "$val" ] && chain+=("${v#*:}=$val")
  done
  # the run's login in the skipper's vocabulary (acct_dir: pick_account has exported or unset
  # CLAUDE_CONFIG_DIR by now)
  chain+=(DISPATCH_TASK="$topic" ASK_ACCOUNT="$(acct_dir)")
}
max_s=$(awk -v h="${DISPATCH_MAX_H:-8}" 'BEGIN { printf "%d", h * 3600 }')

# "How many runs are live, is this one's screen up -> its record written" in one piece: two runs
# that fire in the same minute both passed the check before either recorded itself (review of
# 2026-10-05). mkdir is atomic. The holder writes its pid inside; a lock whose holder is dead, or
# one with no pid older than 2 min (a crash between mkdir and the write), is taken over. A waiter
# waits 150 s, longer than that takeover age, so a lock is never given up on while it can still clear.
# Nothing under the lock reaps orphans (that waits up to 20 s per run): the count runs with
# reaping off, and the reaping after drop_lock.
take_lock() {
  local i h
  for i in $(seq 1 300); do
    if mkdir "$lockd" 2>/dev/null; then echo $$ > "$lockd/pid"; held=1; return 0; fi
    h=$(cat "$lockd/pid" 2>/dev/null)
    if { [ -n "$h" ] && ! kill -0 "$h" 2>/dev/null; } || { [ -z "$h" ] && [ -n "$(find "$lockd" -maxdepth 0 -mmin +2 2>/dev/null)" ]; }; then
      [ "$(cat "$lockd/pid" 2>/dev/null)" = "$h" ] && { rm -f "$lockd/pid"; rmdir "$lockd" 2>/dev/null; }
    fi
    sleep 0.5
  done
  echo "FAILED: $lockd is held for 150 s (another run starting?); not running"; return 1
}
# only our own: a lock taken over meanwhile belongs to that run
drop_lock() {
  [ -n "$held" ] && [ "$(cat "$lockd/pid" 2>/dev/null)" = "$$" ] && { rm -f "$lockd/pid"; rmdir "$lockd" 2>/dev/null; }
  held=""
}
# bin/pickup's running() compares exactly this: `ps -o lstart` in UTC
pstart() { TZ=UTC LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | xargs; }
# one record per run, for --status and for dispatch-rc (which ends it and fills in the end);
# the id is ours to give (--session-id), so the record and the transcript are found by it
# The session id is in the name: a run that starts in the second its predecessor ended (--next's
# usual case) wrote its record over the predecessor's (a test run of 2026-10-05, 1 in ~10).
# --start's caller chose the id (its lock is written with it before the start)
new_state() {
  sid=${lsid:-$(uuidgen | tr 'A-Z' 'a-z')}
  [ -n "$lresume" ] && [ "$lfork" = 0 ] && sid="$lresume"   # a plain --resume keeps its id
  state="$runs/$(date +%Y%m%d-%H%M%S)-$rname.$topic.${sid:0:8}.json"
  sess_args
}
# claude's words for the session, into $sargs: a fresh one under our id; --resume, the id kept; or a
# fork, the one form in which claude takes a caller's id beside --resume (header, --start)
sess_args() {
  if [ -z "$lresume" ]; then sargs=(--session-id "$sid")
  elif [ "$lfork" = 1 ]; then sargs=(--session-id "$sid" --resume "$lresume" --fork-session)
  else sargs=(--resume "$lresume"); fi
}
# The record's chain fields, into $crec: the run's depth, model, effort, yolo, note and bound pin, the
# brief it started from (path relative to the repo, as on every host, and blob; a --start run has
# none) and its skipper's id, plan, page, host and login — what a retry needs to start the same step
# again under the same skipper (orchestration B2, chain-manager E2).
chain_record() {
  local a
  crec=(depth="$depth" model="$model" effort="$effort" yolo="$yolo")
  if [ "$mode_torn" = 1 ]; then   # resolve_mode: a torn read marks a sent task with no mode
    [ "$start" = 0 ] && crec+=(mode_unread=1)
  else
    [ -n "$mode" ] && [ "$start" = 0 ] && crec+=(task_mode="$mode")
  fi
  [ -n "${brief:-}" ] && crec+=(brief="${brief#"$wt"/}")
  [ -n "${note:-}" ] && crec+=(note="$note")
  crec+=(prio="$prio")   # the run's rank in the queue (dispatch --priority); S4's --next inherits it
  [ -n "$fromq" ] && crec+=(queue="$fromq")
  [ -n "$landq" ] && crec+=(queue="$landq")   # S9: the landing's claim is spent by this record
  [ -n "${origin_scope:-}" ] && crec+=(origin="$origin_scope")
  [ -n "${origin_marker:-}" ] && crec+=(origin_mark="$origin_marker")   # a name given records its marker too
  for a in ${chain[@]+"${chain[@]}"}; do
    case "$a" in
      # the run record keeps its keys (manager, plan…: read by stalls, the board, a re-dispatch);
      # the chain holds each value under both names, so only the new one is read here
      DISPATCH_SKIPPER=*) crec+=(manager="${a#*=}");; DISPATCH_SHIP=*) crec+=(plan="${a#*=}");;
      DISPATCH_PLAN_SPACE=*) crec+=(plan_space="${a#*=}");; DISPATCH_SKIPPER_HOST=*) crec+=(manager_host="${a#*=}");;
      DISPATCH_SKIPPER_ACCOUNT=*) crec+=(manager_account="${a#*=}");; DISPATCH_BRIEF=*) crec+=(brief_blob="${a#*=}");;
      DISPATCH_PIN=*) crec+=(pin="${a#*=}");;
    esac
  done
}
# key=value words into the record; the numbers as numbers (they were all strings until 2026-10-11 —
# dispatch-rc's typed() still reads those). INTS is dispatch-rc's list: change both together.
record() { python3 -c '
import json, sys
INTS = ("pid", "started", "ended", "window", "watcher", "screen_pid", "idle", "depth", "probe", "yolo")
st = dict(a.split("=", 1) for a in sys.argv[2:])
st.update((k, int(v)) for k, v in list(st.items()) if k in INTS and v.isdecimal())
json.dump(st, open(sys.argv[1], "w"), indent=1)' "$state" "$@"; }

run_headless() {   # $prompt in $wt — with the start lock held; drops it once the run is recorded
  new_state; run_env headless
  # the plist's variables must not reach the session: its own dispatch calls would delete this job.
  # CLAUDE_UNATTENDED reaches its hooks: checkpoint.py keeps the run read-only on live systems.
  local hpf="$state.claude-pid" hw; rm -f "$hpf"; hw=($(hpf_env "$hpf"))
  (cd "$wt" && exec env -u DISPATCH_LABEL -u DISPATCH_LOG -u DISPATCH_YEAR -u DISPATCH_LOADED_AT -u DISPATCH_EVENT_AT -u DISPATCH_ORIGIN -u DISPATCH_PIN -u DISPATCH_HOST_PIN -u CLAUDE_CODE_DISABLE_BACKGROUND_TASKS "${SKIPPER_UNSET[@]}" -u DISPATCH_REPO "${renv[@]}" "${chain[@]}" ${hw[@]+"${hw[@]}"} "${CL[@]}" -p "$prompt" "${sargs[@]}" --model "$model" --effort "$effort" --permission-mode auto --allowedTools "${tools[@]}" --disallowedTools "${denied[@]}" --output-format text) &
  kpid=$!; cpid=$(pid_of_claude "$kpid" "$hpf"); chain_record
  record mode=headless background="$bgeff" branch="$branch" repo="$repo" topic="$topic" session="$sid" ${lresume:+resumed_from="$lresume"} pid="$cpid" proc_start="$(pstart "$cpid")" started="$(date +%s)" log="$log" wt="$wt" \
    watcher="$$" watcher_start="$(pstart $$)" "${crec[@]}"
  drop_lock
  queue_started
  # the maximum lifetime: a -p session has no idle to wait for, only an end
  # (its sleep dies with it, and neither leaves a "Terminated" line in the log)
  ( trap 'kill $! 2>/dev/null; exit 0' TERM; sleep "$max_s" & wait $!
    kill -0 "$cpid" 2>/dev/null && { echo "$(date +%T) ending claude $cpid: still running after ${DISPATCH_MAX_H:-8} h (DISPATCH_MAX_H)"; kill -TERM "$cpid"; } ) 2>/dev/null & dog=$!
  # no caffeinate off macOS (a node that never sleeps): the wait alone
  command -v caffeinate >/dev/null && { caffeinate -i -w "$kpid" & }; wait "$kpid"; rc=$?
  # its sleep first: a TERM that reaches the watchdog after its trap is set but before its `wait`
  # starts runs the trap only once that wait returns — bash 3.2 — so the watchdog, and this run,
  # sat 8 h (two test runs of 2026-10-06, each a stub claude that exits at once)
  pkill -TERM -P "$dog" sleep 2>/dev/null; kill "$dog" 2>/dev/null; wait "$dog" 2>/dev/null
  # an end already recorded (dispatch --end) stays
  python3 -c 'import json, sys, time; p = sys.argv[1]; s = json.load(open(p)); s.get("ended") or s.update(ended=int(time.time()), end_reason="exit " + sys.argv[2]); json.dump(s, open(p, "w"), indent=1)' "$state" "$rc"
  # session-asks R2: an ask handed past a live skipper is stored on the record, as dispatch-rc's
  # finish() does for a visible run — a headless one never reaches finish()
  python3 "$here/bin/dispatch-rc" ask-guard "$state" || true
  echo "== exit $rc at $(date)"
}

machine() {   # $host, and $shown: the name as the config keys spell it (regatta/laptop, the dispatch host, the ssh peers)
  local n
  host="${DISPATCH_HOST:-$(local_host)}"; shown="$host"
  for n in "$laptop" "$dispatch_host" ${peers}; do
    n="${n%%:*}"; [ -n "$n" ] && [ "$(lc "$n")" = "$(lc "$host")" ] && { shown="$n"; return 0; }
  done
}
# The runner: written out because screen takes one command line. It strips every CLAUDE* variable
# a calling session would hand down (a child marker turns transcript saving off — probed
# 2026-10-04) and the plist's, then becomes claude itself, so the pid it records is claude's.
# CLAUDE_CONFIG_DIR and CLAUDE_CODE_OAUTH_TOKEN stay: they say which account runs it (bin/account).
# The prompt goes first: --allowedTools/--disallowedTools take every word after them.
runner_text() {   # PROMPT DIR REMOTE-CONTROL-NAME PIDFILE — with $sid set; claude-host writes claude's pid to PIDFILE.claude
  echo '#!/bin/bash'
  printf 'echo $$ $PPID > %q\n' "$4"   # claude (exec'd below) and its SCREEN master
  echo 'for v in $(env | sed -n "s/^\(CLAUDE[A-Z_]*\)=.*/\1/p"); do case $v in CLAUDE_CONFIG_DIR|CLAUDE_CODE_OAUTH_TOKEN) ;; *) unset "$v";; esac; done'
  echo 'unset DISPATCH_LABEL DISPATCH_LOG DISPATCH_YEAR DISPATCH_LOADED_AT DISPATCH_EVENT_AT DISPATCH_ORIGIN DISPATCH_PIN DISPATCH_HOST_PIN DISPATCH_SKIPPER DISPATCH_MANAGER DISPATCH_SKIPPER_ACCOUNT DISPATCH_MANAGER_ACCOUNT DISPATCH_SHIP DISPATCH_PLAN DISPATCH_PLAN_SPACE DISPATCH_TASK ASK_ACCOUNT DISPATCH_SKIPPER_HOST DISPATCH_MANAGER_HOST DISPATCH_REPO DISPATCH_MODE'
  printf 'cd %q || exit 1\n' "$2"
  printf 'exec env'
  local hw; hw=($(hpf_env "$4.claude"))
  printf ' %q' "${renv[@]}" "${chain[@]}" ${hw[@]+"${hw[@]}"} "${CL[@]}" "$1" "${sargs[@]}" --remote-control "$3" --model "$model" --effort "$effort" \
    --permission-mode auto -n "run-${3%% · *}" --allowedTools "${tools[@]}" --disallowedTools "${denied[@]}"
  echo
}

run_rc() {   # PROMPT DIR SCREEN [probe] — with the start lock held; drops it once the run is recorded
  local scr="$3" name title
  S="${DISPATCH_SCREEN:-/usr/bin/screen}"; export SCREENDIR="$cache/screen"
  mkdir -p "$SCREENDIR"; chmod 700 "$SCREENDIR"   # screen refuses a socket directory others can read
  # a socket left by a crash or reboot lists as "(Dead ???)" in this persistent SCREENDIR and read as
  # a live run: wipe it, and never count a dead one
  "$S" -wipe >/dev/null 2>&1
  # screen -ls exits non-zero even when it lists sessions (4.00.03), which pipefail would pass on
  if { "$S" -ls 2>/dev/null || :; } | grep -v 'Dead' | grep -qE "^[[:space:]]*[0-9]+\.$scr[[:space:]]"; then
    drop_lock; echo "FAILED: a run of $topic in $rname is still going (SCREENDIR=$SCREENDIR screen -x $scr); not starting a second"; return 1
  fi
  machine
  new_state; run_env rc
  # Screen, runner, pid file, .command and title name the repo too: two repos may run one topic.
  # The pid file is per run: two runs of a topic must never read each other's.
  name="${scr#run-$rname-}"; [ "$start" = 1 ] && name="$lname"
  title="run · $name · $rname"
  runner="$cache/$scr.sh"; pidf="$cache/$scr.$sid.pid"
  rm -f "$pidf.claude"   # claude-host's answer of an earlier run must not be read as this one's
  runner_text "$1" "$2" "$name · $shown" "$pidf" > "$runner"
  TERM=xterm-256color LANG="${LANG:-en_US.UTF-8}" "$S" -U -dmS "$scr" /bin/bash "$runner" || { drop_lock; echo "FAILED: screen did not start"; return 1; }
  for _ in $(seq 1 20); do [ -s "$pidf" ] && break; sleep 0.5; done
  [ -s "$pidf" ] || { drop_lock; "$S" -S "$scr" -X quit >/dev/null 2>&1; echo "FAILED: the run's screen started no claude ($runner); its screen quit"; return 1; }
  read -r cpid spid < "$pidf"
  cpid=$(pid_of_claude "$cpid" "$pidf.claude")   # the runner exec'd claude-host, whose child is claude
  # A run with a caller of its own (--start: bin/autofinish-run's /finish) ends as soon as it is
  # idle, as every run did before 2026-10-06: nobody picks a launch up again, so a warm cache buys
  # nothing, and autofinish-run waits for this watcher to return — an hour of that would hold a
  # detached waiter and one of DISPATCH_MAX_RUNS slots per launch, and the 10-minute sweep would
  # start refusing. A seeded branch run keeps the hour (dispatch-rc's IDLE).
  # A --yolo build ends idle too: its launch waits on this watcher, and nobody picks it up either; so
  # does a dnd step, whose owner is not there to pick it up (yolo-launch review D2, 2026-10-25: a dnd rc
  # run sat its whole warm hour before its launch). On the hand-over line it ends at once (dispatch-rc's
  # said_its_end reads the `handed` kind as an end).
  local idle_for=""; { [ "$start" = 1 ] || [ "$yolo" = 1 ] || [ "$mode" = dnd ]; } && idle_for=600
  chain_record
  record mode=rc background="$bgeff" branch="$branch" repo="$repo" topic="$topic" session="$sid" ${lresume:+resumed_from="$lresume"} pid="$cpid" proc_start="$(pstart "$cpid")" \
    started="$(date +%s)" log="$log" screen="$scr" screendir="$SCREENDIR" runner="$runner" rc_name="$name · $shown" \
    title="$title" wt="$2" screen_pid="$spid" ${4:+probe=1} ${idle_for:+idle="$idle_for"} "${crec[@]}" \
    ${CLAUDE_CONFIG_DIR:+config_dir="$CLAUDE_CONFIG_DIR"}   # the run's registry: dispatch-rc's registry_dirs
  drop_lock
  queue_started
  echo "== claude $cpid, session $sid, screen $scr, Remote Control \"$name · $shown\"; state $state"
  # the window: the laptop only (regatta/laptop; the build Mac has nobody at its screen); a failure
  # here never stops the run
  if [ "$(lc "$host")" = "$(lc "$laptop")" ] && [ -x "${DISPATCH_YABAI:-/opt/homebrew/bin/yabai}" ]; then
    python3 "$here/bin/dispatch-rc" window "$state"
  fi
  # stays until the session is done, keeping the Mac awake meanwhile; then ends it and logs the id
  # no caffeinate here since 2026-10-06: the watcher holds one only while the session is busy
  # (dispatch-rc's hold_awake), so the warm hour it now waits out does not keep the Mac awake
  python3 "$here/bin/dispatch-rc" watch "$state"; local rc=$?
  rm -f "$pidf"
  return $rc
}

# An interactive session in an untrusted repo waits at the trust dialog for a person — trust is
# per directory, ~/projects' does not reach ~/projects/x (probed 2026-10-04; a worktree takes its
# repo's). Until 2026-10-13 the run went headless then; now it trusts the repo first and stays
# visible (the owner, 2026-10-13: "always launch in a terminal, never headless" — and dispatch may accept
# the dialog: bin/trust-projects, which writes what the dialog would). Read back; still untrusted
# is FAILED, never -p. Trust is per config dir: the picked account's (E5), never only the default's.
untrusted() { [ "$headless" = 0 ] && ! python3 "$here/bin/dispatch-rc" trusted "$repo" --config-dir "${CLAUDE_CONFIG_DIR:-}"; }
ensure_trusted() {
  untrusted || return 0
  echo "== not trusted: $repo — trusting it (bin/trust-projects, ${CLAUDE_CONFIG_DIR:-the default login})"
  ${DISPATCH_TRUST:-python3 ${p_trust:-$here/bin/trust-projects}} 2>&1 | tail -3
  untrusted || return 0
  echo "FAILED: $repo is still not trusted after bin/trust-projects; not running (no headless fallback)"; return 1
}

# The account, at fire time (header, --account). Exports CLAUDE_CONFIG_DIR for the picked row (unset
# for the default dir, whose env must stay empty — bin/account's header); prints "== account …" to
# the log, or FAILED and returns 1. A seeded run defaults to auto; --start and --probe keep the
# caller's login unless --account was given.
pick_account() {
  local want="$account" out rc line err
  [ -n "$want" ] || { [ "$start$probe" = 00 ] && want=auto; } || return 0
  [ -n "$want" ] || return 0
  local cached=(); [ "$dry" = 1 ] && cached=(--cached)
  # stdout alone is parsed: a warning on stderr ahead of the JSON failed json.loads at char 0, and
  # auto and bound fell to the caller's login past the walk (tenants review, regatta#82, 2026-10-22).
  # stderr goes to a file and is quoted in the failure text, as pickup and autofinish-run do.
  err=$(mktemp)
  if [ "$want" = auto ]; then
    out=$("$ACCT" pick --repo "$repo" --json ${cached[@]+"${cached[@]}"} 2>"$err"); rc=$?
  elif [ "$want" = bound ]; then
    out=$("$ACCT" pick --bound --repo "$repo" --json ${cached[@]+"${cached[@]}"} 2>"$err"); rc=$?
  else
    out=$("$ACCT" limits "$want" --repo "$repo" --json ${cached[@]+"${cached[@]}"} 2>"$err"); rc=$?
  fi
  line=$(printf '%s' "$out" | python3 -c '
import json, os, re, sys
want, rc, force = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "1"
try:
    err = " ".join(open(sys.argv[4], errors="replace").read().split())
except OSError:
    err = ""
out = sys.stdin.read()
try:
    d = json.loads(out)
except ValueError:
    d = None
text = "; ".join(x for x in (err, out.strip()) if x)   # what a failure quotes: stderr first, then stdout
# a refusal a reset lifts (judge() in account: the week, the 5-hour window, a cooldown, a Codex lock): SHORT,
# the queue keeps it. Any other (extra usage on, same login as, limits unknown, parked, a reason added later)
# would refuse the same way after every requeue, so it fails plainly (the S3 third landing review, item 2)
def resets(why):
    return bool(re.match(r"(week \d|5h \d|cooling down until|locked by)", why or ""))
if want in ("auto", "bound"):
    if rc == 4:
        print("-\x1f\x1fno account registry here — the login this run was started with"); sys.exit()
    if rc == 3 and isinstance(d, dict):
        # SHORT when a reset could free a row; every row refused for good: FAILED, never queued again
        tag = "SHORT" if any(resets(w) for _, w in d.get("skipped") or []) else "FAILED"
        print(tag + "\x1f\x1fno account may run this now — " + "; ".join("%s: %s" % (l, w) for l, w in d.get("skipped") or [])); sys.exit()
    if rc != 0 or not isinstance(d, dict) or not d.get("account"):
        print("-\x1f\x1faccount pick failed (%s) — the login this run was started with" % text.strip()[:120]); sys.exit()
    print("%s\x1f%s\x1f%s" % (d["account"], (d.get("env") or {}).get("CLAUDE_CONFIG_DIR", ""), d.get("reason") or "")); sys.exit()
rows = d if isinstance(d, list) else []
if rc != 0 or not rows:
    print("FAILED\x1f\x1f--account %s: %s" % (want, text.strip()[:200] or "no such enabled account")); sys.exit()
a = rows[0]
if a.get("provider") != "claude":
    print("FAILED\x1f\x1f--account %s is a %s account; dispatch runs claude only" % (want, a.get("provider"))); sys.exit()
if not a.get("here"):
    print("FAILED\x1f\x1f--account %s is not set up on this machine (account setup)" % want); sys.exit()
if a.get("denied"):  # the guard would block every prompt there: --force never crosses a deny list
    print("FAILED\x1f\x1f--account %s: %s — run it on the default login (no --account)" % (want, a.get("why"))); sys.exit()
if not a.get("eligible") and force and a.get("overage") and (os.environ.get("REGATTA_UNATTENDED") or os.environ.get("CLAUDE_UNATTENDED")):
    # --force past paid overage is a yes to money: an unattended caller never gives it (costs S8; no apostrophe in this block)
    print("FAILED\x1f\x1f--account %s: %s — --force past paid overage is a yes only a person gives, refused to an unattended caller" % (want, a.get("why"))); sys.exit()
if not a.get("eligible") and not force:   # SHORT only for its limits, which a reset lifts: a refusal the queue keeps
    print("%s\x1f\x1f--account %s: %s — --force runs it there anyway" % ("SHORT" if resets(a.get("why")) else "FAILED", want, a.get("why"))); sys.exit()
print("%s\x1f%s\x1f%s" % (want, (a.get("env") or {}).get("CLAUDE_CONFIG_DIR", ""), "as asked" + ("" if a.get("eligible") else ", forced past: " + str(a.get("why")))))
' "$want" "$rc" "$force" "$err"); rm -f "$err"
  local label dir why
  IFS=$'\x1f' read -r label dir why <<<"$line"   # not a tab: a whitespace IFS collapses an empty dir
  if [ "$label" = FAILED ] || [ "$label" = SHORT ]; then
    # a refusal the queue keeps (SHORT): exit 3 of the pick with a row a reset frees, or a named login past its
    # limits now (the first review's open item 4 — failed, its entry was removed though the login has room
    # after its reset). Its FAILED line is the caller's, said only when no queue took it (queue_refused)
    [ "$label" = SHORT ] && { acct_short="$why"; return 1; }
    echo "FAILED: $why; not running"
    return 1
  fi
  if [ "$label" = - ]; then echo "== account: $why"; return 0; fi   # no registry, or no answer: as before E5
  if [ -n "$dir" ]; then export CLAUDE_CONFIG_DIR="$dir"; else unset CLAUDE_CONFIG_DIR; fi
  acct_label="$label"
  [ "$want" = bound ] && chain+=(DISPATCH_PIN=bound)   # its --next stays bound (header, --account)
  echo "== account $label${dir:+ ($dir)}: $why"
}
acct_label=""; acct_short=""

# --if-room (header): why this run may not spend the week now, or nothing. autofinish's week_tight is
# the one reader the sweep and yolo_launch use; fresh, except a dry run's (cached, as pick_account's).
# A read that raises is a reason, as in yolo_launch; no reading is room (week_tight's None, header).
# Refusing on no reading would refuse every run at the reset, whose last sample is last week's.
no_room() {
  python3 - "$here" "$repo" "$dry" <<'PY' 2>/dev/null || echo "the week's budget is unreadable"
import os, sys
from importlib.machinery import SourceFileLoader
here, repo, dry = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
try:
    kind, detail = SourceFileLoader("autofinish", os.path.join(here, "bin", "autofinish")).load_module().week_tight(repo, fresh=not dry)
except Exception as e:  # noqa: BLE001
    print("the week's budget is unreadable (%s)" % type(e).__name__); sys.exit()
if kind == "none":
    print("no account may run it (%s)" % detail)
elif kind == "tight":
    print("the week is tight (%s)" % detail)
PY
}

# --yolo's launch (header): after the build run, in the run's own log. Every refusal is a logged
# line and no launch, never a failure of the run — the branch is pushed and its PR waits either way.
# Each gate fails closed (review of 2026-10-08): what it cannot read is a reason not to launch.
#   - the run ended on its own: exit 0 headless; interactively, idle after its last turn (dispatch-rc
#     watch returns 0 for every end — `dispatch --end`, a crash, the lifetime cap — so its record's
#     end_reason decides, not the exit)
#   - its last reply, read from the transcript, carries no ⚠ and no WAITING line; a WAITING FOR SOMETHING
#     line only when it is the hand-over (the core's `handed` kind: $handover, or a free form naming
#     dispatch's launch first)
#   - no next step is scheduled on this branch (dispatch --next): the launch would curate under it
#   - autofinish is armed on this Mac and the week is not tight: the sweep's two switches, which a
#     launch started from here would otherwise skip (the build Mac stays disarmed)
#   - the worktree is clean, and memo finds no D-item the owner has not settled (yolo_settled: the
#     owner's box, a yolo pick, or a dated reply of the owner's — never a session's own `>` reply) in any Markdown file
#     the branch adds, changes or renames against origin/<main>; a file memo cannot parse counts as open.
#   - (skipper-modes S3b) a dnd run launches too, `--by dnd`: the build digest's "dnd never launches" is
#     reversed by the owner's "dnd: I want to automerge as well". The mode is read again here, from plan.json
#     (mode_now), not the one the run started with: a ship lowered mid-flight launches nothing, and the
#     launch carries the mode read now. Whether it merges is autofinish-run's: it reads plan.json itself
#     and holds the slice at a ready PR, never trusting this `--by`.
# Each outcome also goes into the run record as `launch` (yolo-launch review D1, 2026-10-25): helm's card
# on a hand-over whose launch never started says why, where it once read the line as "nothing woke it"
# and would retry the build, declined the same way each time.
AFRUN="${DISPATCH_AUTOFINISH_RUN:-$here/bin/autofinish-run}"   # the tests stand one in
mode_now() {   # the run's mode at this moment: read_mode, as resolve_mode read it at the start (a torn read is ask)
  local torn m
  # torn at the start: there was no hint (resolve_mode), and its `ask` is no hint either
  read -r torn m < <(read_mode "$([ "$mode_torn" = 1 ] || echo "$mode")")
  echo "$m"
}
note_launch() {   # WHAT — into the run record's `launch`; a record that will not read keeps the log line alone
  python3 -c 'import json, sys
try:
    s = json.load(open(sys.argv[1])); s["launch"] = sys.argv[2]; json.dump(s, open(sys.argv[1], "w"), indent=1)
except (OSError, ValueError):
    pass' "$state" "$1"
}
declined() { echo "== $m: no launch — $1"; note_launch "no launch — $1"; }   # yolo_launch's $m
yolo_launch() {   # RC — the build run's exit
  { [ "$yolo" = 1 ] || [ "$mode" = dnd ]; } || return 0
  local m="$mode"; [ "$yolo" = 1 ] && m=yolo
  if requeued_end; then declined "it was requeued (dispatch --requeue): the session that continues it lands it"; return 0; fi
  if [ "$1" != 0 ]; then declined "the build run ended with $1"; return 0; fi
  local why nxt now_m
  now_m=$(mode_now)
  case "$now_m" in
    dnd|yolo) m="$now_m";;
    *) declined "the mode is now ${now_m:-unreadable} (plan.json): the sweep judges it under that mode's rules"; return 0;;
  esac
  nxt=$(jobs | grep -v "/${DISPATCH_LABEL:-/}\.plist\$" | head -1)
  if [ -n "$nxt" ]; then declined "a next step is scheduled on this branch ($(basename "$nxt"))"; return 0; fi
  # …or queued (a --next goes through the queue): an entry of the branch other than this run's, or a
  # queue that does not read — the readers' rule counts that as an entry
  if queue_on; then
    python3 "$Q" has --repo "$repo" --branch "$branch" --state queued --state claimed --state waiting --except-session "${sid:-}" "${qctx[@]}" >/dev/null 2>&1
    case $? in 0) ;; *) declined "a next step is queued on this branch, or the queue does not read (dispatch --queue)"; return 0;; esac
  fi
  why=$(python3 - "$state" "$here" "$branch" "$repo" "$core" <<'PY'
import glob, json, os, sys
state, here, branch, repo, core = sys.argv[1:6]
sys.path.insert(0, core)
try:
    st = json.load(open(state))
except (OSError, ValueError):
    print("its run record is unreadable (%s)" % state); sys.exit()
reason = st.get("end_reason") or ""
# dispatch-rc's words (API_ERROR_END) for a run ended idle on a turn that ended on an API error: it
# stopped halfway, and "idle" would read as done
if "its last turn ended on an API error" in reason:
    print("it ended idle on an API error, half done: %s" % reason); sys.exit()
if st.get("mode") == "rc" and not reason.startswith("idle"):
    print("it ended by %s, not idle after its last turn" % (reason or "an unrecorded end")); sys.exit()
if os.path.exists(state + ".next"):
    print("a next step is scheduled on this branch (dispatch --next)"); sys.exit()
import common
dirs = [os.environ.get("CLAUDE_CONFIG_DIR") or "", os.path.join(os.path.expanduser("~"), ".claude")]
hits = [h for d in dirs if d for h in glob.glob(os.path.join(d, "projects", "*", st.get("session", "?") + ".jsonl"))]
text = ""
try:
    with open(hits[0]) as f:
        for line in f:
            if '"type":"assistant"' not in line:
                continue
            try:
                msg = json.loads(line).get("message", {})
            except ValueError:
                continue
            # Claude Code's own entry for an API error or "No response requested." is no reply of the run's
            if msg.get("model") == "<synthetic>":
                continue
            content = msg.get("content")
            if isinstance(content, list):
                said = " ".join(c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text")
                text = said.strip() or text
except (OSError, IndexError):
    pass
if not text:
    print("its last reply could not be read (session %s)" % st.get("session")); sys.exit()
kind = common.ending(text)[0]
if "\u26a0" in text or kind in ("waiting", "relayed"):
    print("its last reply stops for %s: %s" % (common.OWNER_NAME or "the owner", [l for l in text.splitlines() if l.strip()][-1][:120])); sys.exit()
if kind == "pending":   # the hand-over is its own kind, `handed`, and goes on
    print("its last reply waits on its own work: %s" % [l for l in text.splitlines() if l.strip()][-1][:120]); sys.exit()
if not common.autofinish_armed():
    print("autofinish is disarmed on this Mac (bin/autofinish arm)"); sys.exit()
try:
    from importlib.machinery import SourceFileLoader
    # the repo's row in the account pool, as the sweep reads it (cached: autofinish-run picks fresh)
    kind, detail = SourceFileLoader("autofinish", os.path.join(here, "bin", "autofinish")).load_module().week_tight(repo)
except Exception as e:  # noqa: BLE001
    print("the week's budget is unreadable (%s)" % e); sys.exit()
if kind == "none":
    print("no account may run it (%s)" % detail)
elif kind == "tight":
    print("the week is tight (%s)" % detail)
PY
) || why="its launch gate failed (exit $?)${why:+: $why}"   # a crash is a reason, never an empty pass (review D3)
  if [ -n "$why" ]; then declined "$why"; return 0; fi
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then declined "$wt has uncommitted changes"; return 0; fi
  local base open
  base=$(python3 -c 'import json, sys
try:
    print(json.load(open(sys.argv[1])).get("main") or "main")
except (OSError, ValueError):
    print("main")' "$wt/.claude/workflow.json")
  git -C "$wt" fetch -q origin "$base" 2>/dev/null
  git -C "$wt" rev-parse -q --verify "origin/$base" >/dev/null || { declined "origin/$base unreadable here"; return 0; }
  open=$(git -C "$wt" -c core.quotePath=false diff --name-only --no-renames --diff-filter=AM "origin/$base...HEAD" -- '*.md' | while IFS= read -r f; do
    python3 "${p_keel:-$here/bin/keel}" parse "$wt/$f" 2>/dev/null | python3 -c 'import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    print("%s (memo could not parse it)" % sys.argv[1]); sys.exit()
o = [i["id"] for i in d.get("items", []) if not i.get("settled")]
if o:
    print("%s %s" % (sys.argv[1], ",".join(o)))' "$f"
  done)
  if [ -n "$open" ]; then declined "open for $who: ${open//$'\n'/; }"; return 0; fi
  # The sweep's rule M takes a deployed branch only with a `taken` doc (bin/autofinish verdict(): rule
  # L's /finish would read its taken answers as open, and its held slice never applied); without one,
  # rule L launches it at once, `--by sweep`: live ahead of main is drift, and dnd's slice would hold a
  # physical repo's deploy at a ready PR (the follow-ups' landing review, item 1 — picked over saying dnd
  # trades L for the slice: the sweep already chose L, and one rule for both starts is one rule to read).
  # A taken doc is the sweep's own reading: autofinish's mode_asks over the asks lines the branch adds
  # (keel memo's `taken` verdict), never a second test of its own (the second landing review). An asks
  # line it cannot settle keeps rule M, the held one.
  local rule=M by="$m" live
  live=$(AUTOFINISH_MEMO="${p_keel:-${AUTOFINISH_MEMO:-}}" python3 - "$here" "$wt" "origin/$base" "$core" <<'PY' 2>/dev/null
import os, sys
sys.path.insert(0, sys.argv[4])
from importlib.machinery import SourceFileLoader
af = SourceFileLoader("autofinish", os.path.join(sys.argv[1], "bin", "autofinish")).load_module()
wt = sys.argv[2]
base = af.git(wt, "merge-base", sys.argv[3], "HEAD")
live = (af.deployed_on(wt, base, "HEAD")[0] or "") if base else ""
if live:
    status, _, _, added, unparsed = af.diff_facts(wt, base, "HEAD")
    # the run's own seed under docs/handoff/ is no ask here: this launch's /finish takes it (the sweep
    # never meets one, it skips a branch that still adds a seed)
    asks = [h for p in sorted(status) if not p.startswith(af.HANDOFF) for h in af.asks_in(p, added.get(p, []), status[p])]
    skip, taken = af.mode_asks(wt, asks, status, False) if asks else (None, [])
    if skip or taken or unparsed:
        live = ""   # rule M: a taken doc, or asks it cannot settle
print(live)
PY
)
  if [ -n "$live" ]; then
    rule=L by=sweep
    echo "== $m: deployed ($live) with no taken doc — rule L's start, as the sweep's: at once, --by sweep"
  fi
  echo "== $m: the build run ended clean — starting the launch: autofinish-run $wt --by $by"
  note_launch "started: autofinish-run --rule $rule --by $by"
  # autofinish-run returns once dispatch's verdict is in (exit 0 started or not confirmed, 5 refused): its child is double-forked and setsid, out of this job's
  # process group, which launchd ends with the job: probed 2026-10-08 on the build Mac, a setsid grandchild
  # outlived a job that booted itself out (as cleanup does), a plain `( … ) &` child did not
  # without the build's login (pick_account exported it): autofinish-run picks its own, fresh, as
  # the sweep's start_runner does — a build on a second login must not run on it past its ceiling (review, 2026-10-08)
  env -u DISPATCH_LABEL -u DISPATCH_LOG -u DISPATCH_YEAR -u DISPATCH_LOADED_AT -u DISPATCH_EVENT_AT -u DISPATCH_ORIGIN -u DISPATCH_PIN -u DISPATCH_HOST_PIN -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_OAUTH_TOKEN \
    "$AFRUN" "$wt" --rule "$rule" --by "$by" 2>&1
  arc=$?
  echo "== $m: autofinish-run exit $arc"
  # a refusal (same tip, a lock, no account) wrote no run state, so "started" would hide the hand-over from helm
  [ "$arc" = 0 ] || note_launch "no launch — autofinish-run exit $arc"
  [ "$arc" = 0 ] && launched=1   # queue_claim leaves this slot to the landing
}

# The fire path's quiet refusals: past the chain's depth, a physical repo, --if-room with no week room. Each
# a FAILED in the log and nothing more; run once, before a one-shot enters the queue (queue_fire): there a
# refusal it met only after the put filed a queue-failed card — sextant's weekly --if-room slot one every
# tight week (S3's second landing review, item 5). A dry run's refusal is said where it prints (fd 3) too.
fchecked=0
fire_refusals() {
  [ "$fchecked" = 0 ] || return 0
  fchecked=1
  [ "$depth" -le "$maxdepth" ] || { echo "FAILED: $(deep)"; exit 1; }
  physical_ok || { [ "$dry" = 1 ] && { echo -n "DRY RUN: refused — "; physical_ok; } >&3; echo "FAILED: not running"; exit 1; }
  if [ "$ifroom" = 1 ]; then
    room=$(no_room)
    if [ -n "$room" ]; then
      [ "$dry" = 1 ] && echo "DRY RUN: refused — --if-room: $room" >&3
      echo "FAILED: --if-room: $room; not starting"; exit 1
    fi
    echo "== --if-room: the week has room"
  fi
}

# S9: a step with --after starts on its predecessors' code: origin/<main> merged into its branch first — a
# merge, never a rebase (the branch is pushed; a rebase would rewrite what origin holds). A one-shot's
# predecessors are judged here (landed.py), and a claimed entry's that its brief adds; one not landed is FAILED
# (the queue, when a home is set, took a one-shot before this: queue_fire). A merge that conflicts is aborted and FAILED: the run would start on half its base.
after_merge() {
  local b v m judged=("${afters[@]}")
  # a claimed entry's own predecessors were proved by its claim, from the sightings the entry and the claimer
  # hold (a merge-commit landing proves only from those); a name the brief's After: line adds at fire time, which
  # the entry never carried, is judged here as a one-shot's every predecessor is (the review)
  [ -n "$fromq" ] && judged=(${brief_afters[@]+"${brief_afters[@]}"})
  for b in ${judged[@]+"${judged[@]}"}; do
    v=$(python3 "$here/bin/landed.py" judge "$repo" "$b" 2>&1) \
      || { echo "FAILED: --after $b has not landed (${v:-no answer}); not running"; return 1; }
  done
  m=$(python3 "$here/bin/landed.py" main "$repo" 2>/dev/null) || m=main
  [ -n "$m" ] || m=main
  git -C "$wt" fetch -q origin "+refs/heads/$m:refs/remotes/origin/$m" 2>&1 || { echo "FAILED: origin/$m did not fetch, and --after merges it first; not running"; return 1; }
  if git -C "$wt" merge-base --is-ancestor "origin/$m" HEAD; then
    echo "== --after: $branch holds origin/$m already"; return 0
  fi
  if ! git -C "$wt" merge --no-edit --no-ff -m "Merge origin/$m: the predecessors of this step landed there ($(IFS=,; echo "${afters[*]}"); dispatch --after)" "origin/$m" 2>&1; then
    git -C "$wt" merge --abort 2>/dev/null
    echo "FAILED: merging origin/$m into $branch conflicts (--after); not running — merge it by hand in $wt, then dispatch again"
    return 1
  fi
  echo "== --after: merged origin/$m into $branch (a merge, never a rebase)"
}

# S9: a --start is a landing when it runs /finish in a claude/* worktree — judged here from what it runs (the
# prompt and the worktree's branch), never from a flag or a variable a caller sets: the rank it buys is above
# every build (dispatch-queue LAND_RANK), and S4 stands — no caller raises a rank by its word.
is_landing() {
  # autofinish-run's finish_prompt, word for word: `/finish <branch> --unattended`, then only its own flags
  case "$branch" in claude/?*) ;; *) return 1;; esac
  [[ $lprompt =~ ^/finish\ ([^ ]+)\ --unattended(\ --(yolo|dnd|hold|merge|from=[A-Za-z0-9._-]+))*$ ]] \
    && [ "${BASH_REMATCH[1]}" = "$branch" ]
}
# S9: no room for a landing — its entry in this Mac's queue-local/_land (dispatch-queue land), this process
# waiting for a claim of it (land-wait: a read of a local file, no network). A slot freeing here claims it
# first: the watcher at a run's park, a run's end, the sweep. Its prompt, its allow and undeny lists and so its
# merge rights never leave this process, so a queued --merge keeps exactly the direct road's rights. The
# `queued as` line is what autofinish-run reports as its `queued` verdict (night landings' finding 1);
# its waiter goes on waiting on this process, as at a start. 0 with the claim taken and the start lock held.
land_queue() {   # WHY
  local out rc q="" r="?"
  out=$(python3 "$Q" land --repo "$repo" --branch "$branch" --topic "$topic" --pid $$ "${qctx[@]}" 2>&1); rc=$?
  if [ "$rc" = 0 ]; then
    eval "$(printf '%s\n' "$out" | tail -1 | python3 -c 'import json, shlex, sys
try:
    d = json.loads(sys.stdin.read())
except ValueError:
    d = {}
print("q=%s r=%s" % (shlex.quote(d.get("qid") or ""), shlex.quote(str(d.get("rank") or "?"))))')"
  fi
  [ -n "$q" ] || { echo "FAILED: $1; and the queue did not take the landing (dispatch-queue land exit $rc: $(printf '%s' "$out" | tail -1 | cut -c1-160)); not starting another"; return 1; }
  landq="$q"
  # the session named: the run log is per day and topic, not per repo, so autofinish-run believes this line only
  # for its own run's id, as it does a header (its log_verdict)
  echo "queued as $q (a landing), session ${lsid:-none}, rank $r: $1 — it starts at the first free slot on this Mac, ahead of every build but force (dispatch --queue)"
  while :; do
    python3 "$Q" land-wait "$q" --pid $$ "${qctx[@]}"; rc=$?
    case "$rc" in
      0) ;;
      3) echo "FAILED: the landing's queue entry $q is gone (dispatch --queue; queue.jsonl names why); not starting"; return 1;;
      6) echo "FAILED: the landing waited in the queue with no slot on this Mac; not starting (autofinish's sweep starts it again)"; return 1;;
      *) echo "FAILED: the landing's wait in the queue failed (dispatch-queue land-wait exit $rc); not starting"; return 1;;
    esac
    take_lock || return 1
    n=$(python3 "$here/bin/dispatch-rc" live --no-reap "$repo" "$topic") || n=0
    n=$((n + $(qreserved)))   # bar this landing's own claim (qreserved's landq)
    if [ "$n" -lt "$max_runs" ]; then echo "== the landing's claim: $q, a slot on this Mac"; return 0; fi
    drop_lock
    # a start that filled the slot between the claim and this lock: back to queued, and wait again
    python3 "$Q" refused "$q" --label "landing.$$" --why "the run cap ($n of $max_runs busy at its start)" "${qctx[@]}" > /dev/null 2>&1
  done
}

# --start --dry-run: what would run, printed and nothing written — not even the log's header
if [ "$start" = 1 ] && [ "$dry" = 1 ]; then
  sid="${lsid:-<session-id>}"; [ -n "$lresume" ] && [ "$lfork" = 0 ] && sid="$lresume"; sess_args; machine
  untrusted && echo "# not trusted: $repo — the run would trust it first (bin/trust-projects)"
  if [ "$headless" = 1 ]; then
    run_env headless >&2
    printf 'cd %q && exec env -u DISPATCH_LABEL -u DISPATCH_LOG -u DISPATCH_YEAR -u DISPATCH_LOADED_AT -u DISPATCH_EVENT_AT -u DISPATCH_ORIGIN -u DISPATCH_PIN -u DISPATCH_HOST_PIN -u CLAUDE_CODE_DISABLE_BACKGROUND_TASKS' "$ldir"
    printf ' %q' "${renv[@]}" "${chain[@]}" "${CL[@]}" -p "$lprompt" "${sargs[@]}" --model "$model" --effort "$effort" \
      --permission-mode auto --allowedTools "${tools[@]}" --disallowedTools "${denied[@]}" --output-format text
    echo
  else
    run_env rc >&2
    echo "# screen -U -dmS run-$rname-$topic /bin/bash $cache/run-$rname-$topic.sh, which holds:"
    runner_text "$lprompt" "$ldir" "$lname · $shown" "$cache/run-$rname-$topic.$sid.pid"
  fi
  exit 0
fi

{
  echo "== $(date) dispatch $branch ($model $effort) in $repo"
  # an installed tidier on an older plist (its interval) is brought up to this code: from here, a
  # job of its own, never from the tidier itself (dispatch-rc refresh_tidy)
  [ "$dry" = 1 ] || python3 "$here/bin/dispatch-rc" refresh-tidy
  [ "$dry" = 1 ] || queue_jobs   # the queue-sweep job, as the tidier: brought here by a run's start (S2)
  # a claimed entry's job (dispatch-queue start_job): its load-to-start seconds, the RunAtLoad latency
  if [ -n "$fromq" ]; then
    case "${DISPATCH_LOADED_AT:-}" in ''|*[!0-9]*) lat="";; *) lat=", $(( $(date +%s) - DISPATCH_LOADED_AT )) s from its job's load";; esac
    echo "== from the queue: $fromq ($prio)$lat"
    # still this job's claim? A RunAtLoad plist a kill or a power loss left behind fires again at the next
    # login, and the entry may have been requeued, replaced or claimed elsewhere since: then it is not
    # this job's to run, and not its to fail either (the review's item 3). Unreadable: not run; the
    # claimer's sweep returns the claim past its lease
    if [ "$dry" = 0 ]; then
      mine=$(python3 "$Q" mine "$fromq" --label "${DISPATCH_LABEL:-}" "${qctx[@]}" 2>&1); mrc=$?
      queue_unsure "$mrc" "$mine"
      if [ "$mrc" != 0 ]; then
        qdone=1; echo "== a stale queue job: $fromq is not this job's claim now (${mine:-exit $mrc}); not running"
        queue_unreserve; exit 0
      fi
    fi
  fi
  # --at WHEN stays a one-shot; at its fire time it enters the queue (S3), aged from WHEN: ranked against what
  # waits already, never ahead of it, and claimed here at once only when it is first in line with room
  if [ -z "$fromq" ] && [ -n "${DISPATCH_LABEL:-}" ] && [ "$start$probe$dry" = 000 ] && queue_on; then
    fire_refusals
    queue_fire && exit 0
  fi
  pick_account || { [ -z "$acct_short" ] || queue_refused "$acct_short" skip || echo "FAILED: $acct_short; not running"; exit 1; }
  if [ "$start" = 1 ]; then
    # the caller's run: its prompt, its worktree, its name; the start lock, the cap and the watcher as any run's
    wt="$ldir"; prompt="$lprompt"
    cd "$wt" || exit 1
    ensure_trusted || exit 1
    python3 "$here/bin/dispatch-rc" reap
    room=0; why=$(roomy) || room=1   # before the lock: the sample sleeps 2 s
    take_lock || exit 1
    n=$(python3 "$here/bin/dispatch-rc" live --no-reap "$repo" "$topic") || n=0
    n=$((n + $(qreserved)))   # the queue's claims hold their slots before their records exist
    if [ "$n" -ge "$max_runs" ] || [ "$room" = 1 ]; then
      drop_lock
      full="$n other runs are busy (dispatch --status; warm or waiting ones not counted)"; [ "$n" -ge "$max_runs" ] || full="$why"
      # S9 (night landings' finding 8): a landing waits in the queue for this Mac's first free slot, ahead of
      # every build, instead of being refused; any other --start is refused as before
      if is_landing && queue_on; then
        land_queue "$full" || exit 1   # returns with the slot claimed and the start lock held
      elif [ "$n" -ge "$max_runs" ]; then
        echo "FAILED: $full; not starting another (DISPATCH_MAX_RUNS)"; exit 1
      else
        echo "FAILED: $why; not starting another (wharf-runs/headroom)"; exit 1
      fi
    fi
    # its end frees a slot like any run's: a claim takes what waits (a slot a --start held had no end that
    # claimed, and an entry queued meanwhile waited for an unrelated run; the third review's items 11, 17)
    if [ "$headless" = 1 ]; then run_headless; queue_claim; exit 0; fi
    run_rc "$prompt" "$wt" "run-$rname-$topic"; rc=$?
    echo "== exit $rc at $(date)"
    queue_claim
    exit "$rc"
  fi
  if [ "$probe" = 1 ]; then
    [ "$dry" = 1 ] && { echo "DRY RUN: probe" >&3; exit 0; }
    probe_prompt="reply with the single word ok"
    ensure_trusted || exit 1
    if [ "$headless" = 1 ]; then
      run_env headless
      (cd "$repo" && exec env -u DISPATCH_LABEL -u DISPATCH_LOG -u DISPATCH_YEAR -u DISPATCH_LOADED_AT -u DISPATCH_EVENT_AT -u DISPATCH_ORIGIN -u DISPATCH_PIN -u DISPATCH_HOST_PIN -u CLAUDE_CODE_DISABLE_BACKGROUND_TASKS "${renv[@]}" "${CL[@]}" -p "$probe_prompt" --model "$model" --permission-mode auto --allowedTools "${tools[@]}" --disallowedTools "${denied[@]}" --output-format text)
      echo "== probe exit $? at $(date)"; exit 0
    fi
    # the visible path, as a run takes it: no worktree, its own screen; no run cap, no after()
    take_lock || exit 1
    run_rc "$probe_prompt" "$repo" "run-$rname-$topic-probe" probe; rc=$?
    echo "== probe exit $rc at $(date)"; exit 0
  fi
  [ "$probe" = 1 ] || fire_refusals
  # one branch, one host, for a run the queue did not start (a one-shot, an --on's --at on a peer): its
  # entry live on another host refuses it; enqueue alone enforced that, and a one-shot fired beside a
  # queued run elsewhere (the third review's item 22). A queue that does not read lets it go ahead, as
  # before the queue: refusing every one-shot whenever the home is away would stop an offline Mac
  if [ -z "$fromq" ] && [ "$dry" = 0 ] && queue_on; then
    qel=$(python3 "$Q" has --repo "$repo" --branch "$branch" --elsewhere "${qctx[@]}" 2>&1); qrc=$?
    case "$qrc" in
      0) ;;
      3) echo "FAILED: $branch is live on another host through the queue (${qel}) — one branch, one host; not running"; exit 1;;
      *) echo "== the queue did not say whether $branch runs elsewhere (exit $qrc: ${qel:-no answer}); going ahead, as before the queue";;
    esac
  fi
  wt="$repo/.claude/worktrees/$topic"
  tiershow=""; case "$tier" in principal-*) tiershow=" (tier $tier)";; esac   # a principal tier alone is the tier's doing
  if [ "$dry" = 1 ]; then echo "DRY RUN: would fetch $branch, use $wt, run $C $([ "$headless" = 1 ] && echo "-p <brief>" || echo "<brief> --remote-control in screen run-$rname-$topic") --model $model --effort $effort${tiershow}, background ${bg:-deny}, account ${acct_label:-the default login}${mode:+, mode $mode}$([ "$yolo" = 1 ] && echo ", --yolo: memo yolo's gate in the prompt, then autofinish-run --by yolo")$([ "$mode" = dnd ] && echo ", dnd: keel yolo --dnd's gate in the prompt, then autofinish-run --by dnd")" >&3; exit 0; fi
  # scheduled from inside an earlier run of this branch (--next's usual case): that run is in its
  # last turn, or idle in its screen, in this same worktree. Wait for it rather than share it.
  # a claim that waits for its branch's earlier run gives its slot back meanwhile (that run holds one)
  if [ -n "$fromq" ] && [ "$(python3 "$here/bin/dispatch-rc" unfinished "$repo" "$topic" 2>/dev/null)" != 0 ]; then
    python3 "$Q" waiting "$fromq" --label "${DISPATCH_LABEL:-}" "${qctx[@]}"
  fi
  python3 "$here/bin/dispatch-rc" after "$repo" "$topic" || exit 1
  # after() may have held it for hours: still this job's claim? (the second review: a check before the
  # wait alone let a job whose entry was replaced or returned meanwhile run beside its successor)
  if [ -n "$fromq" ] && [ "$dry" = 0 ]; then
    mine=$(python3 "$Q" mine "$fromq" --label "${DISPATCH_LABEL:-}" "${qctx[@]}" 2>&1); mrc=$?
    queue_unsure "$mrc" "$mine"
    if [ "$mrc" != 0 ]; then
      qdone=1; echo "== a stale queue job: $fromq is not this job's claim after its wait (${mine:-exit $mrc}); not running"
      queue_unreserve; exit 0
    fi
  fi
  git -C "$repo" fetch origin "$branch" 2>&1 || { echo "FAILED: $branch is not on origin"; exit 1; }
  if [ -d "$wt" ]; then
    # a leftover directory is no worktree (git would walk up to the primary on main), and one on another branch is not ours
    [ "$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$wt" && pwd -P)" ] && [ "$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$branch" ] \
      || { echo "FAILED: $wt exists but is not a worktree on $branch"; exit 1; }
  else
    git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || git -C "$repo" branch --no-track "$branch" "origin/$branch" || exit 1
    git -C "$repo" worktree add "$wt" "$branch" 2>&1 || { echo "FAILED: worktree"; exit 1; }
    [ -f "$repo/.env" ] && ln -s "$repo/.env" "$wt/.env"
  fi
  # diverged from origin: stop — every checkpoint push would be refused and the work would sit here unread
  git -C "$wt" merge --ff-only "origin/$branch" 2>&1 || { echo "FAILED: $branch here has diverged from origin (or $wt is dirty); not running"; exit 1; }
  [ ${#afters[@]} -eq 0 ] || after_merge || exit 1
  rel=$(git -C "$wt" ls-tree -r --name-only HEAD -- docs/handoff | grep -E -- "$brief_re" | sort | tail -1)
  [ -n "$rel" ] || { echo "FAILED: no docs/handoff/<YYYY-MM-DD>-$topic.md on $branch"; exit 1; }
  brief="$wt/$rel"
  # the brief as it fires decides the tier (tier_run): unread, a principal line refuses rather than run at the default
  if ! tier_run < "$brief"; then
    if grep -qiE '^[[:space:]*-]*tier[*]*:.*principal' "$brief"; then
      echo "FAILED: $rel names a principal tier and blueprintlib could not read it; not running at $model $effort"; exit 1
    fi
  fi
  if ! why=$(principal_flags); then echo "FAILED: $rel — $why; not running at $model $effort"; exit 1; fi
  case "$tier" in principal-*) echo "== tier $tier: $model $effort$([ "$model_given$effort_given" != 00 ] && echo " (--model/--effort given win for their half)")";; esac
  skipper_chain
  resolve_mode
  # the brief's blob: a --next from this run's session on an unchanged brief is refused
  chain+=(DISPATCH_BRIEF="$(git -C "$wt" rev-parse "HEAD:$rel")")
  # "in the foreground": on 2026-10-05 two runs out of two (aurora-sequence-build, codereview-jev)
  # backgrounded the check, replied "I'll pick up when it finishes", and -p exited with exit 0.
  # A brief asked for the foreground on 2026-10-04 (idea-redaction) and the run backgrounded anyway:
  # prose alone does not hold, so run_env enforces it unless --background allow (rule: engineering).
  prompt="You are an unattended session started by dispatch on $(hostname -s) at $(date '+%F %H:%M %Z'); nobody is watching, so decide from the brief and do not ask. Your worktree is $wt on branch $branch. Read the brief at $brief and do what it says. Run the project's check from AGENTS.md before calling anything done, through \`$p_check $wt --out <dir>\` (<dir> under your scratchpad; it runs the line scoped to what this branch changed, one script at a time under a slot, and says SKIP or PASSED for what it need not run — both are the check passing), in the foreground: never run_in_background, Monitor or a background agent you would wait for — this run ends with your reply, and whatever is still running dies unread. One Bash call stops at 30 minutes: start it as \`nohup $p_check $wt --out <dir> > <dir>.out 2>&1 &\` in one call, then poll <dir>/summary in later calls until its last line starts DONE, INTERRUPTED or REFUSED; an UNRUN line names a command only this branch's check line has — run it by its own Bash call; a REFUSED line (a prose check line, none at all) means the check is run by hand as AGENTS.md says. Commit; do not push, except through \`dispatch --next --repo $repo\`; never merge into main or launch (the checkpoint hook pushes, /finish launches). End with what changed, what you verified, and what you left for $who. ${note}"
  # Whether to land is never a D-item (the owner, 2026-10-23); a yolo or dnd run hands it to dispatch on
  # the hand-over line its mode's paragraph names, so the base text must not tell it to ask (review D4)
  land="Whether to land the branch is never such a decision: no D-item for it — end with the WAITING line asking it (the owner, 2026-10-23: a landing D-item cost a page round-trip for a yes that rarely matters to the doc)."
  case "$mode" in yolo|dnd) land="Whether to land the branch is never such a decision: no D-item for it, and no WAITING line asks it — this run's mode hands the landing to dispatch, as below (the owner, 2026-10-23: a landing D-item cost a page round-trip for a yes that rarely matters to the doc).";; esac
  # session-asks (R2–R4, B5): the three steps instead of an ask, and the plan reports — helm's tools
  # (G22): without its ask and helm those lines leave the prompt, and a decision the run cannot make
  # ends it on the WAITING line
  if [ -n "$p_ask" ] && [ -n "$p_helm" ]; then
    prompt="$prompt

First run \`$p_ask apply\`: it writes and commits any answer your skipper sent while this worktree was yours and nothing listened. When the brief leaves a decision you cannot make from it, do not ask (AskUserQuestion is denied): write it as a D-item in the doc you are writing — Reversible: yes|no, ➤ Recommended:, an empty ➤ Answer: — commit it, and run \`$p_ask relay <doc> <Dn>\`. $land Park what rests on that item, build the rest, and end on the line bin/ask prints: RELAYED TO … when a skipper has it (start \`$p_ask listen\` as your background shell first, if the brief allows background work), the WAITING line when nobody does. Report to the plan at your start, at each relay and at your end: \`$p_helm report --task $topic --status running|relayed|parked|done --progress '<one line>' --eta <40m> --cost auto\`; \`$p_helm show\` at the start names the sibling tasks and who owns which files. A report that fails never stops the work."
  else
    prompt="$prompt

When the brief leaves a decision you cannot make from it, do not ask (AskUserQuestion is denied): write it as a D-item in the doc you are writing — Reversible: yes|no, ➤ Recommended:, an empty ➤ Answer: — commit it, park what rests on that item, build the rest, and end on the WAITING line naming it. $land"
  fi
  prompt="$prompt When the brief names steps of a Course doc (a \`Steps:\` line), mark each one done once its check is green — \`python3 ${p_keel:-$here/bin/keel} step <doc> <S> done --branch $branch --stamp\` — and commit it: /finish and autofinish refuse a branch whose brief names an open step."
  # The gate per mode travels in the prompt (E12: "the brief carries the gate"; skipper-modes S3): keel
  # yolo is the mechanism, the mode read at fire time (resolve_mode) says which form.
  case "$mode" in
    yolo)
    prompt="$prompt

The owner's yolo (mode yolo, dispatch --yolo; E12 of docs/autofinish-design-2026-10-02.md, skipper-modes D1): one pass, up to a launch. Where the brief would stop for $who's answers to a doc's D-list, run \`python3 ${p_keel:-$here/bin/keel} yolo <the doc>\` instead and commit what it wrote. Exit 0: every open item with a bare Recommended pick, Reversible: no included, now holds that pick as a 'Taken unattended' answer — build on those answers here, inline, in this session. Exit 3, or any other exit: it stopped (at an item with no pick, a conditional or a reopened one, or on an error it printed) and wrote nothing — build nothing that rests on that list; end with the WAITING line naming the item and the doc. Never write a 'Taken unattended' answer, or an item's Reversible: mark, by hand. Do not schedule a next step (dispatch --next): a yolo run is one pass, and a step waiting on this branch stops its launch. Do not run /finish: once this run ends with its worktree clean and no doc this branch changed holding an open item, dispatch starts the launch (autofinish-run --by yolo), which lands it while the ship's mode is still yolo, past the check and the review gate (skipper-modes S3b). The landing is not asked here, so no WAITING line asks it: once the work is built and committed, and keel yolo took every item it met (exit 0, or no D-list at all), end on exactly \`$handover\`, nothing after it but links. That line hands the landing to dispatch; any other WAITING line (the one keel yolo's stop owes), a RELAYED line or a ⚠ stops it."
      ;;
    dnd)
    prompt="$prompt

The owner's do-not-disturb (mode dnd, skipper-modes D1-A): where the brief would stop for $who's answers to a doc's D-list, run \`python3 ${p_keel:-$here/bin/keel} yolo --dnd <the doc>\` instead and commit what it wrote. It takes every bare Recommended pick, Reversible: no included, as a 'Taken unattended ($who's dnd …)' answer, except the held classes (money in an option, a repo that is not physical: none, a deletion or a public publish, a third party's answer, no pick, a conditional, unmarked or reopened item). Exit 0: nothing held — build on the answers. Exit 4: it printed each held item as 'held Dn' — relay each one as above (ask relay <doc> <Dn>), park what rests on them, and build the rest on the answers it took. Any other exit: it wrote nothing — build nothing that rests on that list and relay its items. Never write a 'Taken unattended' answer, or an item's Reversible: mark, by hand. A dnd answer is not $who's word, but the mode is his yes to land (skipper-modes S3b): do not run /finish — once the last step on this branch ends with its worktree clean and nothing open, dispatch starts the launch (autofinish-run --by dnd), which lands it unless the branch is in the held slice (money, a physical repo, a public publish, a deletion of data, a gated path), where it stops at a ready PR for $who's tap. The landing is not asked here, so no WAITING line asks it: when this is the branch's last step (no dispatch --next scheduled), nothing was relayed and the work is committed, end on exactly \`$handover\`, nothing after it but links. That line hands the landing to dispatch; any other WAITING line, a RELAYED line or a ⚠ stops it. A step that scheduled the next one waits for no launch: it ends on the line dispatch --next told it to end on, when it printed one (the queue holds the step), else on \`$handnext\`."
      ;;
    ask)
    prompt="$prompt

The owner's ask mode (mode ask, skipper-modes S1): nothing answers this run's questions but $who. Relay each one as above — the relay cards it on the board, and your skipper will not answer it — then park what rests on it, build the rest, and end on the line bin/ask prints. Never take a Recommended pick yourself, and never run keel yolo."
      ;;
  esac
  cd "$wt" || exit 1
  ensure_trusted || exit 1
  python3 "$here/bin/dispatch-rc" reap   # idle orphans out before counting, outside the lock
  room=0; why=$(roomy) || room=1   # before the lock: the sample sleeps 2 s
  take_lock || exit 1
  n=$(python3 "$here/bin/dispatch-rc" live --no-reap "$repo" "$topic") || n=0
  n=$((n + $(qreserved)))   # the queue's claims hold their slots before their records exist
  if [ "$n" -ge "$(pcap)" ]; then   # force: one slot over (D2-A)
    drop_lock
    queue_refused "the run cap ($n of $max_runs busy on $self_host)" \
      || echo "FAILED: $n other runs are busy (dispatch --status; warm or waiting ones not counted); not starting another (DISPATCH_MAX_RUNS)"
    exit 1
  fi
  if [ "$room" = 1 ]; then
    drop_lock
    queue_refused "memory on $self_host: $why" || echo "FAILED: $why; not starting another (wharf-runs/headroom)"
    exit 1
  fi
  if [ "$headless" = 1 ]; then run_headless; queue_ended; yolo_launch "$rc"; queue_claim; exit 0; fi
  run_rc "$prompt" "$wt" "run-$rname-$topic"; rc=$?
  if [ "$rc" = 3 ]; then
    # never busy (dispatch-rc NEVER_STARTED): a dialog or a login prompt, the screen's contents above.
    # Once more the same way, then FAILED — never -p (the owner, 2026-10-13: "never headless")
    echo "never started interactively — retrying once, visible again"
    # the first try may have marked its entry running: end it, or it reads "running here" for good (S1 has no sweep)
    take_lock || { queue_ended; exit 1; }
    run_rc "$prompt" "$wt" "run-$rname-$topic"; rc=$?
    [ "$rc" = 3 ] && echo "FAILED: never started interactively, twice — the screens' contents above; not run headless"
  fi
  echo "== exit $rc at $(date)"
  queue_ended
  yolo_launch "$rc"
  queue_claim
} >> "$log" 2>&1
