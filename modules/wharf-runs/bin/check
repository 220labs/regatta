#!/usr/bin/env bash
# check — the PR's CI by default; local inputs here, local suites under slots when CI cannot answer.
#
#   bin/check [<checkout>] [--ci-wait MIN] [--ci-merge-main|--ci-no-merge] [--out <dir>]
#   bin/check [<checkout>] [--local] [--only <script>…] [--full] [--fresh] [--out <dir>]
#   bin/check --slots    the slot count this host runs by, nothing run (`regatta limit`'s trial read)
#
# The local road is scoped (2026-10-23): a module's suite (a script under modules/<m>/tests/) runs only when
# the checkout changed something under modules/<m>/ since it forked from origin/main (main without a
# remote), or under a module <m> uses — one its plugin.json `dependencies` names, or one its files name
# by path (`modules/<x>` or `../<x>/`) in any file of its own but Markdown — declared ones followed through (helm
# uses wharf-runs uses wharf: a wharf change runs all three), a mention one hop (followed through, a
# loose one would reach everything). A change under a module's tests/ or to its Markdown bar skills/
# and agents/ (behaviour another suite may read) runs that module's suite alone; a file moved out of
# a module changed it; a module removed is a change its users follow. Uncommitted changes count. Every other command runs every time (`claude plugin
# validate`, a gate that reads the whole tree); a module every other module declares (the core) runs
# on any change under modules/, since its suite checks them all. The whole line runs when a changed file
# sits outside modules/ and is not Markdown, under docs/ or under .github/ (bar .github/ci/, the shares'
# scripts and list; check.yml and check-linux.yml run wharf's suite, which reads them) (an unknown file is judged
# by everything), when nothing changed at all (on main, or a clean fork: nothing to scope by), when the
# fork point cannot be read, when the checkout has no modules/ or no git, or with --full. A root
# Markdown file (AGENTS.md, README) runs the suites of the modules that depend on nothing — the core's,
# which checks it. A `.<m>/` folder is module m's (.helloworld/). Each suite left out is a `SKIP
# <command> — <why>` line, in the summary and on stdout, not counted in DONE; the scope is said once
# (`check: scope — …`) after the logs line. What the scope cannot see is a suite reading another
# module's files at test time with no path in its own files: name the path in the suite, as sextant's and
# wharf-runs' tests/check.sh do. The pull request's macOS share runs by these same verdicts, so only main's
# nightly run, the whole line, closes such a gap.
# Why: a full check took 58–80 min on the laptop and 40 on the quiet build Mac, and every landing ran it
# three or four times (the build run, /finish, the PR's CI, main's CI) while the Macs sat at load 98
# (docs/check-load-2026-10-23.md). `pr merge` refuses until the pull request's CI passed (an admin
# token is not refused by the protection), and that CI is scoped by the same rules (.github/ci/share.sh:
# the Linux share since 2026-10-30, the macOS share since free-ci S3, and the whole-line PR while
# CI_LINUX_ELSEWHERE is not `true` since free-ci-scope-whole);
# the whole line is main's nightly run.
# A pass is remembered per tree: after a run, each script that passed is recorded under
# $CHECK_LOGS/passed/<tree> (the checkout's exact content, `git write-tree` over a scratch index,
# uncommitted files included), and a later run of the same tree reports it `PASSED <when> <command>`
# — counted as passed, not run, and said before any slot is taken (a run remembered whole never
# waits) — so /finish does not repeat the build run's green. A record holds the mode (attended or
# unattended, which must match: a suite may pass in one only) and HEAD, which must match for a command
# naming HEAD (the publish gate reads the commit). A record lives $CHECK_PASS_TTL seconds (default
# 86400; 0 turns the memory off, the suites' setting), pruned past that; --fresh ignores the records and
# runs everything in scope. The record is the tree's, never the environment's: a changed overlay, peer
# repo or login is not seen, which the day's TTL bounds.
#
# Start it with the Bash tool's run_in_background: a whole check of the overlay's size runs ~36 min, past one
# Bash call's cap (10 min, the tool's maximum; AGENTS.md). Where background tasks are off (an unattended /finish), `nohup bin/check … --out
# <dir> > <dir>.out 2>&1 &` in one call, then poll <dir>/summary until its last line starts DONE,
# FAILED (--ci's red), INTERRUPTED or REFUSED. Unattended (CLAUDE_UNATTENDED), the line is origin/main's, not the branch's,
# and the first line says so (below). The log folder is printed as `logs: <dir>` (the first line,
# attended); in it, one log per script (`01-test_checkpoint.sh.log`…) and `summary`, one line per
# script as it ends —
#   HH:MM rc=<exit code> <seconds>s <command>
# or `PASSED <when> <command>` for one the memory above answered; `SKIP <command> — <why>` lines first
# for the suites out of scope; then, unattended only, `ABSENT <command> …` and `UNRUN <command>` lines
# (below), then `DONE <passed>/<total>`. Exit 0 only when every script passed; 1 when one failed; 3 when all passed
# but a command was UNRUN; 2 for a usage error (no check line, an --only that names no script),
# printed and, with --out, written to the summary as `REFUSED <why>`. A signal to check itself stops the
# script it runs and ends the summary `INTERRUPTED <passed>/<total> by SIG<x>`, so a run cut short
# never reads as a run that failed. A script killed from outside shows its rc: 137 is SIGKILL (what
# macOS's low-memory killer sends), 143 SIGTERM — a kill, not a test that failed.
#
#   <checkout>   default: the git checkout the caller is in — this file lives in a module of the
#                regatta clone (wharf-runs), not in the repo it checks, so its own path names no
#                checkout to check (B7; it was the overlay's own). /finish passes the worktree it launches.
#   --only       a subset, in the check line's order: each name matches a script by path, basename
#                or basename without .sh (`--only bin/test_check.sh test_hooks`). Same slot rules;
#                no scope (what is named runs), the pass memory still answers.
#   --full       the whole line, whatever changed; --fresh: run what is in scope, remembered or not.
#   --out        the log folder; default $CHECK_LOGS (~/Library/Caches/check-runs)/<checkout>-<stamp>-<pid>
#   --local      run locally; an existing exact-tree CI green still counts as PASSED <when> CI.
#                --only, --full and --fresh force local scripts, without the CI shortcut.
#   --ci         the default: use this claude/* branch's PR CI when the repo has a PR workflow,
#                required checks and gh answers, outside every confidential scope. Its shares run in
#                parallel, spending CI minutes and opening a non-draft PR labelled hold (automerge
#                stays off). Fetch and merge origin/main if needed, then push only this branch,
#                never force. A conflict is FAILED, aborted with its files named. A PR readied by
#                /finish uses local checks when main moved unless --ci-merge-main explicitly allows
#                a merge (the owner's yes, refused unattended).
#                --ci-no-merge refuses a moved main (the curated /finish tip must be rebased).
#                A required green on this exact tree returns PASSED <when> CI before any mutation.
#                Wait for origin/main's .github/main-protection.json contexts (else the protection API's); a moved
#                head is FAILED. --ci-wait MIN bounds the wait (whole minutes, default 120).
#                Missing gh/network, refused push, no PR or timeout falls back to the local line,
#                said once; so do confidential scopes or an unreadable registry, uncommitted work,
#                a branch already landed, guarded repos, and local-only --only/--full/--fresh.
#                A new PR opens as a draft, labelled before it is readied; a signal ends the helper.
#                check_ci.py's explicit LOCAL_COMMANDS list
#                runs contract commands whose private inputs CI lacks beside the wait, without a
#                slot, counted in DONE too; a local failure fails the check even with green CI.
#                Commands neither CI's line (.github/ci/share.sh line) nor that list covers are
#                UNRUN (exit 3); without a CI line to compare, check runs locally.
#                No local slot or pass record is used for CI.
#                Why: review/fix loops waited hours for Mac slots; PR CI runs the shares at once.
#                CI failures end with FAILED, with failed-job lines and logs in --out; exit 0/1.
#
# Why the slots (2026-10-19): with five checks running on the laptop, Claude Code killed rename S3's
# test_hooks and test_pickup for low memory (load averages 40–90 the day before), and the killed
# suite read as a failed one — a built slice reported "failed". Before its first script, check takes
# one of $CHECK_SLOTS (default 2, about what the laptop held beside its sessions; per host below) slots per Mac login (under $HOME, so a second login has its own):
# a directory $CHECK_SLOT_DIR (~/Library/Caches/check-slots)/slot-<i> made with mkdir (atomic), with
# the holder's `pid`, `start` (its ps lstart, so a reused pid is not mistaken for the holder),
# `checkout` and `since` inside: `start` first, then `pid` by rename (a pid always has its start),
# then `checkout` and `since`, so a reader may see a pid before those two (since 2026-10-27).
# A slot whose holder is dead is taken over; one with no pid older than 2 min (a crash between mkdir
# and the write) too — bin/dispatch's take_lock pattern. A slot is given back at exit (any exit a
# trap sees); a SIGKILLed holder's slot is reclaimed by the next waiter. Waiters queue in order of
# arrival (a ticket in queue/, dead tickets dropped), print once that they wait and for whom, and
# poll every $CHECK_SLOT_POLL seconds (default 5).
# $CHECK_SLOTS unset, the count is this host's line in the config dir's wharf-runs/check-slots (the
# overlay writes it): `<host>:<n>`, `*:<n>` for a host without a line, host names lower-case; no
# file or no line is 2 (the owner, 2026-10-23: "let's expand the laptop capacity to 3").
# Not parallel inside one check: the scripts' timing tests assume they run alone (brief, 2026-10-19).
set -u

# this host's line of wharf-runs/check-slots, else `*`'s, else 2. The live layer first (`regatta limit`,
# live-limits 2026-11-01: <config>/live/<key>, which --config never writes): its lines stand in front of
# the base file's, so the first match is the layer's, as the core's config_read merges them.
slots_here() {
  local c f h v
  c="${REGATTA_CONFIG:-$HOME/.config/regatta}"; f="$c/wharf-runs/check-slots"
  # spelled as the core's host_name and `regatta limit` spell it: lower case, any other character a dash
  h="${CHECK_HOST:-$( { scutil --get LocalHostName 2>/dev/null || hostname -s; } | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9-]/-/g' -e 's/^-*//' -e 's/-*$//')}"
  # sed over both files, never `cat` into it: a layer whose last line has no newline would join the config's first
  v="$(sed -n "s/^[[:space:]]*$h:[[:space:]]*//p" "$c/live/wharf-runs/check-slots" "$f" 2>/dev/null | head -1)"
  [ -n "$v" ] || v="$(sed -n 's/^[[:space:]]*\*:[[:space:]]*//p' "$c/live/wharf-runs/check-slots" "$f" 2>/dev/null | head -1)"
  echo "${v:-2}" | tr -d '[:space:]'
}
wt=""; out=""; only=(); mode=""; asked_only=""; full=""; fresh=""
ci=1; ci_wait=120; ci_wait_set=""; ci_merge=""; ci_logs=""
# a refusal (exit 2) also ends <dir>/summary when --out named one, so a caller polling it sees it
refuse() {
  echo "check: $1" >&2
  [ -n "$out" ] && mkdir -p "$out" 2>/dev/null && echo "REFUSED $1" >> "$out/summary"
  exit 2
}
while [ $# -gt 0 ]; do
  case "$1" in
    # the slot count this host runs by, judged as a check judges it, and nothing run: `regatta limit`'s
    # trial read of a value (exit 2 on a count the slot would refuse)
    --slots) n="${CHECK_SLOTS:-$(slots_here)}"
             case "$n" in ''|*[!0-9]*|0*) refuse "CHECK_SLOTS must be a number from 1 (got $n)" ;; esac
             echo "$n"; exit 0 ;;
    --only) mode=only; asked_only=1; shift; continue ;;
    --out) [ $# -ge 2 ] || refuse "--out needs a folder"; out="$2"; mode=""; shift 2; continue ;;
    --full) full=1; mode=""; shift; continue ;;
    --fresh) fresh=1; mode=""; shift; continue ;;
    --ci) ci=1; mode=""; shift; continue ;;
    --local) ci=""; mode=""; shift; continue ;;
    --ci-wait) [ $# -ge 2 ] || refuse "--ci-wait needs minutes"; ci_wait="$2"; ci_wait_set=1; mode=""; shift 2; continue ;;
    --ci-merge-main) ci_merge=1; mode=""; shift; continue ;;
    --ci-no-merge) ci_merge=never; mode=""; shift; continue ;;
    -h|--help) sed -n '2,/^set -u/{ /^set -u/d; p; }' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) refuse "unknown option $1" ;;
  esac
  if [ "$mode" = only ]; then only+=("$1")
  elif [ -z "$wt" ]; then wt="$1"
  else refuse "one checkout only (got $wt and $1)"; fi
  shift
done
# an --only that named nothing, even one followed by --out, never runs the whole line
[ -z "$asked_only" ] || [ ${#only[@]} -gt 0 ] || refuse "--only needs a script"
[ -n "$wt" ] || wt="$(git rev-parse --show-toplevel 2>/dev/null)" || refuse "not in a git checkout: name the checkout to check"
[ -d "$wt" ] || refuse "no such checkout: $wt"
wt="$(cd "$wt" && pwd -P)"
case "$ci_wait" in ''|*[!0-9]*) refuse "--ci-wait must be whole minutes from 0" ;; esac
[ -n "$ci" ] || [ -z "$ci_merge$ci_wait_set" ] || refuse "CI options cannot be used with --local"
# merging main into a ready PR leaves it unlandable (AGENTS.md's trap): the flag is a person's yes
[ "$ci_merge" != 1 ] || [ -z "${CLAUDE_UNATTENDED:-}${REGATTA_UNATTENDED:-}${AUTOFINISH_CALLER_UNATTENDED:-}" ] \
  || refuse "--ci-merge-main is the owner's yes, never an unattended run's"

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
# a `- check:` line's code (between its first pair of backticks), empty for prose
code_of() { case "$1" in '- check: `'*'`'*) printf '%s\n' "$1" | sed 's/^- check: *`//; s/`.*$//' ;; esac; }
# cmds=( the line's commands, split on ` && `, trimmed )
split_line() {
  cmds=(); local rest="$1" c
  while :; do
    case "$rest" in
      *" && "*) c="${rest%% && *}"; rest="${rest#* && }" ;;
      *) c="$rest"; rest="" ;;
    esac
    c="$(trim "$c")"; [ -n "$c" ] && cmds+=("$c")
    [ -n "$rest" ] || break
  done
}

# the check line: the first `- check:` in AGENTS.md.
# Unattended (CLAUDE_UNATTENDED, which bin/dispatch sets for every launcher and seeded run) it comes from
# origin/main (main without a remote, as the PR will merge onto it), never the branch's: the launcher's
# Bash(<overlay>/bin/*) rule approves this script, so a branch that rewrote its own check line
# would have it run unwatched — the hole autofinish-run's start_cmd keeps closed since the 2026-10-13
# review (check-slots item 4, the skipper's answer of 2026-10-19). What that leaves out is said, never
# dropped: a script main's line names that this branch lacks is ABSENT (forked before main added it, or
# renamed here; the attended run would not have it either), and a command only the branch's line has is
# UNRUN, exit 3 — /finish runs it by its own Bash call, where auto mode sees it (review, 2026-10-19).
# A `~/`, HOME-variable or `/` path this Mac lacks is no rebase's to bring and fails an attended run too:
# rc=127, counted and failed, never ABSENT (B14b's prerequisites' landing review, 2026-10-24).
unatt=""; braw=""
if [ -n "${CLAUDE_UNATTENDED:-}" ]; then
  unatt=1
  git -C "$wt" rev-parse --git-dir > /dev/null 2>&1 || refuse "unattended, and $wt is not a git checkout"
  ref=origin/main; git -C "$wt" rev-parse -q --verify "$ref:AGENTS.md" > /dev/null 2>&1 || ref=main
  raw=$(git -C "$wt" show "$ref:AGENTS.md" 2>/dev/null | grep -m1 '^- check:')
  src="$ref:AGENTS.md"
  [ -n "$raw" ] || refuse "unattended, and no \`- check:\` line in $src of $wt"
  echo "check: unattended — the check line from $ref, not this branch's"
  braw=$(grep -m1 '^- check:' "$wt/AGENTS.md" 2>/dev/null)
else
  raw=$(grep -m1 '^- check:' "$wt/AGENTS.md" 2>/dev/null); src="$wt/AGENTS.md"
fi
# prose (no code span) is run by hand, never handed to bash
case "$raw" in '- check: `'*'`'*) ;; *) refuse "no \`- check:\` command line in $src (prose is run by hand)" ;; esac
line=$(code_of "$raw")
[ -n "$line" ] || refuse "no \`- check:\` line in $src"
unrun=()
if [ -n "$braw" ] && [ ${#only[@]} -eq 0 ] && [ -n "$(code_of "$braw")" ]; then
  split_line "$line"; main_cmds=("${cmds[@]}")
  split_line "$(code_of "$braw")"
  for b in "${cmds[@]}"; do
    hit=""; for m in "${main_cmds[@]}"; do [ "$b" = "$m" ] && { hit=1; break; }; done
    [ -n "$hit" ] || unrun+=("$b")
  done
fi
split_line "$line"
# CI answers after the contract is read; --local may only reuse an existing exact-tree green.
if [ -n "$asked_only$full$fresh" ]; then
  [ -z "$ci" ] || echo "check: CI unavailable (local options requested); falling back to local check"
else
  ci_line=""
  [ -f "$wt/.github/ci/share.sh" ] && ci_line="$(bash "$wt/.github/ci/share.sh" line "$wt" 2>/dev/null)"
  if [ -z "$ci_line" ]; then
    # without the CI's own line nothing says which of the contract's commands a CI green covers
    [ -z "$ci" ] || echo "check: CI unavailable (no .github/ci/share.sh line to compare); falling back to local check"
  else
    # The helper runs only its explicit local-input list; other uncovered commands stay UNRUN.
    ci_unrun=("${unrun[@]+"${unrun[@]}"}")
    for c in "${cmds[@]}"; do case "$ci_line" in *"$c"*) ;; *) ci_unrun+=("$c") ;; esac; done
    [ -n "$out" ] || out="${CHECK_LOGS:-$HOME/Library/Caches/check-runs}/$(basename "$wt")-$(date +%Y%m%d-%H%M%S)-$$"
    mkdir -p "$out" || refuse "cannot make $out"
    out="$(cd "$out" && pwd -P)"; : > "$out/summary"
    if [ -n "$ci" ]; then echo "logs: $out"; ci_logs=1; fi
    # in the background under traps, so a signal to check ends the helper too and says INTERRUPTED
    CHECK_CI_UNRUN="$(printf '%s\n' "${ci_unrun[@]+"${ci_unrun[@]}"}")" \
      python3 "$(cd "$(dirname "$0")" && pwd)/check_ci.py" "$wt" "$out" "$ci_wait" "${ci_merge:-0}" "${ci:-reuse}" &
    cip=$!
    ci_signal() {
      kill -TERM "$cip" 2>/dev/null
      echo "INTERRUPTED 0/0 by SIG$1" >> "$out/summary"; echo "INTERRUPTED 0/0 by SIG$1"
      exit "$2"
    }
    trap 'ci_signal INT 130' INT; trap 'ci_signal TERM 143' TERM; trap 'ci_signal HUP 129' HUP
    wait "$cip"; rc=$?
    trap - INT TERM HUP
    # 75 is this helper's no-answer result; red CI (1) never reruns locally to turn green; 3 is green
    # with UNRUN lines, as the local road's
    case "$rc" in 0|1|3) exit "$rc" ;; 75) ;; *) echo "check: CI unavailable (helper could not answer); falling back to local check" ;; esac
  fi
fi
# the script a command runs: its first word with a / or a .sh/.py ending, else its first word;
# a leading `NAME=value` is an assignment, never the script. A `~/` word, or one led by the HOME variable,
# is expanded, as bash will when it runs the command: such a path, or one from `/`,
# is outside the branch (a module in another checkout, `python3 ~/…/regatta check`), so the
# ABSENT test below asks the Mac for it, not the worktree (B14b's prerequisites, 2026-10-24).
script_of() {
  local w
  for w in $1; do
    case "$w" in
      [A-Za-z_]*=*) case "${w%%=*}" in *[!A-Za-z0-9_]*) ;; *) continue ;; esac ;;
    esac
    case "$w" in
      "~/"*) printf '%s' "$HOME${w#\~}"; return ;;
      '$'HOME/*) printf '%s' "$HOME${w#\$HOME}"; return ;;
      '$'{HOME}/*) printf '%s' "$HOME${w#\$\{HOME\}}"; return ;;
      */*|*.sh|*.py) printf '%s' "$w"; return ;;
    esac
  done
  printf '%s' "${1%% *}"
}
run=()
for c in "${cmds[@]}"; do
  c="$(trim "$c")"; [ -n "$c" ] || continue
  if [ ${#only[@]} -eq 0 ]; then run+=("$c"); continue; fi
  s="$(script_of "$c")"; b="$(basename "$s")"
  for o in "${only[@]}"; do
    case "$o" in "$s"|"~${s#"$HOME"}"|"$b"|"${b%.sh}"|"$c") run+=("$c"); break ;; esac
  done
done
if [ ${#only[@]} -gt 0 ]; then
  for o in "${only[@]}"; do
    hit=""
    for c in "${run[@]+"${run[@]}"}"; do
      s="$(script_of "$c")"; b="$(basename "$s")"
      case "$o" in "$s"|"~${s#"$HOME"}"|"$b"|"${b%.sh}"|"$c") hit=1; break ;; esac
    done
    [ -n "$hit" ] || refuse "--only $o: not in the check line of $src"
  done
fi
[ ${#run[@]} -gt 0 ] || refuse "nothing to run"

# --- the scope (the header) ----------------------------------------------------------------------
# skipped=( "<command> — <why>" ); scope_line is said after the logs line
skipped=(); scope_line=""; base=""
in_git() { git -C "$wt" rev-parse -q --verify HEAD > /dev/null 2>&1; }
if [ -z "$full" ] && [ ${#only[@]} -eq 0 ] && [ -d "$wt/modules" ] && in_git; then
  base=origin/main; git -C "$wt" rev-parse -q --verify "$base" > /dev/null 2>&1 || base=main
  if git -C "$wt" rev-parse -q --verify "$base" > /dev/null 2>&1; then
    mb=$(git -C "$wt" merge-base "$base" HEAD 2>/dev/null) || mb=""
    # --no-renames and both sides of a porcelain `R old -> new`: a file moved out of a module changed it
    changed=$( { git -C "$wt" diff --no-renames --name-only "$mb" 2>/dev/null
                 git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null | cut -c4- | sed 's/ -> /\
/'; } | sort -u)
    [ -n "$mb" ] || changed=""
    # one verdict per command, in order — RUN<tab><why> or SKIP<tab><why> — after a SCOPE<tab><said> line;
    # check_scope.py holds the rules, which the Linux PR trigger (.github/workflows/check-linux.yml) asks too
    verdicts=$(CHECK_CMDS="$(printf '%s\n' "${run[@]}")" python3 "$(cd "$(dirname "$0")" && pwd)/check_scope.py" "$wt" "$base" "$changed") || verdicts=""
    if [ -n "$verdicts" ]; then
      scope_line="${verdicts%%
*}"; scope_line="${scope_line#SCOPE	}"
      kept=(); i=0
      while IFS= read -r v; do
        case "$v" in SCOPE*) continue ;; esac
        c="${run[$i]}"; i=$((i + 1))
        case "$v" in RUN*) kept+=("$c") ;; *) skipped+=("$c — ${v#SKIP	}") ;; esac
      done <<< "$verdicts"
      run=("${kept[@]+"${kept[@]}"}")
    else
      scope_line="the whole line: the scope could not be read"
    fi
    [ -n "$mb" ] || { run=("${cmds[@]}"); skipped=(); scope_line="the whole line: the fork point from $base could not be read"; }
  else
    scope_line="the whole line: no $base in $wt"
  fi
elif [ -n "$full" ]; then scope_line="the whole line (--full)"
fi
total=${#run[@]}

[ -n "$out" ] || out="${CHECK_LOGS:-$HOME/Library/Caches/check-runs}/$(basename "$wt")-$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$out" || refuse "cannot make $out"
out="$(cd "$out" && pwd -P)"; : > "$out/summary"
[ -n "$ci_logs" ] || echo "logs: $out"
[ -z "$scope_line" ] || echo "check: scope — $scope_line"
for sk in "${skipped[@]+"${skipped[@]}"}"; do echo "SKIP $sk" >> "$out/summary"; echo "SKIP $sk"; done
passed=0
if [ "$total" -eq 0 ]; then   # every suite out of scope: nothing to run, nothing failed
  for u in "${unrun[@]+"${unrun[@]}"}"; do echo "UNRUN $u" >> "$out/summary"; echo "UNRUN $u"; done
  echo "DONE 0/0" >> "$out/summary"; echo "DONE 0/0"
  [ ${#unrun[@]} -eq 0 ] || exit 3
  exit 0
fi

# --- the pass memory (the header): this tree's passed scripts, by command -------------------------
# A record: <epoch> <mode> <HEAD> <command>, tab-separated, in $passed_dir/<tree>. The mode (attended or
# unattended: a suite may pass only in one, AGENTS.md's trap) must match; HEAD must match for a command
# that names HEAD (the publish gate reads the commit, not the tree it is remembered under).
ttl="${CHECK_PASS_TTL:-86400}"; tree=""; head=""; passed_dir="${CHECK_LOGS:-$HOME/Library/Caches/check-runs}/passed"
case "$ttl" in ''|*[!0-9]*) refuse "CHECK_PASS_TTL must be a number of seconds (got $ttl)" ;; esac
mode="attended"; [ -z "$unatt" ] || mode="unattended"
if [ "$ttl" -gt 0 ] && in_git; then
  ix="$(mktemp "${TMPDIR:-/tmp}/check-index.XXXXXX")"
  # seeded from the real index: its stat cache spares a re-hash of every tracked file
  cp "$(git -C "$wt" rev-parse --path-format=absolute --git-path index)" "$ix" 2>/dev/null || : > "$ix"
  tree=$( cd "$wt" && GIT_INDEX_FILE="$ix" git add -A . 2>/dev/null && GIT_INDEX_FILE="$ix" git write-tree 2>/dev/null ) || tree=""
  rm -f "$ix"
  head=$(git -C "$wt" rev-parse HEAD 2>/dev/null)
  find "$passed_dir" -type f -mmin "+$(( ttl / 60 + 1 ))" -delete 2>/dev/null   # records past their life
fi
# remembered_at <command>: the youngest usable record's time (epoch), nothing when none
remembered_at() {
  [ -n "$tree" ] && [ -z "$fresh" ] && [ -f "$passed_dir/$tree" ] || return 0
  local h=""; case " $1 " in *" HEAD "*|*HEAD*) h="$head" ;; esac
  awk -F'\t' -v c="$1" -v m="$mode" -v h="$h" -v now="$(date +%s)" -v ttl="$ttl" \
    '$4 == c && $2 == m && (h == "" || $3 == h) && now - $1 <= ttl { t = $1 } END { if (t) print t }' "$passed_dir/$tree"
}
remember() {   # <command>: this tree passed it now
  [ -n "$tree" ] || return 0
  mkdir -p "$passed_dir" 2>/dev/null && printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$mode" "$head" "$1" >> "$passed_dir/$tree"
}
# what is remembered is said now, and never waits for a slot; what is left runs under one
todo=()
for c in "${run[@]}"; do
  at="$(remembered_at "$c")"
  if [ -n "$at" ]; then
    l="PASSED $(date -r "$at" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$at" '+%Y-%m-%d %H:%M') $c"
    echo "$l" >> "$out/summary"; echo "$l"; passed=$((passed + 1))
  else todo+=("$c"); fi
done
if [ ${#todo[@]} -eq 0 ]; then
  for u in "${unrun[@]+"${unrun[@]}"}"; do echo "UNRUN $u" >> "$out/summary"; echo "UNRUN $u"; done
  echo "DONE $passed/$total" >> "$out/summary"; echo "DONE $passed/$total"
  [ ${#unrun[@]} -eq 0 ] || exit 3
  exit 0
fi
run=("${todo[@]}")

# --- the slot --------------------------------------------------------------------------------------
sd="${CHECK_SLOT_DIR:-$HOME/Library/Caches/check-slots}"; n="${CHECK_SLOTS:-$(slots_here)}"; poll="${CHECK_SLOT_POLL:-5}"
case "$n" in ''|*[!0-9]*|0*) refuse "CHECK_SLOTS must be a number from 1 (got $n)" ;; esac   # 00 too: seq 1 00 is empty on GNU
mkdir -p "$sd/queue" || refuse "cannot make $sd"
pstart() { TZ=UTC LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | xargs; }
me_start="$(pstart $$)"
# an empty start would make this run's holder look dead to every other check
[ -n "$me_start" ] || refuse "ps cannot read this run's start time"
# a holder (slot dir or ticket file) is live when its pid runs and started when it said it did; a
# ps that fails (fork pressure, the load the slots exist for) reads as live — fail closed, never a third run
alive() {
  [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 1
  local s; s="$(pstart "$1")"; [ -z "$s" ] || [ "$s" = "$2" ]
}
slot_live() {   # <slot> <its pid as read>
  if [ -z "$2" ]; then [ -z "$(find "$1" -maxdepth 0 -mmin +2 2>/dev/null)" ]; return; fi
  alive "$2" "$(cat "$1/start" 2>/dev/null)"
}
# take over a dead holder's slot, only if it still names the holder seen dead
# (pid-less: still older than 2 min, so a fresh holder another waiter just made is left alone)
reclaim() {   # <slot> <its pid as read>
  [ "$(cat "$1/pid" 2>/dev/null)" = "$2" ] || return 0
  [ -n "$2" ] || [ -n "$(find "$1" -maxdepth 0 -mmin +2 2>/dev/null)" ] || return 0
  rm -f "$1/pid" "$1/start" "$1/checkout" "$1/since" "$1/.DS_Store" "$1"/pid.* 2>/dev/null
  rmdir "$1" 2>/dev/null || { echo "check: cannot reclaim $1 — a file in it is not a slot's; remove it" >&2; return 0; }
  local w; if [ -n "$2" ]; then w="pid $2"; else w="a holder that never wrote its pid"; fi
  echo "check: reclaimed $(basename "$1") from $w, no longer running"
}
held=""; ticket=""
release() {
  [ -n "$held" ] && [ "$(cat "$held/pid" 2>/dev/null)" = "$$" ] && {
    rm -f "$held/pid" "$held/start" "$held/checkout" "$held/since" "$held/.DS_Store"; rmdir "$held" 2>/dev/null; }
  held=""
  [ -n "$ticket" ] && rm -f "$ticket"; ticket=""
}
child=""
on_signal() {
  [ -n "$child" ] && kill -TERM -- "-$child" 2>/dev/null
  echo "INTERRUPTED $passed/$total by SIG$1" >> "$out/summary"; echo "INTERRUPTED $passed/$total by SIG$1"
  release; trap - EXIT; exit "$2"
}
trap release EXIT
trap 'on_signal INT 130' INT; trap 'on_signal TERM 143' TERM; trap 'on_signal HUP 129' HUP

stamp() { perl -MTime::HiRes=time -e 'printf "%017.6f", time' 2>/dev/null || printf '%010d.000000' "$(date +%s)"; }
ticket="$sd/queue/$(stamp).$$"
printf '%s\n%s\n%s\n' "$$" "$me_start" "$wt" > "$sd/queue/.t.$$" && mv "$sd/queue/.t.$$" "$ticket"
said=""
while :; do
  free=(); holders=" "
  for i in $(seq 1 "$n"); do
    s="$sd/slot-$i"
    if [ -d "$s" ]; then
      p=$(cat "$s/pid" 2>/dev/null)
      # a holder by pid and start both, and only a live one: a dead pid left in an unreclaimable slot
      # must not let a new run that reuses it skip the queue
      if slot_live "$s" "$p"; then holders="$holders$p|$(cat "$s/start" 2>/dev/null) "; else reclaim "$s" "$p"; fi
    fi
    [ -d "$s" ] || free+=("$s")
  done
  # a ticket whose run already holds a slot (it drops the ticket just after) is not ahead: counted
  # as a taken slot and a waiter both, it made a third check wait with three slots for three
  # (test_check.sh's "this host's line, 3", once on a slow runner Mac, 2026-10-27)
  rank=0
  for t in $(ls "$sd/queue" 2>/dev/null | sort); do
    f="$sd/queue/$t"; [ "$f" = "$ticket" ] && break
    { read -r tp; read -r ts; } 2>/dev/null < "$f" || { tp=""; ts=""; }
    if ! alive "$tp" "$ts"; then rm -f "$f"
    else case "$holders" in *" $tp|$ts "*) ;; *) rank=$((rank + 1)) ;; esac; fi
  done
  if [ "$rank" -lt "${#free[@]}" ]; then
    for s in "${free[@]}"; do
      if mkdir "$s" 2>/dev/null; then
        # start before pid (a pid without its start reads as dead and is reclaimed), the pid next, so
        # the window where the slot names no holder is as short as it can be; the rest after
        printf '%s\n' "$me_start" > "$s/start"
        # held only once the pid reads back as ours: a racing reclaimer may have removed the dir
        printf '%s\n' "$$" > "$s/pid.$$" 2>/dev/null && mv "$s/pid.$$" "$s/pid" 2>/dev/null \
          && [ "$(cat "$s/pid" 2>/dev/null)" = "$$" ] && {
            held="$s"   # first: a signal from here on still gives the slot back
            printf '%s\n' "$wt" > "$s/checkout"; date '+%Y-%m-%d %H:%M:%S' > "$s/since"; break; }
      fi
    done
    [ -n "$held" ] && break
  elif [ -z "$said" ]; then
    who=""
    for i in $(seq 1 "$n"); do
      s="$sd/slot-$i"; [ -d "$s" ] || continue
      # checkout and since come just after the pid: a holder caught between reads as `?`
      who="$who; pid $(cat "$s/pid" 2>/dev/null || echo '?') $(cat "$s/checkout" 2>/dev/null || echo '?') (since $(cat "$s/since" 2>/dev/null || echo '?'))"
    done
    if [ ${#free[@]} -eq 0 ]; then w="all $n taken${who:+:${who#;}}"; else w="${#free[@]} of $n free"; fi
    echo "check: waiting for a slot — $w$([ "$rank" -gt 0 ] && echo "; $rank ahead in the queue")"
    said=1
  fi
  sleep "$poll"
done
rm -f "$ticket"; ticket=""
echo "check: $(basename "$held") of $n, ${#run[@]} script(s) in $wt"

# --- the scripts, one at a time --------------------------------------------------------------------
k=0
for c in "${run[@]}"; do
  s="$(script_of "$c")"
  if [ -n "$unatt" ] && case "$s" in /*) true ;; *) false ;; esac && [ ! -e "$s" ]; then
    l="$(date +%H:%M) rc=127 0s $c — this Mac has no $s"
    echo "$l" >> "$out/summary"; echo "$l"; continue
  fi
  if [ -n "$unatt" ] && case "$s" in /*) false ;; */*|*.sh|*.py) true ;; *) false ;; esac && [ ! -e "$wt/$s" ]; then
    l="ABSENT $c — main's line names it, this branch has no $s"
    echo "$l" >> "$out/summary"; echo "$l"; total=$((total - 1)); continue
  fi
  k=$((k + 1))
  name="$(basename "$(script_of "$c")" | tr -c 'A-Za-z0-9._\n-' '_')"
  log="$out/$(printf '%02d' "$k")-$name.log"
  t0=$(date +%s)
  # its own process group (set -m), so a signal to check stops the script and everything it started
  set -m; (cd "$wt" && exec bash -c "$c") > "$log" 2>&1 < /dev/null &
  child=$!; set +m; wait "$child"; rc=$?; child=""
  [ "$rc" -eq 0 ] && { passed=$((passed + 1)); remember "$c"; }
  l="$(date +%H:%M) rc=$rc $(( $(date +%s) - t0 ))s $c"
  echo "$l" >> "$out/summary"; echo "$l"
done
for u in "${unrun[@]+"${unrun[@]}"}"; do echo "UNRUN $u" >> "$out/summary"; echo "UNRUN $u"; done
release
echo "DONE $passed/$total" >> "$out/summary"; echo "DONE $passed/$total"
[ "$passed" -eq "$total" ] || exit 1
[ ${#unrun[@]} -eq 0 ] || exit 3
