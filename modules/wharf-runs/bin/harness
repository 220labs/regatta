#!/usr/bin/env python3
"""harness — one set of verbs over every coding-agent CLI: the provider contract of
docs/harness-contract-2026-10-11.md, section 3 (orchestration B5; the owner's D2-A, 2026-10-14: ACP's
verb meanings, A2A's state names plus `idle`, sessionpipe's events; one bin/harness, one adapter
file per harness).

    harness status REF [--harness NAME] [--host here|PEER|all] [--repo DIR] [--json]
        V3: one session record. REF is a session id or a prefix of 6 or more, a session's title
        (Claude Code's `name`), or a dispatch run's topic — its live run first, else its newest.
        Exit 1: nothing matches; 2: two live sessions match (each is listed; --repo narrows).
    harness list [--harness NAME] [--host here|PEER|all] [--unsettled] [--json]
        V4: every live session record. --json prints one JSON array of records, else a table.
        Exit 3: a host asked for did not answer — what the others hold is still printed.
        --unsettled adds the runs that ended without completing which the harness still lists
        (Orca: every failed or canceled Dispatch) — bin/stalls.py's read; the others ignore it.
    harness retry REF [--harness orca] [--model M] [--effort E] [--json]
        A fresh attempt at a failed run's task, the same placement: Orca's `--retry-of` (the tick's
        S1 retry of an Orca step, B8). Only the orca adapter has it; a Claude Code step is
        re-dispatched from its brief by bin/stalls_tick.py instead. Exit 2: not a failed run.
    harness run [--harness claude-code|orca|codex|agy] (--prompt TEXT | --prompt-file FILE | --branch BRANCH)
                [--cwd DIR] [--repo DIR] [--name TOPIC] [--agent claude|codex] [--runner orca]
                [--model M] [--effort E] [--account auto|LABEL [--ship KEY]] [--headless] [--on HOST]
                [--timeout S] [--ephemeral] [--json]
        V1: start a session; prints its record at once (state `submitted` or later, its session_id
        when the harness has one by then). claude-code (the default) is bin/dispatch: --prompt in
        --cwd, a claude/* worktree, is `dispatch --start` detached; --branch is a seeded branch,
        `dispatch BRANCH` (launchd, about 2 min; --on PEER there only: dispatch's --pin, S12). orca makes the worktree
        itself in --repo (`<yyyy-mm-dd>-<topic>` → claude/<host>/<yyyy-mm-dd>-<topic>) and starts an
        `--agent` worker in it — with --account (auto: bin/account's pick; --ship KEY keeps a ship on
        the login it was pinned to) a Claude worker on that login, in a terminal of ours (docs/
        orca-accounts-2026-10-16.md); codex is `codex exec --json` detached in --cwd, or Orca's codex
        worker with --runner orca; --timeout S ends a codex run past S seconds (default two hours) and
        --ephemeral runs it `codex exec --ephemeral`; agy is Google's `agy` in print mode detached in --cwd (a
        claude/* worktree), on the login `bin/account pick --provider antigravity` names for the repo, its guards in
        agy's own hooks.json (bin/harness_adapters/agy.py's header) — the road `dispatch BRANCH --harness agy` takes
        (agy-road, 2026-11-04). Exit 1: the start failed; 2: refused before anything started.
    harness run --harness codex --mode research --repo HOME --cwd COPY (--prompt TEXT | --prompt-file FILE)
                [--review BASE] [--web] [--timeout S] [--deadline EPOCH] [--council RUN] [--approved QUOTE]
                [--model M] [--effort E] [--json]
        Research mode (principal tier S3, docs/principal-tier-2026-10-26.md; fenced since the isolation
        design's S1, docs/principal-council-isolation-2026-10-29.md, whose fences F1–F7 these are): one Codex
        turn in COPY, in the foreground: it returns when codex ends or at its deadline (killed then), the record
        holding the reply, the usage summed over every turn.completed and each command codex ran. Refused (exit 2)
        before codex starts:
        - F1, the source judge (research_guard): a public repo (contract E4);
          a confidential scope's repo, as HOME or as COPY, or any while the registry cannot be read (bin/jev's
          rule, fail closed); a guarded HOME or prompt file without --approved, the owner's quote for OpenAI
          (bin/gate's vet), never from an unattended caller.
        - F2, the copy: COPY is a council arm's — `<run>/<phase>/<arm>/box/copy` or the review's `<run>/review/
          box/repo`, under a 0700 run dir of this account's holding the council's marker (the core's
          fence.box_why, which says what the rules it replaced read; council's git_copy writes the copy).
        - F3, the start (the adapter): no scratch CODEX_HOME in the box (auth.json alone, council's
          fence.arm_home), a feature `codex features list` shows on that fence.CODEX_FEATURES has not judged,
          an administrator layer of Codex's (/etc/codex/*.toml, the managed preferences' config keys).
        - F4, the seatbelt: none here (off macOS, until the design's S6), or its probe failing.
        - F6, the bounds: --timeout finite, positive, at most a day; --deadline (the caller's clock: council's)
          finite, ahead and within --timeout, so the waits below come out of the caller's bound; one Codex run
          per council verb. Unattended (the core's common.unattended_caller(): REGATTA_UNATTENDED, CLAUDE_UNATTENDED or
          AUTOFINISH_CALLER_UNATTENDED) only bounded: --timeout of at most 1800 s, --council RUN:VERB, at most two
          Codex runs per council run (its arms and one examine) and twelve on this Mac in any 24 h (the adapter's
          research_counts, read by mtime before any lock), the counts and the cap read from their defaults
          (HARNESS_RUNS_DIR and HARNESS_DISPATCH only beside a stand-in HARNESS_CODEX), and a free slot under
          dispatch's cap (`dispatch --cap` against dispatch-queue's busy(), runs and reservations, counted under
          dispatch's start lock, held until codex runs; dispatch-rc's count then holds the slot).
        Then codex runs under the seatbelt from the box's scratch CODEX_HOME and an allowlisted environment,
        `codex exec --json --ephemeral --skip-git-repo-check -C COPY`, its shell on, its features judged off
        turned off (hygiene), its own sandbox and approvals off; the proxy this process runs is its one door
        (chatgpt.com alone, any public host with --web) and withdraws the login at its first connection to
        chatgpt.com, before the reply (F7), the record's `credential` saying when and what was on disk at the
        first tool call; F5 is codex's own events. --review BASE runs `codex exec review --base BASE` instead
        (COPY then holds the review's two-commit repo). Every other mode stays attended only.
    harness resume REF (--prompt TEXT | --prompt-file FILE) [--fork] [--harness NAME] [--repo DIR]
                [--timeout S] [--ephemeral] [--json]
        V2: REF's next turn — the same session, or with --fork a copy under a new id (claude-code,
        codex; Orca has no fork). A live session is not continued beside itself: stop it first, or fork.
    harness stop REF [--harness NAME] [--repo DIR] [--json]
        V5: end REF now, busy or not; prints the exit report. Only what a harness started: a dispatch
        run (dispatch --end), an Orca worker (worker-stop), a harness codex run (SIGTERM, its start
        time checked). The owner's own sessions are not this verb's to end (exit 2).
    V1, V2 and V5 act on this Mac only (--host is refused): a peer's runs start through dispatch --pin.

A Codex run (--harness codex or --agent codex) is refused (exit 2)
in a public repo (oss/, the overlay's own, those wharf-runs/public-repos names): OpenAI's docs say not to use a plan login in scripts on
public or open-source repositories (contract E4; the orchestration doc's Q2, 2026-10-14). An agy run
(--harness agy) meets the same rule: Google's word on a scripted agy run under a consumer login is unsettled
(the agy-machines-port branch searched, 2026-10-17: no terms text, forum replies that conflict). A run of
any CLI but Claude Code's (Codex, an Orca worker of another agent) meets the checks a Claude run does
(docs/codex-agy-gaps-2026-10-29.md, D2-A; vendor-fence): a confidential or guarded repo only on a login
its tenant owns (the core's vendor_refusal, `account pick --provider <it>` naming the login; agy's provider
word there is `antigravity`), and the run cap (`dispatch --slots`, whose count holds Codex runs, agy runs and
Orca's non-Claude workers), so an unattended caller may start one. The agy road (agy-road, 2026-11-04):
`dispatch BRANCH --harness agy` puts an entry that needs the `agy` feature (dispatch-queue's eligibility: a builder
host's feature line, with agy installed there), and its fired run starts `harness run --harness agy` in the branch's worktree. Only an Orca Claude worker is still attended-only: no cap counts it.

--host: `here` (the default) is this Mac; PEER a Mac wharf-runs/ssh names (`<peer>:<ssh alias>`),
read over that alias; `all` both. ssh runs from the Mac whose key names the peer (bin/pickup's PEERS,
D2): from a Mac with no peer key, `all` is that Mac alone. The peer runs this same code, sent on
stdin to its `python3 -` as bin/pickup's probe is, so the two ends never disagree on a mapping; it
reads only, and reaches its own launcher checkout only for the scripts an adapter reads through
(bin/dispatch-rc).

The session record (contract section 3), one shape for every harness:

    {"harness", "account", "session_id", "machine", "cwd", "branch", "pid", "started_at",
     "updated_at", "state", "attention": null | {"kind", "message", "since"}, "model", "effort",
     "title", "attach", "native": {…}}

Times are epoch seconds (B1's adapter set it; bin/stalls.py computes with them). `native` is the one key beyond the contract: what the harness itself
said (Claude Code's own status word, a dispatch run's record path, topic and end), so a caller can
check a mapping without a second reader. States: submitted, working, input-required, idle,
completed, failed, canceled, auth-required (A2A's names, plus idle); attention kinds are
sessionpipe's: permission, question, elicitation, idle, error.

Adapters: bin/harness_adapters/<file>.py, one per harness, found by listing the folder — an orca
or codex adapter is one more file there and nothing here changes. Each module has
    NAME                  the harness name its records carry ("claude-code")
    sessions(ctx)         V4: every live session of this harness on this machine, as records
    candidates(ctx, ref)  V3: the records REF could mean, live or ended (the choice is made here,
                          the same way for every harness: pick())
    run(ctx, req)         V1: start one; returns its record (req: prompt, cwd, repo, name, branch,
                          agent, runner, model, effort, account, headless, on, topic, date)
    resume(ctx, rec, req) V2: REF's next turn (req adds fork); returns the new run's record
    stop(ctx, rec)        V5: end it; returns its last record (`last_message` added when known)
    send(ctx, rec, msg)   bin/hail's road into REC: {"verdict", "why"} (bin/hail's header; msg: frame,
                          kind, dry, idle_s) — Claude Code's inbox socket, `codex queue`, Orca's mailbox
An adapter refuses with ctx.fail(message, code): 2 for "not started, by rule", 1 for "it failed".
Claude Code's also keeps B1's list() and status(sid), which
bin/stalls.py calls directly (it ships the adapter's source to the peer itself). `ctx` carries `machine` (this Mac's name), `coding` (the
launcher checkout on this machine), `dispatch_host` (dispatch's default --on), `warn(msg)` (stderr; a line, never an exit) and `fail(msg, code)`.

Python 3.9, stdlib only; no model call, no Claude import — an adapter reads a harness's files and
runs its CLI, never its libraries.
"""
import calendar
import glob
import json
import math
import os
import re
import shlex
import socket
import subprocess
import sys
import time
import types

common = None   # the core's config reader, when an installed core can be found
CORE_MISSING = False   # True: a copy run from its file whose core did not import — the spawn gate fails closed
if "__file__" in globals():   # stdin sets __file__ too; a copy hail execs on a peer has none and keeps common None (hail puts the peer's core on sys.path for the adapters)
    sys.path.insert(1, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
    try:
        import core_path
        core_path.add()
        import common
    except ImportError:
        CORE_MISSING = True

USAGE = __doc__ or "harness status|list"


def config_lines(key):
    """`<config>/<key>`'s non-blank lines through the core's one reader, [] with no core or no such key."""
    try:
        return (common.config_lines(key) or []) if common else []
    except Exception:   # noqa: BLE001 — a reader that cannot be used is no key
        return []


def ssh_peers():
    """{peer: ssh alias} from wharf-runs/ssh (`<peer>:<alias>` per line), peers lower-cased."""
    out = {}
    for line in config_lines("wharf-runs/ssh"):
        peer, _, alias = line.partition(":")
        if peer.strip() and alias.strip():
            out[peer.strip().lower()] = alias.strip()
    return out


PEERS = ssh_peers()   # bin/pickup's, bin/account's: the ssh alias per peer Mac
SSH = os.environ.get("HARNESS_SSH") or "ssh"
FINAL = ("completed", "failed", "canceled")
# Codex never runs in these (module docstring): repo folder names the wharf-runs/public-repos key
# lists, the overlay's own checkout, and anything under ~/projects/oss/
PUBLIC = tuple(config_lines("wharf-runs/public-repos"))


def warn(msg):
    print("harness: %s" % msg, file=sys.stderr, flush=True)


class Failed(Exception):
    """An adapter's refusal or failure: the message, and the exit code (2 refused, 1 failed)."""
    def __init__(self, msg, code=1):
        Exception.__init__(self, msg)
        self.code = code


def fail(msg, code=1):
    raise Failed(msg, code)


def embedded():
    """{file name: source} when this copy runs on a peer from stdin (bundle()); else None."""
    return globals().get("HARNESS_EMBEDDED")


def machine():
    """This Mac's name as branches and repos.json spell it (`laptop`, `buildbox`): LocalHostName,
    lower-cased — helmlib.host()'s reading. HARNESS_HOST stands in for it (tests, as PICKUP_HOST)."""
    if os.environ.get("HARNESS_HOST"):
        return os.environ["HARNESS_HOST"].lower()
    if common:
        return common.host_name()
    try:
        r = subprocess.run(["/usr/sbin/scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=5)
        if r.stdout.strip():
            return re.sub(r"[^a-z0-9-]", "-", r.stdout.strip().lower()).strip("-") or "host"
    except (OSError, subprocess.TimeoutExpired):
        pass
    return re.sub(r"[^a-z0-9-]", "-", socket.gethostname().split(".")[0].lower()).strip("-") or "host"


def coding_root():
    """The checkout an adapter reads scripts from: this file's own on the machine it lives on
    (rules/engineering.md: a script anchors on its own path); on a peer, stdin has no path, so
    HARNESS_LAUNCHER, else this module in the checkout that Mac's `home` file names (its overlay
    came first until B14b, 2026-10-23: the module's files are the same code, and no shim but the
    launcher's few is left there)."""
    if embedded() is None:
        return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if os.environ.get("HARNESS_LAUNCHER"):
        return os.environ["HARNESS_LAUNCHER"]
    cfg = os.path.expanduser(os.environ.get("REGATTA_CONFIG") or "~/.config/regatta")

    def first(name):
        try:
            with open(os.path.join(cfg, name)) as f:
                return os.path.expanduser(f.readline().strip())
        except OSError:
            return ""

    home = first("home")
    return os.path.join(home, "modules", "wharf-runs") if home else os.path.expanduser("~/projects/regatta/modules/wharf-runs")


def adapter_sources():
    """{file name: source} of every adapter, in name order; underscore files are helpers, not harnesses."""
    emb = embedded()
    if emb is not None:
        return dict(sorted(emb.items()))
    d = os.path.join(os.path.dirname(os.path.abspath(__file__)), "harness_adapters")
    out = {}
    for p in sorted(glob.glob(os.path.join(d, "*.py"))):
        if not os.path.basename(p).startswith("_"):
            with open(p) as f:
                out[os.path.basename(p)] = f.read()
    return out


def adapters():
    """[module] of every adapter, loaded from its source text — the same path here and on a peer,
    where the source came over stdin. One that fails to load is named and skipped: a broken codex
    adapter must not take Claude Code's list with it."""
    mods = []
    for fname, src in adapter_sources().items():
        mod = types.ModuleType("harness_adapter_" + fname[:-3])
        mod.__file__ = fname
        try:
            exec(compile(src, fname, "exec"), mod.__dict__)
        except Exception as e:   # noqa: BLE001 — any error in one adapter is that adapter's
            warn("adapter %s did not load: %s" % (fname, e))
            continue
        if not getattr(mod, "NAME", None):
            warn("adapter %s has no NAME: skipped" % fname)
            continue
        mods.append(mod)
    return mods


def dispatch_host():
    """Where dispatch sends a run with no --on: the wharf-runs/dispatch-host key, else the first
    peer of wharf-runs/ssh (dispatch says so itself), else "" (this Mac), lower-cased."""
    line = (config_lines("wharf-runs/dispatch-host") or [""])[0]
    return (line or next(iter(PEERS), "")).lower()


class Ctx:
    def __init__(self):
        self.machine = machine()
        self.coding = coding_root()
        self.dispatch_host = dispatch_host()
        self.warn = warn
        self.fail = fail
        self.started = release_slot   # an adapter calls it once its run is under way (research mode's slot)
        # and this, right before it starts codex: the start lock taken then, never through its probes (finding 9)
        self.claim = lambda: research_room(self)
        self._mods = None

    def adapter(self, name):
        """Another harness's adapter module, or None: Orca's worker is a claude or codex session too,
        and that harness's own reader knows whether it waits on a prompt (orca.py, _inner())."""
        if self._mods is None:
            self._mods = adapters()
        return next((m for m in self._mods if m.NAME == name), None)


def chosen(mods, name):
    if not name:
        return mods
    picked = [m for m in mods if m.NAME == name]
    if not picked:
        sys.exit("harness: no adapter %r (have: %s)" % (name, ", ".join(m.NAME for m in mods) or "none"))
    return picked


# ---- hosts ---------------------------------------------------------------------------------

def peers():
    """{host: ssh alias} of the other machines. HARNESS_PEER_<HOST>=alias adds or overrides one
    (tests; bin/pickup's PICKUP_PEER_<HOST>); this machine is never its own peer."""
    p = dict(PEERS)
    p.update({k[len("HARNESS_PEER_"):].lower(): v for k, v in os.environ.items()
              if k.startswith("HARNESS_PEER_") and v})
    p.pop(machine(), None)
    return p


_MESSAGE_READER = []


def message_peers(here=None, aliases=None, target=None):
    """Message-only discovery; placement keeps peers(). TARGET is an explicit hail --host,
    allowed to reach a confidential yard or node; automatic walks reach configured placement
    aliases as main did and skip every added name that is a confidential yard or node."""
    try:
        if not _MESSAGE_READER:
            path = common.tool("message_peers.py") if common else None
            if not path:
                return peers() if aliases is None else aliases
            reader = types.ModuleType("harness_message_peers")
            with open(path) as f:
                exec(compile(f.read(), str(path), "exec"), reader.__dict__)
            _MESSAGE_READER.append(reader)
        return _MESSAGE_READER[0].message_peers(common, here or machine(), peers() if aliases is None else aliases, target)
    except Exception:   # discovery cannot cost the configured roads
        return peers() if aliases is None else aliases


def hosts_for(arg):
    """[(host, alias or None for here)] that --host names."""
    me, other = machine(), peers()
    if arg in ("here", me):
        return [(me, None)]
    if arg == "all":
        return [(me, None)] + sorted(other.items())
    if arg in other:
        return [(arg, other[arg])]
    sys.exit("harness: unknown host %r (here, all, %s)" % (arg, ", ".join(sorted(other)) or "no peers"))


def bundle():
    """This file with every adapter's source in front: what a peer's `python3 -` runs."""
    with open(os.path.abspath(__file__)) as f:
        me = f.read()
    # ascii(): the adapters on one line with non-ASCII escaped — Python 3.9 reading source from stdin
    # failed "Non-UTF-8 code" on the literal form once the adapters grew (hail's send(), 2026-10-21)
    return "HARNESS_EMBEDDED = %s\n%s" % (ascii(adapter_sources()), me)


def remote(host, alias, argv):
    """Run this code on a peer with ARGV, read-only; (parsed JSON, None) or (None, why)."""
    cmd = "python3 - " + " ".join(shlex.quote(a) for a in argv)
    try:
        r = subprocess.run([SSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", alias, cmd],
                           input=bundle(), capture_output=True, text=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, "%s did not answer: %s" % (host, e)
    for line in (r.stderr or "").splitlines():
        if line.strip():
            print("%s: %s" % (host, line), file=sys.stderr)
    try:
        return json.loads(r.stdout), None
    except ValueError:
        return None, "%s did not answer (ssh %s, exit %s)" % (host, alias, r.returncode)


# ---- V4 list -------------------------------------------------------------------------------

def local_list(mods, ctx):
    out = []
    for m in mods:
        try:
            out.extend(m.sessions(ctx))
        except Exception as e:   # noqa: BLE001 — one harness's failure is named, the others still listed
            warn("%s: list failed: %s" % (m.NAME, e))
    return out


def gather(verb, extra, args, mods):
    """(records, hosts that did not answer) over --host: here from the adapters, a peer over ssh."""
    recs, missed = [], []
    for host, alias in hosts_for(args.get("host") or "here"):
        if alias is None:
            ctx = Ctx()
            ctx.unsettled = bool(args.get("unsettled"))
            recs.extend(local_list(mods, ctx) if verb == "list" else local_candidates(mods, ctx, extra[0]))
            continue
        argv = [verb] + extra + ["--host", "here", "--json"] + (["--unsettled"] if args.get("unsettled") else [])
        if args.get("harness"):
            argv += ["--harness", args["harness"]]
        got, why = remote(host, alias, argv)
        if why:
            warn(why)
            missed.append(host)
        elif isinstance(got, list):
            recs.extend(r for r in got if isinstance(r, dict))
    return recs, missed


def ago(when):
    """'12 min' since a record's time, for the table."""
    t = epoch(when)
    if t is None:
        return "-"
    m = max(0, int((time.time() - t) // 60))
    return "%d min" % m if m < 120 else "%.1f h" % (m / 60) if m < 2880 else "%d d" % (m // 1440)


def where(cwd):
    """A cwd under any Mac's ~/projects, without it: a peer's home is not this one's."""
    return re.sub(r"^/Users/[^/]+/projects/", "", cwd or "?")


def table(recs):
    if not recs:
        print("no live sessions")
        return
    print("%-15s %-9s %-9s %-24s %-8s %s" % ("STATE", "HOST", "SESSION", "TITLE", "SINCE", "WHERE · BRANCH"))
    for r in recs:
        att = r.get("attention") or {}
        state = r.get("state") or "?"
        if att.get("kind") and att["kind"] != "idle":
            state += " (%s)" % att["kind"]
        print("%-15s %-9s %-9s %-24s %-8s %s%s" % (
            state, r.get("machine") or "?", (r.get("session_id") or "?")[:8], (r.get("title") or "-")[:24],
            ago(r.get("updated_at")), where(r.get("cwd")), " · " + r["branch"] if r.get("branch") else ""))


def order(recs):
    """Machine, then the most recently updated first."""
    return sorted(recs, key=lambda r: (r.get("machine") or "", -(epoch(r.get("updated_at")) or 0)))


def epoch(t):
    """Epoch seconds from a record's time: a number as it is, an ISO string parsed."""
    if isinstance(t, (int, float)) and not isinstance(t, bool):
        return float(t)
    try:
        return float(calendar.timegm(time.strptime((t or "")[:19], "%Y-%m-%dT%H:%M:%S")))
    except (ValueError, TypeError):
        return None


def cmd_list(args):
    mods = chosen(adapters(), args.get("harness"))
    recs, missed = gather("list", [], args, mods)
    recs = order(recs)
    if args.get("json"):
        print(json.dumps(recs, indent=1))
    else:
        table(recs)
    return 3 if missed else 0


# ---- V3 status -----------------------------------------------------------------------------

def local_candidates(mods, ctx, ref):
    out = []
    for m in mods:
        try:
            out.extend(m.candidates(ctx, ref))
        except Exception as e:   # noqa: BLE001
            warn("%s: status failed: %s" % (m.NAME, e))
    return out


def under(path, root):
    if not path or not root:
        return False
    p, r = os.path.realpath(path), os.path.realpath(root)
    return p == r or p.startswith(r + "/")


def pick(cands, ref):
    """(record, None) or (None, [the live records REF could mean]). One rule for every harness: a
    whole session id wins outright; else a live match, when there is exactly one; else the newest
    ended one. Two live sessions answering to one topic (two repos ran it) are not guessed between."""
    exact = [c for c in cands if c.get("session_id") == ref]
    if exact:
        # one session, several runs: a continued run keeps the id (V2), so the live one, else the newest
        live = [c for c in exact if c.get("state") not in FINAL]
        return (live or sorted(exact, key=lambda c: -(epoch(c.get("updated_at")) or 0)))[0], None
    seen, live = set(), []
    for c in cands:
        # a record with no session id yet (a codex run still submitted) is its own: never folded into another
        key = (c.get("machine"), c.get("session_id")) if c.get("session_id") else id(c)
        if c.get("state") not in FINAL and key not in seen:
            seen.add(key)
            live.append(c)
    if len(live) > 1:
        return None, live
    if live:
        return live[0], None
    ended = sorted(cands, key=lambda c: -(epoch(c.get("updated_at")) or 0))
    return (ended[0], None) if ended else (None, [])


def cmd_status(args):
    ref = args.get("ref")
    if not ref:
        sys.exit(USAGE)
    mods = chosen(adapters(), args.get("harness"))
    cands, missed = gather("candidates", [ref], args, mods)
    if args.get("repo"):
        cands = [c for c in cands if under(c.get("cwd"), args["repo"])
                 or under((c.get("native") or {}).get("repo"), args["repo"])]
    rec, many = pick(cands, ref)
    if rec is None and many:
        warn("%d live sessions answer to %r — say which by session id or --repo:" % (len(many), ref))
        for c in many:
            print("  %s %s %s %s" % (c.get("machine"), c.get("session_id"), c.get("state"), where(c.get("cwd"))), file=sys.stderr)
        return 2
    if rec is None:
        warn("no session or run answers to %r%s" % (ref, " (and %s did not answer)" % ", ".join(missed) if missed else ""))
        return 1
    if args.get("json"):
        print(json.dumps(rec, indent=1))
    else:
        for k in ("state", "attention", "session_id", "harness", "machine", "title", "cwd", "branch", "pid",
                  "model", "effort", "account", "started_at", "updated_at", "attach"):
            v = rec.get(k)
            if v is not None:
                print("%-11s %s" % (k, json.dumps(v) if isinstance(v, dict) else v))
        for k, v in sorted((rec.get("native") or {}).items()):
            print("%-11s %s" % ("." + k, v))
    return 0


def cmd_candidates(args):
    """The peer's half of a status across hosts: every candidate, as JSON (not a user verb)."""
    mods = chosen(adapters(), args.get("harness"))
    print(json.dumps(local_candidates(mods, Ctx(), args.get("ref") or "")))
    return 0


# ---- V1 run, V2 next turn, V5 stop: the rules every harness shares -----------------------------

def git_out(cwd, *argv, strip=True):
    try:
        r = subprocess.run(["git", "-C", cwd, "-c", "core.fsmonitor=false"] + list(argv), capture_output=True, text=True,
                           timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode:
        return None
    return r.stdout.strip() if strip else r.stdout


def repo_root(path):
    """The main checkout of the repo PATH is in (a worktree's too: its common dir's parent), or None."""
    common = git_out(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return os.path.realpath(os.path.dirname(common)) if common else None


_PUBLIC_WARNED = []


def public_repo(root):
    """True for a repo that is or may go public: Codex's plan login stays out of it (module docstring)."""
    real = os.path.realpath(root)
    if not PUBLIC and not _PUBLIC_WARNED:
        _PUBLIC_WARNED.append(1)
        warn("wharf-runs/public-repos is not set: only the overlay's checkout and projects/oss/ count as public for Codex")
    old = common.overlay_root() if common else None
    names = PUBLIC + ((os.path.basename(os.path.realpath(str(old))),) if old else ())
    return os.path.basename(real) in names or "/projects/oss/" in real + "/"


def codex_in(req, harness):
    return harness == "codex" or (req.get("agent") or "") == "codex"


def vendor_of(req, harness):
    """The provider whose CLI the run starts — `claude` for Claude Code, else the agent's own name (`codex`,
    and any agent Orca names later): what bin/account's rows call it, and what the vendor fence judges."""
    if harness == "codex":
        return "codex"
    if harness == "agy":
        return "antigravity"   # bin/account's provider word for agy's rows (agy.py's VENDOR)
    agent = req.get("agent") or ""
    if harness == "orca" or req.get("runner") == "orca":
        return agent or "claude"
    return agent if agent and agent != "claude" else "claude"


def unattended_mark():
    """`NAME=value` of the unattended marker this caller carries (the core's unattended_label), or None."""
    if common and hasattr(common, "unattended_label"):
        return common.unattended_label()
    return next(("%s=%s" % (n, os.environ[n]) for n in ("REGATTA_UNATTENDED", "CLAUDE_UNATTENDED") if os.environ.get(n)), None)


def dispatch_bin():
    """bin/dispatch beside this file (HARNESS_DISPATCH, the suites' stand-in): the one home of the run cap."""
    return os.environ.get("HARNESS_DISPATCH") or os.path.join(coding_root(), "bin", "dispatch")


def run_slots():
    """(busy, cap) from `dispatch --slots`, or None when it does not read. dispatch-rc's live count holds the
    harness's Codex runs and Orca's non-Claude workers since vendor-fence (2026-10-29), so a Codex start asks
    the same cap a dispatch does. dispatch's agy road hands the count it took under its start lock instead
    (HARNESS_SLOTS `<busy> <cap>` beside HARNESS_DISPATCHED): a `--slots` read from here would count that run's own
    queue claim, which dispatch's count leaves out, and miss force's slot over the cap (agy-road's round 1)."""
    if os.environ.get("HARNESS_DISPATCHED") and os.environ.get("HARNESS_SLOTS"):
        try:
            busy, cap = os.environ["HARNESS_SLOTS"].split()[:2]
            return int(busy), int(cap)
        except ValueError:
            return None
    try:
        r = subprocess.run([dispatch_bin(), "--slots"], capture_output=True, text=True, timeout=120)
        busy, cap = r.stdout.split()[:2]
        return int(busy), int(cap)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def vendor_fence(root, vendor):
    """Why a run of VENDOR's CLI may not open ROOT, or None: the core's vendor_refusal (a confidential or
    guarded repo's text goes only to a login its tenant owns; Claude's rule unchanged). No core, no
    judgement: refused, as a torn registry is."""
    if vendor == "claude":
        return None
    if not common or not hasattr(common, "vendor_refusal"):
        return "the regatta core is not here to judge %s's scopes: no %s run starts without it" % (root, vendor)
    return common.vendor_refusal(root, vendor, account=os.environ.get("HARNESS_ACCOUNT"))


def spawn_refusal(req, harness, where):
    """Why a start of HARNESS in WHERE may not go, by the core's spawn gate (confidential-reach S6), or None.
    A claude-code run goes by bin/dispatch, which judges it there (its run, its `--start --resume`); an Orca
    worker, a Codex run, an Orca retry or a resume's next turn start here, around dispatch, so they ask the
    gate themselves (the fourth landing review, item 6). Each hands the run a prompt no review read, so
    from inside a confidential scope into an open repo they are refused; an open caller on a branch whose
    seed carries a review needs that review to hold. The caller is this shell's directory and its session's
    own folder (common.caller_dirs), as dispatch judges it. A peer's stdin copy has no core and judges
    nothing (its caller, on the other Mac, was judged there); a copy run from its file whose core did not
    import refuses, as dispatch refuses (the fifth landing review). The tree judged is the one the run
    reads: WHERE's own HEAD when WHERE is on the branch (or none is named), so an unpushed brief or review
    there counts; else the branch's local tip, then origin's (the fifth landing review, item 12). A
    detached HEAD names no topic, so every `.review` in it counts: the stricter reading."""
    if harness in (None, "claude-code") and req.get("runner") != "orca":
        return None
    if common is None:
        return None if not CORE_MISSING else (
            "the regatta core did not load here, so whether this %s run leaves a confidential scope cannot be told "
            "(fails closed; confidential-reach S6)" % (req.get("runner") or harness))
    cur = git_out(where, "symbolic-ref", "--quiet", "--short", "HEAD") or ""
    branch = req.get("branch") or cur
    ref = "HEAD"
    if req.get("branch") and req["branch"] != cur:
        ref = next((r for r in ("refs/heads/%s" % branch, "refs/remotes/origin/%s" % branch)
                    if git_out(where, "rev-parse", "--verify", "--quiet", r)), None)
        reg, torn = common.read_registry()
        if ref is None and not torn and not common.confidential_scopes(reg=reg or {}):
            return None   # no confidential scope here: nothing leaves one, as the gate's own first answer
        if ref is None:
            # a branch this host has neither made nor fetched: no tree to judge, and judging none read no review, so
            # an open caller's spawn passed (the sixth landing review). Refused for now, in the cap's waiting words
            return ("%s is refused for now: whether it leaves a confidential scope cannot be judged here — %s is not "
                    "on this host (no local branch, none fetched from origin). End with the WAITING line — the next "
                    "step waits for a run to end and for that branch to be fetched (confidential-reach S6)"
                    % (req.get("runner") or harness, branch))
    try:
        v = common.spawn_gate(where, ref,
                              common.caller_dirs(os.getcwd(), os.environ.get("CLAUDE_CODE_SESSION_ID")),
                              topic=common.branch_topic(branch), start=True)
    except Exception as e:   # noqa: BLE001 — the gate never raises; a broken core is no answer either
        return "the spawn check could not run here (%s), so whether this run leaves a confidential scope cannot be told (fails closed; confidential-reach S6)" % e
    if v.why and v.final:
        return ("%s is refused for good, a run out of a confidential scope with no review that vouches for what it is "
                "handed — %s (confidential-reach S6)" % (req.get("runner") or harness, v.why))
    if v.why:
        # a wait fixes this one (a torn registry, a branch not fetched here): the cap's waiting words, as dispatch's
        # spawn_refuse says them (AGENTS.md's dispatch-refusal trap), so a managed run ending on it is no unrelayed ask
        return ("%s is refused for now: whether it leaves a confidential scope cannot be judged here — %s. End with the "
                "WAITING line — the next step waits for a run to end and for that to read (confidential-reach S6)"
                % (req.get("runner") or harness, v.why))
    return None


RESEARCH_TIMEOUT, RESEARCH_MAX = 1200, 1800   # seconds: research mode's default and its unattended bound
# and its bound for anyone: dispatch-rc's research_live() reads only the records written in the last
# RESEARCH_LIMIT (and a margin), so a turn may not outlive it (the second landing review's finding 11)
RESEARCH_LIMIT = 86400


def core_tool(name):
    """The core's bin/NAME, loaded as a module (jev, gate): the rules research mode asks."""
    from importlib.machinery import SourceFileLoader
    return SourceFileLoader(name, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(common.__file__))),
                                               "bin", name)).load_module()


def confidential_why(root):
    """Why a research run may not read ROOT, or None: a confidential scope's repo (or a path in one), or any
    repo while the registry cannot be read — the core's bin/jev rule (it fails closed), which wharf's council
    also asks; here too, for --repo and the copy alike, so no caller of this verb sends one to OpenAI. No
    core: refused, the rule unreadable."""
    try:
        jev = core_tool("jev")
        hit = jev.confidential(os.path.basename(root)) or jev.confidential(root)
    except Exception as e:   # noqa: BLE001 — a fence that cannot be read refuses
        return "research mode cannot read the confidential rule (%s): refused" % e
    return ("%s is a confidential scope's repo, or the registry cannot be read: no research run reads it" % root) if hit else None


def guarded_why(root, prompt_file, quote):
    """Why a research run may not send ROOT's text (or the prompt file's) to OpenAI, or None: the core's
    bin/gate vet(), the guarded-source rule — a guarded repo (jev's GUARDED) needs the owner's quote for
    OpenAI, --approved (the second landing review's finding 4: no caller of this verb skips it, as wharf's
    council does not). The prompt file is judged by its repo, else its path. A rule that cannot be read refuses."""
    try:
        gate = core_tool("gate")
        jev = gate._jev_module()
        sources = [jev.repo_of(root) or os.path.basename(root)]
        if prompt_file:
            real = os.path.realpath(prompt_file)
            sources.append(jev.repo_of(real) or real)
        row = {"site": "harness.research", "provider": "codex"}
        for src in sources:
            gate.vet(row, src, {"openai": quote} if quote else None)
    except Exception as e:   # noqa: BLE001 — gate's refusal names what it needs; anything else is no rule
        if type(e).__name__ in ("GateError", "GateOff"):
            return "%s (--approved QUOTE is the owner's yes for OpenAI)" % e
        return "research mode cannot read the guarded rule (%s): refused" % e
    return None


def core_fence():
    """The core's hooks/fence.py, loaded as a module: research mode's box rule (box_why)."""
    from importlib.machinery import SourceFileLoader
    return SourceFileLoader("fence", os.path.join(os.path.dirname(os.path.abspath(common.__file__)), "fence.py")).load_module()


def unattended():
    """`NAME=value` of what makes the caller an unattended run, or None: the core's rule (common.unattended_caller)."""
    return common.unattended_caller()


def stand_in_codex():
    """HARNESS_CODEX names a codex other than the one on PATH: a suite's stand-in. Only beside one does an
    unattended research run read its bounds from HARNESS_RUNS_DIR and HARNESS_DISPATCH (finding 9)."""
    import shutil
    cx = os.environ.get("HARNESS_CODEX")
    real = shutil.which("codex")
    if not cx or (real and os.path.realpath(cx) == os.path.realpath(real)):
        return False
    # the core's one rule (fence.is_stand_in): a `#!` script that is no node launcher. codex is a compiled binary
    # or npm's node launcher, so a copy of it at another path is the real one (round 2; round 5's code review: npm's
    # launcher read as a stand-in here alone, and moved an unattended run's bounds)
    return core_fence().is_stand_in(cx)


_RESEARCH_REQ = []   # the research request being judged: research_room counts it again under the lock
_SLOT = []   # (dispatch-queue, its start lock) an unattended research run holds from its count until codex runs


def research_room(ctx, hold=True):
    """None when this Mac's run cap has a slot for one more run, else why not: `dispatch --cap` against
    dispatch-queue's busy() — dispatch-rc's counted(live()), a running research run in it, plus the queue's
    reservations — counted under dispatch's start lock. HOLD: the lock is then kept until codex runs (the adapter
    takes it by ctx.claim() right before it starts codex and gives it back by ctx.started() once the record holds
    codex's pid, which dispatch-rc counts; cmd_run's finally too), so a dispatch start or a queue claim never
    takes the same last slot (the second landing review's finding 6) and the fleet's starts wait seconds, not the
    probes' minute or two (the fourth landing review, finding 9). Without HOLD: the count alone, the lock given
    back at once (research_guard's early refusal). Anything that cannot be read refuses: an unattended Codex run
    is the spend the cap bounds."""
    dispatch = dispatch_bin()   # the one rule for its path (round 6: a copy of it here)
    try:
        from importlib.machinery import SourceFileLoader
        q = SourceFileLoader("dispatch_queue_room", os.path.join(ctx.coding, "bin", "dispatch-queue")).load_module()
    except Exception as e:   # noqa: BLE001 — a broken install: no wait fixes it, so never the cap's waiting words
        return "dispatch-queue cannot be loaded (%s: %s): refused, no research run starts" % (type(e).__name__, e)
    try:
        r = subprocess.run([dispatch, "--cap"], capture_output=True, text=True, timeout=30)
        cap = int(r.stdout.strip().splitlines()[-1])
    except Exception as e:   # noqa: BLE001 — a cap that cannot be read is no room
        return "the run cap cannot be read (%s: %s): the next step waits for a run to end" % (type(e).__name__, e)
    lock = q.start_lock(wait=60)
    if lock is None:
        return "dispatch's start lock is held: the next step waits for a run to end"
    try:
        n = q.busy(getattr(q, "LAUNCHCTL", "launchctl"))   # the queue's own (systemd-launchctl off macOS; round 6)
    except Exception as e:   # noqa: BLE001
        q.start_unlock(lock)
        return "the run cap cannot be read (%s: %s): the next step waits for a run to end" % (type(e).__name__, e)
    if n < cap and hold and _RESEARCH_REQ:
        # the per-council and per-day counts again, now under the lock: two calls that both passed the early read
        # cannot both start (round 2)
        try:
            why = chosen(adapters(), "codex")[0].research_counts(_RESEARCH_REQ[0], True)
        except Exception as e:   # noqa: BLE001
            why = "the research runs cannot be counted (%s: %s): the next step waits for a run to end" % (type(e).__name__, e)
        if why:
            q.start_unlock(lock)
            return why
    if n >= cap:
        q.start_unlock(lock)
        # the cap's own waiting words (AGENTS.md: a new refusal reuses them)
        return "%d runs are busy, this Mac's cap is %d: the next step waits for a run to end" % (n, cap)
    if hold:
        _SLOT.append((q, lock))
    else:
        q.start_unlock(lock)
    return None


def release_slot():
    """Give dispatch's start lock back: codex runs now, and dispatch-rc's count holds its slot."""
    while _SLOT:
        q, lock = _SLOT.pop()
        q.start_unlock(lock)


def research_guard(req, harness):
    """Research mode's refusals (exit 2): judged by --repo and by the copy, the copy fenced, unattended only
    bounded."""
    if harness != "codex" or req.get("runner") or req.get("agent") not in (None, "", "codex"):
        fail("--mode research is a Codex run of its own (--harness codex, no --runner or --agent)", 2)
    if req.get("branch") or req.get("on") or req.get("account"):
        fail("--mode research takes --repo, --cwd and a prompt; --branch, --on and --account are not its", 2)
    repo, cwd = req.get("repo"), req.get("cwd")
    if not repo or not os.path.isdir(repo):
        fail("--mode research needs --repo, the home repo the copy was made from (got %r)" % repo, 2)
    root = repo_root(repo)
    if not root:
        fail("%s is in no git repository" % repo, 2)
    if public_repo(root):
        fail("Codex does not run on %s: a public repo (oss/, the overlay's, wharf-runs/public-repos) — OpenAI's docs say not "
             "to use a plan login in scripts there (contract E4)" % root, 2)
    why = confidential_why(root)
    if why:
        fail(why, 2)
    if not cwd or not os.path.isdir(cwd):
        fail("--mode research needs --cwd, the scratch copy (got %r)" % cwd, 2)
    # the copy is read back in whatever --repo says: judge it too (F1; the landing review, 2026-10-28: a
    # confidential checkout on /Volumes named as --cwd passed). Then the one rule over where it sits (F2, F4): the
    # seatbelt opens its box alone, so the box must be a council arm's (the core's fence.box_why, which says what
    # the rules it replaced read)
    why = confidential_why(os.path.realpath(cwd))
    if why:
        fail(why, 2)
    # the refusals every other Codex start meets in guard(), which research mode returns before (the council's
    # fourth landing review, finding 2): the vendor fence on the home repo and the copy (a confidential or guarded
    # repo's text goes only to a login its tenant owns), the spawn gate on the caller's own folders (a confidential
    # scope's caller hands OpenAI a prompt no review read: its brief in /private/tmp counts), and the depth cap
    pf = req.get("prompt_file")
    if pf:
        # the prompt file's text goes to OpenAI too: judged as the home and the copy are (round 1's finding)
        why = confidential_why(os.path.realpath(pf))
        if why:
            fail(why, 2)
    for judged in (root, os.path.realpath(cwd)) + ((os.path.realpath(pf),) if pf else ()):
        why = vendor_fence(judged, "codex")
        if why:
            fail(why, 2)
    why = spawn_refusal(req, "codex", repo)   # --repo as given: a worktree's branch is the one judged (round 4)
    if why:
        fail(why, 2)
    why = depth_refusal("codex")
    if why:
        fail(why, 2)
    try:
        why = core_fence().box_why(cwd)
    except Exception as e:   # noqa: BLE001 — a fence that cannot be read refuses
        why = "research mode cannot read the core's fence (%s): refused" % e
    if why:
        fail(why, 2)
    if req.get("approved") and unattended():
        fail("--approved stands for the owner's yes and the caller is unattended (%s): never passed unattended"
             % unattended(), 2)
    why = guarded_why(root, req.get("prompt_file"), req.get("approved"))
    if why:
        fail(why, 2)
    try:
        t = float(req.get("timeout") or RESEARCH_TIMEOUT)
    except ValueError:
        fail("--timeout is a number of seconds, not %r" % req.get("timeout"), 2)
    # nan and inf compare false both ways, so every bound below would pass them (finding 12)
    if not math.isfinite(t) or t <= 0 or t > RESEARCH_LIMIT:
        fail("--timeout must be a finite number of seconds, positive and at most %d (a research run is one turn)"
             % RESEARCH_LIMIT, 2)
    if req.get("deadline") is not None:
        # the caller's own clock (council's): the turn ends by it, so the start lock's and the cap's waits below
        # come out of the caller's bound, never on top of it (finding 11)
        try:
            dl = float(req["deadline"])
        except ValueError:
            fail("--deadline is an epoch time in seconds, not %r" % req["deadline"], 2)
        if not math.isfinite(dl) or dl <= time.time() or dl > time.time() + t:
            fail("--deadline must be a finite epoch time after now and within --timeout (%d s) of it" % t, 2)
        req["deadline"] = dl
    if unattended():
        # bounded: a timeout, a council run's id, the adapter's counts per council run and per day (from the
        # run records), and a free slot under the cap before codex starts (dispatch-rc counts it after)
        if not req.get("timeout") or t > RESEARCH_MAX or not re.match(r"^[^:\s]+:[^:\s]+$", req.get("council") or ""):
            fail("an unattended research run is bounded: --timeout of at most %d s and --council RUN:VERB naming the "
                 "council run (unattended: %s)" % (RESEARCH_MAX, unattended()), 2)
        moved = [v for v in ("HARNESS_RUNS_DIR", "HARNESS_DISPATCH") if os.environ.get(v)]
        if moved and not stand_in_codex():
            # the counts and the cap are read from what these name: moved, they bound nothing (finding 9)
            fail("an unattended research run reads its bounds from the defaults: %s would move them (honoured beside a "
                 "stand-in HARNESS_CODEX only)" % ", ".join(moved), 2)
    # the adapter's counts (one Codex run per council verb; unattended, its two per council run and twelve a day),
    # read before research_room takes dispatch's start lock, so the records are parsed with nothing held (finding 8)
    try:
        why = chosen(adapters(), "codex")[0].research_counts(req, bool(unattended()))
    except Exception as e:   # noqa: BLE001 — a count that cannot be read is no room
        why = "the research runs cannot be counted (%s: %s): the next step waits for a run to end" % (type(e).__name__, e)
    if why:
        fail(why, 2)
    if unattended():
        # an early count, no lock kept: the adapter claims the slot right before codex starts (finding 9)
        why = research_room(Ctx(), hold=False)
        if why:
            fail("an unattended research run needs a free slot: %s" % why, 2)
        req["unattended"] = True
        _RESEARCH_REQ[:] = [req]
    req["timeout"] = t
    req["repo"] = root
    return req


def depth_refusal(vendor):
    """Why this caller may start no VENDOR run by depth, or None: the depth cap the attended-only rule also stood
    for. A chain of runs stops at DISPATCH_MAX_DEPTH, as dispatch's does (the codex adapter's child_env counts one
    deeper). guard() and research_guard() both ask it (the council's fourth landing review, finding 2)."""
    d, top = os.environ.get("DISPATCH_DEPTH", ""), os.environ.get("DISPATCH_MAX_DEPTH", "")
    d, top = (int(d) if d.isdigit() else 0), (int(top) if top.isdigit() else 5)
    if d >= top:
        return "this caller is at depth %d of DISPATCH_MAX_DEPTH %d: no %s run starts from it" % (d, top, vendor)
    return None


def physical_ok(root):
    """Compatibility for open branches written before the `physical:` field was retired: always passes."""
    return None


def guard(req, harness):
    """The shared refusals before any start (exit 2), and req["repo"] made the main checkout. Every vendor's
    run meets the same checks a Claude run does (docs/codex-agy-gaps-2026-10-29.md, D2-A):
    for a non-Claude CLI, the vendor fence (a confidential or guarded repo only on a login
    its tenant owns) and the run cap; Codex's public-repo rule (contract E4). Research mode has its own road
    (research_guard), which asks the same vendor fence, spawn gate and depth cap first."""
    if req.get("mode") == "research":
        return research_guard(req, harness)
    if req.get("mode") not in (None, ""):
        fail("--mode is research or nothing, not %r" % req["mode"], 2)
    if req.get("approved"):
        fail("--approved is research mode's (the guarded-source rule); no other mode sends a repo's text by itself", 2)
    if req.get("web"):
        fail("--web is research mode's (its proxy)", 2)
    if req.get("deadline"):
        fail("--deadline is research mode's (its caller's clock)", 2)
    for k in ("review", "council"):
        # dropped without a word outside research mode, so the caller believed it ran a review (round 6's fourth)
        if req.get(k):
            fail("--%s is research mode's" % k, 2)
    where = req.get("cwd") or req.get("repo")
    if not where or not os.path.isdir(where):
        fail("--cwd or --repo must name a directory (got %r)" % where, 2)
    root = repo_root(where)
    if not root:
        fail("%s is in no git repository" % where, 2)
    vendor = vendor_of(req, harness)
    mark = unattended_mark()
    if mark and vendor == "claude" and (harness == "orca" or req.get("runner") == "orca"):
        # an Orca Claude worker counts against no run cap (dispatch-rc live counts only the non-Claude ones,
        # whose CLI no registry of Claude Code's sees) and no depth cap: only an attended caller starts one
        # (review 2026-10-15). stalls.py sees Orca workers since B8, and the tick's `harness retry` passes
        # here from launchd (no marker), bounded by its two retries per Task
        fail("Orca Claude workers are started attended only (%s): no run cap counts them yet" % mark, 2)
    if codex_in(req, harness) and public_repo(root):
        fail("Codex does not run in %s: a public repo (oss/, the overlay's, wharf-runs/public-repos) — OpenAI's docs say not "
             "to use a plan login in scripts there (contract E4)" % root, 2)
    if harness == "agy" and req.get("runner"):
        fail("an agy run is agy under this harness's own wrapper: no --runner (Orca's agy agent is orca-vendors S2)", 2)
    if harness == "agy" and public_repo(root):
        fail("agy does not run in %s: a public repo (oss/, the overlay's, wharf-runs/public-repos) — a plan login stays "
             "out of scripts there, as Codex's (contract E4)" % root, 2)
    why = vendor_fence(root, vendor)
    if why:
        fail(why, 2)
    # the spawn gate after the vendor fence: a refusal either would make, the fence's words first (its torn-registry
    # line is its own); every start the fence passes is judged here before a slot is counted (S6's fifth round)
    why = spawn_refusal(req, harness, where)
    if why:
        fail(why, 2)
    if vendor != "claude":
        why = depth_refusal(vendor)
        if why:
            fail(why, 2)
        # counted by the cap since vendor-fence, so an unattended caller may start one: the attended-only
        # rule this replaced said "no run cap counts them yet" (F6 of the gaps doc)
        slots = run_slots()
        if slots is None and mark:
            fail("the run cap did not read (%s --slots): an unattended %s start waits until it does" % (dispatch_bin(), vendor), 2)
        if slots is None:
            warn("the run cap did not read (%s --slots): starting, as an attended caller" % dispatch_bin())
        elif slots[0] >= slots[1]:
            fail("%d runs are busy of %d (dispatch --slots): no %s run starts; the next step waits for a run to end"
                 % (slots[0], slots[1], vendor), 2)
    req["repo"] = root
    return req


def prompt_of(args):
    if args.get("prompt-file"):
        try:
            with open(args["prompt-file"]) as f:
                return f.read()
        except OSError as e:
            sys.exit("harness: --prompt-file: %s" % e)
    return args.get("prompt")


def request(args):
    """The adapter's request from the command line; the date is today's, here, once."""
    req = {k: args.get(k) for k in ("cwd", "repo", "name", "branch", "agent", "runner", "model", "effort",
                                      "account", "ship", "on", "fork", "mode", "timeout", "deadline", "council", "review", "approved")}
    req["prompt"] = prompt_of(args)
    if args.get("prompt-file"):
        req["prompt_file"] = os.path.abspath(os.path.expanduser(args["prompt-file"]))   # research mode judges its repo
    req["headless"] = bool(args.get("headless"))
    req["web"] = bool(args.get("web"))
    req["ephemeral"] = bool(args.get("ephemeral"))   # a Codex run's --ephemeral (research mode runs it so itself)
    req["date"] = time.strftime("%Y-%m-%d")
    for k in ("cwd", "repo"):
        if req.get(k):
            req[k] = os.path.abspath(os.path.expanduser(req[k]))
    return req


def show(rec, as_json):
    if as_json:
        print(json.dumps(rec, indent=1))
        return
    for k in ("state", "attention", "session_id", "harness", "machine", "title", "cwd", "branch", "pid",
              "model", "effort", "account", "started_at", "updated_at", "attach", "stop_reason",
              "last_message", "ended_at", "files_changed"):
        v = rec.get(k)
        if v is not None and v != []:
            print("%-11s %s" % (k, json.dumps(v) if isinstance(v, (dict, list)) else v))
    for k, v in sorted((rec.get("native") or {}).items()):
        print("%-11s %s" % ("." + k, v))


def one_here(args, verb):
    """(adapter, record) REF names on this Mac, or exits as status does: 1 none, 2 ambiguous."""
    if args.get("host") not in (None, "here", machine()):
        sys.exit("harness: %s acts on this Mac only; a peer's runs start and end through dispatch --pin" % verb)
    mods = chosen(adapters(), args.get("harness"))
    ref = args.get("ref")
    if not ref:
        sys.exit(USAGE)
    ctx = Ctx()
    cands = local_candidates(mods, ctx, ref)
    if args.get("repo"):
        cands = [c for c in cands if under(c.get("cwd"), args["repo"])
                 or under((c.get("native") or {}).get("repo"), args["repo"])]
    rec, many = pick(cands, ref)
    if rec is None and many:
        warn("%d live sessions answer to %r — say which by session id or --repo" % (len(many), ref))
        sys.exit(2)
    if rec is None:
        warn("no session or run here answers to %r" % ref)
        sys.exit(1)
    mod = next((m for m in mods if m.NAME == rec.get("harness")), None)
    if mod is None or not hasattr(mod, verb):
        warn("%s has no %s" % (rec.get("harness"), verb))
        sys.exit(2)
    return mod, rec, ctx


def cmd_run(args):
    name = args.get("harness") or "claude-code"
    if args.get("host") not in (None, "here", machine()):
        sys.exit("harness: run starts on this Mac; for a peer, --on HOST with a --branch (dispatch's)")
    mod = chosen(adapters(), name)[0]
    if not hasattr(mod, "run"):
        warn("%s has no run" % name)
        return 2
    req = request(args)
    if not (req.get("prompt") or req.get("branch") or (req.get("mode") == "research" and req.get("review"))):
        sys.exit("harness: run needs --prompt, --prompt-file or --branch (research mode: or --review BASE)\n" + USAGE)
    try:
        guard(req, name)
        if req.get("mode") == "research":
            try:
                rec = mod.research(Ctx(), req)
            finally:
                release_slot()
            show(rec, args.get("json"))
            return 0 if rec.get("state") == "completed" else 1
        if req.get("runner") == "orca" and name != "orca":
            # a harness run *by* Orca is Orca's worker: its records are the orca adapter's
            req["agent"] = req.get("agent") or {"claude-code": "claude"}.get(name, name)
            mod = chosen(adapters(), "orca")[0]
        rec = mod.run(Ctx(), req)
    except Failed as e:
        warn(str(e))
        return e.code
    show(rec, args.get("json"))
    return 0


def cmd_resume(args):
    mod, rec, ctx = one_here(args, "resume")
    req = request(args)
    req["fork"] = bool(args.get("fork"))
    if not req.get("prompt"):
        sys.exit("harness: resume needs --prompt or --prompt-file (the next turn)")
    try:
        # the record's own agent: an Orca codex worker is Codex, whatever --agent this call left out
        agent = req.get("agent") or (rec.get("native") or {}).get("agent")
        guard(dict(req, agent=agent, cwd=rec.get("cwd") or (rec.get("native") or {}).get("repo")), rec.get("harness"))
        new = mod.resume(ctx, rec, req)
    except Failed as e:
        warn(str(e))
        return e.code
    show(new, args.get("json"))
    return 0


def cmd_retry(args):
    mod, rec, ctx = one_here(args, "retry")
    req = request(args)
    try:
        agent = (rec.get("native") or {}).get("agent")
        guard(dict(req, agent=agent, cwd=rec.get("cwd")), rec.get("harness"))
        new = mod.retry(ctx, rec, req)
    except Failed as e:
        warn(str(e))
        return e.code
    show(new, args.get("json"))
    return 0


def exit_report(rec):
    """The contract's exit report from a session's last record. Cost is not measured here (the plan
    readings are bin/account's, a reading of the whole login): the adapter's own `cost` where it summed
    one (a codex run's tokens over every turn.completed, F11), else null, never guessed; turns only where
    the harness counted them (a codex run's turn.completed events)."""
    native = rec.get("native") or {}
    files = None
    # never in a research run's copy: an arm writes it, its .git config included (round 2: `harness stop` ran its
    # core.fsmonitor as the owner, outside the seatbelt)
    if rec.get("cwd") and os.path.isdir(rec["cwd"]) and native.get("mode") != "research":
        st = git_out(rec["cwd"], "status", "--porcelain", strip=False)   # its first column is the status
        files = [l[3:] for l in st.splitlines() if l.strip()] if st is not None else None
    return {"session_id": rec.get("session_id"), "harness": rec.get("harness"), "state": rec.get("state"),
            "stop_reason": native.get("end_reason") or native.get("stop_reason"),
            "last_message": rec.get("last_message") or native.get("last_message"),
            "turns": native.get("turns"), "cost": native.get("cost"),
            "started_at": rec.get("started_at"), "ended_at": native.get("ended_at") or time.time(),
            "files_changed": files, "cwd": rec.get("cwd"), "branch": rec.get("branch"), "native": native}


def cmd_stop(args):
    mod, rec, ctx = one_here(args, "stop")
    try:
        last = mod.stop(ctx, rec)
    except Failed as e:
        warn(str(e))
        return e.code
    show(exit_report(last), args.get("json"))
    return 0


# ---- the command line ----------------------------------------------------------------------

VALUED = {"status": ("--host", "--harness", "--repo"), "list": ("--host", "--harness", "--repo"),
          "candidates": ("--host", "--harness", "--repo"),
          "run": ("--host", "--harness", "--repo", "--cwd", "--prompt", "--prompt-file", "--branch", "--name",
                  "--agent", "--runner", "--model", "--effort", "--account", "--ship", "--on",
                  "--mode", "--timeout", "--deadline", "--council", "--review", "--approved"),
          "resume": ("--host", "--harness", "--repo", "--prompt", "--prompt-file", "--model", "--effort", "--timeout"),
          "stop": ("--host", "--harness", "--repo"),
          "retry": ("--host", "--harness", "--repo", "--model", "--effort")}
FLAGS = {"run": ("--json", "--headless", "--web", "--ephemeral"), "resume": ("--json", "--fork", "--ephemeral"),
         "list": ("--json", "--unsettled")}


def parse(argv):
    """{"verb", "ref", and each option without its dashes}; exits with the usage on anything else."""
    if not argv:
        sys.exit(USAGE)
    a = {"verb": argv[0]}
    rest = argv[1:]
    valued, flags = VALUED.get(argv[0], ()), FLAGS.get(argv[0], ("--json",))
    i = 0
    while i < len(rest):
        x = rest[i]
        if x in flags or x == "--json":
            a[x[2:]] = True
        elif x in valued and i + 1 < len(rest):
            a[x[2:]] = rest[i + 1]
            i += 1
        elif x in ("-h", "--help"):
            print(USAGE)
            sys.exit(0)
        elif not x.startswith("-") and "ref" not in a and a["verb"] in ("status", "candidates", "resume", "stop", "retry"):
            a["ref"] = x
        else:
            sys.exit("harness: unexpected %r\n%s" % (x, USAGE))
        i += 1
    return a


def main(argv):
    a = parse(argv)
    verb = a["verb"]
    if verb == "list":
        return cmd_list(a)
    if verb == "status":
        return cmd_status(a)
    if verb == "candidates":
        return cmd_candidates(a)
    if verb == "run":
        return cmd_run(a)
    if verb == "resume":
        return cmd_resume(a)
    if verb == "stop":
        return cmd_stop(a)
    if verb == "retry":
        return cmd_retry(a)
    if verb in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    sys.exit(USAGE)


if __name__ == "__main__":
    # research mode judged as main will read the line: parse() keeps the last --mode, so `--mode x --mode research`
    # is research too (round 6: the first --mode alone was read, and that run kept the whole start environment)
    if common is not None and parse(sys.argv[1:]).get("mode") == "research":
        # research mode from nothing first: the arm reads this process's start environment through sysctl, so it
        # holds no credential (the fourth landing review, finding 1); it needs none, the arm's login is in its box.
        # Its refusal exits 2, as every research refusal does (round 5's second review: a traceback read as failed)
        _f = core_fence()
        try:
            _f.reexec_clean(sys.argv)
        except _f.FenceError as e:
            print("harness: refused: %s" % e, file=sys.stderr)
            sys.exit(2)
    sys.exit(main(sys.argv[1:]))
