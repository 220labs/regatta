#!/usr/bin/env bash
# orca-serve-agent HOST|here [--remove] [--dry-run]
#
# Runs a Mac's Orca as a headless server under a LaunchAgent in the login session, so it survives a
# reboot and can reach the keychain. Started over ssh instead, Orca says "the macOS keychain needs a
# prompt that this session cannot show ... secrets are stored unencrypted". The Orca app still opens
# on that Mac: it attaches a window to the same server (`orca open` there reported
# desktopWindowStatus "available" against a headless serve).
#
# The LaunchAgent's label is config, read on the Mac the agent is installed on (the remote side for
# HOST, this Mac for `here`), from ${REGATTA_CONFIG:-$HOME/.config/regatta}/wharf-runs/:
#   serve-label           the label, first non-blank line; org.regatta.orca-serve when absent
#   serve-label-previous  an older label to boot out and remove first, so one agent serves; none when absent
#
# Output goes to /dev/null: `orca serve` prints the pairing link, a credential, and a log would keep
# it. A paired client keeps its device key across restarts; to pair a new client, stop the agent and
# run `orca serve --pairing-address <tailscale ip>` once in a screen.
#
# On Linux (a yard-node guest, a cloud VM; `uname -s` on the side it installs on) the server is the
# systemd user unit orca-serve.service, the one the agent guest's cloud-init writes
# (node/agent.user-data.yaml), so a run there takes that unit over rather than refusing it as
# another agent: the same [Unit]/[Service]/[Install], ExecStart the guest's orca-serve-node wrapper
# where it exists, else `orca-ide serve --pairing-address <tailscale ip>` (the Linux CLI is orca-ide:
# GNOME's screen reader owns /usr/bin/orca). Linger keeps the user manager up from boot with nobody
# logged in; output goes to null for the reason above (the journal would keep the link). The serve-label
# keys are launchd's and are not read there. To pair a new client: `systemctl --user stop
# orca-serve`, run `orca-ide serve --pairing-address <tailscale ip>` once in a screen, then start the
# unit again.
#
# An always-on service is the owner's to install (an auto-mode classifier refuses it to a session as
# persistence), so this runs from the owner's own terminal. --dry-run prints the label, the plist and
# the commands and changes nothing.
#
# ASCII only: bash under a C locale over ssh read a multibyte ellipsis after a variable as part of
# the variable's name (2026-10-19).
set -euo pipefail
host=${1:?usage: orca-serve-agent HOST|here [--remove] [--dry-run]}
shift
remove=0 dry=0
for a in "$@"; do
  case "$a" in
    --remove) remove=1 ;;
    --dry-run) dry=1 ;;
    *) echo "orca-serve-agent: unknown argument $a" >&2; exit 2 ;;
  esac
done
# `here` runs it on this Mac: the laptop's yard stopped when its Orca app was closed, since a run
# needs a runtime and only the other Mac had a headless one. Quit the Orca app first: the script waits
# up to 30 s for it to go. Workers keep running: their terminals live in Orca's terminal host
# (daemon-host/.../terminal-host-*, parent launchd), not in the app.
if [ "$host" = here ]; then
  on() { REMOVE=$remove DRYRUN=$dry bash -s; }
else
  on() { ssh -o ConnectTimeout=8 "$host" "REMOVE=$remove DRYRUN=$dry" 'bash -s'; }
fi
on <<'REMOTE'
set -euo pipefail
# A C locale, so the label's character class stays ASCII: under UTF-8, bash 3.2's [A-Za-z] lets
# accented letters through, and `here` would accept a label ssh's C locale refuses.
export LC_ALL=C
cfg=${REGATTA_CONFIG:-$HOME/.config/regatta}
# The first non-blank line of a config file, trimmed, a BOM and a CR dropped: what the core's
# config_read takes. Empty when the file is absent or blank.
config_line() {
  local f=$cfg/wharf-runs/$1 l
  [ -f "$f" ] || return 0
  while IFS= read -r l || [ -n "$l" ]; do
    l=${l#$'\xef\xbb\xbf'}; l=${l%$'\r'}
    l=${l#"${l%%[![:space:]]*}"}; l=${l%"${l##*[![:space:]]}"}
    if [ -n "$l" ]; then printf '%s\n' "$l"; return 0; fi
  done < "$f"
}
# A label lands in a plist and a path: reverse-DNS characters only.
check_label() {
  case "$2" in
    ""|*[!A-Za-z0-9._-]*) echo "orca-serve-agent: $1 is not a launchd label: '$2'" >&2; exit 2 ;;
  esac
}
# ORCA_SERVE_UNAME stands in for uname in tests (`here` only: ssh carries no other variable)
if [ "${ORCA_SERVE_UNAME:-$(uname -s)}" = Linux ]; then
  unit=orca-serve.service
  units=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  file=$units/$unit
  wrapper=${ORCA_SERVE_WRAPPER:-/usr/local/bin/orca-serve-node}
  me=$(id -un)
  # systemctl --user over ssh needs the user manager's runtime dir
  if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then export XDG_RUNTIME_DIR=/run/user/$(id -u); fi
  run() {
    if [ "$DRYRUN" = 1 ]; then echo "+ $*"; else "$@" || true; fi
  }
  echo "unit: $unit"
  # Another unit that runs Orca's server under another name: the same refusal as the plists below,
  # read as orca-host's serve_unit() reads them (an ExecStart line naming orca and serve).
  for f in "$units"/*.service; do
    [ -f "$f" ] || continue
    [ "$(basename "$f")" != "$unit" ] || continue
    if grep -Eiq '^ExecStart=.*orca.*serve' "$f"; then
      echo "orca-serve-agent: $f already runs orca serve; remove it first (systemctl --user disable --now $(basename "$f"))" >&2
      exit 2
    fi
  done
  if [ "$REMOVE" = 1 ]; then
    run systemctl --user disable --now "$unit"
    run rm -f "$file"
    run systemctl --user daemon-reload
    if [ "$DRYRUN" = 1 ]; then echo "dry run: nothing changed"; else echo "removed $unit"; fi
    exit 0
  fi
  orca=$(command -v orca-ide || true)
  if [ -z "$orca" ]; then
    if [ "$DRYRUN" = 1 ]; then orca=orca-ide; else echo "no orca-ide here: orca-host setup installs the release .deb" >&2; exit 1; fi
  fi
  if [ -x "$wrapper" ]; then
    exec_start=$wrapper
    echo "serves through: $wrapper (the guest's own, its address read at each start)"
  else
    ip=$(tailscale ip -4 2>/dev/null | head -1 || true)
    if [ -z "$ip" ]; then
      if [ "$DRYRUN" = 1 ]; then ip='<tailscale ip>'; else echo "no Tailscale address here: tailscale up first" >&2; exit 1; fi
    fi
    exec_start="$orca serve --pairing-address $ip"
  fi
  unit_text() {
    cat <<EOF
[Unit]
Description=Orca headless server (orca-ide serve)
After=network-online.target

[Service]
ExecStart=$exec_start
Restart=on-failure
RestartSec=30
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
EOF
  }
  linger=$(loginctl show-user "$me" --property=Linger --value 2>/dev/null || true)
  if [ "$DRYRUN" = 1 ]; then
    echo "unit file: $file"
    unit_text
    if [ "$linger" != yes ]; then echo "+ loginctl enable-linger $me"; fi
    echo "+ screen -S orca-serve -X quit"
    echo "+ pkill -f 'orca-ide serve'"
    echo "+ (wait up to 30 s for it to go)"
    echo "+ systemctl --user daemon-reload"
    echo "+ systemctl --user enable $unit"
    echo "+ systemctl --user restart $unit"
    echo "+ (wait up to 60 s for: $orca status --json to say ready)"
    echo "dry run: nothing changed"
    exit 0
  fi
  if [ "$linger" != yes ]; then
    loginctl enable-linger "$me" 2>/dev/null || sudo -n loginctl enable-linger "$me" || {
      echo "linger is off and could not be turned on: sudo loginctl enable-linger $me" >&2; exit 1; }
  fi
  # The user manager's bus must answer before anything is stopped: turning linger on starts it,
  # and /run/user/<uid> appears with it, so a shell with no session finds it only now.
  if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    for i in $(seq 1 10); do [ -d "/run/user/$(id -u)" ] && break; sleep 1; done
    [ -d "/run/user/$(id -u)" ] && export XDG_RUNTIME_DIR=/run/user/$(id -u)
  fi
  systemctl --user show-environment >/dev/null 2>&1 || {
    echo "the user's systemd does not answer (XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}); nothing stopped" >&2; exit 1; }
  mkdir -p "$units"
  unit_text > "$file.new"
  mv "$file.new" "$file"
  echo "stopping the Orca running now (up to 30 s)..."
  screen -S orca-serve -X quit >/dev/null 2>&1 || true
  pkill -f 'orca-ide serve' 2>/dev/null || true
  for i in $(seq 1 15); do pgrep -f 'orca-ide serve' >/dev/null || break; sleep 2; done
  echo "starting ${unit}..."
  systemctl --user daemon-reload
  systemctl --user enable "$unit"
  systemctl --user restart "$unit"
  echo "waiting for orca serve to be ready (up to 60 s)..."
  for i in $(seq 1 30); do
    # captured, never piped to grep -q: under pipefail a status write after grep quits fails the test
    st=$(env -u ELECTRON_RUN_AS_NODE "$orca" status --json 2>/dev/null || true)
    if printf '%s' "$st" | grep -Eq '"state": ?"ready"'; then
      echo "orca serve: ready under $unit"; exit 0
    fi
    sleep 2
  done
  echo "orca serve did not reach ready in 60 s: systemctl --user status $unit" >&2; exit 1
fi
label=$(config_line serve-label)
[ -n "$label" ] || label=org.regatta.orca-serve
check_label serve-label "$label"
old=$(config_line serve-label-previous)
if [ -n "$old" ]; then check_label serve-label-previous "$old"; fi
[ "$old" != "$label" ] || old=
plist=$HOME/Library/LaunchAgents/$label.plist
orca=/Applications/Orca.app/Contents/Resources/bin/orca
uid=$(id -u)
# the removals go through run, so --dry-run shows them as a real run executes them; the install's
# own steps are listed in the dry-run block below, beside the real ones
run() {
  if [ "$DRYRUN" = 1 ]; then echo "+ $*"; else "$@" || true; fi
}
echo "label: $label"
if [ -n "$old" ]; then echo "previous label: $old"; fi
# the first name it was written under: taken back so one agent serves
remove_old() {
  if [ -n "$old" ]; then
    run launchctl bootout "gui/$uid/$old" 2>/dev/null
    run rm -f "$HOME/Library/LaunchAgents/$old.plist"
  fi
}
# Another LaunchAgent that runs `orca serve` under a label this run does not know (a Mac whose
# serve-label was never written, or renamed without serve-label-previous): installing beside it
# leaves two always-on serves fighting for one Orca, and the ready check passes on the old one.
# Refused before anything changes; orca-host's serve_agent() reads plists the same way.
for f in "$HOME"/Library/LaunchAgents/*.plist; do
  [ -f "$f" ] || continue
  n=$(basename "$f" .plist)
  [ "$n" != "$label" ] && [ "$n" != "$old" ] || continue
  if grep -qi 'orca' "$f" && grep -q '<string>serve</string>' "$f"; then
    echo "orca-serve-agent: $f already runs orca serve; name $n in wharf-runs/serve-label or serve-label-previous" >&2
    exit 2
  fi
done
if [ "$REMOVE" = 1 ]; then
  remove_old
  run launchctl bootout "gui/$uid/$label" 2>/dev/null
  run rm -f "$plist"
  if [ "$DRYRUN" = 1 ]; then echo "dry run: nothing changed"; else echo "removed $label; open the Orca app to run it as before"; fi
  exit 0
fi
ip=$(/Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4 2>/dev/null | head -1 || true)
[ -n "$ip" ] || ip=$(tailscale ip -4 2>/dev/null | head -1 || true)
if [ -z "$ip" ]; then
  if [ "$DRYRUN" = 1 ]; then ip='<tailscale ip>'; else echo "no Tailscale address on this Mac" >&2; exit 1; fi
fi
plist_text() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>$orca</string><string>serve</string><string>--supervise</string>
    <string>--pairing-address</string><string>$ip</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
EOF
}
if [ "$DRYRUN" = 1 ]; then
  echo "plist: $plist"
  plist_text
  echo "+ plutil -lint $plist"
  remove_old
  echo "+ screen -S orca-serve -X quit"
  echo "+ pkill -f 'Orca.app/Contents/MacOS/Orca .*serve'"
  echo "+ (wait up to 30 s for the Orca app to quit)"
  run launchctl bootout "gui/$uid/$label" 2>/dev/null
  run launchctl bootstrap "gui/$uid" "$plist"
  echo "+ (wait up to 60 s for: $orca status --json to say ready)"
  echo "dry run: nothing changed"
  exit 0
fi
mkdir -p "$HOME/Library/LaunchAgents"
plist_text > "$plist.new"
plutil -lint "$plist.new" >/dev/null
mv "$plist.new" "$plist"
# the old agent stops only once the new plist is known good: a failed step above leaves it serving
remove_old
echo "stopping the Orca running now (up to 30 s)..."
screen -S orca-serve -X quit >/dev/null 2>&1 || true
pkill -f "Orca.app/Contents/MacOS/Orca .*serve" 2>/dev/null || true
for i in $(seq 1 15); do pgrep -x Orca >/dev/null || break; sleep 2; done
echo "starting ${label}..."
launchctl bootout "gui/$uid/$label" 2>/dev/null || true
# a bootstrap while the old job still exits fails "5: Input/output error": wait up to 10 s for it to go
for i in $(seq 1 10); do launchctl print "gui/$uid/$label" >/dev/null 2>&1 || break; sleep 1; done
launchctl bootstrap "gui/$uid" "$plist"
echo "waiting for orca serve to be ready (up to 60 s)..."
for i in $(seq 1 30); do
  # captured, never piped to grep -q: under pipefail a status write after grep quits fails the test
  st=$(env -u ELECTRON_RUN_AS_NODE "$orca" status --json 2>/dev/null || true)
  if printf '%s' "$st" | grep -Eq '"state": ?"ready"'; then
    echo "orca serve: ready under $label, advertised on $ip"; exit 0
  fi
  sleep 2
done
echo "orca serve did not reach ready in 60 s: launchctl print gui/$uid/$label" >&2; exit 1
REMOTE
