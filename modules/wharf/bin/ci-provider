RUNS_ON_VAR = "CI_RUNS_ON"   # the variable form's name when none is given (regatta#53's)
# the self-hosted kind's first step, before the checkout, at the steps' indent (render_workflow). What a job on
# the runner Mac found it must not do, moving eight repos there by hand (2026-10-21): GIT_CONFIG_GLOBAL
# and not a scratch HOME, which hung headless Chrome and hid the user site's packages on macOS,
