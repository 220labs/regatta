GUARD_STEP = """\
# The runner runs as its login, with that login's real HOME (a scratch HOME on macOS hangs
# headless Chrome and hides the user site's Python packages), so a job keeps out of what is
# that login's own: `git config --global` writes this job's file (this step); `npm install -g`
# takes --prefix "$RUNNER_TEMP/npm", with "$RUNNER_TEMP/npm/bin" added to $GITHUB_PATH (the
# global prefix is first on the login's PATH, in front of its own tools); no sudo, no apt-get.
# The runner takes one job at a time: a job that waits on another job's effect deadlocks if it
# takes the runner first.
- name: git config --global in this job's own file
  run: echo "GIT_CONFIG_GLOBAL=$RUNNER_TEMP/gitconfig" >> "$GITHUB_ENV"
"""
GUARD_RUN = GUARD_STEP.splitlines()[-1].split("run: ", 1)[1]
RUNNER_URL = ("https://github.com/actions/runner/releases/download/v2.338.0/"
              "actions-runner-osx-arm64-2.338.0.tar.gz")
# read 2026-10-19 from the release's asset (size, digest) and its notes' "BEGIN SHA osx-arm64"
RUNNER_SIZE = 128562863
