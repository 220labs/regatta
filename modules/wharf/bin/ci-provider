#!/usr/bin/env python3
"""ci-provider — which CI runs a repo's check: GitHub Actions on ubuntu, GitHub Actions on a
self-hosted runner on a Mac of one's own (the runner Mac), or CircleCI, switched in one command.

    REPO: any path in the checkout, `.` by default; every form works on its top level.

    ci-provider [REPO]                        where REPO stands: provider, files, main's required
                                              check on GitHub, which CI reported on HEAD and main,
                                              the repo's self-hosted runners
    ci-provider REPO --to actions|self-hosted|circleci [--check CMD] [--context NAME] [--force] [--dry-run]
                                              rewrite the checkout's files for that provider
                                              (--force: drop what the old CI file held beyond the
                                              template and its command)
    ci-provider REPO --to self-hosted --runs-on-var NAME | --twin
                                              the same, runs-on read from a repository variable
                                              (--twin: CI_RUNS_ON, for a check.yml a public twin
                                              publishes)
    ci-provider REPO --protect [--force] [--dry-run]
                                              set GitHub main's required check to the provider's
                                              (live: the one step that changes GitHub)
    ci-provider REPO --compose                regenerate .circleci/config.yml from its parts
    ci-provider REPO --runner install|status|remove [--host ALIAS] [--labels L,…] [--name NAME]
                     [--instance N] [--dry-run]
                                              the repo's runner on the runner Mac, over ssh, or on a
                                              Linux host (--labels self-hosted,Linux --name NAME: the
                                              Linux share's suites, below the runner's notes)
                                              (live: install downloads and registers it, and sets
                                              the runs-on variable unless other online runners
                                              serve it; remove deregisters it; status only reads);
                                              --host, --labels and --name for another runner Mac
                                              than the keys', --instance N for a further runner of
                                              the repo on one Mac
    ci-provider REPO --runner caps [--name NAME] [--dry-run]
                                              each runner's custom labels set to its capabilities
                                              in wharf/ci-runner-caps.json (live: one PUT per runner
                                              that differs; --name: that runner only); refused when
                                              a runs-on, variable or literal, would be left with
                                              no runner, or --name names no runner
    ci-provider REPO --pick [--apply] [--usage FILE] [--dry-run]
                                              the lane the check takes, by lighthouse's lanes,
                                              budgets and queue (live with --apply: the runs-on
                                              variable, one PATCH logged with its undo, on the ops
                                              host only); "The pick", below the runner's notes

The owner, 2026-10-18: "I need to be able to easily switch repos between circle ci and raw GH
actions - add that capability (will later move to Regatta)"; moved into wharf 2026-10-20 with
its templates (templates/ci/circleci-check.yml here; templates/code/.github/workflows/check.yml
and main-protection.json, B5's). bin/repos loads this file, its sibling, for provider_from, the
one definition of which CI a repo is on (its ci_state reads origin/main with it).

The self-hosted kind's name is `self-hosted` (SELF, below). The config dir's `wharf/ci-runner-kind`
lists older names of it: an installer whose repos' ci.json still name the kind otherwise (after
the first Mac it ran on) writes them there, and ci.json and --to read each as `self-hosted`, which is
what --to writes back (2026-10-31). Nothing else here names a machine. The runner Mac's
private values come from the regatta config dir (`$REGATTA_CONFIG`, else .config/regatta in the
home folder), one file each, which the overlay writes (wharf's README, "Private values"), read
once per command:
  wharf/ci-runner-ssh      the ssh alias of the runner Mac, logged in as the runner's user (never
                           starting with `-`: ssh would read it as an option)
  wharf/ci-runner-labels   the runner's labels, one per line: self-hosted, macOS and at least one of
                           the Mac's own; the first of its own is the runner's name. A runner the
                           capabilities file lists takes its automatic labels from it too, and
                           keeps an own label only while a runs-on still asks for it. No check.yml
                           is written from it any more
  wharf/ci-runner-user     that user's name, for the trust warning only (absent: left unnamed)
  wharf/ci-runner-kind     older names of the self-hosted kind, one per line, which ci.json and --to
                           read as `self-hosted` (absent: none)
  wharf/ci-runner-caps.json  {runner name: [capability, …]}: what each runner can do, which --runner
                           caps makes its custom labels and --runner install registers it with,
                           beside any own label a runs-on still asks for (absent: caps refuses,
                           install takes the labels key's)
Without the first two, --to self-hosted and --runner refuse and name the file to write; every other
verb, status among them, reads the labels a repo's own check.yml or variable asks for instead.

Which runs-on is this tool's (review 2026-10-21, 3-5): the two forms it writes, the variable form
below exactly, or a literal of `self-hosted`, an OS and the labels ci.json's `needs` lists; and one
it wrote before 2026-10-31, the labels key's labels literally, which a re-run replaces. Any other
(`[self-hosted, linux, gpu]`, a `vars.X` the repo reads its own way) is a hand edit: a switch holds it
like any other, --force drops it, and --runner never reads or writes its variable. Without ci.json a
check.yml is self-hosted when its runs-on is the variable form, a literal of `self-hosted`, `macOS`
and no label of a runner's own (`[self-hosted, macOS]`), or a literal naming one of the labels key's
own labels (`[self-hosted, macOS, <label>]`, `[macOS, <label>]`, the label alone); on a Mac without
the key, only the first two say so.

What a provider is, all of it in the repo except the last line:
  .github/ci.json                     {"provider": "actions"|"self-hosted"|"circleci", "check": "<command>"},
                                      a record of the command; the live CI file wins over it. Only
                                      the command crosses a switch: a check.yml or part holding more
                                      than its template (setup steps, env) is refused without --force;
                                      optional "context": main's required check name when it is
                                      not the provider's default (a CircleCI GitHub App project
                                      reports through the Checks API under a name read back on its
                                      first run, 2026-10-18). Dropped on a switch: a
                                      name belongs to one provider; `--to … --context NAME` sets it;
                                      "needs": what the check needs from a runner (the lanes' words,
                                      or capabilities), hand-written, which crosses a switch;
                                      "replaces": the names a later --context or switch replaced,
                                      which --protect swaps out of main's required checks too;
                                      only this branch's: the list main carries is spent
  actions:  .github/workflows/check.yml from templates/code/.github/workflows/check.yml
  self-hosted:  the same file with its runs-on line swapped: Actions on the runner Mac, always on
            (the owner, 2026-10-19: "Add this as a 3rd kind of CI workflow, I want this
            standardized"). For a check that reads a macOS tool (plutil, Apple cc, qlmanage):
            hosted macOS bills at 10x and CircleCI's Free macOS at 200 credits a minute, while a
            self-hosted runner bills no minutes. Only the runs-on line and a first step differ
            (below), so the draft skip and the concurrency block are the template's own. The line takes one of two forms:
              literal   `runs-on: [self-hosted, macOS, <the capabilities it needs>]`, from ci.json's
                        `needs`, for a repo that is private only: what the job needs from a runner
                        Mac, never which one, so `needs` may name capabilities beside the lanes'
                        words (wharf's README, "Capabilities"). A `needs` naming another OS is
                        refused here: it takes the variable form, where a lane routes it
              variable  `runs-on: ${{ fromJSON(vars.NAME || '"ubuntu-latest"') }}`: the labels
                        sit in the repository variable NAME (a JSON list), which --runner install
                        sets and status reads, so the file names no machine (the template's header
                        names none either; wharf's suite scans both where a private word list is
                        installed). For a repo with a public twin, whose check.yml is published:
                        --runs-on-var NAME or --twin, or by itself (CI_RUNS_ON) when
                        .helloworld/allowlist.txt lists check.yml (even over a literal: published,
                        it would name what the runner carries), or the repo carries .helloworld/
                        and check.yml is not on the runner Mac yet. Otherwise a re-run keeps the
                        file's form, literal or variable, unless --runs-on-var is given. Where the
                        variable is unset (the twin, a fork) the job runs on ubuntu-latest, and
                        still reports `check`: set it (--runner install) before that green counts.
                        One shape for every repo: another (`github.event.repository.private &&
                        …`) is a hand edit here, bar the split below.
              split     `${{ fromJSON(github.event_name != 'pull_request' && vars.NAME_FULL ||
                        vars.NAME || '"ubuntu-latest"') }}`: the variable form, where a push, the
                        nightly run and a hand start take NAME_FULL's labels when it is set (a repo
                        whose pull requests run only a share of the line, so a slower runner Mac
                        takes those alone; regatta since 2026-10-27). Written by hand; this tool
                        reads it as the variable form, keeps it on a re-run, status reads NAME_FULL
                        too, and nothing here sets NAME_FULL.
            The self-hosted file also takes a first step, `GIT_CONFIG_GLOBAL=$RUNNER_TEMP/gitconfig`
            into $GITHUB_ENV (GUARD_STEP): the job runs as the runner's login with its real HOME,
            so a `git config --global` would rewrite that login's identity. Not a scratch HOME:
            on macOS that hung headless Chrome and hid the user site's packages (eight repos moved
            by hand, 2026-10-21). A file written before the step is still the tool's own; a re-run
            adds it, and status warns without it. --to self-hosted refuses a check command that runs
            `npm install -g` (the global prefix is first on the login's PATH), sudo or unguarded
            apt-get (--force writes it, still said), and says each such line, by file and line, in
            the scripts the command names (one level) and, with `git config --global` where no
            GIT_CONFIG_GLOBAL guards it, in the other workflows on the runner Mac; status says
            them too (host_writes: a line read as text, not a shell parse). The step hides the
            login's whole ~/.gitconfig from the job, its identity, init.defaultBranch and credential
            helper too: a check that needs one sets it in the job.
  circleci: .circleci/parts/check.yml from templates/ci/circleci-check.yml, composed into
            .circleci/config.yml (CircleCI reads one file; a repo's own jobs, e.g. an untrusted
            harness, stay in their own part and survive every switch)
  .github/main-protection.json        required_status_checks.contexts: `check` (Actions' job
                                      name, on ubuntu or the runner Mac alike: a switch between
                                      those two needs no --protect and keeps ci.json's `context`)
                                      or `ci/circleci: check` (what CircleCI's GitHub
                                      integration posts: `ci/circleci: <job>`, read back on a
                                      CircleCI project 2026-10-18)
  GitHub main's protection            --protect PATCHes required_status_checks only; never the
                                      rest of the protection (a PUT would replace all of it). It
                                      swaps the old provider's check for the new one and keeps every
                                      other required check; main-protection.json likewise. As
                                      `checks` when GitHub (or the file) has them, so a kept
                                      check keeps its app_id pin; the new one is sent without,
                                      and GitHub pins the app that reported it

The order a switch takes: --to on a claude/* branch, commit and push; the new CI reports green on
that head; then --protect, which refuses a check that has never reported (a required check that
never reports blocks every PR; an admin bypass would be the only way in). It runs before the
switching PR lands, so every other open PR needs a rebase onto it to report the new check, and an
abandoned switch PR leaves main requiring a check main cannot produce: --protect prints the PATCH
that undoes it.

To actions or self-hosted with --protect to follow, the PR leaves draft before it: check.yml runs on no
claude/* push and skips a draft PR's head (a skipped `check`, which GitHub counts as passed and
--protect does not), so `gh pr ready` is what makes `check` report on that head. Ready is not
landed: main still requires the old CI's check, whose file the head no longer has, so the merge
waits for --protect (review 2026-10-19, 2). Not workflow_dispatch: GitHub runs it only for a
workflow file already on the default branch (docs, "Events that trigger workflows", read
2026-10-19), and a switch to Actions has not landed check.yml there yet.

Not handled: a repo with .github/workflows/automerge.yml. Automerge runs on Actions and waits for
a check.yml run, so under CircleCI it would never arm; --to circleci refuses it rather than leave
a broken gate (bin/repos --github also checks automerge repos against check.yml). CircleCI must
follow the project once (Projects > Set Up, config from the branch) before anything reports.

self-hosted, and what it does not cover:
  - the trust boundary: the runner runs as the runner's user, which holds whatever that login
    holds (on the owner's Mac: `gh` logged in as a machine account with write on every repo, an
    ssh key, git credentials and Claude logins; the owner's D5-A accepts it). A job runs the
    workflow file of the PR's own head, so ANY write collaborator on the repo can run code on
    the runner Mac as that user by pushing a branch and opening a PR. "Private repos only" below
    stops forks, and nothing else. --to self-hosted and --runner install print the repo's write
    collaborators (`gh api repos/O/R/collaborators`, push or above) as a warning; they refuse
    nothing for them.
  - a public repo is refused, by --to self-hosted and by --runner install (`gh api repos/O/R --jq
    .private`), and so is a private one set to run fork PRs' workflows (`gh api repos/O/R/actions/
    permissions/fork-pr-workflows-private-repos`, run_workflows_from_fork_pull_requests); either
    one unread is refused too: a fork's pull request would run its own code on the runner Mac.
    The fork-PR setting and the runner list are an admin's reads: the gh login first, then
    WHARF_READ_TOKEN's token where it is set (gh_read; lighthouse's `ops pick` passes the desk's).
    `ci-provider REPO` warns if a self-hosted repo has gone public, or let fork PRs run, since.
    A private repo's public twin is another repo: it has no variable, so its check runs hosted.
  - automerge.yml stays on ubuntu-latest, hosted, so no runner-Mac job runs with an
    authenticated `gh` it does not need (its script calls `gh`; the runner's user has one).
    It runs on every PR event (opened, push, label, ready), each billed as a hosted Linux minute:
    the one Actions cost left. --to self-hosted says so when the repo has it. A repo whose own
    automerge.yml reads <var>_AUTOMERGE, then <var> (regatta's, curl and jq for `gh`), runs it
    where that names: unset, in the check's queue; status says which.
  - with no online runner carrying every label the job waits in the queue (GitHub drops it
    after 24 h) and `check` never reports: provision the runner, then land the switch.
  - the runner: one per repo on each runner Mac (more with --instance), never org-wide (an owner that is a GitHub User account has no org
    runners), in ~/actions-runners/<owner>/<repo> under the runner's user, named after the
    labels key's first label of its own, labels self-hosted and macOS (both automatic) and its
    own; actions/runner v2.338.0, osx-arm64 or osx-x64 as the Mac's `uname -m` says (x64 since
    2026-10-27), each pinned by URL, size and SHA-256 (the release's asset digest, read 2026-10-19
    and 2026-10-27), downloaded once into ~/actions-runners/.dist. A fleet: each further runner Mac
    by --host, --name and --labels, all of them under one shared label the runs-on variable asks
    for; --instance N a further runner of the same repo on one Mac, in <repo>-N, named <name>-N. The service is the runner's own svc.sh: a LaunchAgent of
    the runner user's, which launchd runs only while that user has a login session on the Mac.
    Nested, owner then repo, since 2026-10-19: the flat <owner>-<repo> it replaced let `a-b/c`
    and `a/b-c` share one directory. The runners installed before that stay where they are:
    every verb uses the flat directory while its .runner names this repo's URL (config.sh writes
    it as gitHubUrl), the nested one otherwise.
  - a Linux host (linux-runner, 2026-11-04; the owner: "can the node help with linux checks as well?"): a
    runner whose labels name Linux (--labels self-hosted,Linux, with --name, as a Linux host has no label of
    its own to route on) is installed the same way, over ssh, with the release's linux-x64 or linux-arm64
    build (pinned by URL, size and SHA-256, the asset digests read 2026-11-04) as the host's `uname -m` says;
    the probe's `uname -s` must say Linux (and a Mac's must not), or nothing is minted. It runs in a rootless
    container (D1-C, the owner, 2026-11-04: "container", over svc.sh's systemd unit as the host's login, which can
    become root there: any write collaborator's pull request could): Podman, as the login, with no sudo on any road.
    The probe names what the host lacks for it (podman; a user namespace, which the profile for /usr/bin/podman in
    Ubuntu's apparmor package allows; subordinate uid and gid ranges with uidmap's newuidmap and newgidmap;
    slirp4netns, podman 4.9's rootless network; linger; the systemd user instance), each the owner's step with sudo,
    and refuses before a token. The install builds the image localhost/ci-runner-<name>
    first, so a failed build registers nothing: the pinned ubuntu:24.04 (hosted ubuntu-latest is newer), the suites' packages, no
    sudo, the verified tarball unpacked for an unprivileged user (RUNNER_CONTAINERFILE). config.sh runs in a
    container of it, the token on its stdin, into the volume ci-runner-<name>-state (no self-update: the image holds
    the pin), whose .runner is copied out to the runner directory for the probe. The service is a quadlet user unit,
    ci-runner-<name>.service: each container takes one job (the listener's `--once`, run by the entry) and exits, and systemd starts a fresh one
    from the image, so no job's leftovers reach the next; the state volume read-only, and no host mount, socket,
    credential, capability or new privilege. The residual risks: a kernel escape; the job's read of the runner's own
    credential, as on any runner; the network, which reaches what the host reaches, though not its loopback: the
    host's own listeners on its other addresses (sshd, tailscale's), the tailnet's peers, and on a cloud VM its
    link-local metadata service, which hands out the VM's managed-identity tokens where it has one; and the
    login's disk, which a job's layer may fill. The runner never updates itself (--disableupdate: the image holds the
    pin), and GitHub stops queuing jobs to a runner 30 days after a newer release (its docs, read 2026-11-04; v2.338.2
    came out 2026-10-26): bump RUNNER_LINUX_* and reinstall within that. A user unit sits in the login's app.slice beside the sessions' units (read on a
    node, 2026-11-04: dispatched sessions run as user units there, the cpu controller delegated), at CPUWeight=20 to
    their 100 and Nice=10: a weight counts among siblings only. A rebuilt image or rewritten unit serves the job after
    the next (the container waiting holds the old one), never by a restart that would cut a job. One runner a host,
    so one job at a time: --instance 2 is refused, and so is a host where another repo's runner or unit is
    configured. It registers by its capabilities alone, so the capabilities file must list it (the
    ci-capabilities rule: never a host's name, here not even beside them). It serves check-linux.yml's
    `suite` jobs, never check.yml: install and remove route and name no runs-on variable, which the pick
    sets for the share (CI_LINUX_RUNS_ON, below). A runner deregistered or asleep is the pick's to judge.
  - the variable form: --runner install sets the repository variable to the runner's labels (its
    capabilities in wharf/ci-runner-caps.json, else the labels key's, or --labels') once the runner is online, unless the variable already asks for
    labels it carries or another registered runner, online or asleep, carries the variable's (a
    fleet: never narrowed, never re-routed to the newcomer; it prints the calls that would) (`gh api` POST repos/O/R/actions/variables, or PATCH
    …/variables/NAME when it holds another value: REST "Actions variables", read 2026-10-20),
    reads it back and prints the call that undoes it; only GitHub's 404 reads as unset, any other
    failure refuses the write. --runner remove leaves it, says what it holds, read back, and prints
    the DELETE that would send the check back to ubuntu-latest. Where check.yml reads no variable
    while ci.json says self-hosted or the repo has a public twin, install says it set none, and why.
  - the registration and remove tokens: `gh api -X POST repos/O/R/actions/runners/
    registration-token` (`remove-token`), an hour's life, minted only once the runner Mac reports
    the runner not configured (install; on Linux also a registration GitHub's full list no longer names) or
    configured (remove); held in memory, written to ssh's
    stdin and handed to config.sh as ACTIONS_RUNNER_INPUT_TOKEN (the runner reads and unsets its
    ACTIONS_RUNNER_INPUT_* variables: src/Runner.Listener/CommandSettings.cs at v2.338.0); never
    in an argv, a file, a log or this tool's output. It does sit in config.sh's environment for
    that run, which any process of the runner's user can read (`ps -E`), until config.sh exits.
  - a check.yml beyond the template (a matrix, setup steps) is refused like any other: the runner
    Mac is one macOS, so a matrix over macOS images becomes one job. --force writes the template's
    job (its steps as one --check command), and a matrix's `check (<value>)` names leave main's
    required checks on every switch, as no file written here can report them: that switch needs
    --protect, and says so; a ci.json `context` that is such a name is not carried into the
    one-job file. --protect and status drop them only when the check.yml on disk has no
    `strategy:`/`matrix:`: a hand-written matrix still reports them.

The pick (lighthouse-ops S1, docs/lighthouse-ops-broker-2026-10-26.md; the owner's D2-A: picked, every
15 minutes on every eligible repo): which lane a repo's check takes, the required check staying `check`.
A lane is a row of the config dir's `lighthouse/ci-lanes.json` (`name`, `provider` actions|circleci, `projects` on a CircleCI one,
`runs_on` a hosted image or a label list, `runs` some of macos/linux/public, `account` for a hosted
lane); a repo is eligible for one that runs all its ci.json `needs` (absent: macos), and `public`
too when GitHub says the repo is; a capability in `needs` is met only by a self-hosted lane whose
label list names it. In order: a self-hosted lane whose queued p50 (the sampler's
ops.jsonl row) is under `lighthouse/ci-queue-max` or unmeasured; a hosted lane for a public repo;
the hosted lane whose account has the most month left above its reserve in `lighthouse/ci-budgets.json`;
else the self-hosted lane with the shortest queue. A label list is a self-hosted lane, a hosted one
is one image's name. A self-hosted lane needs the trust refusals above passed, --to self-hosted's
guard step and host-write refusals, and an online runner with its labels; the repo's current lane
is skipped while a check created since the pick's last flip of it sits queued past 30 minutes.
No lane, and the current one refused (trust, money, no runner): exit 3, for the desk to card. Usage is the desk's file (`lighthouse ops usage --write`, the log dir's
ci-usage.json): the owner's billing token is read there, in the desk's own job; this tool sees it
only as WHARF_READ_TOKEN, for the two admin reads (gh_read), never for usage, so
without fresh usage every hosted lane of a private repo is over budget. --apply writes only from the desk's job (refused under a Claude Code session), on
`lighthouse/ops-host`, only to a check.yml in the variable form (another is reported, never
written), only when the pick changed, and logs the old value and the call that restores it to
the log dir's ci-pick.jsonl. A CircleCI lane is never picked for `check`: a variable moves no check
there. It is the Linux share's switch instead, where check.yml reads CI_LINUX_ELSEWHERE: with no lane
under budget (each read as above, unread never chosen) the share goes off (the runner takes the whole
line), as it does when it may stand on a lane that is out and a refused move or an unread variable keeps
it there; with one, it comes back on only while main requires check-linux. Where several CircleCI lanes
run linux, the share takes the one with the most month left, moving the repository variable
CI_LINUX_TARGET, which check-linux.yml's trigger reads before .circleci/project-slug, to the project
that lane's `projects` names for this repo ({"<owner>/<repo>": "<project slug>"}: a lane is an org, and
an org holds many projects). A lane that names no project here is never chosen beside one that does,
nor one whose project the repo's check-linux.yml cannot reach; with no lane naming one, the first is
judged and nothing moves, unless the variable holds a project no lane names, which turns the share off.
A move waits an hour after the last one unless the lane it leaves is out.
An Actions lane (provider `actions`, GitHub's hosted runners, judged by the account's minutes) whose
`projects` names this repo (`"actions"`) runs the share alone: the CircleCI lanes are read and said, never
chosen, and with it out the share goes off (linux-on-actions, 2026-11-02). A self-hosted Linux lane (a label
list naming Linux, never macOS, its `projects` naming the repo with `actions`; linux-runner, 2026-11-04) is such a
lane too, judged by its runner and not a budget: with one online it is taken before any hosted lane, and the
share's suites run there by CI_LINUX_RUNS_ON, the `suite` job's runs-on, which the pick moves between the lanes'
`runs_on` (unset is ubuntu-latest); a runner none carries the labels of, or one offline more than a sweep, is
gone, and the share moves to a hosted lane with month left or goes off (LINUX_RUNS_VAR's notes).
Each flip has the same guards, and is logged the same way.
"""
import argparse
import calendar
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

# This module, wharf: its templates/ beside this bin/ (the realpath, so a source shim's copy in an
# overlay still reads the module's own), and the core through lib/core_path.py like repos (C2)
MOD = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(MOD, "lib"))
import core_path  # noqa: E402 — the regatta core; none: one line, exit 2
core_path.require()
import common  # noqa: E402
# The self-hosted kind's name, and the older names ci.json and --to read as it (the header): a kind
# named after a machine is a host name in CI logic (the owner, 2026-10-31). The aliases are the
# overlay's `wharf/ci-runner-kind`, read once, at import, like the rest of the table.
SELF = "self-hosted"
KIND_ALIASES = tuple(n for n in common.config_lines("wharf/ci-runner-kind") or ()
                     if n not in (SELF, "actions", "circleci"))
CODE_TEMPLATES = os.path.join(MOD, "templates", "code")
ACTIONS_TEMPLATE = os.path.join(CODE_TEMPLATES, ".github", "workflows", "check.yml")
CIRCLECI_TEMPLATE = os.path.join(MOD, "templates", "ci", "circleci-check.yml")
CONTEXT = {"actions": "check", "circleci": "ci/circleci: check", SELF: "check"}
ACTIONS_KINDS = ("actions", SELF)  # one check.yml on GitHub Actions; self-hosted: runs-on and GUARD_STEP
# The labels a self-hosted runner gets by itself (config.sh adds the OS and the architecture):
# the rest of the labels key are the Mac's own, passed to config.sh --labels where the capabilities
