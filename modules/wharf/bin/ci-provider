# A Linux runner runs in a rootless container (linux-runner D1-C, the owner, 2026-11-04: "container"): Podman,
# a quadlet user unit, the image built on the host from this file over the pinned base (ubuntu:24.04's index digest,
# read from Docker Hub 2026-11-04; hosted ubuntu-latest is on 26.04, with uutils, so a 26.04-only break shows on the
# twin's CI, not here; by digest alone, as a tag beside one is not every tool's grammar) and the tarball verified there first.
# No sudo in it and none needed: what a suite lacks fails the job, naming it (linux-tools.sh)
RUNNER_IMAGE_BASE = ("docker.io/library/ubuntu@sha256:"
                     "fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852")
RUNNER_CONTAINERFILE = """\
# ci-provider's runner image (linux-runner): the pinned runner and what check-linux's suites need, no sudo
FROM %(base)s
LABEL ci-provider.runner=true
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \\
      ca-certificates curl git jq python3 python3-yaml ruby sqlite3 xz-utils openssh-client locales tzdata \\
      >/dev/null && rm -rf /var/lib/apt/lists/*
# /state is the runner's: podman gives a fresh volume its mount point's owner after it applies `:U` (4.9.3's
# fixVolumePermissions, read)
RUN useradd -m -d /runner -s /bin/bash runner && mkdir -p /runner/actions-runner /state && \\
    chown runner:runner /state
COPY runner.tar.gz /tmp/runner.tar.gz
RUN tar xzf /tmp/runner.tar.gz -C /runner/actions-runner && rm -f /tmp/runner.tar.gz && \\
    /runner/actions-runner/bin/installdependencies.sh >/dev/null && rm -rf /var/lib/apt/lists/* && \\
    chown -R runner:runner /runner/actions-runner
COPY entry.sh /usr/local/bin/ci-runner-entry
RUN chmod 755 /usr/local/bin/ci-runner-entry
ENV LANG=C.UTF-8 ACTIONS_RUNNER_RETURN_VERSION_DEPRECATED_EXIT_CODE=1
USER runner
WORKDIR /runner/actions-runner
ENTRYPOINT ["/usr/local/bin/ci-runner-entry"]
CMD ["run"]
"""
# The container's entry. configure and remove read their token from stdin (`podman run -i`): never in an
# argv, an environment podman sees, or the unit. The runner's registration (config.sh's files) lives in the
# state volume, copied in at each start: the runner deletes a file before it writes it (ConfigurationStore's
# SaveObject, v2.338.0), so a link into the volume would not hold. run takes one job (the listener's `--once`,
# kept in v2.338.0: "customers still relies on it") and exits; systemd starts a fresh container from the image for
# the next, so nothing a job leaves reaches the one after it, the volume aside, which the unit mounts read-only.
# The listener runs under this script, not run.sh, whose loop reads every outcome as 0: its exit is read here.
# 1 (terminated: GitHub refused the registration, a runner it deleted, say), 5 (a session conflict) and 7 (a
# version GitHub retired, with ACTIONS_RUNNER_RETURN_VERSION_DEPRECATED_EXIT_CODE) exit 3, which stops the unit
# (RestartPreventExitStatus), each with its remedy; every other exit ends the container for a fresh one: 0 (its
# one job done) at once, unless the listener lived under 30 s (a revoked credential's "Shutting down" is a 0 too),
# and the rest (2, retryable; a crash; a kill) after a pause, so a registration that can never work retries slowly
# and for good (the runner's own service, RunnerService.js v2.338.0, stops on 0 and after ten retryable failures,
# where nobody restarts it here). The pause is a background sleep the shell waits on, so a SIGTERM ends it at once. SIGTERM is passed on to the listener, which
# then ends its session; a shell as PID 1 ignores the signal it has no trap for. Not kept: what the listener
# saves while it runs (a migrated .runner_migrated or .credentials_migrated, v2.338.0's RunnerConfigUpdater):
# the volume is read-only to it, so a job cannot plant a registration for the next container
RUNNER_ENTRY = """\
#!/bin/sh
set -eu
cd /runner/actions-runner
state=".runner .credentials .credentials_rsaparams .env .path"
load() { for f in $state; do if [ -f "/state/$f" ]; then cp "/state/$f" "./$f"; fi; done; }
token() { IFS= read -r token || true; [ -n "${token:-}" ] || { echo "no token on stdin" >&2; exit 4; }; }
case "${1:-run}" in
configure)
  token
  ACTIONS_RUNNER_INPUT_TOKEN=$token ./config.sh --unattended --replace --disableupdate --url "$2" \\
    --name "$3" --labels "$4" --work _work
  for f in $state; do if [ -f "$f" ]; then cp "$f" "/state/$f"; fi; done ;;
run)
  [ -f /state/.runner ] || { echo "not configured: no /state/.runner" >&2; exit 3; }
  # the trap first: a stop while the state is copied starts no listener (PID 1 ignores an untrapped TERM)
  pid=
  trap 'stopping=1; [ -z "$pid" ] || kill -TERM "$pid" 2>/dev/null || true' TERM INT
  load
  [ -z "${stopping:-}" ] || exit 0
  began=$(date +%s)
  ./bin/Runner.Listener run --once &
  pid=$!
  rc=0; wait "$pid" || rc=$?
  while kill -0 "$pid" 2>/dev/null; do rc=0; wait "$pid" || rc=$?; done
  # a stop: the listener has ended its session, and no pause follows (the trap's one TERM went to the listener)
  [ -z "${stopping:-}" ] || exit 0
  case $rc in
    0) [ $(( $(date +%s) - began )) -ge 30 ] && exit 0
       echo "the listener exited 0 within 30 s: a fresh container after a pause" >&2 ;;
    1) echo "the listener exited 1, GitHub refused its registration: --runner install registers it again where GitHub lists no such runner" >&2; exit 3 ;;
    5) echo "the listener exited 5, a session conflict: another listener holds this runner's session; --runner install starts it again" >&2; exit 3 ;;
    7) echo "the listener exited 7, a version GitHub retired: bump ci-provider's Linux pin, then --runner install" >&2; exit 3 ;;
    *) echo "the listener exited $rc: a fresh container after a pause" >&2 ;;
  esac
  sleep "${RUNNER_RETRY_PAUSE:-30}" &
  wait $! || true
  exit 0 ;;
remove)
  token
  load
  ACTIONS_RUNNER_INPUT_TOKEN=$token ./config.sh remove
  for f in $state; do rm -f "/state/$f"; done ;;
*) echo "unknown verb: $1" >&2; exit 2 ;;
esac
"""
# The quadlet unit, in containers/systemd under the login's config folder: a user service in app.slice, the sibling of
# the sessions' services there (read on a node, 2026-11-04: the dispatched sessions run as user units in
# user@<uid>.service/app.slice, whose cpu controller is delegated), at CPUWeight 20 to their 100 and Nice 10.
# No host mount (the state is a named volume, read-only), no socket, no credential, no capability, no new
# privileges; rootless podman's own network, which keeps the host's loopback (127/8) out of reach and nothing
# else. The entry's exit 3 stops it (a runner that can take no job): quadlet's --sdnotify=conmon unit ends with the
# container's exit, which conmon returns (podman 4.9.3, conmon 2.1.10, read; podman is not on the node to probe)
RUNNER_UNIT = """\
# ci-provider's, for %(slug)s's runner %(name)s: a rootless container, a fresh one for every job
[Unit]
Description=GitHub Actions runner %(name)s for %(slug)s, in a rootless container

[Container]
Image=localhost/%(ctr)s
ContainerName=%(ctr)s
Exec=run
Volume=%(ctr)s-state:/state:ro
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=always
RestartPreventExitStatus=3
RestartSec=10
CPUWeight=20
Nice=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
"""
# what an image reference's path component takes (containers/image's grammar, vendored by podman 4.9):
# lower case, a separator only between letters and digits; at most 53, so ci-runner-<name> keeps under 64
LINUX_NAME = re.compile(r"^(?=.{1,53}$)[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*$")


def runner_container(name):
    """The unit, container, image and volume stem of a Linux runner: its name on GitHub, never the host's."""
    return "ci-runner-" + name


def linux_files(s, name):
    """(Containerfile, entry, unit) for a Linux runner's install, passed to the host in argv: none secret."""
    ctr = runner_container(name)
    return (RUNNER_CONTAINERFILE % {"base": RUNNER_IMAGE_BASE}, RUNNER_ENTRY,
            RUNNER_UNIT % {"slug": s, "name": name, "ctr": ctr})
RUNNER_WAIT = 60  # seconds a new runner gets to show online on GitHub
GENERATED = "# GENERATED by wharf's ci-provider"
# Every config.yml composed before the move opens "# GENERATED by <the overlay's path to it>":
# read as generated too, else the first compose after the move takes it for a hand edit
GENERATED_BEFORE = re.compile(r"# GENERATED by [^\n]*\bci-provider from \.circleci/parts/")
HASHED = "sha256 of what follows: "
SECTION_ORDER = ["parameters", "orbs", "executors", "commands", "jobs", "workflows"]


class Refusal(Exception):
    pass


def kind_of(name):
    """A provider as ci.json or --to names it, an older name of the self-hosted kind read as the kind;
    None for what is no name (a list in a hand-edited ci.json), which no reader takes for a provider."""
    if not isinstance(name, str):
        return None
    return SELF if name in KIND_ALIASES else name


# --- the runner Mac's private values (the docstring; wharf's README, "Private values") -------

def config_key(name):
    """`wharf/<name>`'s lines from the regatta config dir, None when absent; unreadable is a
    refusal, never taken for absent."""
    lines, why = common.config_read("wharf/" + name)
    if why:
        raise Refusal("%s is unreadable (%s)" % (common.CONFIG / "wharf" / name, why))
    return lines


def runner_labels(required=True, given=None, named=False):
    """The runner Mac's labels, from `wharf/ci-runner-labels` (or `given`, --labels' list), which
    name it and register a runner the capabilities file does not list: self-hosted among them and at least one of the Mac's own, or a refusal naming the file to
    write. required=False, for reading a repo's files (which kind, which labels status asks for):
    None instead of a refusal. Read once per command and passed down (review 2026-10-21, 12)."""
    try:
        lines = given if given is not None else config_key("ci-runner-labels")
        path = "--labels" if given is not None else common.CONFIG / "wharf" / "ci-runner-labels"
        if not lines:
            raise Refusal("no runner labels: write the runner Mac's labels to %s, one per "
                          "line (self-hosted, macOS and one of its own, e.g. its host name)" % path)
        labels = tuple(dict.fromkeys(lines))
        # a Linux runner registers by its capabilities alone (the ci-capabilities rule): with --name to
        # name it, its labels are self-hosted and Linux, and no label of the host's own
        if "self-hosted" not in {l.lower() for l in labels} or not (
                own_labels(labels) or (named and linux_labels(labels))):
            raise Refusal("%s holds %s: it needs self-hosted and at least one label of the Mac's own"
                          " (a Linux runner: self-hosted and Linux, with --name)" % (path, ", ".join(labels)))
    except Refusal:
        if required:
            raise
        return None
    return labels


def own_labels(labels):
    """The labels config.sh does not add by itself: what --labels gets; the first names the
    runner on GitHub."""
    return [l for l in labels or () if l.lower() not in AUTOMATIC_LABELS]


def runner_host(given=None):
    """The ssh alias of the runner Mac, from `wharf/ci-runner-ssh` (or `given`, --host's), or a
    refusal. One starting with `-` is refused: it goes to ssh as an argument, where it would be read
    as an option."""
    lines = [given] if given is not None else config_key("ci-runner-ssh")
    path = "--host" if given is not None else common.CONFIG / "wharf" / "ci-runner-ssh"
    if not lines:
        raise Refusal("no runner Mac: write the ssh alias that logs in to it as the runner's user "
                      "to %s" % path)
    if lines[0].startswith("-"):
        raise Refusal("%s holds %r: an ssh alias never starts with '-', which ssh would take for an "
                      "option" % (path, lines[0]))
    return lines[0]


def runner_user(host=None):
    """How the trust warning names the runner's user: `wharf/ci-runner-user`, else unnamed. host,
    --host's alias: its `user@` where it has one; another alias than the key's leaves it unnamed,
    since the key's user is another Mac's."""
    if host is not None:
        if "@" in host:
            return "as %s" % host.split("@", 1)[0]
        try:
            same = host == runner_host()
        except Refusal:
            same = False
        if not same:
            return "as the runner's user"
    try:
        lines = config_key("ci-runner-user")
    except Refusal:
        lines = None
    return "as %s" % lines[0] if lines else "as the runner's user"


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True).stdout.strip()


def gh(*args, data=None, token=None):
    """gh api, JSON in and out; returns (ok, parsed-or-text). token: this one call as that token
    (GH_TOKEN), never the gh login's; only gh_read passes one (the admin-only reads)."""
    cmd = ["gh", "api", *args]
    if data is not None:
        cmd += ["--input", "-"]
    env = dict(os.environ, GH_TOKEN=token) if token else None
    try:
        p = subprocess.run(cmd, input=json.dumps(data) if data is not None else None,
                           capture_output=True, text=True, env=env)
    except FileNotFoundError:
        # a job or shell whose PATH lacks gh (a plain ssh shell on the ops host): unread, never a traceback
        return False, "gh is not on PATH"
    out = p.stdout.strip()
    try:
        out = json.loads(out) if out else None
    except ValueError:
        pass
    return p.returncode == 0, (out if p.returncode == 0 else (p.stderr.strip() or out))


def slug(repo):
    url = git(repo, "remote", "get-url", "origin").rstrip("/")
    m = re.search(r"github\.com[:/]([^/]+)/(.+?)(?:\.git)?$", url)
    if not m:
        raise Refusal("no GitHub origin in %s (%r)" % (repo, url))
    return "%s/%s" % (m.group(1), m.group(2))


def p(repo, *parts):
    return os.path.join(repo, *parts)


def main_branch(repo):
    wfj = p(repo, ".claude", "workflow.json")
    if os.path.exists(wfj):
        return json.loads(read(wfj)).get("main", "main")
    return "main"


def read(path):
    with open(path, encoding="utf-8") as fh:
        return fh.read()


def read_loose(path):
    """A file read only to scan it (another workflow, the allowlist): a byte that is not UTF-8 is
    replaced, never a traceback (landing review 2026-10-21, 13)."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def write(path, text, dry):
    if dry:
        print("  would write %s" % path)
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    print("  wrote %s" % path)


def remove(path, dry):
    if os.path.exists(path):
        print("  %s %s" % ("would remove" if dry else "removed", path))
        if not dry:
            os.remove(path)


def load_ci(repo):
    """ci.json, {} when there is none; one that is not a JSON object is a refusal, never a
    traceback (provider_from tolerates it, as bin/repos must not stop on one repo)."""
    path = p(repo, ".github", "ci.json")
    if not os.path.exists(path):
        return {}
    try:
        ci = json.loads(read(path))
    except ValueError as e:
        raise Refusal("%s is not JSON (%s): fix it, or remove it and pass --check" % (path, e))
    if not isinstance(ci, dict):
        raise Refusal("%s is not a JSON object: fix it, or remove it and pass --check" % path)
    return ci


def required_context(repo, provider):
    """main's required check: ci.json's `context` for this provider, else the provider's default."""
    ci = load_ci(repo)
    if kind_of(ci.get("provider")) == provider and ci.get("context"):
        return ci["context"]
    return CONTEXT[provider]


def provider_from(get, labels=None):
    """(provider or None, why) from a repo's files, `get(relpath)` giving a file's text or None.
    The one definition: this tool reads the checkout, bin/repos (ci_state) origin/main (review
    2026-10-19, 5). ci.json's record first, as only this tool writes it; then the files. labels:
    the labels key's (None when absent), which a literal runs-on is read against: bin/repos passes
    none, as it calls this only where main has no check.yml."""
    try:
        ci = json.loads(get(".github/ci.json") or "{}")
    except ValueError:
        ci = {}
    kind = kind_of(ci.get("provider")) if isinstance(ci, dict) else None
    if kind:
        return kind, "ci.json" if kind == ci["provider"] else "ci.json, by its older name %s" % ci["provider"]
    if get(".circleci/parts/check.yml") is not None:
        return "circleci", "inferred: .circleci/parts/check.yml"
    wf = get(".github/workflows/check.yml")
    if wf is not None:
        needs = literal_needs(ci) if isinstance(ci, dict) and "needs" in ci else None
        if on_runner_mac(wf, labels) or own_runs_on(wf, None, needs):
            return SELF, "inferred: .github/workflows/check.yml runs on the runner Mac"
        return "actions", "inferred: .github/workflows/check.yml"
    return None, "no check in CI"


# runs-on, as this tool reads it. Its own self-hosted file takes one of two forms and nothing else is
# the tool's (review 2026-10-21, 3-5; the header): a literal of what ci.json's `needs` asks for (or the
# labels key's labels literally, as it wrote before 2026-10-31), or the variable form exactly as
# var_runs_on spells it. Any other runs-on (`[self-hosted, linux, gpu]`, a `vars.X` of the repo's own)
# is a hand edit: a switch holds it like any other (--force drops it), --runner never writes its
# variable, and without ci.json it is self-hosted only when it names one of the labels key's own labels.
RUNS_ON_LINE = re.compile(r"^( *)[\"']?runs-on[\"']?[ \t]*:(.*)$", re.M)
VAR_NAME = re.compile(r"(?!GITHUB_)[A-Za-z_][A-Za-z0-9_]*", re.I)


def var_runs_on(name, full=False):
    """The variable form's runs-on value, regatta#53's spelling: the variable's JSON list, else
    ubuntu-latest, so a public twin or a fork, which has no such variable, runs hosted. full: the
    split form, where a push, the nightly run and a hand start take NAME_FULL's labels when it is
    set: a repo whose pull requests run only a share of the line (CI_LINUX_ELSEWHERE) keeps its
    whole-line runs off a slower runner Mac that takes the share (regatta's 2016 laptop, 2026-10-27:
    the share in 41 min, the whole line in 95, past the job's 90)."""
    if full:
        return ("${{ fromJSON(github.event_name != 'pull_request' && vars.%s_FULL || vars.%s || "
                "'\"ubuntu-latest\"') }}" % (name, name))
    return "${{ fromJSON(vars.%s || '\"ubuntu-latest\"') }}" % name


# The variable form exactly as var_runs_on writes it, plain or split: only the name may vary
_NAME = "([A-Za-z_][A-Za-z0-9_]*)"
VAR_FORM = re.compile(re.escape(var_runs_on("@NAME@")).replace("@NAME@", _NAME))
VAR_FORM_FULL = re.compile(re.escape(var_runs_on("@NAME@", full=True))
                           .replace("@NAME@_FULL", _NAME + "_FULL", 1).replace("@NAME@", r"\1", 1))


def yaml_value(raw):
    """A one-line YAML value without its trailing comment (a `#` after a space, outside quotes) and
    the whitespace around it, a CR among it (review 2026-10-21, 8)."""
    quote = None
    for i, c in enumerate(raw):
        if quote:
            quote = None if c == quote else quote
        elif c in "'\"":
            quote = c
        elif c == "#" and (i == 0 or raw[i - 1] in " \t"):
            return raw[:i].strip()
    return raw.strip()


def runs_on_lines(text):
    """(as written, value) for each runs-on in a check.yml, in order: the text after `runs-on:`
    stripped, and its value without a trailing comment."""
    return [(m.group(2).strip(), yaml_value(m.group(2))) for m in RUNS_ON_LINE.finditer(text or "")]


def flow_labels(value):
    """The labels of a literal runs-on, quotes off: a flow list's items, or the one plain label;
    None for an expression (`${{ … }}`) or nothing."""
    if not value or value.startswith("${{"):
        return None
    if value.startswith("["):
        if not value.endswith("]"):
            return None
        items = value[1:-1].split(",")
    else:
        items = [value]
    labels = tuple(re.sub(r"^(['\"])(.*)\1$", r"\2", i.strip()) for i in items if i.strip())
    return labels or None


def lowered(labels):
    return {l.lower() for l in labels or ()}


def var_form(value):
    """The variable's name when value is this tool's variable form, plain or split, else None."""
    m = VAR_FORM.fullmatch(value or "") or VAR_FORM_FULL.fullmatch(value or "")
    return m.group(1) if m else None


def full_form(text):
    """Whether a check.yml's runs-on is the split variable form (var_runs_on's full)."""
    return any(VAR_FORM_FULL.fullmatch(v or "") for _, v in runs_on_lines(text or ""))


def runs_on_var(text):
    """The repository variable a check.yml's runs-on reads in this tool's form, or None: a
    variable the file reads any other way is the repo's own, never this tool's to set."""
    return next((var_form(v) for _, v in runs_on_lines(text) if var_form(v)), None)


def own_runs_on(text, labels, needs=None):
    """runs-on as this tool writes it, as the file has it (for comparing the file with its
    template): the variable form; a literal of `self-hosted`, the OS the repo needs and any of its
    capabilities, so a repo that adds one to `needs` gets its re-run (needs: repo_needs', None for no
    such literal), and never another OS, which is a hand edit on a runner of that OS; or the labels
    key's labels literally, the form before 2026-10-31 (labels: the key's; None for no such literal).
    None when the file has none of them."""
    for written, v in runs_on_lines(text):
        found = flow_labels(v)
        if var_form(v) or (labels and found and lowered(found) == lowered(labels)):
            return written
        rest = lowered(found) - {SELF}
        if needs is not None and SELF in lowered(found) and rest <= needs and needs & set(OS_WORDS) <= rest:
            return written
    return None


def on_runner_mac(text, labels):
    """Whether a check.yml runs on the runner Mac: its runs-on is the variable form, a literal of
    `self-hosted`, `macOS` and no label of a runner's own (`[self-hosted, macOS]`, this tool's literal
    for a repo that needs no capability), or a literal naming one of the labels key's own labels
    (`[self-hosted, macOS, <label>]`, `[macOS, <label>]`, the label alone), as the first Mac's name
    once did (review 2026-10-21, 5). From the config, never a name here; without the key, only the
    first two say so."""
    own = lowered(own_labels(labels))
    def names_it(found):
        return own & lowered(found) or ({SELF, "macos"} <= lowered(found) and not own_labels(found))
    return any(var_form(v) or names_it(flow_labels(v)) for _, v in runs_on_lines(text))


def literal_labels(text, labels=None):
    """The labels a literal runs-on asks for when it is a self-hosted runner's (self-hosted among
    them, or one of the labels key's own), or None."""
    want = {"self-hosted"} | lowered(own_labels(labels))
    for _, v in runs_on_lines(text):
        found = flow_labels(v)
        if found and lowered(found) & want:
            return found
    return None


def publishes_workflows(repo):
    """Whether the repo's public twin gets its check.yml: helloworld's allowlist (one file per
    line, `#` comments; .helloworld/, else the old .opensource/, as helloworld reads it) lists
    .github/workflows/check.yml. Such a check.yml must name no machine, so a literal runs-on is no
    form to keep there. Another .github/ file published (dependabot.yml, another workflow) leaves
    check.yml private (landing review 2026-10-21, 8)."""
    for conf in (".helloworld", ".opensource"):
        path = p(repo, conf, "allowlist.txt")
        if os.path.isfile(path):
            break
    else:
        return False
    for line in read_loose(path).splitlines():
        line = line.strip().rstrip("/")
        if line in (".github", ".github/workflows", ".github/workflows/check.yml"):
            return True
    return False


def pick_runs_on_var(repo, given, labels, twin=False):
    """Which repository variable --to self-hosted writes runs-on through, or None for the literal
    labels: --runs-on-var NAME; else, for a repo whose check.yml is published (--twin, or
    .helloworld/allowlist.txt listing check.yml), the variable check.yml already reads or
    RUNS_ON_VAR, even over a literal, which would publish the runner Mac's labels; else a re-run
    keeps its form, the variable check.yml already reads or a literal on the runner Mac (review
    2026-10-21, 6); else RUNS_ON_VAR when the repo has a public twin (.helloworld/)."""
    if given is not None:
        # fullmatch: `$` would take a name with a trailing newline (review 2026-10-21, 11)
        if not VAR_NAME.fullmatch(given):
            raise Refusal("--runs-on-var %r: a variable name is letters, digits and _, not starting "
                          "with a digit or GITHUB_" % given)
        return given
    wf = p(repo, ".github", "workflows", "check.yml")
    text = read(wf) if os.path.isfile(wf) else None
    have = runs_on_var(text)
    if have:
        return have
    if twin or publishes_workflows(repo):
        return RUNS_ON_VAR
    if text is not None and (on_runner_mac(text, labels) or own_runs_on(text, None, needs_of(repo))):
        return None
    if os.path.isdir(p(repo, ".helloworld")):
        return RUNS_ON_VAR
    return None


# What a job on the runner Mac must not do: it runs as the runner's login, with that login's real
# HOME (a scratch HOME is too much on macOS: headless Chrome hangs with no DOM, and the user site's
# Python packages vanish; the move of eight repos, 2026-10-21), so what the job writes "globally"
# is that login's own. Each: (what, the pattern, why and the fix). A line is read as a command;
# comments are skipped. The guards each takes are in host_writes.
HOST_WRITES = (
    # bounded at a shell separator, so `npm install && cc -g …` is no npm -g; npm 8's
    # --location=global and `npm -g install` too; `--global-style` is not -g (landing review 2026-10-21, 1)
    ("npm install -g", re.compile(r"\bnpm\s+(?:(?:-g|--global|--location[= ]global)\s+(?:install|i|add)\b"
                                  r"|(?:install|i|add)\b[^#\n;&|]*?\s(?:-g|--global|--location[= ]global))(?![\w-])"),
     "lands in the runner login's global prefix, first on its PATH, in front of its own tools: "
     "install with --prefix \"$RUNNER_TEMP/npm\" and add \"$RUNNER_TEMP/npm/bin\" to $GITHUB_PATH "
     "(or after actions/setup-node with a node-version, whose own Node takes it)"),
    ("sudo", re.compile(r"(?:^|[\s;&|(`])sudo\s"),
     "the runner's login waits on a password, or changes the Mac for every login"),
    ("apt-get", re.compile(r"(?:^|[\s;&|(`])apt(?:-get)?\s+(?:-\S+\s+)*(?:install|update|upgrade|remove)\b"),
     "there is no apt-get on macOS: guard it (`if: runner.os == 'Linux'`, or `command -v apt-get`)"),
    ("git config --global", re.compile(r"\bgit\s+config\s+(?:[^#\n]*\s)?--global\b"),
     "rewrites the runner login's own git identity: a first step "
     "`echo \"GIT_CONFIG_GLOBAL=$RUNNER_TEMP/gitconfig\" >> \"$GITHUB_ENV\"`"),
)
# what says a line runs on Linux only: not a bare "linux", which `--platform linux/amd64` holds
# (landing review 2026-10-21, 12)
APT_GUARD = re.compile(r"uname|command -v|which apt|runner\.os|RUNNER_OS|OSTYPE|ubuntu-", re.I)
# git's global config moved for the job: GIT_CONFIG_GLOBAL, or a HOME under the job's temp dir
# (five of the eight hand-moved repos, landing review 2026-10-21, 7)
GIT_GUARD = re.compile(r"GIT_CONFIG_GLOBAL=|\bHOME=\S*RUNNER_TEMP")


# automerge.yml's own runner variable, then the check's, then hosted (ci-queue-health D1): it runs on a
# runner Mac, so the scan reads it
AUTOMERGE_FORM = re.compile(r"\$\{\{\s*fromJSON\(vars\.\w+_AUTOMERGE\s*\|\|\s*vars\.\w+\s*\|\|\s*'\"ubuntu-latest\"'\)\s*\}\}")


def runs_on_runner_mac(text, labels):
    """For the scan only: on_runner_mac, or any runs-on naming self-hosted (`[self-hosted, gpu]`,
    an expression holding it) or GitHub's own `macOS` label (`[macOS, gpu]`), which the runner Mac takes too (landing review 2026-10-21, 4). A wider test
    than on_runner_mac, which decides a re-run's form and stays the tool's own."""
    return (on_runner_mac(text, labels) or any("self-hosted" in w.lower() for w, _ in runs_on_lines(text))
            or any("macos" in lowered(flow_labels(v)) for _, v in runs_on_lines(text))
            or any(SELF in i.lower() or "macos" in lowered(flow_labels(i))
                   for m in RUNS_ON_LINE.finditer(text) for i in runs_on_items(text, m.end()))
            or any(AUTOMERGE_FORM.fullmatch(v or "") for _, v in runs_on_lines(text)))


def job_start(lines, i):
    """The first line of the workflow job holding line i (its `<id>:` key under `jobs:`), else 0:
    $GITHUB_ENV and setup-node act within one job (landing review 2026-10-21, 5)."""
    top = next((j for j, l in enumerate(lines[:i]) if re.match(r"^jobs:\s*(#.*)?$", l)), None)
    if top is None:
        return 0
    col = next((len(l) - len(l.lstrip()) for l in lines[top + 1:i + 1]
                if l.strip() and not l.lstrip().startswith("#")), None)
    for j in range(i, top, -1):
        l = lines[j]
        if len(l) - len(l.lstrip()) == col and re.match(r"^\s*[\w-]+:\s*(#.*)?$", l):
            return j
    return top


def step_span(lines, i):
    """(first, last + 1) of the workflow step holding line i: its `- ` line and every line deeper
    than it, so an `if:` after `run:` counts (YAML's key order is free; landing review 2026-10-21, 12)."""
    start = next((j for j in range(i, -1, -1) if re.match(r"^\s*-\s", lines[j])), 0)
    col = len(lines[start]) - len(lines[start].lstrip())
    end = i + 1
    while end < len(lines) and (not lines[end].strip() or len(lines[end]) - len(lines[end].lstrip()) > col):
        end += 1
    return start, end


def host_writes(repo, cmd, labels, own=False):
    """[(where, line number, line, what, why)] for each HOST_WRITES line a check on the runner Mac
    would run: in cmd (the check command, written into check.yml's job), in each file cmd names in
    the repo (one level: a script it runs), and in each other workflow that runs on the runner Mac
    (own: check.yml too, for status, which then holds the command, so cmd itself is not read again;
    a switch replaces it).
    The guards: `git config --global` only in another workflow, where no GIT_CONFIG_GLOBAL or HOME
    under $RUNNER_TEMP comes before it in its job (the self-hosted check.yml's first step sets it for
    the command and its scripts); `npm … -g` with a --prefix or npm_config_prefix on its line, an
    NPM_CONFIG_PREFIX set before it (in a workflow: in its job), or after actions/setup-node with a
    node-version in its job; apt-get, and a sudo on its line, with uname, `command -v`, runner.os
    or ubuntu- on its line or the three before (a workflow: anywhere in its step)."""
    sources = [] if own else [("the check command", cmd, False)]
    seen = set()
    for tok in re.findall(r"[A-Za-z0-9_][A-Za-z0-9_./-]*", cmd):
        path = os.path.realpath(p(repo, tok))
        if (tok in seen or not os.path.isfile(path) or not path.startswith(os.path.realpath(repo) + os.sep)
                or os.path.getsize(path) > 512 * 1024):
            continue
        seen.add(tok)
        try:
            sources.append((tok, read_loose(path), False))
        except OSError:
            continue
    wdir = p(repo, ".github", "workflows")
    if os.path.isdir(wdir):
        for name in sorted(os.listdir(wdir)):
            path = os.path.join(wdir, name)
            if ((name == "check.yml" and not own) or not name.endswith((".yml", ".yaml"))
                    or not os.path.isfile(path)):
                continue
            text = read_loose(path)
            if runs_on_runner_mac(text, labels):
                sources.append((".github/workflows/" + name, text, True))
    hits = []
    for where, text, workflow in sources:
        lines = text.splitlines()
        def live(a, b):
            return [l for l in lines[a:b] if not l.lstrip().startswith("#")]
        def apt_guarded(i):
            a, b = step_span(lines, i) if workflow else (max(0, i - 3), i + 1)
            return any(APT_GUARD.search(l) for l in lines[a:b])
        for i, line in enumerate(lines):
            # a comment, or a workflow step's name (the guard step's own names git config --global)
            if line.lstrip().startswith("#") or (workflow and re.match(r"^\s*(- )?name:", line)):
                continue
            before = live(job_start(lines, i) if workflow else 0, i)
            for what, pat, why in HOST_WRITES:
                if not pat.search(line):
                    continue
                if what == "git config --global" and (
                        not workflow or any(GIT_GUARD.search(l) for l in before)
                        or re.search(r"\s--(get|list)\b|\s-l\b", line)):
                    continue
                if what == "npm install -g" and (
                        re.search(r"--prefix|npm_config_prefix", line, re.I)
                        or any(re.search(r"NPM_CONFIG_PREFIX=", l, re.I) for l in before)
                        or (workflow and any("actions/setup-node" in l for l in before)
                            and any(re.search(r"node-version(-file)?:", l) for l in before))):
                    continue
                if what == "apt-get" and apt_guarded(i):
                    continue
                if what == "sudo" and HOST_WRITES[2][1].search(line) and apt_guarded(i):
                    continue  # `sudo apt-get …` behind a Linux guard: hosted ubuntu needs the sudo
                hits.append((where, i + 1, line.strip(), what, why))
    return hits


def say_host_writes(hits):
    for where, n, line, what, why in hits:
        print("  ⚠ %s:%d runs %s on the runner Mac: %s — %s" % (where, n, what, why, line))


def provider_on_disk(repo, labels):
    return provider_from(lambda rel: read(p(repo, rel)) if os.path.isfile(p(repo, rel)) else None,
                         labels)


# A block scalar's header: `|` or `>`, a chomping indicator and an indentation digit in either
# order (`|-`, `|+`, `|2`, `>2-`), then an optional comment (YAML 1.2, 8.1.1)
BLOCK_HEADER = r"([|>])(?:([-+])?([1-9])?|([1-9])([-+]))\s*(?:#.*)?$"


def blocks(text, key):
    """Every block scalar under `key:` (Actions' `run: |`, CircleCI's `command: |`; `|-`, `|+`,
    `|2`, `| # …` and folded `>` too), dedented, each with whether its step is named `check`
    (`- name: check`, or `name: check` under `- run:`). Chomping is moot: a command's trailing
    newlines are dropped either way."""
    lines = text.splitlines()
    found = []
    for i, line in enumerate(lines):
        m = re.match(r"^(\s*)(?:- )?%s:\s*%s" % (re.escape(key), BLOCK_HEADER), line)
        inline = None if m else re.match(r"^(\s*)(?:- )?%s:\s*([^|>#\s].*?)\s*$" % re.escape(key), line)
        if inline:
            # `run: sh check.sh` on one line; a quoted value loses its quotes
            m, value = inline, re.sub(r"^(['\"])(.*)\1$", r"\2", inline.group(2))
        elif not m:
            continue
        body = [] if not inline else None
        # the block ends at the key's own column: on `- run: |` that is past the dash, where a
        # sibling `name:` after it starts
        key_col = len(m.group(1)) + (2 if re.match(r"^\s*- ", line) else 0)
        for nxt in lines[i + 1:] if body is not None else ():
            if nxt.strip() == "":
                body.append("")
                continue
            if len(nxt) - len(nxt.lstrip()) <= key_col:
                break
            body.append(nxt)
        if body is None:
            body = [value]
        while body and not body[-1].strip():
            body.pop()
        digit = m.group(4) or m.group(5) if not inline else None
        if digit:
            # an explicit indent counts from the mapping holding the key, so a first line indented
            # deeper keeps its extra spaces
            ind = key_col + int(digit)
        else:
            ind = min((len(b) - len(b.lstrip()) for b in body if b.strip()), default=0)
        body = [b[ind:] for b in body]
        if not inline and m.group(2) == ">":
            body = ["".join(fold(body))]
        found.append(("\n".join(body), step_named_check(lines, i)))
    return found


def fold(lines):
    """A folded (`>`) block's text from its dedented lines: a break between two plain lines is a
    space, an empty line a newline, and a more-indented line keeps its breaks (YAML 1.2, 6.5)."""
    while lines and not lines[0].strip():
        lines = lines[1:]
    out, prev, i = [], None, 0
    while i < len(lines):
        empty = 0
        while i < len(lines) and not lines[i].strip():
            empty, i = empty + 1, i + 1
        cur = lines[i]
        if prev is not None:
            kept = prev[:1] in (" ", "\t") or cur[:1] in (" ", "\t")
            out.append("\n" * (empty + kept) if (empty or kept) else " ")
        out.append(cur)
        prev, i = cur, i + 1
    return out


def step_named_check(lines, i):
    """Whether the mapping holding the key on line i has `name: check`, before the key or after
    it: YAML's key order is free (review 2026-10-19, 6). Its siblings are the lines whose content
    starts in the key's column, up to the first line that starts left of it."""
    def col(line):
        s = re.match(r"^(\s*)(- )?(.*)$", line)
        return len(s.group(1)) + len(s.group(2) or ""), s.group(3), bool(s.group(2))
    key_col, _, dash = col(lines[i])
    def named(text):
        return re.match(r"^name:\s*['\"]?check['\"]?\s*(#.*)?$", text.strip()) is not None
    # forward: siblings after the key (deeper lines are the block or other keys' values)
    for line in lines[i + 1:]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        c, text, d = col(line)
        if c < key_col or (d and c == key_col):
            break
        if c == key_col and named(text):
            return True
    # backward: siblings before it, stopping at the list item that opens the step (`- name: check`
    # itself, or `- run:` above CircleCI's `command:`); a key on a `- ` line opens its own step
    if dash:
        return False
    for line in reversed(lines[:i]):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        c, text, d = col(line)
        if c < key_col:
            break
        if c == key_col and named(text):
            return True
        if d and c == key_col:
            break
    return False


def the_check(text, key, where):
    """The step named `check`, else the only block; two candidates and none named is a refusal:
    a setup step taken for the check would run green and assert nothing."""
    # the self-hosted kind's guard step is a `run:` too, never the check (landing review 2026-10-21, 14)
    found = [(b, n) for b, n in blocks(text, key) if b.strip() != GUARD_RUN]
    named = [b for b, n in found if n]
    if len(named) == 1:
        return named[0]
    if len(found) == 1 and not named:
        return found[0][0]
    if found:
        raise Refusal("%s: %d `%s:` steps and not one named `check`: pass --check"
                      % (where, len(found), key))
    return None


def check_command(repo, given):
    if given:
        return given
    # the live CI file first: an edit made there is the newest word; ci.json is its record
    wf = p(repo, ".github", "workflows", "check.yml")
    if os.path.exists(wf):
        cmd = the_check(read(wf), "run", ".github/workflows/check.yml")
        # only the template's own placeholder is no command: `${{ matrix.os }}` and the like are
        if cmd and cmd.strip() != "{{COMMAND}}":
            return cmd
    part = p(repo, ".circleci", "parts", "check.yml")
    if os.path.exists(part):
        cmd = the_check(read(part), "command", ".circleci/parts/check.yml")
        if cmd and cmd.strip() != "@COMMAND@":
            return cmd
    ci = load_ci(repo)
    if ci.get("check"):
        return ci["check"]
    agents = p(repo, "AGENTS.md")
    if os.path.exists(agents):
        m = re.search(r"^- check: `([^`]+)`", read(agents), re.M)
        if m:
            return m.group(1)
    raise Refusal("no check command: pass --check, or give AGENTS.md a `- check: `…`` line")


def indent_block(cmd, spaces):
    pad = " " * spaces
    return "\n".join((pad + line) if line.strip() else "" for line in cmd.splitlines())


def render(template, placeholder, cmd):
    """The template with its placeholder line replaced by cmd at the placeholder's own indent."""
    text = read(template)
    pat = r"^( *)%s$" % re.escape(placeholder)
    m = re.search(pat, text, re.M)
    if not m:
        raise Refusal("%s has no `%s` line" % (template, placeholder))
    return re.sub(pat, lambda _: indent_block(cmd, len(m.group(1))), text, count=1, flags=re.M)


def render_workflow(kind, cmd, runs_on=None, guard=True):
    """check.yml for actions or self-hosted: the template, and for self-hosted its one runs-on line
    swapped for runs_on (the caller's: what the repo needs, or a file's own when comparing) and the
    GIT_CONFIG_GLOBAL step first (guard=False: without it, as the tool wrote it before 2026-10-21,
    for comparing an older file). One template for both, so the draft skip and the concurrency
    block cannot drift."""
    text = render(ACTIONS_TEMPLATE, "{{COMMAND}}", cmd)
    if kind != SELF:
        return text
    if guard:
        steps = r"^( *)- uses: actions/checkout@"
        found = re.findall(steps, text, re.M)
        if len(found) != 1:
            raise Refusal("%s has %d `- uses: actions/checkout@` steps, not one" % (ACTIONS_TEMPLATE, len(found)))
        def first_step(m):
            pad = m.group(1)
            return "\n".join(pad + l if l else "" for l in GUARD_STEP.splitlines()) + "\n" + m.group(0)
        text = re.sub(steps, first_step, text, count=1, flags=re.M)
    if not runs_on:
        raise Refusal("no runs-on for the self-hosted runner")
    pat = r"^( *)runs-on: ubuntu-latest$"
    found = re.findall(pat, text, re.M)
    if len(found) != 1:
        raise Refusal("%s has %d `runs-on: ubuntu-latest` lines, not one" % (ACTIONS_TEMPLATE, len(found)))
    def swap(m):
        pad = m.group(1)
        # Published with the file wherever check.yml is (a public twin's): this block, like the
        # template's header, names no machine, login or account; the literal form's labels say what
        # the runner carries, which a repo with a twin keeps out of its public file with the
        # variable form. The suite scans the rendered file against the private word list where
        # one is installed.
        var = var_form(yaml_value(runs_on))
        via = ("%s# runs-on reads the repository variable %s (a JSON list of labels), ubuntu-latest\n"
               "%s# where it is unset (a public twin, a fork): this file names no machine.\n"
               % (pad, var, pad)) if var else ""
        if var and VAR_FORM_FULL.fullmatch(yaml_value(runs_on) or ""):
            via += ("%s# A push, the nightly run and a hand start take %s_FULL's labels where it is set:\n"
                    "%s# the whole line, kept off a runner that takes only a pull request's share.\n"
                    % (pad, var, pad))
        return via + ("%s# A self-hosted runner on a Mac of the owner's (wharf's ci-provider): macOS, no\n"
                "%s# Actions minutes. It runs as a login holding that Mac's credentials (gh, an ssh\n"
                "%s# key, git, Claude logins). Any write collaborator on this repo can run code there\n"
                "%s# by opening a PR. Private repos with fork PRs' workflows off only: that stops forks,\n"
                "%s# nothing else. The runner: `ci-provider <repo> --runner install`; with none online\n"
                "%s# the job waits, unreported.\n"
                "%sruns-on: %s" % (pad, pad, pad, pad, pad, pad, pad, runs_on))
    return re.sub(pat, swap, text, count=1, flags=re.M)


def workflow_renders(cmd, runs_on=None):
    """check.yml as each Actions kind renders it with cmd, for comparing an existing file: self-hosted
    with that file's own runs-on (runs_on), so the comparison needs no runner keys and a file
    written on another Mac's labels holds nothing more, and self-hosted without its GIT_CONFIG_GLOBAL
    step too, so a file written before it is the tool's own and a re-run adds the step; a kind
    whose render is refused is left out, as the file cannot be that kind's."""
    out = []
    for k, guard in (("actions", True), (SELF, True), (SELF, False)):
        try:
            out.append(render_workflow(k, cmd, runs_on, guard))
        except Refusal:
            pass
    return out


def is_private(s):
    """Whether GitHub says the repo is private; anything unread is a refusal, never a guess."""
    ok, out = gh("repos/%s" % s, "--jq", ".private")
    if not ok or not isinstance(out, bool):
        raise Refusal("could not read whether %s is private (%s): the runner Mac runs a private "
                      "repo's jobs only" % (s, out))
    return out


# A read-only token for the admin-only reads: GitHub answers the fork-PR setting and the runner
# list to a repo admin alone, so the machine login the desk's gh runs as reads a 404, and the trust
# guard refused the Mac lane on every pass (198 times by 2026-11-02). lighthouse's `ops pick` passes
# the desk token here (ops.env's GITHUB_TOKEN, given Administration: read on the repo). main's caller
# pops it from the environment at the start, so no child process inherits it; gh_read alone uses it,
# as GH_TOKEN on that one call.
READ_VAR = "WHARF_READ_TOKEN"
READ_TOKEN = None


def gh_read(path):
    """A GET the gh login may lack the rights for: the login first, then READ_TOKEN's once.
    (ok, parsed) from the first read that answered a dict, else (False, both answers said)."""
    whys = []
    for tok in [None] + ([READ_TOKEN] if READ_TOKEN else []):
        ok, out = gh(path, token=tok)
        if ok and isinstance(out, dict):
            return True, out
        whys.append(("%s: %s" % (READ_VAR, out)) if tok else str(out))
    return False, "; ".join(whys)


def runs_fork_prs(s):
    """Whether a private repo runs workflows from fork pull requests (Settings > Actions >
    General > Fork pull request workflows); unread is a refusal, as with .private. Read through
    gh_read: the setting is a repo admin's alone."""
    ok, out = gh_read("repos/%s/actions/permissions/fork-pr-workflows-private-repos" % s)
    flag = out.get("run_workflows_from_fork_pull_requests") if ok else None
    if not isinstance(flag, bool):
        raise Refusal("could not read whether %s runs fork pull requests' workflows (%s): the "
                      "runner Mac runs a repo's jobs only when it does not" % (s, out))
    return flag


def refuse_forks(s, what):
    """Public, or private with fork PRs' workflows on: a fork's PR would run its code on the
    runner Mac."""
    if not is_private(s):
        raise Refusal("%s is public: %s would let a fork's pull request run its code on the runner Mac; "
                      "keep it on actions (ubuntu)" % (s, what))
    if runs_fork_prs(s):
        raise Refusal("%s runs fork pull requests' workflows: %s would let a fork's pull request "
                      "run its code on the runner Mac; turn that off (Settings > Actions > General) or keep "
                      "it on actions (ubuntu)" % (s, what))


def warn_writers(s, user=None):
    """The trust boundary, said at the two steps that open it: every collaborator with push or
    above can run code on the runner Mac as its user by opening a PR (the owner's D5-A accepts it;
    nothing is refused for it). `user`: how to name that user, the key's unless given."""
    ok, out = gh("repos/%s/collaborators?per_page=100" % s)
    if ok and isinstance(out, list):
        names = [c.get("login") for c in out if isinstance(c, dict) and any(
            (c.get("permissions") or {}).get(k) for k in ("push", "maintain", "admin"))]
        print("  ⚠ write collaborators of %s, each able to run code on the runner Mac %s, with "
              "every credential it holds (gh, its ssh key, git, Claude logins): %s"
              % (s, user or runner_user(), ", ".join(names) or "none"))
    else:
        print("  ⚠ write collaborators of %s unread (%s): each of them can run code on the runner "
              "Mac %s" % (s, out, user or runner_user()))


def holds_more(path, rendered):
    """Whether the CI file at path differs from what its template renders with the same command,
    comments and blank lines aside (a template's reworded comment is no difference; a step, an
    `env:`, an `on:` filter or a newer image digest is: --force says it may go)."""
    if not os.path.exists(path):
        return False
    def meat(s):
        return [l.rstrip() for l in s.splitlines() if l.strip() and not l.lstrip().startswith("#")]
    return meat(read(path)) != meat(rendered)


# --- CircleCI composition ------------------------------------------------------------------

def split_part(text, name):
    """A part's preamble comments and its top-level sections, each a list of body lines."""
    preamble, sections, cur, started = [], {}, None, False
    for line in text.splitlines():
        if line.rstrip() == "---" and not started:
            # a document-start marker before any key: one document, nothing to section; a second
            # `---` (two documents in one file) still meets the refusal below
            started = True
            continue
        if line[:1] not in ("", " ", "#"):
            started = True
            # every column-0 line is a top-level key; one compose cannot section is refused
            m = re.match(r"^([A-Za-z_][\w-]*):(.*)$", line)
            if not m:
                raise Refusal("%s: column-0 line %r is not a top-level key" % (name, line))
            cur, rest = m.group(1), m.group(2).strip()
            if cur == "version":
                cur = None
                continue
            if rest and not rest.startswith("#"):
                raise Refusal("%s: top-level `%s:` has an inline value (%r); compose takes only "
                              "sections (%s)" % (name, cur, rest, ", ".join(SECTION_ORDER)))
            if cur in sections:
                raise Refusal("%s: top-level `%s:` twice" % (name, cur))
            sections[cur] = []
            continue
        if cur is None:
            if line.strip() and not line.lstrip().startswith("#"):
                raise Refusal("%s: %r is outside any top-level section" % (name, line))
            preamble.append(line)
        else:
            sections[cur].append(line)
    for sec, body in sections.items():
        if sec not in SECTION_ORDER:
            raise Refusal("%s: top-level `%s:` is not one compose knows (%s)" % (name, sec, ", ".join(SECTION_ORDER)))
        # parts are pasted under one key, so their entries must share its indent: two spaces
        first = next((b for b in body if b.strip() and not b.lstrip().startswith("#")), None)
        if first is not None and len(first) - len(first.lstrip()) != 2:
            raise Refusal("%s: `%s:` entries are indented %d spaces; compose needs 2"
                          % (name, sec, len(first) - len(first.lstrip())))
    return preamble, sections


def read_parts(repo, overrides=None):
    """The parts on disk, with this run's planned writes (text) and removals (None) applied."""
    parts_dir = p(repo, ".circleci", "parts")
    parts = {f: read(os.path.join(parts_dir, f)) for f in os.listdir(parts_dir)
             if f.endswith(".yml")} if os.path.isdir(parts_dir) else {}
    for name, text in (overrides or {}).items():
        if text is None:
            parts.pop(name, None)
        else:
            parts[name] = text
    return parts


def compose_text(parts):
    """The one config.yml CircleCI reads, from the parts; validated, nothing written."""
    merged = {s: [] for s in SECTION_ORDER}
    seen = {}
    for name in sorted(parts):
        preamble, sections = split_part(parts[name], name)
        first = True
        for sec in SECTION_ORDER:
            if sec not in sections:
                continue
            for line in sections[sec]:
                m = re.match(r"^  ([^\s#][^:]*):", line)
                if m:
                    key = (sec, m.group(1))
                    if key in seen:
                        raise Refusal("%s and %s both define %s `%s`" % (seen[key], name, sec, m.group(1)))
                    seen[key] = name
            head = ["  # --- part: .circleci/parts/%s" % name]
            if first:
                head += ["  " + c if c.strip() else "" for c in preamble if c.strip()]
                first = False
            body = list(sections[sec])
            while body and not body[-1].strip():
                body.pop()
            merged[sec] += head + body + [""]
    out = ["version: 2.1", ""]
    for sec in SECTION_ORDER:
        if merged[sec]:
            while merged[sec] and not merged[sec][-1].strip():
                merged[sec].pop()
            out += ["%s:" % sec] + merged[sec] + [""]
    body = "\n".join(out).rstrip("\n") + "\n"
    yaml_check(body)
    return (GENERATED + " from .circleci/parts/*.yml: edit a part, then\n"
            "# `ci-provider <repo> --compose`. CircleCI reads only this file. "
            + HASHED + hashlib.sha256(body.encode()).hexdigest() + "\n" + body)


def config_state(repo):
    """absent | hand (never generated) | generated | edited (generated, then changed by hand).
    A config generated before the hash line existed reads as generated: nothing to compare."""
    config = p(repo, ".circleci", "config.yml")
    if not os.path.exists(config):
        return "absent"
    text = read(config)
    if not (text.startswith(GENERATED) or GENERATED_BEFORE.match(text)):
        return "hand"
    head = text.split("\n", 2)
    if len(head) == 3 and HASHED in head[1]:
        want = head[1].rsplit(HASHED, 1)[1].strip()
        if hashlib.sha256(head[2].encode()).hexdigest() != want:
            return "edited"
    return "generated"


def compose_plan(repo, overrides=None, adopting=False):
    """What compose would do, validated, nothing written: ("write"|"same"|"remove"|"none", text)."""
    parts = read_parts(repo, overrides)
    state = config_state(repo)
    config = p(repo, ".circleci", "config.yml")
    if state == "edited" or (state == "hand" and parts and not adopting):
        raise Refusal("%s was edited by hand beside .circleci/parts/: move the edit into a part "
                      "(or restore the file), then compose" % config)
    if not parts:
        return ("remove" if state == "generated" else "none"), None
    text = compose_text(parts)
    if state != "absent" and read(config) == text:
        return "same", text
    return "write", text


def apply_plan(repo, plan, dry, quiet=False):
    config = p(repo, ".circleci", "config.yml")
    action, text = plan
    if action == "write":
        write(config, text, dry)
    elif action == "remove":
        remove(config, dry)
    elif action == "same" and not quiet:
        print("  %s already composed" % config)


def compose(repo, dry=False, quiet=False):
    apply_plan(repo, compose_plan(repo), dry, quiet)


def yaml_check(text):
    """Parse the composed file with Ruby's YAML (on every Mac; no Python YAML in stdlib)."""
    ruby = shutil.which("ruby")
    if not ruby:
        print("  (ruby not found: the composed YAML was not parsed)")
        return
    # aliases: true, as CircleCI's own loader takes anchors; an orb's job (`node/test`) is defined
    # by the orb, not under jobs:
    prog = ("require 'yaml'; begin; d = YAML.safe_load(STDIN.read, aliases: true); "
            "raise 'not a mapping' unless d.is_a?(Hash); "
            "raise 'no jobs' unless d['jobs'].is_a?(Hash); "
            "raise 'no workflows' unless d['workflows'].is_a?(Hash); "
            "d['workflows'].each { |w, v| next unless v.is_a?(Hash); (v['jobs'] || []).each { |j| "
            "n = j.is_a?(Hash) ? j.keys.first : j; next if n.to_s.include?('/'); "
            "raise \"workflow #{w}: no job #{n}\" unless d['jobs'].key?(n) } }; "
            "rescue => e; warn e.message.lines.first.to_s.strip; exit 1; end")
    r = subprocess.run([ruby, "-e", prog], input=text, capture_output=True, text=True)
    if r.returncode != 0:
        raise Refusal("the composed .circleci/config.yml does not pass: %s" % (r.stderr.strip().splitlines() or ["?"])[0])


def adopt_text(repo):
    """A hand-written .circleci/config.yml becomes parts/main.yml the first time parts are used:
    its text, or None when there is nothing to adopt."""
    config = p(repo, ".circleci", "config.yml")
    parts_dir = p(repo, ".circleci", "parts")
    if config_state(repo) != "hand":
        return None
    if os.path.isdir(parts_dir) and os.listdir(parts_dir):
        raise Refusal("%s was edited by hand beside .circleci/parts/: move the edit into a part" % config)
    return re.sub(r"^version:.*\n", "", read(config), count=1, flags=re.M)


# --- the switch ----------------------------------------------------------------------------

def swap_contexts(have, want, drop):
    """main's required checks with the old provider's (drop) swapped for want; the rest kept."""
    return [c for c in have if c not in drop and c != want] + [want]


def matrix_names(contexts):
    """`check (<value>)`: what a matrix job named check reports (a repo's two macOS images).
    Every file this tool writes has one job and no matrix, so after a switch none of these can
    report again, and left required they would block every PR."""
    return {c for c in contexts if c and re.match(r"^check \(.+\)$", c)}


def has_matrix(text):
    """Whether a check.yml has a `strategy:` or `matrix:`: written by hand, as this tool's never do."""
    return text is not None and re.search(r"^\s*(strategy|matrix):", text, re.M) is not None


def stale_matrix(repo, contexts):
    """The matrix names to drop from main's required checks: all of them while the check.yml on
    disk is this tool's one job (or there is none), none while a hand-written matrix reports
    them (review 2026-10-19 second pass, E: --protect --force would block every PR)."""
    wf = p(repo, ".github", "workflows", "check.yml")
    if has_matrix(read(wf) if os.path.isfile(wf) else None):
        return set()
    return matrix_names(contexts)


def pins_of(rsc):
    """{context: app_id} from required_status_checks' `checks`, the form that pins a check to the
    GitHub App that must report it; app_id None where none is pinned."""
    return {c["context"]: c.get("app_id") for c in (rsc or {}).get("checks") or []
            if isinstance(c, dict) and c.get("context")}


def checks_of(names, pins):
    """`checks` for these names: a kept check keeps its pin, a new one goes without app_id, which
    GitHub fills with the app that recently reported it (REST "Update status check protection",
    read 2026-10-19). A `contexts` PATCH re-derives every pin that way, so an explicit pin to
    another app, or -1 (any app), would not survive one (review 2026-10-19, 3). A null app_id is
    kept unpinned (sent without one); -1 is not used. Unverified: what GitHub does with either.
    The second review of 2026-10-19 left this as it is."""
    return [dict({"context": n}, **({"app_id": pins[n]} if pins.get(n) is not None else {}))
            for n in names]


def protection_text(repo, provider, context, old_context):
    """main-protection.json with the provider's check swapped in, or None when it already is.
    Written in the form(s) the file had: `checks` keeps its pins, `contexts` stays plain."""
    path = p(repo, ".github", "main-protection.json")
    data = json.loads(read(path)) if os.path.exists(path) else json.loads(
        read(os.path.join(CODE_TEMPLATES, ".github", "main-protection.json")))
    rsc = data.get("required_status_checks") or {"strict": False}
    data["required_status_checks"] = rsc
    pins = pins_of(rsc)
    have = list(rsc.get("contexts") or []) + list(pins)
    want = context or CONTEXT[provider]
    # matrix names all go: this runs for a switch, and what it writes is one job or no check.yml
    new = swap_contexts(list(dict.fromkeys(have)), want,
                        set(CONTEXT.values()) | {old_context} | live_replaces(repo)
                        | matrix_names(have))
    before = same_checks(rsc)
    if "checks" in rsc:
        rsc["checks"] = checks_of(new, pins)
    if "contexts" in rsc or "checks" not in rsc:
        rsc["contexts"] = new
    if same_checks(rsc) == before:
        return None
    return json.dumps(data, indent=2) + "\n"


def same_checks(rsc):
    """required_status_checks as GitHub reads it: the lists are sets, so a reorder (the swap puts
    the new check last) is no change, and a switch that only reorders needs no --protect."""
    d = dict(rsc)
    if isinstance(d.get("contexts"), list):
        d["contexts"] = sorted(set(d["contexts"]))
    if isinstance(d.get("checks"), list):
        d["checks"] = sorted({(c.get("context"), c.get("app_id")) for c in d["checks"]
                              if isinstance(c, dict)}, key=repr)
    return json.dumps(d, sort_keys=True)


def switch(repo, to, check, dry, context=None, force=False, var=None, twin=False):
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    main = main_branch(repo)
    if branch == main:
        raise Refusal("%s is on %s: switch on a claude/* branch, then land it" % (repo, main))
    automerge = os.path.exists(p(repo, ".github", "workflows", "automerge.yml"))
    if to == "circleci" and automerge:
        raise Refusal("automerge.yml runs on GitHub Actions and waits for a check.yml run, so under "
                      "CircleCI it would never arm; remove it first or keep actions")
    # the labels key, read once (review 2026-10-21, 12): for self-hosted first, in either form
    # (--runner install takes the runner's name from it), so without it there is nothing to write
    # and GitHub is not asked; for the other kinds only to tell this tool's runs-on from a hand edit
    labels = runner_labels(required=(to == SELF))
    asked = runs_on = None
    table = readable_caps()
    if to == SELF:
        var = pick_runs_on_var(repo, var, labels, twin)
        # a re-run keeps the split form where the file has it, as it keeps the variable form
        wf = p(repo, ".github", "workflows", "check.yml")
        full = full_form(read(wf)) if os.path.isfile(wf) else False
        if var:
            runs_on = var_runs_on(var, full)
        else:
            asked = needed_labels(load_ci(repo))
            runs_on = "[%s]" % ", ".join(asked)
        # `needs` is open to any label, so a typo reads as a capability: said here, while the file
        # is being written, not once a job has queued for good
        unlisted = sorted(n for n in own_labels(needs_of(repo)) if n not in LANE_RUNS and table is not None
                          and not any(n in lowered(c) for c in table.values()))
        if unlisted:
            print("  ⚠ no runner in %s lists %s: until one carries it the job queues; a mistyped `needs`, "
                  "or a capability to add there" % (CAPS_KEY, ", ".join(unlisted)))
        refuse_forks(slug(repo), "a check on the runner Mac's self-hosted runner")
    was, _ = provider_on_disk(repo, labels)
    cmd = check_command(repo, check)
    print("%s → %s (check: %s)" % (repo, to, cmd.replace("\n", "; ")))
    if to == SELF:
        # what the job would run as the runner's login: the check command, which this switch
        # writes, is refused (--force writes it anyway); what it leaves, the scripts the command
        # names and the other workflows on the runner Mac, is said, line by line
        hits = host_writes(repo, cmd, labels)
        say_host_writes(hits)
    wf = p(repo, ".github", "workflows", "check.yml")
    part = p(repo, ".circleci", "parts", "check.yml")
    # only the target's file: a refusal of one kind's render (the self-hosted kind's runs-on swap) gates only
    # a switch to that kind
    target = (render_workflow(to, cmd, runs_on) if to in ACTIONS_KINDS
              else render(CIRCLECI_TEMPLATE, "@COMMAND@", cmd))
    # what either CI file holds beyond its template and its own command is not carried across, nor
    # kept by a re-run on the same provider: each is compared with its template rendered with that
    # file's own command, not the new one (check.yml with either runs-on, ubuntu's or this tool's
    # own self-hosted one: a runs-on of any other shape is a hand edit, review 2026-10-21, 4)
    wf_text = read(wf) if os.path.exists(wf) else None
    own_on = own_runs_on(wf_text, labels, needs_of(repo))
    for path, key, renders in (
            (wf, "run", lambda c: workflow_renders(c, own_on)),
            (part, "command", lambda c: [render(CIRCLECI_TEMPLATE, "@COMMAND@", c)])):
        if not os.path.exists(path) or force:
            continue
        try:
            own = the_check(read(path), key, os.path.relpath(path, repo)) or cmd
        except Refusal:
            own = cmd  # a file with no clear check is compared as is: --force passes it
        if all(holds_more(path, r) for r in renders(own)):
            # a runner's runs-on that is not this config's labels: say so, as it is often the one
            # difference (another Mac's labels, or a Mac without the labels key)
            why = ""
            if path == wf and own_on is None and literal_labels(wf_text, labels):
                why = (" (its runs-on, [%s], is not this tool's: that is `self-hosted`, the OS and what "
                       ".github/ci.json's `needs` lists, so a label just dropped from `needs` leaves the "
                       "line to edit by hand%s)" % (
                           ", ".join(literal_labels(wf_text, labels)),
                           "" if labels else "; %s is not set here" % (common.CONFIG / "wharf" / "ci-runner-labels")))
            raise Refusal("%s holds more than its template and its check command (setup steps, env, "
                          "other jobs, an older template, a runs-on of its own)%s; a switch keeps only "
                          "the command: port the rest by hand, then --force (and --check CMD if the "
                          "command read is not the check)" % (os.path.relpath(path, repo), why))
    # after the holds-more refusal: its way out, --force, also drops what the old file held beyond
    # its template, which that refusal says first (landing review 2026-10-21, 15)
    if to == SELF and not force and any(h[0] == "the check command" for h in hits):
        raise Refusal("the check command runs %s on the runner Mac, as its login (above): pass "
                      "--check without it, or --force" % ", ".join(
                          sorted({h[3] for h in hits if h[0] == "the check command"})))
    was_on = literal_labels(wf_text, labels) if asked and wf_text else None
    if was_on and lowered(was_on) - lowered(asked):
        # a literal naming a Mac may have stood for a real need: said, as this widens where the job runs
        print("  runs-on [%s] → [%s]: any runner carrying these takes the job; a real need goes in "
              ".github/ci.json's `needs`" % (", ".join(was_on), ", ".join(asked)))
    # plan everything, validate, and only then write: a refusal leaves the checkout as it was
    writes, removes = {}, []
    if to == "circleci":
        overrides = {"check.yml": target}
        adopted = adopt_text(repo)
        if adopted is not None:
            overrides["main.yml"] = adopted
        try:
            plan = compose_plan(repo, overrides, adopting=adopted is not None)
        except Refusal as e:
            if adopted is None:
                raise
            # main.yml is not on disk yet: name the file the text came from
            raise Refusal("adopting .circleci/config.yml as .circleci/parts/main.yml: %s" % e)
        for name, text in overrides.items():
            writes[p(repo, ".circleci", "parts", name)] = text
        removes.append(wf)
    else:
        plan = compose_plan(repo, {"check.yml": None})
        writes[wf] = target
        removes.append(part)
    old = load_ci(repo)
    # a name belongs to the CI that reports it: kept on the same provider, and between actions and
    # self-hosted, where the same job of the same check.yml reports it
    if context is None and (kind_of(old.get("provider")) == to or
                            {kind_of(old.get("provider")), to} <= set(ACTIONS_KINDS)):
        context = old.get("context")
        if to in ACTIONS_KINDS and matrix_names([context]):
            # a matrix job's name, and the check.yml written here has one job: it would never
            # report. Left to `replaces`, so --protect swaps it out
            print("  ci.json's context %r is a matrix job's name, which the one-job check.yml "
                  "cannot report: dropped" % context)
            context = None
    prot = protection_text(repo, to, context, old.get("context"))
    if prot is not None:
        writes[p(repo, ".github", "main-protection.json")] = prot
    ci = {"provider": to, "check": cmd}
    if "needs" in old:
        # what the check needs from a runner is the repo's, whichever CI runs it
        ci["needs"] = old["needs"]
    if context:
        ci["context"] = context
    # a context this branch named before and now replaces may already be required on GitHub
    # (--protect ran on it): kept here so --protect swaps it out too; main's own list is spent
    replaces = [c for c in sorted(live_replaces(repo)) + [old.get("context")] if c and c != context]
    if replaces:
        ci["replaces"] = sorted(set(replaces))
    if old != ci:
        writes[p(repo, ".github", "ci.json")] = json.dumps(ci, indent=2) + "\n"
    for path, text in writes.items():
        write(path, text, dry)
    for path in removes:
        remove(path, dry)
    apply_plan(repo, plan, dry, quiet=True)
    if not dry:
        for d in (p(repo, ".circleci", "parts"), p(repo, ".circleci")):
            if os.path.isdir(d) and not os.listdir(d):
                os.rmdir(d)
    want = context or CONTEXT[to]
    where = ""
    if to == SELF:
        # the variable form runs hosted until the variable is set, and a green there proves
        # nothing of the runner: say so where the step asks for green (review 2026-10-21, 6)
        where = (" on the runner Mac, which it reaches only once %s is set (`ci-provider %s --runner "
                 "install`; until then it runs on ubuntu-latest, hosted)" % (var, repo)
                 if var else " on the runner Mac")
    if to == "circleci":
        print("next: commit and push this branch; CircleCI must follow the project (Projects > Set "
              "Up) and report `%s` green; then `ci-provider %s --protect`" % (want, repo))
    elif was in ACTIONS_KINDS and prot is None:
        # same job name, main-protection.json unchanged: GitHub already requires what will report
        print("next: commit and push this branch; the `check` workflow must report green%s; main's "
              "required check stays %r: no --protect" % (where, want))
    else:
        # check.yml skips drafts, and every claude/* PR starts as one: ready it, or `check` never
        # reports on this head and --protect refuses (the docstring's order)
        print("next: commit and push this branch, then `gh pr ready` its PR (check.yml skips a "
              "draft); once the `check` workflow reports green%s, `ci-provider %s --protect` "
              "(until then main requires the old check, so the ready PR waits)" % (where, repo))
    if context:
        print("  main's required check will be %r (ci.json `context`)" % context)
    if to == SELF:
        warn_writers(slug(repo))
        if var:
            # unset, the job runs hosted and still reports `check`: green there is no proof the
            # runner works, so the variable is set only once the runner is online
            print("  runs-on reads the repository variable %s: `ci-provider %s --runner install` "
                  "installs the runner (downloads actions/runner onto the runner Mac) and then sets "
                  "%s to %s; until then the check runs on ubuntu-latest, hosted"
                  % (var, repo, var, variable_value(
                      capped_labels(own_labels(labels)[0], labels, table) or labels)))
        else:
            print("  the runner, once per repo: `ci-provider %s --runner install` (downloads "
                  "actions/runner onto the runner Mac); until one labelled %s is online the job "
                  "queues and `check` never reports" % (repo, ", ".join(asked)))
        if automerge:
            print("  automerge.yml stays on ubuntu-latest, hosted, so no runner-Mac job runs with an "
                  "authenticated `gh` it does not need: about one hosted Linux minute per PR event, "
                  "still billed")


# --- GitHub ---------------------------------------------------------------------------------

def statuses(repo_slug, ref):
    """Names and states of what reported on ref: commit statuses and check runs."""
    found = {}
    ok, st = gh("repos/%s/commits/%s/status" % (repo_slug, ref))
    if ok and isinstance(st, dict):
        for s in st.get("statuses", []):
            found.setdefault(s["context"], s["state"])
    ok, cr = gh("repos/%s/commits/%s/check-runs" % (repo_slug, ref))
    if ok and isinstance(cr, dict):
        runs = {}
        for c in cr.get("check_runs", []):
            runs.setdefault(c["name"], []).append(c)
        for name, rs in runs.items():
            c = best_run(rs)
            found.setdefault(name, c.get("conclusion") or c.get("status"))
    return found


def best_run(runs):
    """One head can carry several runs of one name (a draft's skipped `check` beside the ready
    PR's: a commit of 2026-10-19 listed skipped before success). A success if any, else the
    newest completed, else the first listed."""
    ok = [r for r in runs if r.get("conclusion") == "success"]
    if ok:
        return ok[0]
    done = [r for r in runs if r.get("status") == "completed"]
    if done:
        return max(done, key=lambda r: r.get("completed_at") or "")
    return runs[0]


def required(repo_slug, branch):
    ok, rsc = gh("repos/%s/branches/%s/protection/required_status_checks" % (repo_slug, branch))
    if not ok:
        return None, rsc
    return rsc, None


def main_ci(repo):
    """ci.json as main has it ({} when it has none)."""
    shown = subprocess.run(["git", "-C", repo, "show", "%s:.github/ci.json" % main_branch(repo)],
                           capture_output=True, text=True)
    if shown.returncode == 0:
        try:
            ci = json.loads(shown.stdout)
            return ci if isinstance(ci, dict) else {}
        except ValueError:
            pass
    return {}


def live_replaces(repo):
    """ci.json's `replaces` while they may still be required on GitHub: the names this branch's
    switches replaced. Once a switch lands its --protect has run (the order above), so the list
    main carries is spent: a branch whose ci.json is main's drops none of it, and a switch does not
    carry it on. Else the list only grew, and a name once replaced was swapped out of protection
    for good, even when a later job reused it (review 2026-10-19, 7)."""
    ci = load_ci(repo)
    if ci == main_ci(repo):
        return set()
    return set(ci.get("replaces", []))


def stale_contexts(repo):
    """Every provider's check name, the context main's ci.json names and this branch's replaced
    ones: what a swap replaces."""
    drop = set(CONTEXT.values()) | {main_ci(repo).get("context")} | live_replaces(repo)
    drop.discard(None)
    return drop


def protect(repo, force, dry):
    provider, why = provider_on_disk(repo, runner_labels(required=False))
    if provider not in CONTEXT:
        raise Refusal("no provider on disk (%s)" % why)
    want = required_context(repo, provider)
    s, main = slug(repo), main_branch(repo)
    rsc, err = required(s, main)
    if rsc is None:
        raise Refusal("could not read %s %s's required checks: %s" % (s, main, err))
    have = rsc.get("contexts") or []
    new = swap_contexts(have, want, stale_contexts(repo) | stale_matrix(repo, have))
    if set(new) == set(have):
        print("%s %s already requires %r" % (s, main, want))
        return
    head = git(repo, "rev-parse", "HEAD")
    seen = statuses(s, head)
    if seen.get(want) != "success" and not force:
        # a skipped `check` (a draft's) is no report, though GitHub counts it as passed: the order
        # above has the PR leave draft first
        raise Refusal("%r has not reported success on this checkout's HEAD %s (saw: %s); push and "
                      "let it run first%s, or --force" % (
                          want, head[:12], seen or "nothing",
                          " (check.yml skips a draft PR: `gh pr ready` it)"
                          if provider in ACTIONS_KINDS else ""))
    # `checks` whenever GitHub answers with it, so each kept check keeps its app_id pin
    pins = pins_of(rsc)
    def body_of(names):
        if "checks" in rsc:
            return {"strict": bool(rsc.get("strict")), "checks": checks_of(names, pins)}
        return {"strict": bool(rsc.get("strict")), "contexts": names}
    url = "repos/%s/branches/%s/protection/required_status_checks" % (s, main)
    print("%s %s: required %s → %s" % (s, main, have, new))
    if dry:
        print("  (dry run: nothing changed)")
        return
    ok, out = gh("-X", "PATCH", url, data=body_of(new))
    if not ok:
        raise Refusal("GitHub refused: %s" % out)
    back, err = required(s, main)
    kept = {n: a for n, a in pins.items() if n in new and a is not None}
    if (back is None or set(back.get("contexts") or []) != set(new)
            or any(pins_of(back).get(n) != a for n, a in kept.items())):
        raise Refusal("read back %s, not %r%s" % (back and (back.get("checks") or back.get("contexts")),
                                                  new, " with pins %s" % kept if kept else ""))
    print("  read back: %s" % back.get("contexts"))
    print("  rollback: echo '%s' | gh api -X PATCH %s --input -" % (json.dumps(body_of(have)), url))


def status(repo):
    labels = runner_labels(required=False)
    provider, why = provider_on_disk(repo, labels)
    print("%s: %s (%s)" % (repo, provider or "none", why))
    for f in (".github/ci.json", ".github/workflows/check.yml", ".circleci/parts/check.yml",
              ".circleci/config.yml", ".github/main-protection.json", ".github/workflows/automerge.yml"):
        print("  %-34s %s" % (f, "present" if os.path.exists(p(repo, f)) else "-"))
    if provider == SELF:
        # read here, before GitHub: what the job runs as the runner's login (2026-10-21)
        wf = p(repo, ".github", "workflows", "check.yml")
        text = read(wf) if os.path.isfile(wf) else ""
        if text and not GIT_GUARD.search(text):
            print("  ⚠ check.yml sets no GIT_CONFIG_GLOBAL: a `git config --global` in its job rewrites "
                  "the runner login's own; `ci-provider %s --to %s` adds the step (with --check "
                  "and --force on a hand-edited file)" % (repo, SELF))
        if text and publishes_workflows(repo) and not runs_on_var(text):
            print("  ⚠ check.yml is published (its allowlist lists it) and its runs-on "
                  "names the runner Mac's labels: `ci-provider %s --to %s` writes the variable form"
                  % (repo, SELF))
        try:
            cmd = check_command(repo, None)
        except Refusal:
            cmd = ""
        say_host_writes(host_writes(repo, cmd, labels, own=True))
    try:
        s = slug(repo)
    except Refusal as e:
        print("  " + str(e))
        return
    main = main_branch(repo)
    rsc, err = required(s, main)
    print("  GitHub %s requires: %s" % (main, rsc.get("contexts") if rsc else "(unread: %s)" % err))
    if provider in CONTEXT and rsc:
        want = required_context(repo, provider)
        have = rsc.get("contexts") or []
        if set(swap_contexts(have, want, stale_contexts(repo) | stale_matrix(repo, have))) != set(have):
            print("  ⚠ protection differs from the files: `ci-provider %s --protect` once %r reports" % (repo, want))
    for label, ref in (("HEAD", git(repo, "rev-parse", "HEAD")), (main, main)):
        seen = statuses(s, ref)
        print("  reported on %s: %s" % (label, ", ".join("%s=%s" % kv for kv in sorted(seen.items())) or "nothing"))
    if provider == SELF:
        # the runners API only here: it needs admin rights, and an actions repo has no runner
        runners = show_runners(s)
        want = wanted_labels(repo, s, labels)
        if runners is not None and want and not any(runs_check(r, want) for r in runners):
            print("  ⚠ no online runner labelled %s: the check queues and never reports; "
                  "`ci-provider %s --runner install`" % (", ".join(want), repo))
        try:
            if not is_private(s):
                print("  ⚠ %s is public and runs on the runner Mac: a fork's PR would run there; "
                      "`ci-provider %s --to actions` now" % (s, repo))
            elif runs_fork_prs(s):
                print("  ⚠ %s runs fork pull requests' workflows and runs on the runner Mac: a fork's PR "
                      "would run there; turn that off, or `ci-provider %s --to actions` now" % (s, repo))
        except Refusal as e:
            print("  ⚠ %s" % e)


# --- the runner on the runner Mac -----------------------------------------------------------

def wanted_labels(repo, s, labels):
    """The labels the repo's check asks for, said as status reads them: its check.yml's literal
    runs-on, or the repository variable it reads (unset: hosted, nothing to ask for), else the
    labels key's (labels, None when absent); None when none is known."""
    wf = p(repo, ".github", "workflows", "check.yml")
    text = read(wf) if os.path.isfile(wf) else None
    var = runs_on_var(text)
    if var and full_form(text):
        # the split form's other half: a push, the nightly run and a hand start queue for good where
        # no online runner carries it, while the pull requests' variable looks healthy (review 2026-10-27)
        full, err = variable(s, var + "_FULL")
        if err:
            print("  runs-on variable %s_FULL: (unread: %s)" % (var, err))
        elif full is None:
            print("  runs-on variable %s_FULL is unset: a push, the nightly run and a hand start take "
                  "%s's labels too" % (var, var))
        else:
            print("  runs-on variable %s_FULL (a push, the nightly run, a hand start): %s" % (var, full))
            try:
                want = json.loads(full)
            except ValueError:
                want = None
            runners, _ = runners_of(s)
            if not isinstance(want, list) or not all(isinstance(l, str) for l in want):
                print("  ⚠ runs-on variable %s_FULL is not a JSON label list: check.yml's fromJSON "
                      "fails on a push, the nightly run and a hand start" % var)
            elif runners is not None and not any(runs_check(r, want) for r in runners):
                print("  ⚠ no online runner labelled %s: a push, the nightly run and a hand start queue "
                      "until one is" % ", ".join(want))
    if var:
        automerge_runner(repo, s, var)
        value, err = variable(s, var)
        if err:
            print("  runs-on variable %s: (unread: %s)" % (var, err))
            return None
        if value is None:
            print("  ⚠ runs-on variable %s is unset: the check runs on ubuntu-latest, hosted; "
                  "`ci-provider %s --runner install` sets it" % (var, repo))
            return None
        print("  runs-on variable %s: %s" % (var, value))
        try:
            asked = json.loads(value)
        except ValueError:
            asked = None
        if isinstance(asked, str):
            # fromJSON of a string is one runs-on name, a hosted image as the variable's own
            # default is: no self-hosted runner asked for, so no runner to warn about (review
            # 2026-10-21, 10)
            print("  runs-on variable %s is one name, not a label list: a hosted runner, none of "
                  "the runner Mac's" % var)
            return None
        if not isinstance(asked, list) or not all(isinstance(l, str) for l in asked):
            print("  ⚠ runs-on variable %s is not a JSON label list: check.yml's fromJSON fails" % var)
            return None
        return tuple(asked)
    # a literal naming no `self-hosted`, or a block list, before the key: a runner carrying
    # capabilities no longer carries the key's own label
    lists = literal_runs_on([("check.yml", text or "")])
    if any(l is None for _, _, l, _ in lists) or any(by_variable(v) for _, v in runs_on_lines(text)):
        return None   # a shape read here, or a variable this tool did not write: nothing claimed
    other = next((l for _, _, l, _ in lists if l and not hosted_name(l)), None)
    return literal_labels(text, labels) or other or labels


def automerge_runner(repo, s, var):
    """Where automerge.yml runs, said when its runs-on reads <var>_AUTOMERGE: unset, it takes the
    check's runners and waits in their queue behind hour-long checks (a 10-second job started 33 min
    after its PR's check passed; docs/ci-queue-health-2026-10-27.md)."""
    wf = p(repo, ".github", "workflows", "automerge.yml")
    name = var + "_AUTOMERGE"
    if not (os.path.isfile(wf) and ("vars." + name) in read(wf)):
        return
    value, err = variable(s, name)
    if err:
        print("  runs-on variable %s: (unread: %s)" % (name, err))
    elif value is None:
        print("  runs-on variable %s is unset: automerge.yml takes %s's runners, queued behind the checks"
              % (name, var))
    else:
        print("  runs-on variable %s (automerge.yml): %s" % (name, value))


def runners_of(s):
    """The repo's self-hosted runners from GitHub, or None when unread (it needs admin rights:
    gh_read, so the desk's read token serves where the login cannot)."""
    ok, out = gh_read("repos/%s/actions/runners" % s)
    if not ok or not isinstance(out, dict):
        return None, out
    return out.get("runners") or [], None


def labels_of(r):
    return [l.get("name", "") for l in r.get("labels") or []]


def runs_check(r, labels):
    """An online runner with every label check.yml's runs-on asks for."""
    have = {l.lower() for l in labels_of(r)}
    return r.get("status") == "online" and all(l.lower() in have for l in labels)


def show_runners(s):
    runners, err = runners_of(s)
    if runners is None:
        print("  runners: (unread: %s)" % err)
    elif not runners:
        print("  runners: none")
    for r in runners or []:
        print("  runner %s: %s%s, labels %s" % (r.get("name"), r.get("status"),
                                                ", busy" if r.get("busy") else "",
                                                ", ".join(labels_of(r))))
    return runners


class Target:
    """Which runner a --runner verb acts on: the runner Mac's ssh alias, the labels it registers,
    its name on GitHub and its instance. The keys give one runner Mac; --host, --labels and --name
    name another, so a fleet of them serves one repo, each under one shared label. --instance N
    (2 and up) is a further runner of the same repo on the same Mac, named and kept apart with
    `-N` (the build Mac's second regatta runner was installed by hand that way, 2026-10-23)."""

    def __init__(self, host, labels, name=None, instance=1):
        self.host, self.labels, self.instance = host, labels, instance
        self.route = None   # the labels a variable may route on, where a label kept beside them may not
        base = name or own_labels(labels)[0]
        self.name = base if instance == 1 else "%s-%d" % (base, instance)


def runner_asset(arch, system="Darwin"):
    """The pinned build for the runner host's `uname -m` and `uname -s`: (url, size, sha256). Read at
    call time, so a suite's swap of a pin holds."""
    if system == "Linux":
        if arch == "x86_64":
            return RUNNER_LINUX_X64_URL, RUNNER_LINUX_X64_SIZE, RUNNER_LINUX_X64_SHA256
        if arch in ("aarch64", "arm64"):
            return RUNNER_LINUX_ARM64_URL, RUNNER_LINUX_ARM64_SIZE, RUNNER_LINUX_ARM64_SHA256
        raise Refusal("the Linux host's `uname -m` is %r: no runner build is pinned for it (x86_64, aarch64)"
                      % arch)
    if system != "Darwin":
        raise Refusal("the runner host's `uname -s` is %r: a runner is installed on macOS or Linux only" % system)
    if arch == "arm64":
        return RUNNER_URL, RUNNER_SIZE, RUNNER_SHA256
    if arch == "x86_64":
        return RUNNER_X64_URL, RUNNER_X64_SIZE, RUNNER_X64_SHA256
    raise Refusal("the runner Mac's `uname -m` is %r: no runner build is pinned for it (arm64, x86_64)"
                  % arch)


def linux_labels(labels):
    """Whether a runner's labels make it a Linux one: `Linux` among them (labels ignore case). The probe's
    `uname -s` must agree before anything is minted or written."""
    return "linux" in lowered(labels)


def runner_dir(s, instance=1):
    """Under the runner user's home: one directory per repo, as a runner serves one repo;
    owner then repo, so `a-b/c` and `a/b-c` cannot share one; `<repo>-N` for instance N."""
    return "actions-runners/" + s + ("" if instance == 1 else "-%d" % instance)


def flat_runner_dir(s, instance=1):
    """Where an install before 2026-10-19 put it (two runners, <owner>-<repo>); RUNNER_SH
    uses it while its .runner names this repo, so status and remove still find those two.
    A further instance was never flat: its own directory."""
    return "actions-runners/" + s.replace("/", "-") if instance == 1 else runner_dir(s, instance)


# Run by bash on the runner host, its arguments in argv and nothing secret among them: the token, when the
# verb needs one, is the first line of stdin. No `set -x`: it would echo the token's expansion. macOS and
# Linux alike (linux-runner, 2026-11-04): a size by wc, a digest by sha256sum or shasum. The service is the
# runner's own svc.sh on macOS, a LaunchAgent; on Linux a rootless container (D1-C), its image, entry and
# quadlet unit in $10-$12 (install only), under the login's systemd user instance: no sudo on either road
RUNNER_SH = r'''set -euo pipefail
verb=$1 slug=$2 dir=$HOME/$3 flat=$HOME/$4 url=$5 size=$6 sha=$7 name=$8 label=$9
containerfile=${10:-} entry=${11:-} unit=${12:-}
system=$(uname -s)
ctr=ci-runner-$name
qdir=${XDG_CONFIG_HOME:-$HOME/.config}/containers/systemd
# a runner installed before 2026-10-19 lives in the flat <owner>-<repo>: kept while its .runner (config.sh's
# settings, gitHubUrl among them) names this repo, so another repo's flat directory of
# the same spelling (a-b/c beside a/b-c) is never taken for it
if grep -qiF "github.com/$slug\"" "$flat/.runner" 2>/dev/null; then dir=$flat; fi
# a further instance's <repo>-N may be another repo's own directory, either way round (acme/demo's 2nd
# beside acme/demo-2's 1st): acted on only while its .runner, where there is one, names this repo. A
# repo renamed on GitHub after its install trips it too: reinstall under the new name
if [ -s "$dir/.runner" ] && ! grep -qiF "github.com/$slug\"" "$dir/.runner"; then
  echo "$dir holds another repo's runner, not $slug's: nothing done" >&2; exit 5
fi
dist=$HOME/actions-runners/.dist
tgz=$dist/${url##*/}
size_of() { if [ -f "$1" ]; then wc -c < "$1" | tr -d ' '; else echo 0; fi; }
sha_ok() {   # by what the host has, never its name: a Mac's shasum, and a Linux without perl has GNU's sha256sum
  if command -v shasum >/dev/null 2>&1; then echo "$sha  $1" | shasum -a 256 -c --status -
  else echo "$sha  $1" | sha256sum -c --status -; fi
}
# what a rootless runner container needs of a Linux host, one `lacks <what>` a line, each the owner's to give
# with sudo before an install: podman; a user namespace AppArmor allows (Ubuntu's apparmor package ships the
# profile for /usr/bin/podman that grants it); subordinate uid and gid ranges in it (/etc/subuid and /etc/subgid,
# with uidmap's newuidmap and newgidmap: podman 4.9 refuses a namespace whose ranges it cannot map, and with one
# id alone the image's runner user cannot exist); a rootless network helper; linger, so the unit runs with no
# login; the user instance. Read as the effect (the namespace's maps) where there is one
idmap() { m=$(podman unshare cat "/proc/self/$1" 2>/dev/null || true); printf '%s\n' "$m" | grep -c . || true; }
lacks() {
  [ "$system" = Linux ] || return 0
  if ! podman --version >/dev/null 2>&1; then echo "lacks podman"
  else
    nu=$(idmap uid_map) ng=$(idmap gid_map)
    if [ "$nu" = 0 ] || [ "$ng" = 0 ]; then
      if ! command -v newuidmap >/dev/null 2>&1 || ! command -v newgidmap >/dev/null 2>&1; then echo "lacks uidmap"
      else echo "lacks userns"; fi
    elif [ "$nu" = 1 ] || [ "$ng" = 1 ]; then echo "lacks subuids"; fi
  fi
  command -v slirp4netns >/dev/null 2>&1 || echo "lacks network"
  [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || true)" = yes ] || echo "lacks linger"
  systemctl --user show-environment >/dev/null 2>&1 || echo "lacks user-systemd"
}
# another runner on this Linux host, any repo's: one runner a Linux host, so one job at a time and a suite
# never starves the sessions it runs beside. A configured directory, else another runner's unit. No pipe:
# under pipefail an early-closing reader fails
other_runner() {
  [ "$system" = Linux ] || return 0
  o=$(find "${dist%/.dist}" -mindepth 2 -maxdepth 3 -name .runner ! -path "$dir/.runner" -print -quit 2>/dev/null || true)
  [ -n "$o" ] || o=$(find "$qdir" -maxdepth 1 -name 'ci-runner-*.container' ! -name "$ctr.container" -print -quit 2>/dev/null || true)
  printf '%s' "${o%/.runner}"
}
# the pinned build, once for every repo's runner, kept only when its size and SHA-256 are the pinned ones
fetch_tgz() {
  if [ "$(size_of "$tgz")" != "$size" ]; then
    echo "downloading ${url##*/}"
    curl -fsSL --retry 2 -o "$tgz.part" "$url"
    mv "$tgz.part" "$tgz"
  fi
  got=$(size_of "$tgz")
  if [ "$got" != "$size" ]; then echo "$tgz: $got bytes, not $size; removed" >&2; rm -f "$tgz"; exit 3; fi
  if ! sha_ok "$tgz"; then
    echo "$tgz: SHA-256 is not $sha; removed" >&2; rm -f "$tgz"; exit 3
  fi
}
# the registration is the state volume's .runner; the copy in $dir (the slug check's) counts only beside it, so a
# lost volume reads as not configured, and the install mints a token and registers again (config.sh --replace)
linux_registered() {
  [ -f "$dir/.runner" ] || return 1
  mp=$(podman volume inspect --format '{{.Mountpoint}}' "$ctr-state" 2>/dev/null) || return 1
  podman unshare test -f "$mp/.runner"
}
refuse_lacks() {
  l=$(lacks)
  if [ -n "$l" ]; then printf '%s\n' "$l" >&2; echo "a rootless runner container needs them: nothing done" >&2; exit 6; fi
}
# remove, on Linux: nothing touched before the refusals (the image a registration needs to leave GitHub, its
# token); then the unit (a job running is cut, as svc.sh's uninstall cuts one), config.sh remove in a container of
# the image where there is a registration, and the volume and the image
linux_remove() {
  refuse_lacks
  reg=
  if linux_registered; then reg=1; fi
  if [ -n "$reg" ] && ! podman image exists "localhost/$ctr"; then
    echo "the image localhost/$ctr is gone: --runner install rebuilds it (the registration kept), then remove; nothing touched" >&2; exit 9
  fi
  if [ -n "$reg" ]; then
    IFS= read -r token || true
    if [ -z "${token:-}" ]; then echo "no remove token on stdin" >&2; exit 4; fi
  fi
  systemctl --user stop "$ctr.service" 2>/dev/null || true
  rm -f "$qdir/$ctr.container"
  systemctl --user daemon-reload
  if [ -n "$reg" ]; then
    printf '%s\n' "$token" | podman run --rm -i -v "$ctr-state:/state:U" "localhost/$ctr" remove
    unset token
  else
    echo "the state volume holds no registration: nothing deregistered from here"
  fi
  podman volume rm "$ctr-state" >/dev/null 2>&1 || true
  podman rmi "localhost/$ctr" >/dev/null 2>&1 || true
  # the directory is the repo's, the unit and volume the name's: its .runner goes only where it is this runner's
  # (a registration in this name's volume says nothing of whose .runner the directory holds: another name's may)
  if grep -qF "\"agentName\": \"$name\"" "$dir/.runner" 2>/dev/null; then rm -f "$dir/.runner"; fi
  echo "removed; $dir stays (the image's build context)"
}
# A Linux runner (D1-C): the image built before anything is registered, so a failed build leaves no runner on
# GitHub; the registration in the state volume, its .runner copied here (the probe's and the slug check's);
# then the quadlet unit, started unless active (a unit its exit 3 stopped is reset first).
# An active unit is never restarted, as a restart would cut a job: the container waiting now keeps the old image
# and runs the next job, and the rebuilt image and rewritten unit serve the job after it. Dangling images no container
# uses are pruned, by the image's label as the login's podman may hold others', so an old one in use goes at a later install: one at most.
# A token on stdin registers whatever the volume holds (config.sh --replace): the caller sends one when GitHub lists
# no runner of this name, a registration it deleted; a unit still active then is stopped first, so no listener keeps
# the key the registration replaces (GitHub listing no such runner, it runs no job)
linux_install() {
  o=$(other_runner)
  if [ -n "$o" ] && [ ! -f "$dir/.runner" ]; then
    echo "$o holds a runner already: one runner a Linux host, one job at a time" >&2; exit 7
  fi
  refuse_lacks
  mkdir -p "$dist" "$dir" "$qdir"
  cd "$dir"
  reg=
  if linux_registered; then reg=1; fi
  IFS= read -r token || true
  if [ -n "${token:-}" ]; then reg=
  elif [ -z "$reg" ]; then echo "no registration token on stdin" >&2; exit 4; fi
  fetch_tgz
  rm -rf image
  mkdir image
  printf '%s' "$containerfile" > image/Containerfile
  printf '%s' "$entry" > image/entry.sh
  cp "$tgz" image/runner.tar.gz
  podman build -q -t "localhost/$ctr" image
  rm -f image/runner.tar.gz
  podman image prune -f --filter label=ci-provider.runner >/dev/null
  if [ -z "$reg" ]; then
    # unguarded: is-active reads a unit waiting out RestartSec as inactive, and a stop cancels that restart too
    systemctl --user stop "$ctr.service" 2>/dev/null || true
    podman volume create --ignore "$ctr-state" >/dev/null
    # printf is bash's own: the token reaches the container's stdin and no process's argv
    printf '%s\n' "$token" | podman run --rm -i -v "$ctr-state:/state:U" "localhost/$ctr" \
      configure "https://github.com/$slug" "$name" "$label"
    podman run --rm -v "$ctr-state:/state:ro" --entrypoint cat "localhost/$ctr" /state/.runner > .runner.new
    mv .runner.new .runner
  fi
  unset token || true
  printf '%s' "$unit" > "$qdir/$ctr.container.new"
  mv "$qdir/$ctr.container.new" "$qdir/$ctr.container"
  systemctl --user daemon-reload
  if ! systemctl --user is-active --quiet "$ctr.service"; then
    systemctl --user reset-failed "$ctr.service" 2>/dev/null || true
    systemctl --user start "$ctr.service"
  fi
  # systemctl exits 3 for a unit that is not active: a state to report, never a failed read
  systemctl --user --no-pager status "$ctr.service" || { rc=$?; echo "the unit is not active (systemctl status exit $rc)"; }
}
case $verb in
probe)
  # whether a token is needed: install mints one only when not configured, remove only when it is;
  # the host's architecture and system, which pick the build install fetches; on Linux, another runner
  if [ "$system" = Linux ]; then
    if linux_registered; then
      state=configured
      podman image exists "localhost/$ctr" || noimage=1
    else state=absent; fi
  elif [ -f "$dir/.runner" ]; then state=configured; else state=absent; fi
  echo "$state $(uname -m) $system $dir"
  o=$(other_runner)
  if [ -n "$o" ]; then echo "other $o"; fi
  if [ -n "${noimage:-}" ]; then echo noimage; fi
  lacks
  ;;
install)
  if [ "$system" = Linux ]; then linux_install; exit 0; fi
  mkdir -p "$dist" "$dir"
  cd "$dir"
  if [ -f .runner ]; then
    echo "configured already: $dir"
  else
    IFS= read -r token || true
    if [ -z "${token:-}" ]; then echo "no registration token on stdin" >&2; exit 4; fi
    fetch_tgz
    tar xzf "$tgz"
    # config.sh sources env.sh, which freezes this PATH into .path for every job: ssh's bare one
    # lacks Homebrew, which hosted macOS images have (gtar for upload-pages-artifact, say)
    # (Apple silicon's prefix, or an Intel Mac's, which ssh's PATH lacks as well)
    for d in /usr/local /opt/homebrew; do
      if [ -x "$d/bin/brew" ]; then PATH=$d/bin:$d/sbin:$PATH; fi
    done
    # the runner reads ACTIONS_RUNNER_INPUT_TOKEN and unsets it: the token stays out of ps' argv
    ACTIONS_RUNNER_INPUT_TOKEN=$token ./config.sh --unattended --replace \
      --url "https://github.com/$slug" --name "$name" --labels "$label" --work _work
  fi
  unset token || true
  # config.sh freezes the caller's LANG into .env, which every job reads. A locale this Mac lacks
  # (C.UTF-8, which macOS 12 has not, from a newer Mac's ssh) puts every job in C, where bash's
  # printf %q escapes each non-ASCII character (the 2016 laptop's first job, 2026-10-27). Such a
  # LANG, fresh or from an earlier install, becomes an installed UTF-8 one, and the service restarts
  # (an empty or absent LANG is C too). The list read once, into a variable: `locale -a | grep -q`
  # under pipefail fails when grep stops reading early, which would call an installed LANG missing.
  # (A Linux runner's container sets its own LANG, C.UTF-8, in the image: it never reaches this)
  relang=
  have=
  if [ -f .env ]; then have=$(sed -n 's/^LANG=//p' .env | head -1); fi
  locales=$(locale -a 2>/dev/null || true)
  if [ -z "$have" ] || ! grep -qxF "$have" <<<"$locales"; then
    for l in en_US.UTF-8 C.UTF-8; do
      if grep -qxF "$l" <<<"$locales"; then
        if grep -q '^LANG=' .env 2>/dev/null; then sed "s/^LANG=.*/LANG=$l/" .env > .env.new && mv .env.new .env
        else printf 'LANG=%s\n' "$l" >> .env; fi
        echo "LANG ${have:-(none)} is no locale here: $l (a job running now is cut by the restart)"
        relang=1; break
      fi
    done
    [ -n "$relang" ] || echo "⚠ LANG ${have:-(none)} is no locale here and neither en_US.UTF-8 nor C.UTF-8 is installed: jobs run in C" >&2
  fi
  # svc.sh's install refuses an existing plist, and `launchctl load` a loaded one; grep without
  # -q reads to the end, so pipefail never sees launchctl die of SIGPIPE
  [ -f .service ] || ./svc.sh install
  svc=$(basename "$(cat .service)" .plist)
  if [ -n "$relang" ] && launchctl list | grep -F "$svc" >/dev/null; then
    # started at once, never by re-reading the list, where a stopped job may still show a moment;
    # two commands, so a failing stop ends the install under set -e (an `&&` would let it pass)
    ./svc.sh stop
    ./svc.sh start
  fi
  launchctl list | grep -F "$svc" >/dev/null || ./svc.sh start
  ./svc.sh status
  ;;
status)
  if [ ! -f "$dir/.runner" ]; then echo "not configured: $dir"; exit 0; fi
  cd "$dir"
  if [ "$system" = Linux ]; then
    if ! linux_registered; then echo "the state volume $ctr-state holds no registration: --runner install registers again"; fi
    if [ ! -f "$qdir/$ctr.container" ]; then echo "configured, no unit installed: $dir"; exit 0; fi
    # systemctl exits 3 for a unit that is not active: a state to report, never a failed read
    systemctl --user --no-pager status "$ctr.service" || { rc=$?; echo "the unit is not active (systemctl status exit $rc)"; }
  else
    ./svc.sh status
  fi
  ;;
remove)
  if [ "$system" = Linux ]; then
    if [ ! -f "$dir/.runner" ] && [ ! -f "$qdir/$ctr.container" ]; then echo "not configured: $dir"; exit 0; fi
    linux_remove; exit 0
  fi
  if [ ! -f "$dir/.runner" ]; then echo "not configured: $dir"; exit 0; fi
  IFS= read -r token || true
  if [ -z "${token:-}" ]; then echo "no remove token on stdin" >&2; exit 4; fi
  cd "$dir"
  if [ -f .service ]; then
    # svc.sh's uninstall stops first and gives up when the agent is not loaded
    plist=$(cat .service)
    ./svc.sh uninstall || { launchctl unload "$plist" 2>/dev/null || true; rm -f "$plist" .service; }
  fi
  ACTIONS_RUNNER_INPUT_TOKEN=$token ./config.sh remove
  unset token
  echo "removed; $dir stays (a reinstall unpacks over it)"
  ;;
esac
'''


def variable_value(labels):
    """The variable's value for these labels: a compact JSON list, as GitHub's UI shows one; a
    hosted image's one name (the pick's hosted lane) is a JSON string, as the default is."""
    if isinstance(labels, str):
        return json.dumps(labels)
    return json.dumps(list(labels), separators=(",", ":"))


def variable(s, name):
    """(value, None) for a repository variable; (None, None) when GitHub has none of that name,
    which only its 404 says; (None, error) for any other answer, a gh failure with no output among
    them (review 2026-10-21, 7): unread is never taken for absent, or a write would follow."""
    ok, out = gh("repos/%s/actions/variables/%s" % (s, name))
    if ok:
        if isinstance(out, dict) and isinstance(out.get("value"), str):
            return out["value"], None
        return None, "no value in %r" % (out,)
    if "HTTP 404" in str(out):
        return None, None
    return None, out or "gh failed with no output"


def same_labels(value, labels):
    try:
        return json.loads(value) == (labels if isinstance(labels, str) else list(labels))
    except (TypeError, ValueError):
        return False


def set_variable(s, name, labels, dry, raw=False):
    """The runs-on variable set to labels and read back: POST when GitHub has none of that name,
    PATCH when it holds another value (REST "Actions variables", read 2026-10-20). Returns the
    call that undoes the write, None when nothing was written. raw: labels is the value as written,
    a plain word (the share's `true`), never a JSON list."""
    want = labels if raw else variable_value(labels)
    have, err = variable(s, name)
    if err:
        raise Refusal("could not read %s's variable %s: %s" % (s, name, err))

    def same(v):
        return v == want if raw else same_labels(v, labels)
    if have is not None and same(have):
        print("  variable %s already %s" % (name, have))
        return None
    if dry:
        print("  would %s variable %s: %s → %s" % ("create" if have is None else "update", name,
                                                   have, want))
        return None
    body = {"name": name, "value": want}
    if have is None:
        ok, out = gh("-X", "POST", "repos/%s/actions/variables" % s, data=body)
    else:
        ok, out = gh("-X", "PATCH", "repos/%s/actions/variables/%s" % (s, name), data=body)
    if not ok:
        raise Refusal("GitHub refused variable %s: %s" % (name, out))
    back, err = variable(s, name)
    if back is None or not same(back):
        raise Refusal("variable %s read back %s, not %s" % (name, back if back is not None else err, want))
    print("  variable %s: %s (read back)" % (name, back))
    if have is not None:
        undo = ("gh api -X PATCH repos/%s/actions/variables/%s -f name=%s -f value=%s"
                % (s, name, name, shlex.quote(have)))
    else:
        # created: undone by removing it, which sends the check back to ubuntu-latest (review
        # 2026-10-21, 17)
        undo = "gh api -X DELETE repos/%s/actions/variables/%s" % (s, name)
    print("  rollback: " + undo)
    return undo


def runner_token(s, kind):
    """A registration or remove token (an hour's life). Returned to be written to ssh's stdin and
    nowhere else: no error message carries gh's stdout, which would be the token."""
    r = subprocess.run(["gh", "api", "-X", "POST", "repos/%s/actions/runners/%s-token" % (s, kind),
                        "--jq", ".token"], capture_output=True, text=True)
    tok = r.stdout.strip()
    if r.returncode != 0 or not re.match(r"^[A-Za-z0-9_.\-]+$", tok):
        raise Refusal("could not get a runner %s token for %s (gh exit %d: %s)"
                      % (kind, s, r.returncode, r.stderr.strip()[:200] or "no token"))
    return tok


def ssh_runner(verb, s, t, token=None, capture=False, asset=None, files=()):
    """RUNNER_SH on the runner Mac (t.host: the key's ssh alias, or --host's): the script and its arguments in
    ssh's argv, the token on stdin. The return code, or with capture (probe) the code and stdout.
    The name, the labels and the build (asset, the arm64 pin unless given) are passed on every verb,
    as before; only install reads them, and a Linux install its image, entry and unit (files)."""
    url, size, sha = asset or runner_asset("arm64")   # any pin: probe, status and remove read none
    args = (verb, s, runner_dir(s, t.instance), flat_runner_dir(s, t.instance), url, str(size), sha,
            t.name, ",".join(own_labels(t.labels))) + tuple(files)
    remote = "bash -c %s ci-provider-runner %s" % (shlex.quote(RUNNER_SH),
                                                   " ".join(shlex.quote(a) for a in args))
    r = subprocess.run(["ssh", "-o", "ConnectTimeout=10", "-o", "BatchMode=yes", t.host, remote],
                       input=(token + "\n") if token else "", text=True,
                       stdout=subprocess.PIPE if capture else None)
    return (r.returncode, r.stdout or "") if capture else r.returncode


class Probe:
    """What the runner host reports before a token is minted: done (the repo's runner is configured), arch
    and system (`uname -m`, `uname -s`), other (another runner's directory or unit on a Linux host, which
    holds one) and lacks (what a Linux host lacks for a rootless runner container, in LACKS' words)."""

    def __init__(self, done, arch, system, other, lacks=(), noimage=False):
        self.done, self.arch, self.system, self.other, self.lacks = done, arch, system, other, list(lacks)
        self.noimage = noimage   # a Linux runner registered whose image is gone: remove needs it


# What each `lacks` word asks of the owner, with sudo, before a Linux install (Ubuntu's names)
LACKS = {
    "podman": "podman (apt-get install podman)",
    "uidmap": "the uidmap package (newuidmap and newgidmap: podman cannot map the login's subordinate ranges "
              "without them)",
    "userns": "an unprivileged user namespace for podman (Ubuntu's apparmor package ships the profile for "
              "/usr/bin/podman that allows one; else kernel.apparmor_restrict_unprivileged_userns)",
    "subuids": "a subordinate uid and gid range for the login (its lines in /etc/subuid and /etc/subgid)",
    "network": "slirp4netns, podman 4.9's rootless network (apt-get install slirp4netns)",
    "linger": "linger for the login (loginctl enable-linger <login>), so its unit runs with no session",
    "user-systemd": "the login's systemd user instance (systemctl --user)",
}


def configured(s, t):
    """The runner host's Probe: a token is minted only for a step that will use it (an hour's life, and one
    less in flight), and the build and the service follow the host's system."""
    rc, out = ssh_runner("probe", s, t, capture=True)
    lines = out.strip().splitlines() if rc == 0 else []
    words = lines[0].split(" ", 3) if lines else []
    if len(words) < 3 or words[0] not in ("configured", "absent"):
        raise Refusal("ssh %s exited %d (%s): could not read whether %s's runner is configured"
                      % (t.host, rc, out.strip()[:200] or "no output", s))
    other = next((l[len("other "):] for l in lines[1:] if l.startswith("other ")), None)
    lacks = [l[len("lacks "):] for l in lines[1:] if l.startswith("lacks ")]
    return Probe(words[0] == "configured", words[1], words[2], other, lacks, "noimage" in lines[1:])


def refuse_lacks(probe, host):
    if probe.system == "Linux" and probe.lacks:
        raise Refusal("%s lacks what a rootless runner container needs, the owner's to give with sudo first: %s; "
                      "nothing minted" % (host, "; ".join(LACKS.get(w, w) for w in probe.lacks)))


def served(s, value, name):
    """Registered runners other than `name` that carry every label the variable's value asks for,
    online or not (a fleet Mac asleep is still the fleet): while any does, an install leaves the
    variable. A runner list that cannot be read is a refusal, never "none serve it": a write would
    follow (review 2026-10-27)."""
    want = variable_labels(value, bare=False) if value else None
    if not want:
        return []
    runners, err = runners_of(s)
    if runners is None:
        raise Refusal("could not read %s's runners (%s), so not whether others serve the variable: "
                      "nothing written" % (s, err))
    return [r.get("name") for r in runners
            if r.get("name") != name and want <= {l.lower() for l in labels_of(r)}]


def wait_online(s, t):
    """Poll GitHub until the runner shows online (state, never a re-registration loop)."""
    name, labels = t.name, t.labels
    deadline = time.time() + RUNNER_WAIT
    while True:
        runners, err = runners_of(s)
        mine = [r for r in runners or [] if r.get("name") == name]
        if mine and runs_check(mine[0], labels):
            print("  GitHub: runner %s online, labels %s" % (name, ", ".join(labels_of(mine[0]))))
            return
        if time.time() >= deadline:
            raise Refusal("runner %s is not online on GitHub after %d s (%s): `ci-provider <repo> "
                          "--runner status`" % (name, RUNNER_WAIT,
                                                mine and mine[0].get("status") or err or "not listed"))
        time.sleep(5)


def no_variable(repo, text, labels):
    """Why --runner install sets no variable, when one might be expected: ci.json says self-hosted or
    the repo has a public twin, and check.yml reads none in this tool's form (review 2026-10-21,
    16). None when nothing needs saying."""
    try:
        on_self = kind_of(load_ci(repo).get("provider")) == SELF
    except Refusal:
        on_self = False
    if not (on_self or os.path.isdir(p(repo, ".helloworld"))):
        return None
    if text is None:
        why = "there is no .github/workflows/check.yml"
    elif own_runs_on(text, labels, needs_of(repo)):
        why = "check.yml's runs-on names the labels itself (the literal form)"
    else:
        values = [v for _, v in runs_on_lines(text)]
        why = "check.yml's runs-on (%s) reads no variable in this tool's form" % (
            "; ".join(values) or "none")
    return ("  no repository variable set: %s. A repo with a public twin takes the variable form: "
            "`ci-provider %s --to %s --runs-on-var %s`" % (why, repo, SELF, RUNS_ON_VAR))


def route_variable(s, var, t, dry):
    """The runs-on variable after an install: set to this runner's labels, unless it already asks
    for labels this runner carries (it joins the fleet the variable names: never narrowed to it), or
    for labels another registered runner carries. Then it routes the check somewhere that works, and
    a further runner Mac must not re-route it (the check would wait on the newcomer alone): left as
    it is, with the calls that would move it printed. t.route: a capped runner's capabilities, so a
    label kept for a literal never reaches the variable."""
    labels = t.route or t.labels
    have, err = variable(s, var)
    if err:
        raise Refusal("could not read %s's variable %s: %s" % (s, var, err))
    asked = variable_labels(have, bare=False) if have else None
    if asked and asked <= lowered(labels):
        print("  variable %s already routes to %s: %s carries its labels" % (var, have, t.name))
        return
    others = [] if have is None or same_labels(have, labels) else served(s, have, t.name)
    if not others:
        set_variable(s, var, labels, dry)
        return
    print("  variable %s left at %s: registered runner%s %s carr%s its labels. For %s to take the "
          "check too, give the others a shared label of this one's (gh api -X POST repos/%s/actions/"
          "runners/<id>/labels -f 'labels[]=<label>'), then point the variable at it: gh api -X PATCH "
          "repos/%s/actions/variables/%s -f name=%s -f value=%s"
          % (var, have, "" if len(others) == 1 else "s", ", ".join(others),
             "ies" if len(others) == 1 else "y", t.name, s, s, var, var,
             shlex.quote(variable_value(labels))))


LINUX_ROUTE = ("  no runs-on variable routed: a Linux runner takes %s's Linux share, whose suites check-linux.yml "
               "sends where CI_LINUX_RUNS_ON says; the pick sets it with CI_LINUX_TARGET and CI_LINUX_ELSEWHERE "
               "once a self-hosted Linux lane in lighthouse/ci-lanes.json names the repo (`--pick`)")


def runner(repo, verb, dry, host=None, labels=None, name=None, instance=1):
    s = slug(repo)
    # the keys before anything else, GitHub and ssh included: absent, a refusal naming the file.
    # Read once here and passed down (review 2026-10-21, 12); --host and --labels stand in for them
    given_host = host
    t = Target(runner_host(host), runner_labels(given=labels, named=name is not None), name, instance)
    # a Linux runner (its labels name Linux; the probe's `uname -s` must agree) takes the Linux share's
    # suites, which check-linux.yml routes by CI_LINUX_RUNS_ON and the pick sets: it registers by its
    # capabilities alone, one a host, and check.yml's own variable is never routed to it (linux-runner)
    linux = linux_labels(t.labels)
    if linux and instance > 1:
        raise Refusal("one runner a Linux host: a further instance would run two jobs at once beside the "
                      "host's sessions")
    if linux and not LINUX_NAME.match(t.name):
        raise Refusal("%r names a Linux runner's image, unit and volume: lower-case letters and digits, a `.`, "
                      "`_` or `-` only between them, at most 53" % t.name)
    wf = p(repo, ".github", "workflows", "check.yml")
    text = read(wf) if os.path.isfile(wf) else None
    # only the variable form this tool writes: a variable the file reads any other way is the
    # repo's own, never set here (review 2026-10-21, 3)
    var = runs_on_var(text)
    capped, kept, stays, key_labels = False, [], [], t.labels
    table = load_caps() if verb == "install" and (labels is None or linux) else None
    listed = table is not None and t.name in table
    if linux and verb == "install" and not listed:
        raise Refusal("a Linux runner registers by its capabilities, never a label of the host's own: list %s "
                      "in %s (its capabilities, e.g. the one CI_LINUX_RUNS_ON asks for)"
                      % (t.name, common.CONFIG / "wharf" / CAPS_KEY))
    # every list a job routes on, read as caps reads them: a fresh registration meets no other judge.
    # Fetched only where a write rests on it: elsewhere they word the warnings below
    texts = workflows(repo, remote=listed) if verb == "install" else []
    lists = literal_runs_on(texts)
    asked = [l for _, _, l, _ in lists if l]
    unread = [(f, v, x) for f, v, l, x in lists if l is None]
    if listed and linux:
        # its automatic labels (self-hosted, Linux) and its capabilities: no label of its own to keep, and
        # no runs-on variable it moves
        if not table[t.name]:
            raise Refusal("%s lists %s with no capabilities: a runner that takes no job; list one"
                          % (CAPS_KEY, t.name))
        t.route = capped_labels(t.name, t.labels, table)
        t.labels = t.route
        capped = True
    elif listed:
        # registered with what it can do (the capabilities' section): the labels key's automatic
        # labels and the table's capabilities. The Mac's own label only names it, unless a runs-on
        # still asks for it (`[self-hosted, macOS, <the Mac's label>]`, as --to self-hosted wrote before
        # 2026-10-31, or a file no reader here can judge that names it): that one stays beside them,
        # never instead of them, or no runner would carry it (the landing reviews, 2026-10-31 and 11-01)
        if not table[t.name]:
            raise Refusal("%s lists %s with no capabilities: a runner that takes no job; list one, "
                          "or give --labels" % (CAPS_KEY, t.name))
        # the variables a job routes on: a split form's _FULL, automerge's own. The one route_variable
        # moves holds its label only until it has moved
        moving = set()
        for other in routed_vars(texts):
            value, err = variable(s, other)
            if err:
                raise Refusal("could not read %s's variable %s (%s): nothing done" % (s, other, err))
            want = variable_labels(value) if value else set()
            if want is None:
                unread.append(("variable %s" % other, value, value))
            elif other == (var or "").upper():
                moving = want
            else:
                asked.append(want)
        wanted = {l.lower() for one in asked for l in one}
        own = [l for l in own_labels(t.labels) if l.lower() not in lowered(table[t.name])]
        kept = [l for l in own if l.lower() in wanted or any(names_label(x, l) for _, _, x in unread)]
        stays = [l for l in own if l.lower() in moving and l not in kept]
        t.route = capped_labels(t.name, t.labels, table)
        t.labels = t.route + tuple(kept)
        capped = True
        if kept:
            print("  %s keeps %s beside its capabilities: a runs-on still asks for it, and `--runner "
                  "caps` refuses to drop it until none does" % (t.name, ", ".join(kept)))
    host, labels, name = t.host, t.labels, t.name
    where = ("%s:~/%s" % (host, runner_dir(s, instance)) if instance > 1 else
             "%s:~/%s (or ~/%s, installed before 2026-10-19)" % (host, runner_dir(s), flat_runner_dir(s)))
    if verb == "status":
        print("%s's runner %s on the runner Mac (%s):" % (s, name, where))
        rc = ssh_runner("status", s, t)
        show_runners(s)
        if rc:
            raise Refusal("ssh %s exited %d" % (host, rc))
        return
    if verb == "install":
        refuse_forks(s, "a runner on the runner Mac")
        # another Mac than the keys' logs in as whoever --host says, never the key's user
        warn_writers(s, runner_user(given_host))
        none_set = None if var else no_variable(repo, text, key_labels)
        for f, v, _ in unread:
            print("  ⚠ %s's runs-on (%s) is no label list or variable this tool reads: not judged" % (f, v))
        # a Linux runner carries none of check.yml's runs-on: nothing it would leave queued
        uncarried = [] if linux else list(dict.fromkeys(
            l for one in asked if not hosted_name(one) for l in own_labels(one) if l.lower() not in lowered(labels)))
        if uncarried:
            # the literal form's capabilities: registered without them, a job may queue for good
            print("  ⚠ a runs-on asks for %s, which runner %s would not carry: unless another runner "
                  "does, list %s under %s in %s (or give --labels), or the job queues"
                  % (", ".join(uncarried), name, "it" if len(uncarried) == 1 else "them", name,
                     common.CONFIG / "wharf" / CAPS_KEY))
        if dry:
            system, archs = ("Linux", ("x86_64", "aarch64")) if linux else ("Darwin", ("arm64", "x86_64"))
            builds = "; ".join("%s %s (%d bytes, SHA-256 %s)" % ((arch,) + (u, z, h[:12]))
                               for arch in archs for u, z, h in [runner_asset(arch, system)])
            if linux:
                ctr = runner_container(name)
                print("would: ask the runner host whether it is configured, its `uname -m` and `uname -s` (Linux, "
                      "or refused) and whether it lacks what a rootless container needs (podman, a user namespace "
                      "with subordinate uids, a network helper, linger, the user instance: refused, naming each); if "
                      "not registered (or registered where GitHub's list names no such runner), "
                      "take a registration token (gh api -X POST repos/%s/actions/runners/registration-token), "
                      "and over ssh into %s: fetch that architecture's build once (%s), build the image "
                      "localhost/%s from it over %s (no sudo in it), config.sh --name %s --labels %s in a "
                      "container of it, the token on its stdin, into the volume %s-state; then the quadlet "
                      "unit %s.service, a rootless container a job (the listener's --once), no host mount, socket or "
                      "credential, in the login's app.slice at CPUWeight=20 beside the sessions' 100, Nice=10; "
                      "start; one runner on the host; then wait for it online on GitHub"
                      % (s, where, builds, ctr, RUNNER_IMAGE_BASE, name, ",".join(own_labels(labels)), ctr, ctr))
            else:
                print("would: ask the runner host whether it is configured, its `uname -m` and `uname -s` (%s, "
                      "or refused); if not configured, take a registration token (gh api -X POST repos/%s/"
                      "actions/runners/registration-token), and over ssh into %s: fetch that architecture's "
                      "build once (%s), unpack, config.sh --name %s --labels %s; svc.sh install and start; "
                      "then wait for it online on GitHub"
                      % (system, s, where, builds, name, ",".join(own_labels(labels))))
            if linux:
                print(LINUX_ROUTE % s)
            elif var:
                print("would then route the repository variable %s that check.yml's runs-on reads:"
                      % var)
                route_variable(s, var, t, dry=True)
            elif none_set:
                print(none_set)
            return
        print("%s: installing its runner %s in %s" % (s, name, where))
        probe = configured(s, t)
        done, arch, system, other = probe.done, probe.arch, probe.system, probe.other
        if (system == "Linux") != linux:
            # labels that say another system than the host's: registered, every job would queue on them
            raise Refusal("%s is %s, and the runner's labels %s: a Linux host's runner is labelled "
                          "self-hosted,Linux (with --name), a Mac's macOS; nothing done"
                          % (host, system, "name Linux" if linux else "do not name Linux"))
        if other and not done:
            raise Refusal("%s holds a runner already (%s): one runner a Linux host, so a suite never starves "
                          "its sessions; nothing minted" % (host, other))
        refuse_lacks(probe, host)
        # the build only for a fresh install: a configured runner fetches nothing. A Linux one rebuilds its
        # image on every install (the build cached, the tarball kept), so a reinstall takes a changed image
        asset = runner_asset(arch, system) if linux or not done else None
        files = linux_files(s, name) if linux else ()
        mint = not done
        if linux and done:
            # the volume's registration is only local state: a runner GitHub deleted (offline too long) reads
            # configured and stops its unit at exit 1 for good. GitHub's list decides; unread, the volume does
            # read here, not through runners_of: only a list GitHub says is whole (total_count) can say "none"
            ok, page = gh_read("repos/%s/actions/runners" % s)
            listed_runners = page.get("runners") or [] if ok and isinstance(page, dict) else None
            whole = listed_runners is not None and isinstance(page.get("total_count"), int)
            if not whole or page["total_count"] > len(listed_runners):
                listed_runners = None
            if listed_runners is not None and not any(r.get("name") == name for r in listed_runners):
                print("  GitHub lists no runner %s: registering it again (config.sh --replace)" % name)
                mint = True
        rc = ssh_runner("install", s, t, runner_token(s, "registration") if mint else None, asset=asset,
                        files=files)
        if rc:
            raise Refusal("ssh %s exited %d: the output above says where it stopped" % (host, rc))
        if done and capped:
            # a configured runner skips config.sh, so its labels are the ones it was registered
            # with: set them to the table's before waiting for them (landing review, 2026-10-31)
            # what the variable asks for stays until route_variable, below, has moved it
            caps(repo, False, only=name, keep=kept + stays, texts=texts)
        wait_online(s, t)
        # only now: set before the runner is online, every job would queue on it
        if linux:
            print(LINUX_ROUTE % s)
        elif var:
            route_variable(s, var, t, dry=False)
        elif none_set:
            print(none_set)
        if stays:
            # nothing else drops it, and a label kept for a moved variable routes on a host name
            # (landing review 2026-11-01)
            print("  %s still carries %s, which the variable asked for before it moved: `ci-provider %s "
                  "--runner caps` drops it once no runs-on asks for it" % (name, ", ".join(stays), repo))
        return
    if dry:
        print("would: if the runner host reports it configured, take a remove token, and over ssh in "
              "%s: %s" % (where, "stop and remove the unit %s.service, config.sh remove in a container of its "
                          "image, then its volume and image" % runner_container(name) if linux else
                          "svc.sh uninstall, config.sh remove"))
        return
    print("%s: removing its runner %s in %s" % (s, name, where))
    probe = configured(s, t)
    if linux and probe.system != "Linux":
        # Linux labels on another system: the runner there is not the one this call names (install refuses alike)
        raise Refusal("%s is %s, and the runner's labels name Linux: nothing removed" % (host, probe.system))
    linux = probe.system == "Linux"   # Mac labels on a Linux host (the keys'): the host says what it is
    if probe.done:
        refuse_lacks(probe, host)
    if linux and probe.other and not probe.done:
        # the runner directory is the repo's, the unit the name's: this name is not the runner the host holds
        raise Refusal("%s holds another runner (%s), not %s: nothing removed" % (host, probe.other, name))
    if probe.done and probe.noimage:
        raise Refusal("the image localhost/%s is gone: --runner install rebuilds it (the registration kept), then "
                      "remove; nothing minted" % runner_container(name))
    rc = ssh_runner("remove", s, t, runner_token(s, "remove") if probe.done else None)
    if rc:
        raise Refusal("ssh %s exited %d: the output above says where it stopped" % (host, rc))
    runners, list_err = runners_of(s)
    left = [r for r in runners or [] if r.get("name") == name]
    if runners is None:
        print("  GitHub's runner list unread (%s): whether %s is gone is not known here" % (list_err, name))
    elif left:
        # a runner whose directory was lost stays registered: the DELETE is printed, not run
        print("  GitHub still lists %s (%s): gh api -X DELETE repos/%s/actions/runners/%s"
              % (name, left[0].get("status"), s, left[0].get("id")))
    else:
        print("  GitHub: no runner %s left" % name)
    if linux:
        # said from what was done and what GitHub lists now: the pick judges the lane by the same list
        others = [r.get("name") for r in runners or [] if r.get("name") != name and "linux" in lowered(labels_of(r))]
        if runners is None and probe.done:
            print("  the Linux share: deregistered from here; GitHub's list unread, so `ci-provider %s --pick` "
                  "judges the lane" % repo)
        elif not probe.done or left:
            print("  the Linux share: nothing deregistered from here, so it stays where the pick put it "
                  "(`ci-provider %s --pick` judges the lane by GitHub's list)" % repo)
        elif others:
            print("  the Linux share: deregistered; %s still carr%s Linux labels, which the next pick judges the "
                  "lane by (`ci-provider %s --pick`)" % (", ".join(others), "ies" if len(others) == 1 else "y", repo))
        else:
            print("  the Linux share: deregistered, no runner carries its lane's labels, so the next pick takes the "
                  "share off that lane (`ci-provider %s --pick`)" % repo)
    elif var:
        # what the variable holds, read, never assumed (review 2026-10-21, 9). Left set, jobs queue
        # for a runner that is gone; deleting it sends the check to hosted ubuntu, billed: the
        # owner's call, so printed, not run
        value, err = variable(s, var)
        delete = "`gh api -X DELETE repos/%s/actions/variables/%s`" % (s, var)
        if err:
            print("  the repository variable %s: unread (%s); while it holds labels, jobs queue until "
                  "a runner carrying them is back; %s sends the check to ubuntu-latest"
                  % (var, err, delete))
        elif value is None:
            print("  the repository variable %s is unset: the check runs on ubuntu-latest, hosted"
                  % var)
        else:
            print("  the repository variable %s holds %s: jobs queue until a runner carrying those "
                  "labels is back; %s sends the check to ubuntu-latest" % (var, value, delete))


# --- capabilities: what a runner can do, never which machine it is (the owner, 2026-10-31) -------
#
# "let's stop using host names in CI logic … use the concept of capabilities, not host names", and
# "capabilities can be assigned via config so it's instant". A job's runs-on variable lists what it
# needs; a runner's custom labels are what it can do; GitHub's runs-on is all-of, so the match is the
# routing. `wharf/ci-runner-caps.json` maps each runner's name to its capabilities, and --runner caps
# makes GitHub's custom labels equal to it with one PUT per runner (REST "Set custom labels for a
# self-hosted runner for a repository"): no re-registration, no workflow edit, a queued job matched at
# once. The vocabulary is the README's ("Capabilities"); a capability is any label, so a repo may
# name its own. A runner's name stays an identity for people and is never routed on.

CAPS_KEY = "ci-runner-caps.json"
CAP_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
VAR_IN_RUNS_ON = re.compile(r"vars\.([A-Za-z_][A-Za-z0-9_]*)", re.I)   # GitHub's contexts ignore case
BY_VARIABLE = re.compile(r"\$\{\{\s*(?:fromJSON\(\s*)?vars\.\w+(?:\s*\|\|\s*vars\.\w+)*"
                         r"(?:\s*\|\|\s*'\"(?:ubuntu|macos|windows)-[\w.-]+\"')?\s*\)?\s*\}\}", re.I)


def load_caps():
    """`wharf/ci-runner-caps.json`: {runner name: [capability, …]}; None when there is no such file.
    Unreadable, not JSON, or another shape is a refusal, never taken for absent: a write follows. An
    automatic label (self-hosted, macOS, ARM64 …) is refused too: GitHub sets those, never a PUT."""
    path = common.CONFIG / "wharf" / CAPS_KEY
    try:
        text = path.read_text(encoding="utf-8-sig")
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError) as e:
        raise Refusal("%s is unreadable (%s)" % (path, getattr(e, "strerror", None) or e))
    try:
        d = json.loads(text)
    except ValueError as e:
        raise Refusal("%s is not JSON (%s)" % (path, e))
    if not isinstance(d, dict) or not all(isinstance(v, list) for v in d.values()):
        raise Refusal("%s is not {runner name: [capability, …]}" % path)
    for name, caps in d.items():
        for c in caps:
            if not isinstance(c, str) or not CAP_RE.match(c):
                raise Refusal("%s: %s's capability %r is not a label (letters, digits, '.', '_', '-')"
                              % (path, name, c))
            if c.lower() in AUTOMATIC_LABELS:
                raise Refusal("%s: %s lists %s, a label GitHub sets by itself: list capabilities only"
                              % (path, name, c))
    # GitHub's labels are case-insensitive: one per spelling, the first kept
    out = {}
    for name, caps in d.items():
        seen, kept = set(), []
        for c in caps:
            if c.lower() not in seen:
                seen.add(c.lower())
                kept.append(c)
        out[name] = kept
    return out


def readable_caps():
    """The table, or None when it is absent or does not read: for a caller that only says something
    from it. A write's caller takes load_caps' refusal."""
    try:
        return load_caps()
    except Refusal:
        return None


def capped_labels(name, labels, table):
    """What a runner registers with by the table: the labels key's automatic labels and its
    capabilities, never the Mac's own label. None when the table does not list it, or lists nothing."""
    if not table or not table.get(name):
        return None
    return tuple(l for l in labels if l.lower() in AUTOMATIC_LABELS) + tuple(table[name])


def custom_labels(r):
    """A runner's labels that a PUT sets: GitHub's `custom` ones (its `read-only` ones are the OS and
    the architecture); a runner listed without types reads by AUTOMATIC_LABELS."""
    labels = r.get("labels") or []
    if all("type" in l for l in labels):
        return [l.get("name", "") for l in labels if l.get("type") == "custom"]
    return own_labels(labels_of(r))


def workflows(repo, remote=True):
    """(name, text) for each workflow GitHub may run: the checkout's, and with remote those of origin's
    default branch where they differ, named `origin/<branch>:<file>`. A push and every other pull
    request run that branch's file until a branch lands, so a checkout that has moved its runs-on says
    nothing of what still asks for the old label (the landing review, 2026-11-01; bin/repos' ci_state
    reads origin/main for the same reason). Fetched first, and a refusal when it cannot be read: a
    write follows, and unread is never taken for absent (variable(), load_caps()). An origin with no
    default branch yet runs nothing: said, and the checkout's stand alone."""
    out, mine = [], {}
    wdir = p(repo, ".github", "workflows")
    for f in sorted(os.listdir(wdir)) if os.path.isdir(wdir) else []:
        if f.endswith((".yml", ".yaml")):
            mine[f] = read_loose(p(wdir, f))
            out.append((f, mine[f]))
    if not remote:
        return out
    def run(*args):
        return subprocess.run(["git", "-C", repo, *args], capture_output=True, encoding="utf-8", errors="replace")
    head = run("ls-remote", "--symref", "origin", "HEAD")
    if head.returncode:
        raise Refusal("could not reach origin (%s), whose workflows GitHub runs until a branch lands: nothing "
                      "written" % (head.stderr.strip()[:200] or "no output"))
    m = re.search(r"^ref: refs/heads/(\S+)\s+HEAD$", head.stdout, re.M)
    if not m:
        print("  origin has no default branch yet: only this checkout's workflows judged")
        return out
    ref = "origin/%s" % m.group(1)
    done = run("fetch", "-q", "origin", "+refs/heads/%s:refs/remotes/%s" % (m.group(1), ref))
    listed = run("ls-tree", "-z", "--name-only", ref, "--", ".github/workflows/") if not done.returncode else done
    if listed.returncode:
        raise Refusal("could not read %s's workflows (%s), which GitHub runs until a branch lands: nothing "
                      "written" % (ref, listed.stderr.strip()[:200] or "no output"))
    for path in filter(None, listed.stdout.split("\0")):
        f = os.path.basename(path)
        if f.endswith((".yml", ".yaml")):
            shown = run("show", "%s:%s" % (ref, path))
            if shown.returncode:
                raise Refusal("could not read %s:%s (%s): nothing written" % (ref, path, shown.stderr.strip()[:200]))
            if shown.stdout != mine.get(f):
                out.append(("%s:%s" % (ref, f), shown.stdout))
    return out


def routed_vars(texts):
    """The repository variables any workflow's runs-on reads (check.yml's NAME and NAME_FULL,
    automerge.yml's NAME_AUTOMERGE …), in file order. texts: workflows()'."""
    names = []
    for _, text in texts:
        for m in RUNS_ON_LINE.finditer(text):
            said = " ".join([yaml_value(m.group(2))] + runs_on_items(text, m.end()))
            # a variable's name is upper case on GitHub, however a file spells it
            names += [n for n in map(str.upper, VAR_IN_RUNS_ON.findall(said)) if n not in names]
    return names


def runs_on_items(text, end):
    """The items of the YAML block list under a `runs-on:` whose line ends at offset end, as written."""
    items = []
    for line in text[end:].split("\n")[1:]:
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        if not s.startswith("- "):
            break
        items.append(yaml_value(s[2:]))
    return items


def block_labels(text, end):
    """runs_on_items as a label tuple; None when no list follows or an item is no plain label (an
    expression)."""
    items = [flow_labels(i) for i in runs_on_items(text, end)]
    if not items or None in items:
        return None
    return tuple(l for one in items for l in one)


def literal_runs_on(texts):
    """(workflow, value, labels, its text) for each runs-on in workflows()' texts that names its
    labels: `[self-hosted, macOS, x]`, `[macOS, x]`, the label alone (the header reads each as a
    runner's) and a block list. labels None: anything else, whatever it is (an expression, a runner
    group's mapping, a YAML anchor, tag or block scalar, a flow list over two lines, a variable mixed
    with labels): a value reads only as plain labels, so a shape nobody listed is unread, never a
    label no runner carries. A runs-on that is variables alone, by_variable's, is routed_vars'."""
    found = []
    for f, text in texts:
        for m in RUNS_ON_LINE.finditer(text):
            v = yaml_value(m.group(2))
            if by_variable(v):
                continue
            labels = flow_labels(v) if v else block_labels(text, m.end())
            if not all(CAP_RE.fullmatch(l) for l in labels or ()):
                labels = None
            found.append((f, v or ("[%s]" % ", ".join(labels) if labels else "a block of its own"), labels, text))
    return found


def by_variable(value):
    """Whether a runs-on routes on repository variables alone: this tool's forms, or a chain of `vars.`
    with at most a hosted image behind it (`${{ fromJSON(vars.A || vars.B) }}`, `${{ vars.A }}`)."""
    return bool(var_form(value) or BY_VARIABLE.fullmatch(value))


def names_label(text, label):
    """Whether text holds the label as a word of its own (`box1`, not `box10` or `my-box1`)."""
    return bool(re.search(r"(?<![\w.-])%s(?![\w.-])" % re.escape(label), text, re.I))


def hosted_name(labels):
    """Whether a literal is one hosted image's name; a runner may carry such a label all the same."""
    return len(labels) == 1 and bool(HOSTED_IMAGE.match(next(iter(labels))))


def variable_labels(value, bare=True):
    """What a set variable routes on: asked_labels' list, or its one plain label, a JSON string or
    bare (`${{ vars.RUNNER }}`), which routes as a list would; a hosted image's name is judged too, as
    a runner may carry it. None for any other JSON (a runner group's mapping), which no reader here
    can judge. bare False: read as this tool's `fromJSON(vars.X || …)` form reads it, where a bare
    value is no JSON and fails the job, so it routes nowhere (None): served and route_variable, which
    act on that form only (landing review 2026-11-01: a bare `box1` read as already routing)."""
    want = asked_labels(value)
    if want is not None:
        return want
    try:
        parsed = json.loads(value)
    except ValueError:
        if not bare:
            return None
        parsed = value
    return {parsed.strip().lower()} if isinstance(parsed, str) else None


def asked_labels(value):
    """A variable's value as the label list a job asks for; None for a hosted image's name."""
    try:
        want = json.loads(value)
    except (TypeError, ValueError):
        return None
    if isinstance(want, list) and want and all(isinstance(l, str) for l in want):
        return lowered(want)
    return None


def caps(repo, dry, only=None, keep=(), texts=None):
    """--runner caps: every runner the table lists gets exactly its capabilities as custom labels;
    one it does not list is left as it is, said. Refused before any write when a runs-on, a variable's
    or a literal one, that some registered runner serves now would be served by none after (a job queued on it would wait up to
    GitHub's 24 h): add the new capabilities, move the variables, then drop the old labels. only: the
    one runner name install syncs; keep: labels it holds beside the table's, for a runs-on that still
    asks for them; texts: workflows()', where the caller has read them. Prints the PUT that undoes
    each write."""
    s = slug(repo)
    table = load_caps()
    path = common.CONFIG / "wharf" / CAPS_KEY
    if table is None:
        raise Refusal("no capabilities: write %s, {\"<runner name>\": [\"<capability>\", …]} "
                      "(wharf's README, \"Capabilities\")" % path)
    runners, err = runners_of(s)
    if runners is None:
        raise Refusal("could not read %s's runners (%s): nothing written" % (s, err))
    plan, after = [], {}
    for r in runners:
        name, old = r.get("name"), custom_labels(r)
        fixed = [l for l in labels_of(r) if l not in old]
        after[name] = lowered(labels_of(r))
        if only is not None and name != only:
            continue
        if name not in table:
            print("  runner %s: not in %s, left at %s" % (name, CAPS_KEY, ", ".join(old) or "no custom labels"))
            continue
        new = table[name] + list(keep)
        if lowered(old) == lowered(new) and len(old) == len(new):
            print("  runner %s: already %s" % (name, ", ".join(new) or "no capabilities"))
            continue
        after[name] = lowered(fixed + new)
        plan.append((r, old, new))
    names = {r.get("name") for r in runners}
    if only is not None and only not in names:
        raise Refusal("%s has no runner named %s: nothing written (its runners: %s)"
                      % (s, only, ", ".join(sorted(n for n in names if n)) or "none"))
    for name in table:
        if name not in names and only is None:
            print("  %s lists %s: %s has no runner of that name" % (CAPS_KEY, name, s))
    before = {r.get("name"): lowered(labels_of(r)) for r in runners}
    texts = workflows(repo) if texts is None else texts
    asks, unread = [], []
    for var in routed_vars(texts):
        value, verr = variable(s, var)
        if verr:
            raise Refusal("could not read %s's variable %s (%s): nothing written" % (s, var, verr))
        want = variable_labels(value) if value else set()
        if want is None:
            unread.append(("variable %s" % var, value, value))
        elif want:
            asks.append(("variable %s" % var, value, want, "Point the variable at capabilities first"))
    # a literal runs-on routes on its labels as a variable does (`[self-hosted, macOS, <a runner's
    # label>]`, as --to self-hosted wrote it before 2026-10-31): judged the same way, or caps strands it
    # (landing review, 2026-10-31: twelve repos' check.yml were literal that day)
    for f, value, literal, text in literal_runs_on(texts):
        if literal is None:
            unread.append((f, value, text))
            continue
        asks.append(("%s's runs-on" % f, value, lowered(literal),
                     "Name capabilities in its runs-on first"))
    for what, value, want, first in asks:
        now = sorted(n for n, have in before.items() if want <= have)
        then = sorted(n for n, have in after.items() if want <= have)
        if now and not then:
            raise Refusal("%s asks for %s, which %s carr%s now and no runner would after: "
                          "nothing written. %s, or keep the old labels in %s until it is moved"
                          % (what, value, ", ".join(now), "ies" if len(now) == 1 else "y", first, CAPS_KEY))
        if now or then or not hosted_name(want):
            print("  %s (%s): %s" % (what, value, ", ".join(then) if then else
                                     "no registered runner carries it"))
    # a runs-on no reader here can judge may still expand to a label this change takes off every
    # runner (a matrix, a runner group): refused when its file names that label, said when it does not
    dropped = sorted({l for _, old, new in plan for l in lowered(old) - lowered(new)}
                     - set().union(*after.values()))
    for f, value, text in unread:
        named = [l for l in dropped if names_label(text, l)]
        if named:
            raise Refusal("%s's runs-on (%s) is no label list or variable this tool reads, and its text "
                          "names %s, which this change takes off every runner: nothing written. Name "
                          "capabilities there first, or keep the label in %s"
                          % (f, value, ", ".join(named), CAPS_KEY))
        print("  ⚠ %s's runs-on (%s) is no label list or variable this tool reads: not judged" % (f, value))
    # additions before removals: a refusal partway leaves labels added, never a job's last runner
    # gone (landing review, 2026-10-31)
    plan.sort(key=lambda x: not lowered(x[1]) <= lowered(x[2]))
    for r, old, new in plan:
        call = "repos/%s/actions/runners/%s/labels" % (s, r.get("id"))
        if dry:
            print("  would set runner %s's capabilities: %s → %s" % (r.get("name"), ", ".join(old) or "none",
                                                                      ", ".join(new) or "none"))
            continue
        # PUT replaces every custom label; an empty list is GitHub's DELETE of them all
        ok, out = gh("-X", "PUT", call, data={"labels": new}) if new else gh("-X", "DELETE", call)
        if not ok:
            raise Refusal("GitHub refused runner %s's labels: %s" % (r.get("name"), out))
        # the undo first: the write happened, whatever the read-back says (landing review, 2026-10-31)
        undo = ("echo %s | gh api -X PUT %s --input -" % (shlex.quote(json.dumps({"labels": old})), call)
                if old else "gh api -X DELETE %s" % call)
        back = [l.get("name", "") for l in (out or {}).get("labels") or [] if l.get("type") == "custom"]
        if lowered(back) != lowered(new):
            raise Refusal("runner %s read back %s, not %s; rollback: %s" % (r.get("name"), back, new, undo))
        print("  runner %s: %s (read back)" % (r.get("name"), ", ".join(back) or "no capabilities"))
        print("  rollback: " + undo)


# --- the pick: which lane a repo's check takes, by budget and queue (lighthouse-ops S1) ----------
#
# The broker's design (docs/lighthouse-ops-broker-2026-10-26.md, D2-A answered): the required check
# stays `check` on Actions; what moves is the runs-on variable the variable form reads, one PATCH, no
# commit. A lane is one row of lighthouse's `ci-lanes.json`; a repo is eligible for it when the lane
# runs everything the repo's ci.json `needs` (absent reads as macOS: never guessed onto Linux) and,
# for a public repo, `public`. Hosted minutes are spent only under `ci-budgets.json`'s caps, read
# against the usage `lighthouse ops usage` writes from the desk's own job, which alone holds the
# owner's token: this tool reads it only as WHARF_READ_TOKEN, for the admin-only reads (gh_read), so
# with no fresh usage every hosted lane of a private repo is over budget (fail closed). Every self-hosted candidate runs --runner install's trust refusals.

PICK_STALE = 30 * 60   # s: a check queued this long on the repo's lane skips that lane this pick (D2-A)
USAGE_MAX_AGE = 3600   # s: older usage reads as unread; the desk's job writes it every 15 minutes
QUEUE_MAX = 600        # s: `lighthouse/ci-queue-max`'s default, a self-hosted lane's queued p50
RESERVE = 0.2          # the share of a month cap the pick never spends below, unless a budget says
LANE_RUNS = ("macos", "linux", "public")
OS_WORDS = ("macos", "linux", "windows")   # in `needs`, an OS and not a capability
STATE_OK = "ok"
PROJECT_SLUG = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")   # as check-linux.yml's trigger reads one


def lighthouse_json(name):
    """`lighthouse/<name>` from the config dir, parsed; None when there is no such file. Unreadable,
    not JSON or not an object is a refusal, never taken for absent."""
    path = common.CONFIG / "lighthouse" / name
    try:
        text = path.read_text(encoding="utf-8-sig")
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError) as e:
        raise Refusal("%s is unreadable (%s)" % (path, getattr(e, "strerror", None) or e))
    try:
        d = json.loads(text)
    except ValueError as e:
        raise Refusal("%s is not JSON (%s)" % (path, e))
    if not isinstance(d, dict):
        raise Refusal("%s is not a JSON object" % path)
    return d


def load_lanes():
    """The lanes, in the file's order: [{name, provider, runs, runs_on, self_hosted, account, projects}]."""
    path = common.CONFIG / "lighthouse" / "ci-lanes.json"
    d = lighthouse_json("ci-lanes.json")
    if d is None:
        raise Refusal("no lanes: write %s, {\"lanes\": [...]} (lighthouse's README, \"Private values\")" % path)
    rows = d.get("lanes")
    if not isinstance(rows, list) or not rows:
        raise Refusal("%s holds no `lanes` list" % path)
    lanes, seen = [], set()
    for i, r in enumerate(rows):
        name = r.get("name") if isinstance(r, dict) else None
        if not isinstance(name, str) or not name or name in seen:
            raise Refusal("%s: lane %d has no name of its own" % (path, i + 1))
        seen.add(name)
        runs = r.get("runs")
        if not isinstance(runs, list) or not runs or not all(x in LANE_RUNS for x in runs):
            raise Refusal("%s: lane %s's `runs` must list some of %s" % (path, name, ", ".join(LANE_RUNS)))
        provider = r.get("provider", "actions")
        lane = {"name": name, "provider": provider, "runs": set(runs), "account": r.get("account"),
                "runs_on": None, "self_hosted": False, "projects": {}}
        if provider == "circleci":
            # a value the trigger would refuse fails here, at the pick, never as a held pull request
            projects = r.get("projects", {})
            if not isinstance(projects, dict) or not all(isinstance(k, str) and re.fullmatch(r"[^/\s]+/[^/\s]+", k)
                                                         and isinstance(v, str) and PROJECT_SLUG.fullmatch(v)
                                                         for k, v in projects.items()):
                raise Refusal("%s: lane %s's `projects` maps \"<owner>/<repo>\" to a project slug, "
                              "<provider>/<org>/<project>" % (path, name))
            lane["projects"] = projects
            lanes.append(lane)
            continue
        if provider != "actions":
            raise Refusal("%s: lane %s's provider is %r, not actions or circleci" % (path, name, provider))
        ro = r.get("runs_on")
        if isinstance(ro, str) and ro.strip():
            lane["runs_on"] = ro.strip()
        elif isinstance(ro, list) and ro and all(isinstance(l, str) and l.strip() for l in ro):
            # a label list is a self-hosted runner's, `self-hosted` named or not: the header reads
            # `[macOS, <label>]` as the runner Mac's too, and a hosted lane is one image's name
            lane["runs_on"] = tuple(l.strip() for l in ro)
            lane["self_hosted"] = True
        else:
            raise Refusal("%s: lane %s needs `runs_on`, a hosted image's name or a label list" % (path, name))
        if isinstance(lane["runs_on"], str) and not HOSTED_IMAGE.match(lane["runs_on"]):
            # a hosted lane is one image's name; any other string is a label (`macOS`, a runner's
            # own), which GitHub routes to a self-hosted runner holding it, read with or without
            # wharf/ci-runner-labels on this host (the second landing review)
            raise Refusal("%s: lane %s's runs_on %r is no hosted image's name (ubuntu-*, macos-*, "
                          "windows-*): a self-hosted lane is written as a label list" % (path, name, lane["runs_on"]))
        if lane["self_hosted"] and "public" in lane["runs"]:
            # the trust boundary (the header): a fork's PR would run its code on the runner's host
            raise Refusal("%s: lane %s is self-hosted and lists `public`: a self-hosted lane never runs "
                          "a public repo" % (path, name))
        # a hosted lane may run a repo's Linux share too (linux-on-actions, 2026-11-02): its `projects` maps
        # the repo to `actions`, the target check-linux.yml reads as "run the suites here, on GitHub's runners"
        projects = r.get("projects", {})
        if not isinstance(projects, dict) or not all(isinstance(k, str) and re.fullmatch(r"[^/\s]+/[^/\s]+", k)
                                                     and v == ACTIONS_TARGET for k, v in projects.items()):
            raise Refusal("%s: lane %s's `projects` maps \"<owner>/<repo>\" to %r on an Actions lane"
                          % (path, name, ACTIONS_TARGET))
        if projects and lane["self_hosted"] and not (
                "linux" in lane["runs"] and "linux" in lowered(lane["runs_on"]) and "macos" not in lowered(lane["runs_on"])):
            # a self-hosted lane runs the share only on a Linux runner of the repo's (linux-runner, 2026-11-04)
            raise Refusal("%s: lane %s is self-hosted: the Linux share runs on GitHub's hosted runners, or on a "
                          "self-hosted Linux lane (its `runs` and `runs_on` naming linux, never macOS)" % (path, name))
        lane["projects"] = projects
        lanes.append(lane)
    return lanes


def load_budgets():
    """{account: {provider, cap, unit, reserve, week_share, margin}} from `lighthouse/ci-budgets.json`;
    {} when there is none (every hosted lane of a private repo is then over budget)."""
    path = common.CONFIG / "lighthouse" / "ci-budgets.json"
    d = lighthouse_json("ci-budgets.json") or {}
    reserve = d.get("reserve", RESERVE)
    accounts = d.get("accounts") or {}
    if not isinstance(accounts, dict):
        raise Refusal("%s: `accounts` is not an object" % path)
    out = {}
    for key, b in accounts.items():
        if not isinstance(b, dict):
            raise Refusal("%s: account %s is not an object" % (path, key))
        cap, unit = (b.get("month_minutes"), "minutes") if "month_minutes" in b else (b.get("month_credits"), "credits")
        r, w, m = b.get("reserve", reserve), b.get("week_share"), b.get("margin", 0.1 if unit == "credits" else 0)
        if not isinstance(cap, (int, float)) or isinstance(cap, bool) or cap <= 0:
            raise Refusal("%s: account %s needs a positive month_minutes or month_credits" % (path, key))
        if not isinstance(r, (int, float)) or not 0 <= r < 1 or (w is not None and not (isinstance(w, (int, float)) and 0 < w <= 1)) \
                or not isinstance(m, (int, float)) or m < 0:
            raise Refusal("%s: account %s's reserve is a share in [0, 1), week_share in (0, 1], margin ≥ 0" % (path, key))
        out[key] = {"cap": float(cap), "unit": unit, "reserve": float(r), "week_share": w, "margin": float(m)}
    return out


def usage_file():
    return common.LOG_DIR / "ci-usage.json"


def load_usage(path, now):
    """({account: row}, None) from the desk's usage file, or ({}, why) when it is absent, torn or
    older than USAGE_MAX_AGE: unread usage is never a zero."""
    try:
        d = json.loads(open(path, encoding="utf-8").read())
    except FileNotFoundError:
        return {}, "no usage at %s (`lighthouse ops usage --write` writes it, in the desk's own job)" % path
    except (OSError, ValueError) as e:
        return {}, "usage at %s unreadable (%s)" % (path, e)
    at = d.get("as_of") if isinstance(d, dict) else None
    if not isinstance(at, (int, float)) or isinstance(at, bool):
        return {}, "usage at %s carries no as_of" % path
    if now - at > USAGE_MAX_AGE:
        return {}, "usage at %s is %d min old" % (path, (now - at) // 60)
    if at - now > 300:
        return {}, "usage at %s is dated in the future" % path
    acc = d.get("accounts")
    return (acc if isinstance(acc, dict) else {}), None


def budget_left(key, budgets, usage, usage_why):
    """(what is left above the reserve, why) for one account; (None, why) when it is over, unread or
    paying: netAmount above zero is money beyond the plan, the one thing G4 forbids."""
    if not key:
        return None, "no account: its minutes are unbudgeted"
    b = budgets.get(key)
    if not b:
        return None, "no budget for account %s in ci-budgets.json" % key
    if usage_why:
        return None, usage_why
    u = usage.get(key)
    if not isinstance(u, dict) or u.get("state") != STATE_OK:
        return None, "usage of %s unread (%s)" % (key, (u or {}).get("why") or (u or {}).get("state") or "absent")
    try:   # a row marked ok but missing a field is unread, never a zero
        used = float(u["month_used"]) * (1 + b["margin"])
        week = float(u["week_used"]) * (1 + b["margin"])
        net = float(u["net_amount"])
    except (KeyError, TypeError, ValueError):
        return None, "usage of %s is incomplete or not a number" % key
    if net > 0:
        return None, "%s pays beyond its plan this month (netAmount %.2f)" % (key, net)
    left = b["cap"] * (1 - b["reserve"]) - used
    if left <= 0:
        return None, "%s used %.0f of %.0f %s, the reserve %.0f%% kept" % (key, used, b["cap"], b["unit"], b["reserve"] * 100)
    if b["week_share"] and week >= b["cap"] * b["week_share"]:
        return None, "%s used %.0f %s this week, its share %.0f" % (key, week, b["unit"], b["cap"] * b["week_share"])
    return left, "%.0f of %.0f %s left above the reserve" % (left, b["cap"], b["unit"])


def queue_max():
    try:
        return float(common.config_line("lighthouse/ci-queue-max") or QUEUE_MAX)
    except ValueError:
        return QUEUE_MAX


def lane_queues(now):
    """{lane: queued-seconds p50} from the sampler's last ops.jsonl row (lighthouse-ops S2,
    `ci.lanes.<name>.queued_s_p50`), {} when there is none or it is over an hour old. A lane with no
    number reads as under the max: hosted minutes are spent on a measured queue only."""
    try:
        # the tail only: the sampler appends 96 rows a day (S1's second landing review)
        with open(common.LOG_DIR / "ops.jsonl", "rb") as fh:
            fh.seek(0, 2)
            fh.seek(max(0, fh.tell() - 65536))
            last = [l for l in fh.read().decode("utf-8", "replace").splitlines() if l.strip()][-1:]
        row = json.loads(last[0]) if last else {}
        if not isinstance(row, dict) or now - float(row.get("as_of") or 0) > USAGE_MAX_AGE:
            return {}
        lanes = (row.get("ci") or {}).get("lanes") or {}
        return {k: float(v["queued_s_p50"]) for k, v in lanes.items()
                if isinstance(v, dict) and isinstance(v.get("queued_s_p50"), (int, float))}
    except (OSError, ValueError, TypeError, AttributeError):
        return {}


def repo_needs(ci):
    """What a repo's ci.json says its check needs, in lower case as GitHub's labels compare: the
    lanes' words (LANE_RUNS; absent: macos) and any other label, a capability. A capability with no
    OS beside it reads as macos too, as an absent `needs` does: never guessed onto Linux."""
    needs = ci.get("needs", ["macos"])
    if not isinstance(needs, list) or not all(isinstance(x, str) and CAP_RE.fullmatch(x) for x in needs):
        raise Refusal(".github/ci.json's `needs` must list some of %s, or capabilities (each a label: "
                      "letters, digits, '.', '_', '-')" % ", ".join(LANE_RUNS))
    needs = {x.lower() for x in needs}
    if needs - set(LANE_RUNS) and not needs & set(OS_WORDS):
        needs.add("macos")
    return needs


def literal_needs(ci):
    """repo_needs for the literal form, which always names an OS, so a `needs` naming none reads as
    macos (`[]`, `["public"]`: never a bare `[self-hosted]` a Linux runner would take; the lanes read
    repo_needs itself, where they mean what they say); None when it does not read, for a caller that
    only asks whether a runs-on is this tool's."""
    try:
        needs = repo_needs(ci)
    except Refusal:
        return None
    return needs if needs & set(OS_WORDS) else needs | {"macos"}


def needs_of(repo):
    """literal_needs of the repo's ci.json, None when it does not read."""
    try:
        return literal_needs(load_ci(repo))
    except Refusal:
        return None


def needed_labels(ci):
    """The literal form's labels: `self-hosted`, `macOS` and the capabilities ci.json's `needs` lists,
    each once, as it spells them first (labels ignore case). `public` is no label: it says what the
    repo is. Never a runner's name: GitHub gives the job to whichever runner carries all of them.
    Another OS is refused: this tool's self-hosted runner is a Mac (the Mac-only checks and the
    runner it installs), and a lane routes the rest through the variable form."""
    repo_needs(ci)   # its refusal, which literal_needs only reads as None
    other = sorted(literal_needs(ci) & (set(OS_WORDS) - {"macos"}))
    if other:
        raise Refusal(".github/ci.json's `needs` names %s: the literal form asks for a runner Mac, the one "
                      "kind --runner install sets up; --runs-on-var moves the check by lane instead"
                      % " and ".join(other))
    spelt = {}
    for n in ci.get("needs", ["macos"]):
        spelt.setdefault(n.lower(), n)
    return (SELF, "macOS") + tuple(n for l, n in spelt.items() if l not in (*OS_WORDS, "public", SELF))


def lane_lacks(lane, need):
    """What of a repo's needs a lane does not meet: a capability is a label the lane's own list must
    name, and a hosted image carries none."""
    return need - lane["runs"] - (lowered(lane["runs_on"]) - set(LANE_RUNS) if lane["self_hosted"] else set())


def lane_of(value, lanes, literal=False, need=frozenset()):
    """The lane a runs-on value names (a variable's JSON, a literal's labels), or None. literal: a
    file's own list, which says what the repo needs and not what a lane carries, so failing an exact
    match it sits on the first self-hosted lane whose list holds all of it, one that meets need
    first (the landing review, 2026-11-01: a re-run off the labels key's literal took a repo off its
    lane, and the desk's card)."""
    if value is None:
        value = "ubuntu-latest"   # the variable form's own default
    asked = value
    for lane in lanes:
        ro = lane["runs_on"]
        if ro is None:
            continue
        if isinstance(value, (list, tuple)) and len(value) == 1:
            value = value[0]   # a literal `runs-on: ubuntu-latest` reads as one label
        if isinstance(ro, str) and value == ro:
            return lane["name"]
        if not isinstance(ro, str) and isinstance(value, (list, tuple)) and lowered(value) == lowered(ro):
            return lane["name"]
    if literal and isinstance(asked, (list, tuple)):
        holding = [l for l in lanes if l["self_hosted"] and lowered(asked) <= lowered(l["runs_on"])]
        fits = [l for l in holding if not lane_lacks(l, need)]
        return (fits or holding or [{"name": None}])[0]["name"]
    return None


def last_flip(s, variable=None):
    """When the pick last flipped this repo's runs-on (ci-pick.jsonl), 0 when never; with VARIABLE, when
    it last flipped that variable. A share flip is no runs-on flip: counted as one, a share flapping
    near its reserve would hide every queued run from stale_lane (the landing review); so is a project move."""
    at = 0
    try:
        with open(common.LOG_DIR / "ci-pick.jsonl", encoding="utf-8") as fh:
            for l in fh:
                # a torn line costs that line only, never every repo's last flip (the second review)
                try:
                    r = json.loads(l)
                except ValueError:
                    continue
                if not (isinstance(r, dict) and r.get("repo") == s and isinstance(r.get("at"), (int, float))):
                    continue
                if (r.get("variable") == variable) if variable else (
                        r.get("variable") not in (SHARE_VAR, PROJECT_VAR, OLD_PROJECT_VAR, LINUX_RUNS_VAR)):
                    at = max(at, r["at"])
    except OSError:
        return 0
    return at


def stale_lane(s, now):
    """Minutes a check.yml run has sat queued past PICK_STALE on the repo's current lane, or None:
    that lane reported nothing, so the pick skips it (D2-A). A run created before the pick's last
    flip of this repo waits on the lane before it, so it never counts (the landing review: it made
    the new lane look stuck and flipped the repo back). Unread: None, it never blocks a lane."""
    since = last_flip(s)
    ok, out = gh("repos/%s/actions/workflows/check.yml/runs?status=queued&per_page=20" % s)
    runs = out.get("workflow_runs") if ok and isinstance(out, dict) else None
    for r in runs or []:
        try:
            t = calendar.timegm(time.strptime(r.get("created_at", ""), "%Y-%m-%dT%H:%M:%SZ"))
        except (TypeError, ValueError):
            continue
        if t >= since and now - t > PICK_STALE:
            return int((now - t) // 60)
    return None


def pick_log(row):
    path = common.LOG_DIR / "ci-pick.jsonl"
    os.makedirs(path.parent, exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, separators=(",", ":")) + "\n")


def apply_guard(dry):
    """Refuses --apply anywhere but the desk's own job on the ops host (both flips: runs-on, the share)."""
    if (os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_UNATTENDED")
            or (hasattr(common, "unattended") and common.unattended())):
        # an accident guard, as yard-node's write verbs: the desk's job applies, a session reports
        raise Refusal("--apply runs in the desk's own job (`lighthouse ops pick --apply`), never in a "
                      "Claude Code session: --pick alone reports")
    host_why = None if dry else ops_host_refusal()
    if host_why:
        raise Refusal(host_why)


# The Linux share (ci-budgets, 2026-10-31): a check.yml that reads CI_LINUX_ELSEWHERE runs its Linux-proven
# suites on CircleCI's check-linux when the variable is `true`, and the whole line on its own runner otherwise.
# The variable is the share's lane switch, judged by the CircleCI lanes' budgets as a hosted lane's is. Off is
# always safe: check-linux.yml then posts check-linux green itself, saying the runner runs the whole line
# (regatta#316), so main's requirement stays met. On only while main requires check-linux, or a red Linux
# run would block nothing (docs/circleci-oauth-2026-10-30.md's rollout order: the requirement first).
#
# Two CircleCI orgs (ci-two-orgs, 2026-11-01; the owner: "You will move the jobs between them"): each org
# has its free plan, so the share runs in whichever has the most month left, and goes off only when none
# has any. The project moves by a repository variable and not by the file for the reason the share itself
# does: one PATCH, no commit, and the next trigger follows it (a head already pending at the old org keeps
# that status until a new push: the trigger's once-a-head guard reads it). A lane's `projects` is a map and
# not one slug because a lane is an org, read by a budget, and ci-lanes.json serves every repo: one slug
# would send a second repo's trigger to this repo's project. With the variable unset the trigger reads
# .circleci/project-slug, so the pick reads the current project the same way; undoing a first move (the
# DELETE it logs) goes back to the file.
#
# A move waits SHARE_HOLD after the last one while the lane it would leave can still run: two orgs near one
# reading would otherwise swap every 15 minutes, each swap a PATCH and a log line. It limits the rate and sets
# no margin, so such orgs may trade the share hourly, which keeps them level. A lane that is out is left at
# once. The project is written before the share goes on, and a failed write leaves it off unless the lane it
# already stands on can run it, where it comes on there and the pick exits 3; on a lane that is out, a failed
# move turns the share off: it never runs at an org the pick judged out. The move changes where
# the PR share runs, nothing else; main's push job (.circleci/parts/linux.yml) runs on demand only since
# linux-on-actions. An Actions lane (provider `actions`, its `projects` naming `actions`) that names the repo
# is the only lane chosen while it is in the file: the CircleCI lanes are then read and said, never chosen.
SHARE_VAR = "CI_LINUX_ELSEWHERE"
SHARE_CONTEXT = "check-linux"
SHARE_HOLD = 3600   # off→on, and a move off a lane that can still run, wait this long after the last: a budget read near its line flaps
PROJECT_VAR = "CI_LINUX_TARGET"   # a CircleCI project slug, or ACTIONS_TARGET (check-linux.yml reads it)
OLD_PROJECT_VAR = "CI_CIRCLECI_PROJECT"   # its name until linux-on-actions: an old log row of it is no runs-on flip
ACTIONS_TARGET = "actions"
PROJECT_FILE = (".circleci", "project-slug")
# The share on a self-hosted Linux lane (linux-runner, 2026-11-04; the owner: "can the node help with linux checks
# as well?"): an Actions lane whose `runs_on` is a label list naming linux, its `projects` naming the repo with
# `actions`. Its suites run where check-linux.yml's `suite` job reads CI_LINUX_RUNS_ON (unset: ubuntu-latest), so
# choosing it moves three variables, CI_LINUX_TARGET, CI_LINUX_RUNS_ON and CI_LINUX_ELSEWHERE, in that order, and a
# hosted Actions lane moves CI_LINUX_RUNS_ON back to its image. It has no budget: a lane whose runner is online is
# taken before any hosted one (it bills nothing), and one whose runner is gone is out, the share off or on another
# lane, as a CircleCI lane without budget is. Gone: no runner carries its labels, or the one that does has been
# offline more than a sweep (SHARE_GRACE: three of the desk's 15-minute readings, as a one-job runner is offline in
# the seconds between its containers and two readings can both land there), counted from the pick that first saw it offline
# in the log dir's ci-share-runners.json, which only --apply (the desk's job) writes. Within the grace the share
# stays where it stands, and never comes on at a lane whose runner is offline. The trust refusals hold as for a
# runs-on flip: a public repo, or a private one that runs fork PRs' workflows, is never given one.
LINUX_RUNS_VAR = "CI_LINUX_RUNS_ON"
SHARE_GRACE = 20 * 60   # s: past a sweep, the desk's pick interval; offline longer, the share lane's runner is gone
RUNNER_LEFT = float("inf")   # a self-hosted share lane's "month left": it bills nothing, so it beats every budget


def requires_share(s, branch):
    """(True | False, None) whether main requires check-linux (any app's: `ci/circleci: check-linux`
    as well), or (None, why) when the protection is unread: never taken for "not required"."""
    ok, br = gh("repos/%s/branches/%s" % (s, branch))
    rsc = ((br.get("protection") or {}).get("required_status_checks") if ok and isinstance(br, dict) else None)
    # an empty list there is no answer: a branch whose checks come from a ruleset, or protection the reader
    # cannot see, reads `contexts: []` (the landing review); the protection endpoint judges it, as before
    if not (isinstance(rsc, dict) and (rsc.get("contexts") or rsc.get("checks"))):
        # the protection endpoint answers admins only (the desk's machine account: a 404, logbook #6); the
        # branch's own read carries the same lists for any reader, and this stays the fallback
        rsc, err = required(s, branch)
    if not isinstance(rsc, dict):
        return None, "main's required checks unread (%s)" % (err or rsc)
    names = [c.get("context") for c in rsc.get("checks") or [] if isinstance(c, dict)] + list(rsc.get("contexts") or [])
    return any(isinstance(n, str) and (n == SHARE_CONTEXT or n.endswith(": " + SHARE_CONTEXT)) for n in names), None


def file_project(repo):
    """The project .circleci/project-slug names: the first line that is no comment, byte for byte as the
    trigger reads it, so a line the trigger would refuse matches no lane."""
    try:
        with open(p(repo, *PROJECT_FILE), encoding="utf-8", newline="") as fh:   # newline: grep keeps a CR
            for line in fh.read().split("\n"):
                if line and not line.startswith("#"):
                    return line
    except (OSError, UnicodeDecodeError):
        pass
    return None


def trigger_reads_project(repo):
    """Whether this checkout's trigger reads the project variable (`vars.<name>`: its comments name it too):
    if not, a write would move nothing."""
    try:
        return "vars." + PROJECT_VAR in read_loose(p(repo, ".github", "workflows", "check-linux.yml"))
    except OSError:
        return False


def trigger_reads_runs_on(repo):
    """Whether this checkout's check-linux.yml sends its suites where the runs-on variable says: if not, a
    self-hosted lane would run them on GitHub's hosted runners, billed."""
    try:
        return "vars." + LINUX_RUNS_VAR in read_loose(p(repo, ".github", "workflows", "check-linux.yml"))
    except OSError:
        return False


BAD_RUNS = object()   # a CI_LINUX_RUNS_ON no `suite` job can read: it matches no lane, so the pick rewrites it


def runs_value(raw):
    """CI_LINUX_RUNS_ON as the `suite` job reads it: unset (or empty, which `||` passes over) is ubuntu-latest,
    a JSON string one image, a JSON list of strings labels (a tuple here); anything else, a bare word among them,
    fails fromJSON or runs-on, so it is BAD_RUNS and stands on no lane."""
    if not raw:
        return "ubuntu-latest"
    try:
        v = json.loads(raw)
    except ValueError:
        return BAD_RUNS
    if isinstance(v, str) and v:
        return v
    if isinstance(v, list) and v and all(isinstance(x, str) for x in v):
        return tuple(v)
    return BAD_RUNS


def same_runs(a, b):
    if a is BAD_RUNS or b is BAD_RUNS:
        return False
    if isinstance(a, str) or isinstance(b, str):
        return a == b
    return lowered(a) == lowered(b)


def share_runners_file():
    return common.LOG_DIR / "ci-share-runners.json"


class ShareCtx:
    """What the share's judgement reads once per pick: the lanes' budgets, the repo's trust and runners, and
    when each self-hosted share lane's runner was first seen offline (SHARE_GRACE)."""

    def __init__(self, repo, s, budgets, usage, usage_why, now):
        self.repo, self.s, self.budgets, self.usage, self.usage_why, self.now = repo, s, budgets, usage, usage_why, now
        self.trust = self.runners = None
        self.reads_runs = trigger_reads_runs_on(repo)
        self.on = False
        self.at = lambda lane: False
        self.changed = False
        try:
            d = json.loads(share_runners_file().read_text(encoding="utf-8"))
            self.offline = {k: v for k, v in (d.get(s) or {}).items() if isinstance(v, (int, float))}
        except (OSError, ValueError, AttributeError):
            self.offline = {}

    def left(self, lane):
        """(left, why) for one share lane: an account's budget, or for a self-hosted lane its runner."""
        if not lane["self_hosted"]:
            return budget_left(lane["account"], self.budgets, self.usage, self.usage_why)
        if self.trust is None:
            try:
                refuse_forks(self.s, "the Linux share on a self-hosted lane")
                self.trust = ""
            except Refusal as e:
                self.trust = str(e)
        if self.trust:
            return None, self.trust
        if not self.reads_runs:
            return None, "check-linux.yml reads no %s, so its suites would run on GitHub's hosted runners" % LINUX_RUNS_VAR
        if self.runners is None:
            self.runners = runners_of(self.s)
        runners, err = self.runners
        if runners is None:
            return None, "the repo's runners are unread (%s)" % err
        labels, name = lane["runs_on"], lane["name"]
        if any(runs_check(r, labels) for r in runners):
            self.seen(name, None)
            return RUNNER_LEFT, "a runner labelled %s is online" % ", ".join(labels)
        if not any(lowered(labels) <= lowered(labels_of(r)) for r in runners):
            self.seen(name, None)
            return None, "no runner labelled %s" % ", ".join(labels)
        since = self.offline.get(name)
        if since is None:
            since = self.now
            self.seen(name, since)
        mins = int(max(0, self.now - since) // 60)
        if self.now - since >= SHARE_GRACE:
            return None, "its runner labelled %s has been offline %d min: gone" % (", ".join(labels), mins)
        if self.on and self.at(lane):
            return RUNNER_LEFT, "its runner is offline %d min, held a sweep before the share leaves it" % mins
        return None, "its runner labelled %s is offline: never a lane to come on at" % ", ".join(labels)

    def seen(self, name, since):
        if self.offline.get(name) != since:
            self.changed = True
            if since is None:
                self.offline.pop(name, None)
            else:
                self.offline[name] = since

    def save(self, apply, dry):
        """The first-offline times, written by the desk's job alone: --apply, not --dry-run, and only where
        apply_guard passes (never a session's or another host's --apply, whose variable writes it refuses)."""
        if not (apply and not dry and self.changed):
            return
        try:
            apply_guard(dry)
        except Refusal:
            return
        path = share_runners_file()
        try:
            d = json.loads(path.read_text(encoding="utf-8"))
            d = d if isinstance(d, dict) else {}
        except (OSError, ValueError):
            d = {}
        d[self.s] = self.offline
        # never a raise: it runs in pick_share's `finally`, and the runs-on half of the pick still follows
        try:
            os.makedirs(path.parent, exist_ok=True)
            tmp = path.with_name(path.name + ".%d" % os.getpid())
            tmp.write_text(json.dumps(d, separators=(",", ":"), sort_keys=True) + "\n", encoding="utf-8")
            os.replace(tmp, path)
        except OSError as e:
            print("  ⚠ share runners not recorded at %s: %s" % (path, getattr(e, "strerror", None) or e))


def share_lane(rows, s, project, reads, ctx, now):
    """(lane, left, why, stands) for the share: the lane to run on with what it has left, or, with none able
    to, (the lane that explains it, None, why, False). stands: the lane the share is on can still run it."""
    budgets = ctx.budgets
    fits = []
    last = (None, "no lane")
    for lane in rows:
        to = lane["projects"].get(s)
        left, why = ctx.left(lane)
        if left is not None and not to and len(rows) > 1:
            left, why = None, "names no project for %s" % s
        elif left is not None and to and to != project and not reads:
            left, why = None, "check-linux.yml reads no %s, so its project is out of reach" % PROJECT_VAR
        if len(rows) > 1:
            print("  share lane %s: %s, %s" % (lane["name"], "eligible" if left is not None else "not chosen", why))
        if left is not None:
            fits.append((lane, left, why))
        if last[0] is None or ctx.at(lane):
            last = (lane, why)   # the lane the share stands on says why best, else the first
    if not fits:
        return last[0], None, last[1], False
    here = next((f for f in fits if ctx.at(f[0])), None)
    def frac(f):   # minutes and credits are no common unit: the share of the month's cap left
        if f[1] == RUNNER_LEFT:
            return RUNNER_LEFT   # a self-hosted lane bills nothing
        cap = (budgets.get(f[0]["account"]) or {}).get("cap")
        return f[1] / cap if cap else 0.0
    best = max(fits, key=lambda f: (frac(f), f is here))   # a tie stays where it is
    if here and best is not here:
        moved = max(last_flip(s, PROJECT_VAR), last_flip(s, LINUX_RUNS_VAR))
        if moved and now - moved < SHARE_HOLD:
            print("  share %s: stays on lane %s: lane %s has more left, but the project moved %d min ago "
                  "(a move waits %d min)" % (PROJECT_VAR, here[0]["name"], best[0]["name"],
                                             (now - moved) // 60, SHARE_HOLD // 60))
            return here + (True,)
    return best + (here is not None or not best[0]["projects"].get(s),)   # a lane with no project moves nothing


def share_move(s, lane, project, why, apply, dry, now, runs=None, reads_runs=False):
    """The trigger's project moved to LANE's, then, for an Actions lane, the suites' runs-on (runs: the
    variable as read, None when unset; reads_runs: check-linux.yml reads it), each said and (with --apply)
    written. True when a write failed: the runs-on is never moved after a refused project."""
    to = lane["projects"].get(s)
    if to and to != project:
        print("  share %s: %s → %s (lane %s: %s)" % (PROJECT_VAR, project or "unset", to, lane["name"], why))
        if not apply:
            print("  --apply sets %s to it" % PROJECT_VAR)
        else:
            apply_guard(dry)   # a session or the wrong host: a refusal, as before
            try:
                undo = set_variable(s, PROJECT_VAR, to, dry, raw=True)
            except Refusal as e:
                print("  ⚠ share %s not written: %s" % (PROJECT_VAR, e))
                return True
            if undo:
                pick_log({"at": int(now), "repo": s, "variable": PROJECT_VAR, "from": project, "to": to,
                          "lane": lane["name"], "why": why, "undo": undo})
    if not (to and lane["provider"] == "actions" and reads_runs):
        return False
    want = lane["runs_on"]
    if same_runs(runs_value(runs), want):
        return False
    print("  share %s: %s → %s (lane %s: %s)" % (LINUX_RUNS_VAR, runs or "unset", variable_value(want), lane["name"], why))
    if not apply:
        print("  --apply sets %s to it" % LINUX_RUNS_VAR)
        return False
    apply_guard(dry)
    try:
        undo = set_variable(s, LINUX_RUNS_VAR, want, dry)
    except Refusal as e:
        print("  ⚠ share %s not written: %s" % (LINUX_RUNS_VAR, e))
        return True
    if undo:
        pick_log({"at": int(now), "repo": s, "variable": LINUX_RUNS_VAR, "from": runs, "to": variable_value(want),
                  "lane": lane["name"], "why": why, "undo": undo})
    return False


def pick_share(repo, s, text, lanes, budgets, usage, usage_why, apply, dry, now):
    """pick_share_on, then the share lanes' runner sightings kept for the next pick (ShareCtx.save)."""
    ctx = ShareCtx(repo, s, budgets, usage, usage_why, now)
    try:
        return pick_share_on(repo, s, text, lanes, ctx, apply, dry, now)
    finally:
        ctx.save(apply, dry)


def pick_share_on(repo, s, text, lanes, ctx, apply, dry, now):
    """The share's flip and its project, said and (with --apply) written: off when no lane is under
    budget, when it may stand on a lane that is out and cannot be moved or told, or when main no longer requires
    check-linux; on when a lane is, main requires check-linux and the
    last off is SHARE_HOLD old; else left as it is. While on, or coming on, it stands on the lane share_lane
    takes. True when a write failed or a variable no lane names steers the trigger: the pick then exits 3, which
    `ops pick` returns and the sample job's log line counts (nothing is filed: the budget alarm is what pages).
    Never a raise: the runs-on half still runs."""
    if SHARE_VAR not in text:
        return False
    rows = [l for l in lanes if "linux" in l["runs"]
            and (l["provider"] == "circleci" or (l["provider"] == "actions" and l["projects"]))]
    if not rows:
        print("  share %s: no lane runs the Linux share; left as it is" % SHARE_VAR)
        return False
    have, err = variable(s, SHARE_VAR)
    if err:
        print("  share %s: unread (%s); left as it is" % (SHARE_VAR, err))
        return False
    # once an Actions lane names this repo, it alone runs the share: the CircleCI lanes are read and said,
    # never chosen (the brief: "never chosen once the Actions lane exists"; the owner moved off CircleCI for
    # its money, 2026-11-02). With that lane out, the share goes off and the Macs take the whole line.
    gha = [l for l in rows if l["provider"] == "actions" and l["projects"].get(s)]
    if gha:
        for l in rows:
            if l not in gha:
                left, why = ctx.left(l)
                print("  share lane %s: not chosen, an Actions lane runs the share for %s (%s)" % (
                    l["name"], s, why))
        rows = gha
    # a file with no row naming a project here reads as it always did: its first CircleCI lane, and nothing
    # moves (an Actions lane naming other repos only is never this repo's: the trigger would go to CircleCI)
    named = any(l["projects"].get(s) for l in rows)
    rows = rows if named else [l for l in rows if l["provider"] == "circleci"][:1]
    if not rows:
        print("  share %s: no lane runs the Linux share for %s; left as it is" % (SHARE_VAR, s))
        return False
    held, perr = variable(s, PROJECT_VAR)
    reads = trigger_reads_project(repo)
    perr = perr if reads else None   # a trigger that ignores the variable goes to the file's project, known
    project = (held if reads else None) or file_project(repo)   # where the trigger goes, as it reads it
    on = (have or "").strip().lower() == "true"
    # where an Actions lane's suites run: read only where check-linux.yml routes them by it, and unread is as an
    # unread project, nothing moves
    runs = None
    if ctx.reads_runs and any(l["provider"] == "actions" for l in rows):
        runs, rerr = variable(s, LINUX_RUNS_VAR)
        perr = perr or (rerr and "%s: %s" % (LINUX_RUNS_VAR, rerr))

    def at(lane):   # the share stands on LANE: its project, and for an Actions lane its runs-on too
        to = lane["projects"].get(s)
        if not to or to != project:
            return False
        return not (lane["provider"] == "actions" and ctx.reads_runs) or same_runs(runs_value(runs), lane["runs_on"])
    ctx.on, ctx.at = on, at
    lane, left, why, stands = share_lane(rows, s, project, reads, ctx, now)
    # a variable left behind by a lanes file that named projects: the trigger goes where no lane is judged
    refused = bool(not named and held and reads and held != file_project(repo))
    if refused:
        left, why = None, "%s holds %s, which no lane names" % (PROJECT_VAR, held)
    if left is not None:
        req, rwhy = requires_share(s, main_branch(repo))
        if on and req is False:
            # on with no requirement: a red Linux run blocks nothing, so off (the safe side) — the
            # 2026-10-27 stopgap dropped the requirement by hand and left the variable on
            why = "main does not require %s" % SHARE_CONTEXT
        elif perr:
            # where the share stands is unknown: nothing moves or comes on, and it goes off, which needs no
            # project, when it may stand on a lane that is out
            print("  share %s: unread (%s); nothing moves" % (PROJECT_VAR, perr))
            out = next((l for l in rows if l["projects"].get(s) and ctx.left(l)[0] is None), None)
            if not on or out is None:
                return False
            why, lane = "%s is unread, and a lane it may stand on is out" % PROJECT_VAR, out
        elif on:
            if not lane["projects"].get(s) or at(lane):
                print("  share %s: %s, stays (lane %s: %s%s)" % (
                    SHARE_VAR, have, lane["name"], why, "; %s" % rwhy if rwhy else ""))
            refused = share_move(s, lane, project, why, apply, dry, now, runs, ctx.reads_runs)
            if not refused or stands:
                return refused
            out = next((l for l in rows if project and at(l)), None)
            why = "%s, and the move to lane %s was refused" % ("it is out" if out else "no lane names its project", lane["name"])
            lane = out or lane
        elif not req:
            print("  share %s: %s, stays: lane %s is under budget, but %s" % (
                SHARE_VAR, have or "unset", lane["name"],
                rwhy or "main does not require %s, so a red Linux run would block nothing" % SHARE_CONTEXT))
            return False
        else:
            off_at = last_flip(s, SHARE_VAR)
            if off_at and now - off_at < SHARE_HOLD:
                print("  share %s: %s, stays: lane %s is under budget, but the share went off %d min ago "
                      "(on waits %d min)" % (SHARE_VAR, have or "unset", lane["name"], (now - off_at) // 60,
                                             SHARE_HOLD // 60))
                return False
    elif not on:
        print("  share %s: %s, stays (lane %s: %s)" % (SHARE_VAR, have or "unset", lane["name"], why))
        return refused
    want = "false" if on else "true"
    print("  share %s: %s → %s (lane %s: %s)" % (SHARE_VAR, have or "unset", want, lane["name"], why))
    if want == "true" and share_move(s, lane, project, why, apply, dry, now, runs, ctx.reads_runs):
        if not stands:
            return True   # never on at an org the pick judged out
        refused = True    # where it stands can run it: on there, the better lane refused
        # the log names the lane the share comes on at, not the one the refused move aimed for
        held_at = next((l for l in rows if project and at(l)), None)
        if held_at is not None:
            why = "the move to lane %s was refused; on where it stands" % lane["name"]
            lane = held_at
            print("  share %s: on at lane %s (%s)" % (SHARE_VAR, lane["name"], why))
    if not apply:
        print("  --apply sets %s to it" % SHARE_VAR)
        return refused
    apply_guard(dry)   # a session or the wrong host: a refusal, as before
    try:
        undo = set_variable(s, SHARE_VAR, want, dry, raw=True)
    except Refusal as e:
        print("  ⚠ share %s not written: %s" % (SHARE_VAR, e))
        return True
    if undo:
        pick_log({"at": int(now), "repo": s, "variable": SHARE_VAR, "from": have, "to": want,
                  "lane": lane["name"], "why": why, "undo": undo})
    return refused


def ops_host_refusal():
    """--apply writes only on the one host that brokers (`lighthouse/ops-host`): two hosts picking
    at once would flip a repo back and forth."""
    want = common.config_line("lighthouse/ops-host")
    if not want:
        return "lighthouse/ops-host names no host: the desk is off, and --apply writes nothing"
    if want.lower() != common.host_name():
        return "this host is %s, not lighthouse/ops-host's %s: the pick writes on that host only" % (common.host_name(), want)
    return None


def pick(repo, apply, dry, usage_path=None):
    lanes, budgets = load_lanes(), load_budgets()
    now = time.time()
    usage, usage_why = load_usage(usage_path or usage_file(), now)
    qmax, queues = queue_max(), lane_queues(now)
    ci = load_ci(repo)
    if ci.get("provider") == "circleci":
        raise Refusal("%s is on circleci: the pick moves an Actions check's runs-on only" % repo)
    needs = repo_needs(ci)
    wf = p(repo, ".github", "workflows", "check.yml")
    text = read(wf) if os.path.isfile(wf) else None
    if text is None:
        raise Refusal("%s has no .github/workflows/check.yml: nothing for a lane to run" % repo)
    var = runs_on_var(text)
    s = slug(repo)
    private = is_private(s)
    need = needs | ({"public"} if not private else set())
    if var:
        have, err = variable(s, var)
        if err:
            raise Refusal("could not read %s's variable %s: %s" % (s, var, err))
        try:
            current = json.loads(have) if have is not None else None
        except ValueError:
            current = have
    else:
        # the literal form: what its runs-on names (labels or one image); ubuntu-latest is the
        # variable form's default only
        vals = [v for _, v in runs_on_lines(text)]
        current = (literal_labels(text) or flow_labels(vals[0]) or yaml_value(vals[0]) or "?") if vals else "?"
    cur_lane = lane_of(current, lanes, literal=not var, need=need)
    print("%s (%s, %s; needs %s): lane %s" % (repo, s, "private" if private else "public",
                                              ", ".join(sorted(needs)) or "nothing", cur_lane or "(none of the lanes: %s)" % (current,)))
    stale = stale_lane(s, now) if cur_lane else None
    trust = runners = None
    host = {}
    failed = {}
    hosted, selfh = [], []
    for lane in lanes:
        n = lane["name"]
        if lane["provider"] != "actions":
            print("  lane %s: CircleCI, advisory: a variable moves no check there" % n)
            continue
        if lane["self_hosted"] and lane["projects"]:
            # a self-hosted share lane is check-linux.yml's suites' alone: one job at a time, never check.yml's
            print("  lane %s: a share lane, the Linux share's suites only" % n)
            if n == cur_lane:
                # check.yml sits on it (a variable set by hand): a failing lane, carded when nothing else takes it
                failed[n] = "a share lane, the Linux share's suites only: check.yml never runs there"
            continue
        lacks = lane_lacks(lane, need)
        if lacks:
            print("  lane %s: not eligible, the repo needs %s, the lane runs %s"
                  % (n, ", ".join(sorted(lacks)), ", ".join(sorted(lane["runs"]))))
            if n == cur_lane:
                # the repo sits on a lane it no longer fits (a public repo on the runner Mac): a
                # failing lane, carded when nothing else takes it (the second landing review)
                failed[n] = "the repo needs %s, the lane runs %s" % (", ".join(sorted(lacks)),
                                                                    ", ".join(sorted(lane["runs"])))
            continue
        if n == cur_lane and stale:
            failed[n] = "a check sat queued %d min on it" % stale
            print("  lane %s: skipped, %s" % (n, failed[n]))
            continue
        if lane["self_hosted"]:
            if trust is None:
                try:
                    refuse_forks(s, "a flip to a self-hosted lane")
                    trust = ""
                except Refusal as e:
                    trust = str(e)
            if trust:
                failed[n] = trust
                print("  lane %s: refused, %s" % (n, trust))
                continue
            if lane["runs_on"] not in host:
                # --to self-hosted's other refusals (a narrower probe keeps the old one's): the guard
                # step, and a check that writes the runner login's own (npm -g, sudo, apt-get)
                try:
                    hits = ["%s:%d %s" % (h[0], h[1], h[3]) for h in
                            host_writes(repo, check_command(repo, None), lane["runs_on"])]
                except Refusal as e:
                    hits = [str(e)]
                host[lane["runs_on"]] = ("check.yml lacks the GIT_CONFIG_GLOBAL step (`ci-provider %s --to %s` adds it)" % (repo, SELF)
                        if not GIT_GUARD.search(text) else
                        "the check writes the runner login's own: %s" % "; ".join(hits[:3]) if hits else "")
            if host[lane["runs_on"]]:
                failed[n] = host[lane["runs_on"]]
                print("  lane %s: refused, %s" % (n, failed[n]))
                continue
            if runners is None:
                runners, rerr = runners_of(s)
                runners = runners if runners is not None else ("unread", rerr)
            if isinstance(runners, tuple):
                failed[n] = "the repo's runners are unread (%s)" % runners[1]
                print("  lane %s: refused, %s" % (n, failed[n]))
                continue
            if not any(runs_check(r, lane["runs_on"]) for r in runners):
                why = "no online runner labelled %s" % ", ".join(lane["runs_on"])
                print("  lane %s: refused, %s" % (n, why))
                # a literal sits on a lane by holding part of its list, so the job is served by a
                # runner of what the literal asks for, whatever the lane's other labels: no card
                if var or not isinstance(current, (list, tuple)) or not any(runs_check(r, current) for r in runners):
                    failed[n] = why
                continue
            q = queues.get(n)
            print("  lane %s: eligible, queue %s" % (n, "%ds" % q if q is not None else "unmeasured"))
            selfh.append((lane, q))
        elif not private:
            print("  lane %s: eligible, a public repo's hosted minutes are free" % n)
            hosted.append((lane, float("inf")))
        else:
            left, why = budget_left(lane["account"], budgets, usage, usage_why)
            print("  lane %s: %s, %s" % (n, "eligible" if left is not None else "over budget", why))
            if left is None:
                failed[n] = why
            if left is not None:
                hosted.append((lane, left))
    share_bad = pick_share(repo, s, text, lanes, budgets, usage, usage_why, apply, dry, now)
    choice = (next((l for l, q in selfh if q is None or q < qmax), None)
              or (max(hosted, key=lambda x: x[1])[0] if hosted else None)
              or (min(selfh, key=lambda x: x[1])[0] if selfh else None))
    if choice is None:
        print("  no lane: every eligible lane is refused or over budget; runs-on stays %s" % (current,))
        if cur_lane in failed:
            # the repo sits on a lane this pick refused (trust, money): exit 3 so the desk cards it
            print("  ⚠ current lane %s fails: %s" % (cur_lane, failed[cur_lane]))
            return 3
        return 3 if share_bad else 0
    want = choice["runs_on"]
    if choice["name"] == cur_lane:
        print("  pick: %s, unchanged" % choice["name"])
        return 3 if share_bad else 0
    print("  pick: %s (%s)" % (choice["name"], variable_value(want)))
    if not var:
        why = ("check.yml reads no runs-on variable: `ci-provider %s --to %s --runs-on-var %s` migrates it; "
               "until then the pick only reports it" % (repo, SELF, RUNS_ON_VAR))
        if apply and cur_lane in failed:
            # a literal-form repo on a failing lane is the desk's card, not a routine refusal
            print("  " + why)
            print("  ⚠ current lane %s fails: %s" % (cur_lane, failed[cur_lane]))
            return 3
        if apply:
            raise Refusal(why)
        print("  " + why)
        return 3 if share_bad else 0
    if not apply:
        print("  --apply sets %s to it" % var)
        return 3 if share_bad else 0
    apply_guard(dry)
    undo = set_variable(s, var, want, dry)
    if undo:
        pick_log({"at": int(now), "repo": s, "variable": var, "from": cur_lane, "to": choice["name"],
                  "old": current, "new": want, "undo": undo})
    return 3 if share_bad else 0


def main(argv):
    ap = argparse.ArgumentParser(prog="ci-provider", description=__doc__.split("\n\n")[0])
    ap.add_argument("repo", nargs="?", default=".")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--to", choices=sorted((*CONTEXT, *KIND_ALIASES)))
    g.add_argument("--protect", action="store_true")
    g.add_argument("--compose", action="store_true")
    g.add_argument("--runner", choices=["install", "status", "remove", "caps"])
    g.add_argument("--pick", action="store_true",
                   help="the lane the repo's check takes, by lighthouse's lanes and budgets (--apply writes it)")
    ap.add_argument("--check", help="the check command (default: ci.json, check.yml, the part, AGENTS.md)")
    ap.add_argument("--context", help="with --to: main's required check name, when not the provider's default")
    ap.add_argument("--runs-on-var", metavar="NAME",
                    help=f"with --to {SELF}: runs-on read from the repository variable NAME, so "
                         "check.yml names no machine (by itself CI_RUNS_ON where .helloworld/ is)")
    ap.add_argument("--twin", action="store_true",
                    help=f"with --to {SELF}: check.yml is published to a public twin, so runs-on "
                         "takes the variable form even over a literal (by itself where "
                         ".helloworld/allowlist.txt lists .github/workflows/check.yml)")
    ap.add_argument("--force", action="store_true",
                    help="--protect without a green report; --to dropping what the old CI file held beyond its template")
    ap.add_argument("--host", help="with --runner: the runner Mac's ssh alias (default: wharf/ci-runner-ssh)")
    ap.add_argument("--labels", help="with --runner: its labels, comma-separated (default: wharf/ci-runner-labels)")
    ap.add_argument("--name", help="with --runner: its name on GitHub (default: the first label of its own)")
    ap.add_argument("--instance", type=int, default=1, metavar="N",
                    help="with --runner: the repo's Nth runner on that Mac (2 and up: `<name>-N`, `<repo>-N`)")
    ap.add_argument("--apply", action="store_true", help="with --pick: set the runs-on variable to the pick")
    ap.add_argument("--usage", metavar="FILE", help="with --pick: the desk's usage file (default: the log dir's ci-usage.json)")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)
    a.to = kind_of(a.to)
    if (a.apply or a.usage) and not a.pick:
        ap.error("--apply and --usage go with --pick only")
    if (a.host is not None or a.labels is not None or a.name is not None or a.instance != 1) and not a.runner:
        ap.error("--host, --labels, --name and --instance go with --runner only")
    if a.host is not None and a.name is None:
        # named after its first own label, every Mac of a fleet would register under the shared
        # label's name, and config.sh --replace would take another Mac's registration (review 2026-10-27)
        ap.error("--host needs --name: the runner's name on GitHub, its own")
    if a.instance < 1:
        ap.error("--instance counts from 1")
    if a.name is not None and not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", a.name):
        ap.error("--name: letters, digits, '.', '_' and '-', not starting with a punctuation mark")
    if (a.check or a.context) and not a.to:
        ap.error("--check and --context go with --to only")
    if a.runs_on_var is not None and a.to != SELF:
        ap.error(f"--runs-on-var goes with --to {SELF} only")
    if a.twin and a.to != SELF:
        ap.error(f"--twin goes with --to {SELF} only")
    if a.force and not (a.to or a.protect):
        ap.error("--force goes with --to or --protect")
    # the checkout's top level, not the directory named: from a subdirectory, `.github/` and
    # `.circleci/` would land beside the real ones (review 2026-10-19, 1)
    top = subprocess.run(["git", "-C", a.repo, "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    if top.returncode != 0 or not top.stdout.strip():
        print("ci-provider: %s is not in a git checkout" % os.path.abspath(a.repo), file=sys.stderr)
        return 2
    repo = top.stdout.strip()
    try:
        if a.to:
            switch(repo, a.to, a.check, a.dry_run, a.context, a.force, a.runs_on_var, a.twin)
        elif a.protect:
            protect(repo, a.force, a.dry_run)
        elif a.compose:
            compose(repo, a.dry_run)
        elif a.runner == "caps":
            if a.host is not None or a.labels is not None or a.instance != 1:
                ap.error("--runner caps reads %s: --host, --labels and --instance do not go with it" % CAPS_KEY)
            caps(repo, a.dry_run, a.name)
        elif a.runner:
            labels = None if a.labels is None else [l.strip() for l in a.labels.split(",") if l.strip()]
            runner(repo, a.runner, a.dry_run, a.host, labels, a.name, a.instance)
        elif a.pick:
            return pick(repo, a.apply, a.dry_run, a.usage)
        else:
            status(repo)
    except Refusal as e:
        print("ci-provider: %s" % e, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    # popped here, not at import (bin/repos loads this file): no child of this run inherits it
    READ_TOKEN = os.environ.pop(READ_VAR, None) or None
    sys.exit(main(sys.argv[1:]))
