#!/usr/bin/env python3
"""list-merge — git's merge driver for the lists every branch appends to: TODO.md and CHANGELOG.md.

    list-merge <base> <ours> <theirs> <path>      the result goes into <ours>; exit 0 clean, 3 conflict
    list-merge install [<repo>] [--check] [--here] [--force]
                                                   set (or check) <repo>'s `merge.union.driver`; one that is
                                                   not list-merge's is left alone without --force

Why (the owner, 2026-11-02: TODO.md's ids, then "can you apply this to release notes as well?"): two
branches that each add a TODO item or a CHANGELOG line conflict at the same end of the list, and every
conflict restarts an hour-long check. `merge=union` in .gitattributes ends the conflict but merges the
everyday shapes wrong with no sign (todo-ids' landing review, probed: git 2.54.0): a branch's done of
the last item comes back when main appended meanwhile, a line under the last item moves to main's
append, and a CHANGELOG line a branch added under `## Unreleased` lands under the release main cut
meanwhile (AGENTS.md's trap). This driver merges by item instead.

How it reaches a clone: the attribute stays `merge=union`, and `install` sets the repo's own
`merge.union.driver` (its .git/config, which every worktree shares) to this file. A configured driver of
that name replaces git's built-in union (probed, git 2.54.0; git looks up a user-defined driver before a
built-in one), so a repo on a machine that installed it gets this merge, and anywhere else (GitHub's
server, a CI runner, a repo no session has opened) git's own union runs, as before. wharf's sync.py
installs it in each repo it tends at a session start. Per repo, not global (the landing review): a
global override would reach every union file on the machine and every repo's merges would hang on one
path. The driver line falls back to `git merge-file --union` when this file is gone, so a moved checkout
never jams a merge; git's own union also honours a merge's `-X` options, which merge-file does not.

The model: a file is a preamble, then blocks. A block is a heading (`#`… at column 0), an item (`- `, `* `,
`+ `, `<n>. ` or `<n>) ` at column 0) or a paragraph (column 0 after a blank line), outside a code fence,
with every line after it up to the next block. A heading's key is its path (`# Changelog / ## 0.2.0 /
### Added`), so each release's `### Added` is its own; an item's section is the heading above it. A TODO.md
item is keyed by its `[id]` (todo-md's shape, so a `[x]` checkbox is none), any other block by its first
line. A block one side renamed (its first line, in the slot the old one held: the same block before it or
after it) keeps its identity, so an edit is an edit and two edits of one item conflict; one exception: a
CHANGELOG heading `Unreleased` renamed to a version is a release cut, never a rename. Three-way, with
<ours> as the order to keep:
  - text: one side changed it → that side's; both, the same way → it; both, differently → a conflict
    (git's markers around the two versions of that block alone); a change of the blank lines after a block
    alone is no change, as they follow its neighbours;
  - presence: deleted on one side → gone, unless the other side changed it (kept, changed);
    added → kept, in the section its side put it; a section the other side removed is made again under
    its parent, so a branch's line under `## Unreleased` gets an `## Unreleased` again after a release cut;
  - section: a block one side moved (a release cut) goes where that side put it;
  - order: <ours>'s; a block from <theirs> goes after the one before it there, past what only <ours>
    added there, else at its section's start.
Any other path, a file that does not parse, or a result that lost a line either side added falls back
to `git merge-file --union` (histogram, as merge-ort's union), and so does a clean result whose line counts
differ from a three-way merge's, a section gone that is no release cut, a rename it cannot pair for sure, or a
move within the list on theirs or on both sides. Measured, not proved (round 2's placement fuzzer, which judges only the section
each item lands in, never its order there, with no subsections and no merge where both sides moved, edited or
renamed one block): 3 merges in about 64,000 placed an item worse than union would, each a release cut with a
new section on each side in one merge (1 of them in the 12,000 after the last fix round).
"""
import collections
import difflib
import os
import re
import shlex
import subprocess
import sys

DRIVER_NAME = "union"
CONFLICT = 3
HEAD_RE = re.compile(r"(#{1,6})(?:\s|$)")
ITEM_RE = re.compile(r"(?:[-*+] |\d+[.)] )")
# todo-md's id: lower-case words and digits joined by hyphens, a letter among them, two characters at least
ID_RE = re.compile(r"- \[((?=[a-z0-9-]*[a-z])[a-z0-9]+(?:-[a-z0-9]+)+|(?=[a-z0-9]*[a-z])[a-z0-9]{2,})\] ")
FENCE_RE = re.compile(r"\s*(```|~~~)")
RENAME_LIKE = 0.6  # how alike a renamed block's first line must be to its old one (difflib ratio)
OURS_RE = re.compile(r"list-merge'? %O %A %B %P; s=\$\?")  # the line driver_line writes
DUP_RE = re.compile(r"#\d+$")  # the suffix give_keys puts on a repeated key; a heading's own #s are not it


class Unsure(Exception):
    """The merge cannot be judged safely: fall back to union."""


def kind_of(path):
    name = os.path.basename(path or "")
    if name == "TODO.md":
        return "todo"
    if name.upper() in ("CHANGELOG.MD", "CHANGES.MD", "RELEASE-NOTES.MD", "RELEASE_NOTES.MD"):
        return "changelog"
    return None


def bare(ln):
    return ln.rstrip("\r\n")


def unreleased(text):
    return "unreleased" in text.lower()


class Block:
    __slots__ = ("typ", "level", "first", "lines", "key", "section")

    def __init__(self, typ, level, ln):
        self.typ, self.level, self.first, self.lines, self.key, self.section = typ, level, bare(ln).strip(), [ln], None, None

    def text(self):
        return "".join(self.lines)


def blocks_of(text):
    """(preamble lines, [Block]) — the raw blocks, keys not yet given."""
    pre, blocks, fence, prev_blank = [], [], None, False
    for ln in text.splitlines(keepends=True):
        b = bare(ln)
        start = None
        f = FENCE_RE.match(b)
        if f:  # a fence closes only on the marker that opened it (the landing review: ~~~ inside ```)
            fence = None if fence == f.group(1) else (fence or f.group(1))
        elif not fence:
            h = HEAD_RE.match(b)
            if h:
                start = ("h", len(h.group(1)))
            elif ITEM_RE.match(b):
                start = ("i", 0)
            elif blocks and prev_blank and b.strip() and not b[0].isspace():
                # a paragraph at column 0 after a blank line (helm's group labels): glued to the item above,
                # it made that item read as edited (the history replay)
                start = ("p", 0)
        prev_blank = not b.strip()
        if start:
            blocks.append(Block(start[0], start[1], ln))
        else:
            (blocks[-1].lines if blocks else pre).append(ln)
    return pre, blocks


def give_keys(blocks, kind, renamed=None):
    """Keys and sections in place; `renamed` maps this side's first lines (by block index) to the base's."""
    renamed = renamed or {}
    stack, seen = [], collections.Counter()
    for i, b in enumerate(blocks):
        first = renamed.get(i, b.first)
        if b.typ == "h":
            stack = [s for s in stack if s[0] < b.level] + [(b.level, first)]
            k = "h:" + " / ".join(t for _, t in stack)
        else:
            m = ID_RE.match(b.first) if kind == "todo" and b.typ == "i" else None
            k = f"i:[{m.group(1)}]" if m else f"{b.typ}:{first}"
        seen[k] += 1
        b.key = k if seen[k] == 1 else f"{k}#{seen[k]}"
        b.section = ("h:" + " / ".join(t for _, t in stack)) if stack else None
        if b.typ == "h":
            b.section = b.key


def renames(o, x, kind):
    """{index in x: base first line} for the blocks x renamed: a block of one type and level gone from the
    base and one new in x, in the same slot (the block before it, or after it, is the same in both)."""
    def sig(b):
        return (b.typ, b.level, b.first)
    o_sigs = collections.Counter(sig(b) for b in o)
    x_sigs = collections.Counter(sig(b) for b in x)
    gone = [i for i, b in enumerate(o) if x_sigs[sig(b)] < o_sigs[sig(b)] or sig(b) not in x_sigs]
    new = [j for j, b in enumerate(x) if o_sigs[sig(b)] < x_sigs[sig(b)] or sig(b) not in o_sigs]
    def fits(i, j):
        bo, bx = o[i], x[j]
        if (bo.typ, bo.level) != (bx.typ, bx.level):
            return False
        if kind == "todo" and bo.typ == "i" and (ID_RE.match(bo.first) or ID_RE.match(bx.first)):
            return False  # an id is its own identity
        if kind == "changelog" and bo.typ == "h" and unreleased(bo.first) and not unreleased(bx.first):
            return False  # a release cut, never a rename of Unreleased
        before = (i == 0 and j == 0) or (i > 0 and j > 0 and sig(o[i - 1]) == sig(x[j - 1]))
        after = i + 1 < len(o) and j + 1 < len(x) and sig(o[i + 1]) == sig(x[j + 1])
        # alike as well as in the slot: a new entry on top of an edited one is in the same slot (round 2's
        # review: the new line was paired as the edit and swapped across a release cut)
        return (before or after) and likeness(i, j) >= RENAME_LIKE

    def likeness(i, j):
        """1.0 when one first line begins with the other (an entry reworded by extending it), else difflib's."""
        a, b = o[i].first.rstrip(".:;, "), x[j].first.rstrip(".:;, ")
        return 1.0 if a.startswith(b) or b.startswith(a) else difflib.SequenceMatcher(None, a, b).ratio()

    cands = {i: sorted((j for j in new if fits(i, j)), key=lambda j: -likeness(i, j)) for i in gone}
    out, taken = {}, set()
    for i, js in cands.items():
        js = [j for j in js if j not in taken]
        if not js:
            continue
        # the most alike, when it is plainly the one: a new entry beside an edited one is in the same slot
        # too (round 2's review), so a near tie is no rename anyone can tell
        if len(js) > 1 and likeness(i, js[0]) - likeness(i, js[1]) < 0.2:
            raise Unsure(f"{o[i].first[:60]!r}: which new block renamed it cannot be told")
        out[js[0]] = o[i].first
        taken.add(js[0])
    return out


def same(x, y):
    """Two blocks' texts alike but for the blank lines after them, which follow their neighbours."""
    return x.rstrip() == y.rstrip()


def keep_tail(body, tail_of):
    t = tail_of[len(tail_of.rstrip("\r\n")):]
    return body.rstrip("\r\n") + (t or "\n")


def three(o, a, b):
    """The three-way pick of one block's text; None when both sides changed it differently."""
    if a == o or b == o or a == b:
        return b if a == o else a
    if same(a, o):
        return keep_tail(b, a)  # ours moved only a blank line: theirs' words, ours' spacing
    if same(b, o) or same(a, b):
        return a
    return None


def conflict(a, b, eol):
    a = a if a.endswith("\n") else a + eol
    b = b if b.endswith("\n") else b + eol
    return f"<<<<<<< ours{eol}{a}======={eol}{b}>>>>>>> theirs{eol}"


def merge(o_text, a_text, b_text, kind):
    """(merged text, conflicted?, Counter of heading lines made again for a section the other side removed)"""
    eol = "\r\n" if "\r\n" in a_text else "\n"
    preO, bo = blocks_of(o_text)
    preA, ba = blocks_of(a_text)
    preB, bb = blocks_of(b_text)
    give_keys(bo, kind)
    give_keys(ba, kind, renames(bo, ba, kind))
    give_keys(bb, kind, renames(bo, bb, kind))
    def stem(key):
        return DUP_RE.sub("", key)
    for k in {stem(x.key) for x in bo + ba + bb if DUP_RE.search(x.key)}:
        counts = [sum(1 for x in side if stem(x.key) == k) for side in (bo, ba, bb)]
        if len(set(counts)) > 1:
            # a duplicate deleted, added or edited: which copy a side meant cannot be told (the landing review:
            # a deleted copy came back beside its edited twin)
            raise Unsure(f"{k[:60]!r} is in the file {counts[0]}, {counts[1]} and {counts[2]} times")
    conflicted = False
    made = collections.Counter()  # heading lines ensure_section made again, beyond what the sides imply
    pre = three("".join(preO), "".join(preA), "".join(preB))
    if pre is None:
        raise Unsure("both sides changed the preamble")
    O = {x.key: x for x in bo}
    A = {x.key: x for x in ba}
    B = {x.key: x for x in bb}

    # headings: ours' order; theirs' new ones after their predecessor heading there; theirs' deletions
    heads = [x.key for x in ba if x.typ == "h"
             and not (x.key in O and x.key not in B and same(x.text(), O[x.key].text()))]
    b_heads = [x.key for x in bb if x.typ == "h"]
    for i, k in enumerate(b_heads):
        if k in O or k in A:
            continue
        prev = next((p for p in reversed(b_heads[:i]) if p in heads), None)
        heads.insert(heads.index(prev) + 1 if prev else 0, k)
    head_text = {}
    for k in heads:
        a, b, o = A.get(k), B.get(k), O.get(k)
        if a and b:
            t = three(o.text(), a.text(), b.text()) if o else (a.text() if same(a.text(), b.text()) else None)
            if t is None:
                t, conflicted = conflict(a.text(), b.text(), eol), True
        else:
            t = (a or b).text()
        head_text[k] = t

    def ensure_section(sec, donors):
        """A CHANGELOG's Unreleased section the other side cut into a release, made again under its parent,
        its heading text taken from the side that still has it. Any other section gone is Unsure: union keeps
        the line where it stood, which a remade heading at the top did not (round 2's review: a renamed
        `## Later` came back above `## Now`)."""
        if sec is None or sec in head_text:
            return sec
        # remade only when the first level missing is Unreleased itself: a `### Added` under an Unreleased that is
        # still there was renamed, not cut, and union keeps its line where it stood (round 4's review)
        parts_ = sec[2:].split(" / ")
        first_gone = next(n for n in range(1, len(parts_) + 1) if "h:" + " / ".join(parts_[:n]) not in head_text)
        if not (kind == "changelog" and unreleased(parts_[first_gone - 1])):
            raise Unsure(f"a section the other side removed or renamed: {sec[2:62]!r}")
        parts = sec[2:].split(" / ")
        for n in range(1, len(parts) + 1):
            k = "h:" + " / ".join(parts[:n])
            if k in head_text:
                continue
            src = next((d[k] for d in donors if k in d), None)
            t = src.text() if src else (("#" * n) + " " + parts[n - 1].lstrip("# ") + eol)
            if not t.endswith(eol + eol) and not t.endswith("\n\n"):
                t = t.rstrip("\r\n") + eol + eol
            parent = "h:" + " / ".join(parts[:n - 1]) if n > 1 else None
            heads.insert(heads.index(parent) + 1 if parent in heads else 0, k)
            head_text[k] = t
            made[bare(t.splitlines()[0])] += 1
        return sec

    # blocks: presence, text, section
    final = {}  # key -> (text, section)
    keys = dict.fromkeys([x.key for x in ba if x.typ != "h"] + [x.key for x in bb if x.typ != "h"]
                         + [x.key for x in bo if x.typ != "h"])
    for k in keys:
        o, a, b = O.get(k), A.get(k), B.get(k)
        if o is not None:
            if a is None and b is None:
                continue
            if a is None:
                if same(b.text(), o.text()):
                    continue
                t, sec, donors = b.text(), b.section, (B, O)  # deleted on ours, changed on theirs: kept
            elif b is None:
                if same(a.text(), o.text()):
                    continue
                t, sec, donors = a.text(), a.section, (A, O)
            else:
                t = three(o.text(), a.text(), b.text())
                if t is None:
                    t, conflicted = conflict(a.text(), b.text(), eol), True
                sec, donors = (b.section, (B, O)) if a.section == o.section else (a.section, (A, O))
        else:
            if a is not None and b is not None and not same(a.text(), b.text()):
                t, conflicted = conflict(a.text(), b.text(), eol), True
            else:
                t = (a or b).text()
            sec, donors = (a.section, (A, O)) if a is not None else (b.section, (B, O))
        final[k] = (t, ensure_section(sec, donors))

    # a side that moved blocks the three share, within one section: ours' order would drop theirs' move
    # silently (round 2's review), so a reorder on theirs alone is Unsure
    def shared_order(side):
        return [x.key for x in side if x.typ != "h" and x.key in O and x.key in A and x.key in B]
    so, sa, sb = shared_order(bo), shared_order(ba), shared_order(bb)
    if sb != so and sb != sa:  # ours' order wins below, so any move of theirs it lacks would be lost
        raise Unsure("theirs moved blocks within the list")

    # order within each section: ours' order, then theirs' blocks placed after their predecessor
    order = {s: [] for s in [None] + heads}
    for x in ba:
        if x.typ != "h" and x.key in final:
            order[final[x.key][1]].append(x.key)
    b_items = [x for x in bb if x.typ != "h"]
    for i, x in enumerate(b_items):
        k = x.key
        if k not in final or k in A:
            continue
        seq = order[final[k][1]]
        prev = next((p.key for p in reversed(b_items[:i]) if p.key in seq), None)
        if prev is None:
            pos = 0
        else:
            pos = seq.index(prev) + 1
            while pos < len(seq) and seq[pos] not in O and seq[pos] not in B:
                pos += 1  # past what only ours added after the same block
        seq.insert(pos, k)
    for k, (_t, sec) in final.items():  # a block ours lacked and theirs placed nowhere (none expected)
        if k not in order[sec]:
            order[sec].append(k)

    typ = {x.key: x.typ for x in bo + ba + bb}
    chunks = [(typ.get(k), final[k][0]) for k in order[None]]
    for h in heads:
        chunks.append(("h", head_text[h]))
        chunks.extend((typ.get(k), final[k][0]) for k in order[h])
    out = [pre]
    for t, c in chunks:
        if not c.endswith("\n"):
            c += eol
        # a heading or a paragraph follows a blank line, or Markdown reads it into the block above
        if t in ("h", "p") and out and out[-1] and not out[-1].endswith(("\n\n", "\r\n\r\n")) and "".join(out).strip():
            out[-1] = out[-1].rstrip("\r\n") + eol + eol
        out.append(c)
    result = "".join(out)
    if a_text and not a_text.endswith("\n"):
        result = result.rstrip("\r\n")
    return result, conflicted, made


def miscounted(o_text, a_text, b_text, result, made=None):
    """Non-blank lines whose count in a clean result is not the three-way count: as many as both sides
    hold when they agree, else what each side added or removed over the base, applied once (the landing
    review: a duplicate line's ordinal key shifted, and an entry came back or doubled with no line lost)."""
    def count(t):
        return collections.Counter(bare(l) for l in t.splitlines() if l.strip())
    co, ca, cb, cr = count(o_text), count(a_text), count(b_text), count(result)
    bad = []
    for l in set(co) | set(ca) | set(cb) | set(cr):
        want = (ca[l] if ca[l] == cb[l] else max(0, ca[l] + cb[l] - co[l])) + (made or {}).get(l, 0)
        if cr[l] != want:
            bad.append(l)
    return bad


def lost_additions(o_text, a_text, b_text, result):
    """Non-blank lines either side added (as a multiset over the base) that the result lacks."""
    def count(t):
        return collections.Counter(bare(l) for l in t.splitlines() if l.strip())
    have, base = count(result), count(o_text)
    lost = []
    for side in (a_text, b_text):
        for l, n in (count(side) - base).items():
            if have[l] < n:  # a block the other side deleted is kept when this side changed it
                lost.append(l)
    return lost


def union(o_path, a_path, b_path):
    """git's union, into <ours>, with histogram as merge-ort's union uses (round 2's review: myers brought back a
    line a side deleted); a git before 2.44 refuses the flag and merges without it. A failure reads as a
    conflict, never as clean."""
    for extra in (["--diff-algorithm=histogram"], []):
        r = subprocess.run(["git", "merge-file", "--union", *extra, a_path, o_path, b_path], capture_output=True,
                           text=True)
        if r.returncode == 0:
            return 0
        if r.returncode != 129 or not extra:
            # 129 is the usage error a git without the flag gives before it reads a file; any other failure
            # may have truncated <ours> already, so no retry reads it (round 3's review)
            return CONFLICT
    return CONFLICT


def read(p):
    with open(p, encoding="utf-8", newline="") as f:  # newline="": a CRLF file keeps its line ends
        return f.read()


def run_merge(o_path, a_path, b_path, path):
    kind = kind_of(path)
    if kind is None:
        return union(o_path, a_path, b_path)
    try:
        o, a, b = read(o_path), read(a_path), read(b_path)
        result, conflicted, made = merge(o, a, b, kind)
        lost = lost_additions(o, a, b, result)
        if lost:
            raise Unsure(f"{len(lost)} added line(s) would be lost, the first: {lost[0][:80]!r}")
        # a clean result holds each line exactly as often as a three-way merge of lines would; a block kept
        # because one side deleted it and the other changed it is the one honest exception, and union takes it
        odd = [] if conflicted else miscounted(o, a, b, result, made)
        if odd:
            raise Unsure(f"{len(odd)} line(s) counted otherwise than both sides imply, the first: {odd[0][:80]!r}")
    except Exception as e:  # never worse than union, whatever this file does wrong
        print(f"list-merge: {path}: {type(e).__name__}: {e}; merged as union", file=sys.stderr)
        return union(o_path, a_path, b_path)
    tmp = a_path + ".list-merge"
    try:  # whole or not at all: a crash mid-write never leaves the fallback a partial <ours>, nor a stray file
        with open(tmp, "w", encoding="utf-8", newline="") as f:
            f.write(result)
        os.replace(tmp, a_path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    # 3, not 1: python's own crash exits 1, and git would read it as a conflict holding ours alone, with no
    # markers (the landing review, probed); driver_line maps 3 to git's conflict and anything else to union
    return CONFLICT if conflicted else 0


def main_copy(path):
    """The same file in the main checkout when <path> is in a linked worktree: a driver named by a worktree's
    path would fall back to union once /finish removes it. None when main lacks the file yet."""
    d = os.path.dirname(path)
    r = subprocess.run(["git", "-C", d, "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel"],
                       capture_output=True, text=True)
    parts = r.stdout.split("\n") if r.returncode == 0 else []
    if len(parts) < 2 or not parts[0] or not parts[1]:
        return path  # not in git (a plugin install's copy): this file is the one
    common, top = os.path.realpath(parts[0]), os.path.realpath(parts[1])
    main_top = os.path.dirname(common) if os.path.basename(common) == ".git" else None
    if main_top is None or main_top == top:
        return path
    there = os.path.join(main_top, os.path.relpath(path, top))
    return there if os.path.isfile(there) else None


def driver_line(me):
    """This file through its own shebang; 0 is clean, 3 a conflict (git's 1); anything else, a gone file, a
    missing interpreter or a crash included, is git's union, so no merge ever jams or keeps ours alone. %P
    bare: git quotes it itself (the landing review, probed: a quoted one arrived as `'TODO.md'`)."""
    p = shlex.quote(me)
    return (f'[ -x {p} ] && {p} %O %A %B %P; s=$?; [ $s = 0 ] && exit 0; [ $s = {CONFLICT} ] && exit 1; '
            f'e=$(git merge-file --union --diff-algorithm=histogram %A %O %B 2>&1); r=$?; '
            f'[ $r = 129 ] && exec git merge-file --union %A %O %B; [ $r = 0 ] || echo "$e" >&2; exit $r')


def install(repo, check=False, here=False, force=False):
    """<repo>'s `merge.union.driver`, naming the main checkout's copy of this file (`--here`: this copy,
    wherever it is — the suite's)."""
    me = os.path.realpath(__file__) if here else main_copy(os.path.realpath(__file__))
    if me is None:
        print("list-merge: the main checkout has no list-merge yet; not installed from a worktree")
        return 0
    if not os.access(me, os.X_OK):
        print(f"list-merge: {me} is not executable: every merge would fall back to union (chmod +x it)")
        return 1 if check else 2
    want = driver_line(me)
    key = f"merge.{DRIVER_NAME}.driver"
    r = subprocess.run(["git", "-C", repo, "config", "--get", key], capture_output=True, text=True)
    have = r.stdout.strip()  # any scope: a driver the owner set globally is theirs too (round 2's review)
    if have == want:
        return 0
    if have and not OURS_RE.search(have) and not force:
        if check:
            print(f"list-merge: {repo}: {key} is someone else's ({have[:60]}); left as it is (--force replaces it)")
            return 1
        return 0  # said by --check only: a session start never nags about a driver the owner chose
    if check:
        print(f"list-merge: {repo}: {key} is {have or 'unset'}; want {want}")
        return 1
    for k, val in ((key, want), (f"merge.{DRIVER_NAME}.name", "list-merge: TODO.md and CHANGELOG.md by item, else union")):
        w = subprocess.run(["git", "-C", repo, "config", "--local", k, val], capture_output=True, text=True)
        if w.returncode != 0:
            print(f"list-merge: {repo}: git config {k}: {w.stderr.strip()}", file=sys.stderr)
            return 2
    print(f"list-merge: {os.path.basename(os.path.abspath(repo))}: merges TODO.md and CHANGELOG.md by item"
          + (" (the driver moved)" if have else ""))
    return 0


def main(argv):
    if argv[:1] == ["install"]:
        rest = [a for a in argv[1:] if not a.startswith("--")]
        return install(rest[0] if rest else ".", check="--check" in argv[1:], here="--here" in argv[1:],
                       force="--force" in argv[1:])
    if len(argv) == 4:
        return run_merge(*argv)
    print(__doc__.split("\n\n")[0], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
