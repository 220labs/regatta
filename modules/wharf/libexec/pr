#!/usr/bin/env python3
"""pr — the pull request for the current claude/* branch, without `gh` (absent on the other Mac).

  pr status                       the open PR for this branch: number, title, url — or "none"
  pr ready [--title T] [--body-file F] [--hold] [--drops-ok]
                                  /finish step 11: rename the hook's `WIP: …` PR to T (default:
                                  the branch's first commit subject), replace its body with F
                                  (default: the branch's commit log), and take it out of draft;
                                  opens the PR if the hook could not. Prints the URL. --hold
                                  labels it `hold` before it leaves draft, and keeps the label:
                                  a `/finish --yolo` launch outside a `merge: auto` repo stops
                                  at a ready PR, which automerge would otherwise launch (E12);
                                  a held launch's own session (held_launch()) gets it unasked.
                                  Both ready and merge refuse a PR that changes a path the
                                  branch's `<branch>-raw` never changed — main's newer work
                                  undone by a stale rebuild (strays()); --drops-ok if meant.
                                  Both also refuse, in an unattended /finish the autofinish sweep
                                  started, a curated diff that touches a gate (bin/autofinish's
                                  GATES and the repo's exclusions): the sweep judged the tip
                                  before the run's own edits (refuse_sweep_gate()).
  pr hold                         label this branch's PR `hold` as build CI's own (check_ci.py's
                                  marker and ownership note), so `pr ready` releases it; an
                                  owner's unmarked hold is kept and nothing claimed. /finish
                                  step 11.2, before it pushes onto a PR already ready.
  pr strays [--local]             the same check alone, offline — /finish step 9, before the push:
                                  exit 1 with the list, else `strays: none`
  pr merge [--drops-ok]           rebase-merge it (the one method the repos allow, D9). Only
                                  on the owner's approval — at the laptop's keyboard, or their
                                  explicit yes to this PR on the other Mac; /finish asks. Then, for
                                  every branch this one CARRIES whose content is then proved
                                  on origin/main: close its open PR as "Launched via #N",
                                  record it with its commit; sync.py archives it at the next start.
  pr carried [--launched-via N]   what this branch carries — content taken from other claude/*
                                  branches, as the checkpoint hook recorded it in
                                  .git/…/claude/carries — one `Carries: <branch> (<kind>, PR
                                  #n | no PR)` line each, for /finish's report and PR body.
                                  With --launched-via N (this branch's merged PR, checked; its old spelling --landed-via an alias until the rename's S8) it
                                  does what `merge` does afterwards, for a merge that
                                  happened on github.com. The record is a pointer: a source
                                  is closed only if branches.prove() holds for it, whatever
                                  the record's kind. Nothing here deletes a branch: sync.py
                                  archives a launched one at session start (coding-on-workflow D4).

  pr restack <N> | --all [--dry-run]
                                  a ready claude/* PR GitHub marks DIRTY where git's plain merge
                                  conflicts in list files alone (TODO.md, CHANGELOG.md,
                                  .helloworld/allowlist.txt): rebased onto origin/main in a scratch
                                  worktree of this repo, whose merge.union.driver must be list-merge,
                                  and force-pushed with a lease on the PR's head, so automerge lands it
                                  with no hand step (an allowlist conflict settled as a set). Pushed only
                                  when every TODO.md or CHANGELOG.md both sides changed is `merge=union`,
                                  every other path has no merge attribute and merges clean, the rebase is clean, the list files hold no conflict markers,
                                  `todo-md lint . --base origin/main` passes, a CHANGELOG whose first
                                  `## ` heading was Unreleased still has it first, and `pr carry` holds.
                                  A ready PR whose required check failed before main last moved is
                                  restacked the same way onto main (once a push), and one whose failure
                                  main has not moved past gets its failed jobs rerun, once a run.
                                  Otherwise its finding goes on the PR as a comment, once per tip.
                                  Only a PR opened by the token's own login or the registry's
                                  machine_account (another login's PR, and one labelled `hold`, is left
                                  alone, unsaid), and a DIRTY one only once the base's required checks
                                  passed on its head, or none ever ran there (a push would cancel a running one;
                                  GitHub runs none on a PR that conflicts). --all: every such open, ready claude/* PR of
                                  this repo (the autofinish sweep's call, armed). Never merges, never
                                  touches main. Exit 0 restacked, rerun or nothing to do, 1 refused, 2 not now
                                  (checks running, GitHub or git unanswerable, a lost lease);
                                  --all exits 0 or 2, each refusal on its PR.
  pr carry <before> <after> [--base <ref>]
                                  CI's question after a push (check.yml, check-linux.yml): does <after>
                                  on <base> (default origin/main) add and remove, file by file and in
                                  order, the lines <before> did on its fork, TODO.md and CHANGELOG.md
                                  aside? `CARRY …` exit 0, else `RUN …` exit 1: the workflow then keeps
                                  <before>'s green instead of the whole line.

Token and host come from hooks/common.py: the token git already has, nothing new. Base is the
repo's main (workflow.json "main", else main). docs/record/repo-sync-2026-09-22.md.
"""
import collections
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
sys.path.insert(1, str(Path(__file__).resolve().parent.parent / "lib"))
import core_path  # noqa: E402 — the regatta core (C2); none: one line, exit 2
core_path.require()
import branches  # noqa: E402
import common  # noqa: E402


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, timeout=30).stdout.strip()


def carried(slug, tok, launched_via=None):
    """The lines for /finish: what the hook recorded, per source branch. With `launched_via` —
    the number of THIS branch's merged pull request, checked against GitHub — it also closes a
    carried branch's open PR (a close, not a deletion; the branch and its history stay), but
    only for a source whose content branches.prove() finds on origin/main right then: an
    ancestor of it, or every file the source changed identical there — which, straight after
    the merge, holds exactly when the merge kept everything. The record itself is a pointer,
    never proof: a merge refused on a dirty tree or a resolution that dropped a file leaves the
    same line (second review, 2026-09-24). No live session may hold the source's worktree. Each
    closed one is recorded with its commit in the common git dir's `launched` file, and the
    names are printed; sync.py archives them at the next session start."""
    gitdir = Path(git("rev-parse", "--absolute-git-dir"))
    records = [branches.parse_record(l) for l in branches.read_lines(gitdir / "claude" / branches.CARRIES_NAME)]
    repo = Path(git("rev-parse", "--show-toplevel"))
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD")
    # a seed made off another branch's tip (`pickup seed --beside`) had no worktree to record in: its
    # pointer is the repo's `carried` line, `<carrier> <kind> <sha> <branch>` (routed comments S3)
    for line in branches.read_lines(branches.common_dir(repo) / "claude" / branches.CARRIED_NAME):
        carrier, _, rest = line.partition(" ")
        if carrier == branch and rest.strip() and branches.parse_record(rest) not in records:
            records.append(branches.parse_record(rest))
    if not records:
        return ["Carries: nothing (no content taken from another claude/* branch)"]
    if launched_via:
        st, merged = common.api("GET", f"/repos/{slug}/pulls/{launched_via}", tok=tok)
        if st != 200 or not (merged or {}).get("merged_at") or (merged.get("head") or {}).get("ref") != branch:
            sys.exit(f"pr: #{launched_via} is not this branch's merged pull request — nothing closed")
        # origin/main must hold the merge before prove() means anything; stale tips prove nothing
        if subprocess.run(["git", "fetch", "-q", "origin"], capture_output=True, timeout=60).returncode:
            sys.exit("pr: fetch failed — nothing closed")
    tgt = branches.target(repo, main_branch())
    known = branches.collect(repo)
    now = time.time()
    for path, name, gd in branches.worktrees(repo):
        if name in known:
            known[name].worktree = path
            known[name].live = bool(gd) and branches.lock_fresh(gd, now)
    by_source = {}
    for kind, sha, source in records:
        by_source.setdefault(source, []).append((kind, sha))
    lines, done, today = [], [], datetime.date.today().isoformat()
    record = branches.common_dir(repo) / "claude" / branches.LAUNCHED_NAME  # `landed` before rename S4, still read
    for source, recs in by_source.items():
        b = known.get(source)
        pr = common.find_pr(slug, source, tok)
        tag = f"PR #{pr['number']}" if pr else "no PR"
        kinds = ", ".join(sorted({k for k, _ in recs}))
        if b is None:
            lines.append(f"Carries: {source} ({kinds}, {tag}) — the branch no longer exists")
            continue
        if not launched_via:
            lines.append(f"Carries: {source} ({kinds}, {tag})")
            continue
        proof = branches.prove(repo, b, tgt) if tgt else None
        if not proof:
            lines.append(f"Carries: {source} ({kinds}, {tag}) — carried by #{launched_via} but not proved on "
                         f"main: left open, stays not on main")
            continue
        if b.live:
            lines.append(f"Carries: {source} ({kinds}, {tag}) — launched ({proof}), but a live session holds "
                         f"its worktree: not closed")
            continue
        if pr:
            body = (f"Launched via #{launched_via} — this branch's content reached `main` there, carried "
                    f"across by that branch's session ({proof}). The branch itself stays until the owner "
                    f"deletes it (rule: git-workflow, never a deletion by an agent).")
            common.api("POST", f"/repos/{slug}/issues/{pr['number']}/comments", {"body": body}, tok=tok)
            tag += ", closed" if common.edit_pr(slug, pr["number"], tok, state="closed") else ", could not close"
        # The commit the proof holds for: the tip the other tips descend from. branches.py
        # trusts this line only while every tip is still an ancestor of it.
        tip = b.remote if b.local and b.remote and branches.is_ancestor(repo, b.local, b.remote) else (b.local or b.remote)
        record.parent.mkdir(parents=True, exist_ok=True)
        if not any(branches.parse_launched(l)[:2] == (source, tip) for l in branches.launched_lines(repo)):
            with record.open("a") as f:
                f.write(f"{source} {tip} via #{launched_via} {today}\n")
        lines.append(f"Carries: {source} ({kinds}, {tag}) — launched: {proof}")
        done.append(b)
    if done:
        lines.append("Carried branches launched — archived at the next session start: " + ", ".join(b.name for b in done))
    return lines


def strays(up, branch):
    """Paths the PR changes against `up` (origin/main) that the branch's own work never changed,
    as `<git status letter> path` — None when there is no `<branch>-raw` to judge by
    (knowledge-commit only rebases, and a rebase cannot undo main). /finish step 8 rebuilds the
    branch from -raw's tree; reset to anything newer than -raw's own base (`--soft origin/main`,
    2026-10-11) and the commit undoes whatever main changed since: ec782b3 deleted five docs and
    cut a lessons section #276 had launched 82 seconds before, and step 9's `diff -raw HEAD` was
    empty by construction."""
    raw = f"{branch}-raw"
    if not git("rev-parse", "-q", "--verify", f"refs/heads/{raw}"):
        return None
    fork = must("merge-base", up, raw)

    def names(*a):
        return set(must("-c", "core.quotePath=false", "diff", "--name-only", "--no-renames", *a).splitlines())

    def blob(ref, path):  # "" for a path the ref lacks
        return git("rev-parse", "-q", "--verify", f"{ref}:{path}")

    own = names(fork, raw)
    out = []
    for line in must("-c", "core.quotePath=false", "diff", "--name-status", "--no-renames", f"{up}...HEAD").splitlines():
        st, _, path = line.partition("\t")
        if path and path not in own:
            out.append(f"{st[:1]} {path}")
    # A file both sides changed: HEAD sits on main's newer copy (its base, not up — step 9 runs
    # before the rebase) yet carries exactly -raw's, so main's edit is undone inside a file the
    # branch owns (review, finding 1).
    on = must("merge-base", up, "HEAD")
    for path in sorted(own & names(fork, on)):
        mine, theirs = blob("HEAD", path), blob(on, path)
        if mine == blob(raw, path) and theirs != blob(fork, path) and theirs != mine:
            out.append(f"M {path} (main's edit undone)")
    return out


def must(*args):
    """git() for the stray check: a failed call refuses, never reads as "nothing stray"."""
    r = subprocess.run(["git", *args], capture_output=True, text=True, timeout=30)
    if r.returncode:
        sys.exit(f"pr: could not judge the PR against -raw (git {args[-2] if len(args) > 1 else args[0]} …: "
                 f"{r.stderr.strip()[:200]}) — nothing changed on GitHub")
    return r.stdout.strip()


def refuse_strays(up, branch, verb, args):
    """Stop `ready`/`merge`/`strays` on strays() unless --drops-ok says the PR means it."""
    found = strays(up, branch)
    if not found:
        return
    # the override is a person's: the run that made the stale tree would judge it right too
    # (step 9 printed nothing for ec782b3) — code review, finding 6
    unattended = bool(os.environ.get("CLAUDE_UNATTENDED"))
    if "--drops-ok" in args and not unattended:
        return
    sys.exit(f"pr: NOT {verb} — this PR changes {len(found)} path(s) that {branch}-raw, the branch's "
             f"own work, never changed:\n  " + "\n  ".join(found[:12]) + (f"\n  … +{len(found) - 12}" if len(found) > 12 else "") +
             f"\nMain changed them after the branch forked (D: main added it, A: main removed it, M: "
             f"main edited it) and the curated tree predates that — a reset to {up} instead of the "
             f"merge-base undoes it. Rebuild from -raw, never back it up again (that would save this "
             f"tree as -raw and pass): `git reset -q --hard {branch}-raw`, then step 8's reset to "
             f"`git merge-base main HEAD` and its commits. If -raw is what is stale — commits after "
             f"step 8 — rerun step 8 whole. "
             + ("--drops-ok is refused unattended: stop and hand it to the owner." if unattended
                else "If the PR really means it, rerun with --drops-ok."))


def run_record(me):
    """autofinish-run's state for this session: this worktree's, else — a sibling repo /finish
    step 11 launches from the run's own worktree — the one in the worktree the session's transcript
    started in (review, 2026-10-19). None when neither names this session (no id: this one's)."""
    def read(gitdir):
        try:
            st = json.loads((Path(gitdir) / "claude" / common.AUTOFINISH_RUN).read_text())
        except (OSError, ValueError):
            return None
        return st if isinstance(st, dict) else None
    st = read(git("rev-parse", "--absolute-git-dir"))
    if st and (not me or not st.get("session") or st["session"] == me):
        return st
    if not me:
        return None
    cfg = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()
    for t in (cfg / "projects").glob(f"*/{me}.jsonl"):
        try:
            with open(t, errors="replace") as f:
                cwd = next((rec.get("cwd") for rec in map(lambda l: json.loads(l) if l.strip() else {}, f)
                            if isinstance(rec, dict) and rec.get("cwd")), None)
        except (OSError, ValueError):
            continue
        try:  # bounded: a dead mount must not hang `pr ready`
            r = subprocess.run(["git", "-C", cwd, "rev-parse", "--absolute-git-dir"], capture_output=True,
                               text=True, timeout=10) if cwd and Path(cwd).is_dir() else None
        except (OSError, subprocess.TimeoutExpired):
            r = None
        other = read(r.stdout.strip()) if r and not r.returncode else None
        if other and other.get("session") == me:
            return other
    return None


def held_launch():
    """Why this session's own launch is held at a ready PR (autofinish-run's `hold`: mode ask, the dnd
    slice; or the keel's `keel_hold`), or None. The launch's own session only: the owner's `pr merge`
    from a terminal (no session id) is the tap it waits for."""
    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    st = run_record(me)
    if st and me and st.get("session") == me and not st.get("ended") and (st.get("hold") or st.get("keel_hold")):
        return st.get("hold") or "the keel holds it (--hold)"
    return None


def refuse_sweep_gate(up, base, verb, hold=None):
    """Stop `ready`/`merge` in an unattended `/finish` the sweep started (autofinish-run's state:
    by=sweep, or yolo — a retry the sweep starts for a yolo run that died, bin/autofinish
    runner_by — not ended, this session) whose curated diff touches a gate. The sweep judged the
    tip before the start; the run's own edits (step 1's fix to a hook or to bin/pr) come after,
    and could launch a gate unwatched (autofinish-widen item 3, the 2026-10-10 note).
    autofinish's touches_gate and repo_config, so the gates are the sweep's own list; autofinish
    is wharf-runs' (G1), found through common.tool(), and a sweep record with none found to read
    the gates refuses, as an unreadable config does. `hold`: at merge the PR is ready already, so
    automerge would launch it — labelled `hold` first.
    A mode launch (by yolo or dnd, or the sweep's rule M; skipper-modes S3b) is judged again here by
    autofinish's held_slice under the branch's mode now: a mode lowered since the start, or a run's
    own edit into the held slice, stops it as a gate does (landing review 1).
    A brief launch (by=brief: rule C from the yes at the brief, autofinish-exclude S7) is judged by
    autofinish's brief_held, not the whole list: the yes covers class 1 and 3, never class 2 or the list.
    A hand-over (by=handed: dispatch landing a done build, task-shape S2) is judged by autofinish's
    handed_held, as at its start: under D1-C its slice is empty, so a diff or config that will not read, a
    binary, a `.gitattributes` change or the launcher's own gates stop it; with rule M it is a mode launch and
    re-judged as one. It is no person's yes, so mode ask now, or a mode that will not read now, stops it too,
    as landing() holds it at the start. A handed start held already, on its mode or by handed_held, is not
    re-judged: held_launch() keeps it from merging and `ready` labels it `hold` (a brief run's mode is not
    re-read: its start never held on an unread mode)."""
    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    st = run_record(me)
    why = held_launch() if verb == "merged" else None
    if why:
        # a held launch stops at a ready PR; its prompt says so and its permissions deny `pr merge` —
        # this is the third wall, for a session whose rules were widened by hand (follow-ups' landing
        # review, item 4); `ready` labels it `hold` itself (the second landing review)
        keep = "" if hold is None else (" The PR is labelled `hold`, so automerge leaves it." if hold()
                                        else " The PR could not be labelled `hold`: label it, or automerge may launch it.")
        sys.exit(f"pr: NOT merged — this launch is held at a ready PR ({why}); it lands by "
                 f"{common.OWNER_NAME or 'the owner'}'s tap, never by its own run.{keep}")
    # `lander` (stuck-ships S1, task-shape D1-C) is re-judged as `handed` is: it lands what a typed /finish lands,
    # every gate run, and is no person's yes; carrying a mode flag (`land_by`), it is that mode's launch
    if not st or st.get("by") not in ("sweep", "yolo", "dnd", "ship", "brief", "handed", "lander") or st.get("ended"):
        return
    # the labels judged by their own slice rather than the whole list (autofinish-run's landing())
    mode_launch = st.get("rule") == "M" or (st.get("by") == "lander" and st.get("land_by"))
    own = {"brief": "brief_held", "handed": "handed_held", "lander": "handed_held"}.get(st.get("by")) \
        if not (st.get("by") in ("handed", "lander") and mode_launch) else None
    from importlib.machinery import SourceFileLoader
    found = common.tool("autofinish")
    gate, problem = None, "autofinish (wharf-runs) is not installed"
    if found:
        af = SourceFileLoader("autofinish", str(found)).load_module()
        primary = str(Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent)
        cfg = af.repo_config(primary, base)
        _, _, problem, exclude = cfg
        if own:
            try:
                held = getattr(af, own)(primary, git("rev-parse", "--show-toplevel"), base, cfg=cfg)
            except Exception as e:  # noqa: BLE001 — what it cannot read is a hold (an autofinish without handed_held too)
                held = f"the {st.get('by')} launch's held paths could not be read ({type(e).__name__})"
            gate = f"held: {held}" if held else None
            if own == "handed_held":
                # handed_held judges the config itself and holds on one that will not read, while a repo with
                # no workflow.json of its own (a repos.json opt-in) holds nothing, as a typed /finish there
                problem = None
            # held_launch(), not the record's `hold`: it is what labels the PR and refuses the merge, and it
            # answers only for the launch's own session (S2's review round 4). A start held already, by the mode
            # or by handed_held itself, is left to it and the `hold` label, a ready PR as its prompt promised;
            # only `ready` reaches here held, as `merged` stopped above (the landing review)
            if own == "handed_held" and held_launch():
                gate = None
            elif own == "handed_held" and not gate:
                # handed is no person's yes, so mode ask holds it at the start (landing()): a mode lowered to ask
                # since, or one that cannot be read now, stops it here as it stops a mode launch
                mode, why_mode = af.landing_mode(git("symbolic-ref", "--quiet", "--short", "HEAD"), primary)
                if af.mode_unreadable(why_mode):
                    gate = f"held: the mode is unreadable now ({why_mode})"
                elif mode == "ask":
                    gate = "held: mode ask — nothing lands by itself"
        else:
            # read here only: a brief or handed run is judged by its own slice, and must() exits on a git failure
            paths = must("-c", "core.quotePath=false", "diff", "--name-only", "--no-renames", f"{up}...HEAD").splitlines()
            gate = af.touches_gate(primary, base, exclude, paths)
        if not gate and not problem and not own and (st.get("by") in af.LAND_MODES or mode_launch
                                         or st.get("by") == "ship"):
            mode, why_mode = af.landing_mode(git("symbolic-ref", "--quiet", "--short", "HEAD"), primary)
            # autofinish's effective_mode, the rule landing() judged the start by (follow-ups' landing review,
            # item 8): a mode that cannot be read now holds, never falls back to the start's eff_mode; with no
            # mode now, the start's `eff_mode` (a record from before the key reads None, and None holds);
            # a ship's mode-less task reads `default`, so a ship takes the start's eff_mode there too
            eff = af.effective_mode(st.get("by"), mode, recorded=st.get("eff_mode"),
                                    unreadable=af.mode_unreadable(why_mode))
            try:
                held = (f"the mode is unreadable now ({why_mode})" if af.mode_unreadable(why_mode)
                        else af.held_slice(primary, git("rev-parse", "--show-toplevel"), base, eff))
            except Exception as e:  # noqa: BLE001 — what it cannot read is a hold
                held = f"the held slice could not be read ({type(e).__name__})"
            if held:
                was = st.get("land_mode")   # the mode landing() read at the start (item 8)
                gate = f"held: {held}" + (f"; mode {was} at the start" if was and was != mode else "")
    if gate or problem:
        why = f"the curated diff touches a gate ({gate})" if gate else f"its gates could not be read ({problem})"
        if hold is None:
            keep = "leave the PR a draft"
        else:
            keep = ("the PR is labelled `hold`, so automerge leaves it" if hold()
                    else "the PR is ready and could not be labelled `hold`: label it, or automerge may launch it")
        who = {"handed": "a dispatch hand-over (by handed)", "lander": "the lander's road (by lander)"}.get(
            st.get("by"), "the autofinish sweep")
        sys.exit(f"pr: NOT {verb} — this /finish was started by {who}, and {why}. "
                 f"A gate launches by a /finish or /autofinish {common.OWNER_NAME or 'the owner'} starts, never unwatched: stop with "
                 f"`⚠ step 11 — {why}`; {keep}.")


# ---- restack: a ready PR GitHub marks DIRTY on list files, or red on a base main has moved past -----
#
# Why (the owner, 2026-11-03: "We should have a tool for that now that resolves in finish"): GitHub's
# server merge runs no custom driver and does not even apply `merge=union`, so a ready PR whose base gained
# a TODO.md or CHANGELOG.md line reads CONFLICTING (regatta#439, #442 twice), while a local rebase with
# list-merge is clean. Each cost a hand rebase, the owner's word for the force push and a fresh 85-min check.
# Widened (restack-clean-overlap, the owner 2026-11-04 on #434: "figure out how to make resolution of trivial
# conflicts like that automatic and not rerun the CI"): #434 changed README.md and `limits` beside main too,
# in hunks git merged clean, and the first build refused any non-list path changed on both sides. Now the
# judge is git's plain merge: the rebase runs with list-merge on the list files alone, every other path both
# sides changed must carry no merge attribute (git's text merge, which GitHub's own merge also runs), and a
# conflict there stops the rebase and refuses. So "may restack" is "every path git's plain merge conflicts in
# is a list file", decided by the one rebase whose result is pushed.
#
# Why the push is no new permission: it is the push /finish's step 11 makes (`--force-with-lease` of the
# branch's own claude/* ref after its rebase onto origin/main), of commits the launch already approved, and
# the PR was ready, so its landing was already decided; this tool never merges (automerge.yml lands the new
# head under the same required checks) and never writes main. The lease is the PR head GitHub showed, so a
# push by anyone meanwhile wins. Its gate is what it may change: a rebase whose plain merge conflicted in
# list files alone, with the PR's own lines unchanged (carry_verdict).
# Why carrying the green adds no risk: main's protection is `strict: false`, so GitHub already lands a green PR
# onto a moved main with no re-test when the merge is textually clean, and automerge rebase-merges, commit by
# commit, as this rebase does. A rebase whose only conflicts are list files, merged by item, is the tree
# GitHub would land had it run the driver; the carry keeps the green only where the PR's own added and
# removed lines are unchanged, so what it accepts untested is main's commits, which `strict: false` accepts.
# Why no re-landing: automerge lands a ready PR's new head by itself, so no autofinish run is asked for and
# autofinish-run's "no retry on the same tip" never meets it; the tip is new besides, a rebase's commits.
#
# The red road (the owner, 2026-11-04: "why is this not a mechanism yet?"): on #434 a draft/ready toggle
# reran `check` on the stale merge ref after main's fix, an hour lost. A rerun replays the same merge commit,
# so a failure main has fixed since fails again; a restack onto main makes a new tip CI tests against the fix.
# A required check that saw an old main (a merge-ref run made before main's tip landed: the run's `created_at`,
# which a rerun keeps; a head-tested status on a head behind main) is restacked, never rerun; on a tip a red
# restack made, or tried from, it is left. One that saw main's tip gets `rerun-failed-jobs`, once a run (a flake).
# So a PR red on its merits costs, per push of its own, one red restack and one rerun per run at most; past
# them the red is the PR's own and nothing more is spent. The bound's marks are PR comments written before the
# act they bound, so a lost mark never repeats it.

LIST_FILES = ("TODO.md", "CHANGELOG.md")   # list-merge's kinds (its kind_of): their patch the carry never reads
# settled by restack_tree with list-merge's set merge (set_settle: what either side deleted stays gone, nothing
# twice), and judged by the carry against that merge: two branches each listing a new file conflict at the same
# alphabetical slot (#464 at 11:41, beside wharf's CHANGELOG). It carries no merge attribute, so a plain merge
# conflicts there everywhere else: union (the build review, probed twice) revived a path main took off the list,
# which would publish it again.
LIST_PATHS = (".helloworld/allowlist.txt",)
RESTACK_MARK = "<!-- pr-restack tip=%s -->"        # a finding on that tip: once a tip
RESTACK_DONE = "<!-- pr-restack pushed=%s -->"     # a push that made that tip: never read as a finding on it
RESTACK_RED = "<!-- pr-restack red=%s -->"         # a push the red road made: that tip is never red-restacked again
RESTACK_RED_FROM = "<!-- pr-restack red-from=%s -->"   # a red restack tried from that tip: never tried again
RESTACK_RERUN = "<!-- pr-restack rerun=%s -->"     # a run whose failed jobs were rerun: once a run
MARKER_RE = r"^(<<<<<<< |=======$|>>>>>>> )"
RESTACK_WAIT = float(os.environ.get("PR_RESTACK_WAIT", "3"))   # GitHub computes mergeable_state lazily
RUN_ID_RE = re.compile(r"/actions/runs/(\d+)")
RED_CONCLUSIONS = ("failure", "timed_out", "startup_failure")   # never `cancelled`: a cancel is someone's choice


def run(cwd, *args, timeout=120, env=None):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, timeout=timeout,
                          env=None if env is None else {**os.environ, **env})


def is_list_file(path):
    """Restacked by itself: a path list-merge merges by item, or one merged as union (LIST_PATHS)."""
    return os.path.basename(path) in LIST_FILES or path in LIST_PATHS


def carry_exempt(path):
    """A path whose patch the carry never compares: a release cut moves a CHANGELOG line, and no suite reads
    this repo's TODO.md or CHANGELOG.md bar `todo-md lint`, which the carry runs."""
    return os.path.basename(path) in LIST_FILES


def names_between(cwd, a, b):
    # -z: a name holding `"`, `\` or a control character is C-quoted even under quotePath=false, and the quoted
    # string matches no path in ls-tree, which read as "the same" at every rev (round 2's probe)
    r = run(cwd, "diff", "--name-only", "-z", "--no-renames", a, b)
    if r.returncode:
        raise RuntimeError(f"git diff {a[:8]} {b[:8]}: {r.stderr.strip()[:200]}")
    return set(r.stdout.split("\0")) - {""}


def entry_at(cwd, rev, path):
    """The tree entry, mode and type with the object (`ls-tree`): a blob id alone misses a `chmod -x` or a
    file swapped for a link of the same text (the build review, probed). "" for a path the rev lacks."""
    return run(cwd, "--literal-pathspecs", "ls-tree", "--full-tree", rev, "--", path).stdout.strip()


def unreleased_first(text):
    """True when the file's first `## ` heading is Unreleased (Keep a Changelog's `[Unreleased]` too)."""
    head = next((l for l in (text or "").split("\n") if l.startswith("## ")), "")
    return bool(re.match(r"##\s+\[?unreleased\]?\s*$", head, re.I))


def changed_lines(cwd, a, b, path):
    """What <path>'s diff a..b adds and removes, in order, as bytes: every `+`, `-` and `\\ No newline` line,
    and the mode lines (a new file, a deletion, a chmod, a type change), with no context, no hunk positions and
    no blob ids. Bytes, not text: universal newlines would read a CRLF → LF change as none. Not patch-id, which
    drops whitespace (AGENTS.md's trap): a space changed inside a line counts. None for a binary diff, whose
    lines say nothing."""
    r = subprocess.run(["git", "--literal-pathspecs", "diff", "-U0", "--no-renames", "--no-color", "--no-ext-diff",
                        "--no-textconv", a, b, "--", path], cwd=cwd, capture_output=True, timeout=120)
    if r.returncode:
        raise RuntimeError(f"git diff {a[:8]} {b[:8]} -- {path}: {r.stderr.decode(errors='replace').strip()[:200]}")
    out, body = [], False
    for ln in r.stdout.split(b"\n"):
        if ln.startswith(b"diff --git "):
            body = False   # a type change is two sections, a deletion and a creation
        elif not body:
            # the header: `--- a/x` and `+++ b/x` are no content, while a removed line `-- x` reads `--- x` in the body
            if ln.startswith(b"@@"):
                body = True
            elif ln.startswith((b"Binary files ", b"GIT binary patch")):
                return None
            elif ln.startswith((b"old mode ", b"new mode ", b"new file mode ", b"deleted file mode ")):
                out.append(ln)
        elif ln[:1] in (b"+", b"-", b"\\"):
            out.append(ln)
    return out


def blob_bytes(cwd, rev, path):
    """<path>'s bytes at <rev>, or None where the rev has no such blob."""
    r = subprocess.run(["git", "cat-file", "blob", f"{rev}:{path}"], cwd=cwd, capture_output=True, timeout=60)
    return None if r.returncode else r.stdout


def clean_merge(cwd, f_old, f_new, before, after, path):
    """True when <path> at <after> is exactly what git's three-way merge of <before>'s change (f_old → before)
    onto main's copy at f_new makes, with no conflict: list-merge's set merge for LIST_PATHS (the same lines,
    in any order, as the order is free there), else git's plain text merge.

    Why (round 1 of the build review, probed): equal added and removed lines are no proof of the tree. A rebase
    whose conflict was resolved by hand, keeping the PR's lines and dropping main's, and an amend that moves a
    line into another function both keep the lines, while GitHub would have refused the first as DIRTY and CI
    never ran the second. A clean merge is what GitHub lands under `strict: false`, so only it is carried.
    Blobs go through temp files: `merge-file --object-id` needs git 2.43, newer than the oldest runner Mac's (2.37)."""
    texts = [blob_bytes(cwd, rev, path) for rev in (f_new, f_old, before, after)]
    if any(t is None for t in texts):
        return False   # created or deleted somewhere: the strict rule's case, never this one
    tmp = tempfile.mkdtemp(prefix="pr-carry-")
    try:
        names = []
        for i, t in enumerate(texts[:3]):
            names.append(os.path.join(tmp, str(i)))
            with open(names[-1], "wb") as f:
                f.write(t)
        if path in LIST_PATHS:   # the driver the rebase ran: <ours> (main's copy) takes the result
            lm = Path(__file__).resolve().parent.parent / "bin" / "list-merge"
            r = subprocess.run([sys.executable, str(lm), names[1], names[0], names[2], path], capture_output=True,
                               timeout=60)
            with open(names[0], "rb") as f:
                got = f.read()
            return r.returncode == 0 and sorted(got.split(b"\n")) == sorted(texts[3].split(b"\n"))
        for extra in (["--diff-algorithm=histogram"], []):   # merge-ort's algorithm; a git before 2.44 lacks the flag
            r = subprocess.run(["git", "merge-file", "-p", "-q", *extra, *names], capture_output=True,
                               timeout=60)
            if r.returncode != 129 or not extra:
                break
        return r.returncode == 0 and r.stdout == texts[3]
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def listed(cwd, rev, path):
    """A LIST_PATHS file's entries at <rev>, counted as the publish gate reads them (helloworld's lines_of: stripped,
    blank and `#` lines skipped); empty for any other path."""
    if path not in LIST_PATHS:
        return collections.Counter()
    return collections.Counter(l.strip() for l in (blob_bytes(cwd, rev, path) or b"").decode(errors="replace").split("\n")
                               if l.strip() and not l.strip().startswith("#"))


def doubled(cwd, before, after, path):
    """The entries <after> lists twice or more that <before> did not: the publish gate refuses them ("listed
    twice") on every Mac once on main, and the gate never runs in CI (round 1's and 2's probes: union doubled one,
    and `foo.md ` beside `foo.md`)."""
    now, was = listed(cwd, after, path), listed(cwd, before, path)
    return sorted(k for k, c in now.items() if c > 1 and c > was.get(k, 0))


def carry_verdict(before, after, up, cwd=None):
    """(True, why) when <after>'s patch on its fork is <before>'s on its own, TODO.md and CHANGELOG.md aside:
    every other path either side changes holds the same entry at both heads and at both forks, or the same
    added and removed lines in order, whatever context and positions main's commits gave them, in a file that is
    exactly a clean merge of the PR's change onto main's (clean_merge). Then what CI would run on <after>
    differs from <before>'s run only by main's own commits and the lists, and the first is what the
    protection's `strict: false` already lands untested (check.yml's CI_SKIP_MAIN_PUSH comment; the restack
    section's header says why)."""
    for rev in (before, after, up):
        if run(cwd, "cat-file", "-e", f"{rev}^{{commit}}").returncode:
            return False, f"{rev[:12]} is not here"
    f_old = run(cwd, "merge-base", up, before).stdout.strip()
    f_new = run(cwd, "merge-base", up, after).stdout.strip()
    if not f_old or not f_new:
        return False, "no merge base with " + up
    try:
        paths = names_between(cwd, f_old, before) | names_between(cwd, f_new, after)
    except RuntimeError as e:
        return False, str(e)
    lists = sorted(p for p in paths if carry_exempt(p))
    by_lines = []
    for p in sorted(paths - set(lists)):
        if entry_at(cwd, before, p) == entry_at(cwd, after, p) and entry_at(cwd, f_old, p) == entry_at(cwd, f_new, p):
            continue
        try:
            old, new = changed_lines(cwd, f_old, before, p), changed_lines(cwd, f_new, after, p)
            if old is None or new is None or old != new:
                return False, f"{p} differs between the two patches ({'a binary file' if old is None or new is None else 'its added or removed lines'})"
            if not clean_merge(cwd, f_old, f_new, before, after, p):
                return False, f"{p} differs between the two patches (not what a clean merge onto main's copy makes)"
            twice = doubled(cwd, before, after, p)
            if twice:
                return False, f"{p} lists {twice[0][:80]} twice"
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            return False, str(e)
        by_lines.append(p)
    lines = f"; {', '.join(by_lines[:8])}{' …' if len(by_lines) > 8 else ''} by its own lines, main's context aside" if by_lines else ""
    return True, f"the patch is {before[:8]}'s, list files aside ({', '.join(lists) or 'none'}){lines}"


def gh_pull(slug, n, tok):
    """The PR with GitHub's mergeable_state, asked again while GitHub has not judged it; None when unanswered."""
    p = None
    for i in range(4):
        st, p = common.api("GET", f"/repos/{slug}/pulls/{n}", tok=tok)
        if st != 200 or not isinstance(p, dict):
            return None
        if p.get("mergeable_state") not in (None, "unknown"):
            return p
        if i < 3:
            time.sleep(RESTACK_WAIT)
    return p


def gh_open_pulls(slug, tok):
    """Every open PR, paged (the checkpoint hook opens a WIP draft per branch, so a busy repo passes 100); None
    when GitHub does not answer."""
    out = []
    for page in range(1, 21):
        st, prs = common.api("GET", f"/repos/{slug}/pulls?state=open&per_page=100&page={page}", tok=tok)
        if st != 200 or not isinstance(prs, list):
            return None
        out += prs
        if len(prs) < 100:
            return out
    return out


def said_on(slug, n, mark, tok):
    """True when a comment holding <mark> is on the PR already (a finding: one comment a tip, however many
    sweeps), and when the comments cannot be read: a failed read must not post again every tick, nor rerun or
    red-restack again."""
    for page in range(1, 21):   # oldest first, 100 a page: the mark may sit past the first
        st, items = common.api("GET", f"/repos/{slug}/issues/{n}/comments?per_page=100&page={page}", tok=tok)
        if st != 200 or not isinstance(items, list):
            return True
        if any(mark in str((c or {}).get("body") or "") for c in items):
            return True
        if len(items) < 100:
            return False
    return True


def leave(slug, n, tip, tok, text, dry):
    if dry or said_on(slug, n, RESTACK_MARK % tip, tok):
        return
    common.api("POST", f"/repos/{slug}/issues/{n}/comments", {"body": f"{RESTACK_MARK % tip}\n{text}"}, tok=tok)


def worktree_of(primary, ref):
    """The worktree that has refs/heads/<ref> checked out, or None."""
    return next((path for path, name, _gd in branches.worktrees(Path(primary)) if name == ref), None)


def restack_tree(primary, ref, sha, base, dry, red=False, before_push=None):
    """(code, text, new): the rebase and its gates; pushed unless dry. code 0 pushed (or would), 1 refused
    with a finding for the PR, 2 not judged now (try again; nothing said on the PR). <red>: the red road's
    call, for a PR GitHub may not mark DIRTY, so no path need be changed on both sides. <before_push>(new): what
    must be written before the push (the red road's mark), False to push nothing."""
    up = f"origin/{base}"
    f = run(primary, "fetch", "-q", "--no-tags", "origin", f"+refs/heads/{base}:refs/remotes/origin/{base}",
            f"+refs/heads/{ref}:refs/remotes/origin/{ref}", timeout=180)
    if f.returncode:
        return 2, f"fetch failed: {f.stderr.strip()[:200]}", None
    if run(primary, "rev-parse", "-q", "--verify", f"refs/remotes/origin/{ref}").stdout.strip() != sha:
        return 2, f"origin's {ref} is not the PR's head {sha[:8]} now: judged at the next pass", None
    lm = Path(__file__).resolve().parent.parent / "bin" / "list-merge"
    # A local branch past the PR's head is work origin lacks: a restack under it would leave that work to a
    # rebase by hand. A worktree on the head itself (the /finish session that readied it, idle or not) loses
    # nothing: its next push is refused as non-fast-forward, never forced, and its own /finish's lease reads
    # the origin ref this updates, so that rebase replaces the restack whole.
    path = worktree_of(primary, ref)
    local = run(primary, "rev-parse", "-q", "--verify", f"refs/heads/{ref}").stdout.strip()
    if local and local != sha and run(primary, "merge-base", "--is-ancestor", local, sha).returncode:
        return 1, (f"its local branch here ({local[:8]}{', in ' + str(path) if path else ''}) holds commits the "
                   f"PR's head lacks: its own `/finish` rebases and pushes them"), None
    fork = run(primary, "merge-base", up, sha).stdout.strip()
    if not fork:
        return 1, f"no merge base with {up}", None
    # a merge commit's own edit is lost by the rebase, which flattens it (the build review, probed): /finish's
    merges = run(primary, "rev-list", "--merges", f"{fork}..{sha}").stdout.split()
    if merges:
        return 1, (f"the PR holds {len(merges)} merge commit(s) ({merges[0][:8]}): a rebase would drop what a merge "
                   f"changed itself, so `/finish` rebases it"), None
    if red and fork == run(primary, "rev-parse", up).stdout.strip():
        return 1, f"it is on {up}'s tip already: nothing to restack onto", None
    both = sorted(names_between(primary, fork, sha) & names_between(primary, fork, up))
    if not both and not red:
        return 1, "GitHub says DIRTY, yet no path changed on both sides since the fork: not a list file's conflict", None
    lists = [p for p in both if is_list_file(p)]
    plain = [p for p in both if not is_list_file(p)]
    tmp = tempfile.mkdtemp(prefix="pr-restack-")
    wt = os.path.join(tmp, "tree")
    try:
        a = run(primary, "worktree", "add", "-q", "--detach", wt, sha)
        if a.returncode:
            return 2, f"no scratch worktree: {a.stderr.strip()[:200]}", None
        # -z: a path is read whole, whatever it holds (a `: ` in a name would split a line wrong). Read at main's
        # tip and at the PR's head: each pick merges under the tree it lands on, main's attributes first (round 1's
        # probe: a `merge=union` main added after the fork union-merged a path read here as plain). A list file
        # needs union where the rebase meets it, at main's; any other path no attribute at either.
        attrs = {}
        for at in (up, sha):
            if not both:
                break
            co = run(wt, "checkout", "-q", "--detach", at)
            if co.returncode:
                return 2, f"no checkout of {at[:12]} in the scratch worktree: {co.stderr.strip()[:200]}", None
            ca = run(wt, "check-attr", "-z", "merge", "--", *both)
            if ca.returncode:   # an attribute that cannot be read is no answer: never fail open
                return 2, f"git check-attr could not be read: {ca.stderr.strip()[:200]}", None
            fields = ca.stdout.split("\0")
            attrs[at] = {fields[i]: fields[i + 2] for i in range(0, len(fields) - 2, 3)}
            if any(p not in attrs[at] for p in both):
                return 2, "git check-attr did not answer for every path", None
        if both and run(wt, "rev-parse", "HEAD").stdout.strip() != sha:
            return 2, f"the scratch worktree is not on {sha[:12]} again", None
        # TODO.md and CHANGELOG.md merge through the clone's driver (union); a LIST_PATHS file carries no attribute,
        # so git conflicts on it everywhere else and the loop below settles it with list-merge's set merge (round
        # 3: a union there revived a path main took off the list wherever list-merge was not the driver)
        not_union = [p for p in lists if p not in LIST_PATHS and attrs[up][p] != "union"]
        if not_union:
            return 1, f"{', '.join(not_union)} not `merge=union` in {up}'s .gitattributes: list-merge never runs there", None
        unioned = [p for p in lists if attrs[up][p] == "union"]
        if unioned:
            # the driver is asked for only where a union file needs it (round 3: a red PR with no list file was
            # held for a driver it never used). Either copy passes: the one beside this `pr` (a suite's scratch
            # clone installs it) or the main checkout's, which sync.py installs (the landing review: a `pr` run
            # from a worktree refused a driver installed right)
            c = subprocess.run([str(lm), "install", primary, "--check", "--here"], capture_output=True, text=True,
                               timeout=30)
            if c.returncode:
                c = subprocess.run([str(lm), "install", primary, "--check"], capture_output=True, text=True, timeout=30)
            if c.returncode:
                return 2, ("this clone's merge.union.driver is not list-merge (`list-merge install <repo>`): "
                           + (c.stdout.strip() or c.stderr.strip())[:200]), None
        # every other path is merged by git's text merge, as GitHub's own merge would: a union, a custom driver
        # or `-merge` is a merge GitHub never makes, so the plain merge would not be the judge there
        driven = sorted({f"{p} (merge={a[p]})" for a in attrs.values() for p in plain if a[p] not in ("unspecified", "set")})
        if driven:
            return 1, (f"{', '.join(driven[:8])} changed on both sides, with a merge attribute git's plain merge "
                       f"does not have: `/finish` rebases it"), None
        editors = {"GIT_EDITOR": "true", "GIT_SEQUENCE_EDITOR": "true"}
        r = run(wt, "-c", "rebase.updateRefs=false", "-c", "rebase.autoStash=false", "rebase", "-q", up,
                timeout=300, env=editors)
        picks = int(run(primary, "rev-list", "--count", f"{fork}..{sha}").stdout.strip() or 0)
        for _ in range(picks):   # each stop a pick whose only conflicts are LIST_PATHS files: settled as a set
            if not r.returncode:
                break
            stuck = sorted(set(run(wt, "diff", "--name-only", "-z", "--diff-filter=U").stdout.split("\0")) - {""})
            if not stuck or any(p not in LIST_PATHS for p in stuck) or not all(set_settle(wt, lm, p) for p in stuck):
                break
            r = run(wt, "-c", "core.editor=true", "rebase", "--continue", timeout=300, env=editors)
        if r.returncode:
            stuck = sorted(set(run(wt, "diff", "--name-only", "-z", "--diff-filter=U").stdout.split("\0")) - {""})
            run(wt, "rebase", "--abort")
            code = [p for p in stuck if not is_list_file(p)]
            if code:
                return 1, (f"a code conflict: {', '.join(code[:8])}{' …' if len(code) > 8 else ''} conflicts under "
                           f"git's plain merge (only {', '.join(LIST_FILES + LIST_PATHS)} restack by themselves): "
                           f"`/finish` rebases it"), None
            return 1, (f"the rebase onto {up} stopped" + (f" in {', '.join(stuck)}" if stuck else "")
                       + f": `/finish` rebases it ({(r.stderr or r.stdout).strip()[:160]})"), None
        new = run(wt, "rev-parse", "HEAD").stdout.strip()
        if not names_between(wt, up, new):
            return 1, f"nothing of the PR is left once on {up}: its work is on main already", None
        # the list files only: a driver ran there; a plain merge that is clean writes no markers, and a README's
        # setext `=======` underline is text, while a line of the PR's own the merge changed fails the carry below
        g = run(wt, "--literal-pathspecs", "grep", "-n", "-E", MARKER_RE, "HEAD", "--", *lists) if lists else None
        if g is not None and g.stdout.strip():
            return 1, f"conflict markers after the rebase: {g.stdout.strip().split(chr(10))[0][:160]}", None
        todo_md = lm.parent / "todo-md"
        if os.path.isfile(os.path.join(wt, "TODO.md")) and todo_md.is_file():
            l = subprocess.run([sys.executable, str(todo_md), "lint", ".", "--base", up], cwd=wt,
                               capture_output=True, text=True, timeout=120)
            if l.returncode:
                return 1, f"`todo-md lint . --base {up}` fails on the rebased tree: {(l.stdout + l.stderr).strip()[:300]}", None
        for p in lists:
            if os.path.basename(p) == "CHANGELOG.md":
                was = run(wt, "show", f"{sha}:{p}").stdout
                now = run(wt, "show", f"{new}:{p}").stdout
                if unreleased_first(was) and not unreleased_first(now):
                    return 1, f"{p}: `## Unreleased` is no longer its first heading after the rebase", None
        # the proof the push is the approved patch, list files aside: what the CI carry asks of it, here first
        same, why = carry_verdict(sha, new, up, cwd=wt)
        if not same:
            return 1, f"the rebased patch is not the PR's: {why}", None
        merged = "; ".join(x for x in (f"list-merge: {', '.join(lists)}" if lists else "",
                                        f"git's plain merge: {', '.join(plain[:8])}{' …' if len(plain) > 8 else ''}"
                                        if plain else "") if x) or "no path changed on both sides"
        if dry:
            return 0, f"would push {sha[:8]} → {new[:8]} ({merged})", new
        if before_push is not None and not before_push(new):
            return 2, f"the mark for {new[:8]} could not be written on the PR: nothing pushed", None
        # the push shape /finish's step 11 makes, from the repo itself so its pre-push guard reads the ref
        p = run(primary, "push", "-q", f"--force-with-lease=refs/heads/{ref}:{sha}", "origin",
                f"{new}:refs/heads/{ref}", timeout=180)
        if p.returncode:
            return 2, f"the push was refused (the lease on {sha[:8]}, or the guard): {p.stderr.strip()[:200]}", None
        run(primary, "update-ref", f"refs/remotes/origin/{ref}", new)
        if path is None:   # no worktree has it: the local branch follows, if it was on the old tip
            run(primary, "update-ref", f"refs/heads/{ref}", new, sha)
        note = (f"; its worktree {path} is on the old tip: `git -C {path} reset --keep origin/{ref}` before working there"
                if path else "")
        return 0, f"pushed {sha[:8]} → {new[:8]} ({merged}){note}", new
    finally:
        if os.path.isdir(wt):
            run(primary, "worktree", "remove", "--force", wt)
        shutil.rmtree(tmp, ignore_errors=True)
        run(primary, "worktree", "prune")


def set_settle(wt, lm, path):
    """Settle a rebase's conflict in a LIST_PATHS file with list-merge's set merge of its three stages (base, ours:
    the tree being built on main, theirs: the pick) and stage the result. False when a stage is missing (added or
    deleted on one side) or list-merge does not settle it: the rebase is refused, never guessed."""
    stages = []
    for n in (1, 2, 3):
        r = subprocess.run(["git", "--literal-pathspecs", "show", f":{n}:{path}"], cwd=wt, capture_output=True, timeout=60)
        if r.returncode:
            return False
        stages.append(r.stdout)
    tmp = tempfile.mkdtemp(prefix="pr-settle-")
    try:
        names = [os.path.join(tmp, x) for x in ("o", "a", "b")]
        for name, data in zip(names, stages):
            with open(name, "wb") as f:
                f.write(data)
        m = subprocess.run([sys.executable, str(lm), *names, path], capture_output=True, timeout=60)
        if m.returncode:
            return False
        shutil.copyfile(names[1], os.path.join(wt, path))
        return run(wt, "--literal-pathspecs", "add", "--", path).returncode == 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def own_logins(tok):
    """The logins whose PRs a restack may push: the token's own and the registry's `machine_account` (the other
    Mac's agents). A collaborator's claude/* PR is theirs to rebase (round 2's review: a shared repo's sweep would
    force-push it from the owner's token). None when GitHub cannot say who the token is."""
    st, me = common.api("GET", "/user", tok=tok)
    if st != 200 or not isinstance(me, dict) or not me.get("login"):
        return None
    out = {me["login"]}
    reg = common.repos_json()
    try:
        machine = json.loads(reg.read_text()).get("machine_account") if reg else None
    except (OSError, ValueError, AttributeError):
        machine = None
    if isinstance(machine, str) and machine:
        out.add(machine)
    return out


def checks_settled(slug, sha, base, tok):
    """None when the base's required checks (["check"] when the protection is hidden) passed on the head; else why
    not now. Main's check_state reads the newest non-skipped run per context, then the statuses: a run still going
    would be cancelled by the push (check.yml's cancel-in-progress) and leave the carry no green (round 2's review);
    a red required check gains nothing from a restack. Only the required ones: a red or cancelled `automerge` run,
    or an advisory status, would hold a PR automerge lands for good (round 3's review, probed)."""
    contexts = common.required_contexts(slug, base, tok) or ["check"]
    state, why = common.check_state(slug, sha, contexts, tok)
    if state == "pending" and never_ran(slug, sha, contexts, tok):
        # GitHub runs no pull_request workflow while a PR conflicts, so a head pushed into a conflict (a restack
        # main overtook within seconds) never gets a check: waiting would hold it for good, and a push cancels
        # nothing. The carry then finds no green and the whole line runs (the finish review, 2026-11-04).
        return None
    if state == "pending":
        return f"{why}; a push would cancel it"
    if state != "success":
        return f"{why}: its own fix comes first"
    return None


def never_ran(slug, sha, contexts, tok):
    """True when no required context has a check run or a status on sha, as GitHub read it: nothing to cancel.
    An answer that will not read is no proof (False)."""
    import urllib.parse
    for ctx in contexts:
        q = urllib.parse.quote(ctx, safe="")
        st, body = common.api("GET", f"/repos/{slug}/commits/{sha}/check-runs?check_name={q}&per_page=20", tok=tok)
        if st != 200 or not isinstance(body, dict) or body.get("check_runs"):
            return False
        st, body = common.api("GET", f"/repos/{slug}/commits/{sha}/status?per_page=100", tok=tok)
        if st != 200 or not isinstance(body, dict) or any(
                isinstance(x, dict) and x.get("context") == ctx for x in body.get("statuses") or []):
            return False
    return True


# wharf-runs' check_ci.MARK, the same text (test_pr.sh holds the two equal): build CI's provenance
# on a PR body, which check_ci.py reads before it merges main into a ready PR again.
CI_MARK = "<!-- wharf-runs check --ci -->"


def iso_epoch(text):
    """An API time (`2026-11-04T12:00:00Z`) as an epoch, or None."""
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00")).timestamp()
    except (TypeError, ValueError):
        return None


def red_checks(slug, sha, contexts, tok):
    """The required contexts that failed on sha, each (context, when its run was made as an epoch or None, the
    Actions run id or None, whether it tests the head); [] when none failed or any is still running (a push would
    cancel it: round 2 of the build review, check red while check-linux ran; round 3, a status whose rerun runs);
    None when a run's making cannot be read now. Failed is RED_CONCLUSIONS: a cancelled run is someone's choice.

    A check run (check.yml's `check`) tests GitHub's merge ref, made at the event: its time is the Actions run's
    `created_at`, which a rerun keeps (round 1: a hand rerun after main's fix read as "not moved"). A status
    (check-linux, from its workflow or CircleCI) tests the PR's head itself (check-linux.yml checks out
    `pull_request.head.sha`), so no time says what it saw: red_road judges it by the PR's fork (round 3)."""
    import urllib.parse
    out = []
    for ctx in contexts:
        q = urllib.parse.quote(ctx, safe="")
        st, body = common.api("GET", f"/repos/{slug}/commits/{sha}/check-runs?check_name={q}&per_page=20", tok=tok)
        if st != 200 or not isinstance(body, dict):
            return []
        r = next((x for x in body.get("check_runs") or [] if isinstance(x, dict) and x.get("conclusion") != "skipped"), None)
        if r is not None:
            if r.get("status") != "completed":
                return []
            if r.get("conclusion") in RED_CONCLUSIONS:
                m = RUN_ID_RE.search(str(r.get("details_url") or ""))
                made = iso_epoch(r.get("started_at"))   # without an Actions run, the check run's own start
                if m:
                    made, state, _ = run_made(slug, m.group(1), tok)
                    if made is None:
                        return None
                    if state != "completed":
                        return []
                out.append((ctx, made, m.group(1) if m else None, False))
            continue
        st, body = common.api("GET", f"/repos/{slug}/commits/{sha}/status?per_page=100", tok=tok)
        if st != 200 or not isinstance(body, dict):
            return []
        x = next((x for x in body.get("statuses") or [] if isinstance(x, dict) and x.get("context") == ctx), None)
        if x is None or x.get("state") not in ("success", "failure", "error"):
            return []   # not reported yet, or pending: still running
        if x.get("state") != "success":
            m = RUN_ID_RE.search(str(x.get("target_url") or ""))
            if m:   # a rerun of the run behind it posts nothing until it ends: ask the run itself
                made, state, concl = run_made(slug, m.group(1), tok)
                if made is None:
                    return None
                if state != "completed":
                    return []
                if concl == "cancelled":
                    # check-linux's gather posts `failure` for a cancelled run too: a cancel is someone's choice,
                    # never red (the landing review); a timed-out run ends `failure` and stays red
                    continue
            out.append((ctx, None, m.group(1) if m else None, True))
    return out


def run_made(slug, run_id, tok):
    """(the Actions run's `created_at` as an epoch, its status, its conclusion), or (None, None, None) when GitHub
    does not say."""
    st, body = common.api("GET", f"/repos/{slug}/actions/runs/{run_id}", tok=tok)
    if st != 200 or not isinstance(body, dict):
        return None, None, None
    return iso_epoch(body.get("created_at")), body.get("status"), body.get("conclusion")


def red_road(slug, tok, n, ref, sha, base, primary, red, dry):
    """(code, line) for a PR whose required check is red. Stale (red_checks says how each context is judged):
    restacked onto main to a new tip, never a rerun, which would replay what main has moved past; on a tip a red
    restack made or tried, nothing more. Otherwise its failed jobs rerun once a run (a flake). Main's tip landed at its committer time: GitHub's rebase-merge writes the
    merge time there (read on origin/main: `github-actions[bot]`), and a commit pushed by hand later than it was
    made reads as older, which sends it to the rerun road, the cheap side."""
    names = ", ".join(c for c, _, _, _ in red)
    # the head too: one pushed from another host is not here yet, and its fork would read as behind (the landing
    # review: a PR on main's tip sent to the restack road)
    f = run(primary, "fetch", "-q", "--no-tags", "origin", f"+refs/heads/{base}:refs/remotes/origin/{base}",
            f"+refs/heads/{ref}:refs/remotes/origin/{ref}", timeout=180)
    if f.returncode:
        return 2, f"#{n} {ref}: not now — fetch failed: {f.stderr.strip()[:200]}"
    try:
        landed = int(run(primary, "log", "-1", "--format=%ct", f"origin/{base}").stdout.strip())
    except ValueError:
        return 2, f"#{n} {ref}: not now — origin/{base} has no commit time here"
    made = [t for _, t, _, head in red if t is not None and not head]
    tip = run(primary, "rev-parse", f"origin/{base}").stdout.strip()
    fork = run(primary, "merge-base", f"origin/{base}", sha).stdout.strip()
    if tip and not fork:
        return 2, f"#{n} {ref}: not now — its head {sha[:12]} has no fork with origin/{base} here"
    behind = tip and fork != tip
    # a merge-ref run made before main's tip landed, or a head-tested one on a head behind main, saw an old main
    stale = (made and landed > min(made)) or (behind and any(head for _, _, _, head in red))
    why = f"its required check ({names}) failed on a base {base} has since moved past"
    if stale:
        if said_on(slug, n, RESTACK_RED % sha, tok):
            return 1, (f"#{n} {ref}: red — {why}, on a tip a red restack made already: its own fix comes first "
                       f"(a push of the PR's own is restacked again)")
        if said_on(slug, n, RESTACK_RED_FROM % sha, tok):
            # its push failed after the mark (a guard, a credential): one try a tip, never a comment a tick
            return 1, f"#{n} {ref}: red — {why}; a red restack of this tip was tried already: its own push comes next"

        def mark(new):   # the bound's marks before the push, both tips: a lost one would repeat the act
            st, _ = common.api("POST", f"/repos/{slug}/issues/{n}/comments", {"body": (
                f"{RESTACK_DONE % new} {RESTACK_RED % new} {RESTACK_RED_FROM % sha}\n**pr restack:** {why}, so it "
                f"is rebased onto `{base}` and pushing as {new[:12]}. The check runs on the new head; a red there is "
                f"the PR's own (no second red restack of that tip).")}, tok=tok)
            return st == 201
        try:
            code, text, new = restack_tree(primary, ref, sha, base, dry, red=True, before_push=mark)
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            return 2, f"#{n} {ref}: not judged ({type(e).__name__}: {str(e)[:200]})"
        if code == 1:
            leave(slug, n, sha, tok, f"**pr restack: not restacked.** {why[0].upper() + why[1:]}, and {text}.\n\n"
                  f"Head {sha[:12]}; the next push to the branch is judged again.", dry)
            return 1, f"#{n} {ref}: refused — {why}, and {text}"
        return code, f"#{n} {ref}: " + ("restacked — " if code == 0 else "not now — ") + f"{why}: {text}"
    since = (f"its run was made after {base} last moved" if made
             else f"its head is on {base}'s tip" if not behind else "when its run was made cannot be read")
    ids = sorted({r for _, _, r, _ in red if r})
    if not ids:
        return 1, f"#{n} {ref}: red ({names}): {since}, and no Actions run to rerun: its own fix comes first"
    fresh = [i for i in ids if not said_on(slug, n, RESTACK_RERUN % i, tok)]
    if not fresh:
        return 1, f"#{n} {ref}: red ({names}) after its rerun was asked: its own fix comes first"
    if dry:
        return 0, f"#{n} {ref}: would rerun the failed jobs of run {', '.join(fresh)} ({names}): {since}"
    done = []
    for i in fresh:
        # the mark first: a rerun whose mark could not be written would be asked again every tick
        st, _ = common.api("POST", f"/repos/{slug}/issues/{n}/comments", {"body": (
            f"{RESTACK_RERUN % i}\n**pr restack:** the required check ({names}) failed on {sha[:12]}, and {since}, "
            f"so a rerun of its failed jobs is asked, once (run {i}); a red after it is the PR's own.")}, tok=tok)
        if st != 201:
            return 2, f"#{n} {ref}: not now — the rerun's mark could not be written (HTTP {st})"
        st, _ = common.api("POST", f"/repos/{slug}/actions/runs/{i}/rerun-failed-jobs", {}, tok=tok)
        if st not in (200, 201, 204):
            # said on the PR, so its mark does not read as a rerun done; never asked again (it would refuse again)
            common.api("POST", f"/repos/{slug}/issues/{n}/comments", {"body": (
                f"**pr restack:** GitHub refused the rerun of run {i} (HTTP {st}); it is not asked again: rerun it "
                f"by hand, or push a fix.")}, tok=tok)
            return 1, f"#{n} {ref}: the rerun of run {i} was refused (HTTP {st}); said on the PR, not asked again"
        done.append(i)
    return 0, f"#{n} {ref}: rerun — the failed jobs of run {', '.join(done)} ({names}): {since}"


def held(p):
    """The PR carries the `hold` label: it lands by the owner's tap, so its head is theirs to review, never rewritten."""
    return any(isinstance(l, dict) and l.get("name") == common.HOLD["name"] for l in p.get("labels") or [])


def restack_one(slug, tok, n, base, primary, dry=False, logins=None):
    """(code, line) for PR n."""
    p = gh_pull(slug, n, tok)
    if p is None:
        return 2, f"#{n}: GitHub could not be asked"
    head = p.get("head") or {}
    ref, sha = head.get("ref") or "", head.get("sha") or ""
    if p.get("state") != "open":
        return 1, f"#{n}: not open"
    if not ref.startswith("claude/"):
        return 1, f"#{n}: {ref or 'its head'} is not a claude/* branch: left alone"
    if (head.get("repo") or {}).get("full_name") != slug:
        return 1, f"#{n}: its head is a fork's: left alone"
    if ((p.get("base") or {}).get("ref")) != base:
        return 1, f"#{n}: it is not into {base}: left alone"
    if p.get("draft"):
        return 1, f"#{n}: a draft: `/finish` curates and readies it"
    if held(p):
        return 1, f"#{n} {ref}: labelled `{common.HOLD['name']}`, it waits for the owner's tap: left alone"
    state = p.get("mergeable_state")
    # dirty: a conflict; blocked: a required check red (or running, or a review owed); behind: a strict base. Any
    # other state is mergeable with its required checks green, or not judged yet: nothing to do
    if state not in ("dirty", "blocked", "behind"):
        return 0, f"#{n}: nothing to do (GitHub says {state or 'nothing yet'})"
    logins = own_logins(tok) if logins is None else logins
    if logins is None:
        return 2, f"#{n}: not now — GitHub could not say whose token this is"
    author = (p.get("user") or {}).get("login") or ""
    if author not in logins:
        return 1, f"#{n} {ref}: opened by {author or 'an unknown login'}, not this token's login or the machine account: left alone"
    contexts = common.required_contexts(slug, base, tok) or ["check"]
    red = red_checks(slug, sha, contexts, tok)
    if red is None:
        return 2, f"#{n} {ref}: not now — a red run's making could not be read from GitHub"
    if red:
        try:
            return red_road(slug, tok, n, ref, sha, base, primary, red, dry)
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            return 2, f"#{n} {ref}: not judged ({type(e).__name__}: {str(e)[:200]})"
    if state != "dirty":
        return 0, f"#{n}: nothing to do (GitHub says {state}, and no required check is red)"
    wait = checks_settled(slug, sha, base, tok)
    if wait:
        return 2, f"#{n} {ref}: not now — {wait}"
    try:
        code, text, new = restack_tree(primary, ref, sha, base, dry)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        return 2, f"#{n} {ref}: not judged ({type(e).__name__}: {str(e)[:200]})"
    if code == 1:
        leave(slug, n, sha, tok, f"**pr restack: not restacked.** GitHub marks this PR DIRTY, and {text}.\n\n"
              f"Head {sha[:12]}; the next push to the branch is judged again.", dry)
        return 1, f"#{n} {ref}: refused — {text}"
    if code == 0 and not dry:
        # the carry is said only where this repo's check.yml has one (regatta's; the template has none)
        wf = run(primary, "show", f"origin/{base}:.github/workflows/check.yml").stdout
        tail = (" The PR's own lines are unchanged bar the lists, so check.yml carries the last green (`pr carry`)."
                if "pr carry" in wf else " This repo's check runs again on the new head.")
        common.api("POST", f"/repos/{slug}/issues/{n}/comments", {"body": (
            f"{RESTACK_DONE % new}\n**pr restack:** rebased onto `{base}` and pushed, {text}.{tail}")},
            tok=tok)
    return code, f"#{n} {ref}: " + ("restacked — " if code == 0 else "not now — ") + text


def restack(args, slug, tok, base):
    dry = "--dry-run" in args
    rest = [a for a in args[1:] if a != "--dry-run"]
    primary = str(Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent)
    if rest == ["--all"]:
        prs = gh_open_pulls(slug, tok)
        if prs is None:
            print("pr restack: GitHub could not be asked for the open pull requests")
            return 2
        worst, logins = 0, own_logins(tok)
        if logins is None:
            print("pr restack: GitHub could not say whose token this is: nothing restacked")
            return 2
        for p in prs:
            ref = (p.get("head") or {}).get("ref") or ""
            if not ref.startswith("claude/") or p.get("draft") or ((p.get("base") or {}).get("ref")) != base or held(p):
                continue   # a held PR is the owner's to review: never rewritten, never logged each tick
            if ((p.get("user") or {}).get("login") or "") not in logins:
                continue   # a collaborator's PR: never judged, never logged each tick
            code, line = restack_one(slug, tok, p["number"], base, primary, dry, logins=logins)
            if "nothing to do" not in line:   # the sweep's log holds what happened, not every clean PR
                print(f"pr restack {line}")
            worst = max(worst, 2 if code == 2 else 0)
        return worst
    if len(rest) != 1 or not rest[0].lstrip("#").isdigit():
        sys.exit("pr restack: <N> or --all, then --dry-run if wanted")
    code, line = restack_one(slug, tok, int(rest[0].lstrip("#")), base, primary, dry)
    print(f"pr restack {line}")
    return code


def main_branch():
    top = git("rev-parse", "--show-toplevel")
    for root in (Path(top), Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent):
        try:
            return json.loads((root / ".claude" / "workflow.json").read_text()).get("main") or "main"
        except (OSError, ValueError):
            continue
    return "main"


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD")
    if cmd == "strays":
        # /finish step 9, before anything is pushed: no token, no PR, no network; against the
        # last-fetched origin base, or the local one with --local (offline, /finish --local)
        base = main_branch()
        up = base if "--local" in args or not git("rev-parse", "-q", "--verify", f"origin/{base}") else f"origin/{base}"
        refuse_strays(up, branch, "clean", [])
        print("strays: none" if strays(up, branch) is not None else f"strays: no {branch}-raw to judge by")
        return
    if cmd == "carry":
        # CI's, offline: no token, no branch (a runner's checkout is a detached merge ref)
        pos, up, rest = [], f"origin/{main_branch()}", list(args[1:])
        while rest:
            a = rest.pop(0)
            if a == "--base" and rest:
                up = rest.pop(0)
            elif a.startswith("--"):
                sys.exit(f"pr carry: unknown option {a}")
            else:
                pos.append(a)
        if len(pos) != 2:
            sys.exit("pr carry: <before> <after> [--base <ref>]")
        ok, why = carry_verdict(pos[0], pos[1], up)
        print(("CARRY " if ok else "RUN ") + why)
        sys.exit(0 if ok else 1)
    slug = common.repo_slug(git("remote", "get-url", "origin"))
    if cmd == "restack":
        # any checkout of the repo, on any branch: the PR names the branch (the sweep runs it from the main checkout)
        tok = common.token() if slug else None
        if not slug or not tok:
            sys.exit(f"pr restack: {'no GitHub token' if slug else 'origin is not on GitHub'} — nothing done")
        sys.exit(restack(args, slug, tok, main_branch()))
    if not branch.startswith("claude/") or not slug:
        sys.exit(f"pr: on {branch or 'a detached HEAD'} with origin {slug or 'not on GitHub'} — nothing to do")
    tok = common.token()
    if not tok:
        sys.exit("pr: no GitHub token — GH_TOKEN, ~/.git-credentials or `gh auth token`")
    pr = common.find_pr(slug, branch, tok)
    base = main_branch()

    if cmd == "status":
        print(f"#{pr['number']} {pr['title']}\n{pr['html_url']}" if pr else "none")
        return
    if cmd == "hold":
        # /finish step 11.2, before it pushes a curated tip onto a PR already ready: check_ci.py's
        # hold protocol through the token, as an unattended /finish may not run gh (dispatch denies
        # it). Same body shape as check_ci.hold(): CI_HOLD_NOTE is the ownership `pr ready` reads
        # and spends; CI_MARK says build CI held it. An unmarked `hold` already on is the owner's:
        # kept, nothing claimed.
        if len(args) != 1:
            sys.exit("pr hold: no options")
        if not pr:
            sys.exit(f"pr hold: no open pull request for {branch} — nothing held")
        body = pr.get("body") or ""
        owned = any(note in body for note in common.HOLD_NOTES)
        labelled = any(isinstance(l, dict) and l.get("name") == common.HOLD["name"] for l in pr.get("labels") or [])
        if labelled and not owned:   # held() is shadowed in main(): `ready` binds a local `held`
            print(f"pr hold: #{pr['number']} already held by its owner — left as it is")
            return
        new = body
        if not owned:
            new = new.rstrip() + "\n\n" + common.CI_HOLD_NOTE
        if CI_MARK not in new:
            new = new.rstrip() + "\n\n" + CI_MARK
        if new != body and not common.edit_pr(slug, pr["number"], tok, body=new):
            sys.exit(f"pr hold: {pr['html_url']} — its body could not be written; not held")
        common.api("POST", f"/repos/{slug}/labels", common.HOLD, tok=tok)  # 201 made, 422 already there
        st, _ = common.api("POST", f"/repos/{slug}/issues/{pr['number']}/labels",
                           {"labels": [common.HOLD["name"]]}, tok=tok)
        if st != 200:
            sys.exit(f"pr hold: {pr['html_url']} could not be labelled `hold` (HTTP {st}) — not held")
        print(f"pr hold: #{pr['number']} held for build CI — `pr ready` releases it")
        return
    if cmd == "ready":
        title = body = None
        hold = False
        i = 1
        while i < len(args):
            if args[i] == "--hold":
                hold = True; i += 1
            elif args[i] == "--drops-ok":
                i += 1
            elif args[i] == "--title":
                title = args[i + 1]; i += 2
            elif args[i] == "--body-file":
                body = Path(args[i + 1]).read_text(); i += 2
            else:
                sys.exit(f"pr: unknown option {args[i]}")
        # The PR's commits are what origin's base lacks, not the local one: a local main that
        # diverged from origin (an unpushed launch) put origin's own tip first in the range,
        # and ten PRs on 2026-09-25 were titled after an already-merged PR.
        git("fetch", "-q", "origin", base)
        up = f"origin/{base}" if git("rev-parse", "-q", "--verify", f"origin/{base}") else base
        rng = f"{up}..HEAD"
        # before the PR leaves draft: here a ready PR is a launched one (automerge.yml); /finish
        # step 9 runs `pr strays` before the push too
        refuse_strays(up, branch, "readied", args)
        refuse_sweep_gate(up, base, "readied")
        if not hold and held_launch():
            # a held launch leaves draft labelled, --hold or not: unlabelled, automerge.yml launches a ready
            # claude/* PR, and the merge wall above never runs (the second landing review)
            hold = True
            print(f"pr: this launch is held ({held_launch()}) — readied with the `hold` label", file=sys.stderr)
        if not title:
            title = git("log", "--reverse", "--format=%s", rng).splitlines()[0]
        if body is None:
            body = git("log", "--reverse", "--format=%s%n%n%b", rng)
        # never the hold mark: a curated body carrying it would let a later `pr ready` take off a
        # `hold` the owner set (common.ready_pr's one-shot mark)
        for note in common.HOLD_NOTES:
            body = body.replace(note, "")
        body = body.rstrip()
        body += f"\n\n---\nFrom `{common.host_name()}`, curated by `/finish`."
        if pr:
            # Curation replaces the body: carry ownership of open_pr's or build CI's hold
            # to ready_pr, which releases it even if the PR was already ready for CI.
            held = any(note in (pr.get("body") or "") for note in common.HOLD_NOTES)
            pr = common.edit_pr(slug, pr["number"], tok, title=title, body=body)
            if pr and held:
                pr["_held"] = True
        else:
            pr = common.open_pr(slug, branch, base, title, body, tok)
        if not pr:
            sys.exit("pr: GitHub refused — is the branch pushed, and does it differ from main?")
        if hold:
            # labelled while still a draft, so automerge never sees it ready and unheld; and no
            # `_held` mark, so ready_pr leaves this label on (it takes off only tool-owned holds)
            common.api("POST", f"/repos/{slug}/labels", common.HOLD, tok=tok)  # 201 made, 422 already there
            st, _ = common.api("POST", f"/repos/{slug}/issues/{pr['number']}/labels",
                               {"labels": [common.HOLD["name"]]}, tok=tok)
            if st != 200:
                sys.exit(f"pr: {pr['html_url']} could not be labelled `hold` (HTTP {st}) — left a draft")
            if any(note in (pr.get("body") or "") for note in common.HOLD_NOTES):
                clean = pr["body"]
                for note in common.HOLD_NOTES:
                    clean = clean.replace(f"\n\n{note}", "").replace(note, "")
                edited = common.edit_pr(slug, pr["number"], tok, body=clean)
                if not edited:  # ready_pr would read the note and take the label off: stop held
                    sys.exit(f"pr: {pr['html_url']} is labelled `hold`, but its body could not be cleaned — left as it is")
                pr = edited
            pr["_held"] = False
        if not common.ready_pr(pr, tok):
            sys.exit(f"pr: {pr['html_url']} is still a draft — GitHub would not mark it ready")
        print(pr["html_url"])
        return
    if cmd == "merge":
        if not pr:
            # automerge may have launched it already (a repo with .github/workflows/automerge.yml):
            # GitHub's merged PR at exactly this tip is the proof, and the carried pass still runs
            done = common.merged_pr(slug, branch, git("rev-parse", "HEAD"), tok)
            if not done:
                sys.exit("pr: no open pull request for this branch — `pr ready` first")
            print(f"merged #{done['number']}: already, by automerge")
            for line in carried(slug, tok, launched_via=done["number"]):
                if not line.startswith("Carries: nothing"):
                    print(line)
            return
        git("fetch", "-q", "origin", base)
        before = git("rev-parse", "-q", "--verify", f"origin/{base}")
        refuse_strays(f"origin/{base}" if before else base, branch, "merged", args)
        def hold():
            common.api("POST", f"/repos/{slug}/labels", common.HOLD, tok=tok)  # 201 made, 422 already there
            st, _ = common.api("POST", f"/repos/{slug}/issues/{pr['number']}/labels",
                               {"labels": [common.HOLD["name"]]}, tok=tok)
            return st == 200
        refuse_sweep_gate(f"origin/{base}" if before else base, base, "merged", hold)
        # the check judged local HEAD; GitHub merges the PR's head — they must be one commit
        remote = ((pr.get("head") or {}).get("sha") or "")
        if remote and remote != git("rev-parse", "HEAD"):
            sys.exit(f"pr: NOT merged — the PR's head {remote[:8]} is not this HEAD: push first (step 11.2)")
        # A refusal is read back, never assumed: in a repo with automerge.yml a token that is no
        # admin (the other Mac's) is refused while `check` runs and automerge launches the PR a minute
        # later; the wait and its limits are common.merge_pr_waiting's.
        has_am = subprocess.run(["git", "cat-file", "-e", f"origin/{base}:{common.AUTOMERGE_YML}"],
                                capture_output=True).returncode == 0
        # The base's required checks must have passed on this head before the PUT: an admin token
        # is not refused by the protection (common.merge_pr_waiting says why). Nothing required: as before.
        contexts = common.required_contexts(slug, base, tok)
        ok, msg = common.merge_pr_waiting(slug, pr["number"], tok, automerge=has_am,
                                          head=remote or git("rev-parse", "HEAD"), contexts=contexts)
        if not ok:
            if "still running" in msg:
                sys.exit(f"pr: NOT merged — {msg}" + ("" if has_am else "; no automerge.yml on the base: run `pr merge` again once it passes"))
            sys.exit(f"pr: merge refused — {msg}")
        print(f"merged #{pr['number']}: {msg}")
        # A rebase merge puts every commit of the PR on the base, so undoing it is a range, not
        # HEAD; both ends are read back from origin, never worked out (coding-on-workflow 3e).
        git("fetch", "-q", "origin", base)
        after = git("rev-parse", "-q", "--verify", f"origin/{base}")
        primary = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).parent
        if before and after and before != after:
            print(f"rollback: cd {primary} && git revert --no-edit {before}..{after} "
                  f"&& GIT_PUSH_OK=1 git push origin {base}")
        for line in carried(slug, tok, launched_via=pr["number"]):
            if not line.startswith("Carries: nothing"):
                print(line)
        return
    if cmd == "carried":
        via = None
        # --landed-via is the old spelling of --launched-via, an alias until the rename's S8 (a /finish older than S4 says it)
        flag = next((f for f in ("--launched-via", "--landed-via") if f in args), None)
        if flag:
            i = args.index(flag)
            via = args[i + 1] if i + 1 < len(args) else sys.exit(f"pr: {flag} needs the PR number")
            via = via.lstrip("#")
            if not via.isdigit():
                sys.exit(f"pr: {flag} needs a PR number, got {via}")
        print("\n".join(carried(slug, tok, launched_via=via)))
        return
    sys.exit(__doc__)


if __name__ == "__main__":
    main()
